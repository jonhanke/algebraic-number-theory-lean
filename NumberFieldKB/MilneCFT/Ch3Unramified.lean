import Mathlib
import QuadFormsKB.Citation
import NumberFieldKB.MilneCFT.Ch3Local
import NumberFieldKB.TauCetiPort.NumberTheory.LocalField.Norm.Unramified.Basic
import NumberFieldKB.TauCetiPort.NumberTheory.LocalField.FiniteExtension.IntermediateField

/-!
# Milne, *Class Field Theory*, Chapter III §1: the cohomology of unramified extensions

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`.
Locators give Milne's printed page numbers (printed page = pdf page − 9).

$L/K$ is a finite unramified extension of a nonarchimedean local field (Chapter I's `IsUnramifiedExt`), Galois with
group $G$.

## Named statements (inputs, never axioms)
* `UnitPrimeDecomposition` — Milne's display (26), p. 97: a prime element $\pi$ of $K$ stays prime in $L$, so every
  $\alpha \in L^\times$ is $u\pi^m$ with $u \in U_L$, $m \in \mathbb Z$ (Milne, *ANT*, Chapter 7).
* `UnramifiedCyclic` — $G \simeq \operatorname{Gal}(l/k)$ (p. 98), so $G$ is cyclic, generated by the Frobenius
  element (p. 99; Chapter I, §1).
* `Prop1_2` — Proposition 1.2: the norm $U_L \to U_K$ is onto. **Proved** (`prop1_2`, from the ported Tau Ceti
  `TauCeti.map_normUnits_unitFiltration`).

## Proved
* `prop_1_1` — Proposition 1.1, $H^r_T(G, U_L) = 0$ for all $r$, from the two remaining inputs, Proposition 1.2, Hilbert's Theorem 90 and
  periodicity (Milne's proof).
* `exists_unique_decomposition` — the decomposition (26) is unique ($\pi^m \in U_L$ only for $m = 0$).
-/

open scoped ValuativeRel

namespace NumberFieldKB.MilneCFT.Ch3

open CategoryTheory Rep groupCohomology Limits NumberFieldKB.MilneCFT NumberFieldKB.MilneCFT.LocalCFT

set_option synthInstance.maxHeartbeats 400000
set_option linter.unusedSectionVars false

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-- The inclusion $K^\times \to L^\times$. -/
noncomputable def embUnits (L : IntermediateField K Ω) : Kˣ →* Lˣ :=
  Units.map (algebraMap K L).toMonoidHom

/-- The norm $\mathrm{Nm}_{L/K} : L^\times \to K^\times$ (the map whose image is Chapter I's `normGroup L`). -/
noncomputable def normUnits (L : IntermediateField K Ω) : Lˣ →* Kˣ :=
  Units.map (Algebra.norm K (S := L))

theorem normUnits_range (L : IntermediateField K Ω) [FiniteDimensional K L] : (normUnits L).range = normGroup L := rfl

@[simp] theorem coe_embUnits (L : IntermediateField K Ω) (a : Kˣ) :
    ((embUnits L a : Lˣ) : L) = algebraMap K L a := rfl

@[simp] theorem coe_normUnits (L : IntermediateField K Ω) (x : Lˣ) :
    ((normUnits L x : Kˣ) : K) = Algebra.norm K (x : L) := rfl

theorem gal_smul_embUnits (L : IntermediateField K Ω) (σ : Gal(L/K)) (a : Kˣ) :
    σ • embUnits L a = embUnits L a :=
  Units.ext (σ.commutes _)

variable (K Ω)

/-- **Display (26)** (named statement; Milne, Chapter III, §1, p. 97, from *ANT*, Chapter 7): if $L/K$ is a finite
unramified extension and $\pi$ is a prime element of $K$, then $\pi$ is a prime element of $L$, and every
$\alpha \in L^\times$ can be written $\alpha = u\pi^m$ with $u \in U_L$ and $m \in \mathbb Z$, i.e.
$L^\times = U_L \cdot \pi^{\mathbb Z} \simeq U_L \times \mathbb Z$. Uniqueness of the decomposition is proved
(`exists_unique_decomposition`). -/
@[kb "milne2020cft" "v4.03, Ch. III, §1, display (26), p. 97 (input)"]
structure UnitPrimeDecomposition : Prop where
  decomp : ∀ (L : IntermediateField K Ω) [FiniteDimensional K L], IsUnramifiedExt L →
    ∀ {π : 𝒪[K]} (hπ : Irreducible π) (x : Lˣ), ∃ u ∈ unitsL L, ∃ m : ℤ,
      x = u * embUnits L (primeUnit hπ) ^ m

/-- **The Galois group of an unramified extension** (named statement; Milne, Chapter III, §1, p. 98: "because $L/K$
is unramified, the action of $G$ on $\mathcal O_L$ defines an isomorphism $G \simeq \operatorname{Gal}(l/k)$", and
p. 99: $G$ has the Frobenius element as canonical generator; Chapter I, §1, p. 20): for a finite unramified Galois
extension $L/K$, $\operatorname{Gal}(L/K)$ is cyclic, generated by a Frobenius element (Chapter I's
`IsFrobenius`), and every Frobenius element generates it (the Frobenius element is unique: Chapter I's
`UnramifiedInput.frobenius_unique`). -/
@[kb "milne2020cft" "v4.03, Ch. III, §1, p. 98–99, G ≃ Gal(l/k) generated by Frobenius (input)"]
structure UnramifiedCyclic : Prop where
  frob_generates : ∀ (L : IntermediateField K Ω) [FiniteDimensional K L] [IsGalois K L], IsUnramifiedExt L →
    ∃ σ : Gal(L/K), IsFrobenius L σ ∧ ∀ τ : Gal(L/K), τ ∈ Subgroup.zpowers σ
  frob_generator : ∀ (L : IntermediateField K Ω) [FiniteDimensional K L] [IsGalois K L], IsUnramifiedExt L →
    ∀ σ : Gal(L/K), IsFrobenius L σ → ∀ τ : Gal(L/K), τ ∈ Subgroup.zpowers σ

/-- **Proposition 1.2** (named statement; Milne, Chapter III, p. 98). Let $L/K$ be a finite unramified extension.
Then the norm map $\mathrm{Nm}_{L/K} : U_L \to U_K$ is surjective. (Milne's proof: Lemmas 1.3–1.5 give
surjectivity on each graded piece $U^{(m)}/U^{(m+1)}$, and completeness of $K$ assembles the successive
approximations.)

**Proved here** as `prop1_2`, from the ported copy under `NumberFieldKB/TauCetiPort/` of Tau Ceti
`TauCeti.map_normUnits_unitFiltration`
(`TauCeti/NumberTheory/LocalField/Norm/Unramified/Basic.lean:126`) (read at Tau Ceti `7ed979dc`, ported from `67aa1716`). Needed to apply it
here: Tau Ceti proves surjectivity on every step of the unit filtration; take the step of index zero and identify it
with our group of units of the local field. -/
@[kb "milne2020cft" "v4.03, Ch. III, Prop. 1.2, p. 98 (input)"]
structure Prop1_2 : Prop where
  surj : ∀ (L : IntermediateField K Ω) [FiniteDimensional K L], IsUnramifiedExt L →
    ∀ u ∈ unitGroup K, ∃ v ∈ unitsL L, normUnits L v = u

variable {K Ω}

/-! ### Proposition 1.2, proved from Tau Ceti

Our $L$ is an intermediate field of $\Omega/K$ with no valuation of its own. Tau Ceti (ported under
`NumberFieldKB/TauCetiPort/`, main `67aa1716`, Apache 2.0) equips a finite intermediate field with the unique extension
of the valuation of $K$ (`TauCeti.finiteIntermediateFieldValuativeRel`, a nonarchimedean local field by
`TauCeti.finiteIntermediateField_isNonarchimedeanLocalField`), whose ring of integers is the integral closure of
$\mathcal O_K$ (`TauCeti.integerRing_eq_integralClosure`), that is our `integers L`. Our unramifiedness
(`IsUnramifiedExt`: $\mathfrak m_K\mathcal O_L$ is maximal) is Tau Ceti's
(`TauCeti.isUnramified_iff_map_maximalIdeal_eq`: $\mathfrak m_K\mathcal O_L = \mathfrak m_L$), since $\mathcal O_L$
is local. Then `TauCeti.map_normUnits_unitFiltration` at level zero is Proposition 1.2. -/

/-- **Proposition 1.2, proved** (Milne, *CFT*, III, Proposition 1.2, p. 98): the named statement `Prop1_2` holds. For a
finite unramified extension $L/K$ the norm $\mathrm{Nm}_{L/K} : U_L \to U_K$ is onto. From Tau Ceti's
`TauCeti.map_normUnits_unitFiltration` at level zero (ported). -/
@[kb "milne2020cft" "v4.03, Ch. III, Prop. 1.2, p. 98"]
theorem prop1_2 : Prop1_2 K Ω := by
  refine ⟨fun L _ hL u hu => ?_⟩
  let : ValuativeRel L := TauCeti.finiteIntermediateFieldValuativeRel K Ω L
  let : TopologicalSpace L := TauCeti.finiteIntermediateFieldTopology K Ω L
  have : ValuativeExtension K L := TauCeti.finiteIntermediateField_valuativeExtension K Ω L
  have : IsNonarchimedeanLocalField L := TauCeti.finiteIntermediateField_isNonarchimedeanLocalField K Ω L
  -- The ring of integers of the installed valuation is our `integers L`.
  have hO : ∀ x : L, x ∈ 𝒪[L] ↔ x ∈ integers L := fun x => by
    rw [TauCeti.integerRing_eq_integralClosure K L]
    rfl
  -- Our unramifiedness is Tau Ceti's.
  have : TauCeti.IsUnramified K L := by
    rw [TauCeti.isUnramified_iff_map_maximalIdeal_eq]
    let e := TauCeti.integerRingEquivIntegralClosure K L
    have he : ((e : 𝒪[L] →+* integers L)).comp (algebraMap 𝒪[K] 𝒪[L]) = algebraMap 𝒪[K] (integers L) :=
      RingHom.ext fun x => e.commutes x
    have hmap : (𝓂[K].map (algebraMap 𝒪[K] 𝒪[L])).map (e : 𝒪[L] →+* integers L) =
        𝓂[K].map (algebraMap 𝒪[K] (integers L)) := by
      rw [Ideal.map_map, he]
    have hmax : (𝓂[K].map (algebraMap 𝒪[K] 𝒪[L])).IsMaximal := by
      have h1 : (((𝓂[K].map (algebraMap 𝒪[K] 𝒪[L])).map (e : 𝒪[L] →+* integers L)).comap
          (e : 𝒪[L] →+* integers L)).IsMaximal := by
        rw [hmap]
        exact Ideal.comap_isMaximal_of_surjective _ e.surjective (H := hL)
      rwa [Ideal.comap_map_of_bijective (e : 𝒪[L] →+* integers L) e.bijective] at h1
    exact IsLocalRing.eq_maximalIdeal hmax
  -- `u` is in level zero of the unit filtration of `K`, so it is the norm of a level-zero unit of `L`.
  obtain ⟨w, hw⟩ := mem_unitGroup.1 hu
  have hu0 : u ∈ TauCeti.unitFiltration K 0 :=
    TauCeti.mem_unitFiltration_iff_exists.2 ⟨w, by simp, hw⟩
  rw [← TauCeti.map_normUnits_unitFiltration K L 0] at hu0
  obtain ⟨v, hv, hvu⟩ := Subgroup.mem_map.1 hu0
  obtain ⟨w', -, hw'⟩ := TauCeti.mem_unitFiltration_iff_exists.1 hv
  have hvw : v = Units.map (𝒪[L].subtype : 𝒪[L] →* L) w' := Units.ext hw'.symm
  refine ⟨v, ⟨?_, ?_⟩, Units.ext ?_⟩
  · rw [← hw']
    exact (hO _).1 (w' : 𝒪[L]).2
  · rw [hvw, ← map_inv]
    exact (hO _).1 ((w'⁻¹ : 𝒪[L]ˣ) : 𝒪[L]).2
  · rw [← hvu, coe_normUnits, TauCeti.Algebra.coe_normUnits]

/-- The norm of a unit of $\mathcal O_L$ is a unit of $\mathcal O_K$. -/
theorem normUnits_mem_unitGroup (L : IntermediateField K Ω) [FiniteDimensional K L] {x : Lˣ}
    (hx : x ∈ unitsL L) : normUnits L x ∈ unitGroup K := by
  have hint : ∀ y : L, y ∈ integers L → ∃ e : 𝒪[K], (e : K) = Algebra.norm K y := by
    intro y hy
    have hy' : IsIntegral 𝒪[K] y := hy
    have : IsIntegral 𝒪[K] (Algebra.norm K y) := Algebra.isIntegral_norm K hy'
    obtain ⟨e, he⟩ := IsIntegrallyClosed.isIntegral_iff.1 this
    exact ⟨e, he⟩
  obtain ⟨e, he⟩ := hint _ hx.1
  obtain ⟨d, hd⟩ := hint _ hx.2
  refine mem_unitGroup.2 ⟨⟨e, d, ?_, ?_⟩, he⟩
  · apply Subtype.ext
    have : ((e : K) * d) = 1 := by
      rw [he, hd, ← map_mul]; simp
    simpa using this
  · apply Subtype.ext
    have : ((d : K) * e) = 1 := by
      rw [he, hd, ← map_mul]; simp
    simpa using this

/-- A power $\pi^m$ of a prime element of $K$ lies in $U_L$ only for $m = 0$. -/
theorem zpow_embUnits_mem_unitsL (L : IntermediateField K Ω) [FiniteDimensional K L] {π : 𝒪[K]}
    (hπ : Irreducible π) {m : ℤ} (h : embUnits L (primeUnit hπ) ^ m ∈ unitsL L) : m = 0 := by
  have h1 := normUnits_mem_unitGroup L h
  have h2 : normUnits L (embUnits L (primeUnit hπ) ^ m) = primeUnit hπ ^ ((Module.finrank K L : ℤ) * m) := by
    rw [map_zpow, zpow_mul, zpow_natCast]
    congr 1
    apply Units.ext
    simp [Algebra.norm_algebraMap]
  rw [h2] at h1
  have h3 := zpow_primeUnit_mem_unitGroup hπ h1
  have hpos : (0 : ℤ) < Module.finrank K L := by exact_mod_cast Module.finrank_pos
  rcases mul_eq_zero.1 h3 with h | h
  · omega
  · exact h

/-- The decomposition (26) is unique. -/
theorem exists_unique_decomposition (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π) (x : Lˣ) :
    ∃! m : ℤ, x * embUnits L (primeUnit hπ) ^ (-m) ∈ unitsL L := by
  obtain ⟨u, hu, m, hm⟩ := h26.decomp L hL hπ x
  refine ⟨m, ?_, ?_⟩
  · simpa [hm] using hu
  · intro m' hm'
    have h1 : (x * embUnits L (primeUnit hπ) ^ (-m)) ⁻¹ * (x * embUnits L (primeUnit hπ) ^ (-m')) ∈ unitsL L :=
      Subgroup.mul_mem _ (Subgroup.inv_mem _ (by simpa [hm] using hu)) hm'
    have h2 : (x * embUnits L (primeUnit hπ) ^ (-m)) ⁻¹ * (x * embUnits L (primeUnit hπ) ^ (-m'))
        = embUnits L (primeUnit hπ) ^ (m - m') := by
      rw [mul_inv_rev, mul_assoc, ← mul_assoc x⁻¹ x, inv_mul_cancel, one_mul, ← zpow_neg, ← zpow_add]
      congr 1; ring
    rw [h2] at h1
    have := zpow_embUnits_mem_unitsL L hπ h1
    omega

private theorem decompKey {M : Type*} [CommGroup M] (x y e : M) (a b : ℤ) :
    x * y * e ^ (-(a + b)) = x * e ^ (-a) * (y * e ^ (-b)) := by
  rw [neg_add, zpow_add]
  simp only [mul_assoc, mul_left_comm]

/-- The exponent `m` in the decomposition `x = u π^m` (chosen). -/
private noncomputable def decompExp (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π) (x : Lˣ) : ℤ :=
  (exists_unique_decomposition h26 L hL hπ x).exists.choose

private theorem decompExp_spec (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π) (x : Lˣ) :
    x * embUnits L (primeUnit hπ) ^ (-decompExp h26 L hL hπ x) ∈ unitsL L :=
  (exists_unique_decomposition h26 L hL hπ x).exists.choose_spec

private theorem decompExp_eq (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π) (x : Lˣ) {m : ℤ}
    (h : x * embUnits L (primeUnit hπ) ^ (-m) ∈ unitsL L) : decompExp h26 L hL hπ x = m :=
  (exists_unique_decomposition h26 L hL hπ x).unique (decompExp_spec h26 L hL hπ x) h

/-- The projection `L^× → U_L`, `x ↦ x π^(-m(x))`. -/
private noncomputable def decompProj (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π) : Lˣ →* unitsL L where
  toFun x := ⟨x * embUnits L (primeUnit hπ) ^ (-decompExp h26 L hL hπ x), decompExp_spec h26 L hL hπ x⟩
  map_one' := by
    apply Subtype.ext
    have : decompExp h26 L hL hπ 1 = 0 := decompExp_eq h26 L hL hπ 1 (by simp)
    simp [this]
  map_mul' x y := by
    apply Subtype.ext
    have : decompExp h26 L hL hπ (x * y) = decompExp h26 L hL hπ x + decompExp h26 L hL hπ y :=
      decompExp_eq h26 L hL hπ _ (by
        have := Subgroup.mul_mem _ (decompExp_spec h26 L hL hπ x) (decompExp_spec h26 L hL hπ y)
        convert this using 1
        exact decompKey _ _ _ _ _)
    simp only [this, Subgroup.coe_mul]
    exact decompKey _ _ _ _ _

private theorem decompProj_smul (h26 : UnitPrimeDecomposition K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] [IsGalois K L] (hL : IsUnramifiedExt L) {π : 𝒪[K]} (hπ : Irreducible π)
    (σ : Gal(L/K)) (x : Lˣ) :
    decompProj h26 L hL hπ (σ • x) = σ • decompProj h26 L hL hπ x := by
  have hm : decompExp h26 L hL hπ (σ • x) = decompExp h26 L hL hπ x := by
    apply decompExp_eq
    have h := gal_smul_mem_unitsL σ (decompExp_spec h26 L hL hπ x)
    convert h using 1
    rw [smul_mul', smul_zpow', gal_smul_embUnits]
  apply Subtype.ext
  show (σ • x) * _ = σ • (x * _)
  rw [hm, smul_mul', smul_zpow', gal_smul_embUnits]

/-- **Proposition 1.1** (p. 97). Let $L/K$ be a finite unramified extension with Galois group $G$, and $U_L$ the
group of units of $L$. Then $H^r_T(G, U_L) = 0$ for all $r \in \mathbb Z$. Milne's proof, from (26)
(`UnitPrimeDecomposition`: $U_L$ is a $G$-direct summand of $L^\times$, so $H^1(G, U_L) = 0$ by Hilbert's Theorem 90),
Proposition 1.2 ($H^0_T(G, U_L) = U_K/\mathrm{Nm}(U_L) = 0$) and periodicity ($G$ cyclic, `UnramifiedCyclic`). -/
@[kb "milne2020cft" "v4.03, Ch. III, Prop. 1.1, p. 97"]
theorem prop_1_1 (h26 : UnitPrimeDecomposition K Ω) (hcyc : UnramifiedCyclic K Ω)
    (L : IntermediateField K Ω) [FiniteDimensional K L] [IsGalois K L] (hL : IsUnramifiedExt L) (r : ℤ) :
    IsZero (tateCohomology (unitsRep L) r) := by
  have : IsCyclic Gal(L/K) := by
    obtain ⟨σ, -, h⟩ := hcyc.frob_generates L hL
    exact ⟨σ, h⟩
  obtain ⟨π, hπ⟩ := IsDiscreteValuationRing.exists_irreducible 𝒪[K]
  refine tate_isZero_of_cyclic _ ?_ ?_ r
  · -- degree 0
    apply tate_zero_isZero_of_norm
    intro m hm
    obtain ⟨m0, hm0⟩ : ∃ m0 : unitsL L, m = Additive.ofMul m0 := ⟨Additive.toMul m, rfl⟩
    rw [hm0] at hm ⊢
    have hfix : ∀ σ : Gal(L/K), σ • (m0 : Lˣ) = m0 := by
      intro σ
      have h2 : σ • m0 = m0 := congrArg Additive.toMul (hm σ)
      exact congrArg Subtype.val h2
    obtain ⟨a, ha, hau⟩ := mem_unitGroup_of_fixed L _ (m0).2 hfix
    obtain ⟨v, hv, hnv⟩ := prop1_2.surj L hL a ha
    refine ⟨(Additive.ofMul (⟨v, hv⟩ : unitsL L) : unitsRep L), ?_⟩
    have key : ∏ g : Gal(L/K), g • (⟨v, hv⟩ : unitsL L) = m0 := by
      apply Subtype.ext
      apply Units.ext
      rw [show (((∏ g : Gal(L/K), g • (⟨v, hv⟩ : unitsL L) : unitsL L) : Lˣ) : L) =
          (((∏ g : Gal(L/K), ((g • (⟨v, hv⟩ : unitsL L) : unitsL L) : Lˣ)) : Lˣ) : L) from
        congrArg (fun z : Lˣ => (z : L)) (map_prod (unitsL L).subtype _ _), Units.coe_prod]
      have h3 := Algebra.norm_eq_prod_automorphisms K (v : L)
      have h4 : algebraMap K L (Algebra.norm K (v : L)) = ((m0 : Lˣ) : L) := by
        rw [← hau, ← hnv]; rfl
      rw [← h4, h3]
      rfl
    change (∑ g : Gal(L/K), Additive.ofMul (g • (⟨v, hv⟩ : unitsL L)) : Additive (unitsL L)) = Additive.ofMul m0
    rw [← ofMul_prod, key]
  · -- degree 1
    refine IsZero.of_iso ?_ ((TateCohomology.isoGroupCohomology (R := ℤ) (G := Gal(L/K)) 1).app _)
    let ψ := decompProj h26 L hL hπ
    let rr : Rep.ofAlgebraAutOnUnits K L ⟶ unitsRep L :=
      Rep.ofHom ⟨AddMonoidHom.toIntLinearMap (MonoidHom.toAdditive ψ), fun σ => by
        refine LinearMap.ext fun x => ?_
        apply Additive.toMul.injective
        exact decompProj_smul h26 L hL hπ σ x.toMul⟩
    refine isZero_groupCohomology_of_retraction (unitsIncl L) rr ?_ 1 ?_
    · ext u
      have h0 : decompExp h26 L hL hπ ((Additive.toMul u : unitsL L) : Lˣ) = 0 :=
        decompExp_eq h26 L hL hπ _ (by simp)
      show (MonoidHom.toAdditive ψ) (Additive.ofMul ((Additive.toMul u : unitsL L) : Lˣ)) = u
      apply Additive.toMul.injective
      apply Subtype.ext
      show _ * _ = _
      simp [h0]
    · exact @ModuleCat.isZero_of_subsingleton _ _ (H1 (Rep.ofAlgebraAutOnUnits K L)) inferInstance

end NumberFieldKB.MilneCFT.Ch3
