import Mathlib
import QuadFormsKB.Citation

/-!
# Milne, *Algebraic Number Theory*, Lemma 6.5: integers of a compositum

Source: J. S. Milne, *Algebraic Number Theory*, course notes, version 3.08 (2020), bib key `milne2020ant`.

* **Lemma 6.5** (`lemma_6_5`): if $[KL:\mathbb Q] = [K:\mathbb Q][L:\mathbb Q]$ and $d = \gcd(\operatorname{disc}
  \mathcal O_K, \operatorname{disc} \mathcal O_L)$, then $\mathcal O_{KL} \subset d^{-1}\mathcal O_K\mathcal O_L$.
-/

open NumberField IntermediateField

namespace NumberFieldKB.MilneANT

/-- Coordinates over the second field: if $K_1K_2 = E$ with $K_2$ and $K_1$ linearly disjoint over
$\mathbb Q$, an integral element $\gamma$ of $E$ is $\sum_i \alpha_i x_i$ with $x_i \in K_2$ and
$\operatorname{disc}(K_1)\, x_i$ integral, where $(\alpha_i)$ is an integral basis of $K_1$ (Cramer's rule applied
to the trace form). -/
lemma lemma_6_5_coords {E : Type*} [Field E] [NumberField E] (K₁ K₂ : IntermediateField ℚ E)
    (htop : K₁ ⊔ K₂ = ⊤)
    (hLD : K₂.LinearDisjoint K₁) {γ : E} (hγi : IsIntegral ℤ γ) :
    ∃ x : Module.Free.ChooseBasisIndex ℤ (𝓞 K₁) → E,
      (∀ i, x i ∈ K₂ ∧ IsIntegral ℤ ((discr K₁ : E) * x i)) ∧
      γ = ∑ i, ((RingOfIntegers.basis K₁ i : K₁) : E) * x i := by
  classical
  set b := RingOfIntegers.basis K₁ with hb
  set q := integralBasis K₁ with hq
  have H' : K₂.toSubalgebra ⊔ K₁.toSubalgebra = ⊤ := by
    have := congr(toSubalgebra $(sup_comm K₁ K₂ ▸ htop))
    simpa [sup_toSubalgebra_of_isAlgebraic_right] using this
  have h2 : K₂ ⊔ K₁ = ⊤ := by rwa [sup_comm]
  let bb : Module.Basis _ K₂ E := hLD.basisOfBasisRight H' q
  have hbb : ∀ i, bb i = ((b i : K₁) : E) := by
    intro i
    simp [bb, hq]
    rfl
  let T : Matrix _ _ ℤ := Algebra.traceMatrix ℤ b
  have hdet : T.det = discr K₁ := rfl
  have hT : ∀ i k, Algebra.trace K₂ E (bb i * bb k) = algebraMap ℤ K₂ (T i k) := by
    intro i k
    have h1 : bb i * bb k = algebraMap K₁ E (q i * q k) := by
      simp [hbb, hq]
      rfl
    rw [h1, hLD.trace_algebraMap h2]
    have h3 : algebraMap ℤ ℚ (T i k) = Algebra.trace ℚ K₁ (q i * q k) := by
      have := Algebra.algebraMap_intTrace (A := ℤ) (K := ℚ) (L := K₁) (B := 𝓞 K₁) (b i * b k)
      rw [Algebra.intTrace_eq_trace] at this
      simp only [T, Algebra.traceMatrix_apply, Algebra.traceForm_apply]
      rw [this]
      simp [hq]
      rfl
    rw [← h3]
    simp
  set x : _ → K₂ := fun i => bb.repr γ i with hx
  have hγ : γ = ∑ i, ((b i : K₁) : E) * (x i : E) := by
    conv_lhs => rw [← bb.sum_repr γ]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [hbb, mul_comm]
    rfl
  set t : _ → K₂ := fun k => Algebra.trace K₂ E (γ * bb k) with ht
  have ht' : ∀ k, t k = ∑ i, x i * algebraMap ℤ K₂ (T i k) := by
    intro k
    have : γ * bb k = ∑ i, x i • (bb i * bb k) := by
      conv_lhs => rw [← bb.sum_repr γ]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_mul_assoc]
    simp only [ht]
    rw [this, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, hT, smul_eq_mul]
  have hint : ∀ k, IsIntegral ℤ (t k : E) := by
    intro k
    have h1 : IsIntegral ℤ (γ * bb k) := by
      refine hγi.mul ?_
      rw [hbb]
      exact (RingOfIntegers.isIntegral_coe (b k)).map (K₁.val.toRingHom.toIntAlgHom)
    have := Algebra.isIntegral_trace (R := ℤ) (L := K₂) h1
    exact (this.map (K₂.val.toRingHom.toIntAlgHom))
  have e : ∀ i j, ∑ k, T i k * T.adjugate k j = if i = j then T.det else 0 := by
    intro i j
    have := congr_fun (congr_fun (Matrix.mul_adjugate T) i) j
    simpa [Matrix.mul_apply, Matrix.one_apply, Matrix.smul_apply] using this
  refine ⟨fun i => (x i : E), fun j => ⟨(x j).2, ?_⟩, hγ⟩
  have key : algebraMap ℤ K₂ T.det * x j = ∑ k, algebraMap ℤ K₂ (T.adjugate k j) * t k := by
    simp_rw [ht', Finset.mul_sum]
    rw [Finset.sum_comm]
    have : ∀ i, ∑ k, algebraMap ℤ K₂ (T.adjugate k j) * (x i * algebraMap ℤ K₂ (T i k))
        = x i * algebraMap ℤ K₂ (if i = j then T.det else 0) := by
      intro i
      rw [← e, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      rw [map_mul]; ring
    simp_rw [this]
    simp [mul_comm]
  have key' : ((discr K₁ : E) * (x j : E)) = ∑ k, (T.adjugate k j) * (t k : E) := by
    have := congr_arg (fun y : K₂ => (y : E)) key
    simpa [← hdet] using this
  rw [key']
  exact IsIntegral.sum _ fun k _ => isIntegral_algebraMap.mul (hint k)

/-- The additive group (a $\mathbb Z$-submodule) generated by products of integers of two subfields. -/
def prodSpan {E : Type*} [Field E] [NumberField E] (K₁ K₂ : IntermediateField ℚ E) : Submodule ℤ E :=
  Submodule.span ℤ (Set.image2 (· * ·) {a : E | a ∈ K₁ ∧ IsIntegral ℤ a}
    {b : E | b ∈ K₂ ∧ IsIntegral ℤ b})

/-- Case where the compositum is the whole field. -/
lemma lemma_6_5_top {E : Type*} [Field E] [NumberField E] (K₁ K₂ : IntermediateField ℚ E)
    (htop : K₁ ⊔ K₂ = ⊤) (hLD : K₂.LinearDisjoint K₁) {γ : E} (hγi : IsIntegral ℤ γ) :
    (discr K₁ : E) * γ ∈ prodSpan K₁ K₂ := by
  obtain ⟨x, hx, hγ⟩ := lemma_6_5_coords K₁ K₂ htop hLD hγi
  have : (discr K₁ : E) * γ = ∑ i, ((RingOfIntegers.basis K₁ i : K₁) : E) * ((discr K₁ : E) * x i) := by
    conv_lhs => rw [hγ, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    ring
  rw [this]
  refine Submodule.sum_mem _ fun i _ => Submodule.subset_span ?_
  exact ⟨_, ⟨(RingOfIntegers.basis K₁ i : K₁).2, (RingOfIntegers.isIntegral_coe _).map
    (K₁.val.toRingHom.toIntAlgHom)⟩, _, ⟨K₂.mul_mem (K₂.intCast_mem _) (hx i).1, (hx i).2⟩, rfl⟩

/-- Reduction to the case where the compositum is the whole field. -/
lemma lemma_6_5_left {E : Type*} [Field E] [NumberField E] (K₁ K₂ : IntermediateField ℚ E)
    (hdeg : Module.finrank ℚ ↥(K₁ ⊔ K₂) = Module.finrank ℚ K₁ * Module.finrank ℚ K₂)
    {γ : E} (hγ : γ ∈ K₁ ⊔ K₂) (hγi : IsIntegral ℤ γ) :
    (discr K₁ : E) * γ ∈ prodSpan K₁ K₂ := by
  set L := K₁ ⊔ K₂ with hL
  have h₁ : K₁ ≤ L := le_sup_left
  have h₂ : K₂ ≤ L := le_sup_right
  let K₁' := IntermediateField.restrict h₁
  let K₂' := IntermediateField.restrict h₂
  have htop : K₁' ⊔ K₂' = ⊤ := by
    rw [eq_top_iff]
    intro y _
    have hy : y.1 ∈ IntermediateField.lift (K₁' ⊔ K₂') := by
      have hle : K₁ ⊔ K₂ ≤ IntermediateField.lift (K₁' ⊔ K₂') := by
        refine sup_le ?_ ?_
        · intro z hz
          exact (IntermediateField.mem_lift (E := K₁' ⊔ K₂') ⟨z, h₁ hz⟩).2
            ((le_sup_left : K₁' ≤ K₁' ⊔ K₂') ((IntermediateField.mem_restrict h₁ ⟨z, h₁ hz⟩).2 hz))
        · intro z hz
          exact (IntermediateField.mem_lift (E := K₁' ⊔ K₂') ⟨z, h₂ hz⟩).2
            ((le_sup_right : K₂' ≤ K₁' ⊔ K₂') ((IntermediateField.mem_restrict h₂ ⟨z, h₂ hz⟩).2 hz))
      exact hle y.2
    exact (IntermediateField.mem_lift y).1 hy
  have e₁ := IntermediateField.restrictAlgEquiv h₁
  have e₂ := IntermediateField.restrictAlgEquiv h₂
  have hd : discr K₁ = discr K₁' := discr_eq_discr_of_algEquiv _ e₁
  have hfr : Module.finrank ℚ L = Module.finrank ℚ K₁' * Module.finrank ℚ K₂' := by
    rw [← e₁.toLinearEquiv.finrank_eq, ← e₂.toLinearEquiv.finrank_eq]; exact hdeg
  have hLD : K₂'.LinearDisjoint K₁' := by
    refine IntermediateField.LinearDisjoint.of_finrank_sup ?_
    rw [sup_comm, htop, IntermediateField.finrank_top', hfr, mul_comm]
  have hI : ∀ z : L, IsIntegral ℤ (z : E) ↔ IsIntegral ℤ z := fun z =>
    isIntegral_algebraMap_iff (R := ℤ) (A := L) (B := E) (x := z)
  have hint' : IsIntegral ℤ (⟨γ, hγ⟩ : L) := (hI ⟨γ, hγ⟩).mp hγi
  have := lemma_6_5_top K₁' K₂' htop hLD hint'
  rw [← hd] at this
  have key : ∀ z ∈ prodSpan K₁' K₂', z.1 ∈ prodSpan K₁ K₂ := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨a, ⟨ha, hai⟩, b, ⟨hb, hbi⟩, rfl⟩ := hz
      refine Submodule.subset_span ⟨a.1, ⟨(IntermediateField.mem_restrict h₁ a).1 ha,
        (hI a).mpr hai⟩, b.1,
        ⟨(IntermediateField.mem_restrict h₂ b).1 hb,
        (hI b).mpr hbi⟩, rfl⟩
    | zero => exact Submodule.zero_mem _
    | add x y _ _ hx hy => exact Submodule.add_mem _ hx hy
    | smul n x _ hx => exact Submodule.smul_mem _ n hx
  exact key _ this

/-- **Lemma 6.5.** Let $K$ and $L$ be finite extensions of $\mathbb Q$ (here: subfields $K_1$, $K_2$ of a number
field $E$, which loses nothing since one can take $E = K_1K_2$) such that
$[K_1K_2:\mathbb Q] = [K_1:\mathbb Q][K_2:\mathbb Q]$, and let $d$ be the greatest common divisor of
$\operatorname{disc}(\mathcal O_{K_1}/\mathbb Z)$ and $\operatorname{disc}(\mathcal O_{K_2}/\mathbb Z)$. Then
$\mathcal O_{K_1K_2} \subset d^{-1}\mathcal O_{K_1}\mathcal O_{K_2}$: for every algebraic integer $\gamma$ of
$K_1K_2$, $d\gamma$ is a $\mathbb Z$-linear combination of products $ab$ with $a \in \mathcal O_{K_1}$ and
$b \in \mathcal O_{K_2}$ (the ring $\mathcal O_{K_1}\mathcal O_{K_2}$ is the additive group generated by such
products). -/
@[kb "milne2020ant" "v3.08, Lemma 6.5, p. 100"]
theorem lemma_6_5 {E : Type*} [Field E] [NumberField E] (K₁ K₂ : IntermediateField ℚ E)
    (hdeg : Module.finrank ℚ ↥(K₁ ⊔ K₂) = Module.finrank ℚ K₁ * Module.finrank ℚ K₂)
    {γ : E} (hγ : γ ∈ K₁ ⊔ K₂) (hγi : IsIntegral ℤ γ) :
    ((Int.gcd (discr K₁) (discr K₂) : ℤ) : E) * γ ∈
      Submodule.span ℤ (Set.image2 (· * ·) {a : E | a ∈ K₁ ∧ IsIntegral ℤ a}
        {b : E | b ∈ K₂ ∧ IsIntegral ℤ b}) := by
  have h1 : (discr K₁ : E) * γ ∈ prodSpan K₁ K₂ := lemma_6_5_left K₁ K₂ hdeg hγ hγi
  have h2' : (discr K₂ : E) * γ ∈ prodSpan K₂ K₁ :=
    lemma_6_5_left K₂ K₁ (by rw [sup_comm, hdeg, mul_comm]) (by rwa [sup_comm]) hγi
  have h2 : (discr K₂ : E) * γ ∈ prodSpan K₁ K₂ := by
    refine (Submodule.span_le.2 ?_ : prodSpan K₂ K₁ ≤ prodSpan K₁ K₂) h2'
    rintro _ ⟨a, ha, b, hb, rfl⟩
    exact Submodule.subset_span ⟨b, hb, a, ha, mul_comm _ _⟩
  have hg : ((Int.gcd (discr K₁) (discr K₂) : ℤ) : E) * γ =
      Int.gcdA (discr K₁) (discr K₂) • ((discr K₁ : E) * γ) +
        Int.gcdB (discr K₁) (discr K₂) • ((discr K₂ : E) * γ) := by
    have := Int.gcd_eq_gcd_ab (discr K₁) (discr K₂)
    rw [zsmul_eq_mul, zsmul_eq_mul]
    rw [← mul_assoc, ← mul_assoc, ← add_mul]
    congr 1
    have h3 := this
    rw [mul_comm (discr K₁), mul_comm (discr K₂)] at h3
    exact_mod_cast h3
  rw [hg]
  exact Submodule.add_mem _ (Submodule.smul_mem _ _ h1) (Submodule.smul_mem _ _ h2)

end NumberFieldKB.MilneANT
