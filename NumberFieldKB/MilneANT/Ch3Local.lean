/-!
# Milne, *Algebraic Number Theory*, Chapter 3: localization and fractional ideals

Source: J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), bib key `milne2020ant`; printed page numbers.

* **Lemma 3.10** (`lemma_3_10`): $A/\mathfrak p^m \cong A_{\mathfrak p}/\mathfrak q^m$ for $\mathfrak p$ maximal,
  $\mathfrak q = \mathfrak pA_{\mathfrak p}$.
* **Remark 3.11** (`remark_3_11`): $(\mathfrak p^m)^{ec} = \mathfrak p^m$ for $S = A \setminus \mathfrak p$.
* **Corollary 3.17** (`cor_3_17_principal`, `cor_3_17_coprime`, `cor_3_17_element`).
* **Example 3.19** (`example_3_19`): the fractional ideals of a discrete valuation ring are the $(\pi^m)$,
  $m \in \mathbb Z$, a free abelian group of rank one.
* **Proposition 3.23** (`prop_3_23`): $\mathfrak a \mapsto S^{-1}\mathfrak a$ is an isomorphism from the subgroup of
  $\mathrm{Id}(A)$ generated by the primes not meeting $S$ onto $\mathrm{Id}(S^{-1}A)$.
* **Remark 3.24** (`remark_3_24`): a Dedekind domain with finite class group becomes a principal ideal domain after
  inverting one nonzero element.

Milne's group $\mathrm{Id}(A)$ of (nonzero) fractional ideals of a Dedekind domain $A$ with field of fractions $K$
is `(FractionalIdeal (nonZeroDivisors A) K)ˣ`.
-/

open scoped nonZeroDivisors

namespace NumberFieldKB.MilneANT

/-- **Remark 3.11.** For a power $\mathfrak a = \mathfrak p^m$ of a maximal ideal $\mathfrak p$ of an integral domain $A$
and $S = A \setminus \mathfrak p$, extension to $S^{-1}A = A_{\mathfrak p}$ followed by contraction returns
$\mathfrak a$: $\mathfrak a^{ec} = \mathfrak a$. -/
@[kb "milne2020ant" "v3.08, Remark 3.11, p. 50"]
theorem remark_3_11 {A : Type*} [CommRing A] [IsDomain A] (p : Ideal A) [p.IsMaximal] (m : ℕ) :
    ((p ^ m).map (algebraMap A (Localization.AtPrime p))).comap (algebraMap A (Localization.AtPrime p)) =
      p ^ m := by
  rcases Nat.eq_zero_or_pos m with rfl | hm
  · simp [Ideal.map_top]
  have hprim : (p ^ m).IsPrimary := by
    apply Ideal.isPrimary_of_isMaximal_radical
    rw [Ideal.radical_pow p hm.ne', Ideal.IsPrime.radical (Ideal.IsMaximal.isPrime ‹_›)]
    exact inferInstance
  refine IsLocalization.under_map_of_isPrimary_disjoint p.primeCompl _ hprim ?_
  rw [Set.disjoint_left]
  intro x hx hx'
  exact hx (Ideal.pow_le_self hm.ne' hx')

/-- **Lemma 3.10.** Let $\mathfrak p$ be a maximal ideal of an integral domain $A$ and
$\mathfrak q = \mathfrak pA_{\mathfrak p}$. For every $m \in \mathbb N$ the map
$a + \mathfrak p^m \mapsto a + \mathfrak q^m$ is a ring isomorphism $A/\mathfrak p^m \to A_{\mathfrak p}/\mathfrak q^m$. -/
@[kb "milne2020ant" "v3.08, Lemma 3.10, p. 49"]
theorem lemma_3_10 {A : Type*} [CommRing A] [IsDomain A] (p : Ideal A) [p.IsMaximal] (m : ℕ) :
    ∃ e : (A ⧸ p ^ m) ≃+* (Localization.AtPrime p ⧸ (p.map (algebraMap A (Localization.AtPrime p))) ^ m),
      ∀ a : A, e (Ideal.Quotient.mk _ a) = Ideal.Quotient.mk _ (algebraMap A (Localization.AtPrime p) a) := by
  set L := Localization.AtPrime p
  have hc := remark_3_11 p m
  have hmap : (p.map (algebraMap A L)) ^ m = (p ^ m).map (algebraMap A L) := (Ideal.map_pow _ _ _).symm
  have H : p ^ m ≤ ((p.map (algebraMap A L)) ^ m).comap (algebraMap A L) := by
    rw [hmap, hc]
  let f := Ideal.quotientMap ((p.map (algebraMap A L)) ^ m) (algebraMap A L) H
  have hinj : Function.Injective f := by
    apply Ideal.quotientMap_injective' (H := H)
    rw [hmap, hc]
  have hsurj : Function.Surjective f := by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    obtain ⟨a, s, hx⟩ := IsLocalization.exists_mk'_eq p.primeCompl x
    have hs : (s : A) ∉ p := s.2
    have hcop : IsCoprime (p ^ m) (Ideal.span {(s : A)}) := by
      apply IsCoprime.pow_left
      rw [Ideal.isCoprime_iff_sup_eq]
      exact (Ideal.IsMaximal.out).2 _ (lt_of_le_of_ne le_sup_left fun h =>
        hs (by
          have h3 : (s : A) ∈ p ⊔ Ideal.span {(s : A)} := Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
          rwa [← h] at h3))
    rw [Ideal.isCoprime_iff_sup_eq] at hcop
    have h1 : (1 : A) ∈ p ^ m ⊔ Ideal.span {(s : A)} := by rw [hcop]; trivial
    rw [Submodule.mem_sup] at h1
    obtain ⟨u, hu, v, hv, huv⟩ := h1
    obtain ⟨t, rfl⟩ := Ideal.mem_span_singleton'.mp hv
    refine ⟨Ideal.Quotient.mk _ (a * t), ?_⟩
    simp only [f, Ideal.quotientMap_mk]
    rw [Ideal.Quotient.eq]
    have hxs : x * algebraMap A L s = algebraMap A L a := by
      rw [← hx]; exact IsLocalization.mk'_spec _ _ _
    have : algebraMap A L (a * t) - x = - (x * algebraMap A L u) := by
      have h2 : u = 1 - t * s := by rw [← huv]; ring
      rw [h2]
      simp only [map_mul, map_sub, map_one]
      rw [← hxs]; ring
    rw [this]
    refine Ideal.neg_mem_iff _ |>.mpr (Ideal.mul_mem_left _ _ ?_)
    rw [hmap]
    exact Ideal.mem_map_of_mem _ hu
  refine ⟨RingEquiv.ofBijective f ⟨hinj, hsurj⟩, fun a => ?_⟩
  show f (Ideal.Quotient.mk _ a) = _
  simp only [f, Ideal.quotientMap_mk]
  rfl

/-- **Corollary 3.17**, third statement. For any nonzero $a \in \mathfrak a$, the ideal $\mathfrak a^*$ can be chosen
with $\mathfrak a\mathfrak a^* = (a)$. -/
@[kb "milne2020ant" "v3.08, Cor. 3.17, p. 52"]
theorem cor_3_17_element {A : Type*} [CommRing A] [IsDedekindDomain A] (a : Ideal A) (x : A) (hx : x ∈ a)
    (hx0 : x ≠ 0) : ∃ a' : Ideal A, a * a' = Ideal.span {x} := by
  obtain ⟨a', h⟩ := Ideal.dvd_iff_le.mpr ((Ideal.span_singleton_le_iff_mem a).mpr hx)
  exact ⟨a', h.symm⟩

/-- **Corollary 3.17**, first statement. For a nonzero ideal $\mathfrak a$ of a Dedekind domain $A$ there is a nonzero
ideal $\mathfrak a^*$ with $\mathfrak a\mathfrak a^*$ principal. -/
@[kb "milne2020ant" "v3.08, Cor. 3.17, p. 52"]
theorem cor_3_17_principal {A : Type*} [CommRing A] [IsDedekindDomain A] (a : Ideal A) (ha : a ≠ ⊥) :
    ∃ a' : Ideal A, a' ≠ ⊥ ∧ (a * a').IsPrincipal := by
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot ha
  obtain ⟨a', h⟩ := cor_3_17_element a x hx hx0
  refine ⟨a', ?_, ⟨⟨x, by rw [h]⟩⟩⟩
  rintro rfl
  rw [Ideal.mul_bot] at h
  exact hx0 (by simpa using h.symm)

/-- **Corollary 3.17**, second statement. The ideal $\mathfrak a^*$ with $\mathfrak a\mathfrak a^*$ principal can be
chosen relatively prime to any given nonzero ideal $\mathfrak c$.

*Update:* Milne says "any particular ideal $\mathfrak c$"; $\mathfrak c \ne 0$ is needed (for $\mathfrak c = 0$
coprimality forces $\mathfrak a^* = A$, so $\mathfrak a$ itself would be principal), and Milne's proof uses it
($\mathfrak a \supsetneq \mathfrak a\mathfrak c$). -/
@[kb "milne2020ant" "v3.08, Cor. 3.17, p. 52"]
theorem cor_3_17_coprime {A : Type*} [CommRing A] [IsDedekindDomain A] (a : Ideal A) (ha : a ≠ ⊥)
    (c : Ideal A) (hc : c ≠ ⊥) :
    ∃ a' : Ideal A, a' ≠ ⊥ ∧ (a * a').IsPrincipal ∧ IsCoprime a' c := by
  by_cases hct : c = ⊤
  · obtain ⟨a', h1, h2⟩ := cor_3_17_principal a ha
    exact ⟨a', h1, h2, Ideal.isCoprime_iff_sup_eq.mpr (by rw [hct]; exact sup_top_eq _)⟩
  have hac : a * c ≠ ⊥ := mul_ne_zero ha hc
  obtain ⟨x, hx⟩ := IsDedekindDomain.exists_sup_span_eq (I := a * c) (J := a) Ideal.mul_le_left hac
  have hxa : x ∈ a := by
    rw [← hx]; exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [Ideal.span_singleton_eq_bot.mpr rfl, sup_bot_eq] at hx
    apply hct
    have : a * c = a * ⊤ := by rw [Ideal.mul_top, hx]
    exact mul_left_cancel₀ ha this
  obtain ⟨a', h⟩ := cor_3_17_element a x hxa hx0
  refine ⟨a', ?_, ⟨⟨x, by rw [h]⟩⟩, ?_⟩
  · rintro rfl
    rw [Ideal.mul_bot] at h
    exact hx0 (by simpa using h.symm)
  · rw [Ideal.isCoprime_iff_sup_eq, sup_comm]
    have : a * (c ⊔ a') = a * ⊤ := by
      rw [Ideal.mul_top, Ideal.mul_sup, h, hx]
    exact mul_left_cancel₀ ha this

/-- **Example 3.19.** Let $A$ be a discrete valuation ring with field of fractions $K$ and $\pi$ a generator of its
maximal ideal. Then $m \mapsto (\pi^m)$ is an isomorphism from $\mathbb Z$ onto the group $\mathrm{Id}(A)$ of
fractional ideals of $A$: the fractional ideals are exactly the $(\pi^m)$, $m \in \mathbb Z$, and they form a free
abelian group of rank $1$. -/
@[kb "milne2020ant" "v3.08, Example 3.19, p. 53"]
theorem example_3_19 {A K : Type*} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A] [Field K]
    [Algebra A K] [IsFractionRing A K] (π : A) (hπ : Irreducible π) :
    ∃ e : Multiplicative ℤ ≃* (FractionalIdeal A⁰ K)ˣ, ∀ m : ℤ,
      ((e (Multiplicative.ofAdd m) : (FractionalIdeal A⁰ K)ˣ) : FractionalIdeal A⁰ K) =
        FractionalIdeal.spanSingleton A⁰ (algebraMap A K π ^ m) := by
  have hπ0 : algebraMap A K π ≠ 0 := by
    rw [map_ne_zero_iff _ (IsFractionRing.injective A K)]; exact hπ.ne_zero
  let u : Kˣ := Units.mk0 _ hπ0
  let f : Multiplicative ℤ →* (FractionalIdeal A⁰ K)ˣ :=
    (Units.map (FractionalIdeal.spanSingleton A⁰ (P := K)).toMonoidHom).comp (zpowersHom Kˣ u)
  have hf : ∀ m : ℤ, ((f (Multiplicative.ofAdd m) : (FractionalIdeal A⁰ K)ˣ) : FractionalIdeal A⁰ K) =
        FractionalIdeal.spanSingleton A⁰ (algebraMap A K π ^ m) := by
    intro m
    simp [f, u]
  have key : ∀ (n : ℕ) (z : Aˣ), n ≠ 0 → (z : A) ≠ π ^ n := by
    intro n z hn h
    apply hπ.not_isUnit
    exact (isUnit_pow_iff hn).mp (h ▸ z.isUnit)
  have key2 : ∀ (n : ℕ) (z : Aˣ), n ≠ 0 → (z : A) * π ^ n ≠ 1 := by
    intro n z hn h
    apply hπ.not_isUnit
    refine (isUnit_pow_iff hn).mp (isUnit_iff_exists_inv.mpr ⟨(z : A), by rwa [mul_comm] at h⟩)
  have hinj : Function.Injective f := by
    rw [injective_iff_map_eq_one]
    intro g hg
    obtain ⟨m, hm0⟩ : ∃ m : ℤ, m = Multiplicative.toAdd g := ⟨_, rfl⟩
    have hgm : Multiplicative.ofAdd m = g := by rw [hm0]; rfl
    suffices hm : m = 0 by rw [← hgm, hm]; rfl
    have h1 := hf m
    rw [hgm, hg] at h1
    have h2 : FractionalIdeal.spanSingleton A⁰ (1 : K) =
        FractionalIdeal.spanSingleton A⁰ (algebraMap A K π ^ m) := by
      rw [map_one]; exact h1
    obtain ⟨z, hz⟩ := FractionalIdeal.spanSingleton_eq_spanSingleton.mp h2
    have hz' : algebraMap A K (z : A) = algebraMap A K π ^ m := by
      have := hz
      simp only [Units.smul_def, Algebra.smul_def, mul_one] at this
      exact this
    rcases Int.eq_nat_or_neg m with ⟨n, rfl | rfl⟩
    · by_contra hne
      have hn : n ≠ 0 := by
        rintro rfl; apply hne; rfl
      apply key n z hn
      apply IsFractionRing.injective A K
      simpa using hz'
    · by_contra hne
      have hn : n ≠ 0 := by
        rintro rfl; apply hne; simp
      apply key2 n z hn
      apply IsFractionRing.injective A K
      rw [zpow_neg, zpow_natCast] at hz'
      have hpn : algebraMap A K π ^ n ≠ 0 := pow_ne_zero _ hπ0
      simp only [map_mul, map_pow, map_one]
      rw [hz']
      exact inv_mul_cancel₀ hpn
  have hsurj : Function.Surjective f := by
    intro I
    obtain ⟨x, hx⟩ := (FractionalIdeal.isPrincipal_iff (I : FractionalIdeal A⁰ K)).mp
      (FractionalIdeal.isPrincipal (I : FractionalIdeal A⁰ K))
    have hI0 : (I : FractionalIdeal A⁰ K) ≠ 0 := I.ne_zero
    have hx0 : x ≠ 0 := by
      rintro rfl
      apply hI0
      rw [hx]; exact map_zero _
    obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective (A := A) x
    have hb0 : (b : A) ≠ 0 := nonZeroDivisors.ne_zero hb
    have ha0 : a ≠ 0 := by
      rintro rfl; apply hx0; simp
    obtain ⟨n1, e1, he1⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible ha0 hπ
    obtain ⟨n2, e2, he2⟩ := IsDiscreteValuationRing.eq_unit_mul_pow_irreducible hb0 hπ
    refine ⟨Multiplicative.ofAdd ((n1 : ℤ) - n2), Units.ext ?_⟩
    rw [hf, hx]
    apply FractionalIdeal.spanSingleton_eq_spanSingleton.mpr
    refine ⟨e1 * e2⁻¹, ?_⟩
    have hπ' : algebraMap A K π ≠ 0 := hπ0
    have he2' : algebraMap A K (e2 : A) ≠ 0 := by
      rw [map_ne_zero_iff _ (IsFractionRing.injective A K)]; exact e2.ne_zero
    simp only [Units.smul_def, Algebra.smul_def, he1, he2, map_mul, map_pow, Units.val_mul,
      zpow_sub₀ hπ', zpow_natCast]
    have : algebraMap A K (e2 : A) * algebraMap A K π ^ n2 ≠ 0 :=
      mul_ne_zero he2' (pow_ne_zero _ hπ')
    have hpn1 : algebraMap A K π ^ n2 ≠ 0 := pow_ne_zero _ hπ'
    field_simp
    rw [← map_mul, Units.inv_mul, map_one]
  refine ⟨MulEquiv.ofBijective f ⟨hinj, hsurj⟩, fun m => ?_⟩
  exact hf m

section P323

open IsDedekindDomain

set_option linter.unusedSectionVars false
set_option linter.overlappingInstances false

variable {A K B : Type*} [CommRing A] [IsDedekindDomain A] [Field K] [Algebra A K]
    [IsFractionRing A K] (S : Submonoid A) (hS : S ≤ A⁰) [CommRing B] [Algebra A B]
    [IsLocalization S B] [Algebra B K] [IsScalarTower A B K] [IsFractionRing B K]
    [IsDedekindDomain B]

include hS

lemma p323_hf : A⁰ ≤ Submonoid.comap (algebraMap A B) B⁰ := by
  intro a ha
  show algebraMap A B a ∈ B⁰
  exact mem_nonZeroDivisors_of_ne_zero
    ((map_ne_zero_iff _ (IsLocalization.injective B hS)).mpr (nonZeroDivisors.ne_zero ha))

/-- extension of fractional ideals from `A` to `B` -/
noncomputable def p323_ext : FractionalIdeal A⁰ K →+* FractionalIdeal B⁰ K :=
  FractionalIdeal.extendedHom' (f := algebraMap A B) K (p323_hf (B := B) S hS)

lemma p323_coe_ext (I : FractionalIdeal A⁰ K) :
    ((p323_ext (B := B) S hS I : FractionalIdeal B⁰ K) : Submodule B K) =
      Submodule.span B (I : Set K) := by
  have hmap : IsLocalization.map (S := K) K (algebraMap A B) (p323_hf (B := B) S hS) =
      RingHom.id K := by
    apply IsLocalization.ringHom_ext A⁰
    ext a
    simp [IsLocalization.map_eq, ← IsScalarTower.algebraMap_apply]
  simp [p323_ext, FractionalIdeal.coe_extended_eq_span, hmap]

lemma p323_ext_coeIdeal (p : Ideal A) :
    p323_ext (B := B) (K := K) S hS (p : FractionalIdeal A⁰ K) =
      ((p.map (algebraMap A B) : Ideal B) : FractionalIdeal B⁰ K) :=
  FractionalIdeal.extended_coeIdeal_eq_map K _ p

lemma p323_under_map {p : Ideal A} (hp : p.IsPrime) (hd : Disjoint (S : Set A) p) :
    (p.map (algebraMap A B)).comap (algebraMap A B) = p :=
  IsLocalization.under_map_of_isPrime_disjoint S B hp hd

/-- the height one prime of `B` attached to a height one prime of `A` disjoint from `S` -/
noncomputable def p323_hos (v : HeightOneSpectrum A) (hd : Disjoint (S : Set A) v.asIdeal) :
    HeightOneSpectrum B where
  asIdeal := v.asIdeal.map (algebraMap A B)
  isPrime := IsLocalization.isPrime_of_isPrime_disjoint S B v.asIdeal v.isPrime hd
  ne_bot := by
    intro h
    apply v.ne_bot
    rw [← p323_under_map (B := B) S hS v.isPrime hd, h]
    exact Ideal.comap_bot_of_injective _ (IsLocalization.injective B hS)

lemma p323_hos_inj (v w : HeightOneSpectrum A) (hv : Disjoint (S : Set A) v.asIdeal)
    (hw : Disjoint (S : Set A) w.asIdeal)
    (h : p323_hos (B := B) S hS v hv = p323_hos (B := B) S hS w hw) : v = w := by
  have h1 : v.asIdeal.map (algebraMap A B) = w.asIdeal.map (algebraMap A B) :=
    congrArg HeightOneSpectrum.asIdeal h
  apply HeightOneSpectrum.ext
  rw [← p323_under_map (B := B) S hS v.isPrime hv, ← p323_under_map (B := B) S hS w.isPrime hw, h1]

lemma p323_count (v w : HeightOneSpectrum A) (hv : Disjoint (S : Set A) v.asIdeal)
    (hw : Disjoint (S : Set A) w.asIdeal) :
    FractionalIdeal.count K (p323_hos (B := B) S hS v hv)
      (p323_ext (B := B) (K := K) S hS (w.asIdeal : FractionalIdeal A⁰ K)) =
    FractionalIdeal.count K v (w.asIdeal : FractionalIdeal A⁰ K) := by
  classical
  rw [p323_ext_coeIdeal]
  have e1 := FractionalIdeal.count_maximal K (p323_hos (B := B) S hS v hv)
    (p323_hos (B := B) S hS w hw)
  have e2 := FractionalIdeal.count_maximal K v w
  refine e1.trans (Eq.trans ?_ e2.symm)
  by_cases h : w = v
  · subst h; simp
  · have : p323_hos (B := B) S hS w hw ≠ p323_hos (B := B) S hS v hv :=
      fun h' => h (p323_hos_inj (B := B) S hS w v hw hv h')
    simp [h, this]

omit hS in
/-- the generating set of the subgroup `H` of Proposition 3.23 -/
def p323_gen : Set (FractionalIdeal A⁰ K)ˣ :=
  {u | ∃ p : Ideal A, p.IsPrime ∧ p ≠ ⊥ ∧ Disjoint (S : Set A) p ∧
    (u : FractionalIdeal A⁰ K) = p}

/-- extension as a map on unit groups -/
noncomputable def p323_Phi : (FractionalIdeal A⁰ K)ˣ →* (FractionalIdeal B⁰ K)ˣ :=
  Units.map (p323_ext (B := B) (K := K) S hS).toMonoidHom

lemma p323_Phi_coe (u : (FractionalIdeal A⁰ K)ˣ) :
    ((p323_Phi (B := B) S hS u : (FractionalIdeal B⁰ K)ˣ) : FractionalIdeal B⁰ K) =
      p323_ext (B := B) (K := K) S hS (u : FractionalIdeal A⁰ K) := rfl

lemma p323_Q (v : HeightOneSpectrum A) (hv : Disjoint (S : Set A) v.asIdeal)
    (u : (FractionalIdeal A⁰ K)ˣ) (hu : u ∈ Subgroup.closure (p323_gen (K := K) S)) :
    FractionalIdeal.count K (p323_hos (B := B) S hS v hv)
      ((p323_Phi (B := B) S hS u : (FractionalIdeal B⁰ K)ˣ) : FractionalIdeal B⁰ K) =
    FractionalIdeal.count K v (u : FractionalIdeal A⁰ K) := by
  induction hu using Subgroup.closure_induction with
  | mem u hu =>
    obtain ⟨p, hp, hne, hd, hup⟩ := hu
    rw [p323_Phi_coe, hup]
    exact p323_count S hS v ⟨p, hp, hne⟩ hv hd
  | one => simp [FractionalIdeal.count_one]
  | mul x y _ _ ihx ihy =>
    rw [map_mul, Units.val_mul, Units.val_mul,
      FractionalIdeal.count_mul K _ (Units.ne_zero _) (Units.ne_zero _),
      FractionalIdeal.count_mul K _ (Units.ne_zero _) (Units.ne_zero _), ihx, ihy]
  | inv x _ ih =>
    rw [map_inv, Units.val_inv_eq_inv_val, Units.val_inv_eq_inv_val,
      FractionalIdeal.count_inv, FractionalIdeal.count_inv, ih]

omit hS in
lemma p323_R (v : HeightOneSpectrum A) (hv : ¬ Disjoint (S : Set A) v.asIdeal)
    (u : (FractionalIdeal A⁰ K)ˣ) (hu : u ∈ Subgroup.closure (p323_gen (K := K) S)) :
    FractionalIdeal.count K v (u : FractionalIdeal A⁰ K) = 0 := by
  induction hu using Subgroup.closure_induction with
  | mem u hu =>
    obtain ⟨p, hp, hne, hd, hup⟩ := hu
    rw [hup]
    apply FractionalIdeal.count_maximal_coprime K v (w := ⟨p, hp, hne⟩)
    intro h
    apply hv
    rw [← h]
    exact hd
  | one => simp [FractionalIdeal.count_one]
  | mul x y _ _ ihx ihy =>
    rw [Units.val_mul, FractionalIdeal.count_mul K _ (Units.ne_zero _) (Units.ne_zero _), ihx, ihy]
    rfl
  | inv x _ ih =>
    rw [Units.val_inv_eq_inv_val, FractionalIdeal.count_inv, ih]
    rfl

lemma p323_inj : Function.Injective
    ((p323_Phi (B := B) (K := K) S hS).comp (Subgroup.closure (p323_gen (K := K) S)).subtype) := by
  rw [injective_iff_map_eq_one]
  intro x hx
  apply Subtype.ext
  apply Units.ext
  have hx' : p323_Phi (B := B) S hS x.1 = 1 := hx
  have hcount : ∀ v : HeightOneSpectrum A, FractionalIdeal.count K v (x.1 : FractionalIdeal A⁰ K) = 0 := by
    intro v
    by_cases hv : Disjoint (S : Set A) v.asIdeal
    · rw [← p323_Q (B := B) S hS v hv x.1 x.2, hx']
      simp [FractionalIdeal.count_one]
    · exact p323_R S v hv x.1 x.2
  have := FractionalIdeal.finprod_heightOneSpectrum_factorization' (K := K) (Units.ne_zero x.1)
  simp only [hcount, zpow_zero, finprod_one] at this
  exact this.symm

lemma p323_surj : Function.Surjective
    ((p323_Phi (B := B) (K := K) S hS).comp (Subgroup.closure (p323_gen (K := K) S)).subtype) := by
  classical
  intro J
  suffices hJ : J ∈ (Subgroup.closure (p323_gen (K := K) S)).map (p323_Phi (B := B) S hS) by
    obtain ⟨x, hx, hxJ⟩ := hJ
    exact ⟨⟨x, hx⟩, hxJ⟩
  have hfin := Filter.eventually_cofinite.mp
    (FractionalIdeal.finite_factors (K := K) (J : FractionalIdeal B⁰ K))
  let gB : HeightOneSpectrum B → (FractionalIdeal B⁰ K)ˣ := fun w =>
    Units.mk0 (w.asIdeal : FractionalIdeal B⁰ K) (FractionalIdeal.coeIdeal_ne_zero.mpr w.ne_bot)
  have hgB : ∀ w, gB w ∈ (Subgroup.closure (p323_gen (K := K) S)).map (p323_Phi (B := B) S hS) := by
    intro w
    have hp : (w.asIdeal.comap (algebraMap A B)).IsPrime := by
      have := w.isPrime
      exact Ideal.comap_isPrime _ _
    have hmu : (w.asIdeal.comap (algebraMap A B)).map (algebraMap A B) = w.asIdeal :=
      IsLocalization.map_under S B w.asIdeal
    have hne : w.asIdeal.comap (algebraMap A B) ≠ ⊥ := by
      intro h
      apply w.ne_bot
      rw [← hmu, h, Ideal.map_bot]
    have hd : Disjoint (S : Set A) (w.asIdeal.comap (algebraMap A B)) := by
      rw [Set.disjoint_left]
      intro a ha ha'
      apply w.isPrime.ne_top
      exact Ideal.eq_top_of_isUnit_mem _ ha' (IsLocalization.map_units B (⟨a, ha⟩ : S))
    refine ⟨Units.mk0 ((w.asIdeal.comap (algebraMap A B) : Ideal A) : FractionalIdeal A⁰ K)
      (FractionalIdeal.coeIdeal_ne_zero.mpr hne), Subgroup.subset_closure ⟨_, hp, hne, hd, rfl⟩, ?_⟩
    apply Units.ext
    show p323_ext (B := B) (K := K) S hS _ = _
    rw [Units.val_mk0, p323_ext_coeIdeal, hmu]
    rfl
  have hJeq : J = ∏ w ∈ hfin.toFinset, gB w ^ (FractionalIdeal.count K w (J : FractionalIdeal B⁰ K)) := by
    apply Units.ext
    rw [Units.coe_prod]
    simp only [Units.val_zpow_eq_zpow_val, gB, Units.val_mk0]
    rw [← finprod_eq_prod_of_mulSupport_subset _ (s := hfin.toFinset) ?_]
    · exact (FractionalIdeal.finprod_heightOneSpectrum_factorization' (K := K) (Units.ne_zero J)).symm
    · intro w hw
      simp only [Function.mem_mulSupport] at hw
      simp only [Set.Finite.coe_toFinset, Set.mem_ofPred_eq]
      intro h
      apply hw
      rw [h, zpow_zero]
  rw [hJeq]
  exact Subgroup.prod_mem _ fun w _ => Subgroup.zpow_mem _ (hgB w) _

end P323

/-- **Proposition 3.23.** Let $A$ be a Dedekind domain with field of fractions $K$, $S \subseteq A \setminus \{0\}$ a
multiplicative set and $B = S^{-1}A$ (a domain with field of fractions $K$). Let $H \le \mathrm{Id}(A)$ be the subgroup
generated by the nonzero prime ideals $\mathfrak p$ with $\mathfrak p \cap S = \emptyset$. Then
$\mathfrak a \mapsto S^{-1}\mathfrak a = B\mathfrak a$ is an isomorphism $H \cong \mathrm{Id}(S^{-1}A)$. -/
@[kb "milne2020ant" "v3.08, Prop. 3.23, p. 55"]
theorem prop_3_23 {A K B : Type*} [CommRing A] [IsDedekindDomain A] [Field K] [Algebra A K]
    [IsFractionRing A K] (S : Submonoid A) (hS : S ≤ A⁰) [CommRing B] [IsDomain B] [Algebra A B]
    [IsLocalization S B] [Algebra B K] [IsScalarTower A B K] [IsFractionRing B K] :
    ∃ φ : (Subgroup.closure {u : (FractionalIdeal A⁰ K)ˣ | ∃ p : Ideal A, p.IsPrime ∧ p ≠ ⊥ ∧
        Disjoint (S : Set A) p ∧ (u : FractionalIdeal A⁰ K) = p}) ≃* (FractionalIdeal B⁰ K)ˣ,
      ∀ u, (((φ u : (FractionalIdeal B⁰ K)ˣ) : FractionalIdeal B⁰ K) : Submodule B K) =
        Submodule.span B (((u : (FractionalIdeal A⁰ K)ˣ) : FractionalIdeal A⁰ K) : Set K) := by
  have : IsDedekindDomain B := IsLocalization.isDedekindDomain A hS B
  refine ⟨MulEquiv.ofBijective
    ((p323_Phi (B := B) (K := K) S hS).comp (Subgroup.closure (p323_gen (K := K) S)).subtype)
    ⟨p323_inj S hS, p323_surj S hS⟩, fun u => ?_⟩
  have h := p323_coe_ext (B := B) S hS ((u : (FractionalIdeal A⁰ K)ˣ) : FractionalIdeal A⁰ K)
  rw [← p323_Phi_coe (B := B) S hS (u : (FractionalIdeal A⁰ K)ˣ)] at h
  exact h

/-- **Remark 3.24.** If the ideal class group of a Dedekind domain $A$ is finite, there is a nonzero $b \in A$ such
that $S^{-1}A = A[1/b]$, $S = \{1, b, b^2, \dots\}$, is a principal ideal domain. -/
@[kb "milne2020ant" "v3.08, Remark 3.24, p. 55"]
theorem remark_3_24 {A : Type*} [CommRing A] [IsDedekindDomain A] [Finite (ClassGroup A)] :
    ∃ b : A, b ≠ 0 ∧ IsPrincipalIdealRing (Localization.Away b) := by
  classical
  have := Fintype.ofFinite (ClassGroup A)
  choose I hI using (ClassGroup.mk0_surjective (R := A))
  have hP : (∏ c : ClassGroup A, (I c : Ideal A)) ≠ ⊥ := by
    rw [Ideal.zero_eq_bot.symm]
    exact Finset.prod_ne_zero_iff.mpr (fun c _ => nonZeroDivisors.coe_ne_zero (I c))
  obtain ⟨b, hbP, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hP
  have hbI : ∀ c, b ∈ (I c : Ideal A) := by
    intro c
    have : (I c : Ideal A) ∣ ∏ c : ClassGroup A, (I c : Ideal A) :=
      Finset.dvd_prod_of_mem _ (Finset.mem_univ c)
    exact Ideal.dvd_iff_le.mp this hbP
  refine ⟨b, hb0, ?_⟩
  set B := Localization.Away b
  have hle : Submonoid.powers b ≤ nonZeroDivisors A :=
    powers_le_nonZeroDivisors_of_noZeroDivisors hb0
  have : IsDomain B := IsLocalization.isDomain_of_le_nonZeroDivisors B hle
  have hinj : Function.Injective (algebraMap A B) := IsLocalization.injective B hle
  refine ⟨fun J => ?_⟩
  by_cases hJ : J = ⊥
  · rw [hJ]; exact bot_isPrincipal
  have ha : J.under A ≠ ⊥ := by
    intro h
    apply hJ
    rw [← IsLocalization.map_under (Submonoid.powers b) B J, h, Ideal.map_bot]
  have hmem : (J.under A) ∈ (Ideal A)⁰ := mem_nonZeroDivisors_of_ne_zero ha
  set c := ClassGroup.mk0 (⟨J.under A, hmem⟩ : (Ideal A)⁰) with hc
  have h1 : ClassGroup.mk0 (⟨J.under A, hmem⟩ : (Ideal A)⁰) = ClassGroup.mk0 (I c) := by
    rw [hI c]
  obtain ⟨x, y, hx, hy, hxy⟩ := ClassGroup.mk0_eq_mk0_iff.mp h1
  have hbunit : IsUnit (algebraMap A B b) := IsLocalization.Away.algebraMap_isUnit b
  have hIc : (I c : Ideal A).map (algebraMap A B) = ⊤ :=
    Ideal.eq_top_of_isUnit_mem _ (Ideal.mem_map_of_mem _ (hbI c)) hbunit
  have h2 := congrArg (Ideal.map (algebraMap A B)) hxy
  rw [Ideal.map_mul, Ideal.map_mul, Ideal.map_span, Ideal.map_span, hIc,
    Set.image_singleton, Set.image_singleton, IsLocalization.map_under (Submonoid.powers b) B J] at h2
  rw [Ideal.mul_top] at h2
  have hx' : algebraMap A B x ≠ 0 := by
    intro h; exact hx (hinj (by rw [h, map_zero]))
  have hyx : algebraMap A B y ∈ Ideal.span {algebraMap A B x} * J := by
    rw [h2]; exact Ideal.mem_span_singleton_self _
  obtain ⟨d, hd, hdy⟩ := Ideal.mem_span_singleton_mul.mp hyx
  refine ⟨⟨d, ?_⟩⟩
  have h3 : Ideal.span {algebraMap A B x} * J = Ideal.span {algebraMap A B x} * Ideal.span {d} := by
    rw [h2, Ideal.span_singleton_mul_span_singleton, ← hdy]
  have := (Ideal.span_singleton_mul_right_inj hx').mp h3
  rw [this]

end NumberFieldKB.MilneANT
