/-!
# Milne, *Algebraic Number Theory*, Example 5.14: the class group of $\mathbb Q[\alpha]$, $\alpha^3 + 10\alpha + 1 = 0$

Source: J. S. Milne, *Algebraic Number Theory*, course notes, version 3.08 (2020), bib key `milne2020ant`.

* **Example 5.14, class group** (`example_5_14_classGroup`): the class group of `MilneCubicField` is cyclic of
  order $6$, generated by the class of $\mathfrak p = (2, 1 + \alpha)$.
-/

open NumberField Polynomial

namespace NumberFieldKB.MilneANT

/-- The powers `1, α, α²` form a `ℤ`-basis of `𝓞 K` (the index of `ℤ[α]` is a unit). -/
theorem milne_alpha_isBasis :
    LinearIndependent ℤ (fun j : Fin 3 => milneAlpha ^ (j : ℕ)) ∧
      Submodule.span ℤ (Set.range (fun j : Fin 3 => milneAlpha ^ (j : ℕ))) = ⊤ := by
  have hrank : Module.finrank ℤ (𝓞 MilneCubicField) = 3 := by
    rw [RingOfIntegers.rank, milne_finrank]
  let bO : Module.Basis (Fin 3) ℤ (𝓞 MilneCubicField) := Module.finBasisOfFinrankEq ℤ _ hrank
  have hD : (discr MilneCubicField : ℚ) =
      Algebra.discr ℚ (bO.localizationLocalization ℚ (nonZeroDivisors ℤ) MilneCubicField) := by
    rw [← NumberField.discr_eq_discr MilneCubicField bO,
      Algebra.discr_localizationLocalization ℤ (nonZeroDivisors ℤ) MilneCubicField bO]
    simp
  let v : Fin 3 → MilneCubicField := fun j => AdjoinRoot.root milneCubic ^ (j : ℕ)
  have hv : Algebra.discr ℚ v = -4027 := by
    rw [← milne_discr_pb, ← Algebra.discr_reindex ℚ milnePB.basis (finCongr milnePB_dim)]
    congr 1
    funext j
    simp [v, PowerBasis.coe_basis, milnePB_gen]
  let P : Matrix (Fin 3) (Fin 3) ℚ := fun i j => (bO.repr (milneAlpha ^ (j : ℕ)) i : ℚ)
  have hvec : v = Matrix.vecMul
      (bO.localizationLocalization ℚ (nonZeroDivisors ℤ) MilneCubicField)
      (P.map (algebraMap ℚ MilneCubicField)) := by
    funext j
    have h1 := bO.sum_repr (milneAlpha ^ (j : ℕ))
    have h2 : v j = ((milneAlpha ^ (j : ℕ) : 𝓞 MilneCubicField) : MilneCubicField) := by
      rfl
    rw [h2, ← h1]
    simp [Matrix.vecMul, dotProduct, mul_comm]
    exact Finset.sum_congr rfl fun x _ => rfl
  have hdet := Algebra.discr_of_matrix_vecMul
    (bO.localizationLocalization ℚ (nonZeroDivisors ℤ) MilneCubicField) P
  rw [← hvec, hv, ← hD] at hdet
  have hP : P.det =
      ((Matrix.of fun i j : Fin 3 => bO.repr (milneAlpha ^ (j : ℕ)) i).det : ℤ) := by
    exact ((Int.castRingHom ℚ).map_det
      (Matrix.of fun i j : Fin 3 => bO.repr (milneAlpha ^ (j : ℕ)) i)).symm
  rw [hP, milne_discr] at hdet
  have hm : (Matrix.of fun i j : Fin 3 => bO.repr (milneAlpha ^ (j : ℕ)) i).det ^ 2 = 1 := by
    have : ((Matrix.of fun i j : Fin 3 => bO.repr (milneAlpha ^ (j : ℕ)) i).det : ℚ) ^ 2 = 1 := by
      simp only [Int.cast_neg, Int.cast_ofNat] at hdet; linarith
    exact_mod_cast this
  rw [Module.Basis.is_basis_iff_det bO (v := fun j : Fin 3 => milneAlpha ^ (j : ℕ)), Module.Basis.det_apply]
  have : bO.toMatrix (fun j : Fin 3 => milneAlpha ^ (j : ℕ)) =
      Matrix.of fun i j : Fin 3 => bO.repr (milneAlpha ^ (j : ℕ)) i := by
    ext i j; simp [Module.Basis.toMatrix_apply]
  rw [this]
  exact (isUnit_pow_iff (two_ne_zero)).1 (by rw [hm]; exact isUnit_one)

/-- The relation `α³ + 10α + 1 = 0` in `𝓞 K`. -/
theorem milneAlpha_rel : milneAlpha ^ 3 + 10 * milneAlpha + 1 = 0 := by
  apply Subtype.ext
  exact milneRoot_eq

/-- The power basis `1, α, α²` of `𝓞 K` over `ℤ`. -/
noncomputable def milnePBZ : PowerBasis ℤ (𝓞 MilneCubicField) where
  gen := milneAlpha
  dim := 3
  basis := Module.Basis.mk milne_alpha_isBasis.1 milne_alpha_isBasis.2.ge
  basis_eq_pow i := by simp [Module.Basis.mk_apply]

/-- The minimal polynomial of `α` over `ℤ`. -/
theorem milne_minpolyZ : minpoly ℤ milneAlpha = X ^ 3 + C 10 * X + 1 := by
  have hm : (X ^ 3 + C 10 * X + 1 : ℤ[X]).Monic := by monicity!
  have hd : (X ^ 3 + C 10 * X + 1 : ℤ[X]).natDegree = 3 := by compute_degree!
  have hint : IsIntegral ℤ milneAlpha := IsIntegral.of_finite ℤ _
  have hdvd : minpoly ℤ milneAlpha ∣ (X ^ 3 + C 10 * X + 1 : ℤ[X]) := by
    apply minpoly.isIntegrallyClosed_dvd hint
    have h10 : aeval milneAlpha (10 : ℤ[X]) = 10 := map_ofNat _ 10
    simpa [h10] using milneAlpha_rel
  symm
  apply eq_of_monic_of_dvd_of_natDegree_le (minpoly.monic hint) hm hdvd
  rw [hd]
  have := milnePBZ.natDegree_minpoly
  show _ ≤ (minpoly ℤ milnePBZ.gen).natDegree
  rw [this]
  rfl

/-- Two ring homomorphisms out of `𝓞 K` agreeing on `α` are equal. -/
theorem milne_ringHom_ext {R : Type*} [CommRing R] (f g : 𝓞 MilneCubicField →+* R)
    (h : f milneAlpha = g milneAlpha) : f = g := by
  have := milnePBZ.algHom_ext (f := f.toIntAlgHom) (g := g.toIntAlgHom) h
  ext x
  exact congrArg (fun F : 𝓞 MilneCubicField →ₐ[ℤ] R => F x) this

/-- For each root `r` of `X³ + 10X + 1` in `ℤ/p` there is a ring map `𝓞 K → ℤ/p` sending `α` to `r`. -/
theorem milne_exists_evalHom (p : ℕ) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    ∃ ψ : 𝓞 MilneCubicField →+* ZMod p, ψ milneAlpha = r := by
  have hy : aeval r (minpoly ℤ milnePBZ.gen) = 0 := by
    show aeval r (minpoly ℤ milneAlpha) = 0
    rw [milne_minpolyZ]
    simp only [map_add, map_mul, map_pow, aeval_X, map_one, eq_intCast]
    have h10 : aeval r (10 : ℤ[X]) = 10 := map_ofNat _ 10
    simpa [h10] using h
  exact ⟨(milnePBZ.lift r hy).toRingHom, milnePBZ.lift_gen r hy⟩

/-- Determinant of the shifted companion matrix. -/
theorem milne_shift_det (n : ℕ) (hn : n = 3) (c : ℕ → ℚ) (h0 : c 0 = 1) (h1 : c 1 = 10)
    (h2 : c 2 = 0) (k : ℚ) :
    (Matrix.of (fun (i j : Fin n) => if (j : ℕ) + 1 = n then -c i else if (i : ℕ) = j + 1 then 1 else 0)
      + (k : ℚ) • (1 : Matrix (Fin n) (Fin n) ℚ)).det = k ^ 3 + 10 * k - 1 := by
  subst hn
  rw [Matrix.det_fin_three]
  simp [h0, h1, h2]
  ring

/-- Norm of `α + k` in `K`. -/
theorem milne_norm_shift_field (k : ℤ) :
    Algebra.norm ℚ (AdjoinRoot.root milneCubic + (k : MilneCubicField)) =
      (k : ℚ) ^ 3 + 10 * k - 1 := by
  rw [Algebra.norm_eq_matrix_det milnePB.basis]
  have h1 : Algebra.leftMulMatrix milnePB.basis (AdjoinRoot.root milneCubic + (k : MilneCubicField)) =
      Algebra.leftMulMatrix milnePB.basis (AdjoinRoot.root milneCubic) +
        (k : ℚ) • (1 : Matrix (Fin milnePB.dim) (Fin milnePB.dim) ℚ) := by
    rw [map_add]
    congr 1
    rw [map_intCast (Algebra.leftMulMatrix milnePB.basis) k]
    ext i j
    simp [Matrix.one_apply, Matrix.intCast_apply]
  rw [h1, milne_leftMul]
  exact milne_shift_det milnePB.dim milnePB_dim milneCubic.coeff
    (by simp [milneCubic, coeff_one]) (by simp [milneCubic, coeff_one])
    (by simp [milneCubic, coeff_one]) k

/-- The abbreviation for the ring of integers of the cubic field. -/
abbrev MO : Type := 𝓞 MilneCubicField

/-- A chosen ring map `𝓞 K → ℤ/p` sending `α` to the root `r` of `X³ + 10X + 1`. -/
noncomputable def milneEval (p : ℕ) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) : MO →+* ZMod p :=
  (milne_exists_evalHom p r h).choose

theorem milneEval_alpha (p : ℕ) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    milneEval p r h milneAlpha = r :=
  (milne_exists_evalHom p r h).choose_spec

theorem milneEval_surjective (p : ℕ) [NeZero p] (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    Function.Surjective (milneEval p r h) := by
  intro z
  refine ⟨(z.val : MO), ?_⟩
  simp

/-- The prime ideal `ker (𝓞 K → ℤ/p)`, `α ↦ r`. -/
noncomputable def milneIdeal (p : ℕ) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) : Ideal MO :=
  RingHom.ker (milneEval p r h)

theorem mem_milneIdeal {p : ℕ} {r : ZMod p} {h : r ^ 3 + 10 * r + 1 = 0} {x : MO} :
    x ∈ milneIdeal p r h ↔ milneEval p r h x = 0 := RingHom.mem_ker

theorem milneIdeal_isMaximal {p : ℕ} (hp : p.Prime) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    (milneIdeal p r h).IsMaximal := by
  have := Fact.mk hp
  have : NeZero p := ⟨hp.ne_zero⟩
  exact RingHom.ker_isMaximal_of_surjective _ (milneEval_surjective p r h)

theorem milneIdeal_absNorm {p : ℕ} (hp : p.Prime) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    Ideal.absNorm (milneIdeal p r h) = p := by
  have := Fact.mk hp
  have : NeZero p := ⟨hp.ne_zero⟩
  rw [Ideal.absNorm_apply, Submodule.cardQuot_apply]
  unfold milneIdeal
  have e := RingHom.quotientKerEquivOfSurjective (milneEval_surjective p r h)
  rw [Nat.card_congr e.toEquiv, Nat.card_zmod]

/-- A prime ideal of prime absolute norm `p` is the kernel of a ring map to `ℤ/p`. -/
theorem exists_ringHom_of_absNorm_prime (P : Ideal MO) [hP : P.IsPrime] {p : ℕ} (hp : p.Prime)
    (hn : Ideal.absNorm P = p) : ∃ ψ : MO →+* ZMod p, RingHom.ker ψ = P := by
  have hP0 : P ≠ ⊥ := by
    intro h0
    rw [h0, Ideal.absNorm_bot] at hn
    exact hp.ne_zero hn.symm
  have : P.IsMaximal := Ideal.IsPrime.isMaximal hP hP0
  have : Finite (MO ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot P hP0
  have : Fintype (MO ⧸ P) := Fintype.ofFinite _
  have hc : Fintype.card (MO ⧸ P) = p := by
    rw [← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply, hn]
  refine ⟨(ZMod.ringEquivOfPrime (MO ⧸ P) hp hc).symm.toRingHom.comp (Ideal.Quotient.mk P), ?_⟩
  ext x
  simp [RingHom.mem_ker, Ideal.Quotient.eq_zero_iff_mem]

/-- Uniqueness: a prime of norm `p` equals `milneIdeal p r` if `r` is the only root mod `p`. -/
theorem eq_milneIdeal_of_absNorm (P : Ideal MO) [P.IsPrime] {p : ℕ} (hp : p.Prime)
    (hn : Ideal.absNorm P = p) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0)
    (huniq : ∀ k : ZMod p, k ^ 3 + 10 * k + 1 = 0 → k = r) : P = milneIdeal p r h := by
  obtain ⟨ψ, hψ⟩ := exists_ringHom_of_absNorm_prime P hp hn
  have hroot : ψ milneAlpha ^ 3 + 10 * ψ milneAlpha + 1 = 0 := by
    have := congrArg ψ milneAlpha_rel
    have h10 : ψ 10 = 10 := map_ofNat ψ 10
    simpa [h10] using this
  have hk := huniq _ hroot
  have : ψ = milneEval p r h := milne_ringHom_ext _ _ (by rw [hk, milneEval_alpha])
  rw [← hψ, this]
  rfl

/-- A prime ideal of prime absolute norm `p` with no root of the cubic mod `p` cannot exist. -/
theorem no_prime_of_noRoot (P : Ideal MO) [hP : P.IsPrime] {p : ℕ} (hp : p.Prime)
    (hn : Ideal.absNorm P = p) (hno : ∀ k : ZMod p, k ^ 3 + 10 * k + 1 ≠ 0) : False := by
  obtain ⟨ψ, hψ⟩ := exists_ringHom_of_absNorm_prime P hp hn
  apply hno (ψ milneAlpha)
  have := congrArg ψ milneAlpha_rel
  have h10 : ψ 10 = 10 := map_ofNat ψ 10
  simpa [h10] using this

/-- `ker ψ_{p,r}` is a nonzero prime for `p` prime. -/
theorem milneIdeal_ne_bot {p : ℕ} (hp : p.Prime) (r : ZMod p) (h : r ^ 3 + 10 * r + 1 = 0) :
    milneIdeal p r h ≠ ⊥ := by
  intro h0
  have := milneIdeal_absNorm hp r h
  rw [h0, Ideal.absNorm_bot] at this
  exact hp.ne_zero this.symm

/-- If `I ≤ J`, `J ≠ ⊥`, and the absolute norms agree, then `I = J`. -/
theorem eq_of_le_of_absNorm_eq {I J : Ideal MO} (hJ : J ≠ ⊥) (hle : I ≤ J)
    (hn : Ideal.absNorm I = Ideal.absNorm J) : I = J := by
  obtain ⟨K, hK⟩ := Ideal.dvd_iff_le.2 hle
  have hJn : Ideal.absNorm J ≠ 0 := by
    intro h0
    exact hJ (Ideal.absNorm_eq_zero_iff.1 h0)
  have hK1 : Ideal.absNorm K = 1 := by
    have h1 : Ideal.absNorm J * Ideal.absNorm K = Ideal.absNorm J * 1 := by
      rw [← map_mul, ← hK, hn, mul_one]
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hJn) h1
  rw [Ideal.absNorm_eq_one_iff.1 hK1] at hK
  rw [hK, Ideal.mul_top]

/-- The absolute norm of `(α + k)` is `|k³ + 10k − 1|`. -/
theorem milne_absNorm_shift (k : ℤ) :
    Ideal.absNorm (Ideal.span {milneAlpha + (k : MO)}) = (k ^ 3 + 10 * k - 1).natAbs := by
  rw [Ideal.absNorm_span_singleton]
  congr 1
  have h1 : ((Algebra.norm ℤ (milneAlpha + (k : MO)) : ℤ) : ℚ) = (k : ℚ) ^ 3 + 10 * k - 1 := by
    rw [Algebra.coe_norm_int]
    exact milne_norm_shift_field k
  have h2 : ((Algebra.norm ℤ (milneAlpha + (k : MO)) : ℤ) : ℚ) = ((k ^ 3 + 10 * k - 1 : ℤ) : ℚ) := by
    rw [h1]; push_cast; ring
  exact_mod_cast h2

/-- The absolute norm of `(n)` is `n³`. -/
theorem milne_absNorm_nat (n : ℕ) : Ideal.absNorm (Ideal.span {(n : MO)}) = n ^ 3 := by
  rw [Ideal.absNorm_span_natCast]
  congr 1
  rw [RingOfIntegers.rank, milne_finrank]

/-- A principal ideal contained in a coprime product of the given norm equals the product. -/
theorem span_eq_mul_of_coprime {x : MO} {A B : Ideal MO} (hc : IsCoprime A B) (hA : x ∈ A)
    (hB : x ∈ B) (hAB : A * B ≠ ⊥)
    (hn : Ideal.absNorm (Ideal.span {x}) = Ideal.absNorm A * Ideal.absNorm B) :
    Ideal.span {x} = A * B := by
  apply eq_of_le_of_absNorm_eq hAB _ (by rw [hn, map_mul])
  rw [Ideal.mul_eq_inf_of_coprime (Ideal.isCoprime_iff_sup_eq.1 hc)]
  exact le_inf ((Ideal.span_singleton_le_iff_mem _).2 hA) ((Ideal.span_singleton_le_iff_mem _).2 hB)

/-- Membership in a power of an ideal from a combination of `a^i * b^(k-i)`. -/
theorem mem_pow_of_combo {𝔭 : Ideal MO} {a b : MO} (ha : a ∈ 𝔭) (hb : b ∈ 𝔭) (k : ℕ)
    (c : ℕ → MO) (x : MO) (h : x = ∑ i ∈ Finset.range (k + 1), c i * (a ^ i * b ^ (k - i))) :
    x ∈ 𝔭 ^ k := by
  rw [h]
  refine Ideal.sum_mem _ fun i hi => Ideal.mul_mem_left _ _ ?_
  have hik : i + (k - i) = k := by
    have := Finset.mem_range.1 hi; omega
  have := Ideal.mul_mem_mul (Ideal.pow_mem_pow ha i) (Ideal.pow_mem_pow hb (k - i))
  rwa [← pow_add, hik] at this

/-- The first prime above `2`: `α ↦ 1`. -/
noncomputable def milneP2 : Ideal MO := milneIdeal 2 1 (by decide)
/-- The prime above `3`: `α ↦ 1`. -/
noncomputable def milneP3 : Ideal MO := milneIdeal 3 1 (by decide)
/-- The prime above `5`: `α ↦ 4`. -/
noncomputable def milneP5 : Ideal MO := milneIdeal 5 4 (by decide)
/-- The prime above `7`: `α ↦ 4`. -/
noncomputable def milneP7 : Ideal MO := milneIdeal 7 4 (by decide)
/-- The prime above `11`: `α ↦ 5`. -/
noncomputable def milneP11 : Ideal MO := milneIdeal 11 5 (by decide)

theorem milneP2_max : milneP2.IsMaximal := milneIdeal_isMaximal (by norm_num) _ _
theorem milneP3_max : milneP3.IsMaximal := milneIdeal_isMaximal (by norm_num) _ _
theorem milneP5_max : milneP5.IsMaximal := milneIdeal_isMaximal (by norm_num) _ _
theorem milneP7_max : milneP7.IsMaximal := milneIdeal_isMaximal (by norm_num) _ _
theorem milneP11_max : milneP11.IsMaximal := milneIdeal_isMaximal (by norm_num) _ _

theorem milneP2_norm : Ideal.absNorm milneP2 = 2 := milneIdeal_absNorm (by norm_num) _ _
theorem milneP3_norm : Ideal.absNorm milneP3 = 3 := milneIdeal_absNorm (by norm_num) _ _
theorem milneP5_norm : Ideal.absNorm milneP5 = 5 := milneIdeal_absNorm (by norm_num) _ _
theorem milneP7_norm : Ideal.absNorm milneP7 = 7 := milneIdeal_absNorm (by norm_num) _ _
theorem milneP11_norm : Ideal.absNorm milneP11 = 11 := milneIdeal_absNorm (by norm_num) _ _

theorem milneP2_ne_bot : milneP2 ≠ ⊥ := milneIdeal_ne_bot (by norm_num) _ _
theorem milneP3_ne_bot : milneP3 ≠ ⊥ := milneIdeal_ne_bot (by norm_num) _ _
theorem milneP5_ne_bot : milneP5 ≠ ⊥ := milneIdeal_ne_bot (by norm_num) _ _
theorem milneP7_ne_bot : milneP7 ≠ ⊥ := milneIdeal_ne_bot (by norm_num) _ _
theorem milneP11_ne_bot : milneP11 ≠ ⊥ := milneIdeal_ne_bot (by norm_num) _ _

/-- `α − k` lies in `ker ψ_{p,r}` when `k ≡ r`. -/
theorem alpha_sub_mem {p : ℕ} {r : ZMod p} {h : r ^ 3 + 10 * r + 1 = 0} (k : ℤ)
    (hk : (k : ZMod p) = r) : milneAlpha - (k : MO) ∈ milneIdeal p r h := by
  rw [mem_milneIdeal, map_sub, milneEval_alpha, map_intCast, hk, sub_self]

/-- `p` lies in `ker ψ_{p,r}`. -/
theorem natCast_mem_milneIdeal {p : ℕ} {r : ZMod p} {h : r ^ 3 + 10 * r + 1 = 0} :
    (p : MO) ∈ milneIdeal p r h := by
  rw [mem_milneIdeal, map_natCast, ZMod.natCast_self]

theorem milneP2_a1 : milneAlpha - 1 ∈ milneP2 := by
  unfold milneP2
  simpa using alpha_sub_mem (p := 2) (r := 1) (h := by decide) 1 (by decide)
theorem milneP2_two : (2 : MO) ∈ milneP2 := by
  unfold milneP2
  simpa using natCast_mem_milneIdeal (p := 2) (r := 1) (h := by decide)
theorem milneP3_a1 : milneAlpha - 1 ∈ milneP3 := by
  unfold milneP3
  simpa using alpha_sub_mem (p := 3) (r := 1) (h := by decide) 1 (by decide)
theorem milneP3_three : (3 : MO) ∈ milneP3 := by
  unfold milneP3
  simpa using natCast_mem_milneIdeal (p := 3) (r := 1) (h := by decide)
theorem milneP5_mem : milneAlpha + 1 ∈ milneP5 := by
  unfold milneP5
  simpa [sub_eq_add_neg] using alpha_sub_mem (p := 5) (r := 4) (h := by decide) (-1) (by decide)
theorem milneP7_mem : milneAlpha + 3 ∈ milneP7 := by
  unfold milneP7
  simpa [sub_eq_add_neg] using alpha_sub_mem (p := 7) (r := 4) (h := by decide) (-3) (by decide)
theorem milneP11_mem : milneAlpha - 5 ∈ milneP11 := by
  unfold milneP11
  simpa using alpha_sub_mem (p := 11) (r := 5) (h := by decide) 5 (by decide)

theorem coprime_pow_of_norm_ne {P Q : Ideal MO} [P.IsMaximal] [Q.IsMaximal] (n : ℕ)
    (h : Ideal.absNorm P ≠ Ideal.absNorm Q) : IsCoprime (P ^ n) Q :=
  (Ideal.isCoprime_of_isMaximal (fun e => h (by rw [e]))).pow_left

theorem milneP2_pow2 : milneAlpha - 1 ∈ milneP2 ^ 2 := by
  refine mem_pow_of_combo milneP2_two milneP2_a1 2
    (fun i => if i = 0 then 2 + milneAlpha else if i = 1 then 7 else 3) _ ?_
  norm_num [Finset.sum_range_succ]
  linear_combination (-1 : MO) * milneAlpha_rel

theorem milneP2_pow3 : milneAlpha + 3 ∈ milneP2 ^ 3 := by
  refine mem_pow_of_combo milneP2_two milneP2_a1 3
    (fun i => if i = 0 then -92 + 40 * milneAlpha - 43 * milneAlpha ^ 2
      else if i = 1 then 0 else if i = 2 then 302 * milneAlpha else 323 * milneAlpha) _ ?_
  norm_num [Finset.sum_range_succ]
  linear_combination (-(89 + 169 * milneAlpha - 43 * milneAlpha ^ 2) : MO) * milneAlpha_rel

theorem milneP2_pow4 : milneAlpha - 5 ∈ milneP2 ^ 4 := by
  refine mem_pow_of_combo milneP2_two milneP2_a1 4
    (fun i => if i = 0 then -5 + 54 * milneAlpha
      else if i = 1 then 49 else if i = 2 then 0
      else if i = 3 then -202 * milneAlpha else -199 * milneAlpha) _ ?_
  norm_num [Finset.sum_range_succ]
  linear_combination (-(-98 - 221 * milneAlpha + 54 * milneAlpha ^ 2) : MO) * milneAlpha_rel

theorem milneP3_pow3 : milneAlpha + 2 ∈ milneP3 ^ 3 := by
  refine mem_pow_of_combo milneP3_three milneP3_a1 3
    (fun i => if i = 0 then -236 - 2 * milneAlpha - 29 * milneAlpha ^ 2
      else if i = 1 then 0 else if i = 2 then 29 + 10 * milneAlpha else 13 * milneAlpha) _ ?_
  norm_num [Finset.sum_range_succ]
  linear_combination (-(-27 + 85 * milneAlpha - 29 * milneAlpha ^ 2) : MO) * milneAlpha_rel

theorem milne_rel_1 : Ideal.span {milneAlpha + 1} = milneP2 * milneP5 := by
  have hm2 := milneP2_max
  have hm5 := milneP5_max
  have e : (milneAlpha + 1 : MO) = milneAlpha + ((1 : ℤ) : MO) := by push_cast; ring
  refine span_eq_mul_of_coprime (Ideal.isCoprime_of_isMaximal (fun e => ?_)) ?_ milneP5_mem
    (mul_ne_zero milneP2_ne_bot milneP5_ne_bot) ?_
  · have := milneP2_norm; rw [e, milneP5_norm] at this; omega
  · have := Ideal.add_mem _ milneP2_a1 milneP2_two
    rwa [show milneAlpha - 1 + 2 = milneAlpha + 1 by ring] at this
  · rw [e, milne_absNorm_shift, milneP2_norm, milneP5_norm]; norm_num

theorem milne_rel_2 : Ideal.span {milneAlpha - 1} = milneP2 ^ 2 * milneP3 := by
  have hm2 := milneP2_max
  have hm3 := milneP3_max
  have e : (milneAlpha - 1 : MO) = milneAlpha + ((-1 : ℤ) : MO) := by push_cast; ring
  refine span_eq_mul_of_coprime (coprime_pow_of_norm_ne 2 ?_) milneP2_pow2 milneP3_a1
    (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP3_ne_bot) ?_
  · rw [milneP2_norm, milneP3_norm]; omega
  · rw [e, milne_absNorm_shift, map_pow, milneP2_norm, milneP3_norm]; norm_num

theorem milne_rel_3 : Ideal.span {milneAlpha + 2} = milneP3 ^ 3 := by
  have e : (milneAlpha + 2 : MO) = milneAlpha + ((2 : ℤ) : MO) := by push_cast; ring
  refine eq_of_le_of_absNorm_eq (pow_ne_zero _ milneP3_ne_bot)
    ((Ideal.span_singleton_le_iff_mem _).2 milneP3_pow3) ?_
  rw [e, milne_absNorm_shift, map_pow, milneP3_norm]; norm_num

theorem milne_rel_4 : Ideal.span {milneAlpha + 3} = milneP2 ^ 3 * milneP7 := by
  have hm2 := milneP2_max
  have hm7 := milneP7_max
  have e : (milneAlpha + 3 : MO) = milneAlpha + ((3 : ℤ) : MO) := by push_cast; ring
  refine span_eq_mul_of_coprime (coprime_pow_of_norm_ne 3 ?_) milneP2_pow3 milneP7_mem
    (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP7_ne_bot) ?_
  · rw [milneP2_norm, milneP7_norm]; omega
  · rw [e, milne_absNorm_shift, map_pow, milneP2_norm, milneP7_norm]; norm_num

theorem milne_rel_5 : Ideal.span {milneAlpha - 5} = milneP2 ^ 4 * milneP11 := by
  have hm2 := milneP2_max
  have hm11 := milneP11_max
  have e : (milneAlpha - 5 : MO) = milneAlpha + ((-5 : ℤ) : MO) := by push_cast; ring
  refine span_eq_mul_of_coprime (coprime_pow_of_norm_ne 4 ?_) milneP2_pow4 milneP11_mem
    (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP11_ne_bot) ?_
  · rw [milneP2_norm, milneP11_norm]; omega
  · rw [e, milne_absNorm_shift, map_pow, milneP2_norm, milneP11_norm]; norm_num

/-- A prime of norm `p` (with `p ∈ P`) has a cofactor of norm `p²` in `(p)`. -/
theorem exists_cofactor {P : Ideal MO} {p : ℕ} (hp : 0 < p) (hpP : (p : MO) ∈ P)
    (hP : Ideal.absNorm P = p) : ∃ Q : Ideal MO, Ideal.span {(p : MO)} = P * Q ∧
      Ideal.absNorm Q = p ^ 2 := by
  obtain ⟨Q, hQ⟩ := Ideal.dvd_iff_le.2 ((Ideal.span_singleton_le_iff_mem _).2 hpP)
  refine ⟨Q, hQ, ?_⟩
  have := congrArg Ideal.absNorm hQ
  rw [milne_absNorm_nat, map_mul, hP] at this
  exact Nat.eq_of_mul_eq_mul_left hp (by rw [← this]; ring)

/-- The cofactor `(2) / 𝔭₂`, of norm `4`. -/
noncomputable def milneQ2 : Ideal MO :=
  (exists_cofactor (P := milneP2) (p := 2) (by norm_num) (by exact_mod_cast milneP2_two)
    milneP2_norm).choose

theorem milneQ2_spec : Ideal.span {(2 : MO)} = milneP2 * milneQ2 := by
  have := (exists_cofactor (P := milneP2) (p := 2) (by norm_num) (by exact_mod_cast milneP2_two)
    milneP2_norm).choose_spec.1
  simp only [Nat.cast_ofNat] at this
  exact this

theorem milneQ2_norm : Ideal.absNorm milneQ2 = 4 :=
  (exists_cofactor (P := milneP2) (p := 2) (by norm_num) (by exact_mod_cast milneP2_two)
    milneP2_norm).choose_spec.2

/-- The cofactor `(3) / 𝔭₃`, of norm `9`. -/
noncomputable def milneQ3 : Ideal MO :=
  (exists_cofactor (P := milneP3) (p := 3) (by norm_num) (by exact_mod_cast milneP3_three)
    milneP3_norm).choose

theorem milneQ3_spec : Ideal.span {(3 : MO)} = milneP3 * milneQ3 := by
  have := (exists_cofactor (P := milneP3) (p := 3) (by norm_num) (by exact_mod_cast milneP3_three)
    milneP3_norm).choose_spec.1
  simp only [Nat.cast_ofNat] at this
  exact this

theorem milneQ3_norm : Ideal.absNorm milneQ3 = 9 :=
  (exists_cofactor (P := milneP3) (p := 3) (by norm_num) (by exact_mod_cast milneP3_three)
    milneP3_norm).choose_spec.2

theorem milneQ2_ne_bot : milneQ2 ≠ ⊥ := by
  intro h
  have := milneQ2_norm
  rw [h, Ideal.absNorm_bot] at this
  omega

theorem milneQ3_ne_bot : milneQ3 ≠ ⊥ := by
  intro h
  have := milneQ3_norm
  rw [h, Ideal.absNorm_bot] at this
  omega

/-- A prime ideal of prime norm at most `17` is one of `𝔭₂, 𝔭₃, 𝔭₅, 𝔭₇, 𝔭₁₁`. -/
theorem prime_norm_classify (P : Ideal MO) [P.IsPrime] {p : ℕ} (hp : p.Prime)
    (hn : Ideal.absNorm P = p) (hle : p ≤ 17) :
    P = milneP2 ∨ P = milneP3 ∨ P = milneP5 ∨ P = milneP7 ∨ P = milneP11 := by
  interval_cases p
  all_goals try (exfalso; revert hp; norm_num; done)
  · left
    exact eq_milneIdeal_of_absNorm P hp hn 1 (by decide) (by decide)
  · right; left
    exact eq_milneIdeal_of_absNorm P hp hn 1 (by decide) (by decide)
  · right; right; left
    exact eq_milneIdeal_of_absNorm P hp hn 4 (by decide) (by decide)
  · right; right; right; left
    exact eq_milneIdeal_of_absNorm P hp hn 4 (by decide) (by decide)
  · right; right; right; right
    exact eq_milneIdeal_of_absNorm P hp hn 5 (by decide) (by decide)
  · exfalso
    exact no_prime_of_noRoot P hp hn (by decide)
  · exfalso
    exact no_prime_of_noRoot P hp hn (by decide)

/-- The prime `p` and the ideal `P` of norm `q = p^n` with `p ∈ P`, `p ∈ {2, 3}`: either `P` is the prime
of norm `p`, or `P` is the cofactor. Shared step for `p = 2` and `p = 3`. -/
theorem prime_over_small (P : Ideal MO) [hP : P.IsPrime] (hP0 : P ≠ ⊥) {p : ℕ} (hp : p.Prime)
    {P1 Q : Ideal MO} (hP1 : P1.IsMaximal) (hQ : Ideal.span {(p : MO)} = P1 * Q)
    (hQn : Ideal.absNorm Q = p ^ 2) (hpP : (p : MO) ∈ P)
    (hq1 : 2 ≤ Ideal.absNorm P) : P = P1 ∨ P.absNorm = p ∨ P = Q := by
  have hle : Ideal.span {(p : MO)} ≤ P := (Ideal.span_singleton_le_iff_mem _).2 hpP
  rw [hQ] at hle
  rcases (Ideal.IsPrime.mul_le hP).1 hle with h1 | h2
  · left
    exact (hP1.eq_of_le hP.ne_top h1).symm
  · right
    obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.2 h2
    have hmul := congrArg Ideal.absNorm hJ
    rw [map_mul, hQn] at hmul
    have hdvd : Ideal.absNorm P ∣ p ^ 2 := ⟨_, hmul⟩
    rcases (Nat.dvd_prime_pow hp).1 hdvd with ⟨k, hk, hkq⟩
    interval_cases k
    · exfalso; rw [pow_zero] at hkq; omega
    · left; simpa using hkq
    · right
      exact (eq_of_le_of_absNorm_eq hP0 h2 (by rw [hQn, hkq])).symm

/-- Every nonzero prime ideal of absolute norm at most `17` is one of seven explicit ideals. -/
theorem prime_classify (P : Ideal MO) [hP : P.IsPrime] (hP0 : P ≠ ⊥)
    (hle : Ideal.absNorm P ≤ 17) :
    P = milneP2 ∨ P = milneP3 ∨ P = milneP5 ∨ P = milneP7 ∨ P = milneP11 ∨ P = milneQ2 ∨
      P = milneQ3 := by
  have hmax : P.IsMaximal := Ideal.IsPrime.isMaximal hP hP0
  have : Finite (MO ⧸ P) := Ideal.finiteQuotientOfFreeOfNeBot P hP0
  have : Fintype (MO ⧸ P) := Fintype.ofFinite _
  let _ : Field (MO ⧸ P) := Ideal.Quotient.field P
  have hq : IsPrimePow (Ideal.absNorm P) := by
    have := FiniteField.isPrimePow_card (MO ⧸ P)
    rwa [← Nat.card_eq_fintype_card, ← Submodule.cardQuot_apply, ← Ideal.absNorm_apply] at this
  have hq2 : 2 ≤ Ideal.absNorm P := hq.two_le
  obtain ⟨c, n, hc, hn, hcn⟩ := (isPrimePow_nat_iff _).1 hq
  have hcP : (c : MO) ∈ P := by
    refine hP.mem_of_pow_mem n ?_
    have := Ideal.absNorm_mem P
    rw [← hcn] at this
    simpa using this
  by_cases h2 : c = 2
  · subst h2
    have hm := milneP2_max
    rcases prime_over_small P hP0 Nat.prime_two hm (by simpa using milneQ2_spec)
        (by simpa using milneQ2_norm) hcP hq2 with h | h | h
    · tauto
    · left
      exact eq_milneIdeal_of_absNorm P Nat.prime_two h 1 (by decide) (by decide)
    · tauto
  by_cases h3 : c = 3
  · subst h3
    have hm := milneP3_max
    rcases prime_over_small P hP0 Nat.prime_three hm (by simpa using milneQ3_spec)
        (by simpa using milneQ3_norm) hcP hq2 with h | h | h
    · tauto
    · right; left
      exact eq_milneIdeal_of_absNorm P Nat.prime_three h 1 (by decide) (by decide)
    · tauto
  have hc5 : 5 ≤ c := by
    have := hc.two_le
    have h4 : c ≠ 4 := by rintro rfl; norm_num at hc
    omega
  have hn1 : n = 1 := by
    by_contra hne
    have : c ^ 2 ≤ c ^ n := Nat.pow_le_pow_right (by omega) (by omega)
    nlinarith
  subst hn1
  have hcq : Ideal.absNorm P = c := by simpa using hcn.symm
  have := prime_norm_classify P hc hcq (by omega)
  tauto

/-- Splitting an integer power: `a ^ m = a ^ (m mod n) * (a ^ (m / n)) ^ n`. -/
theorem zpow_split {G : Type*} [CommGroup G] (a : G) (m : ℤ) (n : ℕ) (hn : 0 < n) :
    a ^ m = a ^ (m % n).toNat * (a ^ (m / n)) ^ n := by
  have h1 : m = ((m % n).toNat : ℤ) + (m / n) * n := by
    have := Int.emod_def m n
    have h0 : 0 ≤ m % (n : ℤ) := Int.emod_nonneg _ (by omega)
    rw [Int.toNat_of_nonneg h0]; nlinarith
  conv_lhs => rw [h1]
  rw [zpow_add, zpow_natCast, zpow_mul, zpow_natCast]

/-- Every unit is `± α^e w²` with `e ∈ {0, 1}` and `w` a unit. -/
theorem unit_sq_form (u : MOˣ) : ∃ (e : ℕ) (w : MOˣ), e ≤ 1 ∧
    (u = milneAlphaUnit ^ e * w ^ 2 ∨ u = -(milneAlphaUnit ^ e * w ^ 2)) := by
  obtain ⟨m, hm⟩ := example_5_14_units.2 u
  have key := zpow_split milneAlphaUnit m 2 (by norm_num)
  push_cast at key
  refine ⟨(m % 2).toNat, milneAlphaUnit ^ (m / 2), by omega, ?_⟩
  rcases hm with h | h
  · left; rw [h, key]
  · right; rw [h, key]

/-- Every unit is `α^e w³` with `e ∈ {0, 1, 2}` and `w` a unit. -/
theorem unit_cube_form (u : MOˣ) : ∃ (e : ℕ) (w : MOˣ), e ≤ 2 ∧ u = milneAlphaUnit ^ e * w ^ 3 := by
  obtain ⟨m, hm⟩ := example_5_14_units.2 u
  have key := zpow_split milneAlphaUnit m 3 (by norm_num)
  push_cast at key
  refine ⟨(m % 3).toNat, ?_⟩
  rcases hm with h | h
  · exact ⟨milneAlphaUnit ^ (m / 3), by omega, by rw [h, key]⟩
  · refine ⟨-(milneAlphaUnit ^ (m / 3)), by omega, ?_⟩
    rw [h, key, Odd.neg_pow (by decide : Odd 3), mul_neg]

/-- The ideal class of a nonzero ideal (and `1` for the zero ideal). -/
noncomputable def cl (I : Ideal MO) : ClassGroup MO :=
  if h : I ≠ ⊥ then ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero h⟩ else 1

theorem cl_of_ne {I : Ideal MO} (h : I ≠ ⊥) :
    cl I = ClassGroup.mk0 ⟨I, mem_nonZeroDivisors_of_ne_zero h⟩ := by
  simp [cl, h]

theorem cl_mul {I J : Ideal MO} (hI : I ≠ ⊥) (hJ : J ≠ ⊥) : cl (I * J) = cl I * cl J := by
  have hIJ : I * J ≠ ⊥ := mul_ne_zero hI hJ
  rw [cl_of_ne hI, cl_of_ne hJ, cl_of_ne hIJ]
  rw [← map_mul]
  rfl

theorem cl_span {x : MO} (hx : x ≠ 0) : cl (Ideal.span {x}) = 1 := by
  have h : Ideal.span {x} ≠ ⊥ := by simpa using hx
  rw [cl_of_ne h]
  exact (ClassGroup.mk0_eq_one_iff _).2 ⟨⟨x, rfl⟩⟩

theorem cl_top : cl (⊤ : Ideal MO) = 1 := by
  have := cl_span (one_ne_zero : (1 : MO) ≠ 0)
  rwa [Ideal.span_singleton_one] at this

theorem cl_pow {I : Ideal MO} (hI : I ≠ ⊥) (n : ℕ) : cl (I ^ n) = cl I ^ n := by
  induction n with
  | zero => simp [cl_top]
  | succ n ih => rw [pow_succ, cl_mul (pow_ne_zero _ hI) hI, ih, pow_succ]

theorem cl_eq_one_iff {I : Ideal MO} (hI : I ≠ ⊥) : cl I = 1 ↔ I.IsPrincipal := by
  rw [cl_of_ne hI]
  exact ClassGroup.mk0_eq_one_iff _

theorem cl_of_span_eq {x : MO} {I : Ideal MO} (hI : I ≠ ⊥) (h : Ideal.span {x} = I) :
    cl I = 1 := by
  have hx : x ≠ 0 := by
    rintro rfl
    apply hI
    rw [← h]; simp
  rw [← h]
  exact cl_span hx

theorem cl_rel_1 : cl milneP5 * cl milneP2 = 1 := by
  rw [mul_comm, ← cl_mul milneP2_ne_bot milneP5_ne_bot]
  exact cl_of_span_eq (mul_ne_zero milneP2_ne_bot milneP5_ne_bot) milne_rel_1

theorem cl_rel_2 : cl milneP3 * cl milneP2 ^ 2 = 1 := by
  rw [mul_comm, ← cl_pow milneP2_ne_bot, ← cl_mul (pow_ne_zero _ milneP2_ne_bot) milneP3_ne_bot]
  exact cl_of_span_eq (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP3_ne_bot) milne_rel_2

theorem cl_rel_3 : cl milneP3 ^ 3 = 1 := by
  rw [← cl_pow milneP3_ne_bot]
  exact cl_of_span_eq (pow_ne_zero _ milneP3_ne_bot) milne_rel_3

theorem cl_rel_4 : cl milneP7 * cl milneP2 ^ 3 = 1 := by
  rw [mul_comm, ← cl_pow milneP2_ne_bot, ← cl_mul (pow_ne_zero _ milneP2_ne_bot) milneP7_ne_bot]
  exact cl_of_span_eq (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP7_ne_bot) milne_rel_4

theorem cl_rel_5 : cl milneP11 * cl milneP2 ^ 4 = 1 := by
  rw [mul_comm, ← cl_pow milneP2_ne_bot, ← cl_mul (pow_ne_zero _ milneP2_ne_bot) milneP11_ne_bot]
  exact cl_of_span_eq (mul_ne_zero (pow_ne_zero _ milneP2_ne_bot) milneP11_ne_bot) milne_rel_5

theorem cl_rel_6 : cl milneQ2 * cl milneP2 = 1 := by
  rw [mul_comm, ← cl_mul milneP2_ne_bot milneQ2_ne_bot]
  exact cl_of_span_eq (mul_ne_zero milneP2_ne_bot milneQ2_ne_bot) milneQ2_spec

theorem cl_rel_7 : cl milneQ3 * cl milneP3 = 1 := by
  rw [mul_comm, ← cl_mul milneP3_ne_bot milneQ3_ne_bot]
  exact cl_of_span_eq (mul_ne_zero milneP3_ne_bot milneQ3_ne_bot) milneQ3_spec

/-- The class `c` of `𝔭₂`. -/
noncomputable abbrev milneC : ClassGroup MO := cl milneP2

theorem mem_zpowers_of_rel {g : ClassGroup MO} {k : ℕ} (h : g * milneC ^ k = 1) :
    g ∈ Subgroup.zpowers milneC := by
  rw [eq_inv_of_mul_eq_one_left h]
  exact Subgroup.inv_mem _ (Subgroup.pow_mem _ (Subgroup.mem_zpowers _) k)

theorem milneC_pow_six : milneC ^ 6 = 1 := by
  have h2 : cl milneP3 = (milneC ^ 2)⁻¹ := eq_inv_of_mul_eq_one_left cl_rel_2
  have h3 := cl_rel_3
  rw [h2, inv_pow, ← pow_mul] at h3
  have : milneC ^ 6 = ((milneC ^ (2 * 3))⁻¹)⁻¹ := by rw [inv_inv]
  rw [this, h3, inv_one]

theorem cl_prime_mem (P : Ideal MO) (hP : P = milneP2 ∨ P = milneP3 ∨ P = milneP5 ∨ P = milneP7 ∨
    P = milneP11 ∨ P = milneQ2 ∨ P = milneQ3) : cl P ∈ Subgroup.zpowers milneC := by
  rcases hP with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Subgroup.mem_zpowers _
  · exact mem_zpowers_of_rel cl_rel_2
  · exact mem_zpowers_of_rel (k := 1) (by simpa using cl_rel_1)
  · exact mem_zpowers_of_rel cl_rel_4
  · exact mem_zpowers_of_rel cl_rel_5
  · exact mem_zpowers_of_rel (k := 1) (by simpa using cl_rel_6)
  · have h2 : cl milneP3 ∈ Subgroup.zpowers milneC := mem_zpowers_of_rel cl_rel_2
    rw [eq_inv_of_mul_eq_one_left cl_rel_7]
    exact Subgroup.inv_mem _ h2

/-- Every nonzero ideal of absolute norm at most `17` has class in `⟨c⟩`. -/
theorem cl_mem_of_norm : ∀ n : ℕ, ∀ I : Ideal MO, I ≠ ⊥ → Ideal.absNorm I = n → n ≤ 17 →
    cl I ∈ Subgroup.zpowers milneC := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro I hI hn hle
    by_cases htop : I = ⊤
    · rw [htop, cl_top]; exact one_mem _
    obtain ⟨P, hPmax, hIP⟩ := Ideal.exists_le_maximal I htop
    have hP0 : P ≠ ⊥ := by
      rintro rfl
      exact hI (le_bot_iff.1 hIP)
    have hPprime : P.IsPrime := hPmax.isPrime
    obtain ⟨J, hJ⟩ := Ideal.dvd_iff_le.2 hIP
    have hJ0 : J ≠ ⊥ := by
      rintro rfl
      exact hI (by rw [hJ, Ideal.mul_bot])
    have hnorm : n = Ideal.absNorm P * Ideal.absNorm J := by
      rw [← hn, hJ, map_mul]
    have hP1 : Ideal.absNorm P ≠ 1 := fun h => hPmax.ne_top (Ideal.absNorm_eq_one_iff.1 h)
    have hP2 : Ideal.absNorm P ≠ 0 := fun h => hP0 (Ideal.absNorm_eq_zero_iff.1 h)
    have hJ2 : Ideal.absNorm J ≠ 0 := fun h => hJ0 (Ideal.absNorm_eq_zero_iff.1 h)
    have hPle : Ideal.absNorm P ≤ 17 := by
      have : Ideal.absNorm P ≤ n := by rw [hnorm]; exact Nat.le_mul_of_pos_right _ (by omega)
      omega
    have hJlt : Ideal.absNorm J < n := by
      have : 2 ≤ Ideal.absNorm P := by omega
      have : 1 ≤ Ideal.absNorm J := by omega
      rw [hnorm]; nlinarith
    rw [hJ, cl_mul hP0 hJ0]
    exact Subgroup.mul_mem _ (cl_prime_mem P (prime_classify P hP0 hPle))
      (ih _ hJlt J hJ0 rfl (by omega))

theorem sq_contra : ∀ (s : ZMod 5), (s = 1 ∨ s = -1) → ∀ (e : ℕ), e ≤ 1 → ∀ t g : ZMod 5,
    t ≠ 0 → (4 - 1) ^ 3 * (s * (4 ^ e * t ^ 2)) ≠ g ^ 2 * (4 + 2) := by
  intro s hs e he
  have h : ∀ t g : ZMod 5, t ≠ 0 → (4 - 1) ^ 3 * (1 * (4 ^ 0 * t ^ 2)) ≠ g ^ 2 * (4 + 2) ∧
      (4 - 1) ^ 3 * (1 * (4 ^ 1 * t ^ 2)) ≠ g ^ 2 * (4 + 2) ∧
      (4 - 1) ^ 3 * (-1 * (4 ^ 0 * t ^ 2)) ≠ g ^ 2 * (4 + 2) ∧
      (4 - 1) ^ 3 * (-1 * (4 ^ 1 * t ^ 2)) ≠ g ^ 2 * (4 + 2) := by decide
  intro t g ht
  have := h t g ht
  interval_cases e <;> rcases hs with rfl | rfl <;> tauto

theorem cube_contra : ∀ (e : ℕ), e ≤ 2 → ∀ t g : ZMod 43,
    t ≠ 0 → (16 - 1) ^ 3 * (16 ^ e * t ^ 3) ≠ g ^ 3 * (16 + 2) := by
  intro e he
  have h : ∀ t g : ZMod 43, t ≠ 0 → (16 - 1) ^ 3 * (16 ^ 0 * t ^ 3) ≠ g ^ 3 * (16 + 2) ∧
      (16 - 1) ^ 3 * (16 ^ 1 * t ^ 3) ≠ g ^ 3 * (16 + 2) ∧
      (16 - 1) ^ 3 * (16 ^ 2 * t ^ 3) ≠ g ^ 3 * (16 + 2) := by decide
  intro t g ht
  have := h t g ht
  interval_cases e <;> tauto

theorem milne_root5 : (4 : ZMod 5) ^ 3 + 10 * 4 + 1 = 0 := by decide
theorem milne_root43 : (16 : ZMod 43) ^ 3 + 10 * 16 + 1 = 0 := by decide

theorem milneC_pow_three_ne_one : milneC ^ 3 ≠ 1 := by
  intro h3
  have hP : (milneP2 ^ 3).IsPrincipal :=
    (cl_eq_one_iff (pow_ne_zero _ milneP2_ne_bot)).1 (by rw [cl_pow milneP2_ne_bot]; exact h3)
  obtain ⟨γ, hγ'⟩ := hP
  have hγ : _ = Ideal.span {γ} := hγ'
  have hspan : Ideal.span {(milneAlpha - 1) ^ 3} = Ideal.span {γ ^ 2 * (milneAlpha + 2)} := by
    rw [← Ideal.span_singleton_pow, milne_rel_2, mul_pow, ← pow_mul, mul_comm 2 3, pow_mul, hγ,
      Ideal.span_singleton_pow, ← milne_rel_3, Ideal.span_singleton_mul_span_singleton]
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.1 hspan
  obtain ⟨e, w, he, hform⟩ := unit_sq_form u
  have hψ := congrArg (milneEval 5 4 milne_root5) hu
  have : Fact (1 < 5) := ⟨by norm_num⟩
  have hw : milneEval 5 4 milne_root5 (w : MO) ≠ 0 := (w.isUnit.map _).ne_zero
  have hα : milneEval 5 4 milne_root5 milneAlpha = 4 := milneEval_alpha _ _ _
  have hue : (milneAlphaUnit : MO) = milneAlpha := rfl
  rcases hform with hf | hf
  · refine sq_contra 1 (Or.inl rfl) e he _ (milneEval 5 4 milne_root5 γ) hw ?_
    rw [hf] at hu
    have hψ := congrArg (milneEval 5 4 milne_root5) hu
    simp only [Units.val_mul, Units.val_pow_eq_pow_val, hue, map_mul, map_pow, map_sub, map_add,
      map_one, hα, map_ofNat] at hψ
    simpa using hψ
  · refine sq_contra (-1) (Or.inr rfl) e he _ (milneEval 5 4 milne_root5 γ) hw ?_
    rw [hf] at hu
    have hψ := congrArg (milneEval 5 4 milne_root5) hu
    simp only [Units.val_neg, Units.val_mul, Units.val_pow_eq_pow_val, hue, map_neg, map_mul,
      map_pow, map_sub, map_add, map_one, hα, map_ofNat] at hψ
    simpa using hψ

theorem milneC_pow_two_ne_one : milneC ^ 2 ≠ 1 := by
  intro h2
  have hP : (milneP2 ^ 2).IsPrincipal :=
    (cl_eq_one_iff (pow_ne_zero _ milneP2_ne_bot)).1 (by rw [cl_pow milneP2_ne_bot]; exact h2)
  obtain ⟨γ, hγ'⟩ := hP
  have hγ : _ = Ideal.span {γ} := hγ'
  have hspan : Ideal.span {(milneAlpha - 1) ^ 3} = Ideal.span {γ ^ 3 * (milneAlpha + 2)} := by
    rw [← Ideal.span_singleton_pow, milne_rel_2, mul_pow, ← pow_mul, pow_mul, hγ,
      Ideal.span_singleton_pow, ← milne_rel_3, Ideal.span_singleton_mul_span_singleton]
  obtain ⟨u, hu⟩ := Ideal.span_singleton_eq_span_singleton.1 hspan
  obtain ⟨e, w, he, hform⟩ := unit_cube_form u
  have : Fact (1 < 43) := ⟨by norm_num⟩
  have hw : milneEval 43 16 milne_root43 (w : MO) ≠ 0 := (w.isUnit.map _).ne_zero
  have hα : milneEval 43 16 milne_root43 milneAlpha = 16 := milneEval_alpha _ _ _
  have hue : (milneAlphaUnit : MO) = milneAlpha := rfl
  refine cube_contra e he _ (milneEval 43 16 milne_root43 γ) hw ?_
  rw [hform] at hu
  have hψ := congrArg (milneEval 43 16 milne_root43) hu
  simp only [Units.val_mul, Units.val_pow_eq_pow_val, hue, map_mul, map_pow, map_sub, map_add,
    map_one, hα, map_ofNat] at hψ
  simpa using hψ

theorem milne_minkowski : (4 / Real.pi) ^ NumberField.InfinitePlace.nrComplexPlaces MilneCubicField *
    ((Module.finrank ℚ MilneCubicField).factorial / (Module.finrank ℚ MilneCubicField) ^
      (Module.finrank ℚ MilneCubicField) * √|(discr MilneCubicField : ℝ)|) < 18 := by
  rw [milne_places.2, milne_finrank, milne_discr]
  have hpi := Real.pi_gt_d4
  have hs : √|((-4027 : ℤ) : ℝ)| < 63.46 := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num [abs_of_neg]
  set s := √|((-4027 : ℤ) : ℝ)|
  have hs0 : 0 ≤ s := Real.sqrt_nonneg _
  have hpi0 : 0 < Real.pi := Real.pi_pos
  norm_num [Nat.factorial]
  rw [div_mul_eq_mul_div, div_lt_iff₀ hpi0]
  nlinarith

theorem milne_generates : ∀ g : ClassGroup MO, g ∈ Subgroup.zpowers milneC := by
  intro g
  obtain ⟨I, hI, hbound⟩ := NumberField.exists_ideal_in_class_of_norm_le (K := MilneCubicField) g
  have hlt := lt_of_le_of_lt hbound milne_minkowski
  have hle : Ideal.absNorm (I : Ideal MO) ≤ 17 := by
    have : (Ideal.absNorm (I : Ideal MO) : ℝ) < 18 := hlt
    have : Ideal.absNorm (I : Ideal MO) < 18 := by exact_mod_cast this
    omega
  have hI0 : (I : Ideal MO) ≠ ⊥ := nonZeroDivisors.coe_ne_zero I
  rw [← hI]
  have := cl_mem_of_norm _ (I : Ideal MO) hI0 rfl hle
  rwa [cl_of_ne hI0] at this

theorem milneC_orderOf : orderOf milneC = 6 := by
  have hd : orderOf milneC ∣ 6 := orderOf_dvd_of_pow_eq_one milneC_pow_six
  have h6 : orderOf milneC ≤ 6 := Nat.le_of_dvd (by norm_num) hd
  have hpos : 0 < orderOf milneC := orderOf_pos _
  have h2 := milneC_pow_two_ne_one
  have h3 := milneC_pow_three_ne_one
  have h1 : milneC ≠ 1 := fun h => h2 (by rw [h, one_pow])
  have hpow := pow_orderOf_eq_one milneC
  generalize orderOf milneC = k at *
  interval_cases k
  · exact absurd (by simpa using hpow) h1
  · exact absurd hpow h2
  · exact absurd hpow h3
  · omega
  · omega
  · rfl

/-- **Example 5.14, class group.** The class group of $K = \mathbb Q[\alpha]$, $\alpha^3 + 10\alpha + 1 = 0$, is
cyclic of order $6$ (generated by the class of the prime $\mathfrak p = (2, 1 + \alpha)$ of norm $2$). -/
@[kb "milne2020ant" "v3.08, Example 5.14, p. 93"]
theorem example_5_14_classGroup :
    IsCyclic (ClassGroup (𝓞 MilneCubicField)) ∧ classNumber MilneCubicField = 6 := by
  refine ⟨⟨milneC, milne_generates⟩, ?_⟩
  have h := orderOf_eq_card_of_forall_mem_zpowers milne_generates
  rw [milneC_orderOf] at h
  unfold classNumber
  rw [← Nat.card_eq_fintype_card]
  exact h.symm

