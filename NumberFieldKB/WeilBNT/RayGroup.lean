import NumberFieldKB.WeilBNT.IdeleCharacterGenerators

/-!
# Weil, *Basic Number Theory*, VII.§8, text p. 138: the group $\gamma$ for $g_v=1+\mathfrak p_v^{m(v)}$

Notation as in `NumberFieldKB.WeilBNT.IdeleCharacterGenerators`: $k$ a number field (`K`), $S$ a finite set of finite
places, $\gamma=\bigcap_{v\in P}(k^\times\cap g_v)$ (`yGroup`). Weil's example (p. 138): take an integral ideal
$\mathfrak m=\prod_{v\in S}\mathfrak p_v^{m(v)}$ with every $m(v)\ge1$ (`modIdeal S m`), some real places
$v_1,\dots,v_p$ (the set `R`), and
$g_v=1+\mathfrak p_v^{m(v)}$ for $v\in S$ (`unitsOnePlusPow`), $g_v=\mathbb R_+^\times$ at $v_1,\dots,v_p$,
$g_v=k_v^\times$ at the other infinite places (`gInfPos R`).

* **`weil_VII_8_text138`**: "one sees at once" that $\gamma\cap\mathfrak r$ consists of the elements $\alpha\ne0$ of
  $\mathfrak r$ with $\alpha\equiv1\pmod{\mathfrak m}$ and $\alpha$ positive at $v_1,\dots,v_p$.
* **`weil_VII_8_text138_generated`**: with Prop. 18, $\gamma$ is generated by these elements.
* The $g_v$ are open (`isOpen_unitsOnePlusPow`, `isOpen_gInfPos`) and the finite ones lie in $r_v^\times$, as Prop. 17
  and Prop. 18 require.
-/

open IsDedekindDomain NumberField Filter Topology NumberFieldKB.MilneCFT

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {K : Type} [Field K] [NumberField K]

/-- $1+\mathfrak p_v^n$ inside $r_v^\times$: the units $u$ of $k_v$ with $\lvert u\rvert_v=1$ and
$\lvert u-1\rvert_v\le\lvert\pi_v\rvert_v^{\,n}$ (for $n\ge1$ the first condition follows from the second). -/
def unitsOnePlusPow (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) : Subgroup (v.adicCompletion K)ˣ where
  carrier := {u | Valued.v (u : v.adicCompletion K) = 1 ∧
    Valued.v ((u : v.adicCompletion K) - 1) ≤ WithZero.exp (-(n : ℤ))}
  one_mem' := by
    refine ⟨by simp, ?_⟩
    simp
  mul_mem' := by
    rintro a b ⟨ha1, ha2⟩ ⟨hb1, hb2⟩
    refine ⟨by simp [ha1, hb1], ?_⟩
    have e : ((a * b : (v.adicCompletion K)ˣ) : v.adicCompletion K) - 1 =
        (a : v.adicCompletion K) * ((b : v.adicCompletion K) - 1) + ((a : v.adicCompletion K) - 1) := by
      simp only [Units.val_mul]; ring
    rw [e]
    refine (Valuation.map_add _ _ _).trans (max_le ?_ ha2)
    rw [map_mul, ha1, one_mul]; exact hb2
  inv_mem' := by
    rintro a ⟨ha1, ha2⟩
    refine ⟨by simp [ha1], ?_⟩
    have e : ((a⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) - 1 =
        -(((a⁻¹ : (v.adicCompletion K)ˣ) : v.adicCompletion K) * ((a : v.adicCompletion K) - 1)) := by
      have : (a : v.adicCompletion K) ≠ 0 := a.ne_zero
      rw [Units.val_inv_eq_inv_val]; field_simp; ring
    rw [e, Valuation.map_neg, map_mul, Units.val_inv_eq_inv_val, map_inv₀, ha1, inv_one, one_mul]
    exact ha2

/-- $\mathbb R_+^\times$ inside the units of the completion at a real place. -/
def unitsPositive {w : InfinitePlace K} (hw : w.IsReal) : Subgroup (w.Completion)ˣ where
  carrier := {u | 0 < InfinitePlace.Completion.extensionEmbeddingOfIsReal hw (u : w.Completion)}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb
    simp only [Set.mem_ofPred_eq, Units.val_mul, map_mul] at ha hb ⊢
    exact mul_pos ha hb
  inv_mem' := by
    intro a ha
    simp only [Set.mem_ofPred_eq, Units.val_inv_eq_inv_val, map_inv₀] at ha ⊢
    exact inv_pos.mpr ha

open scoped Classical in
/-- Weil's choice at the infinite places: $\mathbb R_+^\times$ at the real places in `R`, everything elsewhere. -/
def gInfPos (R : Set (InfinitePlace K)) (w : InfinitePlace K) : Subgroup (w.Completion)ˣ :=
  if h : w.IsReal ∧ w ∈ R then unitsPositive h.1 else ⊤

/-- The modulus $\mathfrak m=\prod_{v\in S}\mathfrak p_v^{m(v)}$. -/
def modIdeal (S : Finset (HeightOneSpectrum (𝓞 K))) (m : S → ℕ) : Ideal (𝓞 K) :=
  ∏ v : S, v.1.asIdeal ^ m v

theorem onePlusPow_iff_mem (v : HeightOneSpectrum (𝓞 K)) {n : ℕ} (hn : 1 ≤ n) (a : 𝓞 K) :
    (Valued.v (algebraMap K (v.adicCompletion K) (a : K)) = 1 ∧
      Valued.v (algebraMap K (v.adicCompletion K) (a : K) - 1) ≤ WithZero.exp (-(n : ℤ))) ↔
      a - 1 ∈ v.asIdeal ^ n := by
  have hsub : Valued.v (algebraMap K (v.adicCompletion K) (a : K) - 1) = v.intValuation (a - 1) := by
    have e : algebraMap K (v.adicCompletion K) (a : K) - 1 = algebraMap K (v.adicCompletion K) ((a : K) - 1) := by
      rw [map_sub, map_one]
    have e2 : ((a : K) - 1) = algebraMap (𝓞 K) K (a - 1) := by simp
    rw [e]
    erw [HeightOneSpectrum.valuedAdicCompletion_eq_valuation' (R := 𝓞 K) (K := K) (v := v) ((a : K) - 1)]
    rw [e2, HeightOneSpectrum.valuation_of_algebraMap]
  rw [hsub, HeightOneSpectrum.intValuation_le_pow_iff_mem]
  constructor
  · exact fun h => h.2
  · intro h
    refine ⟨?_, h⟩
    have hlt : Valued.v (algebraMap K (v.adicCompletion K) (a : K) - 1) < 1 := by
      rw [hsub]
      refine lt_of_le_of_lt ((HeightOneSpectrum.intValuation_le_pow_iff_mem _ _ _).2 h) ?_
      rw [← WithZero.exp_zero, WithZero.exp_lt_exp]; omega
    have := Valuation.map_eq_of_sub_lt (Valued.v (R := v.adicCompletion K))
      (x := 1) (y := algebraMap K (v.adicCompletion K) (a : K)) (by rwa [map_one])
    rwa [map_one] at this

omit [NumberField K] in
theorem mem_gInfPos_iff (R : Set (InfinitePlace K)) (w : InfinitePlace K) (u : (w.Completion)ˣ) :
    u ∈ gInfPos R w ↔ ∀ hw : w.IsReal, w ∈ R →
      0 < InfinitePlace.Completion.extensionEmbeddingOfIsReal hw (u : w.Completion) := by
  unfold gInfPos
  split_ifs with h
  · exact ⟨fun hu _ _ => hu, fun hu => hu h.1 h.2⟩
  · refine ⟨fun _ hw hR => absurd ⟨hw, hR⟩ h, fun _ => Subgroup.mem_top _⟩

theorem mem_modIdeal_iff (S : Finset (HeightOneSpectrum (𝓞 K))) (m : S → ℕ) (x : 𝓞 K) :
    x ∈ modIdeal S m ↔ ∀ v : S, x ∈ v.1.asIdeal ^ m v := by
  unfold modIdeal
  rw [← Ideal.dvd_span_singleton]
  constructor
  · intro h v
    rw [← Ideal.dvd_span_singleton]
    exact (Finset.dvd_prod_of_mem (fun v : S => v.1.asIdeal ^ m v) (Finset.mem_univ v)).trans h
  · intro h
    refine Finset.prod_dvd_of_coprime ?_ fun v _ => (Ideal.dvd_span_singleton).2 (h v)
    intro v _ v' _ hne
    exact HeightOneSpectrum.isCoprime_pow_of_ne _ _ (fun e => hne (Subtype.ext e)) _ _

theorem isOpen_valued_sub_le {F : Type*} [Field F] [Valued F (WithZero (Multiplicative ℤ))] (a z : F)
    (hz : z ≠ 0) : IsOpen {x : F | Valued.v (x - a) ≤ Valued.v z} := by
  rw [isOpen_iff_mem_nhds]
  intro x hx
  rw [Valued.mem_nhds]
  have hz' : (Valued.v (R := F)).restrict z ≠ 0 := by
    rw [Ne, Valuation.restrict_eq_zero_iff _]; simpa using hz
  refine ⟨Units.mk0 _ hz', fun y hy => ?_⟩
  have hy' : Valued.v (y - x) < Valued.v z := (Valuation.restrict_lt_iff _).1 hy
  have e : y - a = (y - x) + (x - a) := by ring
  show Valued.v (y - a) ≤ Valued.v z
  rw [e]
  exact (Valuation.map_add _ _ _).trans (max_le hy'.le hx)

theorem isOpen_valued_eq_one {F : Type*} [Field F] [Valued F (WithZero (Multiplicative ℤ))] :
    IsOpen {x : F | Valued.v x = 1} := by
  rw [isOpen_iff_mem_nhds]
  intro x hx
  rw [Valued.mem_nhds]
  refine ⟨1, fun y hy => ?_⟩
  have hy' : Valued.v (y - x) < 1 := (Valuation.restrict_lt_one_iff _).1 (by simpa using hy)
  have hx' : Valued.v x = 1 := hx
  show Valued.v y = 1
  have e : y = x + (y - x) := by ring
  rw [e, Valuation.map_add_eq_of_lt_left _ (by rw [hx']; exact hy'), hx']

theorem isOpen_unitsOnePlusPow (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) :
    IsOpen (unitsOnePlusPow (K := K) v n : Set (v.adicCompletion K)ˣ) := by
  have h1 : IsOpen {x : v.adicCompletion K | Valued.v x = 1} := isOpen_valued_eq_one
  obtain ⟨π, hπ⟩ := v.valuation_exists_uniformizer K
  have hπ0 : (π : v.adicCompletion K) ≠ 0 := by
    intro h
    have := HeightOneSpectrum.valuedAdicCompletion_eq_valuation' (R := 𝓞 K) (K := K) (v := v) π
    rw [h, map_zero, hπ] at this
    exact WithZero.exp_ne_zero this.symm
  have hz : Valued.v ((π : v.adicCompletion K) ^ n) = WithZero.exp (-(n : ℤ)) := by
    rw [map_pow, HeightOneSpectrum.valuedAdicCompletion_eq_valuation', hπ, ← WithZero.exp_nsmul]
    simp
  have h2 : IsOpen {x : v.adicCompletion K | Valued.v (x - 1) ≤ WithZero.exp (-(n : ℤ))} := by
    rw [← hz]; exact isOpen_valued_sub_le 1 _ (pow_ne_zero _ hπ0)
  exact (h1.preimage Units.continuous_val).inter (h2.preimage Units.continuous_val)

omit [NumberField K] in
theorem isOpen_gInfPos (R : Set (InfinitePlace K)) (w : InfinitePlace K) :
    IsOpen (gInfPos R w : Set (w.Completion)ˣ) := by
  unfold gInfPos
  split_ifs with h
  · have hc : Continuous (InfinitePlace.Completion.extensionEmbeddingOfIsReal h.1) :=
      (InfinitePlace.Completion.isometry_extensionEmbeddingOfIsReal h.1).continuous
    exact isOpen_lt continuous_const (hc.comp Units.continuous_val)
  · exact isOpen_univ

theorem unitsOnePlusPow_valued (v : HeightOneSpectrum (𝓞 K)) (n : ℕ) :
    ∀ u ∈ unitsOnePlusPow (K := K) v n, Valued.v (u : v.adicCompletion K) = 1 :=
  fun _ hu => hu.1

variable (S : Finset (HeightOneSpectrum (𝓞 K))) (m : S → ℕ) (R : Set (InfinitePlace K))

/-- **Weil, VII.§8, text p. 138**, number field case: with $g_v=1+\mathfrak p_v^{m(v)}$ ($v\in S$, $m(v)\ge1$),
$g_v=\mathbb R_+^\times$ at the real places in `R` and $g_v=k_v^\times$ at the other infinite places, a nonzero integer
$\alpha$ of $k$ lies in $\gamma$ iff $\alpha\equiv1\pmod{\mathfrak m}$ and $\alpha$ is positive at the real places
in `R`. -/
@[kb "weil1973bnt" "Ch. VII, §8, text p. 138 (gamma for g_v = 1 + p_v^m(v)), number field case"]
theorem weil_VII_8_text138 (hm : ∀ v, 1 ≤ m v) (a : 𝓞 K) (ha : (a : K) ≠ 0) :
    Units.mk0 (a : K) ha ∈ yGroup S (gInfPos R) (fun v => unitsOnePlusPow v.1 (m v)) ↔
      a - 1 ∈ modIdeal S m ∧ ∀ w ∈ R, ∀ hw : w.IsReal, 0 < InfinitePlace.embedding_of_isReal hw (a : K) := by
  have key : ∀ (w : InfinitePlace K) (hw : w.IsReal),
      InfinitePlace.Completion.extensionEmbeddingOfIsReal hw
        (((pproj S (IdeleGroup.unitEmbedding (𝓞 K) K (Units.mk0 (a : K) ha))).1 w : (w.Completion)ˣ) : w.Completion)
        = InfinitePlace.embedding_of_isReal hw (a : K) := fun w hw => extEmbedding_coe hw (a : K)
  change ((∀ w, (pproj S (IdeleGroup.unitEmbedding (𝓞 K) K (Units.mk0 (a : K) ha))).1 w ∈ gInfPos R w) ∧
    ∀ v, (pproj S (IdeleGroup.unitEmbedding (𝓞 K) K (Units.mk0 (a : K) ha))).2 v ∈ unitsOnePlusPow v.1 (m v))
    ↔ _
  rw [mem_modIdeal_iff]
  refine (and_congr ?_ ?_).trans and_comm
  · simp only [mem_gInfPos_iff, key]
    constructor
    · intro h w hR hw; exact h w hw hR
    · intro h w hw hR; exact h w hR hw
  · refine forall_congr' fun v => ?_
    exact onePlusPow_iff_mem v.1 (hm v) a

/-- **Weil, VII.§8, text p. 138 with Prop. 18**: $\gamma$ is generated by the nonzero integers $\alpha\equiv1
\pmod{\mathfrak m}$ positive at the real places in `R`. -/
theorem weil_VII_8_text138_generated (hm : ∀ v, 1 ≤ m v) :
    Subgroup.closure {ξ : Kˣ | ∃ a : 𝓞 K, (a : K) = ξ ∧ a - 1 ∈ modIdeal S m ∧
        ∀ w ∈ R, ∀ hw : w.IsReal, 0 < InfinitePlace.embedding_of_isReal hw (a : K)} =
      yGroup S (gInfPos R) (fun v => unitsOnePlusPow v.1 (m v)) := by
  rw [← weil_VII_8_prop18 (S := S) (gInf := gInfPos R) (gFin := fun v => unitsOnePlusPow v.1 (m v))
    (fun w => isOpen_gInfPos R w) (fun v => isOpen_unitsOnePlusPow v.1 (m v))
    (fun v => unitsOnePlusPow_valued v.1 (m v))]
  congr 1
  ext ξ
  constructor
  · rintro ⟨a, ha, h1, h2⟩
    have hne : (a : K) ≠ 0 := by rw [ha]; exact ξ.ne_zero
    have hξ : ξ = Units.mk0 (a : K) hne := Units.ext (by simp [ha])
    refine ⟨?_, a, ha⟩
    rw [hξ]
    exact (weil_VII_8_text138 S m R hm a hne).2 ⟨h1, h2⟩
  · rintro ⟨hξ, a, ha⟩
    have hne : (a : K) ≠ 0 := by rw [ha]; exact ξ.ne_zero
    have hξ' : ξ = Units.mk0 (a : K) hne := Units.ext (by simp [ha])
    rw [hξ'] at hξ
    obtain ⟨h1, h2⟩ := (weil_VII_8_text138 S m R hm a hne).1 hξ
    exact ⟨a, ha, h1, h2⟩


end NumberFieldKB.WeilBNT
