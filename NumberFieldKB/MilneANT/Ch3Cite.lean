import Mathlib
import QuadFormsKB.Citation

/-!
# Milne, Algebraic Number Theory, Chapter 3: results in Mathlib

Citation file for J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), bibliography key
`milne2020ant`, Chapter 3 (Dedekind domains and factorization). It covers the items of the chapter that
are already in Mathlib.

The convention is as follows.

* When one Mathlib declaration states the book's result in essentially the book's form, the declaration
  is tagged directly with `attribute [kb "milne2020ant" "..."]`. A plain comment above the attribute names
  the item and any difference in form (for example a special case, or one direction of an equivalence).
* When the book's form differs from Mathlib's (several Mathlib lemmas combined, different packaging, an
  equivalence against one direction, a general statement against the number field case), this file proves a
  short restating theorem in the book's form from the Mathlib results. The docstring says in words what is
  claimed, which Mathlib declarations are restated, and what differs from the book.
* Locators have the form `v3.08, <kind> <number>, p. <printed page>`. The printed page is the pdf page minus 2.

Items of Chapter 3 that are not in Mathlib (Theorem 3.32, Lemma 3.38, Remark 3.39) are not cited here.
Milne's convention from page 48 onward that a Dedekind domain is not a field is not Mathlib's convention:
`IsDedekindDomain` allows fields, exactly as Milne's Definition 3.3 does. Statements that need a nonzero
prime to exist add the hypothesis that the ring is not a field.
-/

open IsDedekindDomain

namespace NumberFieldKB.MilneANT

/-- Milne, Example 3.1: for a prime number $p$, the localization $\mathbb Z_{(p)}$ of the integers at the
prime ideal $(p)$ is a discrete valuation ring, and it has exactly one nonzero prime ideal.

The prime ideal is given as an arbitrary prime ideal `P` of the integers equal to the ideal generated by $p$.
This restates `IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain` for the principal ideal
domain $\mathbb Z$ (a Dedekind domain by `IsPrincipalIdealRing.isDedekindDomain`) together with
`IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime`. The description of the units and the prime
elements is not restated. -/
@[kb "milne2020ant" "v3.08, Example 3.1, p. 46"]
theorem ex_3_1 (p : ℕ) [Fact p.Prime] (P : Ideal ℤ) [P.IsPrime] (hP : P = Ideal.span {(p : ℤ)}) :
    IsDiscreteValuationRing (Localization.AtPrime P) ∧
      ∃! Q : Ideal (Localization.AtPrime P), Q ≠ ⊥ ∧ Q.IsPrime := by
  have hne : P ≠ ⊥ := by
    rw [hP]; simpa using (Fact.out : p.Prime).ne_zero
  have h : IsDiscreteValuationRing (Localization.AtPrime P) :=
    IsLocalization.AtPrime.isDiscreteValuationRing_of_dedekind_domain ℤ hne _
  exact ⟨h, ((IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime _).1 h).2⟩

/-- Milne, Proposition 3.2: an integral domain is a discrete valuation ring if and only if it is
noetherian, integrally closed, and has exactly one nonzero prime ideal.

This restates the equivalence of items 1 and 4 in `IsDiscreteValuationRing.TFAE`, whose hypotheses
(noetherian, local, not a field) are not part of the book's statement; here they are derived from the three
conditions. It also uses `IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime` for the forward direction.
Milne defines a discrete valuation ring as a principal ideal domain with exactly one nonzero prime ideal,
which is the second statement of that last lemma. -/
@[kb "milne2020ant" "v3.08, Prop. 3.2, p. 47"]
theorem prop_3_2 (A : Type*) [CommRing A] [IsDomain A] :
    IsDiscreteValuationRing A ↔
      IsNoetherianRing A ∧ IsIntegrallyClosed A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime := by
  constructor
  · intro h
    exact ⟨inferInstance, inferInstance,
      ((IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime A).1 h).2⟩
  · rintro ⟨hn, hi, P, ⟨hP0, hPp⟩, hPu⟩
    have hnf : ¬ IsField A := Ring.not_isField_iff_exists_prime.2 ⟨P, hP0, hPp⟩
    have hmax : ∀ M : Ideal A, M.IsMaximal → M = P := by
      intro M hM
      have hM0 : M ≠ ⊥ := Ring.ne_bot_of_isMaximal_of_not_isField hM hnf
      exact hPu M ⟨hM0, hM.isPrime⟩
    obtain ⟨M, hM, hPM⟩ := Ideal.exists_le_maximal P hPp.ne_top
    have hMP := hmax M hM
    subst hMP
    have : IsLocalRing A := IsLocalRing.of_unique_max_ideal ⟨M, hM, hmax⟩
    have key := IsDiscreteValuationRing.TFAE A hnf
    refine (key.out 4 1).1 ?_
    exact ⟨hi, M, ⟨hP0, hPp⟩, hPu⟩

-- Milne, Definition 3.3 (Dedekind domain: noetherian, integrally closed, every nonzero prime maximal).
-- Same notion; Mathlib's `IsDedekindDomain` allows fields, as the book's definition does (the book then
-- excludes fields by convention).
attribute [kb "milne2020ant" "v3.08, Def. 3.3, p. 48"] IsDedekindDomain

-- Milne, Proposition 3.4 (a localization of a Dedekind domain is a Dedekind domain).
-- Same statement; the multiplicative subset is required to lie in the nonzero divisors, which is the
-- book's convention that a multiplicative subset does not contain zero.
attribute [kb "milne2020ant" "v3.08, Prop. 3.4, p. 48"] IsLocalization.isDedekindDomain

/-- Milne, Proposition 3.5: a localization of a noetherian integral domain is noetherian, and a
localization of an integrally closed integral domain is integrally closed.

This combines `IsLocalization.isNoetherianRing` (part (a)) and `isIntegrallyClosed_of_isLocalization`
(part (b)) in one statement. The multiplicative subset is required to lie in the nonzero divisors. -/
@[kb "milne2020ant" "v3.08, Prop. 3.5, p. 48"]
theorem prop_3_5 (A : Type*) [CommRing A] [IsDomain A] {M : Submonoid A} (hM : M ≤ nonZeroDivisors A)
    (S : Type*) [CommRing S] [Algebra A S] [IsLocalization M S] :
    (IsNoetherianRing A → IsNoetherianRing S) ∧ (IsIntegrallyClosed A → IsIntegrallyClosed S) :=
  ⟨fun h => IsLocalization.isNoetherianRing M S h,
    fun _ => isIntegrallyClosed_of_isLocalization S M hM⟩

/-- Milne, Proposition 3.6: a noetherian integral domain is a Dedekind domain if and only if its
localization at every nonzero prime ideal is a discrete valuation ring.

This restates `isDedekindDomain_iff_isDiscreteValuationRing_atPrime` with the noetherian hypothesis moved
into the assumptions, as in the book. The book writes "every prime ideal" but means every nonzero prime
ideal (the localization at the zero ideal is the fraction field), as here. -/
@[kb "milne2020ant" "v3.08, Prop. 3.6, p. 48"]
theorem prop_3_6 (A : Type*) [CommRing A] [IsDomain A] [IsNoetherianRing A] :
    IsDedekindDomain A ↔
      ∀ P : Ideal A, P ≠ ⊥ → ∀ _ : P.IsPrime, IsDiscreteValuationRing (Localization.AtPrime P) :=
  ⟨fun h => (isDedekindDomain_iff_isDiscreteValuationRing_atPrime.1 h).2,
    fun h => isDedekindDomain_iff_isDiscreteValuationRing_atPrime.2 ⟨inferInstance, h⟩⟩

/-- Milne, Theorem 3.7: every nonzero ideal of a Dedekind domain is a product of nonzero prime ideals,
and the factors (with multiplicity) are uniquely determined.

The factorization is stated as a multiset of nonzero prime ideals: the multiplicity of a prime in the
multiset is its exponent, so "distinct primes with positive exponents" is the same data. The statement
also holds for the unit ideal (empty product), so the book's hypothesis "proper" is not needed. It restates
`Ideal.uniqueFactorizationMonoid` through `UniqueFactorizationMonoid.normalizedFactors`,
`Ideal.prod_normalizedFactors_eq_self` and `UniqueFactorizationMonoid.normalizedFactors_prod_of_prime`. -/
@[kb "milne2020ant" "v3.08, Thm. 3.7, p. 49"]
theorem thm_3_7 (A : Type*) [CommRing A] [IsDedekindDomain A] {a : Ideal A} (h0 : a ≠ ⊥) :
    ∃ s : Multiset (Ideal A), (∀ p ∈ s, p ≠ ⊥ ∧ p.IsPrime) ∧ s.prod = a ∧
      ∀ t : Multiset (Ideal A), (∀ p ∈ t, p ≠ ⊥ ∧ p.IsPrime) → t.prod = a → t = s := by
  refine ⟨UniqueFactorizationMonoid.normalizedFactors a, ?_, ?_, ?_⟩
  · intro p hp
    have := UniqueFactorizationMonoid.prime_of_normalized_factor p hp
    exact ⟨this.ne_zero, Ideal.isPrime_of_prime this⟩
  · exact Ideal.prod_normalizedFactors_eq_self h0
  · intro t ht htp
    have hp : ∀ p ∈ t, Prime p := fun p hp => Ideal.prime_of_isPrime (ht p hp).1 (ht p hp).2
    rw [← htp]
    exact (UniqueFactorizationMonoid.normalizedFactors_prod_of_prime hp).symm

-- Milne, Lemma 3.8 (in a noetherian ring every ideal contains a product of prime ideals).
-- General noetherian ring form; Mathlib does not require the primes to be nonzero here (for the zero
-- ideal of a domain that cannot be required). The nonzero-prime form is tagged just below.
attribute [kb "milne2020ant" "v3.08, Lemma 3.8, p. 49"] PrimeSpectrum.exists_primeSpectrum_prod_le

-- Milne, Lemma 3.8, the form with nonzero primes: for a noetherian domain that is not a field and a
-- nonzero ideal, the ideal contains a nonzero product of prime ideals (so all the primes are nonzero).
attribute [kb "milne2020ant"
  "v3.08, Lemma 3.8, p. 49 (nonzero ideal of a noetherian domain that is not a field)"]
  PrimeSpectrum.exists_primeSpectrum_prod_le_and_ne_bot_of_domain

-- Milne, Lemma 3.9 (relatively prime ideals have relatively prime powers).
-- Same statement for any semiring, "relatively prime" being `I ⊔ J = ⊤`.
attribute [kb "milne2020ant" "v3.08, Lemma 3.9, p. 49"] Ideal.pow_sup_pow_eq_top

-- Milne, Remark 3.12 (the exponent of a prime in the factorization of a nonzero ideal is positive if and
-- only if the prime contains the ideal). Mathlib states this for membership in the normalized factors; the
-- middle condition of the book (the extended ideal in the localization is proper) is not covered.
attribute [kb "milne2020ant" "v3.08, Remark 3.12, p. 50 (first and last conditions only)"]
  Ideal.mem_normalizedFactors_iff

/-- Milne, Corollary 3.13: for ideals $\mathfrak a$ and $\mathfrak b$ of a Dedekind domain that is not
a field, $\mathfrak a \subseteq \mathfrak b$ if and only if $\mathfrak a A_{\mathfrak p} \subseteq
\mathfrak b A_{\mathfrak p}$ for all nonzero prime ideals $\mathfrak p$; in particular
$\mathfrak a = \mathfrak b$ if and only if the localizations agree at all nonzero primes.

This restates `Ideal.le_of_localization_maximal` and `Ideal.eq_of_localization_maximal`, which hold for any
commutative ring and all maximal ideals. In a Dedekind domain that is not a field the maximal ideals are the
nonzero primes (`Ring.ne_bot_of_isMaximal_of_not_isField`). The hypothesis that the ring is not a field is
necessary and matches the book's convention. The remark on divisibility after the corollary is
`Ideal.dvd_iff_le` and is not restated. -/
@[kb "milne2020ant" "v3.08, Cor. 3.13, p. 51"]
theorem cor_3_13 (A : Type*) [CommRing A] [IsDedekindDomain A] (hA : ¬ IsField A) (a b : Ideal A) :
    (a ≤ b ↔ ∀ P : Ideal A, P ≠ ⊥ → ∀ _ : P.IsPrime,
      Ideal.map (algebraMap A (Localization.AtPrime P)) a ≤
        Ideal.map (algebraMap A (Localization.AtPrime P)) b) ∧
    (a = b ↔ ∀ P : Ideal A, P ≠ ⊥ → ∀ _ : P.IsPrime,
      Ideal.map (algebraMap A (Localization.AtPrime P)) a =
        Ideal.map (algebraMap A (Localization.AtPrime P)) b) := by
  refine ⟨⟨fun h P _ _ => Ideal.map_mono h, fun h => Ideal.le_of_localization_maximal ?_⟩,
    ⟨fun h P _ _ => by rw [h], fun h => Ideal.eq_of_localization_maximal ?_⟩⟩
  · intro P hP
    exact h P (Ring.ne_bot_of_isMaximal_of_not_isField hP hA) hP.isPrime
  · intro P hP
    exact h P (Ring.ne_bot_of_isMaximal_of_not_isField hP hA) hP.isPrime

/-- Milne, Corollary 3.14: an integral domain with only finitely many prime ideals is a Dedekind domain
if and only if it is a principal ideal domain.

This restates the two directions `IsPrincipalIdealRing.of_finite_primes` (Dedekind implies principal) and
`IsPrincipalIdealRing.isDedekindDomain` (principal implies Dedekind) as one equivalence. -/
@[kb "milne2020ant" "v3.08, Cor. 3.14, p. 51"]
theorem cor_3_14 (A : Type*) [CommRing A] [IsDomain A] (h : {I : Ideal A | I.IsPrime}.Finite) :
    IsDedekindDomain A ↔ IsPrincipalIdealRing A :=
  ⟨fun _ => IsPrincipalIdealRing.of_finite_primes h, fun _ =>
    IsPrincipalIdealRing.isDedekindDomain A⟩

-- Milne, Corollary 3.15 (if a contains b, b nonzero, in a Dedekind domain, then a = b + (a) for some a).
-- Same statement, with the ideals named `I ≤ J`.
attribute [kb "milne2020ant" "v3.08, Cor. 3.15, p. 51"] IsDedekindDomain.exists_sup_span_eq

-- Milne, Corollary 3.16 (an ideal containing a nonzero element a is generated by a and one more element).
-- Same statement; the second generator is not stated to lie in the ideal, which follows from equality.
attribute [kb "milne2020ant" "v3.08, Cor. 3.16, p. 51"] IsDedekindDomain.exists_eq_span_pair

-- Milne, Proposition 3.18 (a Dedekind domain that is a unique factorization domain is a principal ideal
-- domain). Same statement.
attribute [kb "milne2020ant" "v3.08, Prop. 3.18, p. 52"]
  IsPrincipalIdealRing.of_isDedekindDomain_of_uniqueFactorizationMonoid

/-- Milne, Theorem 3.20: the nonzero fractional ideals of a Dedekind domain form a group, and it is the free
abelian group on the nonzero prime ideals.

The first part says that every nonzero fractional ideal has the inverse given by `FractionalIdeal`'s
inverse, from the `Semifield` structure `FractionalIdeal.semifield`. The second part says that every nonzero
fractional ideal is, in exactly one way, a finite product of integer powers of the primes (an exponent
function on the nonzero primes with finite support). This restates `FractionalIdeal.semifield`,
`FractionalIdeal.finprod_heightOneSpectrum_factorization'` and `FractionalIdeal.count_finsuppProd`. The
nonzero primes are `IsDedekindDomain.HeightOneSpectrum A`. -/
@[kb "milne2020ant" "v3.08, Thm. 3.20, p. 53"]
theorem thm_3_20 (A K : Type*) [CommRing A] [IsDedekindDomain A] [Field K] [Algebra A K]
    [IsFractionRing A K] :
    (∀ I : FractionalIdeal (nonZeroDivisors A) K, I ≠ 0 → I * I⁻¹ = 1) ∧
    ∀ I : FractionalIdeal (nonZeroDivisors A) K, I ≠ 0 →
      ∃! n : HeightOneSpectrum A →₀ ℤ,
        n.prod (fun v k => (v.asIdeal : FractionalIdeal (nonZeroDivisors A) K) ^ k) = I := by
  refine ⟨fun I hI => mul_inv_cancel₀ hI, fun I hI => ?_⟩
  have hfin : (Function.support fun v : HeightOneSpectrum A => FractionalIdeal.count K v I).Finite :=
    Filter.eventually_cofinite.1 (FractionalIdeal.finite_factors I)
  refine ⟨Finsupp.ofSupportFinite (fun v => FractionalIdeal.count K v I) hfin, ?_, ?_⟩
  · simp only
    conv_rhs => rw [← FractionalIdeal.finprod_heightOneSpectrum_factorization' K hI]
    rw [Finsupp.prod, finprod_eq_prod_of_mulSupport_subset _ (s :=
      (Finsupp.ofSupportFinite (fun v => FractionalIdeal.count K v I) hfin).support)]
    · rfl
    · intro v hv
      by_contra h
      apply hv
      have : FractionalIdeal.count K v I = 0 := by
        simpa [Finsupp.mem_support_iff] using h
      simp [this]
  · intro n hn
    ext v
    rw [← FractionalIdeal.count_finsuppProd K v n, hn]
    simp [Finsupp.ofSupportFinite_coe]

-- Milne, Remark 3.21 (a): Noether's converse, an integral domain whose (nonzero) fractional ideals have
-- inverses is a Dedekind domain. Mathlib packages both directions as one equivalence, so this also
-- covers the group property of Theorem 3.20; parts (b) (localization of fractional ideals) and the
-- direct construction of inverses in (c) are not in Mathlib.
attribute [kb "milne2020ant" "v3.08, Remark 3.21 (a), p. 53"] isDedekindDomain_iff_mul_inv_cancel

/-- Milne, Remark 3.25: for a noetherian integral domain $A$ the following are equivalent. (1) $A$ is a
Dedekind domain. (2) The localization of $A$ at every nonzero prime ideal is a discrete valuation ring.
(3) The nonzero fractional ideals of $A$ form a group, here: every nonzero fractional ideal is a unit.
(4) For every nonzero fractional ideal there is a fractional ideal whose product with it is $A$.

This combines `isDedekindDomain_iff_isDiscreteValuationRing_atPrime` and
`isDedekindDomain_iff_mul_inv_cancel` (items 1, 3 and 4), which Mathlib does not package as a single list.
As in `prop_3_6`, "every prime ideal" in the book is read as "every nonzero prime ideal", and ideals in
(3) and (4) are nonzero. -/
@[kb "milne2020ant" "v3.08, Remark 3.25, p. 55"]
theorem remark_3_25 (A K : Type*) [CommRing A] [IsDomain A] [IsNoetherianRing A] [Field K]
    [Algebra A K] [IsFractionRing A K] :
    List.TFAE
      [IsDedekindDomain A,
       ∀ P : Ideal A, P ≠ ⊥ → ∀ _ : P.IsPrime, IsDiscreteValuationRing (Localization.AtPrime P),
       ∀ I : FractionalIdeal (nonZeroDivisors A) K, I ≠ ⊥ → IsUnit I,
       ∀ I : FractionalIdeal (nonZeroDivisors A) K, I ≠ ⊥ →
         ∃ J : FractionalIdeal (nonZeroDivisors A) K, I * J = 1] := by
  tfae_have 1 ↔ 2 := prop_3_6 A
  tfae_have 1 → 4 := fun h I hI => ⟨I⁻¹, (isDedekindDomain_iff_mul_inv_cancel (K := K)).1 h I hI⟩
  tfae_have 4 → 1 := fun h => (isDedekindDomain_iff_mul_inv_cancel (K := K)).2 fun I hI => by
    obtain ⟨J, hJ⟩ := h I hI
    exact (FractionalIdeal.mul_inv_cancel_iff K).2 ⟨J, hJ⟩
  tfae_have 3 ↔ 4 := forall_congr' fun I => imp_congr_right fun _ => isUnit_iff_exists_inv
  tfae_finish

-- Milne, Proposition 3.27 (a discrete valuation gives a principal ideal domain {v ≥ 0}).
-- Mathlib states it for a valuation (multiplicative, with values in a linearly ordered commutative group
-- with zero) whose value group is cyclic and nontrivial, which is the packaging of a discrete valuation
-- with values in a subgroup of the integers; the maximal ideal part of the book's statement is not covered.
attribute [kb "milne2020ant"
  "v3.08, Prop. 3.27, p. 56 (principal ideal domain part; cyclic value group form)"]
  Valuation.valuationSubring_isPrincipalIdealRing

-- Milne, Proposition 3.27, the same ring is a discrete valuation ring (same packaging as above).
attribute [kb "milne2020ant"
  "v3.08, Prop. 3.27, p. 56 (discrete valuation ring part; cyclic value group form)"]
  Valuation.valuationSubring_isDiscreteValuationRing

-- Milne, Proposition 3.28 (approximation theorem for a Dedekind domain). Mathlib states the Chinese
-- remainder form: for primes `P i` and exponents `e i` there is `y` with `y - x i ∈ P i ^ e i`. Taking
-- `e i = n + 1` gives the book's `ord_{p_i}(x - x_i) > n`; the exponent of a prime is not expressed.
attribute [kb "milne2020ant" "v3.08, Prop. 3.28, p. 56 (ideal membership form)"]
  IsDedekindDomain.exists_forall_sub_mem_ideal

-- Milne, Theorem 3.29 (the integral closure of a Dedekind domain in a finite separable extension of its
-- fraction field is a Dedekind domain). Same statement, in two forms: for the integral closure as a
-- subalgebra, and for any ring that is an integral closure.
attribute [kb "milne2020ant" "v3.08, Thm. 3.29, p. 57"] integralClosure.isDedekindDomain
attribute [kb "milne2020ant" "v3.08, Thm. 3.29, p. 57"] IsIntegralClosure.isDedekindDomain

/-- Milne, Lemma 3.30: an integral domain $B$ containing a field $k$ and algebraic over $k$ is a field.

This restates `isField_of_isIntegral_of_isField'` (an integral domain integral over a field is a field),
using that algebraic over a field means integral. -/
@[kb "milne2020ant" "v3.08, Lemma 3.30, p. 57"]
theorem lemma_3_30 (k B : Type*) [Field k] [CommRing B] [IsDomain B] [Algebra k B]
    [Algebra.IsAlgebraic k B] : IsField B := by
  have : Algebra.IsIntegral k B := inferInstance
  exact isField_of_isIntegral_of_isField' (Field.toIsField k)

-- Milne, Lemma 3.33 (a prime ideal P of B divides pB if and only if p = P ∩ A).
-- Same statement for a Dedekind ring B over a ring A and a maximal ideal p of A, for P different from the
-- unit ideal; "lies over p" means that the comap of P is p.
attribute [kb "milne2020ant" "v3.08, Lemma 3.33, p. 59"] Ideal.liesOver_iff_dvd_map

-- Milne, Theorem 3.34, the first formula (the sum of e_i f_i is the degree [L : K]).
-- Mathlib states it for a finite flat extension of a domain B over A, with the sum over the primes of B
-- lying over p and the right side the rank of B over A; for the integral closure of a Dedekind domain in a
-- finite separable extension, that rank is the degree [L : K] (not restated here).
attribute [kb "milne2020ant" "v3.08, Thm. 3.34, p. 59 (formula (10); rank form)"]
  Ideal.sum_ramification_inertia_eq_finrank

-- Milne, Theorem 3.34, the Galois part. Mathlib states it for a finite group G acting on B with
-- `IsGaloisGroup G A B`: the group acts transitively on the primes over p ...
attribute [kb "milne2020ant" "v3.08, Thm. 3.34, p. 59 (Galois case: transitivity; group form)"]
  Ideal.exists_smul_eq_of_isGaloisGroup
-- ... all ramification indices over p are equal ...
attribute [kb "milne2020ant"
  "v3.08, Thm. 3.34, p. 59 (Galois case: equal ramification indices; group form)"]
  Ideal.ramificationIdx_eq_of_isGaloisGroup
-- ... all residue class degrees over p are equal ...
attribute [kb "milne2020ant"
  "v3.08, Thm. 3.34, p. 59 (Galois case: equal residue class degrees; group form)"]
  Ideal.inertiaDeg_eq_of_isGaloisGroup
-- ... and the number of primes times the ramification index times the residue class degree is the order
-- of the group (formula (11), with the order of the group in place of [L : K]).
attribute [kb "milne2020ant" "v3.08, Thm. 3.34, p. 59 (formula (11); group form)"]
  Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn

-- Milne, Theorem 3.35 (a prime ramifies if and only if it divides the discriminant).
-- Special case only: the base is the integers (so the number field is over the rational numbers) and the
-- ring is the ring of integers; a prime number is unramified in the number field if and only if it does not
-- divide the field discriminant. The finiteness statement and relative discriminants over a general
-- Dedekind domain are not covered.
attribute [kb "milne2020ant" "v3.08, Thm. 3.35, p. 60 (special case: base the integers)"]
  NumberField.not_dvd_discr_iff_isUnramifiedIn

-- Milne, Theorem 3.41 (factorization of pB when B = A[α]): the factors of pB are the prime ideals
-- (p, g_i(α)) from the factorization of the minimal polynomial modulo p, with exponents e_i.
-- Mathlib states the factorization of the ideal as the image under the Dedekind-Kummer correspondence of
-- the normalized factors of the reduction of the minimal polynomial, under the weaker assumption that the
-- conductor of α is coprime to p (which covers B = A[α]). The explicit shape (p, g_i(α)) and the
-- residue degree f_i = deg g_i are not stated in these lemmas.
attribute [kb "milne2020ant" "v3.08, Thm. 3.41, p. 62 (Dedekind-Kummer form; factors)"]
  KummerDedekind.normalizedFactors_ideal_map_eq_normalizedFactors_min_poly_mk_map
-- ... and the exponent of each prime factor is its multiplicity in the reduced minimal polynomial.
attribute [kb "milne2020ant" "v3.08, Thm. 3.41, p. 62 (Dedekind-Kummer form; exponents)"]
  KummerDedekind.emultiplicity_factors_map_eq_emultiplicity
-- ... for a number field and a prime number p not dividing the index of Z[θ], the primes over p are in
-- bijection with the monic irreducible factors of the minimal polynomial modulo p.
attribute [kb "milne2020ant"
  "v3.08, Thm. 3.41, p. 62 (special case: base the integers; bijection of primes with factors)"]
  NumberField.Ideal.primesOverSpanEquivMonicFactorsMod

end NumberFieldKB.MilneANT
