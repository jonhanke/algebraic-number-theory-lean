import NumberFieldKB.WeilBNT.IdeleCharacterExtension
import NumberFieldKB.WeilBNT.IntegersDense
import Mathlib.RingTheory.Henselian
import Mathlib.Algebra.Ring.IsFormallyReal
import Mathlib.NumberTheory.NumberField.AdeleRing
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import Mathlib.Algebra.Order.Star.Real

/-!
# Weil, *Basic Number Theory*, VII.§8, Proposition 18: the group $\gamma$ of Prop. 17 is generated by integers

Notation as in `NumberFieldKB.WeilBNT.IdeleCharacterExtension`: $k$ a number field (`K`), $P=P_\infty\cup S$, open
subgroups $g_v$ of $k_v^\times$ for $v\in P$, contained in $r_v^\times$ for $v$ finite, and
$\gamma=\bigcap_{v\in P}(k^\times\cap g_v)$ (`yGroup S gInf gFin`), the group on which the condition of Prop. 17 is
tested.

* **Prop. 18** (p. 137): $\gamma$ is generated by $\gamma\cap\mathfrak r$, $\mathfrak r$ the maximal order of $k$
  (`weil_VII_8_prop18`).

*Proof* (Weil's): for $\xi\in\gamma$, choose $\alpha\in\mathfrak r$, $\alpha\ne0$, with $\alpha\in g_v$ for every finite
$v\in P$ and $\xi\alpha\in\mathfrak r$ (V.§2, Cor. 1 of Thm. 1: $\mathfrak r$ is dense in $\prod_v r_v$ over finitely
many places, applied to the places of $S$ and the places where $\xi$ is not integral). Then $\alpha^2$ lies in $g_v$ for
every infinite $v$ as well (an open subgroup of $\mathbb R^\times$ contains $\mathbb R^\times_+$, one of
$\mathbb C^\times$ is everything), so $\alpha^2$ and $\xi\alpha^2$ lie in $\gamma\cap\mathfrak r$, and
$\xi=(\xi\alpha^2)(\alpha^2)^{-1}$.
-/

open IsDedekindDomain NumberField Filter Topology NumberFieldKB.MilneCFT

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {K : Type} [Field K] [NumberField K]

variable (S : Finset (HeightOneSpectrum (𝓞 K))) (gInf : ∀ w : InfinitePlace K, Subgroup (w.Completion)ˣ)
  (gFin : ∀ v : S, Subgroup ((v.1).adicCompletion K)ˣ)

/-- Weil's $\gamma=\bigcap_{v\in P}(k^\times\cap g_v)$, as a subgroup of $k^\times$. -/
def yGroup : Subgroup Kˣ := (gProd S gInf gFin).comap ((pproj S).comp (IdeleGroup.unitEmbedding (𝓞 K) K))

variable {S gInf gFin}

/-- An open subgroup of the units of an archimedean completion contains every square. -/
theorem sq_mem_of_isOpen {w : InfinitePlace K} (H : Subgroup (w.Completion)ˣ) (hH : IsOpen (H : Set (w.Completion)ˣ))
    (u : (w.Completion)ˣ) : u ^ 2 ∈ H := by
  have : DiscreteTopology ((w.Completion)ˣ ⧸ H) := QuotientGroup.discreteTopology hH
  have hτ : Continuous (QuotientGroup.mk' H) := continuous_quotient_mk'
  refine (QuotientGroup.eq_one_iff _).1 ?_
  change QuotientGroup.mk' H (u ^ 2) = 1
  rcases InfinitePlace.isReal_or_isComplex w with hw | hw
  · refine real_pos_ker w hw (QuotientGroup.mk' H) hτ (u ^ 2) ?_
    have hne : InfinitePlace.Completion.extensionEmbeddingOfIsReal hw (u : w.Completion) ≠ 0 :=
      (map_ne_zero _).2 u.ne_zero
    rw [Units.val_pow_eq_pow_val, map_pow]
    exact lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hne))
  · exact complex_ker w hw (QuotientGroup.mk' H) hτ (u ^ 2)

/-- The key step of Weil's proof: for $\xi\in\gamma$ there is $\alpha\in\mathfrak r$, $\alpha\neq0$, with $\alpha\in g_v$
for every $v\in S$ and $\xi\alpha\in\mathfrak r$. -/
theorem exists_alpha (hFin : ∀ v, IsOpen (gFin v : Set ((v.1).adicCompletion K)ˣ))
    (hFinU : ∀ v, ∀ u ∈ gFin v, Valued.v (u : (v.1).adicCompletion K) = 1) {ξ : Kˣ}
    (hξ : ξ ∈ yGroup S gInf gFin) :
    ∃ α : Kˣ, (∃ a : 𝓞 K, (a : K) = α) ∧ (∃ a : 𝓞 K, (a : K) = ξ * α) ∧
      ∀ v : S, (pproj S (IdeleGroup.unitEmbedding (𝓞 K) K α)).2 v ∈ gFin v := by
  classical
  have hξ' : pproj S (IdeleGroup.unitEmbedding (𝓞 K) K ξ) ∈ gProd S gInf gFin := hξ
  set T' : Set (HeightOneSpectrum (𝓞 K)) := HeightOneSpectrum.Support (𝓞 K) (ξ : K) with hT'
  have hT'fin : T'.Finite := HeightOneSpectrum.Support.finite (𝓞 K) (ξ : K)
  have hξS : ∀ v : S, v.1.valuation K (ξ : K) = 1 := by
    intro v
    have h := hFinU v _ (hξ'.2 v)
    rw [← HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
    exact h
  have hSnot : ∀ v ∈ S, v ∉ T' := fun v hv hv' => by
    have h1 : 1 < v.valuation K (ξ : K) := hv'
    rw [hξS ⟨v, hv⟩] at h1
    exact lt_irrefl _ h1
  have hint : ∀ b : K, (∀ v : HeightOneSpectrum (𝓞 K), v.valuation K b ≤ 1) → ∃ a : 𝓞 K, (a : K) = b :=
    fun b hb => by
      obtain ⟨r, hr⟩ := HeightOneSpectrum.mem_integers_of_valuation_le_one (R := 𝓞 K) K b hb
      exact ⟨r, hr⟩
  have hξle : ∀ v : HeightOneSpectrum (𝓞 K), v ∉ T' → v.valuation K (ξ : K) ≤ 1 := fun v hv => not_lt.1 hv
  by_cases hT : T' = ∅
  · refine ⟨1, ⟨1, by simp⟩, ?_, fun v => by simp⟩
    refine hint _ fun v => ?_
    rw [Units.val_one, mul_one]
    exact hξle v (by simp [hT])
  obtain ⟨v0, hv0⟩ := Set.nonempty_iff_ne_empty.2 hT
  -- the finite set of places where we approximate
  set T : Set (HeightOneSpectrum (𝓞 K)) := (S : Set (HeightOneSpectrum (𝓞 K))) ∪ T' with hTdef
  have : Finite T := (S.finite_toSet.union hT'fin).to_subtype
  -- the target point and the neighbourhoods
  let t : ∀ v : HeightOneSpectrum (𝓞 K), v.adicCompletion K := fun v =>
    if v ∈ S then 1 else algebraMap K (v.adicCompletion K) (ξ : K)⁻¹
  let N : ∀ v : HeightOneSpectrum (𝓞 K), Set (v.adicCompletion K) := fun v =>
    if h : v ∈ S then Units.val '' (gFin ⟨v, h⟩ : Set _)
    else {y | Valued.v.restrict y = Valued.v.restrict (algebraMap K (v.adicCompletion K) (ξ : K)⁻¹)}
  have hval : ∀ (v : HeightOneSpectrum (𝓞 K)) (x : K),
      Valued.v (algebraMap K (v.adicCompletion K) x) = v.valuation K x := fun v x =>
    HeightOneSpectrum.valuedAdicCompletion_eq_valuation' v x
  have hvne : ∀ v : HeightOneSpectrum (𝓞 K), Valued.v (algebraMap K (v.adicCompletion K) (ξ : K)⁻¹) ≠ 0 :=
    fun v => by
      rw [hval]
      exact (Valuation.ne_zero_iff _).2 (inv_ne_zero ξ.ne_zero)
  have hz : ∀ v : T, t v.1 ∈ v.1.adicCompletionIntegers K := by
    intro v
    by_cases h : v.1 ∈ S
    · simp only [t, if_pos h]
      exact one_mem _
    · have hv' : v.1 ∈ T' := v.2.resolve_left h
      simp only [t, if_neg h]
      rw [HeightOneSpectrum.mem_adicCompletionIntegers, hval, map_inv₀]
      have h1 : 1 < v.1.valuation K (ξ : K) := hv'
      exact inv_le_one_of_one_le₀ h1.le
  have hN : ∀ v : HeightOneSpectrum (𝓞 K), N v ∈ 𝓝 (t v) := by
    intro v
    by_cases h : v ∈ S
    · simp only [N, t, dif_pos h, if_pos h]
      exact IsOpen.mem_nhds (Units.isOpenEmbedding_val.isOpenMap _ (hFin ⟨v, h⟩))
        ⟨1, (gFin ⟨v, h⟩).one_mem, rfl⟩
    · simp only [N, t, dif_neg h, if_neg h]
      refine IsOpen.mem_nhds (Valued.isOpen_sphere (v.adicCompletion K) ?_) rfl
      intro h0
      apply hvne v
      have := congrArg MonoidWithZeroHom.ValueGroup₀.embedding h0
      rwa [Valuation.embedding_restrict, map_zero] at this
  let z : ∀ v : T, v.1.adicCompletionIntegers K := fun v => ⟨t v.1, hz v⟩
  have hU : ∀ᶠ y in 𝓝 z, ∀ v : T, ((y v : v.1.adicCompletionIntegers K) : v.1.adicCompletion K) ∈ N v.1 := by
    rw [Filter.eventually_all]
    intro v
    exact ((continuous_subtype_val.comp (continuous_apply v)).continuousAt (x := z)).preimage_mem_nhds (hN v.1)
  obtain ⟨_, hyU, a, rfl⟩ := mem_closure_iff_nhds.1 (weil_V_2_cor1_partial (K := K) T z) _ hU
  have hay : ∀ v ∈ T, ((a : K) : v.adicCompletion K) ∈ N v := fun v hv => hyU ⟨v, hv⟩
  have hpos : ∀ v ∈ T', v.valuation K (a : K) = v.valuation K (ξ : K)⁻¹ := by
    intro v hv
    have hvS : v ∉ S := fun h => hSnot v h hv
    have h := hay v (Or.inr hv)
    simp only [N, dif_neg hvS, Set.mem_setOf_eq] at h
    have := congrArg MonoidWithZeroHom.ValueGroup₀.embedding h
    rw [Valuation.embedding_restrict, Valuation.embedding_restrict] at this
    exact (hval v (a : K)).symm.trans (this.trans (hval v _))
  have ha0 : (a : K) ≠ 0 := by
    intro h0
    have := hpos v0 hv0
    rw [h0, map_zero] at this
    exact ((Valuation.ne_zero_iff _).2 (inv_ne_zero ξ.ne_zero)) this.symm
  refine ⟨Units.mk0 (a : K) ha0, ⟨a, rfl⟩, ?_, fun v => ?_⟩
  · refine hint _ fun v => ?_
    rw [Units.val_mk0, map_mul]
    by_cases hv : v ∈ T'
    · rw [hpos v hv, ← map_mul, mul_inv_cancel₀ ξ.ne_zero, map_one]
    · exact mul_le_one' (hξle v hv) (v.valuation_le_one a)
  · have h := hay v.1 (Or.inl v.2)
    simp only [N, dif_pos v.2] at h
    obtain ⟨u, hu, hue⟩ := h
    have : (pproj S (IdeleGroup.unitEmbedding (𝓞 K) K (Units.mk0 (a : K) ha0))).2 v = u :=
      Units.ext (by rw [hue]; rfl)
    rw [this]
    exact hu

/-- **Weil, VII.§8, Proposition 18** (p. 137), number field case: $\gamma=\bigcap_{v\in P}(k^\times\cap g_v)$ is generated
by $\gamma\cap\mathfrak r$. -/
@[kb "weil1973bnt" "Ch. VII, §8, Prop. 18 (p. 137)"]
theorem weil_VII_8_prop18 (hInf : ∀ w, IsOpen (gInf w : Set (w.Completion)ˣ))
    (hFin : ∀ v, IsOpen (gFin v : Set ((v.1).adicCompletion K)ˣ))
    (hFinU : ∀ v, ∀ u ∈ gFin v, Valued.v (u : (v.1).adicCompletion K) = 1) :
    Subgroup.closure {ξ : Kˣ | ξ ∈ yGroup S gInf gFin ∧ ∃ a : 𝓞 K, (a : K) = ξ} = yGroup S gInf gFin := by
  refine le_antisymm ((Subgroup.closure_le _).2 fun ξ hξ => hξ.1) fun ξ hξ => ?_
  obtain ⟨α, ⟨a, ha⟩, ⟨b, hb⟩, hαS⟩ := exists_alpha hFin hFinU hξ
  have hα2 : α ^ 2 ∈ yGroup S gInf gFin := by
    show pproj S (IdeleGroup.unitEmbedding (𝓞 K) K (α ^ 2)) ∈ gProd S gInf gFin
    refine ⟨fun w => ?_, fun v => ?_⟩
    · rw [map_pow]
      exact sq_mem_of_isOpen (gInf w) (hInf w) ((pproj S (IdeleGroup.unitEmbedding (𝓞 K) K α)).1 w)
    · rw [map_pow]
      exact pow_mem (hαS v) 2
  have hα2int : ∃ c : 𝓞 K, (c : K) = ((α ^ 2 : Kˣ) : K) :=
    ⟨a * a, by
      change (a : K) * (a : K) = _
      rw [Units.val_pow_eq_pow_val, ← ha]; ring⟩
  have hξα2 : ∃ c : 𝓞 K, (c : K) = ((ξ * α ^ 2 : Kˣ) : K) :=
    ⟨b * a, by
      change (b : K) * (a : K) = _
      rw [Units.val_mul, Units.val_pow_eq_pow_val, hb, ← ha]; ring⟩
  have : ξ = (ξ * α ^ 2) * (α ^ 2)⁻¹ := by group
  rw [this]
  exact mul_mem (Subgroup.subset_closure ⟨mul_mem hξ hα2, hξα2⟩)
    (inv_mem (Subgroup.subset_closure ⟨hα2, hα2int⟩))

end NumberFieldKB.WeilBNT
