import NumberFieldKB.MilneCFT.Ch8.ExplicitPairing
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal

/-!
# Milne, *Class Field Theory*, VIII, Proposition 5.12: what the Steinberg relation gives

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII, §5,
Proposition 5.12 (pdf p. 257, printed p. 248). Setting: $p$ odd prime, $K = \mathbb Q[\zeta]_\lambda$ the completion of
$\mathbb Q[\zeta]$ at $\lambda = 1 - \zeta$, $\eta_i = 1 - \lambda^i$. Prop. 5.12 says that the Hilbert pairing
$K^\times \times K^\times \to \mu_p$ is the unique skew-symmetric pairing with (a)
$(\eta_i, \eta_j) = (\eta_i, \eta_{i+j})(\eta_{i+j}, \eta_j)(\eta_{i+j}, \lambda)^{-j}$, (b) $(\eta_i,\lambda) = 1$
for $1 \le i \le p-1$ and $(\eta_p, \lambda) = \zeta$, (c) $(\cdot,\cdot) = 1$ on $U_i \times U_j$, $i + j \ge p+1$.
The uniqueness half is `prop_5_12_unique` (ExplicitPairing.lean).

## What is formalized here (unconditional, for every field)

The Hilbert symbol of order $p$ is bimultiplicative, has values killed by $p$, and satisfies the **Steinberg
relation** $(a, b) = 1$ whenever $a + b = 1$ (because $1 - a = \prod_{k}(1 - \zeta^k\alpha)$, $\alpha^p = a$, is a
norm from $K[a^{1/p}]$; Milne, *CFT*, VIII, §5, Proposition 5.5-type properties of the Hilbert symbol
[unverified locator]; Serre, *Local Fields*, XIV, §2, Prop. 6). Call such a pairing a *Steinberg pairing* (`IsSteinbergPairing`). We prove, for **every** Steinberg
pairing on any field $K$, any $\lambda \in K^\times$ and $\eta_i = 1 - \lambda^i$ (units), with $p$ odd:

* `IsSteinbergPairing.skew`: $(x,y)(y,x) = 1$; `IsSteinbergPairing.self_eq_one`: $(x,x) = 1$;
* `IsSteinbergPairing.cond_a`: (a) with exponent $i$, and `cond_a_neg`: (a) with exponent $-j$ (the two agree since
  $(\eta_k,\lambda)^k = 1$, `eta_lam_pow_self`);
* `IsSteinbergPairing.cond_b_lt`: (b) for $1 \le i \le p - 1$ ($p$ prime);
* `IsSteinbergPairing.cond_c_eta`: (c) on the generators, $(\eta_i, \eta_j) = 1$ for $i + j \ge p + 1$, provided the
  $\eta_k$ with $k \ge p+1$ are $p$-th powers (true in $K$: $U_{p+1} \subseteq K^{\times p}$, Milne VII A.6a);
* `isExplicitPairing_of_steinberg`: hence every such pairing satisfies `IsExplicitPairing` with
  $z = (\eta_p, \lambda)$; and **`steinberg_pairings_eq`**: two Steinberg pairings with the same value
  $(\eta_p, \lambda)$ agree on the subgroup generated by $\lambda$ and the $\eta_i$.

So of Milne's conditions only the normalization $(\eta_p, \lambda) = \zeta$ (the Artin–Hasse computation) and the
full form of (c) on $U_i \times U_j$ (which needs the generation of $U_i$ modulo $U_{p+1}$ by $\eta_i, \dots, \eta_p$)
are not consequences of the Steinberg relation; and the existence of the Hilbert symbol itself needs local class field
theory.

*Erratum note (text copy).* Our text copy prints the exponent in (a) as $j$; the identity that holds for the Hilbert
symbol has exponent $-j$ (equivalently $i$, `cond_a`, `cond_a_neg`). The exponent $+j$ is wrong whenever
$i + j = p$ and $i \ne j$ (then $(\eta_p,\lambda)^{j} \ne (\eta_p,\lambda)^{-j}$). The extraction of our copy drops
minus signs elsewhere in the same paragraph (e.g. in $\eta_i = 1 - \lambda^i$), so this is most likely the minus sign
of $-j$ lost in extraction, not an erratum of the book; recorded in `docs/results/books/milne-cft.md`.
-/

namespace NumberFieldKB.MilneCFT.Ch8

variable {K M : Type*} [Field K] [CommGroup M]

/-- A **Steinberg pairing** of exponent $p$ on $K^\times$: bimultiplicative (`P : Kˣ →* Kˣ →* M`), with values killed by
$p$, and $(a, b) = 1$ whenever $a + b = 1$ (the Steinberg relation $(a, 1 - a) = 1$). The Hilbert symbol of order $p$
of a local field containing $\mu_p$ is one. -/
structure IsSteinbergPairing (P : Kˣ →* Kˣ →* M) (p : ℕ) : Prop where
  pow_eq_one : ∀ x y, P x y ^ p = 1
  steinberg : ∀ a b : Kˣ, (a : K) + b = 1 → P a b = 1

namespace IsSteinbergPairing

variable {P : Kˣ →* Kˣ →* M} {p : ℕ} (hP : IsSteinbergPairing P p)
include hP

theorem neg_self (a : Kˣ) : P a (-a) = 1 := by
  by_cases ha : (a : K) = 1
  · have : a = 1 := Units.ext ha
    subst this
    simp
  · have hu : (1 : K) - a ≠ 0 := sub_ne_zero.mpr (Ne.symm ha)
    have hu' : (1 : K) - a⁻¹ ≠ 0 := by
      rw [sub_ne_zero]
      intro h
      apply ha
      have : (a⁻¹ : Kˣ) = 1 := Units.ext (h.symm.trans Units.val_one.symm)
      rw [inv_eq_one] at this
      rw [this, Units.val_one]
    set u := Units.mk0 _ hu
    set u' := Units.mk0 _ hu'
    have h1 : P a u = 1 := hP.steinberg a u (by simp [u])
    have h2 : P a⁻¹ u' = 1 := hP.steinberg a⁻¹ u' (by simp [u'])
    have hneg : -a = u * u'⁻¹ := by
      apply Units.ext
      simp only [Units.val_neg, Units.val_mul, Units.val_inv_eq_inv_val, Units.val_mk0, u, u']
      have ha0 : (a : K) ≠ 0 := a.ne_zero
      field_simp
      ring
    have h3 : P a u' = 1 := by
      rw [map_inv, MonoidHom.inv_apply, inv_eq_one] at h2
      exact h2
    rw [hneg, map_mul, map_inv, h1, h3]
    simp

/-- **Skew-symmetry**: $(x, y)(y, x) = 1$. -/
theorem skew (x y : Kˣ) : P x y * P y x = 1 := by
  have h := hP.neg_self (x * y)
  have e : -(x * y) = (-x) * y := by rw [neg_mul]
  rw [map_mul, MonoidHom.mul_apply] at h
  rw [e, map_mul, hP.neg_self x, one_mul] at h
  rw [show (-x) * y = x * (-y) by rw [neg_mul, mul_neg], map_mul, hP.neg_self y, mul_one] at h
  exact h

theorem neg_one (hp : Odd p) (x : Kˣ) : P x (-1) = 1 := by
  have := hP.pow_eq_one x (-1)
  rw [← map_pow, hp.neg_one_pow] at this
  exact this

/-- $(x, x) = 1$ ($p$ odd). -/
theorem self_eq_one (hp : Odd p) (x : Kˣ) : P x x = 1 := by
  have h := hP.neg_self x
  rw [show -x = (-1) * x by rw [neg_one_mul], map_mul, hP.neg_one hp, one_mul] at h
  exact h

/-- $(y, x) = 1$ and $(x, y) = 1$ when $y$ is a $p$-th power. -/
theorem eq_one_of_pow {y : Kˣ} (hy : ∃ β : Kˣ, β ^ p = y) (x : Kˣ) : P y x = 1 ∧ P x y = 1 := by
  obtain ⟨β, rfl⟩ := hy
  refine ⟨?_, ?_⟩
  · rw [map_pow, MonoidHom.pow_apply, hP.pow_eq_one]
  · rw [map_pow, hP.pow_eq_one]

variable {lam : Kˣ} {eta : ℕ → Kˣ} (heta : ∀ i, 1 ≤ i → (eta i : K) = 1 - (lam : K) ^ i)
include heta

/-- $(\eta_k, \lambda)^k = 1$ (Steinberg for $\lambda^k + \eta_k = 1$). -/
theorem eta_lam_pow_self (k : ℕ) (hk : 1 ≤ k) : P (eta k) lam ^ k = 1 := by
  have h := hP.steinberg (lam ^ k) (eta k) (by rw [heta k hk, Units.val_pow_eq_pow_val]; ring)
  rw [map_pow, MonoidHom.pow_apply] at h
  rw [eq_inv_of_mul_eq_one_left (hP.skew (eta k) lam), inv_pow, h, inv_one]

/-- **Condition (a), exponent $i$**: $(\eta_i,\eta_j) = (\eta_i,\eta_{i+j})(\eta_{i+j},\eta_j)(\eta_{i+j},\lambda)^i$
for $i, j \ge 1$ ($p$ odd). -/
theorem cond_a (hp : Odd p) (i j : ℕ) (hi : 1 ≤ i) (hj : 1 ≤ j) :
    P (eta i) (eta j) = P (eta i) (eta (i + j)) * P (eta (i + j)) (eta j) * P (eta (i + j)) lam ^ i := by
  -- Steinberg for `η_i/η_{i+j} + λ^i η_j/η_{i+j} = 1`
  have h := hP.steinberg (eta i * (eta (i + j))⁻¹) (lam ^ i * eta j * (eta (i + j))⁻¹) (by
    have h0 : (eta (i + j) : K) ≠ 0 := (eta (i + j)).ne_zero
    simp only [Units.val_mul, Units.val_inv_eq_inv_val, Units.val_pow_eq_pow_val]
    rw [heta i hi, heta j hj] at *
    rw [heta (i + j) (by omega)] at h0 ⊢
    field_simp
    ring)
  simp only [map_mul, map_inv, map_pow, MonoidHom.mul_apply, MonoidHom.inv_apply] at h
  have hii := hP.eta_lam_pow_self heta i hi
  have hs := hP.self_eq_one hp (eta (i + j))
  rw [mul_pow, hii, one_mul, hs, inv_one, mul_one, inv_pow] at h
  rw [mul_inv_eq_one, inv_mul_eq_iff_eq_mul, mul_inv_eq_iff_eq_mul] at h
  rw [h]
  ac_rfl

/-- **Condition (a), exponent $-j$** (Milne's form): $(\eta_i,\eta_j) =
(\eta_i,\eta_{i+j})(\eta_{i+j},\eta_j)(\eta_{i+j},\lambda)^{-j}$ for $i, j \ge 1$ ($p$ odd). -/
theorem cond_a_neg (hp : Odd p) (i j : ℕ) (hi : 1 ≤ i) (hj : 1 ≤ j) :
    P (eta i) (eta j) = P (eta i) (eta (i + j)) * P (eta (i + j)) (eta j) * (P (eta (i + j)) lam ^ j)⁻¹ := by
  rw [hP.cond_a heta hp i j hi hj]
  congr 1
  have h := hP.eta_lam_pow_self heta (i + j) (by omega)
  rw [pow_add] at h
  exact eq_inv_of_mul_eq_one_left h

/-- **Condition (b), first half**: $(\eta_i, \lambda) = 1$ for $1 \le i \le p - 1$ ($p$ prime). -/
theorem cond_b_lt (hp : p.Prime) (i : ℕ) (hi : 1 ≤ i) (hip : i ≤ p - 1) : P (eta i) lam = 1 := by
  have h1 := hP.eta_lam_pow_self heta i hi
  have h2 := hP.pow_eq_one (eta i) lam
  have hcop : Nat.gcd i p = 1 :=
    Nat.Coprime.symm ((Nat.Prime.coprime_iff_not_dvd hp).mpr (Nat.not_dvd_of_pos_of_lt hi (by omega)))
  have := (pow_gcd_eq_one (a := P (eta i) lam) (m := i) (n := p)).mpr ⟨h1, h2⟩
  rwa [hcop, pow_one] at this

/-- **Condition (c) on the generators**: $(\eta_i, \eta_j) = 1$ for $i, j \ge 1$, $i + j \ge p + 1$, if the $\eta_k$
with $k \ge p + 1$ are $p$-th powers ($p$ odd). -/
theorem cond_c_eta (hp : Odd p) (hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = eta k) (i j : ℕ) (hi : 1 ≤ i)
    (hj : 1 ≤ j) (hij : p + 1 ≤ i + j) : P (eta i) (eta j) = 1 := by
  rw [hP.cond_a heta hp i j hi hj, (hP.eq_one_of_pow (hpow _ hij) _).2, (hP.eq_one_of_pow (hpow _ hij) _).1,
    (hP.eq_one_of_pow (hpow _ hij) _).1]
  simp

/-- **Every Steinberg pairing satisfies the hypotheses of Prop. 5.12** (`IsExplicitPairing`, with exponent $i$ in
(a) and $z = (\eta_p, \lambda)$), for $p$ an odd prime and $\eta_k$ ($k \ge p+1$) $p$-th powers. -/
theorem isExplicitPairing (hp : p.Prime) (hp2 : p ≠ 2) (hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = eta k) :
    IsExplicitPairing P p lam eta (P (eta p) lam) (fun i _ => i) := by
  have hodd : Odd p := hp.odd_of_ne_two hp2
  exact
    { skew := hP.skew
      lam_lam := hP.self_eq_one hodd lam
      a := fun i j hi hj => hP.cond_a heta hodd i j hi hj
      b_lt := fun i hi hip => hP.cond_b_lt heta hp i hi hip
      b_eq := rfl
      c_eta := fun i j hi hj hij => hP.cond_c_eta heta hodd hpow i j hi hj hij
      c_lam := fun i hi => (hP.eq_one_of_pow (hpow i hi) lam).1 }

end IsSteinbergPairing

/-- **Prop. 5.12, the Steinberg form of uniqueness** (Milne, *CFT*, VIII, Prop. 5.12, p. 248): on any field, for
$p$ an odd prime, $\lambda \in K^\times$ and $\eta_i = 1 - \lambda^i$ with $\eta_k \in K^{\times p}$ for
$k \ge p + 1$, two Steinberg pairings of exponent $p$ with the same value $(\eta_p, \lambda)$ agree on the subgroup
generated by $\lambda$ and the $\eta_i$. For the Hilbert symbol of $\mathbb Q[\zeta]_\lambda$ that subgroup is all of
$K^\times$ modulo $p$-th powers (Milne, p. 248), so the symbol is determined by the Steinberg relation and the single
value $(\eta_p, \lambda)$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Prop. 5.12, p. 248 (conditions (a)–(c) from the Steinberg relation)"]
theorem steinberg_pairings_eq {P P' : Kˣ →* Kˣ →* M} {p : ℕ} (hP : IsSteinbergPairing P p)
    (hP' : IsSteinbergPairing P' p) (hp : p.Prime) (hp2 : p ≠ 2) {lam : Kˣ} {eta : ℕ → Kˣ}
    (heta : ∀ i, 1 ≤ i → (eta i : K) = 1 - (lam : K) ^ i) (hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = eta k)
    (hval : P (eta p) lam = P' (eta p) lam) :
    ∀ x ∈ Subgroup.closure (insert lam (eta '' Set.Ici 1)),
      ∀ y ∈ Subgroup.closure (insert lam (eta '' Set.Ici 1)), P x y = P' x y := by
  have h1 := hP.isExplicitPairing heta hp hp2 hpow
  have h2 := hP'.isExplicitPairing heta hp hp2 hpow
  rw [← hval] at h2
  exact prop_5_12_unique h1 h2

end NumberFieldKB.MilneCFT.Ch8
