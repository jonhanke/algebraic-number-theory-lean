import NumberFieldKB.MilneCFT.Ch8.HilbertPairingArtin
import NumberFieldKB.MilneCFT.Ch8.CyclotomicLocalUnits
import NumberFieldKB.MilneCFT.Ch8.ExplicitPairingTrivial

/-!
# Milne, *Class Field Theory*, VIII, Proposition 5.12: the Hilbert pairing of $\mathbb Q_p[\zeta_p]$

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII, §5,
Proposition 5.12 (pdf p. 257, printed p. 248). "The Hilbert pairing $K_\lambda^\times \times K_\lambda^\times \to
\mu_p$ is the unique skew-symmetric pairing satisfying (a) $(\eta_i,\eta_j) = (\eta_i,\eta_{i+j})(\eta_{i+j},\eta_j)
(\eta_{i+j},\lambda)^{-j}$, (b) $(\eta_i,\lambda) = 1$ for $1 \le i \le p-1$, $(\eta_p,\lambda) = \zeta$, (c)
$(\cdot,\cdot) = 1$ on $U_i \times U_j$ for $i + j \ge p + 1$."

**Setting.** $K$ a nonarchimedean local field with the invariants of $\mathbb Q_p[\zeta_p]$: $\zeta \in K$ a primitive
$p$-th root of unity ($p$ an odd prime), $\lambda \in \mathcal O_K$ a uniformizer with $p = \varepsilon\lambda^{p-1}$
($\varepsilon$ a unit), residue field with $p$ elements; `φ` a local Artin map (`IsLocalArtinMap`; existence: the named
input `LocalCFT.LocalReciprocityExistence`, proved in Tau Ceti). The pairing is `hilbertPairing hζ hφ`
(Milne III, Remark 4.5). Milne's $\lambda$ is $1 - \zeta$; the statements hold for any uniformizer with these
properties, so they are stated for one.

**`prop_5_12`** (conditional only on the local Artin map `φ`): the Hilbert pairing
1. is skew-symmetric and satisfies (a) (exponent $i$, equal to the exponent $-j$, `IsSteinbergPairing.cond_a_neg`),
   (b) for $1 \le i \le p-1$ and (c) on the generators (`IsExplicitPairing` with $z = (\eta_p, \lambda)$);
2. satisfies (c) in full, on $U_i \times U_j$;
3. is the **unique** Steinberg pairing of exponent $p$ with its value at $(\eta_p, \lambda)$; and
   $(\eta_p, \lambda) = (\zeta', \eta_{p-1})$ with $\zeta' = 1 - \lambda$.

**Not formalized:** the value $(\eta_p, \lambda) = \zeta$ (the Artin–Hasse normalization). The integer congruence it
reduces to, $N_{\mathbb Q(\zeta)/\mathbb Q}(1 - \lambda^{p-1}) \equiv 1 - p \pmod{p^2}$, is proved
(`norm_one_sub_lam_pow_modEq`, CyclotomicNormCongr.lean). What is missing is the computation of $(\zeta, b)$ through
an explicit reciprocity law: the explicit Artin map of $\mathbb Q_p$ on $\mathbb Q_p(\zeta_{p^2})$, or the global
product formula at $\mathbb Q(\zeta_p)$ with local–global compatibility. A further gap: uniqueness in Milne's sense
("skew-symmetric pairing satisfying (a)–(c)") follows on the subgroup generated by $\lambda, \eta_i$
(`prop_5_12_unique`). Here it is proved on all of $K^\times$ for Steinberg pairings.
-/

open scoped ValuativeRel
open NumberFieldKB.MilneCFT.LocalCFT

namespace NumberFieldKB.MilneCFT.Ch8

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-- **Milne, *CFT*, VIII, Proposition 5.12** (p. 248), all but the value $(\eta_p,\lambda) = \zeta$, for the Hilbert
pairing defined by a local Artin map on a local field with the invariants of $\mathbb Q_p[\zeta_p]$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Prop. 5.12, p. 248 (all but the normalization (η_p, λ) = ζ)"]
theorem prop_5_12 {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {ζ : Kˣ} (hζ : IsPrimitiveRoot ζ p)
    {φ : ∀ L : FiniteAbelianExt K Ω, Kˣ →* Gal(L.toField/K)} (hφ : IsLocalArtinMap φ)
    {lam ε : 𝒪[K]} (hlam : Irreducible lam) (hε : IsUnit ε) (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1))
    (hres : Nat.card 𝓀[K] = p) :
    IsExplicitPairing (hilbertPairing hζ hφ) p (lamUnit hlam) (etaUnit hlam)
        (hilbertPairing hζ hφ (etaUnit hlam p) (lamUnit hlam)) (fun i _ => i) ∧
      (∀ i j, 1 ≤ i → 1 ≤ j → p + 1 ≤ i + j → ∀ u w : Kˣ,
        (∃ c : 𝒪[K], (u : K) = 1 + (lam : K) ^ i * c) → (∃ c : 𝒪[K], (w : K) = 1 + (lam : K) ^ j * c) →
        hilbertPairing hζ hφ u w = 1) ∧
      (∀ P' : Kˣ →* Kˣ →* Kˣ, IsSteinbergPairing P' p →
        P' (etaUnit hlam p) (lamUnit hlam) = hilbertPairing hζ hφ (etaUnit hlam p) (lamUnit hlam) →
        P' = hilbertPairing hζ hφ) ∧
      hilbertPairing hζ hφ (etaUnit hlam p) (lamUnit hlam) =
        hilbertPairing hζ hφ (etaUnit hlam 1) (etaUnit hlam (p - 1)) := by
  have hp : p.Prime := Fact.out
  have hS := hilbertPairing_isSteinberg hζ hφ
  have heta : ∀ i, 1 ≤ i → (etaUnit hlam i : K) = 1 - ((lamUnit hlam : Kˣ) : K) ^ i :=
    fun i hi => etaUnit_val hlam hi
  have hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = etaUnit hlam k := by
    intro k hk
    refine exists_unit_pow_of_mem hp hε hplam (irr_mem_max hlam) hk _ ⟨-1, ?_⟩
    rw [etaUnit_val hlam (by omega)]
    simp [sub_eq_add_neg]
  refine ⟨hS.isExplicitPairing heta hp hp2 hpow, ?_, ?_, ?_⟩
  · intro i j hi hj hij u w hu hw
    exact hS.cond_c hp hp2 hlam hε hplam hres hi hj hij u w hu hw
  · intro P' hP' hval
    exact steinberg_pairings_eq_of_local hP' hS hp hp2 hlam hε hplam hres hval
  · exact hS.eta_p_lam_eq heta (hp.odd_of_ne_two hp2) hp.two_le
      (fun k hk x => hS.eq_one_of_pow (hpow k hk) x)

end NumberFieldKB.MilneCFT.Ch8
