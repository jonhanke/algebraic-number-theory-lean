import Mathlib.Algebra.Group.Subgroup.Lattice
import QuadFormsKB.Citation
import Mathlib.Algebra.Group.Pointwise.Set.Basic

/-!
# Milne, *Class Field Theory*, Chapter VIII, Proposition 5.12: uniqueness of the explicit Hilbert pairing

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII, §5,
Proposition 5.12 (pdf p. 257, printed p. 248). Locators give Milne's printed page numbers (printed page = pdf page − 9).

Setting (Milne): $p$ an odd prime, $K = \mathbb Q[\zeta]$ with $\zeta$ a primitive $p$th root of $1$, completed at
$\lambda = 1 - \zeta$; $\eta_i = 1 - \lambda^i$ ($\eta_1 = \zeta$); $K^\times/K^{\times p}$ is generated by
$\lambda, \eta_1, \dots, \eta_p$. Proposition 5.12: the Hilbert pairing $K^\times \times K^\times \to \mu_p$ is the
**unique** skew-symmetric pairing satisfying
(a) $(\eta_i, \eta_j) = (\eta_i, \eta_{i+j})(\eta_{i+j}, \eta_j)(\eta_{i+j}, \lambda)^{e}$ for $i, j \ge 1$ (in our copy
of the text the exponent is damaged; it is $i$ or $j$), (b) $(\eta_i, \lambda) = 1$ for $1 \le i \le p - 1$ and
$(\eta_p, \lambda) = \zeta$, (c) $(\cdot,\cdot) = 1$ on $U_i \times U_j$ for $i + j \ge p + 1$.

## What is formalized

* `prop_5_12_unique`: **the uniqueness half**, abstractly and for every choice of the exponent in (a): two
  bimultiplicative skew-symmetric pairings on a commutative group with values in a commutative group, satisfying (a)
  (with the same exponents), (b) and (c) on the elements $\lambda, \eta_i$, agree on the subgroup generated by
  $\lambda$ and the $\eta_i$. Condition (c) is used on the generators: $(\eta_i, \eta_j) = 1$ for $i + j \ge p + 1$
  and $(\eta_i, \lambda) = 1$ for $i \ge p + 1$ (since $\eta_i \in U_{p+1} \subseteq K^{\times p}$); $(\lambda,\lambda)
  = 1$ is skew-symmetry ($(\lambda, -\lambda) = 1$) with $-1 = (-1)^p$ a $p$th power.

Not formalized: the existence half (that the Hilbert pairing of order $p$ at the prime above $p$ satisfies (a)–(c)),
which needs the local Hilbert symbol of order $p$ at completions of number fields (the library has it only for $n = 2$,
QuadFormsKB `hilbertSymbol`, and in the idelic form `Ch8.hilbertArtin`), and the generation of $K^\times/K^{\times p}$
by $\lambda, \eta_1, \dots, \eta_p$.
-/

namespace NumberFieldKB.MilneCFT.Ch8

variable {G M : Type*} [CommGroup G] [CommGroup M]

/-- The hypotheses of Proposition 5.12 on a pairing `P` (bimultiplicative, `G →* G →* M`), for elements `lam` ($\lambda$)
and `eta i` ($\eta_i$, used for `i ≥ 1`), a prime-like bound `p`, the value `z` of $(\eta_p, \lambda)$ and the exponents
`e i j` in (a). -/
structure IsExplicitPairing (P : G →* G →* M) (p : ℕ) (lam : G) (eta : ℕ → G) (z : M) (e : ℕ → ℕ → ℕ) : Prop where
  skew : ∀ x y, P x y * P y x = 1
  lam_lam : P lam lam = 1
  a : ∀ i j, 1 ≤ i → 1 ≤ j →
    P (eta i) (eta j) = P (eta i) (eta (i + j)) * P (eta (i + j)) (eta j) * P (eta (i + j)) lam ^ e i j
  b_lt : ∀ i, 1 ≤ i → i ≤ p - 1 → P (eta i) lam = 1
  b_eq : P (eta p) lam = z
  c_eta : ∀ i j, 1 ≤ i → 1 ≤ j → p + 1 ≤ i + j → P (eta i) (eta j) = 1
  c_lam : ∀ i, p + 1 ≤ i → P (eta i) lam = 1

/-- **Proposition 5.12, uniqueness** (Milne, *CFT*, VIII, Prop. 5.12, p. 248): two pairings satisfying (a), (b), (c)
(`IsExplicitPairing`, with the same data) agree on the subgroup generated by $\lambda$ and the $\eta_i$, $i \ge 1$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Prop. 5.12, p. 248 (uniqueness)"]
theorem prop_5_12_unique {P Q : G →* G →* M} {p : ℕ} {lam : G} {eta : ℕ → G} {z : M} {e : ℕ → ℕ → ℕ}
    (hP : IsExplicitPairing P p lam eta z e) (hQ : IsExplicitPairing Q p lam eta z e) :
    ∀ x ∈ Subgroup.closure (insert lam (eta '' Set.Ici 1)),
      ∀ y ∈ Subgroup.closure (insert lam (eta '' Set.Ici 1)), P x y = Q x y := by
  have h1 : ∀ i, 1 ≤ i → P (eta i) lam = Q (eta i) lam := by
    intro i hi
    rcases (by omega : i ≤ p - 1 ∨ i = p ∨ p + 1 ≤ i) with h | h | h
    · rw [hP.b_lt i hi h, hQ.b_lt i hi h]
    · subst h; rw [hP.b_eq, hQ.b_eq]
    · rw [hP.c_lam i h, hQ.c_lam i h]
  have h2 : ∀ k i j, 1 ≤ i → 1 ≤ j → p + 1 ≤ i + j + k → P (eta i) (eta j) = Q (eta i) (eta j) := by
    intro k
    induction k with
    | zero =>
      intro i j hi hj h
      rw [hP.c_eta i j hi hj (by omega), hQ.c_eta i j hi hj (by omega)]
    | succ k ih =>
      intro i j hi hj h
      by_cases hij : p + 1 ≤ i + j
      · rw [hP.c_eta i j hi hj hij, hQ.c_eta i j hi hj hij]
      · rw [hP.a i j hi hj, hQ.a i j hi hj,
          ih i (i + j) hi (by omega) (by omega), ih (i + j) j (by omega) hj (by omega),
          h1 (i + j) (by omega)]
  have hs : ∀ (R : G →* G →* M), (∀ x y, R x y * R y x = 1) → ∀ x y, R x y = (R y x)⁻¹ :=
    fun R hR x y => eq_inv_of_mul_eq_one_left (hR x y)
  have h3 : ∀ s ∈ insert lam (eta '' Set.Ici 1), ∀ t ∈ insert lam (eta '' Set.Ici 1),
      P s t = Q s t := by
    intro s hs' t ht
    rcases hs' with rfl | ⟨i, hi, rfl⟩ <;> rcases ht with rfl | ⟨j, hj, rfl⟩
    · rw [hP.lam_lam, hQ.lam_lam]
    · rw [hs P hP.skew, hs Q hQ.skew, h1 j hj]
    · exact h1 i hi
    · exact h2 (p + 1) i j hi hj (by omega)
  intro x hx y hy
  have h4 : ∀ t ∈ insert lam (eta '' Set.Ici 1), ∀ x ∈ Subgroup.closure (insert lam (eta '' Set.Ici 1)),
      P x t = Q x t := by
    intro t ht x hx
    induction hx using Subgroup.closure_induction with
    | mem x hx => exact h3 x hx t ht
    | one => simp
    | mul a b _ _ iha ihb => rw [map_mul, map_mul, MonoidHom.mul_apply, MonoidHom.mul_apply, iha, ihb]
    | inv a _ iha => rw [map_inv, map_inv, MonoidHom.inv_apply, MonoidHom.inv_apply, iha]
  induction hy using Subgroup.closure_induction with
  | mem t ht => exact h4 t ht x hx
  | one => simp
  | mul a b _ _ iha ihb => rw [map_mul, map_mul, iha, ihb]
  | inv a _ iha => rw [map_inv, map_inv, iha]

end NumberFieldKB.MilneCFT.Ch8
