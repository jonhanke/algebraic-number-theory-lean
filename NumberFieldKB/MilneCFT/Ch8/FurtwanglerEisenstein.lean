import NumberFieldKB.MilneCFT.Ch8.Fermat
import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.Cyclotomic.EisensteinPrimary
import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.Cyclotomic.RootsOfUnity
import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.PowerResidueSymbol.Ideal
import NumberFieldKB.MilneCFT.Ch8.FurtwanglerIdeal
import NumberFieldKB.MilneCFT.Ch8.FurtwanglerReduce

/-!
# Milne, *Class Field Theory*, VIII, Theorem 5.14 (Furtwängler) from Eisenstein reciprocity

Source: Milne, *CFT* v4.03, Chapter VIII, Theorem 5.14 (printed p. 249). Milne's proof uses the power reciprocity
law (Theorem 5.11) together with the explicit Hilbert pairing (Proposition 5.12, Artin–Hasse), not available here. We
follow instead Ireland–Rosen, *A Classical Introduction to Modern Number Theory*, Chapter 14, §5, which derives
Furtwängler's theorem from the **Eisenstein reciprocity law** (Ireland–Rosen, Theorem 14.5.1), taken here as the named
input `EisensteinReciprocity`. It is phrased with Tau Ceti's power residue symbol at an ideal
(`Ideal.powerResidueSymbolIdeal`) and Tau Ceti's primary elements (`TauCeti.IsEisensteinPrimary`). It is now proved,
by Hasse's route from Hilbert reciprocity rather than Ireland–Rosen's Stickelberger route:
`Eisenstein.eisensteinReciprocity` (Ch8/Eisenstein/Reciprocity.lean); hence `Eisenstein.furtwanglerInt` and
`Eisenstein.theorem5_14` (Ch8/Eisenstein/Furtwangler.lean) discharge the reductions of this file.

Proof of `theorem5_14_of_eisensteinReciprocity` (with $K = \mathbb Q(\zeta_p)$, $\lambda = \zeta - 1$): for
$a^p + b^p = c^p$ in coprime integers prime to $p$ and a prime $q \mid b$,
1. $(a + \zeta b)$ is the $p$-th power of an ideal (`exists_pow_eq_span`), since the factors $a + \zeta^i b$ of
   $c^p$ are pairwise coprime;
2. $\zeta^{c}(a+\zeta b)$ is primary for some $c\not\equiv0 \pmod p$ (Tau Ceti's
   `isEisensteinPrimary_toInteger_pow_mul_iff`);
3. multiplying by an auxiliary rational prime $r\ne p, q$ makes it a non-unit, and Eisenstein reciprocity with
   $a = q$ gives $\zeta^{c(q^{p-1}-1)/p} = 1$, using $(\zeta/q)_p = \zeta^{(q^{p-1}-1)/p}$ (`symbol_zeta_span_natCast`)
   and $(m/n)_p = 1$ for coprime rational integers (`symbol_intCast_span_intCast`, by Galois invariance).
-/

open NumberField Ideal

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8

/-- **Eisenstein reciprocity law** (named input; Ireland–Rosen, *A Classical Introduction to Modern Number Theory*,
Theorem 14.5.1; Eisenstein 1850). Let $p$ be an odd prime, $K = \mathbb Q(\zeta_p)$, $a\in\mathbb Z$ prime to $p$,
and $\alpha\in\mathcal O_K$ a primary non-unit (prime to $p$ and congruent to a rational integer modulo
$(\zeta - 1)^2$) relatively prime to $a$. Then $(\alpha/a)_p = (a/\alpha)_p$, for the $p$-th power residue symbol
at the ideals $(a)$ and $(\alpha)$ (`Ideal.powerResidueSymbolIdeal`). -/
@[kb "milne2020cft" "Ch. VIII, Theorem 5.14 (Eisenstein reciprocity, Ireland–Rosen 14.5.1; proved, Eisenstein.eisensteinReciprocity)"]
structure EisensteinReciprocity : Prop where
  law : ∀ (p : ℕ) [Fact p.Prime], p ≠ 2 →
    ∀ (K : Type) [Field K] [NumberField K] [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p)
      (α : 𝓞 K) (a : ℤ), TauCeti.IsEisensteinPrimary hζ.toInteger α → ¬ IsUnit α → ¬ (p : ℤ) ∣ a →
      IsCoprime α (a : 𝓞 K) →
      powerResidueSymbolIdeal (span {(a : 𝓞 K)}) p (Ideal.Quotient.mk _ α) =
        powerResidueSymbolIdeal (span {α}) p (Ideal.Quotient.mk _ (a : 𝓞 K))

section Cyclotomic

variable {p : ℕ} [hp : Fact p.Prime] {K : Type} [Field K] [NumberField K] [IsCyclotomicExtension {p} ℚ K]
  {ζ : K} (hζ : IsPrimitiveRoot ζ p)

/-- The norm of the ideal generated by a rational integer: $N((n)) = |n|^{p-1}$. -/
theorem absNorm_span_intCast (n : ℤ) :
    absNorm (span {(n : 𝓞 K)}) = n.natAbs ^ (p - 1) := by
  have hfin : Module.finrank ℤ (𝓞 K) = p - 1 := by
    rw [RingOfIntegers.rank, IsCyclotomicExtension.finrank K (Polynomial.cyclotomic.irreducible_rat hp.out.pos),
      Nat.totient_prime hp.out]
  rw [absNorm_span_singleton, ← eq_intCast (algebraMap ℤ (𝓞 K)) n, Algebra.norm_algebraMap, hfin, Int.natAbs_pow]

include hζ in
/-- **Rational integers have trivial symbol at rational integers**: for coprime $m, n\in\mathbb Z$,
$(m/n)_p = 1$. The value is a $p$-th root of unity fixed by the automorphism $\zeta\mapsto\zeta^2$ of $K$, since
$m$ and the ideal $(n)$ are Galois-invariant (`Ideal.map_powerResidueSymbolIdeal`). -/
theorem symbol_intCast_span_intCast (hp2 : p ≠ 2) {m n : ℤ} (hmn : IsCoprime m n) :
    powerResidueSymbolIdeal (span {(n : 𝓞 K)}) p (Ideal.Quotient.mk _ (m : 𝓞 K)) = 1 := by
  set η := hζ.toInteger
  have hη : IsPrimitiveRoot η p := hζ.toInteger_isPrimitiveRoot
  set χ := powerResidueSymbolIdeal (span {(n : 𝓞 K)}) p (Ideal.Quotient.mk _ (m : 𝓞 K)) with hχ
  -- `χ` is a `p`-th root of unity
  have hcop : IsCoprime (span {(m : 𝓞 K)}) (span {(n : 𝓞 K)}) :=
    (Ideal.isCoprime_span_singleton_iff _ _).mpr (hmn.intCast)
  have hunit : IsUnit (Ideal.Quotient.mk (span {(n : 𝓞 K)}) (m : 𝓞 K)) := by
    by_contra hnu
    exact ((powerResidueSymbolIdeal_mk_eq_zero_iff (n := p)).mp (MulChar.map_nonunit _ hnu)) hcop
  have hχp : χ ^ p = 1 := powerResidueSymbolIdeal_pow_eq_one (n := p) hunit
  obtain ⟨k, -, hk⟩ := hη.eq_pow_of_pow_eq_one hχp
  -- the automorphism `ζ ↦ ζ ^ 2`
  have h2 : Nat.Coprime 2 p := (Nat.coprime_primes Nat.prime_two hp.out).mpr (Ne.symm hp2)
  have hμ : IsPrimitiveRoot (ζ ^ 2) p := hζ.pow_of_coprime 2 h2
  have hirr := Polynomial.cyclotomic.irreducible_rat (n := p) hp.out.pos
  let τ : K ≃ₐ[ℚ] K := (hζ.powerBasis ℚ).equivOfMinpoly (hμ.powerBasis ℚ) (by
    simp only [IsPrimitiveRoot.powerBasis_gen]
    rw [← hζ.minpoly_eq_cyclotomic_of_irreducible hirr, ← hμ.minpoly_eq_cyclotomic_of_irreducible hirr])
  have hτ : τ ζ = ζ ^ 2 := by
    have := (hζ.powerBasis ℚ).equivOfMinpoly_gen (hμ.powerBasis ℚ) (by
      simp only [IsPrimitiveRoot.powerBasis_gen]
      rw [← hζ.minpoly_eq_cyclotomic_of_irreducible hirr, ← hμ.minpoly_eq_cyclotomic_of_irreducible hirr])
    simpa only [IsPrimitiveRoot.powerBasis_gen] using this
  let σ : 𝓞 K ≃+* 𝓞 K := RingOfIntegers.mapRingEquiv (τ : K ≃+* K)
  have hση : σ η = η ^ 2 := by
    ext
    simp only [σ, RingOfIntegers.mapRingEquiv_apply, η, AlgEquiv.coe_toRingEquiv]
    have hc : (algebraMap (𝓞 K) K) hζ.toInteger = ζ := hζ.coe_toInteger
    simp only [map_pow, hc]
    exact hτ
  have hfix : σ χ = χ := by
    rw [hχ, map_powerResidueSymbolIdeal, Ideal.map_span, Set.image_singleton, map_intCast, map_intCast]
  rw [← hk, map_pow, hση, ← pow_mul] at hfix
  have hne : η ^ k ≠ 0 := pow_ne_zero _ (hη.ne_zero hp.out.ne_zero)
  have : η ^ k * η ^ k = η ^ k * 1 := by rw [← pow_add, mul_one, ← two_mul]; exact hfix
  rw [← hk]
  exact mul_left_cancel₀ hne this

/-- $(\zeta/q)_p = \zeta^{(q^{p-1}-1)/p}$ for a rational prime $q\ne p$. -/
theorem symbol_zeta_span_natCast {q : ℕ} (hq : q.Prime) (hqp : q ≠ p) :
    powerResidueSymbolIdeal (span {(q : 𝓞 K)}) p (Ideal.Quotient.mk _ hζ.toInteger) =
      hζ.toInteger ^ ((q ^ (p - 1) - 1) / p) := by
  have hnorm : absNorm (span {(q : 𝓞 K)}) = q ^ (p - 1) := by
    have := absNorm_span_intCast (p := p) (K := K) (q : ℤ)
    simpa using this
  have hcop : (absNorm (span {(q : 𝓞 K)})).Coprime p := by
    rw [hnorm]
    exact Nat.Coprime.pow_left _ ((Nat.coprime_primes hq hp.out).mpr hqp)
  rw [powerResidueSymbolIdeal_mk_of_pow_eq_one hcop hζ.toInteger_isPrimitiveRoot.pow_eq_one, hnorm]

end Cyclotomic

/-- **Furtwängler's theorem for an integral solution**, from Eisenstein reciprocity, in a fixed cyclotomic field
$K = \mathbb Q(\zeta_p)$. -/
theorem furtwangler_aux (hE : EisensteinReciprocity) {p : ℕ} [Fact p.Prime] (hp2 : p ≠ 2) {K : Type} [Field K]
    [NumberField K] [IsCyclotomicExtension {p} ℚ K] {ζ : K} (hζ : IsPrimitiveRoot ζ p) {a b c : ℤ}
    (h : a ^ p + b ^ p = c ^ p) (hab : IsCoprime a b) (hpb : ¬ (p : ℤ) ∣ b)
    (hpc : ¬ (p : ℤ) ∣ c) {q : ℕ} (hq : q.Prime) (hqb : (q : ℤ) ∣ b) :
    q ^ (p - 1) ≡ 1 [MOD p ^ 2] := by
  have hp : p.Prime := Fact.out
  set η := hζ.toInteger with hηdef
  have hη : IsPrimitiveRoot η p := hζ.toInteger_isPrimitiveRoot
  have hηu : IsUnit η := hη.isUnit hp.ne_zero
  have hqp : q ≠ p := by
    rintro rfl
    exact hpb hqb
  -- `p ∤ a + b`, since `a + b ≡ a ^ p + b ^ p = c ^ p ≡ c (mod p)`
  have hpab : ¬ (p : ℤ) ∣ a + b := by
    intro hd
    apply hpc
    have h1 : ((a : ZMod p) + b) = c := by
      have := congrArg (fun t : ℤ => (t : ZMod p)) h
      simpa only [Int.cast_add, Int.cast_pow, ZMod.pow_card] using this
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd] at hd ⊢
    push_cast at hd
    rw [← h1]
    exact hd
  -- `α = a + ζ b = (a + b) + b (ζ - 1)` is prime to `ζ - 1`
  set α : 𝓞 K := (a : 𝓞 K) + η * b with hα
  have hαdec : α = ((a + b : ℤ) : 𝓞 K) + (b : ℤ) * (η - 1) := by
    rw [hα]; push_cast; ring
  have hlα : ¬ η - 1 ∣ α := by
    intro hd
    apply hpab
    rw [← IsCyclotomicExtension.Rat.zeta_sub_one_dvd_intCast_iff' p hζ]
    have : ((a + b : ℤ) : 𝓞 K) = α - (b : ℤ) * (η - 1) := by rw [hαdec]; ring
    rw [this]
    exact dvd_sub hd (dvd_mul_left _ _)
  -- the primary normalisation `ζ ^ c₀ α`, with `p ∤ c₀`
  have hab0 : ((a + b : ℤ) : ZMod p) ≠ 0 := by
    rw [Ne, ZMod.intCast_zmod_eq_zero_iff_dvd]; exact hpab
  set t : ZMod p := -((b : ℤ) : ZMod p) * ((a + b : ℤ) : ZMod p)⁻¹ with ht
  set c₀ : ℕ := t.val with hc₀def
  have hc₀t : ((c₀ : ℕ) : ZMod p) = t := ZMod.natCast_zmod_val t
  have hc₀ : (p : ℤ) ∣ b + c₀ * (a + b) := by
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    have hab0' : ((a : ZMod p) + b) ≠ 0 := by exact_mod_cast hab0
    push_cast
    rw [hc₀t, ht]
    push_cast
    rw [mul_assoc, inv_mul_cancel₀ hab0', mul_one, add_neg_cancel]
  have hpc₀ : ¬ p ∣ c₀ := by
    intro hd
    apply hpb
    rw [← ZMod.natCast_eq_zero_iff] at hd
    rw [hc₀t, ht] at hd
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd]
    have := mul_eq_zero.mp hd
    rcases this with h0 | h0
    · simpa using h0
    · exact absurd (inv_eq_zero.mp h0) hab0
  have hprim : TauCeti.IsEisensteinPrimary η (η ^ c₀ * α) :=
    (hζ.isEisensteinPrimary_toInteger_pow_mul_iff hp2 hlα (a := a + b) (b := b)
      (by rw [hαdec]; exact ⟨0, by simp [hηdef]⟩) c₀).mpr hc₀
  -- `(α)` is a `p`-th power
  obtain ⟨A, hA⟩ := exists_pow_eq_span hζ hp2 h hab hpc
  -- an auxiliary rational prime `r ≠ p, q`
  obtain ⟨r, hrge, hr⟩ := Nat.exists_infinite_primes (p + q + 1)
  have hrp : r ≠ p := by omega
  have hrq : r ≠ q := by omega
  set β : 𝓞 K := η ^ c₀ * α * ((r : ℤ) : 𝓞 K) with hβ
  have hprimβ : TauCeti.IsEisensteinPrimary η β := by
    refine hprim.mul ((hζ.isEisensteinPrimary_intCast_iff).mpr ?_)
    rw [Int.natCast_dvd_natCast]
    exact fun hd => hrp ((Nat.prime_dvd_prime_iff_eq hp hr).mp hd).symm
  have hrnu : ¬ IsUnit ((r : ℤ) : 𝓞 K) := by
    intro hu
    have h1 := absNorm_span_intCast (p := p) (K := K) (r : ℤ)
    rw [Ideal.span_singleton_eq_top.mpr hu, absNorm_top, Int.natAbs_natCast] at h1
    have h2 : 2 ≤ r ^ (p - 1) := le_trans hr.two_le (Nat.le_self_pow (by have := hp.two_le; omega) r)
    omega
  have hβnu : ¬ IsUnit β := fun hu => hrnu (isUnit_of_mul_isUnit_right hu)
  have hpq : ¬ (p : ℤ) ∣ (q : ℤ) := by
    rw [Int.natCast_dvd_natCast]
    exact fun hd => hqp ((Nat.prime_dvd_prime_iff_eq hp hq).mp hd).symm
  -- coprimality with `q`
  obtain ⟨b', hb'⟩ := hqb
  have hqa : IsCoprime a (q : ℤ) := hab.of_isCoprime_of_dvd_right ⟨b', hb'⟩
  have hαq : IsCoprime α ((q : ℤ) : 𝓞 K) := by
    have : α = (a : 𝓞 K) + ((q : ℤ) : 𝓞 K) * (η * b') := by rw [hα, hb']; push_cast; ring
    rw [this]
    exact (hqa.intCast).add_mul_left_left _
  have hrq' : IsCoprime (r : ℤ) (q : ℤ) :=
    Nat.isCoprime_iff_coprime.mpr ((Nat.coprime_primes hr hq).mpr hrq)
  have hqr' : IsCoprime (q : ℤ) (r : ℤ) := hrq'.symm
  have hβq : IsCoprime β ((q : ℤ) : 𝓞 K) := by
    refine IsCoprime.mul_left ?_ hrq'.intCast
    exact (isCoprime_mul_unit_left_left (hηu.pow c₀) α _).mpr hαq
  -- Eisenstein reciprocity
  have hEis := hE.law p hp2 K hζ β q hprimβ hβnu hpq hβq
  -- the right side `(q / β)` is `1`
  have hα0 : α ≠ 0 := fun h0 => hlα (h0 ▸ dvd_zero _)
  have hr0 : ((r : ℤ) : 𝓞 K) ≠ 0 := Int.cast_ne_zero.mpr (by exact_mod_cast hr.ne_zero)
  have hspanβ : span {β} = A ^ p * span {((r : ℤ) : 𝓞 K)} := by
    rw [hβ, ← Ideal.span_singleton_mul_span_singleton, Ideal.span_singleton_mul_left_unit (hηu.pow c₀), hA]
  have hAq : IsUnit (Ideal.Quotient.mk A ((q : ℤ) : 𝓞 K)) := by
    rw [Ideal.Quotient.isUnit_mk_iff]
    have h1 : span {((q : ℤ) : 𝓞 K)} ⊔ span {α} = ⊤ :=
      Ideal.isCoprime_iff_sup_eq.mp ((Ideal.isCoprime_span_singleton_iff _ _).mpr hαq.symm)
    refine eq_top_iff.mpr (h1 ▸ sup_le_sup_left ?_ _)
    rw [← hA]
    exact Ideal.pow_le_self hp.ne_zero
  have hRHS : powerResidueSymbolIdeal (span {β}) p (Ideal.Quotient.mk _ ((q : ℤ) : 𝓞 K)) = 1 := by
    rw [hspanβ, powerResidueSymbolIdeal_mul_right (by rw [hA]; simpa using hα0) (by simpa using hr0),
      powerResidueSymbolIdeal_pow_right, powerResidueSymbolIdeal_pow_eq_one (n := p) hAq, one_mul]
    exact symbol_intCast_span_intCast hζ hp2 hqr'
  -- the left side `(β / q)` is `ζ ^ (c₀ (q ^ (p - 1) - 1) / p)`
  have hmkα : Ideal.Quotient.mk (span {((q : ℤ) : 𝓞 K)}) α =
      Ideal.Quotient.mk (span {((q : ℤ) : 𝓞 K)}) (a : 𝓞 K) := by
    rw [Ideal.Quotient.eq, Ideal.mem_span_singleton]
    exact ⟨η * b', by rw [hα, hb']; push_cast; ring⟩
  have hLHS : powerResidueSymbolIdeal (span {((q : ℤ) : 𝓞 K)}) p (Ideal.Quotient.mk _ β) =
      η ^ (c₀ * ((q ^ (p - 1) - 1) / p)) := by
    have hz : powerResidueSymbolIdeal (span {((q : ℤ) : 𝓞 K)}) p (Ideal.Quotient.mk _ η) =
        η ^ ((q ^ (p - 1) - 1) / p) := by
      have := symbol_zeta_span_natCast (K := K) hζ hq hqp
      rw [show ((q : ℤ) : 𝓞 K) = (q : 𝓞 K) from Int.cast_natCast q]
      exact this
    rw [hβ, map_mul, map_mul, map_mul, map_mul, map_pow, map_pow, hmkα,
      symbol_intCast_span_intCast hζ hp2 hqa, symbol_intCast_span_intCast hζ hp2 hrq', mul_one, mul_one,
      hz, ← pow_mul, mul_comm]
  rw [hLHS, hRHS, hη.pow_eq_one_iff_dvd] at hEis
  have hpe : p ∣ (q ^ (p - 1) - 1) / p := (hp.dvd_mul.mp hEis).resolve_left hpc₀
  -- Fermat: `p ∣ q ^ (p - 1) - 1`
  have hferm : p ∣ q ^ (p - 1) - 1 := by
    have hq0 : (q : ZMod p) ≠ 0 := by
      rw [Ne, ZMod.natCast_eq_zero_iff]
      exact fun hd => hqp ((Nat.prime_dvd_prime_iff_eq hp hq).mp hd).symm
    have h1 := ZMod.pow_card_sub_one_eq_one hq0
    have h2 : 1 ≤ q ^ (p - 1) := Nat.one_le_pow _ _ hq.pos
    rw [← ZMod.natCast_eq_zero_iff, Nat.cast_sub h2]
    push_cast
    rw [h1, sub_self]
  have hsq : p ^ 2 ∣ q ^ (p - 1) - 1 := by
    obtain ⟨e, he⟩ := hferm
    obtain ⟨f, hf⟩ := hpe
    rw [he, Nat.mul_div_cancel_left _ hp.pos] at hf
    rw [he, hf, sq]
    exact ⟨f, by ring⟩
  exact ((Nat.modEq_iff_dvd' (Nat.one_le_pow _ _ hq.pos)).mpr hsq).symm

/-- **Furtwängler's theorem for an integral solution**, from Eisenstein reciprocity: if $a^p + b^p = c^p$ with
$a, b$ coprime, $p\nmid abc$, and $q$ is a prime dividing $b$, then $q^{p-1}\equiv 1 \pmod{p^2}$. -/
theorem furtwangler_int (hE : EisensteinReciprocity) {p : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {a b c : ℤ}
    (h : a ^ p + b ^ p = c ^ p) (hab : IsCoprime a b) (_hpa : ¬ (p : ℤ) ∣ a) (hpb : ¬ (p : ℤ) ∣ b)
    (hpc : ¬ (p : ℤ) ∣ c) {q : ℕ} (hq : q.Prime) (hqb : (q : ℤ) ∣ b) :
    q ^ (p - 1) ≡ 1 [MOD p ^ 2] := by
  have : Fact p.Prime := ⟨hp⟩
  have : NeZero p := ⟨hp.ne_zero⟩
  have : NeZero ((p : ℕ) : ℚ) := ⟨by exact_mod_cast hp.ne_zero⟩
  have : IsCyclotomicExtension {p} ℚ (CyclotomicField p ℚ) := CyclotomicField.isCyclotomicExtension p ℚ
  exact furtwangler_aux (K := CyclotomicField p ℚ) hE hp2 (IsCyclotomicExtension.zeta_spec p ℚ (CyclotomicField p ℚ)) h hab hpb hpc hq hqb

/-- The integral form of Furtwängler's theorem (`FurtwanglerInt`) from Eisenstein reciprocity. -/
@[kb "milne2020cft" "Ch. VIII, Theorem 5.14 (integral form, from Eisenstein reciprocity)"]
theorem furtwanglerInt_of_eisensteinReciprocity (hE : EisensteinReciprocity) : FurtwanglerInt :=
  ⟨fun _ hp hp2 _ _ _ h hab hpa hpb hpc _ hq hqb => furtwangler_int hE hp hp2 h hab hpa hpb hpc hq hqb⟩

/-- **Theorem 5.14 (Furtwängler)** (Milne, *CFT*, VIII, Theorem 5.14, p. 249), from the Eisenstein reciprocity law
(Ireland–Rosen, Chapter 14, §5). -/
@[kb "milne2020cft" "Ch. VIII, Theorem 5.14 (from Eisenstein reciprocity)"]
theorem theorem5_14_of_eisensteinReciprocity (hE : EisensteinReciprocity) : Theorem5_14 :=
  theorem5_14_of_int (furtwanglerInt_of_eisensteinReciprocity hE)

end NumberFieldKB.MilneCFT.Ch8
