import Mathlib
import QuadFormsKB.Citation
import NumberFieldKB.MilneCFT.Ch2Profinite
import NumberFieldKB.MilneCFT.Ch2Corestriction

/-!
# Milne, Elliptic Curves, Chapter IV §1: group cohomology

J. S. Milne, *Elliptic Curves* (2006; bibliography key `milne2006ec`), Chapter IV, Section 1 ("Group
cohomology").  Locators give the pdf page of the text `ectext6` (printed page = pdf page − 8).

Conventions.
* A $G$-module is a representation `A : Rep ℤ G`.  For a finite group, $H^0$ and $H^1$ are Mathlib's
  `groupCohomology.H0` and `groupCohomology.H1`; the latter is crossed homomorphisms (`cocycles₁`) modulo principal
  ones (`coboundaries₁`).
* For a topological group $G$ (a Galois group with its Krull topology) and a discrete $G$-module $M$, Milne
  defines $H^1(G, M)$ as continuous crossed homomorphisms modulo principal ones (pdf p. 114).  Since principal
  crossed homomorphisms are continuous (`continuous_of_mem_coboundaries₁`), this group is the subgroup `H1cont A` of
  the abstract group $H^1$ (of $G$ as a discrete group) consisting of classes of continuous crossed homomorphisms;
  continuity is for the discrete topology on $M$.  (Mathlib's `continuousCohomology` is the derived-functor
  version; a comparison is not made here.)
* The Galois group acts on the points of a Weierstrass curve through Mathlib's `Point.map` (`pointsRep`).
-/

open CategoryTheory groupCohomology WeierstrassCurve WeierstrassCurve.Affine

namespace NumberFieldKB.MilneEC

/-! ## Galois modules: the points of a Weierstrass curve -/

/-- A module in which every element is fixed by some open subgroup is discrete. -/
theorem isDiscreteModule_of_forall_exists_openSubgroup {G : Type} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] (A : Rep ℤ G)
    (h : ∀ m : A, ∃ H : OpenSubgroup G, ∀ g ∈ H, A.ρ g m = m) : MilneCFT.IsDiscreteModule A := by
  have key : (∀ m : A, ∃ H : OpenSubgroup G, ∀ g ∈ H, A.ρ g m = m) ↔ MilneCFT.IsDiscreteModule A :=
    (MilneCFT.isDiscreteModule_tfae A).out 2 3
  exact key.1 h

/-- In an algebraic extension, the automorphisms fixing a finite set of elements contain an open subgroup of the
Galois group (the subgroup fixing the finite extension generated by the set). -/
theorem exists_openSubgroup_fixing {K L : Type} [Field K] [Field L] [Algebra K L]
    [Algebra.IsAlgebraic K L] (S : Set L) (hS : S.Finite) :
    ∃ H : OpenSubgroup (L ≃ₐ[K] L), ∀ h ∈ H, ∀ x ∈ S, h x = x := by
  have := hS.to_subtype
  have hfd : FiniteDimensional K (IntermediateField.adjoin K S) :=
    IntermediateField.finiteDimensional_adjoin fun x _ => Algebra.IsIntegral.isIntegral x
  refine ⟨⟨(IntermediateField.adjoin K S).fixingSubgroup,
    IntermediateField.fixingSubgroup_isOpen _⟩, fun h hh x hx => ?_⟩
  exact (IntermediateField.mem_fixingSubgroup_iff _ _).1 hh x (IntermediateField.subset_adjoin K S hx)

section Points

variable {K : Type} [Field K] (W : WeierstrassCurve K) (L : Type) [Field L] [Algebra K L]
  [DecidableEq L]

/-- The action of $\operatorname{Aut}(L/K)$ on $E(L)$ (Example 1.1, pdf p. 110): $\sigma$ acts on coordinates. -/
noncomputable def pointsRepresentation :
    Representation ℤ (L ≃ₐ[K] L) (W.toAffine⁄L).Point where
  toFun σ := (Point.map (W' := W.toAffine) (σ : L →ₐ[K] L)).toIntLinearMap
  map_one' := by
    ext P
    exact Point.map_id P
  map_mul' σ τ := by
    ext P
    exact (Point.map_map (W' := W.toAffine) (τ : L →ₐ[K] L) (σ : L →ₐ[K] L) P).symm

/-- $E(L)$ as a $\operatorname{Gal}(L/K)$-module (Example 1.1, pdf p. 110). -/
@[kb "milne2006ec" "Ch. IV, Example 1.1, pdf p. 110"]
noncomputable abbrev pointsRep : Rep ℤ (L ≃ₐ[K] L) := Rep.of (pointsRepresentation W L)

/-- The $n$-torsion $E_n(L) = \{P \in E(L) \mid nP = 0\}$, a subgroup stable under $\operatorname{Aut}(L/K)$. -/
def torsionPoints (n : ℤ) : AddSubgroup (W.toAffine⁄L).Point :=
  (zsmulAddGroupHom (α := (W.toAffine⁄L).Point) n).ker

/-- The action of $\operatorname{Aut}(L/K)$ on $E_n(L)$. -/
noncomputable def torsionRepresentation (n : ℤ) :
    Representation ℤ (L ≃ₐ[K] L) (torsionPoints W L n) where
  toFun σ := (((Point.map (W' := W.toAffine) (σ : L →ₐ[K] L)).comp (torsionPoints W L n).subtype).codRestrict
      (torsionPoints W L n) (fun P => by
        show n • Point.map (W' := W.toAffine) (σ : L →ₐ[K] L) (P : (W.toAffine⁄L).Point) = 0
        rw [← map_zsmul, show n • (P : (W.toAffine⁄L).Point) = 0 from P.2, map_zero])).toIntLinearMap
  map_one' := by
    ext P
    exact Point.map_id (P : (W.toAffine⁄L).Point)
  map_mul' σ τ := by
    ext P
    exact (Point.map_map (W' := W.toAffine) (τ : L →ₐ[K] L) (σ : L →ₐ[K] L) P).symm

/-- $E_n(L)$ as a $\operatorname{Gal}(L/K)$-module (pdf p. 117). -/
noncomputable abbrev torsionRep (n : ℤ) : Rep ℤ (L ≃ₐ[K] L) := Rep.of (torsionRepresentation W L n)

/-- Milne (pdf p. 111): for a Galois extension $L/K$, $H^0(G, E(L)) = E(L)^G = E(K)$: a point of $E(L)$ is fixed
by every automorphism if and only if it comes from $E(K)$.  Stated for every (possibly infinite) Galois extension,
which also gives $E(k^{\mathrm{al}})^G = E(k)$ for a perfect field $k$ (pdf p. 133). -/
@[kb "milne2006ec" "Ch. IV, §1, H^0(G, E(L)) = E(K), pdf p. 111"]
theorem points_fixed_iff [DecidableEq K] [IsGalois K L] (P : (W.toAffine⁄L).Point) :
    (∀ σ : L ≃ₐ[K] L, Point.map (W' := W.toAffine) (σ : L →ₐ[K] L) P = P) ↔
      ∃ Q : (W.toAffine⁄K).Point, Point.map (W' := W.toAffine) (Algebra.ofId K L) Q = P := by
  constructor
  · intro h
    cases P with
    | zero => exact ⟨0, rfl⟩
    | @some x y hxy =>
      have hx : ∀ σ : L ≃ₐ[K] L, σ x = x := fun σ => by
        have := h σ
        simp only [Point.map_some] at this
        exact (Point.some.inj this).1
      have hy : ∀ σ : L ≃ₐ[K] L, σ y = y := fun σ => by
        have := h σ
        simp only [Point.map_some] at this
        exact (Point.some.inj this).2
      obtain ⟨x', hx'⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed x).2 hx
      obtain ⟨y', hy'⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed y).2 hy
      subst hx' hy'
      have hns : (W.toAffine⁄K).Nonsingular x' y' :=
        (W.toAffine.baseChange_nonsingular (Algebra.ofId K L).injective x' y').1 hxy
      exact ⟨Point.some _ _ hns, rfl⟩
  · rintro ⟨Q, rfl⟩ σ
    rw [Point.map_map]
    have : (σ : L →ₐ[K] L).comp (Algebra.ofId K L) = Algebra.ofId K L :=
      AlgHom.ext fun a => σ.commutes a
    rw [this]

/-- Milne (pdf p. 114): $E(k^{\mathrm{al}})$ is a discrete $\operatorname{Gal}(k^{\mathrm{al}}/k)$-module: every
point is fixed by the subgroup fixing a finite extension (the field generated by its coordinates). -/
@[kb "milne2006ec" "Ch. IV, §1, E(k^al) is a discrete G-module, pdf p. 114"]
theorem pointsRep_isDiscreteModule [Algebra.IsAlgebraic K L] :
    MilneCFT.IsDiscreteModule (pointsRep W L) := by
  refine isDiscreteModule_of_forall_exists_openSubgroup _ (fun P => ?_)
  cases P with
  | zero => exact ⟨⊤, fun h _ => map_zero _⟩
  | @some x y hxy =>
    obtain ⟨H, hH⟩ := exists_openSubgroup_fixing (K := K) (L := L) {x, y} (Set.toFinite _)
    refine ⟨H, fun h hh => ?_⟩
    change Point.map (W' := W.toAffine) (h : L →ₐ[K] L) (Point.some x y hxy) = _
    simp only [Point.map_some]
    have h1 := hH h hh x (by simp)
    have h2 := hH h hh y (by simp)
    simp [h1, h2]

end Points

/-- Milne (pdf p. 111): for a finite Galois extension $L/K$ with group $G$, $H^0(G, L^\times) = K^\times$. -/
@[kb "milne2006ec" "Ch. IV, §1, H^0(G, L^×) = K^×, pdf p. 111"]
theorem units_fixed_iff {K L : Type} [Field K] [Field L] [Algebra K L] [IsGalois K L] (x : Lˣ) :
    (∀ σ : L ≃ₐ[K] L, σ (x : L) = x) ↔ ∃ y : Kˣ, (algebraMap K L (y : K)) = x := by
  constructor
  · intro h
    obtain ⟨a, ha⟩ := (InfiniteGalois.mem_range_algebraMap_iff_fixed (k := K) (x : L)).2 h
    have hne : a ≠ 0 := by
      rintro rfl
      simp only [map_zero] at ha
      exact x.ne_zero ha.symm
    exact ⟨Units.mk0 a hne, ha⟩
  · rintro ⟨y, hy⟩ σ
    rw [← hy]
    exact σ.commutes _

/-- Milne (pdf p. 114): $(k^{\mathrm{al}})^\times$ is a discrete $\operatorname{Gal}(k^{\mathrm{al}}/k)$-module. -/
@[kb "milne2006ec" "Ch. IV, §1, k^al× is a discrete G-module, pdf p. 114"]
theorem unitsRep_isDiscreteModule {K L : Type} [Field K] [Field L] [Algebra K L]
    [Algebra.IsAlgebraic K L] : MilneCFT.IsDiscreteModule (Rep.ofAlgebraAutOnUnits K L) := by
  refine isDiscreteModule_of_forall_exists_openSubgroup _ (fun m => ?_)
  obtain ⟨H, hH⟩ := exists_openSubgroup_fixing (K := K) (L := L) {((Additive.toMul m : Lˣ) : L)} (Set.toFinite _)
  refine ⟨H, fun h hh => ?_⟩
  have h1 := hH h hh ((Additive.toMul m : Lˣ) : L) (by simp)
  apply Additive.toMul.injective
  apply Units.ext
  exact h1

/-! ## Cohomology of finite groups -/

section Finite

variable {G : Type} [Group G]

/-- Milne (pdf p. 110): $H^0(G, M) = M^G$, the invariants (Mathlib: `groupCohomology.H0Iso`). -/
@[kb "milne2006ec" "Ch. IV, §1, definition of H^0(G, M), pdf p. 110"]
noncomputable abbrev h0Iso (A : Rep ℤ G) := H0Iso A

/-- Milne (pdf p. 111): $H^1(G, M)$ is crossed homomorphisms modulo principal crossed homomorphisms: every class is
the class of a crossed homomorphism, and the class of a crossed homomorphism is zero exactly when it is principal
(Mathlib: `groupCohomology.H1π`, `groupCohomology.H1π_eq_zero_iff`, `groupCohomology.mem_cocycles₁_iff`). -/
@[kb "milne2006ec" "Ch. IV, §1, definition of crossed homomorphisms and H^1(G, M), pdf p. 111"]
theorem h1_eq_crossed_mod_principal (A : Rep ℤ G) :
    Function.Surjective (H1π A) ∧
      ∀ f : cocycles₁ A, H1π A f = 0 ↔ ∃ m : A, ∀ g : G, (f : G → A) g = A.ρ g m - m := by
  refine ⟨(ModuleCat.epi_iff_surjective _).1 inferInstance, fun f => ?_⟩
  rw [H1π_eq_zero_iff]
  constructor
  · rintro ⟨m, hm⟩
    refine ⟨m, fun g => ?_⟩
    have := congrFun hm g
    simpa [d₀₁_hom_apply] using this.symm
  · rintro ⟨m, hm⟩
    refine ⟨m, funext fun g => ?_⟩
    simpa [d₀₁_hom_apply] using (hm g).symm

/-- **Example 1.2** (pdf p. 111).  For a trivial action, $H^1(G, M) = \operatorname{Hom}(G, M)$
(Mathlib: `groupCohomology.H1IsoOfIsTrivial`). -/
@[kb "milne2006ec" "Ch. IV, Example 1.2, pdf p. 111"]
noncomputable abbrev example_1_2_trivialH1 (A : Rep ℤ G) [A.IsTrivial] :=
  H1IsoOfIsTrivial A

/-- **Proposition 1.3** (Hilbert's Theorem 90, pdf p. 111).  For a finite Galois extension $L/K$ with group $G$,
every crossed homomorphism $G \to L^\times$ is principal: if $f(\sigma\tau) = f(\sigma)\,\sigma(f(\tau))$ then
$f(\sigma) = \sigma(\beta)/\beta$ for some $\beta \in L^\times$
(Mathlib: `groupCohomology.isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units`). -/
@[kb "milne2006ec" "Ch. IV, Prop. 1.3, pdf p. 111"]
theorem prop_1_3 {K L : Type} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L]
    (f : (L ≃ₐ[K] L) → Lˣ) (hf : IsMulCocycle₁ f) : IsMulCoboundary₁ f :=
  isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units f hf

/-- The action of $\operatorname{Aut}(L/K)$ on $\mathbb{P}^n(L)$ through the coordinates. -/
noncomputable def projGalois {K L : Type} [Field K] [Field L] [Algebra K L] (n : ℕ) (σ : L ≃ₐ[K] L) :
    Projectivization L (Fin (n + 1) → L) → Projectivization L (Fin (n + 1) → L) :=
  Projectivization.map (σ := (σ : L →+* L))
    { toFun := fun v i => σ (v i)
      map_add' := fun v w => funext fun i => map_add σ (v i) (w i)
      map_smul' := fun c v => funext fun i => map_mul σ c (v i) }
    (fun _ _ h => funext fun i => σ.injective (congrFun h i))

/-- **Corollary 1.4** (pdf p. 112).  Let $L/K$ be a finite Galois extension with group $G$.  A point
$P \in \mathbb{P}^n(L)$ is fixed by $G$ if and only if it is represented by an $(n+1)$-tuple in $K$. -/
@[kb "milne2006ec" "Ch. IV, Cor. 1.4, pdf p. 112"]
theorem cor_1_4 {K L : Type} [Field K] [Field L] [Algebra K L] [FiniteDimensional K L] [IsGalois K L]
    {n : ℕ} (P : Projectivization L (Fin (n + 1) → L)) :
    (∀ σ : L ≃ₐ[K] L, projGalois n σ P = P) ↔
      ∃ (v : Fin (n + 1) → K) (hv : (fun i => algebraMap K L (v i)) ≠ 0),
        Projectivization.mk L (fun i => algebraMap K L (v i)) hv = P := by
  have hmap : ∀ (σ : L ≃ₐ[K] L) (v : Fin (n + 1) → L) (hv : v ≠ 0),
      projGalois n σ (Projectivization.mk L v hv) =
        Projectivization.mk L (fun i => σ (v i)) (fun h => hv (funext fun i => σ.injective
          ((congrFun h i).trans (map_zero σ).symm))) := fun σ v hv => rfl
  constructor
  · intro hP
    induction P using Projectivization.ind with | h v hv =>
    have hex : ∀ σ : L ≃ₐ[K] L, ∃ a : Lˣ, a • v = fun i => σ (v i) := fun σ => by
      have := hP σ
      rw [hmap] at this
      exact (Projectivization.mk_eq_mk_iff L _ _ _ hv).1 this
    choose c hc using hex
    obtain ⟨i₀, hi₀⟩ : ∃ i₀, v i₀ ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hv (funext hcon)
    have hc' : ∀ σ i, (c σ : L) * v i = σ (v i) := fun σ i => congrFun (hc σ) i
    have hcoc : IsMulCocycle₁ c := by
      intro g h
      apply Units.ext
      have e1 := hc' (g * h) i₀
      have e2 := hc' h i₀
      have e3 := hc' g i₀
      have : ((g * h : L ≃ₐ[K] L) (v i₀)) = g (h (v i₀)) := rfl
      rw [this, ← e2, map_mul, ← e3] at e1
      have e4 : ((g • c h : Lˣ) : L) = g (c h : L) := rfl
      show (c (g * h) : L) = ((g • c h : Lˣ) : L) * (c g : L)
      rw [e4]
      apply mul_right_cancel₀ hi₀
      rw [e1]; ring
    obtain ⟨β, hβ⟩ := isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units c hcoc
    have hβ0 : (β : L) ≠ 0 := β.ne_zero
    have hfix : ∀ i, ∀ σ : L ≃ₐ[K] L, σ ((β⁻¹ : Lˣ) * v i : L) = (β⁻¹ : Lˣ) * v i := by
      intro i σ
      have h2 : (σ β : L) = (c σ : L) * β := by
        have h3 : σ • β = c σ * β := div_eq_iff_eq_mul.1 (hβ σ)
        exact congrArg Units.val h3
      have hσ0 : (σ β : L) ≠ 0 := by simpa using hβ0
      rw [map_mul, Units.val_inv_eq_inv_val, map_inv₀, ← hc' σ i, h2]
      have : (c σ : L) ≠ 0 := (c σ).ne_zero
      field_simp
    choose u hu using fun i =>
      (InfiniteGalois.mem_range_algebraMap_iff_fixed (k := K) ((β⁻¹ : Lˣ) * v i : L)).2 (hfix i)
    have hne : (fun i => algebraMap K L (u i)) ≠ 0 := by
      intro h
      apply hv
      funext i
      have := congrFun h i
      simp only [hu, Pi.zero_apply] at this
      have h4 : (v i) = (β : L) * ((β⁻¹ : Lˣ) * v i) := by
        rw [← mul_assoc]; simp
      rw [h4, this]; simp
    refine ⟨u, hne, ?_⟩
    rw [Projectivization.mk_eq_mk_iff L _ _ hne hv]
    refine ⟨β⁻¹, ?_⟩
    funext i
    exact (hu i).symm
  · rintro ⟨v, hv, rfl⟩ σ
    rw [hmap]
    congr 1
    exact funext fun i => σ.commutes _

/-- **Proposition 1.5** (pdf p. 112).  A short exact sequence $0 \to M \to N \to P \to 0$ of $G$-modules gives an
exact sequence $H^0(G,N) \to H^0(G,P) \xrightarrow{\delta} H^1(G,M) \to H^1(G,N) \to H^1(G,P)$, with $H^0(G,M) \to
H^0(G,N)$ injective (Mathlib: `groupCohomology.mapShortComplex₂_exact`, `mapShortComplex₃_exact`,
`mapShortComplex₁_exact`; Mathlib proves the long exact sequence in all degrees).  The exactness at the last three
places is stated here; injectivity on $H^0$ is `h0_map_injective`. -/
@[kb "milne2006ec" "Ch. IV, Prop. 1.5, pdf p. 112"]
theorem prop_1_5 {X : ShortComplex (Rep ℤ G)} (hX : X.ShortExact) :
    (groupCohomology.mapShortComplex₂ X 0).Exact ∧ (groupCohomology.mapShortComplex₃ hX (zero_add 1)).Exact ∧
      (groupCohomology.mapShortComplex₁ hX (zero_add 1)).Exact ∧ (groupCohomology.mapShortComplex₂ X 1).Exact :=
  ⟨mapShortComplex₂_exact hX 0, mapShortComplex₃_exact hX _, mapShortComplex₁_exact hX _,
    mapShortComplex₂_exact hX 1⟩

/-- Proposition 1.5 (pdf p. 112), the first map: $0 \to H^0(G, M) \to H^0(G, N)$ is exact. -/
@[kb "milne2006ec" "Ch. IV, Prop. 1.5, pdf p. 112"]
theorem h0_map_injective {X : ShortComplex (Rep ℤ G)} (hX : X.ShortExact) :
    Function.Injective (groupCohomology.map (MonoidHom.id G) X.f 0) := by
  have := hX.mono_f
  exact (ModuleCat.mono_iff_injective _).1 inferInstance

/-- **Proposition 1.6** (pdf p. 113).  If $G$ has order $m$, then $mH^1(G, M) = 0$.  (From the corestriction
argument of Milne's *Class Field Theory*, `NumberFieldKB.MilneCFT.cor_1_31`.) -/
@[kb "milne2006ec" "Ch. IV, Prop. 1.6, pdf p. 113"]
theorem prop_1_6 [Finite G] (A : Rep ℤ G) (x : H1 A) : (Nat.card G : ℤ) • x = 0 :=
  MilneCFT.cor_1_31 A 1 Nat.one_pos x

/-- **Remark 1.7** (pdf p. 113).  For a normal subgroup $H$ of $G$ the inflation-restriction sequence
$0 \to H^1(G/H, M^H) \to H^1(G, M) \to H^1(H, M)$ is exact (Mathlib: `groupCohomology.H1InfRes_exact` and the
`Mono` instance on the inflation map). -/
@[kb "milne2006ec" "Ch. IV, Remark 1.7, pdf p. 113"]
theorem remark_1_7 (A : Rep ℤ G) (H : Subgroup G) [H.Normal] :
    Mono (H1InfRes A H).f ∧ (H1InfRes A H).Exact :=
  ⟨inferInstance, H1InfRes_exact A H⟩

end Finite

/-! ## Cohomology of infinite Galois groups -/

section Profinite

variable {G : Type} [Group G] [TopologicalSpace G]

/-- Milne (pdf p. 113): the Galois group of an algebraic closure of a perfect field $k$, with its Krull topology,
is compact, and its open subgroups are exactly the closed subgroups fixing finite extensions of $k$
(Mathlib: `Field.absoluteGaloisGroup`, `krullTopology`, `InfiniteGalois.isOpen_iff_finite`). -/
@[kb "milne2006ec" "Ch. IV, §1, the Galois group of k^al over k with the Krull topology, pdf p. 113"]
theorem galois_compact_and_isOpen_iff (k : Type) [Field k] [PerfectField k] :
    CompactSpace (Field.absoluteGaloisGroup k) ∧
      ∀ L : IntermediateField k (AlgebraicClosure k),
        IsOpen (L.fixingSubgroup : Set (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)) ↔
          FiniteDimensional k L := by
  refine ⟨?_, fun L => InfiniteGalois.isOpen_iff_finite L⟩
  change CompactSpace (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
  infer_instance

/-- Milne (pdf p. 113): a $G$-module $M$ is **discrete** if the action $G \times M \to M$ is continuous for the
discrete topology on $M$; equivalently $M = \bigcup_H M^H$ over the open subgroups $H$
(`NumberFieldKB.MilneCFT.IsDiscreteModule`, `NumberFieldKB.MilneCFT.isDiscreteModule_tfae`). -/
@[kb "milne2006ec" "Ch. IV, §1, definition of a discrete G-module, pdf p. 113"]
theorem isDiscreteModule_iff [IsTopologicalGroup G] (A : Rep ℤ G) :
    MilneCFT.IsDiscreteModule A ↔
      @Continuous (G × A) A (@instTopologicalSpaceProd G A _ ⊥) ⊥ (fun p => A.ρ p.1 p.2) :=
  ((MilneCFT.isDiscreteModule_tfae A).out 3 1)

/-- The continuous crossed homomorphisms $G \to M$, for the discrete topology on $M$. -/
def contCocycles₁ (A : Rep ℤ G) : AddSubgroup (cocycles₁ A) where
  carrier := {f | @Continuous G A _ ⊥ (f : G → A)}
  add_mem' := by
    intro a b ha hb
    let : TopologicalSpace A := ⊥
    have : DiscreteTopology A := ⟨rfl⟩
    exact (show Continuous (fun g => (a : G → A) g + (b : G → A) g) from ha.add hb)
  zero_mem' := by
    let : TopologicalSpace A := ⊥
    have : DiscreteTopology A := ⟨rfl⟩
    exact (continuous_const : Continuous (fun _ : G => (0 : A)))
  neg_mem' := by
    intro a ha
    let : TopologicalSpace A := ⊥
    have : DiscreteTopology A := ⟨rfl⟩
    exact (show Continuous (fun g => -(a : G → A) g) from ha.neg)

/-- Milne's $H^1(G, M)$ for a topological group $G$ and a discrete $G$-module $M$ (pdf p. 114): continuous
crossed homomorphisms modulo principal ones, realized as the subgroup of the abstract $H^1$ formed by the classes
of continuous crossed homomorphisms (principal ones are continuous: `continuous_of_mem_coboundaries₁`). -/
@[kb "milne2006ec" "Ch. IV, §1, definition of H^1(G, M) for an infinite Galois group, pdf p. 114"]
noncomputable def H1cont (A : Rep ℤ G) : AddSubgroup (H1 A) :=
  (contCocycles₁ A).map (H1π A).hom.toAddMonoidHom

/-- Milne (pdf p. 114): for a discrete $G$-module every principal crossed homomorphism is continuous. -/
@[kb "milne2006ec" "Ch. IV, §1, principal crossed homomorphisms are continuous, pdf p. 114"]
theorem continuous_of_mem_coboundaries₁ [IsTopologicalGroup G] (A : Rep ℤ G)
    (hA : MilneCFT.IsDiscreteModule A) (f : cocycles₁ A) (hf : (f : G → A) ∈ coboundaries₁ A) :
    @Continuous G A _ ⊥ (f : G → A) := by
  obtain ⟨m, hm⟩ := hf
  let _ : TopologicalSpace A := ⊥
  have : DiscreteTopology A := ⟨rfl⟩
  have hfm : ∀ g, (f : G → A) g = A.ρ g m - m := fun g => by
    rw [← hm]; rfl
  rw [continuous_discrete_rng]
  intro b
  rw [isOpen_iff_forall_mem_open]
  intro g hg
  refine ⟨(fun x => g⁻¹ * x) ⁻¹' {h : G | A.ρ h m = m}, fun x hx => ?_,
    (hA m).preimage (continuous_const.mul continuous_id), by simp⟩
  have hx' : A.ρ (g⁻¹ * x) m = m := hx
  have : A.ρ x m = A.ρ g m := by
    have := congrArg (A.ρ g) hx'
    rwa [← Module.End.mul_apply, ← map_mul, mul_inv_cancel_left] at this
  show (f : G → A) x = b
  rw [hfm, this, ← hfm]
  exact hg

/-- For a discrete topology on $G$ (a finite Galois group), Milne's $H^1$ is the whole abstract $H^1$. -/
theorem H1cont_eq_top [DiscreteTopology G] (A : Rep ℤ G) : H1cont A = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  induction x using H1_induction_on with | h f =>
  let _ : TopologicalSpace A := ⊥
  exact ⟨f, (continuous_of_discreteTopology : Continuous (f : G → A)), rfl⟩

/-- In a profinite group every open neighbourhood of the identity contains an open normal subgroup. -/
theorem exists_openNormalSubgroup_le_open [IsTopologicalGroup G] [CompactSpace G]
    [TotallyDisconnectedSpace G] {U : Set G} (hU : IsOpen U) (h1 : (1 : G) ∈ U) :
    ∃ H : OpenNormalSubgroup G, (H : Set G) ⊆ U :=
  ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one (G := (ProfiniteGrp.of G : Type)) hU h1

/-- Milne (pdf p. 114): for a profinite group $G$ and a discrete $G$-module $M$, a crossed homomorphism
$f : G \to M$ is continuous if and only if it is constant on the cosets of some open normal subgroup. -/
@[kb "milne2006ec" "Ch. IV, §1, continuous crossed homomorphisms factor through a finite quotient, pdf p. 114"]
theorem continuous_iff_exists_openNormalSubgroup [IsTopologicalGroup G] [CompactSpace G]
    [TotallyDisconnectedSpace G] (A : Rep ℤ G) (f : cocycles₁ A) :
    @Continuous G A _ ⊥ (f : G → A) ↔
      ∃ H : OpenNormalSubgroup G, ∀ g h : G, h ∈ H → (f : G → A) (g * h) = (f : G → A) g := by
  let _ : TopologicalSpace A := ⊥
  have _ : DiscreteTopology A := ⟨rfl⟩
  have hcoc := (mem_cocycles₁_iff f.1).1 f.2
  constructor
  · intro hf
    have hU : IsOpen ((f : G → A) ⁻¹' {0}) := hf.isOpen_preimage _ (isOpen_discrete _)
    obtain ⟨H, hH⟩ := exists_openNormalSubgroup_le_open hU (by simp [cocycles₁_map_one])
    refine ⟨H, fun g h hh => ?_⟩
    have h0 : (f : G → A) h = 0 := hH hh
    have h0' : f.1 h = 0 := h0
    refine (hcoc g h).trans ?_
    rw [h0']
    simp
  · rintro ⟨H, hH⟩
    rw [continuous_discrete_rng]
    intro b
    rw [isOpen_iff_mem_nhds]
    intro g hg
    have hopen : IsOpen {x : G | g⁻¹ * x ∈ (H : Set G)} :=
      H.isOpen.preimage (continuous_const.mul continuous_id)
    refine Filter.mem_of_superset (hopen.mem_nhds (by simp)) fun x hx => ?_
    have := hH g (g⁻¹ * x) hx
    simp only [mul_inv_cancel_left] at this
    simp only [Set.mem_preimage, Set.mem_singleton_iff] at hg ⊢
    rw [this, hg]

/-- Milne (pdf p. 114), $H^1(G, M) = \varinjlim_H H^1(G/H, M^H)$, part (a): for a profinite group and a discrete
module, $H^1(G, M)$ is the union of the images of the inflation maps from the open normal subgroups.  (Part (b) is
the injectivity of inflation in degree 1, `remark_1_7`.) -/
@[kb "milne2006ec" "Ch. IV, §1, H^1(G, M) as a direct limit, part (a), pdf p. 114"]
theorem mem_H1cont_iff_exists_inflation [IsTopologicalGroup G] [CompactSpace G]
    [TotallyDisconnectedSpace G] (A : Rep ℤ G) (hA : MilneCFT.IsDiscreteModule A) (x : H1 A) :
    x ∈ H1cont A ↔ ∃ H : OpenNormalSubgroup G,
      x ∈ Set.range (H1InfRes A (H : Subgroup G)).f := by
  constructor
  · rintro ⟨f, hf, rfl⟩
    obtain ⟨H, hH⟩ := (continuous_iff_exists_openNormalSubgroup A f).1 hf
    refine ⟨H, ?_⟩
    have hex := (ShortComplex.moduleCat_exact_iff_ker_sub_range _).1 (H1InfRes_exact A (H : Subgroup G))
    have hker : (H1π A f : H1 A) ∈ LinearMap.ker (H1InfRes A (H : Subgroup G)).g.hom := by
      rw [LinearMap.mem_ker]
      simp only [HInfRes_X₂, HInfRes_X₃, HInfRes_g, H1π_comp_map_apply (H : Subgroup G).subtype]
      rw [H1π_eq_zero_iff]
      have hz : ⇑((mapCocycles₁ (H : Subgroup G).subtype (𝟙 (Rep.res (H : Subgroup G).subtype A))).hom f) = 0 := by
        funext s
        have h1 := hH 1 s.1 s.2
        rw [one_mul, cocycles₁_map_one] at h1
        exact h1
      rw [hz]
      exact zero_mem _
    exact hex hker
  · rintro ⟨H, z, rfl⟩
    induction z using H1_induction_on with | h y =>
    refine ⟨mapCocycles₁ (QuotientGroup.mk' (H : Subgroup G))
      (Rep.ofHom <| A.ρ.quotientToInvariants_lift (H : Subgroup G)) y, ?_, ?_⟩
    · refine (continuous_iff_exists_openNormalSubgroup A _).2 ⟨H, fun g h hh => ?_⟩
      have : (QuotientGroup.mk' (H : Subgroup G)) (g * h) = (QuotientGroup.mk' (H : Subgroup G)) g := by
        simp [(QuotientGroup.eq_one_iff h).2 hh]
      show (y (QuotientGroup.mk' (H : Subgroup G) (g * h)) : A) = (y (QuotientGroup.mk' (H : Subgroup G) g) : A)
      rw [this]
    · simp [H1π_comp_map_apply]

/-- Milne (pdf p. 114): for a profinite group and a discrete module, $H^1(G, M)$ is torsion (from 1.6). -/
@[kb "milne2006ec" "Ch. IV, §1, H^1(G, M) is torsion, pdf p. 114"]
theorem H1cont_torsion [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G]
    (A : Rep ℤ G) (hA : MilneCFT.IsDiscreteModule A) (x : H1 A) (hx : x ∈ H1cont A) :
    ∃ n : ℕ, 0 < n ∧ (n : ℤ) • x = 0 := by
  obtain ⟨H, z, rfl⟩ := (mem_H1cont_iff_exists_inflation A hA x).1 hx
  have hfin : Finite (G ⧸ (H : Subgroup G)) :=
    inferInstanceAs (Finite (G ⧸ H.toOpenSubgroup.toSubgroup))
  refine ⟨Nat.card (G ⧸ (H : Subgroup G)), Nat.card_pos, ?_⟩
  have hz := prop_1_6 (A.quotientToInvariants (H : Subgroup G)) z
  have := congrArg (H1InfRes A (H : Subgroup G)).f.hom hz
  rw [map_zsmul, map_zero] at this
  exact this

/-- **Example 1.8 (c)** (pdf p. 115).  If $G$ acts trivially on the discrete module $M$, then $H^1(G, M)$ is the
group of continuous homomorphisms $G \to M$: under `example_1_2_trivialH1`, the continuous classes are the continuous
homomorphisms. -/
@[kb "milne2006ec" "Ch. IV, Example 1.8 (c), pdf p. 115"]
theorem example_1_8_c (A : Rep ℤ G) [A.IsTrivial] (x : H1 A) :
    x ∈ H1cont A ↔ @Continuous G A _ ⊥ (fun g => (example_1_2_trivialH1 A).hom x (Additive.ofMul g)) := by
  constructor
  · rintro ⟨f, hf, rfl⟩
    have : (fun g : G => (example_1_2_trivialH1 A).hom (H1π A f) (Additive.ofMul g)) = (f : G → A) := by
      funext g
      exact H1IsoOfIsTrivial_H1π_apply_apply f (Additive.ofMul g)
    show @Continuous G A _ ⊥ (fun g : G => (example_1_2_trivialH1 A).hom (H1π A f) (Additive.ofMul g))
    rw [this]
    exact hf
  · intro h
    induction x using H1_induction_on with | h f =>
    have : (fun g : G => (example_1_2_trivialH1 A).hom (H1π A f) (Additive.ofMul g)) = (f : G → A) := by
      funext g
      exact H1IsoOfIsTrivial_H1π_apply_apply f (Additive.ofMul g)
    rw [this] at h
    exact ⟨f, h, rfl⟩

/-- Example 1.8 (c) (pdf p. 115): the kernel of a continuous homomorphism $G \to M$ to a discrete group is open. -/
@[kb "milne2006ec" "Ch. IV, Example 1.8 (c), pdf p. 115"]
theorem example_1_8_c_ker_isOpen [IsTopologicalGroup G] {M : Type} [AddCommGroup M] (α : Additive G →+ M)
    (hα : @Continuous G M _ ⊥ (fun g => α (Additive.ofMul g))) :
    IsOpen {g : G | α (Additive.ofMul g) = 0} := by
  let _ : TopologicalSpace M := ⊥
  have _ : DiscreteTopology M := ⟨rfl⟩
  exact (isOpen_discrete ({0} : Set M)).preimage hα

end Profinite

section Kummer

variable (k : Type) [Field k] [PerfectField k]

/-- Hilbert's Theorem 90 for a cocycle that is constant on the cosets of an open normal subgroup: it factors
through the finite Galois group of the fixed field of that subgroup. -/
theorem hilbert90_of_locally_constant {K L : Type} [Field K] [Field L] [Algebra K L] [IsGalois K L]
    (f : (L ≃ₐ[K] L) → Lˣ) (hf : IsMulCocycle₁ f) (H : Subgroup (L ≃ₐ[K] L)) [H.Normal]
    (hHopen : IsOpen (H : Set (L ≃ₐ[K] L)))
    (hH : ∀ g h, h ∈ H → f (g * h) = f g) : IsMulCoboundary₁ f := by
  classical
  let E := IntermediateField.fixedField H
  have hfix : E.fixingSubgroup = H :=
    InfiniteGalois.fixingSubgroup_fixedField ⟨H, Subgroup.isClosed_of_isOpen H hHopen⟩
  have hE : FiniteDimensional K E ∧ IsGalois K E := by
    refine (InfiniteGalois.isOpen_and_normal_iff_finite_and_isGalois E).1 ⟨?_, ?_⟩
    · rw [hfix]; exact hHopen
    · rw [hfix]; infer_instance
  obtain ⟨hfd, hgal⟩ := hE
  let res : (L ≃ₐ[K] L) →* (E ≃ₐ[K] E) := AlgEquiv.restrictNormalHom E
  have hsurj : Function.Surjective res := AlgEquiv.restrictNormalHom_surjective L (K₁ := E)
  have hker : ∀ g g' : L ≃ₐ[K] L, res g = res g' → g⁻¹ * g' ∈ H := by
    intro g g' h
    rw [← hfix, ← E.restrictNormalHom_ker]
    rw [MonoidHom.mem_ker, map_mul, map_inv, ← h, inv_mul_cancel]
  have hwd : ∀ g g' : L ≃ₐ[K] L, res g = res g' → f g = f g' := by
    intro g g' h
    have := hH g (g⁻¹ * g') (hker g g' h)
    rw [mul_inv_cancel_left] at this
    exact this.symm
  have hone : f 1 = 1 := by
    have := hf 1 1
    simpa using this
  have hmem : ∀ g, ((f g : Lˣ) : L) ∈ E := by
    intro g
    rw [IntermediateField.mem_fixedField_iff]
    intro h hh
    have h1 : f (h * g) = h • f g * f h := hf h g
    have h2 : f h = 1 := by
      have := hH 1 h hh
      rwa [one_mul, hone] at this
    have h3 : f (h * g) = f g := by
      have := hH g (g⁻¹ * h * g) (by
        have := Subgroup.Normal.conj_mem ‹H.Normal› h hh g⁻¹
        simpa [mul_assoc] using this)
      rw [show g * (g⁻¹ * h * g) = h * g by group] at this
      exact this
    rw [h2, mul_one, h3] at h1
    have := congrArg Units.val h1
    exact this.symm
  have hne : ∀ g, (⟨((f g : Lˣ) : L), hmem g⟩ : E) ≠ 0 := fun g h => by
    have := congrArg Subtype.val h
    exact (f g).ne_zero this
  let F : (E ≃ₐ[K] E) → Eˣ := fun τ => Units.mk0 _ (hne (Function.surjInv hsurj τ))
  have hFeq : ∀ g, (((F (res g) : Eˣ) : E) : L) = ((f g : Lˣ) : L) := by
    intro g
    have h1 : res (Function.surjInv hsurj (res g)) = res g := Function.surjInv_eq hsurj _
    show ((f (Function.surjInv hsurj (res g)) : Lˣ) : L) = _
    rw [hwd _ _ h1]
  have hcomm : ∀ (g : L ≃ₐ[K] L) (x : E), ((res g x : E) : L) = g (x : L) := fun g x =>
    AlgEquiv.restrictNormal_commutes g E x
  have hF : IsMulCocycle₁ F := by
    intro τ σ
    obtain ⟨g, rfl⟩ := hsurj τ
    obtain ⟨g', rfl⟩ := hsurj σ
    apply Units.ext
    apply Subtype.ext
    rw [← map_mul, hFeq, hf g g']
    show _ = ((res g (F (res g') : E) : E) : L) * _
    rw [hcomm, hFeq, hFeq]
    rfl
  obtain ⟨β, hβ⟩ := isMulCoboundary₁_of_isMulCocycle₁_of_aut_to_units F hF
  refine ⟨Units.map (algebraMap E L : E →* L) β, fun g => ?_⟩
  apply Units.ext
  have h1 := hβ (res g)
  have h2 : ((F (res g) : Eˣ) : E) = ((res g • β / β : Eˣ) : E) := by rw [h1]
  have h3 := congrArg (fun x : E => (x : L)) h2
  simp only [hFeq] at h3
  rw [h3]
  have e1 : ((g • Units.map (algebraMap E L : E →* L) β : Lˣ) : L) = g ((β : E) : L) := rfl
  have e2 : (((res g • β : Eˣ) : E) : L) = ((res g (β : E) : E) : L) := rfl
  have e3 : ((Units.map (algebraMap E L : E →* L) β : Lˣ) : L) = ((β : E) : L) := rfl
  rw [Units.val_div_eq_div_val, Units.val_div_eq_div_val, e1, e3]
  push_cast
  rw [e2, hcomm]

/-- **Example 1.8 (a)** (pdf p. 114).  For a perfect field $k$, $H^1(G, (k^{\mathrm{al}})^\times) = 0$, where
$G = \operatorname{Gal}(k^{\mathrm{al}}/k)$ (from Hilbert's Theorem 90 by passing to the limit). -/
@[kb "milne2006ec" "Ch. IV, Example 1.8 (a), pdf p. 114"]
theorem example_1_8_a : H1cont (Rep.ofAlgebraAutOnUnits k (AlgebraicClosure k)) = ⊥ := by
  refine eq_bot_iff.2 ?_
  rintro x ⟨f, hf, rfl⟩
  obtain ⟨H, hH⟩ := (continuous_iff_exists_openNormalSubgroup _ f).1 hf
  have hcoc : IsMulCocycle₁ (G := AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) (M := (AlgebraicClosure k)ˣ) (fun g => Additive.toMul ((f.1 : _ → Additive (AlgebraicClosure k)ˣ) g)) :=
    isMulCocycle₁_of_mem_cocycles₁ (G := AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
      (M := (AlgebraicClosure k)ˣ) _ f.2
  obtain ⟨β, hβ⟩ := hilbert90_of_locally_constant _ hcoc H.toSubgroup H.isOpen
    (fun g h hh => congrArg Additive.toMul (hH g h hh))
  have h0 : H1π (Rep.ofAlgebraAutOnUnits k (AlgebraicClosure k)) f = 0 :=
    (H1π_eq_zero_iff _).2 (coboundariesOfIsMulCoboundary₁ (G := AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
      (M := (AlgebraicClosure k)ˣ)
      (f := fun g => Additive.toMul ((f.1 : _ → Additive (AlgebraicClosure k)ˣ) g)) ⟨β, hβ⟩).2
  exact h0

/-- The group $\mu_n(k^{\mathrm{al}})$ of $n$-th roots of 1, a subgroup of $(k^{\mathrm{al}})^\times$ stable under
$\operatorname{Gal}(k^{\mathrm{al}}/k)$ (pdf p. 114). -/
noncomputable def rootsOfUnityRepresentation (n : ℕ) :
    Representation ℤ (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k)
      (Additive (rootsOfUnity n (AlgebraicClosure k))) where
  toFun σ :=
    { toFun := fun ζ => Additive.ofMul ⟨σ • ((Additive.toMul ζ : rootsOfUnity n (AlgebraicClosure k)) : (AlgebraicClosure k)ˣ), by
        rw [mem_rootsOfUnity, ← smul_pow']
        have h := (mem_rootsOfUnity _ _).1 (Additive.toMul ζ).2
        rw [h]
        exact smul_one σ⟩
      map_add' := by
        intro a b
        apply Additive.toMul.injective
        apply Subtype.ext
        exact smul_mul' σ _ _
      map_smul' := by
        intro m a
        apply Additive.toMul.injective
        apply Subtype.ext
        simp only [RingHom.id_apply]
        exact (smul_zpow' σ (((Additive.toMul a : rootsOfUnity n (AlgebraicClosure k)) : (AlgebraicClosure k)ˣ)) m)
        }
  map_one' := by
    refine LinearMap.ext fun ζ => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    exact one_smul _ _
  map_mul' σ τ := by
    refine LinearMap.ext fun ζ => ?_
    apply Additive.toMul.injective
    apply Subtype.ext
    exact mul_smul σ τ _

/-- $\mu_n(k^{\mathrm{al}})$ as a $\operatorname{Gal}(k^{\mathrm{al}}/k)$-module. -/
noncomputable abbrev rootsOfUnityRep (n : ℕ) : Rep ℤ (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) :=
  Rep.of (rootsOfUnityRepresentation k n)

/-- The inclusion $k^\times \to (k^{\mathrm{al}})^\times$. -/
noncomputable abbrev unitsIncl : kˣ →* (AlgebraicClosure k)ˣ :=
  Units.map (algebraMap k (AlgebraicClosure k)).toMonoidHom

theorem smul_unitsIncl (a : kˣ) (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) :
    σ • unitsIncl k a = unitsIncl k a :=
  Units.ext (σ.commutes (a : k))

theorem unitsIncl_injective : Function.Injective (unitsIncl k) :=
  Units.map_injective (algebraMap k (AlgebraicClosure k)).injective

/-- Every unit of $k$ has an $n$-th root in $(k^{\mathrm{al}})^\times$. -/
theorem exists_pow_eq_unitsIncl (n : ℕ) (hn : 0 < n) (a : kˣ) :
    ∃ α : (AlgebraicClosure k)ˣ, α ^ n = unitsIncl k a := by
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (algebraMap k (AlgebraicClosure k) (a : k)) hn
  have hz0 : z ≠ 0 := by
    rintro rfl
    rw [zero_pow hn.ne'] at hz
    exact (unitsIncl k a).ne_zero hz.symm
  exact ⟨Units.mk0 z hz0, Units.ext (by simpa using hz)⟩

theorem fixed_pow_of_pow_eq (n : ℕ) (α : (AlgebraicClosure k)ˣ) (a : kˣ) (h : α ^ n = unitsIncl k a) :
    ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n := by
  intro σ
  rw [h]
  exact smul_unitsIncl k a σ

/-- The function $\sigma \mapsto \sigma(\alpha)/\alpha$ with values in $\mu_n(k^{\mathrm{al}})$, attached to a unit
$\alpha$ of $k^{\mathrm{al}}$ whose $n$-th power is fixed by the Galois group (the Kummer cocycle). -/
noncomputable def kummerFun (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n)
    (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) : Additive (rootsOfUnity n (AlgebraicClosure k)) :=
  Additive.ofMul (⟨σ • α / α, by
      rw [mem_rootsOfUnity, div_pow, ← smul_pow', hα σ, div_self']⟩ :
        rootsOfUnity n (AlgebraicClosure k))

theorem kummerFun_mem (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n) :
    kummerFun k n α hα ∈ cocycles₁ (rootsOfUnityRep k n) := by
  rw [mem_cocycles₁_iff]
  intro g h
  apply Additive.toMul.injective
  apply Subtype.ext
  show (g * h) • α / α = g • (h • α / α) * (g • α / α)
  rw [mul_smul, smul_div']
  simp only [div_eq_mul_inv]
  group

/-- The Kummer cocycle as an element of the group of crossed homomorphisms. -/
noncomputable def kummerCocycle (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n) :
    cocycles₁ (rootsOfUnityRep k n) :=
  ⟨kummerFun k n α hα, kummerFun_mem k n α hα⟩

theorem kummerCocycle_apply (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n)
    (σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) :
    ((Additive.toMul ((kummerCocycle k n α hα : cocycles₁ (rootsOfUnityRep k n)) σ) :
      rootsOfUnity n (AlgebraicClosure k)) : (AlgebraicClosure k)ˣ) = σ • α / α := rfl

/-- A function on a topological group, constant on the cosets of an open subgroup, is continuous for the
discrete topology on its target. -/
theorem continuous_of_openSubgroup {G X : Type} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
    [TopologicalSpace X] [DiscreteTopology X] (f : G → X) (U : OpenSubgroup G)
    (h : ∀ g, ∀ u ∈ U, f (g * u) = f g) : Continuous f := by
  rw [continuous_discrete_rng]
  intro b
  rw [isOpen_iff_mem_nhds]
  intro g hg
  have hopen : IsOpen {x : G | g⁻¹ * x ∈ (U : Set G)} :=
    U.isOpen.preimage (continuous_const.mul continuous_id)
  refine Filter.mem_of_superset (hopen.mem_nhds (by simp)) fun x hx => ?_
  have := h g (g⁻¹ * x) hx
  simp only [mul_inv_cancel_left] at this
  simp only [Set.mem_preimage, Set.mem_singleton_iff] at hg ⊢
  rw [this, hg]

theorem kummerCocycle_mem_contCocycles₁ (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n) :
    kummerCocycle k n α hα ∈ contCocycles₁ (rootsOfUnityRep k n) := by
  obtain ⟨U, hU⟩ := exists_openSubgroup_fixing (K := k) (L := AlgebraicClosure k) {(α : AlgebraicClosure k)}
    (Set.toFinite _)
  let _ : TopologicalSpace (rootsOfUnityRep k n) := ⊥
  have _ : DiscreteTopology (rootsOfUnityRep k n) := ⟨rfl⟩
  show Continuous (kummerFun k n α hα)
  refine continuous_of_openSubgroup _ U fun g u hu => ?_
  apply Additive.toMul.injective
  apply Subtype.ext
  show (g * u) • α / α = g • α / α
  have : u • α = α := Units.ext (hU u hu _ (by simp))
  rw [mul_smul, this]

theorem kummerCocycle_mul (n : ℕ) (α β : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n)
    (hβ : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • β ^ n = β ^ n)
    (hαβ : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • (α * β) ^ n = (α * β) ^ n) :
    kummerCocycle k n (α * β) hαβ = kummerCocycle k n α hα + kummerCocycle k n β hβ := by
  apply cocycles₁_ext
  intro σ
  apply Additive.toMul.injective
  apply Subtype.ext
  show σ • (α * β) / (α * β) = (σ • α / α) * (σ • β / β)
  rw [smul_mul', div_mul_div_comm]

theorem H1π_kummerCocycle_root (n : ℕ) (ζ : (AlgebraicClosure k)ˣ) (hζ : ζ ^ n = 1)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • ζ ^ n = ζ ^ n) :
    H1π (rootsOfUnityRep k n) (kummerCocycle k n ζ hα) = 0 := by
  rw [H1π_eq_zero_iff]
  refine ⟨Additive.ofMul (⟨ζ, (mem_rootsOfUnity _ _).2 hζ⟩ : rootsOfUnity n (AlgebraicClosure k)), ?_⟩
  funext σ
  apply Additive.toMul.injective
  apply Subtype.ext
  rfl

theorem exists_root_of_H1π_kummerCocycle_eq_zero (n : ℕ) (α : (AlgebraicClosure k)ˣ)
    (hα : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • α ^ n = α ^ n)
    (h : H1π (rootsOfUnityRep k n) (kummerCocycle k n α hα) = 0) :
    ∃ ζ : (AlgebraicClosure k)ˣ, ζ ^ n = 1 ∧ ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k,
      σ • (α / ζ) = α / ζ := by
  rw [H1π_eq_zero_iff] at h
  obtain ⟨m, hm⟩ := h
  refine ⟨((Additive.toMul m : rootsOfUnity n (AlgebraicClosure k)) : (AlgebraicClosure k)ˣ),
    (mem_rootsOfUnity _ _).1 (Additive.toMul m).2, fun σ => ?_⟩
  have h1 := congrFun hm σ
  rw [d₀₁_hom_apply] at h1
  have h2 := congrArg (fun x => ((Additive.toMul x : rootsOfUnity n (AlgebraicClosure k)) :
    (AlgebraicClosure k)ˣ)) h1
  set ζ : (AlgebraicClosure k)ˣ := ((Additive.toMul m : rootsOfUnity n (AlgebraicClosure k)) :
    (AlgebraicClosure k)ˣ) with hζdef
  have h3 : σ • ζ / ζ = σ • α / α := h2
  rw [smul_div', div_eq_div_iff_mul_eq_mul]
  rw [div_eq_div_iff_mul_eq_mul] at h3
  rw [mul_comm α]
  exact h3.symm

/-- The Kummer class of $a \in k^\times$: the class of the cocycle $\sigma \mapsto \sigma(\alpha)/\alpha$ for an
$n$-th root $\alpha$ of $a$ (the choice does not matter: `kummerClass_eq`). -/
noncomputable def kummerClass (n : ℕ) (hn : 0 < n) (a : kˣ) : H1 (rootsOfUnityRep k n) :=
  H1π (rootsOfUnityRep k n) (kummerCocycle k n (Classical.choose (exists_pow_eq_unitsIncl k n hn a))
    (fixed_pow_of_pow_eq k n _ a (Classical.choose_spec (exists_pow_eq_unitsIncl k n hn a))))

theorem kummerClass_eq (n : ℕ) (hn : 0 < n) (a : kˣ) (α : (AlgebraicClosure k)ˣ) (h : α ^ n = unitsIncl k a) :
    kummerClass k n hn a = H1π (rootsOfUnityRep k n) (kummerCocycle k n α (fixed_pow_of_pow_eq k n α a h)) := by
  set α₀ := Classical.choose (exists_pow_eq_unitsIncl k n hn a) with hα₀
  have h₀ : α₀ ^ n = unitsIncl k a := Classical.choose_spec (exists_pow_eq_unitsIncl k n hn a)
  have hζ : (α₀⁻¹ * α) ^ n = 1 := by
    rw [mul_pow, inv_pow, h₀, h, inv_mul_cancel]
  have hαeq : α = α₀ * (α₀⁻¹ * α) := by group
  have hζfix : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • (α₀⁻¹ * α) ^ n = (α₀⁻¹ * α) ^ n := by
    intro σ; rw [hζ]; exact smul_one σ
  have hmul : kummerCocycle k n α (fixed_pow_of_pow_eq k n α a h) =
      kummerCocycle k n α₀ (fixed_pow_of_pow_eq k n α₀ a h₀) + kummerCocycle k n (α₀⁻¹ * α) hζfix := by
    have := kummerCocycle_mul k n α₀ (α₀⁻¹ * α) (fixed_pow_of_pow_eq k n α₀ a h₀) hζfix
      (by rw [← hαeq]; exact fixed_pow_of_pow_eq k n α a h)
    convert this using 2
  rw [hmul, map_add, H1π_kummerCocycle_root k n _ hζ hζfix, add_zero]
  rfl

theorem kummerClass_mem (n : ℕ) (hn : 0 < n) (a : kˣ) :
    kummerClass k n hn a ∈ H1cont (rootsOfUnityRep k n) :=
  ⟨_, kummerCocycle_mem_contCocycles₁ k n _ _, rfl⟩

theorem kummerClass_one (n : ℕ) (hn : 0 < n) : kummerClass k n hn 1 = 0 := by
  rw [kummerClass_eq k n hn 1 1 (by simp)]
  exact H1π_kummerCocycle_root k n 1 (one_pow n) _

theorem kummerClass_mul (n : ℕ) (hn : 0 < n) (a b : kˣ) :
    kummerClass k n hn (a * b) = kummerClass k n hn a + kummerClass k n hn b := by
  obtain ⟨α, hα⟩ := exists_pow_eq_unitsIncl k n hn a
  obtain ⟨β, hβ⟩ := exists_pow_eq_unitsIncl k n hn b
  have hαβ : (α * β) ^ n = unitsIncl k (a * b) := by rw [mul_pow, hα, hβ, map_mul]
  rw [kummerClass_eq k n hn _ _ hαβ, kummerClass_eq k n hn a α hα, kummerClass_eq k n hn b β hβ,
    ← map_add, kummerCocycle_mul k n α β (fixed_pow_of_pow_eq k n α a hα) (fixed_pow_of_pow_eq k n β b hβ)]

theorem mem_range_pow_of_kummerClass_eq_zero (n : ℕ) (hn : 0 < n) (a : kˣ) (h : kummerClass k n hn a = 0) :
    a ∈ (powMonoidHom (α := kˣ) n).range := by
  obtain ⟨α, hα⟩ := exists_pow_eq_unitsIncl k n hn a
  rw [kummerClass_eq k n hn a α hα] at h
  obtain ⟨ζ, hζ, hfix⟩ := exists_root_of_H1π_kummerCocycle_eq_zero k n α _ h
  obtain ⟨y, hy⟩ := (units_fixed_iff (K := k) (L := AlgebraicClosure k) (α / ζ)).1 (fun σ => by
    have := hfix σ
    exact congrArg Units.val this)
  refine ⟨y, ?_⟩
  apply unitsIncl_injective k
  show unitsIncl k (y ^ n) = unitsIncl k a
  rw [map_pow, ← hα]
  have hy' : unitsIncl k y = α / ζ := Units.ext hy
  rw [hy', div_pow, hζ, div_one]

theorem kummerClass_eq_zero_of_mem_range_pow (n : ℕ) (hn : 0 < n) (a : kˣ)
    (h : a ∈ (powMonoidHom (α := kˣ) n).range) : kummerClass k n hn a = 0 := by
  obtain ⟨y, rfl⟩ := h
  have hy : (unitsIncl k y) ^ n = unitsIncl k ((powMonoidHom (α := kˣ) n) y) := by
    rw [← map_pow]; rfl
  rw [kummerClass_eq k n hn _ _ hy]
  have : kummerCocycle k n (unitsIncl k y) (fixed_pow_of_pow_eq k n _ _ hy) = 0 := by
    apply cocycles₁_ext
    intro σ
    apply Additive.toMul.injective
    apply Subtype.ext
    show σ • unitsIncl k y / unitsIncl k y = 1
    rw [smul_unitsIncl, div_self']
  rw [this, map_zero]

theorem exists_kummerClass_eq_of_mem_H1cont (n : ℕ) (hn : 0 < n) (x : H1 (rootsOfUnityRep k n))
    (hx : x ∈ H1cont (rootsOfUnityRep k n)) : ∃ a : kˣ, kummerClass k n hn a = x := by
  obtain ⟨f, hf, rfl⟩ := hx
  obtain ⟨H, hH⟩ := (continuous_iff_exists_openNormalSubgroup _ f).1 hf
  let Fl : (AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k) → (AlgebraicClosure k)ˣ := fun σ =>
    ((Additive.toMul ((f : cocycles₁ (rootsOfUnityRep k n)) σ) : rootsOfUnity n (AlgebraicClosure k)) :
      (AlgebraicClosure k)ˣ)
  have hcoc : IsMulCocycle₁ Fl := by
    intro g h
    have := (mem_cocycles₁_iff (A := rootsOfUnityRep k n) f.1).1 f.2 g h
    exact congrArg (fun y => ((Additive.toMul y : rootsOfUnity n (AlgebraicClosure k)) :
      (AlgebraicClosure k)ˣ)) this
  obtain ⟨β, hβ⟩ := hilbert90_of_locally_constant Fl hcoc H.toSubgroup H.isOpen
    (fun g h hh => congrArg (fun y => ((Additive.toMul y : rootsOfUnity n (AlgebraicClosure k)) :
      (AlgebraicClosure k)ˣ)) (hH g h hh))
  have hFl : ∀ σ, Fl σ ^ n = 1 := fun σ =>
    (mem_rootsOfUnity _ _).1 (Additive.toMul ((f : cocycles₁ (rootsOfUnityRep k n)) σ)).2
  have hfix : ∀ σ : AlgebraicClosure k ≃ₐ[k] AlgebraicClosure k, σ • β ^ n = β ^ n := by
    intro σ
    have h1 := hFl σ
    rw [← hβ σ, div_pow, div_eq_one] at h1
    rw [smul_pow']
    exact h1
  obtain ⟨a, ha⟩ := (units_fixed_iff (K := k) (L := AlgebraicClosure k) (β ^ n)).1
    (fun σ => congrArg Units.val (hfix σ))
  have hβa : β ^ n = unitsIncl k a := Units.ext ha.symm
  refine ⟨a, ?_⟩
  rw [kummerClass_eq k n hn a β hβa]
  have hkf : kummerCocycle k n β (fixed_pow_of_pow_eq k n β a hβa) = f := by
    apply cocycles₁_ext
    intro σ
    apply Additive.toMul.injective
    apply Subtype.ext
    exact hβ σ
  rw [hkf]
  rfl

/-- **Example 1.8 (b)** (pdf p. 114).  For a perfect field $k$ and $n \ge 1$ the Kummer sequence gives an isomorphism
$H^1(G, \mu_n(k^{\mathrm{al}})) \cong k^\times / k^{\times n}$.  Stated as the existence of an isomorphism; Milne's
canonical one sends $a \in k^\times$ to the class of $\sigma \mapsto \sigma(\alpha)/\alpha$ with $\alpha^n = a$. -/
@[kb "milne2006ec" "Ch. IV, Example 1.8 (b), pdf p. 114"]
theorem example_1_8_b (n : ℕ) (hn : 0 < n) :
    Nonempty (H1cont (rootsOfUnityRep k n) ≃+ Additive (kˣ ⧸ (powMonoidHom (α := kˣ) n).range)) := by
  let φ : kˣ →* Multiplicative (H1cont (rootsOfUnityRep k n)) :=
    { toFun := fun a => Multiplicative.ofAdd ⟨kummerClass k n hn a, kummerClass_mem k n hn a⟩
      map_one' := by
        apply Multiplicative.toAdd.injective
        exact Subtype.ext (kummerClass_one k n hn)
      map_mul' := fun a b => by
        apply Multiplicative.toAdd.injective
        exact Subtype.ext (kummerClass_mul k n hn a b) }
  have hle : (powMonoidHom (α := kˣ) n).range ≤ φ.ker := by
    intro a ha
    rw [MonoidHom.mem_ker]
    apply Multiplicative.toAdd.injective
    exact Subtype.ext (kummerClass_eq_zero_of_mem_range_pow k n hn a ha)
  let bar := QuotientGroup.lift (powMonoidHom (α := kˣ) n).range φ hle
  let f : Additive (kˣ ⧸ (powMonoidHom (α := kˣ) n).range) →+ H1cont (rootsOfUnityRep k n) :=
    { toFun := fun x => Multiplicative.toAdd (bar (Additive.toMul x))
      map_zero' := by
        show Multiplicative.toAdd (bar 1) = 0
        rw [map_one]; rfl
      map_add' := fun x y => by
        show Multiplicative.toAdd (bar (Additive.toMul x * Additive.toMul y)) = _
        rw [map_mul]; rfl }
  have hinj : Function.Injective f := by
    rw [injective_iff_map_eq_zero]
    intro x hx
    induction x using Additive.rec with | _ q =>
    induction q using QuotientGroup.induction_on with | _ a =>
    have h0 : kummerClass k n hn a = 0 := congrArg Subtype.val hx
    have := mem_range_pow_of_kummerClass_eq_zero k n hn a h0
    show Additive.ofMul (QuotientGroup.mk a) = 0
    rw [← ofMul_one, (QuotientGroup.eq_one_iff a).2 this]
  have hsurj : Function.Surjective f := by
    rintro ⟨y, hy⟩
    obtain ⟨a, ha⟩ := exists_kummerClass_eq_of_mem_H1cont k n hn y hy
    exact ⟨Additive.ofMul (QuotientGroup.mk a), Subtype.ext ha⟩
  exact ⟨(AddEquiv.ofBijective f ⟨hinj, hsurj⟩).symm⟩

open IsDedekindDomain NumberField in
/-- A number field has infinitely many nonzero prime ideals in its ring of integers. -/
theorem infinite_heightOneSpectrum (K : Type) [Field K] [NumberField K] :
    Infinite (HeightOneSpectrum (𝓞 K)) := by
  have hprimes : Infinite {p : ℕ // p.Prime} := Nat.infinite_setOfPred_prime.to_subtype
  have key : ∀ p : {p : ℕ // p.Prime}, ∃ Q : Ideal (𝓞 K), Q.IsPrime ∧
      Q.under ℤ = Ideal.span {(p.1 : ℤ)} := by
    intro p
    have : (Ideal.span {(p.1 : ℤ)}).IsPrime :=
      (Ideal.span_singleton_prime (by exact_mod_cast p.2.ne_zero)).2 (Nat.prime_iff_prime_int.1 p.2)
    obtain ⟨Q, -, hQ, hQp⟩ := Ideal.exists_ideal_over_prime_of_isIntegral
      (S := 𝓞 K) (Ideal.span {(p.1 : ℤ)}) (⊥ : Ideal (𝓞 K)) (by
        intro x hx
        simp only [Ideal.under, Ideal.mem_comap, Ideal.mem_bot] at hx
        have : x = 0 := by
          have := RingHom.injective_int (algebraMap ℤ (𝓞 K)) (hx.trans (map_zero _).symm)
          exact this
        rw [this]; exact Ideal.zero_mem _)
    exact ⟨Q, hQ, hQp⟩
  choose Q hQ hQu using key
  have hne : ∀ p, Q p ≠ ⊥ := by
    intro p h
    have := hQu p
    rw [h] at this
    have h2 : (p.1 : ℤ) ∈ Ideal.under ℤ (⊥ : Ideal (𝓞 K)) := by
      rw [this]; exact Ideal.mem_span_singleton_self _
    simp only [Ideal.under, Ideal.mem_comap, Ideal.mem_bot] at h2
    have : ((p.1 : ℤ) : 𝓞 K) = 0 := h2
    have h3 : (p.1 : ℤ) = 0 := by exact_mod_cast this
    exact p.2.ne_zero (by exact_mod_cast h3)
  refine Infinite.of_injective (fun p => (⟨Q p, hQ p, hne p⟩ : HeightOneSpectrum (𝓞 K))) ?_
  intro p q h
  have h1 : Q p = Q q := congrArg HeightOneSpectrum.asIdeal h
  have h2 : Ideal.span {(p.1 : ℤ)} = Ideal.span {(q.1 : ℤ)} := by rw [← hQu p, ← hQu q, h1]
  have h3 : (p.1 : ℤ) ∣ q.1 := Ideal.span_singleton_le_span_singleton.1 h2.ge
  have h4 : p.1 ∣ q.1 := by exact_mod_cast h3
  exact Subtype.ext ((Nat.prime_dvd_prime_iff_eq p.2 q.2).1 h4)

open IsDedekindDomain NumberField in
/-- Example 1.8 (b) (pdf p. 115): for a number field $k$ and $n > 1$, $k^\times/k^{\times n}$ is infinite. -/
@[kb "milne2006ec" "Ch. IV, Example 1.8 (b), k^×/k^×n is infinite for a number field, pdf p. 115"]
theorem example_1_8_b_infinite (K : Type) [Field K] [NumberField K] (n : ℕ) (hn : 1 < n) :
    Infinite (Kˣ ⧸ (powMonoidHom (α := Kˣ) n).range) := by
  by_contra hcon
  have hfin : Finite (Kˣ ⧸ (powMonoidHom (α := Kˣ) n).range) := not_infinite_iff_finite.1 hcon
  classical
  let R : Set Kˣ := Set.range (fun q : Kˣ ⧸ (powMonoidHom (α := Kˣ) n).range => Quotient.out q)
  have hR : R.Finite := Set.finite_range _
  let bad : Set (HeightOneSpectrum (𝓞 K)) := ⋃ r ∈ R,
    (HeightOneSpectrum.Support (𝓞 K) (r : K) ∪ HeightOneSpectrum.Support (𝓞 K) ((r⁻¹ : Kˣ) : K))
  have hbad : bad.Finite := hR.biUnion fun r _ =>
    (HeightOneSpectrum.Support.finite _ _).union (HeightOneSpectrum.Support.finite _ _)
  have := infinite_heightOneSpectrum K
  obtain ⟨v, -, hv⟩ := (Set.infinite_univ.sdiff hbad).nonempty
  obtain ⟨π, hπ⟩ := v.valuation_exists_uniformizer K
  have hπ0 : π ≠ 0 := by
    rintro rfl
    rw [map_zero] at hπ
    exact (by simp : WithZero.exp (-1 : ℤ) ≠ 0) hπ.symm
  let u : Kˣ := Units.mk0 π hπ0
  let r : Kˣ := Quotient.out (QuotientGroup.mk u : Kˣ ⧸ (powMonoidHom (α := Kˣ) n).range)
  have hrR : r ∈ R := ⟨_, rfl⟩
  have hr1 : v.valuation K (r : K) = 1 := by
    have h1 : ¬ 1 < v.valuation K (r : K) := fun h =>
      hv (Set.mem_iUnion₂.2 ⟨r, hrR, Or.inl h⟩)
    have h2 : ¬ 1 < v.valuation K ((r⁻¹ : Kˣ) : K) := fun h =>
      hv (Set.mem_iUnion₂.2 ⟨r, hrR, Or.inr h⟩)
    have h3 : v.valuation K ((r⁻¹ : Kˣ) : K) = (v.valuation K (r : K))⁻¹ := by
      rw [Units.val_inv_eq_inv_val, map_inv₀]
    rw [h3] at h2
    have hr0 : v.valuation K (r : K) ≠ 0 := by
      simpa using r.ne_zero
    push Not at h1 h2
    have h4 : 1 ≤ v.valuation K (r : K) := by
      by_contra hlt
      push Not at hlt
      have := one_lt_inv_iff₀.2 ⟨zero_lt_iff.2 hr0, hlt⟩
      exact absurd this (not_lt.2 h2)
    exact le_antisymm h1 h4
  have hq : (QuotientGroup.mk r : Kˣ ⧸ (powMonoidHom (α := Kˣ) n).range) = QuotientGroup.mk u :=
    Quotient.out_eq' _
  obtain ⟨y, hy⟩ := (QuotientGroup.eq).1 hq
  have hu : π = (r : K) * (y : K) ^ n := by
    have : (y ^ n : Kˣ) = r⁻¹ * u := hy
    have h2 : u = r * y ^ n := by rw [this]; group
    have := congrArg Units.val h2
    simpa [u] using this
  have h5 := congrArg (fun x => WithZero.log (v.valuation K x)) hu
  simp only [hπ, map_mul, map_pow, hr1, one_mul, WithZero.log_exp, WithZero.log_pow] at h5
  have : (n : ℤ) ∣ 1 := ⟨-WithZero.log (v.valuation K (y : K)), by simp [nsmul_eq_mul] at h5; linarith⟩
  have : n = 1 := by exact_mod_cast Int.eq_one_of_dvd_one (by positivity) this
  omega


end Kummer

