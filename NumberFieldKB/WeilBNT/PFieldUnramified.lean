import NumberFieldKB.WeilBNT.PFieldStructure
import NumberFieldKB.WeilBNT.PFieldLattices
import Mathlib.FieldTheory.Finite.GaloisField
import Mathlib.FieldTheory.Galois.Basic
import Mathlib.NumberTheory.Cyclotomic.Basic

/-!
# Weil, *Basic Number Theory*, I.§4, Cor. 2–4 of Thm. 7 and Def. 5: unramified extensions

$K$ is a commutative $p$-field with module $q$ (`pq hK`), and $K'$ a division algebra of finite dimension over $K$
with its natural topology (any Hausdorff topology making it a topological division ring and a topological vector space
over $K$); by Cor. 5 of Thm. 6 $K'$ is a $p$-field (`hK' : IsPField K' p`), and by Cor. 6 $q'=q^f$ and $[K':K]=ef$.
$K'$ is *unramified* over $K$ (Def. 4) if $e=1$, i.e. $q'=q^{[K':K]}$ (`IsUnramified`). `primeToPRoots p K'` is the
set of roots of $1$ in $K'$ of order prime to $p$.

* **`weil_I_4_cor2_thm7`**: Cor. 2. A (commutative) extension $K'$ of $K$ generated by roots of $1$ of order prime to
  $p$ is unramified and Galois over $K$, with cyclic Galois group generated by an automorphism $\varphi$ with
  $\varphi(\mu)=\mu^q$ for every root of $1$ $\mu$ of order prime to $p$ in $K'$.
* **`weil_I_4_def5`**: Def. 5 (the Frobenius automorphism). For $K'$ unramified over $K$ there is one and only one
  automorphism $\varphi$ of $K'$ over $K$ with $\varphi(\mu)=\mu^q$ on the roots of $1$ of order prime to $p$; it
  generates the Galois group.
* **`weil_I_4_cor3_thm7`**: Cor. 3, first assertion. A division algebra of finite dimension over $K$ is unramified if
  and only if it is commutative and generated over $K$ by roots of $1$ of order prime to $p$.
* **`weil_I_4_cor3_thm7_degree`**, **`weil_I_4_cor3_thm7_unique`**: Cor. 3, second assertion. An extension generated
  by a primitive $(q^f-1)$-th root of $1$ is unramified of degree $f$; two unramified extensions of $K$ of the same
  degree are isomorphic over $K$. (The existence of an unramified extension of each degree $f$, which needs the natural
  topology on an abstract finite extension of $K$, is not stated.)
* **`weil_I_4_cor4_thm7`**: Cor. 4. For a finite (commutative) extension $K'$ with modular degree $f$ and order of
  ramification $e$, the field $K_1$ generated by the roots of $1$ of order prime to $p$ in $K'$ is unramified of degree
  $f$ over $K$, $[K':K_1]=e$, and every unramified intermediate field is contained in $K_1$.

*Proof* (Weil's). The roots of $1$ of order prime to $p$ in $K'$ are the group $M'^\times$ of order $q'-1$ of Thm. 7,
and $M'$ is a set of representatives of $R'/P'$. An automorphism $\sigma$ over $K$ is continuous (Cor. 5 of Thm. 6),
preserves $R'$, $P'$, so induces an automorphism of the residue field $k'$ over $k$, which is $\xi\mapsto\xi^{q^s}$;
then $\sigma(\mu)=\mu^{q^s}$ on $M'^\times$. Hence the Galois group has at most $f$ elements; $[K':K]=ef\ge f$.
In the formalization the induced map $\sigma\mapsto\bar\sigma$ is an injective homomorphism of the Galois group into
the group of automorphisms of $k'$ over $k$ (cyclic of order $f$, generated by $\xi\mapsto\xi^q$); when it is
bijective the Frobenius automorphism is the preimage of $\xi\mapsto\xi^q$.
-/

open Topology Filter
open scoped NNReal

noncomputable section

set_option linter.unusedSectionVars false

namespace NumberFieldKB.WeilBNT.FieldModule

variable (p) in
/-- The roots of $1$ of order prime to $p$. -/
def primeToPRoots (L : Type*) [Monoid L] : Set L := {x | ∃ m : ℕ, 0 < m ∧ m.Coprime p ∧ x ^ m = 1}

variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalDivisionRing K]
  [LocallyCompactSpace K] [T2Space K] [(𝓝[≠] (0 : K)).NeBot] {p : ℕ}

section DivisionAlgebra

variable {D : Type*} [DivisionRing D] [Algebra K D] [FiniteDimensional K D] [TopologicalSpace D]
  [IsTopologicalDivisionRing D] [T2Space D] [ContinuousSMul K D] [LocallyCompactSpace D] [(𝓝[≠] (0 : D)).NeBot]

/-- Def. 4: $D$ is unramified over $K$ if $q_D=q^{[D:K]}$ (order of ramification $1$). -/
def IsUnramified (hK : IsPField K p) (hD : IsPField D p) : Prop := pq hD = pq hK ^ Module.finrank K D

end DivisionAlgebra

/-! ### Finite fields -/

/-- A group of automorphisms of a finite extension of finite fields over `k` has at most `f` elements, where
`|k'| = |k|^f`; if it has exactly `f` elements it is generated by the Frobenius `x ↦ x^|k|`. -/
theorem finite_field_aut_core {k k' : Type*} [Field k] [Field k'] [Finite k] [Finite k'] [Algebra k k']
    {f : ℕ} (hcard : Nat.card k' = Nat.card k ^ f)
    {H : Type*} [Group H] (ρ : H →* (k' ≃ₐ[k] k')) (hρ : Function.Injective ρ) :
    Nat.card H ≤ f ∧ (Nat.card H = f → ∃ h0 : H, (∀ x : k', ρ h0 x = x ^ Nat.card k) ∧
      ∀ h : H, h ∈ Subgroup.zpowers h0) := by
  classical
  have := Fintype.ofFinite k
  have := Fintype.ofFinite k'
  have hfr : Module.finrank k k' = f := by
    have h := Module.card_eq_pow_finrank (K := k) (V := k')
    rw [← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card] at h
    rw [hcard] at h
    exact (Nat.pow_right_injective (Finite.one_lt_card (α := k)) h).symm
  have hbij := FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow k k'
  rw [hfr] at hbij
  have hAut : Nat.card (k' ≃ₐ[k] k') = f := by
    rw [← Nat.card_congr (Equiv.ofBijective _ hbij)]
    simp
  have hfin : Finite (k' ≃ₐ[k] k') := Finite.of_surjective _ hbij.2
  refine ⟨hAut ▸ Nat.card_le_card_of_injective ρ hρ, fun hH => ?_⟩
  have hb : Function.Bijective ρ := hρ.bijective_of_nat_card_le (by rw [hAut, hH])
  obtain ⟨h0, hh0⟩ := hb.2 (FiniteField.frobeniusAlgEquivOfAlgebraic k k')
  refine ⟨h0, fun x => ?_, fun h => ?_⟩
  · rw [hh0, FiniteField.coe_frobeniusAlgEquivOfAlgebraic, Nat.card_eq_fintype_card]
  · obtain ⟨n, hn⟩ := hbij.2 (ρ h)
    refine ⟨(n.1 : ℤ), ?_⟩
    apply hρ
    simp [hn, hh0]

/-- The same, for a group of ring automorphisms of `k'` fixing the image of `κ : k → k'`. -/
theorem finite_field_aut_core' {k k' : Type*} [Field k] [Field k'] [Finite k] [Finite k'] (κ : k →+* k')
    {f : ℕ} (hcard : Nat.card k' = Nat.card k ^ f)
    {H : Type*} [Group H] (ρ : H →* RingAut k') (hfix : ∀ h x, ρ h (κ x) = κ x)
    (hρ : Function.Injective ρ) :
    Nat.card H ≤ f ∧ (Nat.card H = f → ∃ h0 : H, (∀ x : k', ρ h0 x = x ^ Nat.card k) ∧
      ∀ h : H, h ∈ Subgroup.zpowers h0) := by
  let _ : Algebra k k' := κ.toAlgebra
  let ρ'' : H →* (k' ≃ₐ[k] k') :=
    { toFun := fun h => { ρ h with commutes' := fun r => hfix h r }
      map_one' := by ext x; simp
      map_mul' := fun a b => by ext x; simp }
  have hinj : Function.Injective ρ'' := by
    intro a b hab
    apply hρ
    ext x
    exact congrArg (fun e : k' ≃ₐ[k] k' => e x) hab
  exact finite_field_aut_core hcard ρ'' hinj

variable {K' : Type*} [Field K'] [Algebra K K'] [FiniteDimensional K K'] [TopologicalSpace K']
  [IsTopologicalDivisionRing K'] [T2Space K'] [ContinuousSMul K K'] [LocallyCompactSpace K']
  [(𝓝[≠] (0 : K')).NeBot]

/-! ### Residue fields and the action of the Galois group -/

/-- The inclusion $R\to R'$ of the rings of integers. -/
def pRMap (hK : IsPField K p) (hK' : IsPField K' p) : pR hK →+* pR hK' where
  toFun x := ⟨algebraMap K K' x, mem_pR.2 ((weil_I_4_cor5_thm6_R (K' := K') (x : K)).2 (mem_pR.1 x.2))⟩
  map_one' := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)

/-- The embedding of the residue field of $K$ in that of $K'$. -/
def resEmb (hK : IsPField K p) (hK' : IsPField K' p) : Qt hK →+* Qt hK' :=
  Ideal.Quotient.lift (pIdealU hK) ((resMap hK').comp (pRMap hK hK')) (by
    intro a ha
    show resMap hK' (pRMap hK hK' a) = 0
    rw [resMap_eq_zero]
    exact (weil_I_4_cor5_thm6_P (K' := K') (a : K)).2 ha)

theorem resEmb_res (hK : IsPField K p) (hK' : IsPField K' p) (r : pR hK) :
    resEmb hK hK' (resMap hK r) = resMap hK' (pRMap hK hK' r) := rfl

/-- An automorphism over $K$ preserves the module. -/
theorem modK_aut (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') (x : K') : modK K' (σ x) = modK K' x :=
  weil_I_4_cor3_thm6 hK' σ.toRingEquiv (weil_I_4_cor5_thm6_aut σ) (weil_I_4_cor5_thm6_aut σ.symm) x

/-- An automorphism over $K$ acts on the ring of integers. -/
def pRAut (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') : pR hK' →+* pR hK' where
  toFun x := ⟨σ x, mem_pR.2 (by rw [modK_aut hK' σ]; exact mem_pR.1 x.2)⟩
  map_one' := Subtype.ext (by simp)
  map_mul' x y := Subtype.ext (by simp)
  map_zero' := Subtype.ext (by simp)
  map_add' x y := Subtype.ext (by simp)

/-- The induced endomorphism of the residue field. -/
def resAut (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') : Qt hK' →+* Qt hK' :=
  Ideal.Quotient.lift (pIdealU hK') ((resMap hK').comp (pRAut hK' σ)) (by
    intro a ha
    show resMap hK' (pRAut hK' σ a) = 0
    rw [resMap_eq_zero]
    have : modK K' (σ (a : K')) < 1 := by rw [modK_aut hK' σ]; exact ha
    exact this)

/-- The action on the residue field as a ring automorphism. -/
def resRingAut (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') : RingAut (Qt hK') :=
  RingEquiv.ofBijective (resAut hK' σ)
    (Finite.injective_iff_bijective.1 (resAut hK' σ).injective)

/-- The action of the Galois group on the residue field, as a homomorphism. -/
def resHom (hK' : IsPField K' p) : (K' ≃ₐ[K] K') →* RingAut (Qt hK') where
  toFun := resRingAut hK'
  map_one' := by
    ext x
    obtain ⟨r, rfl⟩ := resMap_surjective hK' x
    exact congrArg (resMap hK') (Subtype.ext rfl)
  map_mul' a b := by
    ext x
    obtain ⟨r, rfl⟩ := resMap_surjective hK' x
    exact congrArg (resMap hK') (Subtype.ext rfl)

theorem resHom_res (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') (r : pR hK') :
    resHom hK' σ (resMap hK' r) = resMap hK' ⟨σ r, mem_pR.2 (by rw [modK_aut hK' σ]; exact mem_pR.1 r.2)⟩ :=
  rfl

theorem resHom_fix (hK : IsPField K p) (hK' : IsPField K' p) (σ : K' ≃ₐ[K] K') (x : Qt hK) :
    resHom hK' σ (resEmb hK hK' x) = resEmb hK hK' x := by
  obtain ⟨r, rfl⟩ := resMap_surjective hK x
  rw [resEmb_res]
  refine congrArg (resMap hK') (Subtype.ext ?_)
  show σ (algebraMap K K' r) = algebraMap K K' r
  exact σ.commutes _

/-- Two elements of a subgroup of order $q'-1$ that are congruent modulo $P'$ are equal. -/
theorem units_eq_of_close (hK' : IsPField K' p) (M : Subgroup K'ˣ) (hM : Nat.card M = pq hK' - 1)
    {x y : K'ˣ} (hx : x ∈ M) (hy : y ∈ M) (h : modK K' ((x : K') - (y : K')) < 1) : x = y :=
  congrArg Subtype.val (redM_injective hK' M hM ((redM_eq_iff hK' M hM ⟨x, hx⟩ ⟨y, hy⟩).2 h))

/-- If $\bar\sigma$ is the $n$-th power map on the residue field, then $\sigma(x)=x^n$ on the roots of $1$ of order
prime to $p$. -/
theorem aut_unit_pow (hK' : IsPField K' p) (M : Subgroup K'ˣ) (hM : Nat.card M = pq hK' - 1)
    (σ : K' ≃ₐ[K] K') (n : ℕ)
    (hres : ∀ r : pR hK', resHom hK' σ (resMap hK' r) = (resMap hK' r) ^ n) (x : K'ˣ) (hx : x ∈ M) :
    σ (x : K') = (x : K') ^ n := by
  have hcomm := weil_I_4_thm7_comm hK' M hM
  have hσ0 : σ (x : K') ≠ 0 := by simp
  obtain ⟨m, hm, hmp, hxm⟩ := (hcomm x).1 hx
  have hu : Units.mk0 (σ (x : K')) hσ0 ∈ M := by
    refine (hcomm _).2 ⟨m, hm, hmp, Units.ext ?_⟩
    have : (x : K') ^ m = 1 := by simpa using congrArg Units.val hxm
    simp [← map_pow, this]
  have hv : x ^ n ∈ M := M.pow_mem hx n
  have hmod : modK K' (x : K') = 1 := (subgroup_elem hK' M hM ⟨x, hx⟩).2
  let r : pR hK' := ⟨(x : K'), mem_pR.2 hmod.le⟩
  have h1 : resMap hK' ⟨σ r, mem_pR.2 (by rw [modK_aut hK' σ]; exact mem_pR.1 r.2)⟩ =
      resMap hK' (r ^ n) := by
    rw [← resHom_res, hres, map_pow]
  have h2 : resMap hK' (⟨σ r, mem_pR.2 (by rw [modK_aut hK' σ]; exact mem_pR.1 r.2)⟩ - r ^ n) = 0 := by
    rw [map_sub, h1, sub_self]
  rw [resMap_eq_zero] at h2
  have h3 := units_eq_of_close hK' M hM hu hv (by
    simpa [r] using h2)
  simpa using congrArg Units.val h3

/-! ### Roots of unity of order prime to $p$ -/

/-- A root of $1$ of order prime to $p$ is an element of the subgroup of order $q'-1$. -/
theorem exists_unit_of_mem_prime (hK' : IsPField K' p) (M : Subgroup K'ˣ) (hM : Nat.card M = pq hK' - 1)
    {x : K'} (hx : x ∈ primeToPRoots p K') : ∃ u : K'ˣ, u ∈ M ∧ (u : K') = x := by
  obtain ⟨m, hm, hmp, hx⟩ := hx
  have hx0 : x ≠ 0 := by rintro rfl; simp [zero_pow hm.ne'] at hx
  exact ⟨Units.mk0 x hx0, (weil_I_4_thm7_comm hK' M hM _).2 ⟨m, hm, hmp, Units.ext (by simpa using hx)⟩, rfl⟩

/-- An element of the subgroup of order $q'-1$ is a root of $1$ of order prime to $p$. -/
theorem mem_prime_of_mem (hK' : IsPField K' p) (M : Subgroup K'ˣ) (hM : Nat.card M = pq hK' - 1)
    {u : K'ˣ} (hu : u ∈ M) : (u : K') ∈ primeToPRoots p K' :=
  ⟨pq hK' - 1, by have := one_lt_pq_nat hK'; omega, coprime_pq_sub_one hK',
    (subgroup_elem hK' M hM ⟨u, hu⟩).1⟩

/-- The roots of $1$ of order prime to $p$ are the roots of $x^{q'-1}=1$. -/
theorem primeToPRoots_pow (hK' : IsPField K' p) {x : K'} (hx : x ∈ primeToPRoots p K') :
    x ^ (pq hK' - 1) = 1 := by
  obtain ⟨M, hM⟩ := weil_I_4_thm7_exists hK'
  obtain ⟨u, hu, rfl⟩ := exists_unit_of_mem_prime hK' M hM hx
  exact (subgroup_elem hK' M hM ⟨u, hu⟩).1

/-- An automorphism over $K$ is determined by its values on a generating set. -/
theorem aut_ext_of_adjoin (S : Set K') (hS : IntermediateField.adjoin K S = ⊤) {σ τ : K' ≃ₐ[K] K'}
    (h : ∀ x ∈ S, σ x = τ x) : σ = τ := by
  let E : Subalgebra K K' := AlgHom.equalizer σ.toAlgHom τ.toAlgHom
  let E' : IntermediateField K K' := E.toIntermediateField (fun x hx => by
    have hx' : σ x = τ x := hx
    show σ x⁻¹ = τ x⁻¹
    rw [map_inv₀, map_inv₀, hx'])
  have hle : IntermediateField.adjoin K S ≤ E' := IntermediateField.adjoin_le_iff.2 (fun x hx => h x hx)
  rw [hS] at hle
  refine AlgEquiv.ext fun x => ?_
  have : x ∈ E' := hle IntermediateField.mem_top
  exact this

/-- If $K'$ is generated by the roots of $1$ of order prime to $p$, it is a cyclotomic extension of $K$. -/
theorem isCyclotomic_of_gen (hK' : IsPField K' p)
    (hgen : IntermediateField.adjoin K (primeToPRoots p K') = ⊤) :
    IsCyclotomicExtension {pq hK' - 1} K K' := by
  classical
  obtain ⟨M, hM⟩ := weil_I_4_thm7_exists hK'
  have hpos : 0 < pq hK' - 1 := by have := one_lt_pq_nat hK'; omega
  have := weil_I_4_thm7_cyclic hK' M hM
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := M)
  have hord : orderOf g = pq hK' - 1 := by
    rw [orderOf_eq_card_of_forall_mem_zpowers hg, hM]
  have hprim : IsPrimitiveRoot (((g : K'ˣ)) : K') (pq hK' - 1) := by
    rw [IsPrimitiveRoot.coe_units_iff]
    have := IsPrimitiveRoot.orderOf (g : K'ˣ)
    rwa [Subgroup.orderOf_coe, hord] at this
  have : NeZero (pq hK' - 1) := ⟨hpos.ne'⟩
  have hcyc := IntermediateField.isCyclotomicExtension_adjoin_of_exists_isPrimitiveRoot
    ({pq hK' - 1} : Set ℕ) K K' (by
      intro n hn hn0
      rw [Set.mem_singleton_iff] at hn
      subst hn
      exact ⟨_, hprim⟩)
  have hset : {b : K' | ∃ n ∈ ({pq hK' - 1} : Set ℕ), n ≠ 0 ∧ b ^ n = 1} = primeToPRoots p K' := by
    ext b
    constructor
    · rintro ⟨n, hn, h0, hb⟩
      rw [Set.mem_singleton_iff] at hn
      subst hn
      exact ⟨_, hpos, coprime_pq_sub_one hK', hb⟩
    · intro hb
      exact ⟨pq hK' - 1, Set.mem_singleton _, hpos.ne', primeToPRoots_pow hK' hb⟩
  have key : IntermediateField.adjoin K
      {b : K' | ∃ n ∈ ({pq hK' - 1} : Set ℕ), n ≠ 0 ∧ b ^ n = 1} = ⊤ := by
    rw [hset]; exact hgen
  have h2 : ∀ T : IntermediateField K K', T = ⊤ → IsCyclotomicExtension {pq hK' - 1} K T →
      IsCyclotomicExtension {pq hK' - 1} K K' := by
    rintro T rfl h
    exact IsCyclotomicExtension.equiv {pq hK' - 1} K _ IntermediateField.topEquiv
  exact h2 _ key hcyc

/-- **Cor. 2 of Thm. 7.** An extension generated by roots of $1$ of order prime to $p$ is unramified and Galois, with
cyclic Galois group generated by an automorphism $\varphi$ with $\varphi(\mu)=\mu^q$ on those roots of $1$. -/
@[kb "weil1973bnt" "Ch. I, §4, Cor. 2 of Thm. 7"]
theorem weil_I_4_cor2_thm7 (hK : IsPField K p) (hK' : IsPField K' p)
    (hgen : IntermediateField.adjoin K (primeToPRoots p K') = ⊤) :
    IsUnramified hK hK' ∧ IsGalois K K' ∧ IsCyclic (K' ≃ₐ[K] K') ∧
      ∃ φ : K' ≃ₐ[K] K', (∀ μ ∈ primeToPRoots p K', φ μ = μ ^ pq hK) ∧
        ∀ σ : K' ≃ₐ[K] K', σ ∈ Subgroup.zpowers φ := by
  classical
  obtain ⟨M, hM⟩ := weil_I_4_thm7_exists hK'
  have hinj : Function.Injective (resHom hK' : (K' ≃ₐ[K] K') →* RingAut (Qt hK')) := by
    rw [injective_iff_map_eq_one]
    intro σ hσ
    have hres : ∀ r : pR hK', resHom hK' σ (resMap hK' r) = (resMap hK' r) ^ 1 := by
      intro r; rw [hσ]; simp
    refine aut_ext_of_adjoin _ hgen (fun x hx => ?_)
    obtain ⟨u, hu, rfl⟩ := exists_unit_of_mem_prime hK' M hM hx
    simpa using aut_unit_pow hK' M hM σ 1 hres u hu
  have hgal : IsGalois K K' := by
    have := isCyclotomic_of_gen hK' hgen
    exact IsCyclotomicExtension.isGalois {pq hK' - 1} K K'
  obtain ⟨π, hπ0, hπ1, hmax⟩ := exists_gen hK
  have hπ : pP hK = (fun r => π * r) '' (pR hK : Set K) := pP_eq_left hπ0 hπ1 hmax
  obtain ⟨e, f, he, hf, hqf, -, hef⟩ := weil_I_4_cor6_thm6 hK hK' hπ0 hπ
  have hGal : Nat.card (K' ≃ₐ[K] K') = Module.finrank K K' := IsGalois.card_aut_eq_finrank K K'
  have hcard : Nat.card (Qt hK') = Nat.card (Qt hK) ^ f := by
    rw [card_Qt, card_Qt]; exact hqf
  obtain ⟨hle, hex⟩ :=
    finite_field_aut_core' (resEmb hK hK') hcard (resHom hK') (resHom_fix hK hK') hinj
  have he1 : e = 1 := by
    rw [hGal, hef] at hle
    have : e * f ≤ 1 * f := by simpa using hle
    have := Nat.le_of_mul_le_mul_right this hf
    omega
  subst he1
  have hfr : Module.finrank K K' = f := by rw [hef]; simp
  obtain ⟨φ, hφ, hzp⟩ := hex (by rw [hGal, hfr])
  have hφ' : ∀ μ ∈ primeToPRoots p K', φ μ = μ ^ pq hK := by
    intro μ hμ
    obtain ⟨u, hu, rfl⟩ := exists_unit_of_mem_prime hK' M hM hμ
    refine aut_unit_pow hK' M hM φ (pq hK) (fun r => ?_) u hu
    rw [hφ, card_Qt]
  refine ⟨by unfold IsUnramified; rw [hqf, hfr], hgal,
    ⟨⟨φ, fun σ => Subgroup.mem_zpowers_iff.1 (hzp σ)⟩⟩, φ, hφ', hzp⟩

/-! ### Intermediate fields -/

instance (L : IntermediateField K K') : IsTopologicalRing L :=
  inferInstanceAs (IsTopologicalRing L.toSubfield.toSubring)

instance intermediateField_continuousSMul (L : IntermediateField K K') : ContinuousSMul L K' :=
  ⟨by
    have : Continuous fun q : L × K' => (q.1 : K') * q.2 :=
      (continuous_subtype_val.comp continuous_fst).mul continuous_snd
    simpa [Algebra.smul_def] using this⟩

/-- An intermediate field of $K'/K$, with the subspace topology, is a topological division ring. -/
instance intermediateField_isTopologicalDivisionRing (L : IntermediateField K K') : IsTopologicalDivisionRing L where
  continuousAt_inv₀ x hx := by
    rw [Topology.IsInducing.subtypeVal.continuousAt_iff]
    have hx' : (x : K') ≠ 0 := fun h => hx (Subtype.ext h)
    have := (continuousAt_inv₀ hx').comp (continuous_subtype_val.continuousAt (x := x))
    exact this

/-- The field generated by the roots of $1$ of order prime to $p$ in $K'$ is generated by its own such roots. -/
theorem adjoin_roots_adjoin_top :
    IntermediateField.adjoin K (primeToPRoots p (IntermediateField.adjoin K (primeToPRoots p K'))) = ⊤ := by
  set K1 := IntermediateField.adjoin K (primeToPRoots p K') with hK1
  set T1 := IntermediateField.adjoin K (primeToPRoots p K1) with hT1
  refine eq_top_iff.2 fun y hy => ?_
  clear hy
  obtain ⟨x, hx⟩ := y
  induction hx using IntermediateField.adjoin_induction with
  | mem x hx =>
    obtain ⟨m, hm, hmp, hxm⟩ := hx
    exact IntermediateField.subset_adjoin K _ ⟨m, hm, hmp, Subtype.ext (by simpa using hxm)⟩
  | algebraMap a => exact T1.algebraMap_mem a
  | add x y hx hy ihx ihy => exact add_mem ihx ihy
  | mul x y hx hy ihx ihy => exact mul_mem ihx ihy
  | inv x hx ihx => exact inv_mem ihx

/-- The field $K_1$ generated by the roots of $1$ of order prime to $p$ in $K'$ is unramified over $K$ and has
the same residue field as $K'$. -/
theorem cor4_unr (hK : IsPField K p) (hK' : IsPField K' p) :
    ∃ (_ : LocallyCompactSpace (IntermediateField.adjoin K (primeToPRoots p K')))
      (_ : (𝓝[≠] (0 : IntermediateField.adjoin K (primeToPRoots p K'))).NeBot)
      (h1 : IsPField (IntermediateField.adjoin K (primeToPRoots p K')) p),
      IsUnramified hK h1 ∧ pq hK' = pq h1 := by
  classical
  set K1 := IntermediateField.adjoin K (primeToPRoots p K') with hK1
  obtain ⟨lc, nb, h1⟩ := weil_I_4_cor5_thm6 (K' := K1) hK
  refine ⟨lc, nb, h1, ?_⟩
  have hc2 := weil_I_4_cor2_thm7 hK h1 (adjoin_roots_adjoin_top (K := K) (K' := K') (p := p))
  refine ⟨hc2.1, ?_⟩
  obtain ⟨M, hM⟩ := weil_I_4_thm7_exists hK'
  obtain ⟨M1, hM1⟩ := weil_I_4_thm7_exists h1
  have hpos : 0 < pq hK' - 1 := by have := one_lt_pq_nat hK'; omega
  have hle : M ≤ M1.map (Units.map (K1.val : K1 →* K')) := by
    intro u hu
    have hu' : (u : K') ∈ primeToPRoots p K' := mem_prime_of_mem hK' M hM hu
    have hmem : (u : K') ∈ K1 := IntermediateField.subset_adjoin K _ hu'
    have hu0 : (⟨(u : K'), hmem⟩ : K1) ≠ 0 := fun h => u.ne_zero (congrArg Subtype.val h)
    refine ⟨Units.mk0 _ hu0, (weil_I_4_thm7_comm h1 M1 hM1 _).2
      ⟨pq hK' - 1, hpos, coprime_pq_sub_one hK', Units.ext (Subtype.ext ?_)⟩, Units.ext rfl⟩
    simpa using (subgroup_elem hK' M hM ⟨u, hu⟩).1
  have : Finite M1 := Nat.finite_of_card_ne_zero (by rw [hM1]; have := one_lt_pq_nat h1; omega)
  have hcard : pq hK' - 1 ≤ pq h1 - 1 := by
    have hφinj : Function.Injective (Units.map (K1.val : K1 →* K')) :=
      Units.map_injective (fun a b h => Subtype.ext h)
    have : Finite (M1.map (Units.map (K1.val : K1 →* K'))) :=
      Finite.of_equiv M1 (Subgroup.equivMapOfInjective M1 _ hφinj).toEquiv
    have := Subgroup.card_le_of_le hle
    rw [Subgroup.card_map_of_injective (Units.map_injective (fun a b h => Subtype.ext h))] at this
    rwa [hM, hM1] at this
  obtain ⟨f1, hf1⟩ := pq_eq_pow_of_algebra (K := K1) (K' := K') h1 hK'
  have h2 := two_le_pq h1
  have h2' := two_le_pq hK'
  have hf1pos : f1 ≠ 0 := by
    rintro rfl
    simp at hf1
    omega
  have hle1 : pq h1 ^ f1 ≤ pq h1 ^ 1 := by rw [pow_one, ← hf1]; omega
  have hf1le := (Nat.pow_le_pow_iff_right h2).1 hle1
  have : f1 = 1 := by omega
  subst this
  simpa using hf1

/-- **Cor. 3 of Thm. 7** (commutative case, first assertion): an unramified extension is generated by roots of $1$ of
order prime to $p$. -/
theorem adjoin_roots_eq_top_of_unramified (hK : IsPField K p) (hK' : IsPField K' p)
    (hunr : IsUnramified hK hK') : IntermediateField.adjoin K (primeToPRoots p K') = ⊤ := by
  obtain ⟨lc, nb, h1, hunr1, hq⟩ := cor4_unr hK hK'
  set K1 := IntermediateField.adjoin K (primeToPRoots p K') with hK1
  have hpow : pq hK ^ Module.finrank K K1 = pq hK ^ Module.finrank K K' := by
    have e1 : pq h1 = pq hK ^ Module.finrank K K1 := hunr1
    have e2 : pq hK' = pq hK ^ Module.finrank K K' := hunr
    rw [← e1, ← e2, hq]
  have hfr := Nat.pow_right_injective (two_le_pq hK) hpow
  refine IntermediateField.eq_of_le_of_finrank_eq le_top ?_
  rw [IntermediateField.finrank_top']
  exact hfr

/-- **Def. 5** (the Frobenius automorphism). For $K'$ unramified over $K$ there is a unique automorphism $\varphi$ over
$K$ with $\varphi(\mu)=\mu^q$ for the roots of $1$ of order prime to $p$; it generates the Galois group. -/
@[kb "weil1973bnt" "Ch. I, §4, Def. 5 (the Frobenius automorphism)"]
theorem weil_I_4_def5 (hK : IsPField K p) (hK' : IsPField K' p) (hunr : IsUnramified hK hK') :
    ∃! φ : K' ≃ₐ[K] K', (∀ μ ∈ primeToPRoots p K', φ μ = μ ^ pq hK) ∧
      ∀ σ : K' ≃ₐ[K] K', σ ∈ Subgroup.zpowers φ := by
  have hgen := adjoin_roots_eq_top_of_unramified hK hK' hunr
  obtain ⟨-, -, -, φ, hφ, hzp⟩ := weil_I_4_cor2_thm7 hK hK' hgen
  refine ⟨φ, ⟨hφ, hzp⟩, fun ψ hψ => ?_⟩
  exact aut_ext_of_adjoin _ hgen (fun x hx => by rw [hψ.1 x hx, hφ x hx])

/-- The $n$-th power of the Frobenius acts on a root of $1$ by raising to the power $q^n$. -/
theorem pow_apply_of_frob (hK : IsPField K p) (φ : K' ≃ₐ[K] K') {ζ : K'} (hφ : φ ζ = ζ ^ pq hK) (n : ℕ) :
    (φ ^ n) ζ = ζ ^ (pq hK ^ n) := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [pow_succ, AlgEquiv.mul_apply, hφ, map_pow, ih, ← pow_mul, pow_succ]

/-- **Cor. 3 of Thm. 7**, second assertion (degree): an extension generated by a primitive $(q^f-1)$-th root of $1$ is
unramified of degree $f$. -/
@[kb "weil1973bnt" "Ch. I, §4, Cor. 3 of Thm. 7 (the extension generated by a primitive (q^f-1)-th root of 1)"]
theorem weil_I_4_cor3_thm7_degree (hK : IsPField K p) (hK' : IsPField K' p) {f : ℕ} (hf : 1 ≤ f) {ζ : K'}
    (hζ : IsPrimitiveRoot ζ (pq hK ^ f - 1)) (hgen : IntermediateField.adjoin K {ζ} = ⊤) :
    IsUnramified hK hK' ∧ Module.finrank K K' = f := by
  classical
  have hq2 := two_le_pq hK
  have hpow2 : 2 ≤ pq hK ^ f := le_trans hq2 (Nat.le_self_pow (by omega) _)
  have hcop : Nat.Coprime (pq hK ^ f - 1) p := by
    obtain ⟨g, hg, hqg⟩ := weil_I_4_thm6_residue hK
    have hp := hK.1
    rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd hp]
    intro hd
    have h2 : p ∣ pq hK ^ f := by
      rw [hqg, ← pow_mul]; exact dvd_pow_self p (by positivity)
    have h3 : p ∣ pq hK ^ f - (pq hK ^ f - 1) := Nat.dvd_sub h2 hd
    have h4 : pq hK ^ f - (pq hK ^ f - 1) = 1 := by omega
    rw [h4] at h3
    exact hp.ne_one (Nat.dvd_one.1 h3)
  have hζprim : ζ ∈ primeToPRoots p K' := ⟨pq hK ^ f - 1, by omega, hcop, hζ.pow_eq_one⟩
  have hgen' : IntermediateField.adjoin K (primeToPRoots p K') = ⊤ :=
    eq_top_iff.2 (hgen ▸ IntermediateField.adjoin.mono K _ _ (Set.singleton_subset_iff.2 hζprim))
  obtain ⟨hunr, hgal, -, φ, hφ, hzp⟩ := weil_I_4_cor2_thm7 hK hK' hgen'
  refine ⟨hunr, ?_⟩
  have hqd : pq hK' = pq hK ^ Module.finrank K K' := hunr
  have hfd : f ≤ Module.finrank K K' := by
    have hdvd := hζ.dvd_of_pow_eq_one (pq hK' - 1) (primeToPRoots_pow hK' hζprim)
    have hle := Nat.le_of_dvd (by have := one_lt_pq_nat hK'; omega) hdvd
    rw [hqd] at hle
    have : pq hK ^ f ≤ pq hK ^ Module.finrank K K' := by
      have := Nat.one_le_pow (Module.finrank K K') (pq hK) (by omega)
      omega
    exact (Nat.pow_le_pow_iff_right hq2).1 this
  have hφf : φ ^ f = 1 := by
    refine aut_ext_of_adjoin {ζ} hgen (fun x hx => ?_)
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [pow_apply_of_frob hK φ (hφ _ hζprim) f, AlgEquiv.one_apply]
    have : pq hK ^ f = (pq hK ^ f - 1) + 1 := by omega
    rw [this, pow_succ, hζ.pow_eq_one, one_mul]
  have hd : Module.finrank K K' = Nat.card (K' ≃ₐ[K] K') := (IsGalois.card_aut_eq_finrank K K').symm
  have htop : Subgroup.zpowers φ = ⊤ := (Subgroup.eq_top_iff' _).2 hzp
  have hcard : Nat.card (K' ≃ₐ[K] K') = orderOf φ := by
    rw [← Nat.card_zpowers, htop, Subgroup.card_top]
  have : orderOf φ ≤ f := Nat.le_of_dvd (by omega) (orderOf_dvd_of_pow_eq_one hφf)
  omega

/-- **Cor. 3 of Thm. 7**, second assertion (uniqueness): two unramified extensions of $K$ of the same degree are
isomorphic over $K$. -/
@[kb "weil1973bnt" "Ch. I, §4, Cor. 3 of Thm. 7 (uniqueness of the unramified extension of degree f)"]
theorem weil_I_4_cor3_thm7_unique (hK : IsPField K p) (hK' : IsPField K' p)
    {K'' : Type*} [Field K''] [Algebra K K''] [FiniteDimensional K K''] [TopologicalSpace K'']
    [IsTopologicalDivisionRing K''] [T2Space K''] [ContinuousSMul K K''] [LocallyCompactSpace K'']
    [(𝓝[≠] (0 : K'')).NeBot] (hK'' : IsPField K'' p)
    (h' : IsUnramified hK hK') (h'' : IsUnramified hK hK'')
    (hdeg : Module.finrank K K' = Module.finrank K K'') : Nonempty (K' ≃ₐ[K] K'') := by
  have c' := isCyclotomic_of_gen hK' (adjoin_roots_eq_top_of_unramified hK hK' h')
  have c'' := isCyclotomic_of_gen hK'' (adjoin_roots_eq_top_of_unramified hK hK'' h'')
  have e1 : pq hK' = pq hK ^ Module.finrank K K' := h'
  have e2 : pq hK'' = pq hK ^ Module.finrank K K'' := h''
  have hq : pq hK' = pq hK'' := by rw [e1, e2, hdeg]
  have c3 : IsCyclotomicExtension {pq hK' - 1} K K'' := by rw [hq]; exact c''
  exact ⟨IsCyclotomicExtension.algEquiv {pq hK' - 1} K K' K''⟩

/-- **Cor. 4 of Thm. 7.** Let $f$ be the modular degree and $e$ the order of ramification of $K'$ over $K$. The field
$K_1$ generated by the roots of $1$ of order prime to $p$ in $K'$ is unramified of degree $f$ over $K$, $K'$ has
degree $e$ over $K_1$ (and is fully ramified over it), and every unramified intermediate field is contained in $K_1$. -/
@[kb "weil1973bnt" "Ch. I, §4, Cor. 4 of Thm. 7"]
theorem weil_I_4_cor4_thm7 (hK : IsPField K p) (hK' : IsPField K' p) {e f : ℕ}
    (hf : pq hK' = pq hK ^ f) (hef : Module.finrank K K' = e * f) :
    Module.finrank K (IntermediateField.adjoin K (primeToPRoots p K')) = f ∧
      Module.finrank (IntermediateField.adjoin K (primeToPRoots p K')) K' = e ∧
      (∃ (_ : LocallyCompactSpace (IntermediateField.adjoin K (primeToPRoots p K')))
        (_ : (𝓝[≠] (0 : IntermediateField.adjoin K (primeToPRoots p K'))).NeBot)
        (h1 : IsPField (IntermediateField.adjoin K (primeToPRoots p K')) p),
        IsUnramified hK h1 ∧ pq hK' = pq h1) ∧
      ∀ (L : IntermediateField K K') [LocallyCompactSpace L] [(𝓝[≠] (0 : L)).NeBot] (hL : IsPField L p),
        IsUnramified hK hL → L ≤ IntermediateField.adjoin K (primeToPRoots p K') := by
  have hq2 := two_le_pq hK
  have hfpos : f ≠ 0 := by
    rintro rfl
    have := two_le_pq hK'
    simp at hf
    omega
  have hmain := cor4_unr hK hK'
  have hdeg : Module.finrank K (IntermediateField.adjoin K (primeToPRoots p K')) = f := by
    obtain ⟨lc, nb, h1, hunr1, hq⟩ := hmain
    have e1 : pq h1 = pq hK ^ Module.finrank K (IntermediateField.adjoin K (primeToPRoots p K')) := hunr1
    have h3 : pq hK ^ Module.finrank K (IntermediateField.adjoin K (primeToPRoots p K')) = pq hK ^ f := by
      rw [← e1, ← hq, hf]
    exact Nat.pow_right_injective hq2 h3
  refine ⟨hdeg, ?_, hmain, ?_⟩
  · have h := Module.finrank_mul_finrank K (IntermediateField.adjoin K (primeToPRoots p K')) K'
    rw [hdeg, hef] at h
    exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero hfpos) (by rw [h, mul_comm])
  · intro L _ _ hL hunr y hy
    have hgen := adjoin_roots_eq_top_of_unramified hK hL hunr
    have key : ∀ z : L, z ∈ IntermediateField.adjoin K (primeToPRoots p L) →
        (z : K') ∈ IntermediateField.adjoin K (primeToPRoots p K') := by
      intro z hz
      induction hz using IntermediateField.adjoin_induction with
      | mem x hx =>
        obtain ⟨m, hm, hmp, hxm⟩ := hx
        exact IntermediateField.subset_adjoin K _ ⟨m, hm, hmp, by simpa using congrArg Subtype.val hxm⟩
      | algebraMap a => exact IntermediateField.algebraMap_mem _ a
      | add x y hx hy ihx ihy => simpa using add_mem ihx ihy
      | mul x y hx hy ihx ihy => simpa using mul_mem ihx ihy
      | inv x hx ihx => simpa using inv_mem ihx
    exact key ⟨y, hy⟩ (by rw [hgen]; exact IntermediateField.mem_top)

/-! ### Division algebras (Cor. 3) -/

section SubfieldDA

variable {D : Type*} [DivisionRing D] [Algebra K D] [FiniteDimensional K D] [TopologicalSpace D]
  [IsTopologicalDivisionRing D] [T2Space D] [ContinuousSMul K D] [LocallyCompactSpace D] [(𝓝[≠] (0 : D)).NeBot]

instance divSubfield_isTopologicalRing (F : Subfield D) : IsTopologicalRing F :=
  inferInstanceAs (IsTopologicalRing F.toSubring)

/-- A subfield of a topological division ring, with the subspace topology, is a topological division ring. -/
instance divSubfield_isTopologicalDivisionRing (F : Subfield D) : IsTopologicalDivisionRing F where
  continuousAt_inv₀ x hx := by
    rw [Topology.IsInducing.subtypeVal.continuousAt_iff]
    have hx' : (x : D) ≠ 0 := fun h => hx (Subtype.ext h)
    have := (continuousAt_inv₀ hx').comp (continuous_subtype_val.continuousAt (x := x))
    exact this

/-- A subfield containing the image of `K` is a `K`-algebra. -/
@[instance_reducible]
def subfieldAlgebra (F : Subfield D) (h : ∀ x : K, algebraMap K D x ∈ F) : Algebra K F :=
  ((algebraMap K D).codRestrict F h).toAlgebra' (fun c x => Subtype.ext (Algebra.commutes c (x : D)))

theorem subfieldAlgebra_smul (F : Subfield D) (h : ∀ x : K, algebraMap K D x ∈ F) (c : K) (x : F) :
    (letI := subfieldAlgebra F h; (c • x : F) : D) = c • (x : D) := by
  let _ := subfieldAlgebra F h
  show algebraMap K D c * (x : D) = c • (x : D)
  rw [Algebra.smul_def]

/-- **Cor. 3 of Thm. 7**, first assertion, forward direction. -/
theorem cor3_forward (hK : IsPField K p) (hD : IsPField D p) (hunr : IsUnramified hK hD) :
    (∀ x y : D, x * y = y * x) ∧ Algebra.adjoin K (primeToPRoots p D) = ⊤ := by
  classical
  obtain ⟨M, hM⟩ := weil_I_4_thm7_exists hD
  have hpos : 0 < pq hD - 1 := by have := one_lt_pq_nat hD; omega
  have hcyc := weil_I_4_thm7_cyclic hD M hM
  obtain ⟨g, hg⟩ := IsCyclic.exists_generator (α := M)
  set μ : D := (((g : M) : Dˣ) : D) with hμ
  have hμroot : μ ^ (pq hD - 1) = 1 := (subgroup_elem hD M hM g).1
  have hμprim : μ ∈ primeToPRoots p D := ⟨_, hpos, coprime_pq_sub_one hD, hμroot⟩
  have hint : IsIntegral K μ := IsIntegral.of_pow hpos (by rw [hμroot]; exact isIntegral_one)
  let A0 : Subalgebra K D := Algebra.adjoin K {μ}
  have hinv : ∀ x ∈ A0, x⁻¹ ∈ A0 := fun x hx => Algebra.IsIntegral.inv_mem hx
  let F : Subfield D := A0.toSubring.toSubfield hinv
  have hFmem : ∀ x, x ∈ F ↔ x ∈ A0 := fun x => Iff.rfl
  have halg : ∀ x : K, algebraMap K D x ∈ F := fun x => A0.algebraMap_mem x
  let _ : Algebra K F := subfieldAlgebra F halg
  let _ : Field F :=
    { (inferInstance : DivisionRing F) with
      mul_comm := fun a b => Subtype.ext (by
        have h := mul_comm (⟨a.1, a.2⟩ : A0) ⟨b.1, b.2⟩
        exact congrArg Subtype.val h) }
  let ι : F →ₗ[K] D :=
    { toFun := Subtype.val
      map_add' := fun _ _ => rfl
      map_smul' := fun c x => subfieldAlgebra_smul F halg c x }
  have hιinj : Function.Injective ι := Subtype.val_injective
  have hfdF : FiniteDimensional K F := Module.Finite.of_injective ι hιinj
  have hcs : ContinuousSMul K F := ⟨by
    refine Topology.IsInducing.subtypeVal.continuous_iff.2 ?_
    have : Continuous fun q : K × F => q.1 • (q.2 : D) :=
      continuous_fst.smul (continuous_subtype_val.comp continuous_snd)
    convert this using 1
    funext q
    exact subfieldAlgebra_smul F halg q.1 q.2⟩
  have htdr : @IsTopologicalDivisionRing F Field.toDivisionRing _ := divSubfield_isTopologicalDivisionRing F
  obtain ⟨lcF, nbF, hF⟩ := weil_I_4_cor5_thm6 (K' := F) hK
  have hgenF : IntermediateField.adjoin K (primeToPRoots p F) = ⊤ := by
    set T := IntermediateField.adjoin K (primeToPRoots p F) with hT
    have key : ∀ x (hx : x ∈ Algebra.adjoin K {μ}), (⟨x, hx⟩ : F) ∈ T := by
      intro x hx
      induction hx using Algebra.adjoin_induction with
      | mem x hx =>
        obtain rfl : x = μ := hx
        exact IntermediateField.subset_adjoin K _
          ⟨pq hD - 1, hpos, coprime_pq_sub_one hD, Subtype.ext (by simpa using hμroot)⟩
      | algebraMap a => exact T.algebraMap_mem a
      | add x y hx hy ihx ihy => exact add_mem ihx ihy
      | mul x y hx hy ihx ihy => exact mul_mem ihx ihy
    refine eq_top_iff.2 fun y hy => ?_
    exact key y.1 y.2
  have hc2 := weil_I_4_cor2_thm7 hK hF hgenF
  have hunrF : pq hF = pq hK ^ Module.finrank K F := hc2.1
  obtain ⟨MF, hMF⟩ := weil_I_4_thm7_exists hF
  have hle : M ≤ MF.map (Units.map (F.subtype : F →* D)) := by
    intro v hv
    obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hg ⟨v, hv⟩)
    have hvD : (v : D) = μ ^ k := by
      have := congrArg (fun m : M => ((m : Dˣ) : D)) hk
      simpa [hμ] using this.symm
    have hmem : (v : D) ∈ F := by rw [hvD]; exact hint.zpow_mem_adjoin k
    have hv0 : (⟨(v : D), hmem⟩ : F) ≠ 0 := fun h => v.ne_zero (congrArg Subtype.val h)
    refine ⟨Units.mk0 _ hv0, (weil_I_4_thm7_comm hF MF hMF _).2
      ⟨pq hD - 1, hpos, coprime_pq_sub_one hD, Units.ext (Subtype.ext ?_)⟩, Units.ext rfl⟩
    simpa using (subgroup_elem hD M hM ⟨v, hv⟩).1
  have : Finite MF := Nat.finite_of_card_ne_zero (by rw [hMF]; have := one_lt_pq_nat hF; omega)
  have hcard : pq hD - 1 ≤ pq hF - 1 := by
    have hφinj : Function.Injective (Units.map (F.subtype : F →* D)) :=
      Units.map_injective (fun a b h => Subtype.ext h)
    have : Finite (MF.map (Units.map (F.subtype : F →* D))) :=
      Finite.of_equiv MF (Subgroup.equivMapOfInjective MF _ hφinj).toEquiv
    have := Subgroup.card_le_of_le hle
    rw [Subgroup.card_map_of_injective hφinj] at this
    rwa [hM, hMF] at this
  have hq2 := two_le_pq hK
  have hqD : pq hD = pq hK ^ Module.finrank K D := hunr
  have h1 : pq hK ^ Module.finrank K D ≤ pq hK ^ Module.finrank K F := by
    have := one_lt_pq_nat hD
    have := one_lt_pq_nat hF
    omega
  have hfa := (Nat.pow_le_pow_iff_right hq2).1 h1
  have haf : Module.finrank K F ≤ Module.finrank K D := LinearMap.finrank_le_finrank_of_injective hιinj
  have hrange : LinearMap.range ι = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [LinearMap.finrank_range_of_inj hιinj]
    omega
  have hall : ∀ d : D, d ∈ Algebra.adjoin K {μ} := by
    intro d
    have : d ∈ LinearMap.range ι := by rw [hrange]; trivial
    obtain ⟨x, rfl⟩ := this
    exact x.2
  refine ⟨fun x y => ?_, ?_⟩
  · have h := mul_comm (⟨x, hall x⟩ : A0) ⟨y, hall y⟩
    exact congrArg Subtype.val h
  · exact eq_top_iff.2 fun d _ =>
      Algebra.adjoin_mono (Set.singleton_subset_iff.2 hμprim) (hall d)

/-- **Cor. 3 of Thm. 7**, first assertion. A division algebra of finite dimension over $K$ is unramified if and only
if it is commutative and generated over $K$ by roots of $1$ of order prime to $p$. -/
@[kb "weil1973bnt" "Ch. I, §4, Cor. 3 of Thm. 7 (unramified iff commutative and generated by roots of unity)"]
theorem weil_I_4_cor3_thm7 (hK : IsPField K p) (hD : IsPField D p) :
    IsUnramified hK hD ↔ (∀ x y : D, x * y = y * x) ∧ Algebra.adjoin K (primeToPRoots p D) = ⊤ := by
  refine ⟨cor3_forward hK hD, fun ⟨hcomm, hgen⟩ => ?_⟩
  let _ : Field D := { (inferInstance : DivisionRing D) with mul_comm := hcomm }
  exact (weil_I_4_cor2_thm7 (K' := D) hK hD (IntermediateField.adjoin_eq_top_of_algebra K _ hgen)).1
end SubfieldDA

