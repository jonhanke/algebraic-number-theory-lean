import QuadFormsKB.Citation

/-!
# Weil, *Basic Number Theory*, III.§2, Def. (p. 50) and Cor. 2 of Prop. 3; III.§1, Cor. 1 of Thm. 3

* `IsProperAbove`: III.§2, text p. 50. A $k$-linear embedding $\lambda$ of $k'$ into a field $K'\supseteq K$ is
  *proper above $K$* if $K'$ is generated by $\lambda(k')$ over $K$; two proper embeddings $(\lambda,K')$, $(\lambda',K'')$
  are equivalent if $\lambda'=\rho\circ\lambda$ for a $K$-isomorphism $\rho:K'\to K''$.
* `weil_III_2_cor2_isGalois`, `weil_III_2_cor2_restrict`, `weil_III_2_cor2_all`: III.§2, Cor. 2 of Prop. 3. If $k'/k$
  is Galois with group $G$ and $(\lambda,K')$ is proper above $K$, then $K'/K$ is Galois; every $\rho\in
  \operatorname{Gal}(K'/K)$ satisfies $\rho\circ\lambda=\lambda\circ\sigma$ for a unique $\sigma\in G$, and
  $\rho\mapsto\sigma$ is an injective homomorphism; every proper embedding of $k'$ above $K$ is equivalent to some
  $(\lambda\circ\sigma,K')$.
* `weil_III_1_cor1_thm3`: III.§1, Cor. 1 of Thm. 3 (number field $k$, $E=k^n$). Two finite subsets $e,e'$ of $E$ that
  both span $E$ generate the same $r_v$-module in $E_v=k_v^n$ for almost all finite places $v$.
-/

open IsDedekindDomain NumberField

noncomputable section

namespace NumberFieldKB.WeilBNT

section Proper

variable {k k' K K' : Type*} [Field k] [Field k'] [Field K] [Field K'] [Algebra k k'] [Algebra k K]
  [Algebra K K'] [Algebra k K'] [IsScalarTower k K K']

/-- III.§2, text p. 50: $\lambda$ is proper above $K$ when $K'=K(\lambda(k'))$. -/
def IsProperAbove (l : k' →ₐ[k] K') : Prop :=
  IntermediateField.adjoin K (Set.range l) = ⊤

/-- For a proper embedding `l` and a primitive element `α` of `k'` over `k`, the field `K'` is a splitting
field over `K` of the minimal polynomial of `α` (pushed to `K`). -/
theorem isSplittingField_of_proper [FiniteDimensional k k'] [IsGalois k k'] {α : k'}
    (hα : IntermediateField.adjoin k {α} = ⊤) {l : k' →ₐ[k] K'} (hl : IsProperAbove (K := K) l) :
    Polynomial.IsSplittingField K K' ((minpoly k α).map (algebraMap k K)) := by
  have hint : IsIntegral k α := IsIntegral.of_finite k α
  have hmin : minpoly k (l α) = minpoly k α := minpoly.algHom_eq l l.injective α
  refine ⟨?_, ?_⟩
  · rw [Polynomial.map_map, ← IsScalarTower.algebraMap_eq]
    have := (Normal.splits (inferInstance : Normal k k') α).map (l : k' →+* K')
    rwa [Polynomial.map_map, l.comp_algebraMap] at this
  · have hmem : l α ∈ ((minpoly k α).map (algebraMap k K)).rootSet K' := by
      rw [Polynomial.mem_rootSet]
      refine ⟨Polynomial.map_ne_zero (minpoly.ne_zero hint), ?_⟩
      rw [Polynomial.aeval_map_algebraMap, ← hmin]
      exact minpoly.aeval k (l α)
    have h1 : IntermediateField.adjoin K {l α} = ⊤ := by
      rw [eq_top_iff, ← hl, IntermediateField.adjoin_le_iff]
      rintro _ ⟨x, rfl⟩
      have hx : x ∈ (⊤ : IntermediateField k k') := trivial
      rw [← hα] at hx
      have hx2 : l x ∈ (IntermediateField.adjoin k {α}).map l := ⟨x, hx, rfl⟩
      rw [IntermediateField.adjoin_map, Set.image_singleton] at hx2
      have hle : IntermediateField.adjoin k {l α} ≤ (IntermediateField.adjoin K {l α}).restrictScalars k := by
        rw [IntermediateField.adjoin_le_iff]
        intro y hy
        exact IntermediateField.subset_adjoin K _ hy
      exact hle hx2
    have h2 : Algebra.adjoin K {l α} = ⊤ := by
      have hal : IsAlgebraic K (l α) := (hint.map l).tower_top.isAlgebraic
      rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hal, h1]
      exact IntermediateField.top_toSubalgebra
    rw [eq_top_iff, ← h2]
    exact Algebra.adjoin_mono (Set.singleton_subset_iff.2 hmem)

@[kb "weil1973bnt" "Ch. III, §2, Cor. 2 of Prop. 3 (K'/K is Galois)"]
theorem weil_III_2_cor2_isGalois [FiniteDimensional k k'] [IsGalois k k'] {l : k' →ₐ[k] K'}
    (hl : IsProperAbove (K := K) l) : IsGalois K K' := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element k k'
  have := isSplittingField_of_proper hα hl
  exact IsGalois.of_separable_splitting_field (p := (minpoly k α).map (algebraMap k K))
    (Polynomial.Separable.map (Algebra.IsSeparable.isSeparable k α))

/-- Two `k`-embeddings of a finite Galois extension `k'` into any extension differ by an automorphism of
`k'`. -/
theorem exists_comp_eq_of_galois [FiniteDimensional k k'] [IsGalois k k'] {L : Type*} [Field L]
    [Algebra k L] (f g : k' →ₐ[k] L) : ∃ σ : k' ≃ₐ[k] k', g = f.comp σ.toAlgHom := by
  let E : IntermediateField k L := f.fieldRange
  let e : k' ≃ₐ[k] E := AlgEquiv.ofInjectiveField f
  have : Normal k E := Normal.of_algEquiv e
  let g' : E →ₐ[k] L := g.comp e.symm.toAlgHom
  have hr : g'.fieldRange = E := AlgHom.fieldRange_of_normal g'
  have hmem : ∀ x, g x ∈ E.toSubalgebra := fun x => by
    have : g x ∈ g'.fieldRange := ⟨e x, by simp [g']⟩
    rw [hr] at this
    exact this
  let σ0 : k' →ₐ[k] k' := e.symm.toAlgHom.comp (g.codRestrict E.toSubalgebra hmem)
  have hσ0 : ∀ x, f (σ0 x) = g x := fun x => by
    have := congrArg Subtype.val (e.apply_symm_apply ⟨g x, hmem x⟩)
    exact this
  have hbij : Function.Bijective σ0 := AlgHom.bijective σ0
  refine ⟨AlgEquiv.ofBijective σ0 hbij, ?_⟩
  ext x
  exact (hσ0 x).symm

/-- Existence and uniqueness of the automorphism `σ` of `k'` with `ρ ∘ l = l ∘ σ`. -/
theorem exists_unique_restrict [FiniteDimensional k k'] [IsGalois k k'] {l : k' →ₐ[k] K'}
    (ρ : K' ≃ₐ[K] K') :
    ∃ σ : k' ≃ₐ[k] k', (ρ.toAlgHom.restrictScalars k).comp l = l.comp σ.toAlgHom ∧
      ∀ τ : k' ≃ₐ[k] k', (ρ.toAlgHom.restrictScalars k).comp l = l.comp τ.toAlgHom → τ = σ := by
  obtain ⟨σ, hσ⟩ := exists_comp_eq_of_galois l ((ρ.toAlgHom.restrictScalars k).comp l)
  refine ⟨σ, hσ, fun τ hτ => ?_⟩
  ext x
  have h1 := AlgHom.congr_fun hσ x
  have h2 := AlgHom.congr_fun hτ x
  simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom] at h1 h2
  exact l.injective (h2.symm.trans h1)

omit [Algebra k K] [IsScalarTower k K K'] in
/-- An automorphism of `K'` over `K` is determined by its values on a proper embedding. -/
theorem algEquiv_ext_of_proper {l : k' →ₐ[k] K'} (hl : IsProperAbove (K := K) l)
    {ρ ρ' : K' ≃ₐ[K] K'} (h : ∀ x, ρ (l x) = ρ' (l x)) : ρ = ρ' := by
  have := IntermediateField.algHom_ext_of_eq_adjoin (hS := hl.symm)
    (φ₁ := ρ.toAlgHom.comp IntermediateField.topEquiv.toAlgHom)
    (φ₂ := ρ'.toAlgHom.comp IntermediateField.topEquiv.toAlgHom) (h := fun x hx => by
      obtain ⟨y, rfl⟩ := hx
      exact h y)
  ext x
  exact AlgHom.congr_fun this ⟨x, trivial⟩

@[kb "weil1973bnt" "Ch. III, §2, Cor. 2 of Prop. 3 (the injective morphism Gal(K'/K) → G)"]
theorem weil_III_2_cor2_restrict [FiniteDimensional k k'] [IsGalois k k'] {l : k' →ₐ[k] K'}
    (hl : IsProperAbove (K := K) l) :
    ∃ φ : (K' ≃ₐ[K] K') →* (k' ≃ₐ[k] k'), Function.Injective φ ∧
      ∀ ρ : K' ≃ₐ[K] K', ∀ σ : k' ≃ₐ[k] k',
        (ρ.toAlgHom.restrictScalars k).comp l = l.comp σ.toAlgHom ↔ σ = φ ρ := by
  choose φ0 hφ0 hφ1 using fun ρ : K' ≃ₐ[K] K' => exists_unique_restrict (l := l) ρ
  have hmul : ∀ a b : K' ≃ₐ[K] K', φ0 (a * b) = φ0 a * φ0 b := by
    intro a b
    refine (hφ1 (a * b) (φ0 a * φ0 b) ?_).symm
    ext x
    have hb := AlgHom.congr_fun (hφ0 b) x
    have ha := AlgHom.congr_fun (hφ0 a) (φ0 b x)
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgHom.coe_restrictScalars'] at hb ha ⊢
    simp only [AlgEquiv.mul_apply, hb, ha]
  have hone : φ0 1 = 1 := by
    refine (hφ1 1 1 ?_).symm
    ext x
    simp
  refine ⟨{ toFun := φ0, map_one' := hone, map_mul' := hmul }, ?_, ?_⟩
  · intro a b hab
    apply algEquiv_ext_of_proper hl
    intro x
    have h1 := AlgHom.congr_fun (hφ0 a) x
    have h2 := AlgHom.congr_fun (hφ0 b) x
    simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgHom.coe_restrictScalars'] at h1 h2
    have hab' : φ0 a = φ0 b := hab
    rw [h1, h2, hab']
  · intro ρ σ
    constructor
    · intro h
      exact hφ1 ρ σ h
    · intro h
      have : σ = φ0 ρ := h
      rw [this]
      exact hφ0 ρ

@[kb "weil1973bnt" "Ch. III, §2, Cor. 2 of Prop. 3 (all proper embeddings are λ∘σ up to equivalence)"]
theorem weil_III_2_cor2_all [FiniteDimensional k k'] [IsGalois k k'] {l : k' →ₐ[k] K'}
    (hl : IsProperAbove (K := K) l) {K'' : Type*} [Field K''] [Algebra K K''] [Algebra k K'']
    [IsScalarTower k K K''] {m : k' →ₐ[k] K''} (hm : IsProperAbove (K := K) m) :
    ∃ (σ : k' ≃ₐ[k] k') (ρ : K' ≃ₐ[K] K''), m = (ρ.toAlgHom.restrictScalars k).comp (l.comp σ.toAlgHom) := by
  obtain ⟨α, hα⟩ := Field.exists_primitive_element k k'
  have h1 := isSplittingField_of_proper hα hl
  have h2 := isSplittingField_of_proper hα hm
  let ρ₀ : K' ≃ₐ[K] K'' :=
    (Polynomial.IsSplittingField.algEquiv K' ((minpoly k α).map (algebraMap k K))).trans
      (Polynomial.IsSplittingField.algEquiv K'' ((minpoly k α).map (algebraMap k K))).symm
  obtain ⟨σ, hσ⟩ := exists_comp_eq_of_galois l ((ρ₀.symm.toAlgHom.restrictScalars k).comp m)
  refine ⟨σ, ρ₀, ?_⟩
  ext x
  have := AlgHom.congr_fun hσ x
  simp only [AlgHom.comp_apply, AlgEquiv.coe_toAlgHom, AlgHom.coe_restrictScalars'] at this ⊢
  rw [← this]
  simp

end Proper

section Cor1

variable {k : Type} [Field k] [NumberField k]

/-- The $r_v$-module generated by a finite set $e\subseteq k^n$ in $k_v^n$. -/
def rvSpan (v : HeightOneSpectrum (𝓞 k)) {n : ℕ} (e : Finset (Fin n → k)) : Set (Fin n → v.adicCompletion k) :=
  {x | ∃ c : (Fin n → k) → v.adicCompletion k, (∀ u, c u ∈ v.adicCompletionIntegers k) ∧
    x = ∑ u ∈ e, c u • fun i => (u i : v.adicCompletion k)}

/-- The inclusion of `k` into the completion at `v`, as a ring homomorphism. -/
def coeRing (v : HeightOneSpectrum (𝓞 k)) : k →+* v.adicCompletion k where
  toFun x := (x : v.adicCompletion k)
  map_one' := by norm_cast
  map_mul' x y := by norm_cast
  map_zero' := by norm_cast
  map_add' x y := by norm_cast

/-- One inclusion of III.§1, Cor. 1 of Thm. 3: if `e` spans, then `rvSpan v e' ⊆ rvSpan v e` for almost
all places `v`. -/
theorem rvSpan_subset_eventually {n : ℕ} {e e' : Finset (Fin n → k)}
    (he : Submodule.span k (e : Set (Fin n → k)) = ⊤) :
    ∀ᶠ v in Filter.cofinite, rvSpan v e' ⊆ rvSpan v e := by
  classical
  have hc : ∀ u' : Fin n → k, ∃ c : (Fin n → k) → k, ∑ u ∈ e, c u • u = u' := by
    intro u'
    have : u' ∈ Submodule.span k (e : Set (Fin n → k)) := by rw [he]; trivial
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 this
    exact ⟨c, hc⟩
  choose c hc using hc
  have hfin : (⋃ u' ∈ e', ⋃ u ∈ e, HeightOneSpectrum.Support (𝓞 k) (c u' u)).Finite :=
    Set.Finite.biUnion e'.finite_toSet fun u' _ =>
      Set.Finite.biUnion e.finite_toSet fun u _ => HeightOneSpectrum.Support.finite _ _
  rw [Filter.eventually_cofinite]
  refine hfin.subset fun v hv => ?_
  by_contra hnot
  apply hv
  simp only [Set.mem_iUnion, not_exists] at hnot
  have hint : ∀ u' ∈ e', ∀ u ∈ e,
      ((c u' u : k) : v.adicCompletion k) ∈ v.adicCompletionIntegers k := by
    intro u' hu' u hu
    have := hnot u' hu' u hu
    simp only [HeightOneSpectrum.Support, Set.mem_ofPred_eq, not_lt] at this
    show Valued.v ((c u' u : k) : v.adicCompletion k) ≤ 1
    rw [HeightOneSpectrum.valuedAdicCompletion_eq_valuation']
    exact this
  rintro x ⟨d, hd, rfl⟩
  have key : ∀ u' : Fin n → k, (fun i => (u' i : v.adicCompletion k)) =
      ∑ u ∈ e, ((c u' u : k) : v.adicCompletion k) • fun i => (u i : v.adicCompletion k) := by
    intro u'
    funext i
    have h1 := congrFun (hc u') i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] at h1 ⊢
    have h2 := congrArg (coeRing v) h1
    simp only [map_sum, map_mul] at h2
    exact h2.symm
  refine ⟨fun u => if u ∈ e then ∑ u' ∈ e', d u' * ((c u' u : k) : v.adicCompletion k) else 0, ?_, ?_⟩
  · intro u
    by_cases hu : u ∈ e
    · simp only [hu, ite_true]
      exact sum_mem fun u' hu' => mul_mem (hd u') (hint u' hu' u hu)
    · simp only [hu, ite_false]
      exact zero_mem _
  · calc ∑ u' ∈ e', d u' • (fun i => (u' i : v.adicCompletion k))
        = ∑ u' ∈ e', ∑ u ∈ e, (d u' * ((c u' u : k) : v.adicCompletion k)) •
            fun i => (u i : v.adicCompletion k) := by
          refine Finset.sum_congr rfl fun u' _ => ?_
          rw [key u', Finset.smul_sum]
          simp only [smul_smul]
      _ = ∑ u ∈ e, ∑ u' ∈ e', (d u' * ((c u' u : k) : v.adicCompletion k)) •
            fun i => (u i : v.adicCompletion k) := Finset.sum_comm
      _ = _ := by
          refine Finset.sum_congr rfl fun u hu => ?_
          simp only [hu, ite_true, Finset.sum_smul]

@[kb "weil1973bnt" "Ch. III, §1, Cor. 1 of Thm. 3 (number fields, E = k^n)"]
theorem weil_III_1_cor1_thm3 {n : ℕ} {e e' : Finset (Fin n → k)}
    (he : Submodule.span k (e : Set (Fin n → k)) = ⊤) (he' : Submodule.span k (e' : Set (Fin n → k)) = ⊤) :
    ∀ᶠ v in Filter.cofinite, rvSpan v e = rvSpan v e' := by
  filter_upwards [rvSpan_subset_eventually (e' := e') he, rvSpan_subset_eventually (e' := e) he']
    with v h1 h2
  exact Set.Subset.antisymm h2 h1

end Cor1

end NumberFieldKB.WeilBNT
