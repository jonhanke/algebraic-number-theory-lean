import Mathlib.FieldTheory.Relrank
import Mathlib.Tactic.Have
import Mathlib.Algebra.Algebra.ZMod
import Mathlib.FieldTheory.Finite.Basic
import Mathlib.FieldTheory.RatFunc.IntermediateField
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import QuadFormsKB.Citation
import Mathlib.AlgebraicGeometry.EllipticCurve.DivisionPolynomial.Basic

/-!
# Milne, Elliptic Curves, Chapter IV, Proposition 9.1(a): the degree of the Frobenius map

J. S. Milne, *Elliptic Curves* (2006; bibliography key `milne2006ec`), Chapter IV, Proposition 9.1, pdf p. 156.

The Frobenius map $\varphi : (x : y : z) \mapsto (x^p : y^p : z^p)$ of an elliptic curve $E$ over $\mathbb F_p$ has
degree $[k(E) : \varphi^* k(E)]$ (Milne, Chapter I, degree of a regular map of curves).  The pullback $\varphi^*$ sends
$x \mapsto x^p$, $y \mapsto y^p$ and fixes $\mathbb F_p$, so it is the Frobenius endomorphism $u \mapsto u^p$ of the
function field $k(E) = \mathbb F_p(x, y)$, and $\varphi^* k(E) = \mathbb F_p(x^p, y^p) = k(E)^p$.

## Proved
* `prop_9_1_a`: $[k(E) : k(E)^p] = p$ (Milne's computation $[k(x, y) : k(x^p, y^p)] = [k(X) : k(X^p)] = p$).

Part (b) ($\varphi$ acts as zero on the tangent space at $O$) is not formalized: Mathlib has no tangent spaces of
curves.
-/

namespace NumberFieldKB.MilneEC

open Polynomial IntermediateField
open scoped nonZeroDivisors

section Helpers
variable (p : ℕ) [Fact p.Prime]

/-- The Frobenius algebra endomorphism over the prime field raises to the $p$-th power. -/
lemma frob_apply_eq_pow {K : Type*} [Field K] [Algebra (ZMod p) K] (x : K) :
    FiniteField.frobeniusAlgHom (ZMod p) K x = x ^ p := by
  simp [FiniteField.frobeniusAlgHom_apply, ZMod.card]

/-- The image of Frobenius on the rational function field is generated by `X ^ p`. -/
lemma frob_ratFunc_range :
    (FiniteField.frobeniusAlgHom (ZMod p) (RatFunc (ZMod p))).fieldRange =
      (ZMod p)⟮(RatFunc.X : RatFunc (ZMod p)) ^ p⟯ := by
  apply le_antisymm
  · rintro _ ⟨h, rfl⟩
    show FiniteField.frobeniusAlgHom (ZMod p) (RatFunc (ZMod p)) h ∈ _
    rw [frob_apply_eq_pow]
    have hX : (RatFunc.X : RatFunc (ZMod p)) ^ p ∈
        (ZMod p)⟮(RatFunc.X : RatFunc (ZMod p)) ^ p⟯ := mem_adjoin_simple_self _ _
    have key : ∀ q : (ZMod p)[X], (algebraMap (ZMod p)[X] (RatFunc (ZMod p)) q) ^ p ∈
        (ZMod p)⟮(RatFunc.X : RatFunc (ZMod p)) ^ p⟯ := by
      intro q
      induction q using Polynomial.induction_on' with
      | add a b ha hb =>
        rw [map_add, add_pow_char]
        exact add_mem ha hb
      | monomial n a =>
        rw [← C_mul_X_pow_eq_monomial, map_mul, map_pow, mul_pow, ← pow_mul, mul_comm n p,
          pow_mul, RatFunc.algebraMap_X]
        refine mul_mem ?_ (pow_mem hX _)
        have h1 : algebraMap (ZMod p)[X] (RatFunc (ZMod p)) (C a) =
            algebraMap (ZMod p) (RatFunc (ZMod p)) a :=
          (IsScalarTower.algebraMap_apply (ZMod p) (ZMod p)[X] (RatFunc (ZMod p)) a).symm
        rw [h1, ← map_pow, ZMod.pow_card]
        exact IntermediateField.algebraMap_mem _ _
    rw [← RatFunc.num_div_denom h, div_pow]
    exact div_mem (key _) (key _)
  · rw [adjoin_simple_le_iff]
    exact ⟨RatFunc.X, by simp⟩

/-- The rational function field has degree $p$ over the image of its Frobenius. -/
lemma frob_ratFunc_finrank :
    Module.finrank (FiniteField.frobeniusAlgHom (ZMod p) (RatFunc (ZMod p))).fieldRange
      (RatFunc (ZMod p)) = p := by
  rw [frob_ratFunc_range, RatFunc.finrank_eq_max_natDegree]
  have : (RatFunc.X : RatFunc (ZMod p)) ^ p = algebraMap (ZMod p)[X] _ (X ^ p) := by
    simp
  rw [this, RatFunc.num_algebraMap, RatFunc.denom_algebraMap]
  simp

/-- If $K$ has a copy of $\mathbb F_p(X)$ over which it has degree $2$, then it has degree $p$ over the image of
its Frobenius (tower law through $\mathbb F_p(X)$ and its image of Frobenius). -/
lemma frob_degree_of_tower {K : Type*} [Field K] [Algebra (ZMod p) K]
    (ι : RatFunc (ZMod p) →ₐ[ZMod p] K) (h2 : Module.finrank ι.fieldRange K = 2) :
    Module.finrank (FiniteField.frobeniusAlgHom (ZMod p) K).fieldRange K = p := by
  set F := FiniteField.frobeniusAlgHom (ZMod p) K with hF
  set φ := FiniteField.frobeniusAlgHom (ZMod p) (RatFunc (ZMod p)) with hφ
  have hcomm : F.comp ι = ι.comp φ := AlgHom.ext fun x => by
    simp [hF, hφ]
  have hL : ι.fieldRange = (⊤ : IntermediateField (ZMod p) (RatFunc (ZMod p))).map ι := by
    rw [AlgHom.fieldRange_eq_map]
  have hM : F.fieldRange = (⊤ : IntermediateField (ZMod p) K).map F := by
    rw [AlgHom.fieldRange_eq_map]
  have hM0 : φ.fieldRange = (⊤ : IntermediateField (ZMod p) (RatFunc (ZMod p))).map φ := by
    rw [AlgHom.fieldRange_eq_map]
  set L := ι.fieldRange
  set L' := L.map F with hL'
  have hL'eq : L' = φ.fieldRange.map ι := by
    rw [hL', hL, hM0, IntermediateField.map_map, IntermediateField.map_map, hcomm]
  have hL'M : L' ≤ F.fieldRange := by
    rw [hM]; exact IntermediateField.map_mono _ le_top
  have hL'L : L' ≤ L := by
    rw [hL'eq, hL]; exact IntermediateField.map_mono _ le_top
  have e1 : IntermediateField.relfinrank L' F.fieldRange = 2 := by
    rw [hL', hM, IntermediateField.relfinrank_map_map, IntermediateField.relfinrank_top_right]
    exact h2
  have e3 : IntermediateField.relfinrank L' L = p := by
    rw [hL'eq, hL, IntermediateField.relfinrank_map_map, IntermediateField.relfinrank_top_right]
    exact frob_ratFunc_finrank p
  have e2 := IntermediateField.relfinrank_mul_finrank_top hL'L
  have e4 := IntermediateField.relfinrank_mul_relfinrank hL'M (le_top : F.fieldRange ≤ ⊤)
  rw [IntermediateField.relfinrank_top_right, IntermediateField.relfinrank_top_right] at e4
  rw [e1] at e4
  rw [← e2, e3, h2] at e4
  omega


end Helpers

/-- **Proposition 9.1(a)** (pdf p. 156): the degree of the Frobenius map of an elliptic curve $E$ over
$\mathbb F_p$ is $p$: the function field $k(E)$ has degree $p$ over the subfield $k(E)^p = \mathbb F_p(x^p, y^p)$, the
image of the Frobenius endomorphism. -/
@[kb "milne2006ec" "Ch. IV, Proposition 9.1(a), pdf p. 156"]
theorem prop_9_1_a (p : ℕ) [Fact p.Prime] (W : WeierstrassCurve (ZMod p)) [W.IsElliptic] :
    Module.finrank (FiniteField.frobeniusAlgHom (ZMod p) W.toAffine.FunctionField).fieldRange
      W.toAffine.FunctionField = p := by
  classical
  have hinj : Function.Injective (algebraMap (ZMod p)[X] W.toAffine.FunctionField) := by
    rw [IsScalarTower.algebraMap_eq (ZMod p)[X] W.toAffine.CoordinateRing W.toAffine.FunctionField]
    exact (IsFractionRing.injective W.toAffine.CoordinateRing W.toAffine.FunctionField).comp (FaithfulSMul.algebraMap_injective _ _)
  let φ : (ZMod p)[X] →ₐ[ZMod p] W.toAffine.FunctionField := IsScalarTower.toAlgHom (ZMod p) (ZMod p)[X] W.toAffine.FunctionField
  have hφ : (ZMod p)[X]⁰ ≤ W.toAffine.FunctionField⁰.comap φ := by
    intro q hq
    exact mem_nonZeroDivisors_of_ne_zero
      fun h => nonZeroDivisors.ne_zero hq (hinj (h.trans (map_zero _).symm))
  let ι : RatFunc (ZMod p) →ₐ[ZMod p] W.toAffine.FunctionField := RatFunc.liftAlgHom φ hφ
  apply frob_degree_of_tower p ι
  let : Algebra (RatFunc (ZMod p)) W.toAffine.FunctionField := ι.toRingHom.toAlgebra
  have : IsScalarTower (ZMod p)[X] (RatFunc (ZMod p)) W.toAffine.FunctionField :=
    IsScalarTower.of_algebraMap_eq fun q => by
      show algebraMap (ZMod p)[X] W.toAffine.FunctionField q = ι (algebraMap _ _ q)
      exact (RatFunc.liftRingHom_algebraMap _ hφ q).symm
  have h1 : Module.finrank (RatFunc (ZMod p)) W.toAffine.FunctionField = 2 := by
    rw [IsFractionRing.finrank_eq (ZMod p)[X] (RatFunc (ZMod p)) W.toAffine.CoordinateRing
      W.toAffine.FunctionField,
      Module.finrank_eq_card_basis (WeierstrassCurve.Affine.CoordinateRing.basis W.toAffine)]
    simp
  rw [← h1]
  symm
  exact Algebra.finrank_eq_of_equiv_equiv (AlgEquiv.ofInjectiveField ι).toRingEquiv
    (RingEquiv.refl _) rfl

end NumberFieldKB.MilneEC
