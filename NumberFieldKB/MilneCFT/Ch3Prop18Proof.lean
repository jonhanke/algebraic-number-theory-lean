/-!
# Milne, *Class Field Theory*, Chapter III, Proposition 1.8

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`.

Let $L/K$ be finite of degree $n$, $E/K$ finite unramified Galois, $M = EL$. Then
$\mathrm{inv}_{M/L} \circ \mathrm{Res} = n \cdot \mathrm{inv}_{E/K}$ (`Ch3.prop1_8`).

Route (different from Milne's comparison of three squares): both invariant maps are Tau Ceti's invariant maps
of Brauer groups (`tcInvK_unramified`, `tcInvRel_unramified`), restriction is base change of Brauer classes
(`toBrRel_resToRel`), and base change to $L$ multiplies the invariant by $[L:K]$ (`Ch4.invMap_brBaseChange`).
The extension $M/L$ is unramified (`isUnramifiedOver_sup`): $E$ is generated by roots of unity of order prime to
the residue characteristic, and distinct such roots of unity stay distinct modulo the maximal ideal.
-/

open scoped ValuativeRel

namespace NumberFieldKB.MilneCFT.Ch3

open CategoryTheory Rep groupCohomology Limits NumberFieldKB.MilneCFT NumberFieldKB.MilneCFT.LocalCFT
open TauCeti.ClassFieldTheory IntermediateField

set_option synthInstance.maxHeartbeats 400000
set_option linter.unusedSectionVars false

/-- If $n$ is a unit and $y^n = 1$, $y \ne 1$, then $1 - y$ is a unit ($n = (1-y)\sum_{i<n}\sum_{j<i} y^j$). -/
theorem isUnit_one_sub_of_pow_eq_one {R : Type*} [CommRing R] [IsDomain R] {n : ℕ} (hn : IsUnit (n : R))
    {y : R} (hy : y ^ n = 1) (hy1 : y ≠ 1) : IsUnit (1 - y) := by
  have hs : ∑ i ∈ Finset.range n, y ^ i = 0 := by
    have h := mul_neg_geom_sum y n
    rw [hy, sub_self] at h
    exact (mul_eq_zero.1 h).resolve_left (sub_ne_zero.2 (Ne.symm hy1))
  have h : (n : R) = (1 - y) * ∑ i ∈ Finset.range n, ∑ j ∈ Finset.range i, y ^ j := by
    rw [Finset.mul_sum]
    simp_rw [mul_neg_geom_sum]
    rw [Finset.sum_sub_distrib, hs, sub_zero]
    simp
  exact isUnit_of_mul_isUnit_left (h ▸ hn)

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-- $q^f - 1$ is a unit of $\mathcal O_K$ ($q$ the cardinality of the residue field). -/
theorem isUnit_card_pow_sub_one {f : ℕ} (hf : f ≠ 0) :
    IsUnit (((Nat.card 𝓀[K] ^ f - 1 : ℕ) : 𝒪[K])) := by
  rw [← IsLocalRing.notMem_maximalIdeal, ← IsLocalRing.residue_eq_zero_iff]
  have : Fintype 𝓀[K] := Fintype.ofFinite _
  have hq : ((Nat.card 𝓀[K] : ℕ) : 𝓀[K]) = 0 := by
    rw [Nat.card_eq_fintype_card]; exact FiniteField.cast_card_eq_zero 𝓀[K]
  have h1 : 1 ≤ Nat.card 𝓀[K] ^ f := Nat.one_le_pow _ _ Nat.card_pos
  rw [map_natCast, Nat.cast_sub h1, Nat.cast_pow, hq, zero_pow hf, zero_sub]
  simp

set_option maxHeartbeats 1600000 in
/-- **An unramified extension is generated by roots of unity of order a unit of $\mathcal O_K$**
($E = K(\mu_{q^f - 1})$, Tau Ceti `eq_unramifiedExtension_finrank`). -/
theorem exists_eq_adjoin_pow_eq_one (E : IntermediateField K Ω) [FiniteDimensional K E] (hE : IsUnramifiedExt E) :
    ∃ n : ℕ, IsUnit ((n : 𝒪[K])) ∧ E = adjoin K {x : Ω | x ^ n = 1} := by
  refine withLocal E fun _ _ _ _ => ?_
  have : TauCeti.IsUnramified K E := (isUnramified_iff_isUnramifiedExt E).2 hE
  have hf : Module.finrank K E ≠ 0 := Module.finrank_pos.ne'
  refine ⟨_, isUnit_card_pow_sub_one hf, ?_⟩
  rw [← TauCeti.unramifiedExtension_eq_adjoin_setOf_pow_eq_one hf]
  exact E.eq_unramifiedExtension_finrank

set_option maxHeartbeats 1600000 in
/-- `maxIdealL M` is a proper ideal. -/
theorem maxIdealL_ne_top (M : IntermediateField K Ω) [FiniteDimensional K M] : maxIdealL M ≠ ⊤ := by
  refine withLocal M fun _ _ _ _ => ?_
  rw [maxIdealL_eq_map]
  exact (Ideal.map_isMaximal_of_equiv _ (p := 𝓂[M])).ne_top

section Sup

variable (E L : IntermediateField K Ω) [FiniteDimensional K L] [FiniteDimensional K E] [IsGalois K E]
  [FiniteDimensional K ↥(E ⊔ L)]

/-- $E$ as an intermediate field of $EL/K$. -/
noncomputable abbrev supLeft : IntermediateField K ↥(E ⊔ L) := restrict (le_sup_left : E ≤ E ⊔ L)

/-- $L$ as an intermediate field of $EL/K$. -/
noncomputable abbrev supRight : IntermediateField K ↥(E ⊔ L) := restrict (le_sup_right : L ≤ E ⊔ L)

theorem supLeft_sup_supRight : supLeft E L ⊔ supRight E L = ⊤ :=
  lift_injective _ (by rw [lift_sup, lift_restrict, lift_restrict, lift_top])

theorem galOver_eq_fixingSubgroup :
    galOver (le_sup_right : L ≤ E ⊔ L) = (supRight E L).fixingSubgroup := by
  ext σ
  rw [IntermediateField.mem_fixingSubgroup_iff]
  constructor
  · intro h x hx
    have := h ⟨x.1, (mem_restrict _ x).1 hx⟩
    exact this
  · intro h x
    exact h _ ((mem_restrict _ _).2 x.2)

instance : FiniteDimensional K (supLeft E L) :=
  (restrictAlgEquiv (le_sup_left : E ≤ E ⊔ L)).toLinearEquiv.finiteDimensional

instance : IsGalois K (supLeft E L) := IsGalois.of_algEquiv (restrictAlgEquiv (le_sup_left : E ≤ E ⊔ L))

/-- $EL/L$ is Galois (Mathlib `IsGalois.sup_right`). -/
instance isGalois_supRight : IsGalois (supRight E L) ↥(E ⊔ L) :=
  IsGalois.sup_right (supLeft E L) (supRight E L) (supLeft_sup_supRight E L)

/-- $[EL^{\mathrm{Gal}(EL/L)} : K] = [L : K]$. -/
theorem finrank_fixedField_galOver :
    Module.finrank K (fixedField (galOver (le_sup_right : L ≤ E ⊔ L))) = Module.finrank K L := by
  rw [galOver_eq_fixingSubgroup E L]
  set M := ↥(E ⊔ L)
  set L' := supRight E L
  set H := L'.fixingSubgroup
  have h1 := Module.finrank_mul_finrank K (fixedField H) M
  have h2 := Module.finrank_mul_finrank K L' M
  have hH : Module.finrank (fixedField H) M = Nat.card H := finrank_fixedField_eq_card H
  have hL' : Module.finrank L' M = Nat.card H := by
    rw [← IsGalois.card_aut_eq_finrank L' M, Nat.card_congr (fixingSubgroupEquiv L').toEquiv,
      Nat.card_eq_fintype_card]
  have hLL : Module.finrank K L' = Module.finrank K L :=
    (restrictAlgEquiv (le_sup_right : L ≤ E ⊔ L)).toLinearEquiv.finrank_eq.symm
  have hpos : 0 < Nat.card H := Nat.card_pos
  rw [hH] at h1
  rw [hL', ← h1] at h2
  rw [← hLL]
  exact (Nat.eq_of_mul_eq_mul_right hpos h2).symm

set_option maxHeartbeats 1600000 in
/-- **$EL/L$ is unramified** when $E/K$ is: the roots of unity generating $E$ stay distinct modulo the maximal ideal
of $EL$, so an automorphism of $EL/L$ acting trivially on the residue field fixes $E$, hence is trivial. -/
theorem isUnramifiedOver_sup (hE : IsUnramifiedExt E) :
    IsUnramifiedOver (E ⊔ L) (galOver (le_sup_right : L ≤ E ⊔ L)) := by
  set M := E ⊔ L
  intro σ hσ hin
  obtain ⟨n, hn, hEeq⟩ := exists_eq_adjoin_pow_eq_one E hE
  have hnM : IsUnit ((n : integers M)) := by
    have := hn.map (algebraMap 𝒪[K] (integers M))
    rwa [map_natCast] at this
  -- σ fixes every `n`-th root of unity of `M`
  have hroot : ∀ s : M, s ^ n = 1 → σ s = s := by
    intro s hs
    by_contra hne
    have hnpos : 0 < n := by
      rcases Nat.eq_zero_or_pos n with rfl | h
      · simp at hn
      · exact h
    have hsI : s ∈ integers M := by
      show IsIntegral 𝒪[K] s
      exact IsIntegral.of_pow hnpos (hs ▸ isIntegral_one)
    have htI : σ s ∈ integers M := galMap_mem_integers M σ hsI
    set s' : integers M := ⟨s, hsI⟩
    set t' : integers M := ⟨σ s, htI⟩
    have hs'n : s' ^ n = 1 := Subtype.ext (by simp [s', hs])
    have ht'n : t' ^ n = 1 := Subtype.ext (by simp [t', ← map_pow, hs])
    have hsn : s' * s' ^ (n - 1) = 1 := by rw [← pow_succ', Nat.sub_add_cancel hnpos, hs'n]
    have hs'u : IsUnit s' := ⟨⟨s', _, hsn, by rw [mul_comm]; exact hsn⟩, rfl⟩
    set y : integers M := t' * s' ^ (n - 1)
    have hsy : s' * y = t' := by
      rw [show y = t' * s' ^ (n - 1) from rfl, mul_left_comm, hsn, mul_one]
    have hyn : y ^ n = 1 := by
      rw [show y = t' * s' ^ (n - 1) from rfl, mul_pow, ht'n, one_mul, ← pow_mul, mul_comm, pow_mul,
        hs'n, one_pow]
    have hy1 : y ≠ 1 := by
      intro h
      apply hne
      have : t' = s' := by rw [← hsy, h, mul_one]
      exact congrArg Subtype.val this
    have hu : IsUnit (1 - y) := isUnit_one_sub_of_pow_eq_one hnM hyn hy1
    have hdiff : t' - s' = -(s' * (1 - y)) := by
      rw [mul_sub, mul_one, hsy]; ring
    have hdu : IsUnit (t' - s') := by rw [hdiff]; exact (hs'u.mul hu).neg
    obtain ⟨z, hz, hzeq⟩ := hin s hsI
    have hzt : z = t' - s' := Subtype.ext (by rw [hzeq]; rfl)
    exact maxIdealL_ne_top M (Ideal.eq_top_of_isUnit_mem _ hz (hzt ▸ hdu))
  have hσE : σ ∈ (supLeft E L).fixingSubgroup := by
    rw [IntermediateField.mem_fixingSubgroup_iff]
    intro x hx
    have hxE : (x : Ω) ∈ E := (mem_restrict _ x).1 hx
    -- `E ≤ lift (fixedField (zpowers σ))`
    have hle : adjoin K {x : Ω | x ^ n = 1} ≤ lift (fixedField (Subgroup.zpowers σ)) := by
      rw [adjoin_le_iff]
      intro w hw
      have hwM : w ∈ M := (le_sup_left : E ≤ M) (hEeq.ge (subset_adjoin K _ hw))
      refine (mem_lift ⟨w, hwM⟩).2 ((mem_fixedField_iff _ _).2 fun f hf => ?_)
      have hfix : σ ∈ MulAction.stabilizer Gal(M/K) (⟨w, hwM⟩ : M) := by
        rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]
        exact hroot _ (Subtype.ext (by simpa using hw))
      have := (Subgroup.zpowers_le.2 hfix) hf
      rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def] at this
      exact this
    have := (mem_lift x).1 (hle (hEeq.le hxE))
    exact (mem_fixedField_iff _ _).1 this σ (Subgroup.mem_zpowers σ)
  have hσL : σ ∈ (supRight E L).fixingSubgroup := by
    rw [← galOver_eq_fixingSubgroup E L]; exact hσ
  have : σ ∈ (supLeft E L ⊔ supRight E L).fixingSubgroup := by
    rw [fixingSubgroup_sup]; exact ⟨hσE, hσL⟩
  rw [supLeft_sup_supRight, fixingSubgroup_top] at this
  exact this

end Sup

/-! ## Restriction from $E/K$ to $M/M^H$ is base change of Brauer classes -/

section ResToRel

attribute [local instance] subVR subTop subLocal subExt

variable {E M : IntermediateField K Ω} [FiniteDimensional K M] [FiniteDimensional K E] [IsGalois K E]
  (h : E ≤ M) (H : Subgroup Gal(M/K)) [Algebra E M] [IsScalarTower K E M]
  (hEM : ∀ x : E, algebraMap E M x = IntermediateField.inclusion h x)

include hEM in
theorem relIso_resToRel (x : H2 E) :
    (relIso M H).hom.hom ((resToRel h H).hom x) =
      (groupCohomology.map ((AlgEquiv.restrictNormalHom E).comp (AlgEquiv.restrictScalarsHom K))
        (TauCeti.unitsBaseChangeHom K E (fixedField H) M) 2).hom x := by
  rw [relIso]
  erw [groupCohomology.mapIso_hom]
  rw [resToRel, ← ModuleCat.comp_apply, ← groupCohomology.map_comp]
  congr 2
  apply groupCohomology.map_congr
  · refine MonoidHom.ext fun g => AlgEquiv.ext fun y => Subtype.ext ?_
    have h1 := galRestrict_apply h ((galFixEquiv M H).symm g : Gal(M/K)) y
    have h2 := AlgEquiv.restrictNormal_commutes (g.restrictScalars K) E y
    rw [hEM, hEM] at h2
    have h3 := congrArg (fun z : M => (z : Ω)) h2
    simp only [IntermediateField.coe_inclusion] at h3
    rw [MonoidHom.comp_apply, MonoidHom.comp_apply]
    refine h1.trans (Eq.trans ?_ h3.symm)
    rfl
  · ext a
    apply Units.ext
    exact (hEM _).symm

include hEM in
/-- **Restriction $H^2(E/K) \to H^2(M/M^H)$ is base change of Brauer classes** (Milne, II, 1.27 (b)). -/
theorem toBrRel_resToRel (x : H2 E) :
    toBrRel M H ((resToRel h H).hom x) = brBaseChange K (fixedField H) (toBr E x) := by
  have e := brBaseChange_relBrInfl K (fixedField H) E M ((sepEquiv K Ω).toAlgHom.comp E.val) (embFix M H) x
  rw [toBr]
  erw [e]
  exact congrArg (relBrInfl (fixedField H) M (embFix M H)) (relIso_resToRel h H hEM x)

end ResToRel

attribute [local instance] subVR subTop subLocal subExt in
/-- **Proposition 1.8** (Milne, *CFT*, III, p. 100), at finite level: for $L/K$ finite of degree $n$ and $E/K$
finite unramified Galois, $\mathrm{inv}_{EL/L} \circ \mathrm{Res} = n \cdot \mathrm{inv}_{E/K}$ on $H^2(E/K)$. -/
@[kb "milne2020cft" "v4.03, Ch. III, Prop. 1.8, p. 100"]
theorem prop1_8 : Prop1_8 K Ω where
  res_inv := by
    intro L E _ _ _ _ hE vE hvE σE hσE vM hvM σM hσM x
    letI : Algebra E ↥(E ⊔ L) := (IntermediateField.inclusion (le_sup_left : E ≤ E ⊔ L)).toAlgebra
    haveI : IsScalarTower K E ↥(E ⊔ L) := .of_algebraMap_eq fun _ => rfl
    have hH := isUnramifiedOver_sup E L hE
    rw [← tcInvRel_unramified (E ⊔ L) _ hH hvM hσM, tcInvRel_apply,
      toBrRel_resToRel le_sup_left _ (fun _ => rfl) x, Ch4.invMap_brBaseChange,
      finrank_fixedField_galOver, map_nsmul, ← tcInvK_apply, tcInvK_unramified E hE hvE hσE]

end NumberFieldKB.MilneCFT.Ch3
