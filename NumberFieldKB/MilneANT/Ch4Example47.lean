import NumberFieldKB.MilneANT.Ch4
import NumberFieldKB.MilneANT.Ch5CubicClassGroup
import Mathlib.RingTheory.Henselian
import Mathlib.RingTheory.PicardGroup
import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal

/-!
# Milne, *Algebraic Number Theory*, Example 4.7, second claim: the class group of $\mathbb Q(\alpha)$, $\alpha^3+10\alpha+1=0$

Source: J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), Example 4.7, p. 71 (and Example 5.14, p. 95);
bib key `milne2020ant`.

**`example47ClassGroup`** proves the named statement `Example47ClassGroup` (Ch4.lean) unconditionally. Example 5.14
computes the class group of the model field `MilneCubicField = ℚ[X]/(X^3+10X+1)` (`example_5_14_classGroup`: cyclic
of order 6). A number field $K$ generated by a root $\alpha$ of $X^3+10X+1$ is isomorphic to the model field
($X^3+10X+1$ is irreducible, so it is the minimal polynomial of $\alpha$), and a ring isomorphism of Dedekind domains
induces an isomorphism of class groups (through the Picard group: Mathlib `ClassGroup.equivPic`,
`CommRing.Pic.mapRingHom`).
-/

open NumberField Polynomial

namespace NumberFieldKB.MilneANT

/-- A ring isomorphism of Dedekind domains induces an isomorphism of class groups. -/
noncomputable def classGroupEquivOfRingEquiv {R S : Type*} [CommRing R] [IsDedekindDomain R] [CommRing S]
    [IsDedekindDomain S] (e : R ≃+* S) : ClassGroup R ≃* ClassGroup S :=
  (ClassGroup.equivPic R).trans <|
    (MulEquiv.mk' ⟨CommRing.Pic.mapRingHom (e : R →+* S), CommRing.Pic.mapRingHom (e.symm : S →+* R),
      fun M => by
        rw [CommRing.Pic.mapRingHom_mapRingHom, RingEquiv.symm_comp, CommRing.Pic.mapRingHom_id_apply],
      fun M => by
        rw [CommRing.Pic.mapRingHom_mapRingHom, RingEquiv.comp_symm, CommRing.Pic.mapRingHom_id_apply]⟩
      (fun a b => map_mul (CommRing.Pic.mapRingHom (e : R →+* S)) a b)).trans (ClassGroup.equivPic S).symm

/-- A number field generated by a root of $X^3+10X+1$ is isomorphic to the model field `MilneCubicField`. -/
noncomputable def milneCubicEquiv (K : Type*) [Field K] [NumberField K] (α : 𝓞 K)
    (hα : α ^ 3 + 10 * α + 1 = 0) (hgen : IntermediateField.adjoin ℚ {(α : K)} = ⊤) :
    MilneCubicField ≃ₐ[ℚ] K := by
  have hroot : aeval (α : K) milneCubic = 0 := by
    have := congrArg (algebraMap (𝓞 K) K) hα
    simp only [map_add, map_mul, map_pow, map_one, map_zero, map_ofNat] at this
    simpa [milneCubic] using this
  have hint : IsIntegral ℚ (α : K) := ⟨milneCubic, milneCubic_monic, hroot⟩
  have hmin : minpoly ℚ (α : K) = milneCubic :=
    (minpoly.eq_of_irreducible_of_monic milneCubic_irreducible hroot milneCubic_monic).symm
  exact (AdjoinRoot.algEquivOfEq ℚ _ _ hmin.symm).trans
    ((IntermediateField.adjoinRootEquivAdjoin ℚ hint).trans
      ((IntermediateField.equivOfEq hgen).trans IntermediateField.topEquiv))

/-- **Example 4.7**, second claim (proved, unconditionally, from Example 5.14): for a number field $K$ generated by a
root $\alpha$ of $X^3 + 10X + 1$, the class group of $\mathcal O_K$ is cyclic of order $6$. -/
@[kb "milne2020ant" "v3.08, Example 4.7, p. 71; Example 5.14, p. 95"]
theorem example47ClassGroup : Example47ClassGroup where
  cyclic_six K _ _ α hα hgen := by
    let e : ClassGroup (𝓞 MilneCubicField) ≃* ClassGroup (𝓞 K) :=
      classGroupEquivOfRingEquiv (RingOfIntegers.mapRingEquiv (milneCubicEquiv K α hα hgen).toRingEquiv)
    obtain ⟨hcyc, hcard⟩ := example_5_14_classGroup
    refine ⟨isCyclic_of_surjective e.toMonoidHom e.surjective, ?_⟩
    rw [← hcard, classNumber, classNumber, ← Nat.card_eq_fintype_card, ← Nat.card_eq_fintype_card,
      Nat.card_congr e.toEquiv]

end NumberFieldKB.MilneANT
