import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.Cyclotomic.EisensteinPrimary

/-!
# Furtwängler's theorem, step 1: $(a + \zeta b)$ is a $p$-th power of an ideal

For $a^p + b^p = c^p$ with $a, b$ coprime integers and $p \nmid c$ ($p$ an odd prime), the ideal generated by
$a + \zeta b$ in $\mathbb Z[\zeta_p]$ is the $p$-th power of an ideal: $c^p = \prod_{\mu^p = 1}(a + \mu b)$
(`IsPrimitiveRoot.pow_add_pow_eq_prod_add_mul`) and the factors are pairwise coprime. Used in
`NumberFieldKB.MilneCFT.Ch8.FurtwanglerEisenstein` (Milne, *CFT*, VIII, Theorem 5.14).
-/

open NumberField Ideal

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8

variable {p : ℕ} [hp : Fact p.Prime] {K : Type} [Field K] [NumberField K] [IsCyclotomicExtension {p} ℚ K]
  {ζ : K} (hζ : IsPrimitiveRoot ζ p)

/-- The factor `a + μ b` is coprime to `a + η b` for distinct `p`-th roots of unity, given the hypotheses. -/
theorem isCoprime_add_mul_of_ne {a b c : ℤ} (h : a ^ p + b ^ p = c ^ p)
    (hab : IsCoprime a b) (hpc : ¬ (p : ℤ) ∣ c) {μ : 𝓞 K}
    (hμ : μ ∈ Polynomial.nthRootsFinset p (1 : 𝓞 K)) (hne : μ ≠ hζ.toInteger) :
    IsCoprime ((a : 𝓞 K) + hζ.toInteger * b) ((a : 𝓞 K) + μ * b) := by
  classical
  set η := hζ.toInteger with hη
  have hηp : IsPrimitiveRoot η p := hζ.toInteger_isPrimitiveRoot
  have hηmem : η ∈ Polynomial.nthRootsFinset p (1 : 𝓞 K) := hηp.mem_nthRootsFinset hp.out.pos
  obtain ⟨w, hw⟩ := (hηp.nthRootsFinset_pairwise_associated_sub_one_sub_of_prime hp.out hηmem hμ
    hne.symm).symm.dvd
  obtain ⟨u, v, huv⟩ := hab
  have huv' : (u : 𝓞 K) * a + v * b = 1 := by exact_mod_cast huv
  set x := (a : 𝓞 K) + η * b
  set y := (a : 𝓞 K) + μ * b
  have hdb : (η - μ) * b ∈ Ideal.span {x, y} := by
    have : (η - μ) * b = x - y := by simp only [x, y]; ring
    rw [this]
    exact Ideal.sub_mem _ (Ideal.subset_span (by simp)) (Ideal.subset_span (by simp))
  have hda : (η - μ) * a ∈ Ideal.span {x, y} := by
    have : (η - μ) * a = η * y - μ * x := by simp only [x, y]; ring
    rw [this]
    exact Ideal.sub_mem _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  have hd : η - μ ∈ Ideal.span {x, y} := by
    have : η - μ = u * ((η - μ) * a) + v * ((η - μ) * b) := by
      linear_combination (-(η - μ)) * huv'
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hda) (Ideal.mul_mem_left _ _ hdb)
  have hl : η - 1 ∈ Ideal.span {x, y} := by
    rw [hw]; exact Ideal.mul_mem_right _ _ hd
  have hs : ((a + b : ℤ) : 𝓞 K) ∈ Ideal.span {x, y} := by
    have : ((a + b : ℤ) : 𝓞 K) = x - b * (η - 1) := by simp only [x]; push_cast; ring
    rw [this]
    exact Ideal.sub_mem _ (Ideal.subset_span (by simp)) (Ideal.mul_mem_left _ _ hl)
  have hnd : ¬ (p : ℤ) ∣ a + b := by
    intro hd
    apply hpc
    have h1 : ((a + b : ℤ) : ZMod p) = 0 := (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).2 hd
    have h2 : ((c : ℤ) : ZMod p) = 0 := by
      have : ((c : ℤ) : ZMod p) ^ p = ((a ^ p + b ^ p : ℤ) : ZMod p) := by rw [h]; push_cast; rfl
      rw [ZMod.pow_card] at this
      rw [this]; push_cast; rw [ZMod.pow_card, ZMod.pow_card]; push_cast at h1; exact h1
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).1 h2
  have hcop : IsCoprime ((a + b : ℤ) : 𝓞 K) (η - 1) := by
    rw [hζ.isCoprime_toInteger_sub_one_iff]
    rw [IsCyclotomicExtension.Rat.zeta_sub_one_dvd_intCast_iff' p hζ]
    exact hnd
  obtain ⟨s, t, hst⟩ := hcop
  have : (1 : 𝓞 K) ∈ Ideal.span {x, y} := by
    rw [← hst]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hs) (Ideal.mul_mem_left _ _ hl)
  obtain ⟨s', t', h'⟩ := Ideal.mem_span_pair.1 this
  exact ⟨s', t', h'⟩

/-- **Step 1**: if $a^p + b^p = c^p$ with $a, b$ coprime and $p\nmid c$, then $(a + \zeta b)$ is the $p$-th power
of an ideal. -/
theorem exists_pow_eq_span (hp2 : p ≠ 2) {a b c : ℤ} (h : a ^ p + b ^ p = c ^ p) (hab : IsCoprime a b)
    (hpc : ¬ (p : ℤ) ∣ c) :
    ∃ A : Ideal (𝓞 K), A ^ p = span {(a : 𝓞 K) + hζ.toInteger * b} := by
  classical
  have hηp : IsPrimitiveRoot hζ.toInteger p := hζ.toInteger_isPrimitiveRoot
  have hodd : Odd p := hp.out.odd_of_ne_two hp2
  have hηmem : hζ.toInteger ∈ Polynomial.nthRootsFinset p (1 : 𝓞 K) :=
    hηp.mem_nthRootsFinset hp.out.pos
  have hprod : ((c : ℤ) : 𝓞 K) ^ p = (a + hζ.toInteger * b) *
      ∏ μ ∈ (Polynomial.nthRootsFinset p (1 : 𝓞 K)).erase hζ.toInteger, ((a : 𝓞 K) + μ * b) := by
    have h' : ((a : ℤ) : 𝓞 K) ^ p + ((b : ℤ) : 𝓞 K) ^ p = ((c : ℤ) : 𝓞 K) ^ p := by exact_mod_cast h
    rw [← h', IsPrimitiveRoot.pow_add_pow_eq_prod_add_mul (x := (a : 𝓞 K)) (y := (b : 𝓞 K)) (hodd := hodd) (h := hηp)]
    exact (Finset.mul_prod_erase _ (fun μ => (a : 𝓞 K) + μ * b) hηmem).symm
  have hcop : IsCoprime ((a : 𝓞 K) + hζ.toInteger * b)
      (∏ μ ∈ (Polynomial.nthRootsFinset p (1 : 𝓞 K)).erase hζ.toInteger, ((a : 𝓞 K) + μ * b)) := by
    refine IsCoprime.prod_right fun μ hμ => ?_
    exact isCoprime_add_mul_of_ne hζ h hab hpc (Finset.mem_of_mem_erase hμ)
      (Finset.ne_of_mem_erase hμ)
  have hsup : Ideal.span {(a : 𝓞 K) + hζ.toInteger * b} ⊔ Ideal.span {∏ μ ∈ (Polynomial.nthRootsFinset p (1 : 𝓞 K)).erase hζ.toInteger, ((a : 𝓞 K) + μ * b)} = ⊤ :=
    (Ideal.isCoprime_span_singleton_iff _ _).2 hcop |> Ideal.isCoprime_iff_sup_eq.1
  have hmul : Ideal.span {(a : 𝓞 K) + hζ.toInteger * b} * Ideal.span {∏ μ ∈ (Polynomial.nthRootsFinset p (1 : 𝓞 K)).erase hζ.toInteger, ((a : 𝓞 K) + μ * b)} = (Ideal.span {((c : ℤ) : 𝓞 K)}) ^ p := by
    rw [Ideal.span_singleton_mul_span_singleton, ← hprod, Ideal.span_singleton_pow]
  have hg : IsUnit (gcd (Ideal.span {(a : 𝓞 K) + hζ.toInteger * b}) (Ideal.span {∏ μ ∈ (Polynomial.nthRootsFinset p (1 : 𝓞 K)).erase hζ.toInteger, ((a : 𝓞 K) + μ * b)})) := by
    rw [Ideal.gcd_eq_sup, Ideal.isUnit_iff]
    exact hsup
  exact exists_eq_pow_of_mul_eq_pow hg hmul |>.imp fun d hd => hd.symm

end NumberFieldKB.MilneCFT.Ch8
