import NumberFieldKB.MilneCFT.Ch8.CubicTauCeti
import Mathlib.NumberTheory.NumberField.Cyclotomic.PID
import Mathlib.NumberTheory.NumberField.Cyclotomic.Three

/-!
# Arithmetic of $\mathbb Z[\zeta_3]$ used in Milne, *CFT*, VIII, Example 10.1

The prime $\lambda = \zeta - 1$ above $3$, the prime `vL`, and the comparison between divisibility by $3$ in
$\mathcal O_K$ and the $\lambda$-adic valuation.
-/

open NumberField IsDedekindDomain TauCeti

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8.Ex101

variable {K : Type} [Field K] [NumberField K] [IsCyclotomicExtension {3} ℚ K]

/-- The primitive cube root of unity as an integer. -/
def ω : 𝓞 K := (IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger

/-- $\lambda = \omega - 1$. -/
def lam : 𝓞 K := ω - 1

theorem lam_prime : Prime (lam (K := K)) :=
  (IsCyclotomicExtension.zeta_spec 3 ℚ K).zeta_sub_one_prime'

theorem omega_sq : (ω : 𝓞 K) ^ 2 + ω + 1 = 0 :=
  IsCyclotomicExtension.Rat.Three.eta_sq_add_eta_add_one (IsCyclotomicExtension.zeta_spec 3 ℚ K)

theorem lam_sq : (lam : 𝓞 K) ^ 2 = -3 * ω := by
  have := omega_sq (K := K)
  unfold lam
  linear_combination this

theorem lam_dvd_three : (lam : 𝓞 K) ∣ 3 := by
  have h := (IsCyclotomicExtension.zeta_spec 3 ℚ K).toInteger_sub_one_dvd_prime'
  simpa [lam, ω] using h

/-- The prime $(\lambda)$. -/
def vL : HeightOneSpectrum (𝓞 K) := CubicTC.specOf (lam_prime (K := K))

theorem vL_asIdeal : (vL (K := K)).asIdeal = Ideal.span {lam} := rfl

theorem three_mem_vL : (3 : 𝓞 K) ∈ (vL (K := K)).asIdeal := by
  rw [vL_asIdeal, Ideal.mem_span_singleton]; exact lam_dvd_three

theorem three_notMem_of_ne {v : HeightOneSpectrum (𝓞 K)} (hv : v ≠ vL) : (3 : 𝓞 K) ∉ v.asIdeal := by
  intro h3
  apply hv
  have h1 : (lam : 𝓞 K) ^ 2 ∈ v.asIdeal := by
    rw [lam_sq]; exact v.asIdeal.mul_mem_right _ ((Ideal.neg_mem_iff _).2 h3)
  have h2 : (lam : 𝓞 K) ∈ v.asIdeal := v.isPrime.mem_of_pow_mem 2 h1
  have h4 : (vL (K := K)).asIdeal ≤ v.asIdeal := by
    rw [vL_asIdeal, Ideal.span_le]; simpa using h2
  have := (vL (K := K)).isMaximal.eq_of_le v.isPrime.ne_top h4
  exact HeightOneSpectrum.ext this.symm

theorem val_three_vL_lt_one : (vL (K := K)).valuation K (3 : K) < 1 := by
  have := ((vL (K := K)).valuation_lt_one_iff_mem (K := K) (3 : 𝓞 K)).2 three_mem_vL
  exact_mod_cast this

theorem val_three_of_ne {v : HeightOneSpectrum (𝓞 K)} (hv : v ≠ vL) : v.valuation K (3 : K) = 1 := by
  have := (v.valuation_eq_one_iff_notMem (K := K) (r := (3 : 𝓞 K))).2 (three_notMem_of_ne hv)
  exact_mod_cast this

/-- Divisibility by $3$ in $\mathcal O_K$ versus the $\lambda$-adic valuation. -/
theorem dvd_three_iff (x : 𝓞 K) :
    (3 : 𝓞 K) ∣ x ↔ (vL (K := K)).valuation K (x : K) ≤ (vL (K := K)).valuation K (3 : K) := by
  constructor
  · rintro ⟨y, rfl⟩
    push_cast
    rw [map_mul]
    exact mul_le_of_le_one_right' ((vL (K := K)).valuation_le_one (K := K) y)
  · intro h
    have h3 : (3 : K) ≠ 0 := by norm_num
    have : ((x : K) / 3) ∈ (algebraMap (𝓞 K) K).range := by
      refine HeightOneSpectrum.mem_integers_of_valuation_le_one K _ fun v => ?_
      rw [map_div₀]
      by_cases hv : v = vL
      · subst hv
        rw [div_le_one₀ (zero_lt_iff.2 ((map_ne_zero _).2 h3))]
        exact h
      · rw [val_three_of_ne hv, div_one]
        exact v.valuation_le_one (K := K) x
    obtain ⟨y, hy⟩ := this
    refine ⟨y, ?_⟩
    apply IsFractionRing.injective (𝓞 K) K
    rw [map_mul]
    have : (algebraMap (𝓞 K) K) y = (x : K) / 3 := hy
    rw [this]
    have e3 : (algebraMap (𝓞 K) K) 3 = 3 := map_ofNat _ 3
    rw [e3]
    show (x : K) = 3 * ((x : K) / 3)
    field_simp

/-- Units congruent to $1$ modulo $3$ are $1$. -/
theorem unit_eq_one_of_dvd {u : (𝓞 K)ˣ} (h : (3 : 𝓞 K) ∣ (u : 𝓞 K) - 1) : u = 1 := by
  have hζ := IsCyclotomicExtension.zeta_spec 3 ℚ K
  rcases IsCyclotomicExtension.Rat.Three.eq_one_or_neg_one_of_unit_of_congruent hζ u
      ⟨1, by simpa using hζ.toInteger_sub_one_sq_dvd_three.trans h⟩ with h' | h'
  · exact h'
  · exfalso
    have h0 : IsPrimaryEisenstein ((0 : ℤ) : 𝓞 K) := by
      rw [isPrimaryEisenstein_iff]
      convert h using 1
      rw [h']
      push_cast
      ring
    exact absurd ((isPrimaryEisenstein_intCast_iff (a := 0)).mp h0) (by decide)

/-- Every prime ideal other than $(\lambda)$ is generated by an element congruent to $1$ modulo $3$. -/
theorem exists_gen_one_mod_three {v : HeightOneSpectrum (𝓞 K)} (hv : v ≠ vL) :
    ∃ ξ : 𝓞 K, (3 : 𝓞 K) ∣ ξ - 1 ∧ v.asIdeal = Ideal.span {ξ} := by
  have hζ := IsCyclotomicExtension.zeta_spec 3 ℚ K
  have := IsCyclotomicExtension.Rat.three_pid K
  obtain ⟨ρ, hρ⟩ := (IsPrincipalIdealRing.principal v.asIdeal).principal
  have hρ' : v.asIdeal = Ideal.span {ρ} := hρ
  have hρp : Prime ρ := by
    rw [← Ideal.span_singleton_prime, ← hρ']
    · exact v.isPrime
    · intro h0; rw [h0] at hρ'; simp at hρ'; exact v.ne_bot hρ'
  have hnd : ¬ hζ.toInteger - 1 ∣ ρ := by
    intro hd
    apply hv
    have h4 : v.asIdeal ≤ (vL (K := K)).asIdeal := by
      rw [hρ', vL_asIdeal, Ideal.span_singleton_le_span_singleton]
      exact hd
    exact HeightOneSpectrum.ext (v.isMaximal.eq_of_le (vL (K := K)).isPrime.ne_top h4)
  obtain ⟨u, hu⟩ := hζ.exists_isPrimaryEisenstein_unit_mul hnd
  refine ⟨-(u * ρ), ?_, ?_⟩
  · rw [isPrimaryEisenstein_iff] at hu
    obtain ⟨c, hc⟩ := hu
    exact ⟨-c - 1, by linear_combination -hc⟩
  · rw [hρ', Ideal.span_singleton_neg]
    exact (Ideal.span_singleton_mul_left_unit u.isUnit ρ).symm

end NumberFieldKB.MilneCFT.Ch8.Ex101
