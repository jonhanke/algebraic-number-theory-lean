import Mathlib.RingTheory.RamificationInertia.Basic
import Mathlib.RingTheory.DedekindDomain.IntegralClosure
import Mathlib.RingTheory.Ideal.GoingUp
import Mathlib.RingTheory.AdjoinRoot
import Mathlib.RingTheory.IntegralClosure.IntegrallyClosed
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed

/-!
# Completely split primes (Dedekind domains)

Let $R$ be a Dedekind domain with fraction field $K$, $L/K$ finite of degree $n$, $S$ the integral closure of $R$ in
$L$ (Dedekind, finite over $R$), and $\theta\in S$ with $L=K(\theta)$ whose minimal polynomial $F$ is monic in $R[X]$.
If $F\bmod\mathfrak p$ has $n$ distinct roots in $R/\mathfrak p$, then exactly $n$ primes of $S$ lie over
$\mathfrak p$, each with $e=f=1$.

This is the local input for the constant field extension (Weil III.§4 Thm. 4 Cor. 1 in the case of an unramified
extension generated by roots of unity of order prime to $p$).
-/

open scoped Polynomial
open Polynomial

noncomputable section

namespace NumberFieldKB.WeilBNT.FF

variable {R S : Type*} [CommRing R] [IsDedekindDomain R] [CommRing S] [IsDedekindDomain S] [Algebra R S]
  [Module.Finite R S] [Module.IsTorsionFree R S]

theorem exists_prime_over_root (P : Ideal R) [P.IsMaximal] (F : R[X])
    (θ : S) (hgen : ∀ p : R[X], aeval θ p = 0 → F ∣ p) (a : R) (ha : Polynomial.eval a F ∈ P) :
    ∃ Q : Ideal S, Q.IsPrime ∧ Q.under R = P ∧ θ - algebraMap R S a ∈ Q := by
  haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  let A : Subalgebra R S := (aeval θ : R[X] →ₐ[R] S).range
  let f : R[X] →ₐ[R] A := (aeval θ : R[X] →ₐ[R] S).rangeRestrict
  have hf : Function.Surjective (f : R[X] →+* A) := AlgHom.rangeRestrict_surjective _
  let φ : R[X] →+* R ⧸ P := eval₂RingHom (Ideal.Quotient.mk P) (Ideal.Quotient.mk P a)
  have hφF : φ F = 0 := by
    show eval₂ (Ideal.Quotient.mk P) (Ideal.Quotient.mk P a) F = 0
    rw [eval₂_at_apply, Ideal.Quotient.eq_zero_iff_mem]; exact ha
  have hker : RingHom.ker (f : R[X] →+* A) ≤ RingHom.ker φ := by
    intro p hp
    have hp' : aeval θ p = 0 := by
      have : f p = 0 := hp
      have := congrArg (fun x : A => (x : S)) this
      simpa [f] using this
    obtain ⟨g, rfl⟩ := hgen p hp'
    rw [RingHom.mem_ker, map_mul, hφF, zero_mul]
  haveI : (RingHom.ker φ).IsPrime := RingHom.ker_isPrime φ
  let M : Ideal A := (RingHom.ker φ).map (f : R[X] →+* A)
  haveI hMprime : M.IsPrime := Ideal.map_isPrime_of_surjective hf hker
  have hcomap : M.comap (f : R[X] →+* A) = RingHom.ker φ := by
    rw [Ideal.comap_map_of_surjective _ hf, ← RingHom.ker_eq_comap_bot]
    exact sup_eq_left.2 hker
  have hiff : ∀ x, f x ∈ M ↔ φ x = 0 := fun x => by
    rw [← RingHom.mem_ker, ← hcomap, Ideal.mem_comap]; rfl
  haveI : Algebra.IsIntegral A S :=Algebra.IsIntegral.tower_top R
  obtain ⟨Q, -, hQp, hQM⟩ := Ideal.exists_ideal_over_prime_of_isIntegral M (⊥ : Ideal S) (by
    intro x hx
    have : algebraMap A S x = 0 := by simpa [Ideal.under] using hx
    have : x = 0 := Subtype.ext (by simpa using this)
    simp [this])
  refine ⟨Q, hQp, ?_, ?_⟩
  · rw [← Ideal.under_under (B := A) Q, hQM]
    ext r
    simp only [Ideal.under, Ideal.mem_comap]
    have h1 : algebraMap R A r = f (C r) := by
      rw [← f.commutes, Polynomial.algebraMap_eq]
    rw [h1, hiff]
    simp [φ, Ideal.Quotient.eq_zero_iff_mem]
  · have hmem : f (X - C a) ∈ M := by
      rw [hiff]
      simp [φ]
    have : algebraMap A S (f (X - C a)) ∈ Q := by
      rw [← Ideal.mem_comap]
      have : Q.comap (algebraMap A S) = M := hQM
      rw [this]; exact hmem
    simpa [f] using this

/-- **Complete splitting.** If $\theta\in S$ is a root of a monic $F\in R[X]$ of degree $n=\operatorname{rank}_RS$
generating the kernel of $p\mapsto p(\theta)$, and
$F\bmod\mathfrak p$ has $n$ distinct roots $r_1,\dots,r_n\in R/\mathfrak p$, then the primes over $\mathfrak p$ are
exactly $n$ and all have $e=f=1$. -/
theorem primesOver_split (P : Ideal R) [P.IsMaximal] (hP : P ≠ ⊥) (F : R[X]) (hF : F.Monic)
    (hdeg : F.natDegree = Module.finrank R S) (θ : S) (hθ : aeval θ F = 0)
    (hgen : ∀ p : R[X], aeval θ p = 0 → F ∣ p)
    (r : Fin (Module.finrank R S) → R) (hr : ∀ i, Polynomial.eval (r i) F ∈ P)
    (hdist : ∀ i j, i ≠ j → r i - r j ∉ P) :
    Fintype.card (P.primesOver S) = Module.finrank R S ∧
      ∀ Q : P.primesOver S, Q.1.ramificationIdx R = 1 ∧ Q.1.inertiaDeg R = 1 := by
  haveI : Algebra.IsIntegral R S := Algebra.IsIntegral.of_finite R S
  haveI : P.IsPrime := inferInstance
  choose Q hQp hQu hQθ using fun i => exists_prime_over_root (S := S) P F θ hgen (r i) (hr i)
  let g : Fin (Module.finrank R S) → P.primesOver S := fun i =>
    ⟨Q i, hQp i, (Ideal.liesOver_iff _ _).mpr (hQu i).symm⟩
  have hinj : Function.Injective g := by
    intro i j h
    by_contra hne
    have hij : Q i = Q j := congrArg Subtype.val h
    apply hdist i j hne
    rw [← hQu i]
    have h2 : θ - algebraMap R S (r j) ∈ Q i := hij ▸ hQθ j
    have h3 := Ideal.sub_mem _ h2 (hQθ i)
    show algebraMap R S (r i - r j) ∈ Q i
    have : algebraMap R S (r i - r j) = (θ - algebraMap R S (r j)) - (θ - algebraMap R S (r i)) := by
      rw [map_sub]; ring
    rw [this]; exact h3
  have hcard : Module.finrank R S ≤ Fintype.card (P.primesOver S) := by
    simpa using Fintype.card_le_of_injective g hinj
  have hsum := Ideal.sum_ramification_inertia_eq_finrank P S
  have hpos : ∀ q : P.primesOver S, 1 ≤ q.1.ramificationIdx R * q.1.inertiaDeg R := by
    intro q
    haveI := q.2.1
    haveI := q.2.2
    have h1 : 0 < q.1.ramificationIdx R := Ideal.ramificationIdx_pos_of_isDedekindDomain' q.1 hP
    have h2 : 0 < q.1.inertiaDeg R := Ideal.inertiaDeg_pos (R := R) (q := q.1)
    exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_pos h1 h2).ne'
  have hle : ∑ q : P.primesOver S, 1 ≤ ∑ q : P.primesOver S,
      q.1.ramificationIdx R * q.1.inertiaDeg R := Finset.sum_le_sum fun q _ => hpos q
  have hcard' : Fintype.card (P.primesOver S) = Module.finrank R S := by
    have : Fintype.card (P.primesOver S) = ∑ q : P.primesOver S, 1 := by simp
    omega
  refine ⟨hcard', fun q => ?_⟩
  have heq := (Finset.sum_eq_sum_iff_of_le (s := Finset.univ) (f := fun _ : P.primesOver S => 1)
    (g := fun q => q.1.ramificationIdx R * q.1.inertiaDeg R) fun q _ => hpos q).mp
    (by simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one]; omega) q (Finset.mem_univ _)
  exact ⟨Nat.eq_one_of_mul_eq_one_right heq.symm, Nat.eq_one_of_mul_eq_one_left heq.symm⟩

end NumberFieldKB.WeilBNT.FF
