import NumberFieldKB.MilneEC.Ch1NinePointLocal
import NumberFieldKB.MilneEC.Ch1BezoutLocal

/-!
# Local intersection numbers along a curve at a nonsingular point

Part of the proof of associativity of the chord and tangent law (Milne, *Elliptic Curves*, Theorem I.3.1,
following Fulton 1969, §3.2 and §5.6). If `f` is nonsingular at `p`, then $\mathcal O_p/(f)$ is a discrete
valuation ring and $\dim_K \mathcal O_p/(f, g)$ is the order of `g` at `p` along the curve. Consequences:

* `numAt_mul`: $I(p, f \cap gh) = I(p, f \cap g) + I(p, f \cap h)$;
* `mem_span_of_numAt_le`: if $I(p, f \cap g) \le I(p, f \cap h)$ then $h \in (f, g)\mathcal O_p$;
* `numAt_line`: a line through `p` not tangent to `f` there meets `f` with multiplicity 1.
-/

open MvPolynomial

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace NumberFieldKB.MilneEC.Bezout

variable {K : Type*} [Field K]

/-- `f` passes through `p` and is nonsingular there. -/
def NonsingAt (f : MvPolynomial (Fin 2) K) (p : K × K) : Prop :=
  evalAt f p = 0 ∧ (evalAt (pderiv 0 f) p ≠ 0 ∨ evalAt (pderiv 1 f) p ≠ 0)

/-! ### Abstract part: a Noetherian local `K`-algebra whose maximal ideal is generated by a
non-nilpotent element, with residue field `K` -/

/-- Data of a uniformizer `t` of a local `K`-algebra `A` with residue field `K` (via `ev`) and `t`
not nilpotent. -/
structure Unif (K A : Type*) [Field K] [CommRing A] [Algebra K A] where
  t : A
  ev : A →ₐ[K] K
  ev_eq_zero : ∀ z, ev z = 0 ↔ z ∈ Ideal.span {t}
  pow_ne_zero : ∀ n : ℕ, t ^ n ≠ 0

namespace Unif

variable {A : Type*} [CommRing A] [Algebra K A] [IsNoetherianRing A] [IsLocalRing A]
  (U : Unif K A)

include U

theorem maxIdeal_eq : IsLocalRing.maximalIdeal A = Ideal.span {U.t} := by
  have hmax : (RingHom.ker U.ev.toRingHom).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ (fun c => ⟨algebraMap K A c, by simp⟩)
  rw [← IsLocalRing.eq_maximalIdeal hmax]
  ext z
  rw [RingHom.mem_ker]
  exact U.ev_eq_zero z

theorem eq_unit_mul_pow {a : A} (ha : a ≠ 0) :
    ∃ (n : ℕ) (u : A), IsUnit u ∧ a = u * U.t ^ n := by
  classical
  have hm := U.maxIdeal_eq
  have hne : IsLocalRing.maximalIdeal A ≠ ⊤ := (IsLocalRing.maximalIdeal.isMaximal A).ne_top
  have hK := Ideal.iInf_pow_eq_bot_of_isLocalRing (IsLocalRing.maximalIdeal A) hne
  have hex : ∃ k : ℕ, a ∉ (IsLocalRing.maximalIdeal A) ^ k := by
    by_contra h
    push Not at h
    apply ha
    have : a ∈ ⨅ i : ℕ, (IsLocalRing.maximalIdeal A) ^ i := by
      simpa [Submodule.mem_iInf] using h
    rw [hK] at this
    simpa using this
  have hN := Nat.find_spec hex
  have hN0 : Nat.find hex ≠ 0 := by
    intro h
    apply hN
    rw [h]
    simp
  obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := Nat.exists_eq_succ_of_ne_zero hN0
  have hprev : a ∈ (IsLocalRing.maximalIdeal A) ^ n := by
    by_contra h
    exact Nat.find_min hex (by omega : n < Nat.find hex) h
  rw [hn, hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hN
  rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hprev
  obtain ⟨c, hc⟩ := hprev
  refine ⟨n, c, ?_, hc.symm⟩
  by_contra hcu
  have hcm : c ∈ IsLocalRing.maximalIdeal A := hcu
  rw [hm, Ideal.mem_span_singleton'] at hcm
  obtain ⟨d, hd⟩ := hcm
  exact hN ⟨d, by rw [← hc, ← hd]; ring⟩

theorem mul_ne_zero' {a b : A} (ha : a ≠ 0) (hb : b ≠ 0) : a * b ≠ 0 := by
  obtain ⟨n, u, hu, rfl⟩ := U.eq_unit_mul_pow ha
  obtain ⟨m, v, hv, rfl⟩ := U.eq_unit_mul_pow hb
  have : u * U.t ^ n * (v * U.t ^ m) = (u * v) * U.t ^ (n + m) := by ring
  rw [this]
  intro h
  exact U.pow_ne_zero (n + m) ((hu.mul hv).mul_right_eq_zero.mp h)

theorem isDomain : IsDomain A := by
  have : Nontrivial A := U.ev.toRingHom.domain_nontrivial
  have : NoZeroDivisors A := ⟨fun {a b} h => by
    by_contra hc
    push Not at hc
    exact U.mul_ne_zero' hc.1 hc.2 h⟩
  exact NoZeroDivisors.to_isDomain A

theorem span_pow_succ_le (n : ℕ) : Ideal.span {U.t ^ (n + 1)} ≤ Ideal.span {U.t ^ n} :=
  Ideal.span_singleton_le_span_singleton.mpr (pow_dvd_pow _ (Nat.le_succ n))

/-- The transition map $A/(t^{n+1}) \to A/(t^n)$. -/
noncomputable def step (n : ℕ) : (A ⧸ Ideal.span {U.t ^ (n + 1)}) →ₗ[K] A ⧸ Ideal.span {U.t ^ n} :=
  (Ideal.Quotient.factorₐ K (U.span_pow_succ_le n)).toLinearMap

theorem step_surjective (n : ℕ) : Function.Surjective (U.step n) := by
  intro y
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨Ideal.Quotient.mk _ x, rfl⟩

theorem step_apply_mk (n : ℕ) (x : A) :
    U.step n (Ideal.Quotient.mk _ x) = Ideal.Quotient.mk _ x := rfl

theorem ker_step (n : ℕ) : LinearMap.ker (U.step n) =
    K ∙ (Ideal.Quotient.mk (Ideal.span {U.t ^ (n + 1)}) (U.t ^ n)) := by
  ext z
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
  rw [LinearMap.mem_ker, step_apply_mk, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton',
    Submodule.mem_span_singleton]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨U.ev c, ?_⟩
    have hd : c - algebraMap K A (U.ev c) ∈ Ideal.span {U.t} := by
      rw [← U.ev_eq_zero]; simp
    rw [Ideal.mem_span_singleton'] at hd
    obtain ⟨d, hd⟩ := hd
    have h1 : x = U.ev c • U.t ^ n + d * U.t ^ (n + 1) := by
      rw [Algebra.smul_def, ← hc]
      linear_combination (-(U.t ^ n)) * hd
    have h2 : Ideal.Quotient.mk (Ideal.span {U.t ^ (n + 1)}) (d * U.t ^ (n + 1)) = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
    rw [h1, map_add, h2, add_zero]
    exact (map_smul (Ideal.Quotient.mkₐ K (Ideal.span {U.t ^ (n + 1)})) (U.ev c) (U.t ^ n)).symm
  · rintro ⟨c, hc⟩
    have h : Ideal.Quotient.mk (Ideal.span {U.t ^ (n + 1)}) x =
        Ideal.Quotient.mk (Ideal.span {U.t ^ (n + 1)}) (c • U.t ^ n) := by
      rw [← hc]
      exact (map_smul (Ideal.Quotient.mkₐ K (Ideal.span {U.t ^ (n + 1)})) c (U.t ^ n))
    rw [Ideal.Quotient.eq, Ideal.mem_span_singleton'] at h
    obtain ⟨e, he⟩ := h
    refine ⟨algebraMap K A c + e * U.t, ?_⟩
    rw [Algebra.smul_def] at he
    linear_combination he

theorem mk_pow_ne_zero (n : ℕ) :
    Ideal.Quotient.mk (Ideal.span {U.t ^ (n + 1)}) (U.t ^ n) ≠ 0 := by
  haveI := U.isDomain
  intro h
  rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h
  obtain ⟨d, hd⟩ := h
  have h1 : U.t ^ n * (d * U.t - 1) = 0 := by linear_combination hd
  have h2 := (mul_eq_zero.mp h1).resolve_left (U.pow_ne_zero n)
  have h3 : d * U.t = 1 := by linear_combination h2
  have := congrArg U.ev h3
  rw [map_mul, (U.ev_eq_zero U.t).mpr (Ideal.mem_span_singleton_self _), mul_zero, map_one] at this
  exact zero_ne_one this

theorem quot_pow : ∀ n : ℕ, Module.Finite K (A ⧸ Ideal.span {U.t ^ n}) ∧
    Module.finrank K (A ⧸ Ideal.span {U.t ^ n}) = n := by
  intro n
  induction n with
  | zero =>
    have : Subsingleton (A ⧸ Ideal.span {U.t ^ 0}) := by
      rw [Ideal.Quotient.subsingleton_iff, pow_zero, Ideal.span_singleton_one]
    exact ⟨inferInstance, Module.finrank_zero_of_subsingleton⟩
  | succ n ih =>
    obtain ⟨hfin, hrank⟩ := ih
    have hsurj := U.step_surjective n
    haveI : Module.Finite K (LinearMap.ker (U.step n)) := by rw [U.ker_step n]; infer_instance
    haveI : Module.Finite K ((A ⧸ Ideal.span {U.t ^ (n + 1)}) ⧸ LinearMap.ker (U.step n)) :=
      Module.Finite.equiv ((U.step n).quotKerEquivOfSurjective hsurj).symm
    haveI : Module.Finite K (A ⧸ Ideal.span {U.t ^ (n + 1)}) :=
      Module.Finite.of_submodule_quotient (LinearMap.ker (U.step n))
    refine ⟨inferInstance, ?_⟩
    have h := LinearMap.finrank_range_add_finrank_ker (U.step n)
    rw [LinearMap.range_eq_top.mpr hsurj, finrank_top, U.ker_step n,
      finrank_span_singleton (U.mk_pow_ne_zero n)] at h
    omega

theorem not_finite_zero : ¬ Module.Finite K (A ⧸ Ideal.span {(0 : A)}) := by
  intro hfin
  obtain ⟨-, hr⟩ := U.quot_pow (Module.finrank K (A ⧸ Ideal.span {(0 : A)}) + 1)
  have hle : Ideal.span {(0 : A)} ≤ Ideal.span {U.t ^ (Module.finrank K (A ⧸ Ideal.span {(0 : A)}) + 1)} :=
    Ideal.span_singleton_le_span_singleton.mpr (dvd_zero _)
  have hs : Function.Surjective (Ideal.Quotient.factorₐ K hle).toLinearMap := by
    intro y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
    exact ⟨Ideal.Quotient.mk _ x, rfl⟩
  have := LinearMap.finrank_le_finrank_of_surjective hs
  omega

theorem ne_zero_of_finite {g : A} (h : Module.Finite K (A ⧸ Ideal.span {g})) : g ≠ 0 := by
  rintro rfl
  exact U.not_finite_zero h

theorem finite_unit_mul_pow {u : A} (hu : IsUnit u) (n : ℕ) :
    Module.Finite K (A ⧸ Ideal.span {u * U.t ^ n}) ∧
      Module.finrank K (A ⧸ Ideal.span {u * U.t ^ n}) = n := by
  rw [Ideal.span_singleton_mul_left_unit hu]
  exact U.quot_pow n

theorem finite_mul {g h : A} (hg : Module.Finite K (A ⧸ Ideal.span {g}))
    (hh : Module.Finite K (A ⧸ Ideal.span {h})) :
    Module.Finite K (A ⧸ Ideal.span {g * h}) ∧
      Module.finrank K (A ⧸ Ideal.span {g * h}) =
        Module.finrank K (A ⧸ Ideal.span {g}) + Module.finrank K (A ⧸ Ideal.span {h}) := by
  obtain ⟨n, u, hu, rfl⟩ := U.eq_unit_mul_pow (U.ne_zero_of_finite hg)
  obtain ⟨m, v, hv, rfl⟩ := U.eq_unit_mul_pow (U.ne_zero_of_finite hh)
  have e : u * U.t ^ n * (v * U.t ^ m) = (u * v) * U.t ^ (n + m) := by ring
  obtain ⟨h1, h2⟩ := U.finite_unit_mul_pow (hu.mul hv) (n + m)
  rw [e, h2, (U.finite_unit_mul_pow hu n).2, (U.finite_unit_mul_pow hv m).2]
  exact ⟨h1, rfl⟩

theorem mem_span_of_finrank_le {g h : A} (hg : Module.Finite K (A ⧸ Ideal.span {g}))
    (hle : Module.finrank K (A ⧸ Ideal.span {g}) ≤ Module.finrank K (A ⧸ Ideal.span {h})) :
    h ∈ Ideal.span {g} := by
  by_cases h0 : h = 0
  · simp [h0]
  obtain ⟨n, u, hu, rfl⟩ := U.eq_unit_mul_pow (U.ne_zero_of_finite hg)
  obtain ⟨m, v, hv, rfl⟩ := U.eq_unit_mul_pow h0
  rw [(U.finite_unit_mul_pow hu n).2, (U.finite_unit_mul_pow hv m).2] at hle
  rw [Ideal.span_singleton_mul_left_unit hu, Ideal.mem_span_singleton']
  refine ⟨v * U.t ^ (m - n), ?_⟩
  rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hle]

end Unif

/-! ### Concrete part: the local ring of the plane at `p` -/

/-- The coordinate function `X i - p_i`. -/
noncomputable def xx (p : K × K) (i : Fin 2) : MvPolynomial (Fin 2) K :=
  X i - C (![p.1, p.2] i)

theorem xx_zero (p : K × K) : xx p 0 = X 0 - C p.1 := by simp [xx]

theorem xx_one (p : K × K) : xx p 1 = X 1 - C p.2 := by simp [xx]

theorem evalAt_xx (p : K × K) (i : Fin 2) : evalAt (xx p i) p = 0 := by
  simp [xx, evalAt]

theorem evalAt_add (p : K × K) (a b : MvPolynomial (Fin 2) K) :
    evalAt (a + b) p = evalAt a p + evalAt b p := by simp [evalAt]

theorem evalAt_mul (p : K × K) (a b : MvPolynomial (Fin 2) K) :
    evalAt (a * b) p = evalAt a p * evalAt b p := by simp [evalAt]

theorem evalAt_X0 (p : K × K) : evalAt (X 0 : MvPolynomial (Fin 2) K) p = p.1 := by simp [evalAt]

theorem evalAt_X1 (p : K × K) : evalAt (X 1 : MvPolynomial (Fin 2) K) p = p.2 := by simp [evalAt]

theorem evalAt_C (p : K × K) (c : K) : evalAt (C c : MvPolynomial (Fin 2) K) p = c := by
  simp [evalAt]

/-- Taylor expansion to first order at `p`. -/
theorem taylor (p : K × K) (q : MvPolynomial (Fin 2) K) :
    ∃ u v : MvPolynomial (Fin 2) K,
      q = C (evalAt q p) + xx p 0 * u + xx p 1 * v ∧
      evalAt u p = evalAt (pderiv 0 q) p ∧ evalAt v p = evalAt (pderiv 1 q) p := by
  simp only [xx_zero, xx_one]
  induction q using MvPolynomial.induction_on with
  | C a => exact ⟨0, 0, by simp [evalAt], by simp [evalAt], by simp [evalAt]⟩
  | add q r hq hr =>
    obtain ⟨u, v, h, hu, hv⟩ := hq
    obtain ⟨u', v', h', hu', hv'⟩ := hr
    refine ⟨u + u', v + v', ?_, ?_, ?_⟩
    · have : evalAt (q + r) p = evalAt q p + evalAt r p := by simp [evalAt]
      rw [this, C_add]
      linear_combination h + h'
    · simp only [evalAt, map_add] at hu hu' ⊢
      rw [hu, hu']
    · simp only [evalAt, map_add] at hv hv' ⊢
      rw [hv, hv']
  | mul_X q i hq =>
    obtain ⟨u, v, h, hu, hv⟩ := hq
    have hi : i = 0 ∨ i = 1 := by fin_cases i <;> simp
    rcases hi with rfl | rfl
    · have d0 : pderiv 0 (q * X 0) = q + X 0 * pderiv 0 q := by
        rw [Derivation.leibniz]; simp [pderiv_X]
      have d1 : pderiv 1 (q * X 0) = X 0 * pderiv 1 q := by
        rw [Derivation.leibniz]; simp [pderiv_X]
      refine ⟨C (evalAt q p) + u * X 0, v * X 0, ?_, ?_, ?_⟩
      · rw [evalAt_mul, evalAt_X0, C_mul]
        linear_combination (X 0 : MvPolynomial (Fin 2) K) * h
      · rw [d0, evalAt_add, evalAt_mul, evalAt_add, evalAt_mul, evalAt_X0, evalAt_C, hu]
        ring
      · rw [d1, evalAt_mul, evalAt_mul, evalAt_X0, hv]
        ring
    · have d0 : pderiv 0 (q * X 1) = X 1 * pderiv 0 q := by
        rw [Derivation.leibniz]; simp [pderiv_X]
      have d1 : pderiv 1 (q * X 1) = q + X 1 * pderiv 1 q := by
        rw [Derivation.leibniz]; simp [pderiv_X]
      refine ⟨u * X 1, C (evalAt q p) + v * X 1, ?_, ?_, ?_⟩
      · rw [evalAt_mul, evalAt_X1, C_mul]
        linear_combination (X 1 : MvPolynomial (Fin 2) K) * h
      · rw [d0, evalAt_mul, evalAt_mul, evalAt_X1, hu]
        ring
      · rw [d1, evalAt_add, evalAt_mul, evalAt_add, evalAt_mul, evalAt_X1, evalAt_C, hv]
        ring

theorem mem_span_xx (p : K × K) {z : LocalRingAt p} (hz : evAt p z = 0) :
    z ∈ Ideal.span (Set.range fun k : Fin 2 =>
      algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) (xx p k)) := by
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective (pointIdeal p).primeCompl z
  have h1 := IsLocalization.mk'_spec (LocalRingAt p) a s
  have ha : evalAt a p = 0 := by
    have := congrArg (evAt p) h1
    rw [map_mul, hz, zero_mul, evAt_algebraMap] at this
    exact this.symm
  obtain ⟨u, v, huv, -, -⟩ := taylor p a
  rw [ha, map_zero, zero_add] at huv
  show IsLocalization.mk' (LocalRingAt p) a s ∈ _
  rw [IsLocalization.mk'_eq_mul_mk'_one]
  refine Ideal.mul_mem_right _ _ ?_
  rw [huv, map_add, map_mul, map_mul]
  exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, rfl⟩))
    (Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨1, rfl⟩))

/-- The evaluation at `p` on $\mathcal O_p/(f)$. -/
noncomputable def evA (p : K × K) (f : MvPolynomial (Fin 2) K) (hf : evalAt f p = 0) :
    (LocalRingAt p ⧸ Ideal.span {algebraMap _ (LocalRingAt p) f}) →ₐ[K] K :=
  Ideal.Quotient.liftₐ _ (evAt p) (fun a ha => by
    obtain ⟨b, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    rw [map_mul, evAt_algebraMap]
    exact mul_eq_zero_of_right _ hf)

theorem evA_mk (p : K × K) (f : MvPolynomial (Fin 2) K) (hf : evalAt f p = 0) (z : LocalRingAt p) :
    evA p f hf (Ideal.Quotient.mk _ z) = evAt p z := rfl

theorem fin2_cases : ∀ i j k : Fin 2, i ≠ j → k = i ∨ k = j := by decide

theorem taylor_ij (p : K × K) {f : MvPolynomial (Fin 2) K} (hf : evalAt f p = 0) {i j : Fin 2}
    (hij : i ≠ j) : ∃ U W : MvPolynomial (Fin 2) K,
      f = xx p i * U + xx p j * W ∧ evalAt W p = evalAt (pderiv j f) p := by
  obtain ⟨u, v, h, hu, hv⟩ := taylor p f
  rw [hf, map_zero, zero_add] at h
  have hc : (i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0) := by
    revert i j; decide
  rcases hc with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact ⟨u, v, h, hv⟩
  · exact ⟨v, u, by rw [h]; ring, hu⟩

theorem prime_xx (p : K × K) (i : Fin 2) : Prime (xx p i) := by
  let e : MvPolynomial (Fin 2) K ≃ₐ[K] MvPolynomial (Fin 2) K :=
    AlgEquiv.ofAlgHom (tr (-p)) (tr p) (AlgHom.ext (tr_neg_tr p)) (AlgHom.ext (tr_tr_neg p))
  have hx : e (X i) = xx p i := by
    show tr (-p) (X i) = xx p i
    fin_cases i <;> simp [tr, xx, sub_eq_add_neg]
  rw [← hx]
  exact (MulEquiv.prime_iff e).mpr X_prime

theorem no_pow_dvd (p : K × K) {f : MvPolynomial (Fin 2) K} {i j : Fin 2} (hij : i ≠ j)
    (hj : evalAt (pderiv j f) p ≠ 0) (hfp : evalAt f p = 0) :
    ∀ (n : ℕ) (s v : MvPolynomial (Fin 2) K), xx p i ^ n * s = f * v → evalAt s p = 0 := by
  intro n
  induction n with
  | zero =>
    intro s v h
    rw [pow_zero, one_mul] at h
    rw [h, evalAt_mul, hfp, zero_mul]
  | succ n ih =>
    intro s v h
    have hd : xx p i ∣ f * v := ⟨xx p i ^ n * s, by rw [← h]; ring⟩
    rcases (prime_xx p i).dvd_or_dvd hd with ⟨q, hq⟩ | ⟨v', hv'⟩
    · exfalso
      apply hj
      have hxd : pderiv j (xx p i) = 0 := by
        simp [xx, pderiv_X, Pi.single_eq_of_ne hij]
      rw [hq, Derivation.leibniz, hxd]
      simp only [smul_eq_mul, mul_zero, add_zero, evalAt_mul, evalAt_xx, zero_mul]
    · refine ih s v' (mul_left_cancel₀ (prime_xx p i).ne_zero ?_)
      rw [hv'] at h
      linear_combination h

theorem mk_xx_pow_ne_zero (p : K × K) {f : MvPolynomial (Fin 2) K} {i j : Fin 2} (hij : i ≠ j)
    (hj : evalAt (pderiv j f) p ≠ 0) (hfp : evalAt f p = 0) (n : ℕ) :
    (Ideal.Quotient.mk (Ideal.span {algebraMap _ (LocalRingAt p) f})
      (algebraMap _ (LocalRingAt p) (xx p i))) ^ n ≠ 0 := by
  intro h
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton'] at h
  obtain ⟨b, hb⟩ := h
  obtain ⟨⟨v, s⟩, rfl⟩ := IsLocalization.mk'_surjective (pointIdeal p).primeCompl b
  have h1 := IsLocalization.mk'_spec (LocalRingAt p) v s
  have h2 : algebraMap _ (LocalRingAt p) (xx p i ^ n * (s : MvPolynomial (Fin 2) K)) =
      algebraMap _ (LocalRingAt p) (f * v) := by
    rw [map_mul, map_pow, ← hb, map_mul _ f v, ← h1]
    ring
  have h3 := IsLocalization.injective (LocalRingAt p)
    (Ideal.primeCompl_le_nonZeroDivisors (pointIdeal p)) h2
  have h4 := no_pow_dvd p hij hj hfp n s v h3
  exact s.2 ((mem_pointIdeal_iff p _).mpr h4)

theorem exists_unif_core (p : K × K) {f : MvPolynomial (Fin 2) K} {i j : Fin 2} (hij : i ≠ j)
    (hj : evalAt (pderiv j f) p ≠ 0) (hfp : evalAt f p = 0) :
    ∃ U : Unif K (LocalRingAt p ⧸ Ideal.span {algebraMap _ (LocalRingAt p) f}),
      U.ev = evA p f hfp := by
  have hf0 : Ideal.Quotient.mk (Ideal.span {algebraMap _ (LocalRingAt p) f})
      (algebraMap _ (LocalRingAt p) f) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
  obtain ⟨t, ht⟩ : ∃ t : LocalRingAt p ⧸ Ideal.span {algebraMap _ (LocalRingAt p) f},
      t = Ideal.Quotient.mk _ (algebraMap _ (LocalRingAt p) (xx p i)) := ⟨_, rfl⟩
  have hjt : Ideal.Quotient.mk (Ideal.span {algebraMap _ (LocalRingAt p) f})
      (algebraMap _ (LocalRingAt p) (xx p j)) ∈ Ideal.span {t} := by
    rw [ht]
    obtain ⟨U, W, hfe, hW⟩ := taylor_ij p hfp hij
    have hWu : IsUnit (algebraMap _ (LocalRingAt p) W) :=
      (isUnit_iff_evAt p _).mpr (by rw [evAt_algebraMap]; show evalAt W p ≠ 0; rw [hW]; exact hj)
    obtain ⟨w', hw'⟩ := hWu.exists_right_inv
    have this := congrArg (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p)) hfe
    rw [map_add, map_mul, map_mul] at this
    have e1 : algebraMap _ (LocalRingAt p) (xx p j) =
        (algebraMap _ (LocalRingAt p) f -
          algebraMap _ (LocalRingAt p) (xx p i) * algebraMap _ (LocalRingAt p) U) * w' := by
      linear_combination (-w') * this + (-(algebraMap _ (LocalRingAt p) (xx p j))) * hw'
    rw [Ideal.mem_span_singleton']
    refine ⟨-(Ideal.Quotient.mk _ (algebraMap _ (LocalRingAt p) U) * Ideal.Quotient.mk _ w'), ?_⟩
    rw [e1, map_mul, map_sub, map_mul, hf0]
    ring
  refine ⟨⟨t, evA p f hfp, ?_, fun n => by rw [ht]; exact mk_xx_pow_ne_zero p hij hj hfp n⟩, rfl⟩
  intro z
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective z
  rw [evA_mk]
  constructor
  · intro hz
    have hmem := mem_span_xx p hz
    have hle : Ideal.span (Set.range fun k : Fin 2 =>
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) (xx p k)) ≤
        Ideal.comap (Ideal.Quotient.mk (Ideal.span {algebraMap _ (LocalRingAt p) f}))
          (Ideal.span {t}) := by
      rw [Ideal.span_le]
      rintro _ ⟨k, rfl⟩
      rcases fin2_cases i j k hij with rfl | rfl
      · rw [SetLike.mem_coe, Ideal.mem_comap, ht]
        exact Ideal.mem_span_singleton_self _
      · exact hjt
    exact hle hmem
  · intro hz
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hz
    have h0 : evA p f hfp t = 0 := by
      rw [ht, evA_mk, evAt_algebraMap]
      exact evalAt_xx p i
    show evA p f hfp (Ideal.Quotient.mk _ z) = 0
    rw [← hc, map_mul, h0, mul_zero]

theorem exists_unif (p : K × K) {f : MvPolynomial (Fin 2) K} (hf : NonsingAt f p) :
    ∃ U : Unif K (LocalRingAt p ⧸ Ideal.span {algebraMap _ (LocalRingAt p) f}),
      U.ev = evA p f hf.1 := by
  rcases hf.2 with h | h
  · exact exists_unif_core p (i := 1) (j := 0) (by decide) h hf.1
  · exact exists_unif_core p (i := 0) (j := 1) (by decide) h hf.1

/-! ### Passing between `O/(f, g)` and `(O/(f))/(g)` -/

section Pair

variable {R : Type*} [CommRing R] [Algebra K R] (a b : R)

/-- $R/(a, b) \cong (R/(a))/(\bar b)$. -/
noncomputable def pairEquiv : (R ⧸ Ideal.span {a, b}) ≃ₐ[K]
    (R ⧸ Ideal.span {a}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {a}) b} :=
  (Ideal.quotientEquivAlgOfEq K (Ideal.span_insert a {b})).trans
    ((DoubleQuot.quotQuotEquivQuotSupₐ K (Ideal.span {a}) (Ideal.span {b})).symm.trans
      (Ideal.quotientEquivAlgOfEq K (by
        rw [Ideal.map_span, Set.image_singleton]
        rfl)))

theorem finrank_pair_eq : Module.finrank K (R ⧸ Ideal.span {a, b}) =
    Module.finrank K ((R ⧸ Ideal.span {a}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {a}) b}) :=
  (pairEquiv (K := K) a b).toLinearEquiv.finrank_eq

theorem finite_pair_iff : Module.Finite K (R ⧸ Ideal.span {a, b}) ↔
    Module.Finite K ((R ⧸ Ideal.span {a}) ⧸ Ideal.span {Ideal.Quotient.mk (Ideal.span {a}) b}) :=
  ⟨fun h => by
      haveI := h
      exact Module.Finite.equiv (pairEquiv (K := K) a b).toLinearEquiv,
    fun h => by
      haveI := h
      exact Module.Finite.equiv (pairEquiv (K := K) a b).symm.toLinearEquiv⟩

end Pair

theorem isLocalRing_QA (p : K × K) (f : MvPolynomial (Fin 2) K)
    (U : Unif K (LocalRingAt p ⧸ Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})) :
    IsLocalRing (LocalRingAt p ⧸ Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f}) := by
  have : Nontrivial (LocalRingAt p ⧸
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f}) :=
    U.ev.toRingHom.domain_nontrivial
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-! ### The three theorems -/

theorem numAt_mul {f g h : MvPolynomial (Fin 2) K} {p : K × K} (hf : NonsingAt f p)
    (hg : Module.Finite K (LocalQuotientAt f g p)) (hh : Module.Finite K (LocalQuotientAt f h p)) :
    Module.Finite K (LocalQuotientAt f (g * h) p) ∧
      numAt f (g * h) p = numAt f g p + numAt f h p := by
  obtain ⟨U, -⟩ := exists_unif p hf
  haveI := isLocalRing_QA p f U
  have e : Ideal.Quotient.mk (Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})
        (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) (g * h)) =
      Ideal.Quotient.mk (Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})
        (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) g) *
      Ideal.Quotient.mk (Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})
        (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) h) := by
    rw [map_mul, map_mul]
  have hg' := (finite_pair_iff (K := K) (algebraMap _ (LocalRingAt p) f)
    (algebraMap _ (LocalRingAt p) g)).mp hg
  have hh' := (finite_pair_iff (K := K) (algebraMap _ (LocalRingAt p) f)
    (algebraMap _ (LocalRingAt p) h)).mp hh
  obtain ⟨h1, h2⟩ := U.finite_mul hg' hh'
  rw [← e] at h1 h2
  refine ⟨(finite_pair_iff (K := K) (algebraMap _ (LocalRingAt p) f)
    (algebraMap _ (LocalRingAt p) (g * h))).mpr h1, ?_⟩
  show Module.finrank K (LocalQuotientAt f (g * h) p) = Module.finrank K (LocalQuotientAt f g p) +
    Module.finrank K (LocalQuotientAt f h p)
  rw [finrank_pair_eq (K := K) (algebraMap _ (LocalRingAt p) f) (algebraMap _ (LocalRingAt p) g),
    finrank_pair_eq (K := K) (algebraMap _ (LocalRingAt p) f) (algebraMap _ (LocalRingAt p) h),
    finrank_pair_eq (K := K) (algebraMap _ (LocalRingAt p) f) (algebraMap _ (LocalRingAt p) (g * h))]
  exact h2

theorem mem_span_of_numAt_le {f g h : MvPolynomial (Fin 2) K} {p : K × K} (hf : NonsingAt f p)
    (hg : Module.Finite K (LocalQuotientAt f g p)) (hle : numAt f g p ≤ numAt f h p) :
    algebraMap _ (LocalRingAt p) h ∈
      Ideal.span {algebraMap _ (LocalRingAt p) f, algebraMap _ (LocalRingAt p) g} := by
  obtain ⟨U, -⟩ := exists_unif p hf
  haveI := isLocalRing_QA p f U
  have hg' := (finite_pair_iff (K := K) (algebraMap _ (LocalRingAt p) f)
    (algebraMap _ (LocalRingAt p) g)).mp hg
  have hle' : Module.finrank K (LocalQuotientAt f g p) ≤ Module.finrank K (LocalQuotientAt f h p) :=
    hle
  rw [finrank_pair_eq (K := K) (algebraMap _ (LocalRingAt p) f) (algebraMap _ (LocalRingAt p) g),
    finrank_pair_eq (K := K) (algebraMap _ (LocalRingAt p) f) (algebraMap _ (LocalRingAt p) h)]
    at hle'
  have hmem := U.mem_span_of_finrank_le hg' hle'
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
  obtain ⟨c', rfl⟩ := Ideal.Quotient.mk_surjective c
  have h1 : Ideal.Quotient.mk (Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})
        (algebraMap _ (LocalRingAt p) h) =
      Ideal.Quotient.mk (Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f})
        (c' * algebraMap _ (LocalRingAt p) g) := by
    rw [map_mul, hc]
  have h2 := Ideal.Quotient.eq.mp h1.symm
  have h4 : c' * algebraMap _ (LocalRingAt p) g - algebraMap _ (LocalRingAt p) h ∈
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) g} :=
    Ideal.span_mono (by
      intro x hx
      rw [Set.mem_singleton_iff.mp hx]
      exact Set.mem_insert _ _) h2
  have h5 : c' * algebraMap _ (LocalRingAt p) g ∈
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) g} :=
    Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))
  have := Ideal.sub_mem _ h5 h4
  rwa [sub_sub_cancel] at this

theorem evalAt_sub (p : K × K) (a b : MvPolynomial (Fin 2) K) :
    evalAt (a - b) p = evalAt a p - evalAt b p := by simp [evalAt]

/-- The evaluation at `p` on $\mathcal O_p/(f, g)$. -/
noncomputable def evQ (p : K × K) {f g : MvPolynomial (Fin 2) K} (hf : evalAt f p = 0)
    (hg : evalAt g p = 0) : LocalQuotientAt f g p →ₐ[K] K :=
  Ideal.Quotient.liftₐ _ (evAt p) (fun a ha => by
    have : Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) g} ≤
        RingHom.ker (evAt p).toRingHom := by
      rw [Ideal.span_le]
      rintro a (rfl | rfl)
      · exact (RingHom.mem_ker).mpr (by
          show evAt p _ = 0
          rw [evAt_algebraMap]; exact hf)
      · exact (RingHom.mem_ker).mpr (by
          show evAt p _ = 0
          rw [evAt_algebraMap]; exact hg)
    exact (RingHom.mem_ker).mp (this ha))

theorem evQ_mk (p : K × K) {f g : MvPolynomial (Fin 2) K} (hf : evalAt f p = 0)
    (hg : evalAt g p = 0) (z : LocalRingAt p) : evQ p hf hg (Ideal.Quotient.mk _ z) = evAt p z :=
  rfl

/-- Transversal intersection: if `g` passes through `p` and the gradients of `f` and `g` at `p` are
independent, then $I_p(f, g) = 1$ (Fulton 1969, §3.3, property (5), the transversal case). -/
theorem numAt_eq_one_of_det {f l : MvPolynomial (Fin 2) K} {p : K × K} (hf : NonsingAt f p)
    (hlp : evalAt l p = 0)
    (hnt : evalAt (pderiv 0 f) p * evalAt (pderiv 1 l) p -
      evalAt (pderiv 1 f) p * evalAt (pderiv 0 l) p ≠ 0) :
    Module.Finite K (LocalQuotientAt f l p) ∧ numAt f l p = 1 := by
  have hfp := hf.1
  obtain ⟨u', v', hfe, hu', hv'⟩ := taylor p f
  obtain ⟨u, v, hle, hu, hv⟩ := taylor p l
  rw [hfp, map_zero, zero_add] at hfe
  rw [hlp, map_zero, zero_add] at hle
  obtain ⟨δ, hδ⟩ : ∃ δ : MvPolynomial (Fin 2) K, δ = u' * v - v' * u := ⟨_, rfl⟩
  have hδev : evalAt δ p ≠ 0 := by
    rw [hδ, evalAt_sub, evalAt_mul, evalAt_mul, hu', hv', hu, hv]
    exact hnt
  have hδu : IsUnit (algebraMap _ (LocalRingAt p) δ) :=
    (isUnit_iff_evAt p _).mpr (by rw [evAt_algebraMap]; exact hδev)
  obtain ⟨d, hd⟩ := hδu.exists_right_inv
  have E0 : xx p 0 * δ = v * f - v' * l := by
    rw [hδ]; linear_combination (-v) * hfe + v' * hle
  have E1 : xx p 1 * δ = u' * l - u * f := by
    rw [hδ]; linear_combination u * hfe + (-u') * hle
  have E0' := congrArg (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p)) E0
  have E1' := congrArg (algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p)) E1
  rw [map_mul, map_sub, map_mul, map_mul] at E0' E1'
  have hx0 : algebraMap _ (LocalRingAt p) (xx p 0) ∈
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) l} := by
    have e : algebraMap _ (LocalRingAt p) (xx p 0) =
        (algebraMap _ (LocalRingAt p) v * algebraMap _ (LocalRingAt p) f -
          algebraMap _ (LocalRingAt p) v' * algebraMap _ (LocalRingAt p) l) *
          d := by
      linear_combination d * E0' + (-(algebraMap _ (LocalRingAt p) (xx p 0))) * hd
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.sub_mem _
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _)))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl))))
  have hx1 : algebraMap _ (LocalRingAt p) (xx p 1) ∈
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) l} := by
    have e : algebraMap _ (LocalRingAt p) (xx p 1) =
        (algebraMap _ (LocalRingAt p) u' * algebraMap _ (LocalRingAt p) l -
          algebraMap _ (LocalRingAt p) u * algebraMap _ (LocalRingAt p) f) *
          d := by
      linear_combination d * E1' + (-(algebraMap _ (LocalRingAt p) (xx p 1))) * hd
    rw [e]
    exact Ideal.mul_mem_right _ _ (Ideal.sub_mem _
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert_of_mem _ rfl)))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))))
  have hker : ∀ z : LocalRingAt p, evAt p z = 0 → z ∈
      Ideal.span {algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) f,
        algebraMap (MvPolynomial (Fin 2) K) (LocalRingAt p) l} := by
    intro z hz
    refine (Ideal.span_le.mpr ?_) (mem_span_xx p hz)
    rintro _ ⟨k, rfl⟩
    rcases fin2_cases 0 1 k (by decide) with rfl | rfl
    · exact hx0
    · exact hx1
  have hinj : Function.Injective (evQ p hfp hlp) := by
    rw [injective_iff_map_eq_zero]
    intro y hy
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective y
    rw [evQ_mk] at hy
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (hker z hy)
  have hsurj : Function.Surjective (evQ p hfp hlp) := fun c => ⟨algebraMap K _ c, by simp⟩
  let e := AlgEquiv.ofBijective (evQ p hfp hlp) ⟨hinj, hsurj⟩
  refine ⟨Module.Finite.equiv e.symm.toLinearEquiv, ?_⟩
  show Module.finrank K (LocalQuotientAt f l p) = 1
  rw [e.toLinearEquiv.finrank_eq, Module.finrank_self]

theorem numAt_line {f l : MvPolynomial (Fin 2) K} {p : K × K} (hf : NonsingAt f p)
    (_hl : l.totalDegree ≤ 1) (hlp : evalAt l p = 0)
    (hnt : evalAt (pderiv 0 f) p * evalAt (pderiv 1 l) p -
      evalAt (pderiv 1 f) p * evalAt (pderiv 0 l) p ≠ 0) :
    Module.Finite K (LocalQuotientAt f l p) ∧ numAt f l p = 1 :=
  numAt_eq_one_of_det hf hlp hnt

end NumberFieldKB.MilneEC.Bezout
