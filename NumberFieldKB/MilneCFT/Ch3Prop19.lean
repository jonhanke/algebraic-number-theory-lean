import Mathlib.FieldTheory.IsSepClosed
import Mathlib.NumberTheory.LocalField.Basic
import Mathlib.RepresentationTheory.Homological.TateCohomology.Basic
import QuadFormsKB.Citation
import NumberFieldKB.MilneCFT.Ch3Split
import NumberFieldKB.MilneCFT.Ch3TateZero
import NumberFieldKB.MilneCFT.Ch3Unramified

/-!
# Milne, *Class Field Theory*, Chapter III §1: Proposition 1.9

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`.
Locators give Milne's printed page numbers (printed page = pdf page − 9).

Let $L/K$ be finite unramified with group $G$, generated by the Frobenius element $\sigma$, $n = [L:K]$, and $\pi$ a
prime element of $K$. Milne's explicit description of Tate's isomorphism (p. 102): the cocycle
$\varphi(\sigma^i, \sigma^j) = 1$ or $\pi$ (`carryCocycle`, representing $u_{L/K}$), its splitting module
$L^\times(\varphi)$, and the connecting maps
$$G \simeq H_1(G, \mathbb Z) = H^{-2}_T(G, \mathbb Z) \xrightarrow{\delta} H^{-1}_T(G, I_G) \xrightarrow{\delta}
H^0_T(G, L^\times) = K^\times/\mathrm{Nm}(L^\times)$$
of $0 \to I_G \to \mathbb Z[G] \to \mathbb Z \to 0$ (`augSeq`) and $0 \to L^\times \to L^\times(\varphi) \to I_G \to 0$
(`splitSeq`).
-/

open scoped ValuativeRel

namespace NumberFieldKB.MilneCFT.Ch3

open CategoryTheory Rep groupCohomology Limits NumberFieldKB.MilneCFT NumberFieldKB.MilneCFT.LocalCFT

set_option synthInstance.maxHeartbeats 400000
set_option linter.unusedSectionVars false

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-- The prime element $\pi$, as a $G$-fixed element of the $G$-module $L^\times$. -/
theorem prime_fixed (L : IntermediateField K Ω) {π : 𝒪[K]} (hπ : Irreducible π) (g : Gal(L/K)) :
    (Rep.ofAlgebraAutOnUnits K L).ρ g (Additive.ofMul (embUnits L (primeUnit hπ))) =
      Additive.ofMul (embUnits L (primeUnit hπ)) :=
  congrArg Additive.ofMul (gal_smul_embUnits L g _)

open Classical in
/-- The composite $G \to H^0_T(G, L^\times) = K^\times/\mathrm{Nm}(L^\times)$ of Proposition 1.9, applied to an
element $\tau \in G$: $\tau \mapsto [\tau] \in H_1(G, \mathbb Z) = H^{-2}_T(G, \mathbb Z)$, then the connecting maps
of `augSeq` and `splitSeq` for the carry cocycle of $(\sigma, \pi)$. -/
noncomputable def prop19Map (L : IntermediateField K Ω) [FiniteDimensional K L] [IsGalois K L]
    {σ : Gal(L/K)} (hgen : ∀ τ : Gal(L/K), τ ∈ Subgroup.zpowers σ) {π : 𝒪[K]} (hπ : Irreducible π)
    (τ : Gal(L/K)) : Additive (Kˣ ⧸ normGroup L) :=
  let φ := carryCocycle hgen (Rep.ofAlgebraAutOnUnits K L) (Additive.ofMul (embUnits L (primeUnit hπ)))
    (prime_fixed L hπ)
  let e2 := (TateCohomology.isoGroupHomology (R := ℤ) (G := Gal(L/K)) (-2) 1 (by norm_num)).app
    (trivial ℤ Gal(L/K) ℤ)
  let x : tateCohomology (trivial ℤ Gal(L/K) ℤ) (-2) :=
    e2.inv.hom ((groupHomology.H1AddEquivOfIsTrivial (trivial ℤ Gal(L/K) ℤ)).symm
      (Additive.ofMul (Abelianization.of τ) ⊗ₜ (1 : ℤ)))
  let y := (TateCohomology.δ (augSeq_shortExact (trivial ℤ Gal(L/K) ℤ)) (-2)).hom x
  let z := (TateCohomology.δ (splitSeq_shortExact (Rep.ofAlgebraAutOnUnits K L) φ) (-2 + 1)).hom y
  tateZeroUnitsEquiv K L ((eqToHom (by norm_num : tateCohomology (Rep.ofAlgebraAutOnUnits K L) (-2 + 1 + 1) =
    tateCohomology (Rep.ofAlgebraAutOnUnits K L) 0)).hom z)

variable (K Ω) in
/-- **Proposition 1.9** (named statement; Milne, p. 102). For $L/K$ finite unramified with Frobenius generator
$\sigma$ and a prime element $\pi$ of $K$, the composite $G \simeq H^{-2}_T(G, \mathbb Z) \to H^{-1}_T(G, I_G) \to
H^0_T(G, L^\times) = K^\times/\mathrm{Nm}(L^\times)$ built from the cocycle of $(\sigma, \pi)$ (`prop19Map`) sends
$\sigma$ to the class of $\pi$. (Milne proves it by computing the norm of $x_\sigma$ in the splitting module.)

**Statement correction (2026-11-05).** With Mathlib's conventions (the chain differential
$d(\tau \otimes a) = \tau^{-1}a - a$, hence $H_1(G, \mathbb Z) \to \hat H^{-1}(G, I_G)$ sends $[\tau]$ to the class
of $\tau^{-1} - 1$, not $\tau - 1$ as in Milne), the composite `prop19Map` sends $\tau$ to the class of
$\pi^{i}$ where $\tau^{-1} = \sigma^i$ (`prop19Map_eq`, `Ch3Prop19Proof.lean`). The earlier version
`prop19Map L hgen hπ σ = [π]` was therefore false for $[L : K] \ge 3$ (it holds iff $\pi^2$ is a norm). Milne's
statement corresponds to evaluating `prop19Map` at $\sigma^{-1}$, which is what is stated now. -/
@[kb "milne2020cft" "v4.03, Ch. III, Prop. 1.9, p. 102 (input)"]
structure Prop1_9 : Prop where
  frob : ∀ (L : IntermediateField K Ω) [FiniteDimensional K L] [IsGalois K L], IsUnramifiedExt L →
    ∀ {σ : Gal(L/K)}, IsFrobenius L σ → ∀ (hgen : ∀ τ : Gal(L/K), τ ∈ Subgroup.zpowers σ)
      {π : 𝒪[K]} (hπ : Irreducible π),
      prop19Map L hgen hπ σ⁻¹ = Additive.ofMul (QuotientGroup.mk (primeUnit hπ))

end NumberFieldKB.MilneCFT.Ch3
