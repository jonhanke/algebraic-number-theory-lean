import NumberFieldKB.Pontryagin.Bochner
import NumberFieldKB.TauCetiPort.Analysis.Bochner.LocallyCompactGroup

/-!
# Bochner's theorem, proved

The named input `NumberFieldKB.Pontryagin.BochnerTheorem` (Folland, *A Course in Abstract Harmonic Analysis*,
2nd ed., Theorem 4.18) is discharged here: `bochnerTheorem : BochnerTheorem`.

The proof is Tau Ceti's (main `7ed979d`, 2026-11-04, Apache 2.0), ported to this repository's toolchain under
`NumberFieldKB/TauCetiPort/` (the import closure of `TauCeti/Analysis/Bochner/LocallyCompactGroup.lean`, 42 files,
declaration names unchanged, five lemma renames for Mathlib `v4.35.0`):
* existence: `TauCeti.IsPositiveDefiniteSub.exists_pontryaginMeasureTransform_eq_of_continuousAt`, through the
  Gelfand–Naimark–Segal construction of the translation representation on the Hilbert space of a positive-definite
  function and the spectral theorem for strongly continuous unitary representations of a locally compact abelian
  group (the representing measure lives on the Gelfand spectrum of the commutative C*-algebra generated by the
  integrated representation, and is pushed to the dual group);
* uniqueness: `MeasureTheory.FiniteMeasure.ext_of_forall_pontryaginMeasureTransform_eq_of_innerRegular`, by
  Stone–Weierstrass for the star algebra spanned by the evaluation characters of the dual, applied to finite inner
  regular (hence tight) measures.

Tau Ceti states both halves for an additive group `G` with dual `PontryaginDual (Multiplicative G)`; for a
multiplicative group they are applied to `Additive G`.

## Main declarations
* `bochnerTheorem`: Bochner's theorem in the form of the named input `BochnerTheorem`.
* `exists_fourierStieltjes_eq`, `fourierStieltjes_injective`: the two halves, as separate theorems.
-/

open MeasureTheory

namespace NumberFieldKB.Pontryagin

universe u

section

variable {G : Type u} [CommGroup G] [TopologicalSpace G] [IsTopologicalGroup G] [LocallyCompactSpace G]
  [MeasurableSpace (PontryaginDual G)] [BorelSpace (PontryaginDual G)]

/-- **Bochner's theorem, existence** (Folland, Theorem 4.18): a positive-definite function on a locally compact
commutative group, continuous at `1`, is the Fourier–Stieltjes transform of a finite inner regular measure on the
dual group. Tau Ceti's `TauCeti.IsPositiveDefiniteSub.exists_pontryaginMeasureTransform_eq_of_continuousAt`. -/
theorem exists_fourierStieltjes_eq {φ : G → ℂ} (hφ : IsPositiveDefinite φ) (h1 : ContinuousAt φ 1) :
    ∃ μ : Measure (PontryaginDual G), IsFiniteMeasure μ ∧ μ.InnerRegular ∧
      ∀ g, fourierStieltjes μ g = φ g := by
  let _ : MeasurableSpace (PontryaginDual (Multiplicative (Additive G))) := ‹MeasurableSpace (PontryaginDual G)›
  have _ : BorelSpace (PontryaginDual (Multiplicative (Additive G))) := ‹BorelSpace (PontryaginDual G)›
  have hφ' : TauCeti.IsPositiveDefiniteSub (fun g : Additive G => φ g.toMul) := by
    intro n c v
    simpa only [toMul_sub, div_eq_mul_inv] using hφ n c fun i => (v i).toMul
  obtain ⟨μ, hreg, hμ⟩ :=
    TauCeti.IsPositiveDefiniteSub.exists_pontryaginMeasureTransform_eq_of_continuousAt hφ' h1
  refine ⟨μ.toMeasure, μ.2, hreg, fun g => ?_⟩
  exact (FiniteMeasure.pontryaginMeasureTransform_apply μ (Additive.ofMul g)).symm.trans
    (congrFun hμ (Additive.ofMul g))

/-- **Bochner's theorem, uniqueness**: two finite inner regular measures on the dual group with the same
Fourier–Stieltjes transform are equal. Tau Ceti's
`MeasureTheory.FiniteMeasure.ext_of_forall_pontryaginMeasureTransform_eq_of_innerRegular`. -/
theorem fourierStieltjes_injective (μ ν : Measure (PontryaginDual G)) [IsFiniteMeasure μ] [IsFiniteMeasure ν]
    [μ.InnerRegular] [ν.InnerRegular] (h : ∀ g, fourierStieltjes μ g = fourierStieltjes ν g) : μ = ν := by
  let _ : MeasurableSpace (PontryaginDual (Multiplicative (Additive G))) := ‹MeasurableSpace (PontryaginDual G)›
  have _ : BorelSpace (PontryaginDual (Multiplicative (Additive G))) := ‹BorelSpace (PontryaginDual G)›
  let P : FiniteMeasure (PontryaginDual (Multiplicative (Additive G))) := ⟨μ, ‹IsFiniteMeasure μ›⟩
  let Q : FiniteMeasure (PontryaginDual (Multiplicative (Additive G))) := ⟨ν, ‹IsFiniteMeasure ν›⟩
  have hP : P.toMeasure.InnerRegular := ‹μ.InnerRegular›
  have hQ : Q.toMeasure.InnerRegular := ‹ν.InnerRegular›
  have := FiniteMeasure.ext_of_forall_pontryaginMeasureTransform_eq_of_innerRegular (P := P) (Q := Q)
    fun g => by
      exact (FiniteMeasure.pontryaginMeasureTransform_apply P g).trans
        ((h g.toMul).trans (FiniteMeasure.pontryaginMeasureTransform_apply Q g).symm)
  exact congrArg FiniteMeasure.toMeasure this

end

/-- **Bochner's theorem** (Folland, Theorem 4.18), both halves, for locally compact commutative groups in universe
`u`: the named input `BochnerTheorem` holds. -/
theorem bochnerTheorem : BochnerTheorem.{u} where
  exists_measure _ _ _ _ _ _ _ _ hφ h1 := exists_fourierStieltjes_eq hφ h1
  ext _ _ _ _ _ _ _ μ ν _ _ _ _ h := fourierStieltjes_injective μ ν h

end NumberFieldKB.Pontryagin
