import NumberFieldKB.MilneCFT.LubinTate.LocalKroneckerWeberCFT
import NumberFieldKB.MilneCFT.LubinTate.ArtinIndependenceAux

/-!
# Same-level containment of Lubin–Tate fields up to an unramified extension

Let `π` and `ϖ` be two prime elements of the ring of integers of a local field `K`, and let `N ≥ 1`. Then the
Lubin–Tate field of `ϖ` at level `N` lies in the compositum of the Lubin–Tate field of `π` at the same level `N`
with some finite unramified extension of `K` (`exists_ltField_le_ltField_sup_unramified`).

The proof adapts the argument for the local Kronecker–Weber theorem (Milne, *Class Field Theory*, Chapter I,
Theorem 4.8, see `localKroneckerWeber`). The norm group of the Lubin–Tate field of `ϖ` at level `N` is generated by
`ϖ` together with the `N`-th unit filtration group (Theorem 3.9 and the computation `normGroup_ltField`), so it
already contains the unit filtration group at level `N`, with no loss of level. Some power `π^f` lies in this norm
group, where `f` is its index. For the unramified extension of degree `f`, the norm group of the compositum is
contained in the norm group of the Lubin–Tate field of `ϖ`, which gives the containment by the order-reversing
correspondence between norm groups and abelian extensions.
-/

open scoped ValuativeRel

noncomputable section

set_option linter.unusedSectionVars false

namespace NumberFieldKB.MilneCFT.LocalCFT

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-- The Lubin–Tate field of `ϖ` at level `N ≥ 1` lies in the compositum of the Lubin–Tate field of `π` at the same
level with a finite unramified extension (Milne, *CFT*, I, Theorems 3.9 and 4.8). -/
theorem exists_ltField_le_ltField_sup_unramified {π ϖ : 𝒪[K]} (hπ : Irreducible π) (hϖ : Irreducible ϖ)
    (N : ℕ) (hN : 1 ≤ N) :
    ∃ m : ℕ, m ≠ 0 ∧ ltField Ω ϖ N ≤ ltField Ω π N ⊔ TauCeti.unramifiedExtension K Ω m := by
  obtain ⟨φ, hφ⟩ := (localReciprocityExistence K Ω).exists_artin
  have hLT := lubinTateExtensionTheorem K Ω
  set L := ltFieldExt hLT hϖ hN with hL
  set Nm := normGroup L.toField with hNm
  have : Nm.FiniteIndex := ⟨by rw [hNm, index_normGroup hφ L]; exact Module.finrank_pos.ne'⟩
  have hNm' : Nm = Subgroup.zpowers (primeUnit hϖ) ⊔ unitFiltration K N :=
    normGroup_ltField Ω hϖ N hN
  have hUN : unitFiltration K N ≤ Nm := hNm' ▸ le_sup_right
  set f := Nm.index
  have hf : 1 ≤ f := Nat.one_le_iff_ne_zero.2 Subgroup.FiniteIndex.index_ne_zero
  have hπf : primeUnit hπ ^ f ∈ Nm := Subgroup.pow_index_mem Nm _
  obtain ⟨Kf, hKf, hdeg⟩ := (unramifiedInput K Ω).exists_unramified f hf
  let M := (ltFieldExt hLT hπ hN).sup Kf
  have hle : L.toField ≤ M.toField := by
    rw [le_iff_normGroup_le hφ L M]
    change normGroup (ltField Ω π N ⊔ Kf.toField) ≤ Nm
    rw [show normGroup (ltField Ω π N ⊔ Kf.toField) =
        normGroup ((ltFieldExt hLT hπ hN).toField ⊔ Kf.toField) from rfl, normGroup_sup hφ]
    rintro x ⟨hx1, hx2⟩
    change x ∈ normGroup (ltField Ω π N) at hx1
    rw [normGroup_ltField Ω hπ N hN] at hx1
    obtain ⟨u, hu, j, rfl⟩ := normGroup_unramified_le (unramifiedInput K Ω) hφ hπ Kf hKf hx2
    have hpj : primeUnit hπ ^ ((Module.finrank K Kf.toField : ℤ) * j) ∈
        Subgroup.zpowers (primeUnit hπ) ⊔ unitFiltration K N :=
      Subgroup.mem_sup_left (Subgroup.zpow_mem_zpowers _ _)
    have hu' : u ∈ (Subgroup.zpowers (primeUnit hπ) ⊔ unitFiltration K N) ⊓ unitGroup K := by
      refine ⟨?_, hu⟩
      have := Subgroup.mul_mem _ hx1 (Subgroup.inv_mem _ hpj)
      simpa using this
    have huN : u ∈ Nm := hUN (zpowers_sup_unitFiltration_inf_unitGroup hπ N hu')
    have hpN : primeUnit hπ ^ ((Module.finrank K Kf.toField : ℤ) * j) ∈ Nm := by
      rw [hdeg, zpow_mul, zpow_natCast]
      exact Subgroup.zpow_mem _ hπf _
    exact Nm.mul_mem huN hpN
  have hfd : FiniteDimensional K Kf.toField := inferInstance
  have heq : Kf.toField = TauCeti.unramifiedExtension K Ω f := by
    have := eq_unramifiedExtension_of_isUnramifiedExt Kf.toField hKf
    rwa [hdeg] at this
  refine ⟨f, by omega, ?_⟩
  rw [← heq]
  exact hle

end NumberFieldKB.MilneCFT.LocalCFT
