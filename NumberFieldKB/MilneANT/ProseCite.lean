import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.Algebra.Group.Submonoid.Saturation
import Mathlib.Data.Finsupp.MonomialOrder.DegLex
import Mathlib.RingTheory.Polynomial.Eisenstein.Basic
import Mathlib.RingTheory.Polynomial.Resultant.Basic
import QuadFormsKB.Citation

/-!
# Milne, Algebraic Number Theory, Chapters 1 to 4 and introduction: definitions given in prose, in Mathlib

Citation file for J. S. Milne, *Algebraic Number Theory*, version 3.08 (2020), bibliography key
`milne2020ant`. It covers the definitions that the book gives in running prose (not as numbered items) on pdf
pages 1 to 86, that is in the introduction and Chapters 1 to 4, and that are already in Mathlib.

The convention is as follows.

* When a Mathlib definition is Milne's definition, or an equivalent standard form of it, the declaration is
  tagged directly with `attribute [kb "milne2020ant" "..."]`. A plain comment above the attribute names the
  prose definition and any difference (for example a hypothesis that Mathlib does not impose).
* When Milne's definition differs from Mathlib's, this file proves a short restating theorem that the two
  agree, with a docstring saying in words what is claimed and which Mathlib declarations it restates.
* Locators have the form `v3.08, <chapter>, definition in prose (<name>), p. <printed page>`. The printed page is
  the pdf page minus 2.

Prose definitions in the audit that are not cited here: D043 (monogenic number field), D045 (Hermite normal
form), D052 (normalized discrete valuation), D054 (invariant factors) and D077 (norm form of an ideal basis)
are not in Mathlib; D074 to D076 (binary quadratic forms) are formalized in QuadFormsKB; D065 (the
Minkowski constant) has no Mathlib declaration, because the constant is only a local notation inside
`Mathlib/NumberTheory/NumberField/ClassNumber.lean`, and `minkowskiBound` is a different quantity.
-/

namespace NumberFieldKB.MilneANT

/-! ### Introduction -/

-- D003 (unit): an element with a two-sided inverse. Same notion, for any monoid.
attribute [kb "milne2020ant" "v3.08, Introduction, definition in prose (unit), p. 7"] IsUnit

-- D006 (irreducible element): not a unit and not a product of two nonunits. Same notion; Mathlib's
-- definition does not require the ring to be a domain and does not mention zero (in a domain with zero
-- not a unit, zero is not irreducible).
attribute [kb "milne2020ant" "v3.08, Introduction, definition in prose (irreducible element), p. 8"]
  Irreducible

-- D009 (class number): the order of the ideal class group of the ring of integers.
-- Mathlib defines it as the cardinality of the class group, which is finite.
attribute [kb "milne2020ant" "v3.08, Introduction, definition in prose (class number), p. 10"]
  NumberField.classNumber

/-! ### Chapter 1 -/

-- D010 (subalgebra generated by elements): $A[b_1, \dots, b_m]$. Mathlib's `Algebra.adjoin` is the smallest
-- subalgebra containing the elements; it is the set of polynomial expressions in them, as in the book.
attribute [kb "milne2020ant"
  "v3.08, Ch. 1, definition in prose (subalgebra generated by elements), p. 14"] Algebra.adjoin

-- D011 (ideal generated by elements): the ideal of finite combinations with coefficients in the ring.
-- Mathlib defines it as the smallest ideal containing the set.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (ideal generated by elements), p. 14"]
  Ideal.span

-- D012 (sum of ideals): the smallest ideal containing both, which is the supremum in the lattice of ideals.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (sum of ideals), p. 14"] Ideal.add_eq_sup

-- D013 (prime element): the book also says a nonzero element is prime if and only if the ideal it generates
-- is prime. Mathlib's `Prime` is the divisibility form (nonzero, nonunit, divides a factor of a product it
-- divides); the equivalence with the ideal form is `Ideal.span_singleton_prime`.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (prime element), p. 15"] Prime
attribute [kb "milne2020ant"
  "v3.08, Ch. 1, definition in prose (prime element, equivalence with a prime principal ideal), p. 15"]
  Ideal.span_singleton_prime

-- D014 (noetherian module): every submodule is finitely generated.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (noetherian module), p. 16"] IsNoetherian

/-- Milne, Chapter 1, definition in prose (local ring): a commutative ring is local if it has exactly one
maximal ideal.

This restates the Mathlib definition `IsLocalRing` (a nontrivial ring in which the nonunits are closed under
addition) as the book's condition, using `IsLocalRing.maximal_ideal_unique` and
`IsLocalRing.of_unique_max_ideal`. -/
@[kb "milne2020ant" "v3.08, Ch. 1, definition in prose (local ring), p. 17"]
theorem prose_D015_localRing (R : Type*) [CommRing R] :
    IsLocalRing R ↔ ∃! I : Ideal R, I.IsMaximal :=
  ⟨fun _ => IsLocalRing.maximal_ideal_unique R, IsLocalRing.of_unique_max_ideal⟩

-- D016 (multiplicative subset): a subset containing 1 and closed under multiplication and not containing 0.
-- Mathlib's `Submonoid` has the first two conditions; the condition that zero is excluded is added as a
-- hypothesis where needed (for example `M ≤ nonZeroDivisors A`).
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (multiplicative subset), p. 18"] Submonoid

-- D017 (localization $S^{-1}A$): Mathlib states it by the universal property, for any commutative ring, and
-- not only as fractions inside the fraction field; for a domain and a subset avoiding zero it is the
-- book's ring of fractions.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (localization), p. 18"] IsLocalization

-- D018 (localization at a prime ideal): the localization at the complement of the prime ideal.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (localization at a prime ideal), p. 18"]
  Localization.AtPrime IsLocalization.AtPrime

-- D019 (bilinear map): a map linear in each argument. Mathlib's predicate on a function of two arguments.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (bilinear map), p. 21"] IsBilinearMap

-- D020 (tensor product): Mathlib gives a construction `TensorProduct`, and a predicate saying that a
-- bilinear map has the universal property (`IsTensorProduct`), which is the book's definition.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (tensor product), p. 21"]
  TensorProduct IsTensorProduct

-- D024 (free module of rank m): Mathlib's `Module.Free` says there is a basis; the rank is `Module.finrank`.
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (free module), p. 21"] Module.Free

-- D025 (extension of scalars): the tensor product over the ring with the algebra, characterized by its
-- universal property for maps into modules over the algebra (`IsBaseChange`).
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (extension of scalars), p. 23"]
  IsBaseChange

-- D027 (saturated multiplicative subset): a subset $S$ such that $ab \in S$ implies $a \in S$ and $b \in S$.
-- Same definition (the characterization as the complement of a union of primes is a theorem in the book
-- and is not cited here).
attribute [kb "milne2020ant" "v3.08, Ch. 1, definition in prose (saturated multiplicative subset), p. 24"]
  Submonoid.MulSaturated

/-! ### Chapter 2 -/

-- D028 (integral element): a root of a monic polynomial with coefficients in the ring. Same notion;
-- algebraic integers are the case of the integers.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (integral element), p. 25"] IsIntegral

-- D029 (symmetric polynomial): unchanged by permuting the variables.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (symmetric polynomial), p. 25"]
  MvPolynomial.IsSymmetric

-- D030 (elementary symmetric polynomials).
attribute [kb "milne2020ant"
  "v3.08, Ch. 2, definition in prose (elementary symmetric polynomials), p. 25"] MvPolynomial.esymm

-- D031 (ordering of monomials): by total degree, ties broken lexicographically. This is Mathlib's
-- degree-lexicographic order (the audit row mentions only the purely lexicographic order).
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (monomial ordering), p. 25"]
  MonomialOrder.degLex

-- D034 (basis of a module): linearly independent elements that span the module.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (basis of a module), p. 31"] Module.Basis

-- D035 (trace and norm): for an algebra free over the base ring, the trace and determinant of multiplication.
-- Mathlib defines them for any algebra, with the value zero for the trace and one for the norm when the
-- algebra is not free.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (trace), p. 31"] Algebra.trace
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (norm), p. 31"] Algebra.norm

-- D036 (nondegenerate bilinear form): the book uses the Gram determinant, equivalently trivial kernels.
-- Mathlib's definition is the kernel form; the determinant criterion over a domain with a basis is the
-- second declaration.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (nondegenerate bilinear form), p. 32"]
  LinearMap.BilinForm.Nondegenerate
attribute [kb "milne2020ant"
  "v3.08, Ch. 2, definition in prose (nondegenerate bilinear form, determinant form), p. 32"]
  LinearMap.BilinForm.nondegenerate_iff_det_ne_zero

-- D038 (discriminant of elements): $D(b_1, \dots, b_m) = \det(\mathrm{Tr}(b_i b_j))$. Mathlib's
-- `Algebra.discr` of a family, defined from the trace form `Algebra.traceForm`.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (discriminant of elements), p. 33"]
  Algebra.discr Algebra.traceForm

-- D039 (discriminant of a free algebra): only the discriminant of a chosen basis is defined in Mathlib
-- (`Algebra.discr`), and for a number field the integer `NumberField.discr`. The ideal (or class modulo
-- squares of units) generated by the discriminant of a basis is not defined.
attribute [kb "milne2020ant"
  "v3.08, Ch. 2, definition in prose (discriminant of a free algebra, basis and number field cases), p. 33"]
  NumberField.discr

-- D041 (discriminant of a polynomial): Mathlib defines it through the resultant of the polynomial and its
-- derivative with the usual sign and leading coefficient factors, which is the other form the book
-- mentions; agreement with the product of squared root differences is not cited here.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (discriminant of a polynomial), p. 37"]
  Polynomial.discr

-- D044 (Euclidean domain): a domain with a size function allowing division with remainder.
attribute [kb "milne2020ant" "v3.08, Ch. 2, definition in prose (Euclidean domain), p. 41"] EuclideanDomain

/-! ### Chapter 3 -/

/-- Milne, Chapter 3, definition in prose (discrete valuation ring): a principal ideal domain with exactly
one nonzero prime ideal.

This restates `IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime`: Mathlib defines a discrete
valuation ring as a principal ideal domain that is local and not a field, and the lemma shows this agrees
with the book's definition. -/
@[kb "milne2020ant" "v3.08, Ch. 3, definition in prose (discrete valuation ring), p. 46"]
theorem prose_D047_discreteValuationRing (A : Type*) [CommRing A] [IsDomain A] :
    IsDiscreteValuationRing A ↔ IsPrincipalIdealRing A ∧ ∃! P : Ideal A, P ≠ ⊥ ∧ P.IsPrime :=
  IsDiscreteValuationRing.iff_pid_with_one_nonzero_prime A

-- D047 (discrete valuation ring), the book's third equivalent form: a principal ideal domain that is local
-- and not a field. This is Mathlib's definition itself.
attribute [kb "milne2020ant"
  "v3.08, Ch. 3, definition in prose (discrete valuation ring, local and not a field form), p. 46"]
  IsDiscreteValuationRing

-- D050 (product of fractional ideals): the set of finite sums of products. Mathlib's product on fractional
-- ideals (the instance, and the equation giving it as the product of submodules).
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (product of fractional ideals), p. 53"]
  FractionalIdeal.instMul FractionalIdeal.mul_def

-- D051 (ideal class group): the group of fractional ideals modulo the principal ones. Mathlib defines it as
-- the quotient of the unit group of the fractional ideals by the range of the principal ideal map.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (ideal class group), p. 54"] ClassGroup

-- D055 (ramified prime): a prime is ramified if some ramification index exceeds one. Mathlib states the
-- negation as the property `Algebra.IsUnramifiedIn` of a prime of the base ring; the equivalence with "all
-- ramification indices are one" for Dedekind domains is not stated by this declaration.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (ramified prime, as its negation), p. 59"]
  Algebra.IsUnramifiedIn

-- D056 (ramification index): the exponent of the prime in the factorization of the extended ideal.
-- Mathlib defines it as the supremum of the exponents $n$ with the extended ideal in the $n$-th power.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (ramification index), p. 59"]
  Ideal.ramificationIdx

-- D058 (residue class degree): the degree of the residue field extension. Mathlib's `Ideal.inertiaDeg`.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (residue class degree), p. 59"]
  Ideal.inertiaDeg

-- D059 (nilpotent element): some power is zero.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (nilpotent element), p. 61"] IsNilpotent

-- D060 (reduced ring): no nonzero nilpotent element. Mathlib's `IsReduced` is a class on any monoid with zero.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (reduced ring), p. 61"] IsReduced

-- D061 (perfect field): every finite extension is separable. Mathlib's class says every irreducible
-- polynomial is separable, the same notion.
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (perfect field), p. 61"] PerfectField

-- D063 (Eisenstein polynomial): Mathlib's `Polynomial.IsEisensteinAt` for a prime ideal requires the leading
-- coefficient not in the ideal, the other coefficients in the ideal, and the constant coefficient not in
-- its square; monic is not required (the book asks for a monic polynomial).
attribute [kb "milne2020ant" "v3.08, Ch. 3, definition in prose (Eisenstein polynomial), p. 66"]
  Polynomial.IsEisensteinAt

/-! ### Chapter 4 -/

-- D064 (numerical norm of an ideal): the index of the ideal in the ring of integers.
-- Mathlib's `Ideal.absNorm`, with `Ideal.absNorm_apply` showing it is the cardinality of the quotient.
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (numerical norm of an ideal), p. 69"]
  Ideal.absNorm
attribute [kb "milne2020ant"
  "v3.08, Ch. 4, definition in prose (numerical norm of an ideal, as the index), p. 69"]
  Ideal.absNorm_apply

-- D066 (unramified extension): no prime of the base ring ramifies in the extension.
-- Mathlib's `Algebra.IsUnramifiedIn` is the property for one prime ideal of the base; the book's global
-- notion is the statement for all nonzero primes (see `NumberFieldKB.MilneANT.thm_4_9` for such a form).
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (unramified extension, one prime), p. 72"]
  Algebra.IsUnramifiedIn

-- D067 (full lattice): a lattice generated by $n$ independent vectors in an $n$-dimensional space.
-- Mathlib's `IsZLattice` for a discrete submodule requires that it spans the space over the reals, which
-- is the full case only.
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (full lattice), p. 73"] IsZLattice

-- D068 (discrete subgroup): a subgroup that is discrete in the induced topology. Mathlib's class
-- `DiscreteTopology`, used on the subgroup type.
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (discrete subgroup), p. 73"]
  DiscreteTopology

-- D070 (fundamental parallelopiped): $\{ \sum a_i e_i \mid 0 \le a_i < 1 \}$. Mathlib's
-- `ZSpan.fundamentalDomain` of a basis, a parallelopiped at the origin; the book also translates it by an
-- element of the lattice.
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (fundamental parallelopiped), p. 75"]
  ZSpan.fundamentalDomain

-- D071 (convex set): contains the line segment between any two of its points. Symmetry in the origin has no
-- name in Mathlib and appears as a hypothesis (`-x` in the set whenever `x` is).
attribute [kb "milne2020ant" "v3.08, Ch. 4, definition in prose (convex set), p. 76"] Convex

end NumberFieldKB.MilneANT
