import NumberFieldKB.MilneEC.Ch5JFunction
import Mathlib.Analysis.CStarAlgebra.Classes
import Mathlib.NumberTheory.ModularForms.Basic
import Mathlib.Topology.UniformSpace.Uniformizable
import Mathlib.Algebra.Group.Action.Sum
import Mathlib.Algebra.Order.Ring.Star
import Mathlib.Algebra.Order.Star.Int
import Mathlib.Algebra.Order.Star.Real
import Mathlib.Analysis.Real.Pi.Bounds

/-!
# Milne, *Elliptic Curves*, Chapter V §1: the extended upper half-plane and the compact quotients $X(\Gamma)$

Source: J. S. Milne, *Elliptic Curves* (`milne2006ec`), Chapter V, §1, pdf pp. 184–187.

$\mathbb H^* = \mathbb H \cup \mathbb P^1(\mathbb Q)$ with Milne's topology (pdf p. 184): the topology of
$\mathbb H$, the sets $\{\Im z > M\} \cup \{\infty\}$ as a fundamental system of neighbourhoods of $\infty$, and the
horodisks $\{|z - (a + ir)| < r\} \cup \{a\}$ as a fundamental system of neighbourhoods of $a \in \mathbb Q$; it is
defined here as the topology generated by these sets. $\mathrm{SL}_2(\mathbb Z)$ acts on $\mathbb H$ by Möbius
transformations and on $\mathbb P^1(\mathbb Q)$ through $\mathrm{GL}_2(\mathbb Q)$, and $X(\Gamma) = \Gamma\backslash\mathbb H^*$
carries the quotient topology.

Named statements: the Hausdorff property of $\mathbb H^*$ and continuity of the action (running text),
Proposition 1.7. Proved from them: Proposition 1.9 in topological form ($X_0(1)$ is homeomorphic to the sphere
$\mathbb P^1(\mathbb C) = $ `OnePoint ℂ`, i.e. has genus zero), using the named injectivity of $j$
(`JInjective`) and the surjectivity of $j$.

Not formalized: the complex structure of Proposition 1.8 (Mathlib has no complex structure on a quotient by a
non-free action) and the Euler characteristic / Hurwitz formula computations of genera.
-/

open UpperHalfPlane hiding I
open ModularForm Complex Filter Topology Matrix.SpecialLinearGroup
open scoped MatrixGroups Real Manifold Pointwise

namespace NumberFieldKB.MilneEC.V

/-- The extended upper half-plane $\mathbb H^* = \mathbb H \sqcup \mathbb P^1(\mathbb Q)$ (pdf p. 184); a type
synonym, so that it carries Milne's topology rather than the disjoint-union topology. -/
def HStar : Type := ℍ ⊕ OnePoint ℚ

/-- The neighbourhood $\{\Im z > M\} \cup \{\infty\}$ of the cusp $\infty$. -/
def HStar.horoInfty (M : ℝ) : Set HStar :=
  {x | ∃ z : ℍ, x = Sum.inl z ∧ M < z.im} ∪ {Sum.inr OnePoint.infty}

/-- The horodisk $\{|z - (a + ir)| < r\} \cup \{a\}$ at the cusp $a \in \mathbb Q$. -/
def HStar.horoDisk (a : ℚ) (r : ℝ) : Set HStar :=
  {x | ∃ z : ℍ, x = Sum.inl z ∧ ‖(z : ℂ) - ((a : ℂ) + r * I)‖ < r} ∪ {Sum.inr (a : OnePoint ℚ)}

/-- Milne's topology on $\mathbb H^*$ (pdf p. 184). -/
instance : TopologicalSpace HStar :=
  TopologicalSpace.generateFrom
    ({S | ∃ U : Set ℍ, IsOpen U ∧ S = Sum.inl '' U} ∪ {S | ∃ M : ℝ, 0 < M ∧ S = HStar.horoInfty M} ∪
      {S | ∃ (a : ℚ) (r : ℝ), 0 < r ∧ S = HStar.horoDisk a r})

/-- $\mathrm{SL}_2(\mathbb Z)$ acting on $\mathbb P^1(\mathbb Q)$ through $\mathrm{GL}_2(\mathbb Q)$. -/
noncomputable instance : MulAction SL(2, ℤ) (OnePoint ℚ) := MulAction.compHom _ (mapGL ℚ)

/-- The action of $\mathrm{SL}_2(\mathbb Z)$ on $\mathbb H^*$ (pdf p. 184). -/
noncomputable instance : MulAction SL(2, ℤ) HStar := inferInstanceAs (MulAction SL(2, ℤ) (ℍ ⊕ OnePoint ℚ))

/-- $X(\Gamma) = \Gamma\backslash\mathbb H^*$ with the quotient topology (pdf p. 185); $X_0(N) = X(\Gamma_0(N))$. -/
def XGamma (Γ : Subgroup SL(2, ℤ)) : Type := Quotient (MulAction.orbitRel Γ HStar)

noncomputable instance (Γ : Subgroup SL(2, ℤ)) : TopologicalSpace (XGamma Γ) :=
  inferInstanceAs (TopologicalSpace (Quotient (MulAction.orbitRel Γ HStar)))

/-- Running text (pdf p. 184), a named statement: "one shows that $\mathbb H^*$ is Hausdorff, and that the action
of $\mathrm{SL}_2(\mathbb Z)$ is continuous". -/
@[kb "milne2006ec" "Ch. V, §1, ℍ* is Hausdorff and SL₂(ℤ) acts continuously (running text), pdf p. 184"]
structure HStarTopology : Prop where
  t2 : T2Space HStar
  continuous_smul : ∀ g : SL(2, ℤ), Continuous fun x : HStar ↦ g • x

/-- **Proposition 1.7** (pdf p. 186), a named statement: for $\Gamma$ of finite index in $\mathrm{SL}_2(\mathbb Z)$,
$\Gamma\backslash\mathbb H^*$ is Hausdorff and compact. -/
@[kb "milne2006ec" "Ch. V, Proposition 1.7, pdf p. 186"]
structure Prop1_7 : Prop where
  t2 : ∀ Γ : Subgroup SL(2, ℤ), Γ.FiniteIndex → T2Space (XGamma Γ)
  compact : ∀ Γ : Subgroup SL(2, ℤ), Γ.FiniteIndex → CompactSpace (XGamma Γ)

/-- The map $X_0(1) \to \mathbb P^1(\mathbb C)$ induced by $j$, with $j(\text{cusp}) = \infty$. -/
noncomputable def jStar : HStar → OnePoint ℂ
  | Sum.inl z => (jFun z : OnePoint ℂ)
  | Sum.inr _ => OnePoint.infty

/-- The map `jStar` is invariant under $\mathrm{SL}_2(\mathbb Z)$. -/
lemma jStar_smul (g : SL(2, ℤ)) (x : HStar) : jStar (g • x) = jStar x := by
  obtain z | c := (x : ℍ ⊕ OnePoint ℚ)
  · show ((jFun (g • z) : ℂ) : OnePoint ℂ) = _
    rw [jFun_smul]
    rfl
  · show jStar (Sum.inr (g • c)) = _
    rfl

/-- `jStar` is constant on the orbits of the whole modular group. -/
lemma jStar_orbit (a b : HStar)
    (h : (MulAction.orbitRel (⊤ : Subgroup SL(2, ℤ)) HStar).r a b) : jStar a = jStar b := by
  obtain ⟨g, rfl⟩ := MulAction.orbitRel_apply.mp h
  exact jStar_smul g.1 b

/-- Two points in the same orbit of the modular group have the same class. -/
lemma mk_eq_of_smul (g : SL(2, ℤ)) (x : HStar) :
    (Quotient.mk _ (g • x) : XGamma ⊤) = Quotient.mk _ x :=
  Quotient.sound (MulAction.orbitRel_apply.mpr ⟨⟨g, trivial⟩, rfl⟩)

/-- The sets `inl '' U` are open. -/
lemma isOpen_inl_image {U : Set ℍ} (hU : IsOpen U) : IsOpen (Sum.inl '' U : Set HStar) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl (Or.inl ⟨U, hU, rfl⟩))

/-- The neighbourhoods of the cusp `∞` are open. -/
lemma isOpen_horoInfty {M : ℝ} (hM : 0 < M) : IsOpen (HStar.horoInfty M) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inl (Or.inr ⟨M, hM, rfl⟩))

/-- The horodisks are open. -/
lemma isOpen_horoDisk (a : ℚ) {r : ℝ} (hr : 0 < r) : IsOpen (HStar.horoDisk a r) :=
  TopologicalSpace.isOpen_generateFrom_of_mem (Or.inr ⟨a, r, hr, rfl⟩)

/-- An open subset of the extended plane containing infinity contains all points of large norm. -/
lemma exists_bound_of_isOpen_infty {V : Set (OnePoint ℂ)} (hV : IsOpen V)
    (h : (OnePoint.infty : OnePoint ℂ) ∈ V) :
    ∃ R : ℝ, ∀ w : ℂ, R < ‖w‖ → (w : OnePoint ℂ) ∈ V := by
  have hc := ((OnePoint.isOpen_iff_of_mem' h).mp hV).1
  obtain ⟨R, hR⟩ := (hc.isBounded.subset_closedBall 0)
  refine ⟨R, fun w hw => ?_⟩
  by_contra hn
  have := hR (show w ∈ ((↑) ⁻¹' V : Set ℂ)ᶜ from hn)
  simp only [Metric.mem_closedBall, dist_zero_right] at this
  linarith

/-- $|j(z)|$ is large when $\Im z$ is large. -/
lemma jFun_large (R : ℝ) : ∃ M : ℝ, 0 < M ∧ ∀ z : ℍ, M < z.im → R < ‖jFun z‖ := by
  obtain ⟨C, A, hCA⟩ := UpperHalfPlane.isBoundedAtImInfty_iff.mp jFun_sub_inv_q_isBoundedAtImInfty
  refine ⟨max (max A (R + C + 1)) 1, lt_of_lt_of_le one_pos (le_max_right _ _), fun z hz => ?_⟩
  have hA : A ≤ z.im := ((le_max_left _ _).trans (le_max_left _ _)).trans hz.le
  have hy : R + C + 1 < z.im := lt_of_le_of_lt ((le_max_right _ _).trans (le_max_left _ _)) hz
  have h1 := hCA z hA
  have hq : ‖1 / cexp (2 * π * I * z)‖ = Real.exp (2 * π * z.im) := by
    rw [norm_div, norm_one, Complex.norm_exp]
    have : (2 * π * I * (z : ℂ)).re = -(2 * π * z.im) := by simp
    rw [this, Real.exp_neg, one_div, inv_inv]
  have h2 : z.im ≤ Real.exp (2 * π * z.im) := by
    have := Real.add_one_le_exp (2 * π * z.im)
    have hpi := Real.pi_gt_three
    nlinarith [z.im_pos]
  have h3 : ‖1 / cexp (2 * π * I * z)‖ - ‖jFun z - 1 / cexp (2 * π * I * z)‖ ≤ ‖jFun z‖ := by
    have := norm_sub_norm_le (1 / cexp (2 * π * I * z)) (1 / cexp (2 * π * I * z) - jFun z)
    rw [← norm_neg (1 / cexp (2 * π * I * z) - jFun z), neg_sub] at this
    simpa using this
  linarith

/-- Every cusp is the image of `∞` under an element of the modular group. -/
lemma exists_smul_infty (c : OnePoint ℚ) : ∃ γ : SL(2, ℤ), γ • (OnePoint.infty : OnePoint ℚ) = c := by
  induction c using OnePoint.rec with
  | infty => exact ⟨1, one_smul _ _⟩
  | coe a =>
    have hg : Int.gcd a.num a.den = 1 := by simpa [Int.gcd] using a.reduced
    have hb := Int.gcd_eq_gcd_ab a.num a.den
    rw [hg] at hb
    have hb' : (1 : ℤ) = a.num * Int.gcdA a.num a.den + a.den * Int.gcdB a.num a.den := by
      exact_mod_cast hb
    have hdet : (!![a.num, -Int.gcdB a.num a.den; a.den, Int.gcdA a.num a.den] :
        Matrix (Fin 2) (Fin 2) ℤ).det = 1 := by
      simp [Matrix.det_fin_two]
      linarith
    let γ : SL(2, ℤ) := ⟨_, hdet⟩
    refine ⟨γ, ?_⟩
    show mapGL ℚ γ • (OnePoint.infty : OnePoint ℚ) = _
    rw [OnePoint.smul_infty_eq_ite]
    have hd : (a.den : ℚ) ≠ 0 := by exact_mod_cast a.den_nz
    have h10 : ((mapGL ℚ γ : GL (Fin 2) ℚ) : Matrix (Fin 2) (Fin 2) ℚ) 1 0 = a.den := rfl
    have h00 : ((mapGL ℚ γ : GL (Fin 2) ℚ) : Matrix (Fin 2) (Fin 2) ℚ) 0 0 = a.num := rfl
    simp [h10, h00, hd, Rat.num_div_den]

/-- Cusps form a single orbit. -/
lemma exists_smul_cusp (c d : OnePoint ℚ) : ∃ γ : SL(2, ℤ), γ • d = c := by
  obtain ⟨g, hg⟩ := exists_smul_infty c
  obtain ⟨h, hh⟩ := exists_smul_infty d
  refine ⟨g * h⁻¹, ?_⟩
  have : h⁻¹ • d = (OnePoint.infty : OnePoint ℚ) := by
    rw [inv_smul_eq_iff]; exact hh.symm
  rw [mul_smul, this, hg]

/-- Mapping a horodisk at a rational point to a neighbourhood of `∞`. -/
lemma exists_horodisk_map (a : ℚ) :
    ∃ (δ : SL(2, ℤ)) (d : ℝ), 0 < d ∧ ∀ (r : ℝ) (w : ℍ), 0 < r →
      ‖(w : ℂ) - ((a : ℂ) + r * I)‖ < r → 1 / (2 * r * d ^ 2) < (δ • w).im := by
  have hg : Int.gcd a.num a.den = 1 := by simpa [Int.gcd] using a.reduced
  have hb := Int.gcd_eq_gcd_ab a.num a.den
  rw [hg] at hb
  have hb' : (1 : ℤ) = a.num * Int.gcdA a.num a.den + a.den * Int.gcdB a.num a.den := by
    exact_mod_cast hb
  have hdet : (!![Int.gcdA a.num a.den, Int.gcdB a.num a.den; -a.den, a.num] :
      Matrix (Fin 2) (Fin 2) ℤ).det = 1 := by
    simp [Matrix.det_fin_two]
    linarith
  let δ : SL(2, ℤ) := ⟨_, hdet⟩
  refine ⟨δ, (a.den : ℝ), by exact_mod_cast a.den_pos, fun r w hr hw => ?_⟩
  · have hδ10 : (δ : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = -a.den := rfl
    have hδ11 : (δ : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = a.num := rfl
    have hden : (a.den : ℝ) ≠ 0 := by exact_mod_cast a.den_nz
    have hdenC : (a.den : ℂ) ≠ 0 := by exact_mod_cast a.den_nz
    have hden0 : (0 : ℝ) < a.den := by exact_mod_cast a.den_pos
    have hdn : denom δ (w : ℂ) = -(a.den : ℂ) * ((w : ℂ) - a) := by
      rw [ModularGroup.denom_apply]
      have : (a : ℂ) = (a.num : ℂ) / a.den := Rat.cast_def a
      rw [this]
      simp [hδ10, hδ11]
      field_simp
      ring
    have hN : Complex.normSq (denom δ (w : ℂ)) =
        (a.den : ℝ) ^ 2 * Complex.normSq ((w : ℂ) - a) := by
      rw [hdn, map_mul, Complex.normSq_neg, Complex.normSq_natCast]
      ring
    rw [ModularGroup.im_smul_eq_div_normSq, hN]
    have hy := w.im_pos
    have h2 : ‖(w : ℂ) - ((a : ℂ) + r * I)‖ ^ 2 < r ^ 2 :=
      pow_lt_pow_left₀ hw (norm_nonneg _) two_ne_zero
    rw [Complex.sq_norm, Complex.normSq_apply] at h2
    have hN' : Complex.normSq ((w : ℂ) - a) = ((w : ℂ).re - a) ^ 2 + w.im ^ 2 := by
      rw [Complex.normSq_apply]; simp; ring
    have hre : ((w : ℂ)).re = w.re := rfl
    rw [hre] at hN'
    have hlt : Complex.normSq ((w : ℂ) - a) < 2 * r * w.im := by
      rw [hN']
      simp at h2
      nlinarith
    have hNpos : 0 < Complex.normSq ((w : ℂ) - a) := by
      rw [hN']; positivity
    have hd2 : 0 < (a.den : ℝ) ^ 2 := by positivity
    rw [div_lt_div_iff₀ (by positivity) (by positivity)]
    nlinarith [mul_lt_mul_of_pos_left hlt hd2]

/-- `jStar` is continuous for Milne's topology. -/
lemma continuous_jStar : Continuous jStar := by
  refine continuous_def.mpr fun V hV => isOpen_iff_forall_mem_open.mpr ?_
  intro x hx
  obtain z | c := (x : ℍ ⊕ OnePoint ℚ)
  · have hx' : (jFun z : OnePoint ℂ) ∈ V := hx
    have hU : IsOpen {w : ℍ | ((jFun w : ℂ) : OnePoint ℂ) ∈ V} :=
      hV.preimage (OnePoint.continuous_coe.comp jFun_mdifferentiable.continuous)
    refine ⟨Sum.inl '' {w : ℍ | ((jFun w : ℂ) : OnePoint ℂ) ∈ V}, ?_, isOpen_inl_image hU,
      ⟨z, hx', rfl⟩⟩
    rintro _ ⟨w, hw, rfl⟩
    exact hw
  · have hx' : (OnePoint.infty : OnePoint ℂ) ∈ V := hx
    obtain ⟨R, hR⟩ := exists_bound_of_isOpen_infty hV hx'
    obtain ⟨M, hM, hbig⟩ := jFun_large R
    induction c using OnePoint.rec with
    | infty =>
      refine ⟨HStar.horoInfty M, ?_, isOpen_horoInfty hM, Or.inr rfl⟩
      rintro y (⟨w, rfl, hw⟩ | rfl)
      · exact hR _ (hbig w hw)
      · exact hx'
    | coe a =>
      obtain ⟨δ, d, hd, hδ⟩ := exists_horodisk_map a
      have hr : 0 < 1 / (2 * M * d ^ 2) := by positivity
      refine ⟨HStar.horoDisk a (1 / (2 * M * d ^ 2)), ?_, isOpen_horoDisk a hr, Or.inr rfl⟩
      rintro y (⟨w, rfl, hw⟩ | rfl)
      · have h1 := hδ _ w hr hw
        have h2 : M = 1 / (2 * (1 / (2 * M * d ^ 2)) * d ^ 2) := by
          field_simp
        rw [← h2] at h1
        have h3 := hR _ (hbig _ h1)
        have h4 : jStar (Sum.inl w) = jStar (δ • (Sum.inl w : HStar)) := (jStar_smul δ _).symm
        show jStar (Sum.inl w) ∈ V
        rw [h4]
        exact h3
      · exact hx'

/-- **Proposition 1.9** (pdf p. 187), topological form, from the compactness of $X_0(1)$ (the compactness half of
Proposition 1.7, proved in `NumberFieldKB.MilneEC.V.compactSpace_xGamma`) and the named `JInjective`. -/
theorem prop_1_9_of_compactSpace (hc : CompactSpace (XGamma ⊤)) (hj : JInjective) :
    ∃ e : XGamma ⊤ ≃ₜ OnePoint ℂ, ∀ x : HStar, e (Quotient.mk _ x) = jStar x := by
  let e₀ : XGamma ⊤ → OnePoint ℂ := Quotient.lift jStar jStar_orbit
  have hcont : Continuous e₀ := continuous_jStar.quotient_lift jStar_orbit
  have hinj : Function.Injective e₀ := by
    intro x y
    refine Quotient.inductionOn₂ x y fun a b h => ?_
    have h : jStar a = jStar b := h
    obtain z | c := (a : ℍ ⊕ OnePoint ℚ) <;> obtain w | d := (b : ℍ ⊕ OnePoint ℚ)
    · have hzw : jFun z = jFun w := OnePoint.coe_injective h
      obtain ⟨γ, hγ⟩ := hj.orbit z w hzw
      have h1 : (Sum.inl w : HStar) = γ • (Sum.inl z : HStar) := congrArg Sum.inl hγ.symm
      exact ((congrArg (Quotient.mk _) h1).trans (mk_eq_of_smul γ _)).symm
    · exact absurd h (by simp [jStar])
    · exact absurd h (by simp [jStar])
    · obtain ⟨γ, hγ⟩ := exists_smul_cusp c d
      have h1 : (Sum.inr c : HStar) = γ • (Sum.inr d : HStar) := congrArg Sum.inr hγ.symm
      exact (congrArg (Quotient.mk _) h1).trans (mk_eq_of_smul γ _)
  have hsurj : Function.Surjective e₀ := by
    intro w
    induction w using OnePoint.rec with
    | infty => exact ⟨Quotient.mk _ (Sum.inr OnePoint.infty : HStar), rfl⟩
    | coe c =>
      obtain ⟨z, hz⟩ := jFun_surjective c
      exact ⟨Quotient.mk _ (Sum.inl z : HStar), by show (jFun z : OnePoint ℂ) = (c : OnePoint ℂ); rw [hz]⟩
  let f : XGamma ⊤ ≃ OnePoint ℂ := Equiv.ofBijective e₀ ⟨hinj, hsurj⟩
  exact ⟨Continuous.homeoOfEquivCompactToT2 (f := f) hcont, fun x => rfl⟩

/-- **Proposition 1.9** (pdf p. 187), in topological form, proved from the named statements
`Prop1_7` and `JInjective`: $X_0(1)$ is homeomorphic to the sphere $\mathbb P^1(\mathbb C)$, so it has genus $0$
(a compact orientable surface homeomorphic to the sphere has genus $0$; Milne computes $2 - 2g = V - E + F = 2$
from a triangulation). The homeomorphism is induced by $j$ (Proposition 2.2). -/
@[kb "milne2006ec" "Ch. V, Proposition 1.9, pdf p. 187"]
theorem prop_1_9 (h17 : Prop1_7) (hj : JInjective) :
    ∃ e : XGamma ⊤ ≃ₜ OnePoint ℂ, ∀ x : HStar, e (Quotient.mk _ x) = jStar x :=
  prop_1_9_of_compactSpace (h17.compact ⊤ inferInstance) hj

end NumberFieldKB.MilneEC.V
