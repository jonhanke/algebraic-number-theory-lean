import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import QuadFormsKB.Citation
import Mathlib.Algebra.GroupWithZero.Action.Pointwise.Finset
import Mathlib.Data.Int.Range

/-!
# Weil, *Basic Number Theory*, V.§1: $\mathbb Q$-lattices and orders

$E$ is a finite-dimensional vector space over $\mathbb Q$.

* **Def. 1** (p. 80): a $\mathbb Q$-lattice in $E$ is a finitely generated subgroup containing a basis of $E$ over
  $\mathbb Q$ (`IsQLattice`).
* **Prop. 1** (p. 80): for two $\mathbb Q$-lattices $L,L'$ some integer $m>0$ has $mL\subseteq L'$ (`weil_V_1_prop1`).
* **Cor. 1** (p. 80): every $\mathbb Q$-lattice is generated by a basis of $E$ over $\mathbb Q$ (`weil_V_1_prop1_cor1`).
* **Cor. 2** (p. 80): a subgroup of a $\mathbb Q$-lattice containing a basis is a $\mathbb Q$-lattice
  (`weil_V_1_prop1_cor2`).
* **Def. 2** (p. 81): an order of a finite-dimensional $\mathbb Q$-algebra is a subring that is a $\mathbb Q$-lattice
  (`IsQOrder`).
* **Prop. 2** (p. 81): every finite-dimensional $\mathbb Q$-algebra contains an order (`weil_V_1_prop2`).
* **Text p. 81**: $\mathbb Z$ is the only order in $\mathbb Q$ (`weil_V_1_order_rat`).
-/

set_option linter.unusedSectionVars false

namespace NumberFieldKB.WeilBNT

variable {E : Type*} [AddCommGroup E] [Module ℚ E] [FiniteDimensional ℚ E]

/-- **Weil, V.§1 Def. 1**: a $\mathbb Q$-lattice in $E$ is a finitely generated subgroup of $E$ containing a basis of $E$
over $\mathbb Q$. -/
def IsQLattice (L : AddSubgroup E) : Prop :=
  L.FG ∧ ∃ (n : ℕ) (b : Module.Basis (Fin n) ℚ E), ∀ i, b i ∈ L

/-- Every vector has a positive integer multiple in a subgroup containing a basis. -/
theorem exists_pos_nsmul_mem {L' : AddSubgroup E} {n : ℕ} (b : Module.Basis (Fin n) ℚ E)
    (hb : ∀ i, b i ∈ L') (x : E) : ∃ m : ℕ, 0 < m ∧ m • x ∈ L' := by
  let P : AddSubmonoid E :=
    { carrier := {x | ∃ m : ℕ, 0 < m ∧ m • x ∈ L'}
      zero_mem' := ⟨1, one_pos, by simp⟩
      add_mem' := by
        rintro x y ⟨m, hm, hx⟩ ⟨k, hk, hy⟩
        refine ⟨m * k, Nat.mul_pos hm hk, ?_⟩
        have e1 : (m * k) • x = k • (m • x) := by rw [mul_comm, mul_smul]
        have e2 : (m * k) • y = m • (k • y) := mul_smul _ _ _
        rw [smul_add, e1, e2]
        exact L'.add_mem (L'.nsmul_mem hx _) (L'.nsmul_mem hy _) }
  have hx : x ∈ P := by
    rw [← b.sum_repr x]
    refine P.sum_mem fun i _ => ?_
    refine ⟨(b.repr x i).den, (b.repr x i).den_pos, ?_⟩
    rw [← Nat.cast_smul_eq_nsmul ℚ, smul_smul, Rat.den_mul_eq_num]
    have : ((b.repr x i).num : ℚ) • b i = (b.repr x i).num • b i := Int.cast_smul_eq_zsmul ℚ _ _
    rw [this]
    exact L'.zsmul_mem (hb i) _
  exact hx

/-- **Weil, V.§1 Prop. 1**: for $\mathbb Q$-lattices $L,L'$ there is an integer $m>0$ with $mL\subseteq L'$. -/
@[kb "weil1973bnt" "Ch. V, §1, Prop. 1 (p. 80)"]
theorem weil_V_1_prop1 {L L' : AddSubgroup E} (hL : IsQLattice L) (hL' : IsQLattice L') :
    ∃ m : ℕ, 0 < m ∧ ∀ x ∈ L, m • x ∈ L' := by
  obtain ⟨_, n, b, hb⟩ := hL'
  obtain ⟨t, ht, htfin⟩ := (AddSubgroup.fg_iff L).mp hL.1
  have h := fun x : E => exists_pos_nsmul_mem b hb x
  choose f hf0 hf using h
  refine ⟨∏ x ∈ htfin.toFinset, f x, Finset.prod_pos fun x _ => hf0 x, ?_⟩
  intro x hx
  rw [← ht] at hx
  induction hx using AddSubgroup.closure_induction with
  | mem y hy =>
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem f (htfin.mem_toFinset.mpr hy)
    rw [hk, mul_comm, mul_smul]
    exact L'.nsmul_mem (hf y) _
  | zero => simp
  | add y z _ _ hy hz => rw [smul_add]; exact L'.add_mem hy hz
  | neg y _ hy => rw [smul_neg]; exact L'.neg_mem hy

/-- **Weil, V.§1 Cor. 1 of Prop. 1**: a $\mathbb Q$-lattice is generated (as a group) by a basis of $E$ over
$\mathbb Q$. -/
@[kb "weil1973bnt" "Ch. V, §1, Cor. 1 of Prop. 1 (p. 80)"]
theorem weil_V_1_prop1_cor1 {L : AddSubgroup E} (hL : IsQLattice L) :
    ∃ (n : ℕ) (b : Module.Basis (Fin n) ℚ E), (∀ i, b i ∈ L) ∧ AddSubgroup.closure (Set.range b) = L := by
  obtain ⟨hfg, n, b, hb⟩ := hL
  have : NoZeroSMulDivisors ℤ E := ⟨fun {c x} h => by
    rw [← Int.cast_smul_eq_zsmul ℚ] at h
    rcases smul_eq_zero.mp h with h | h
    · left; exact_mod_cast h
    · right; exact h⟩
  have : Module.Finite ℤ L :=
    Module.Finite.iff_addGroup_fg.mpr ((AddGroup.fg_iff_addSubgroup_fg L).mpr hfg)
  have : Module.IsTorsionFree ℤ E := Module.IsTorsionFree.trans (R := ℚ)
  have : Module.IsTorsionFree ℤ L :=
    Function.Injective.moduleIsTorsionFree (R := ℤ) (fun x : L => (x : E)) Subtype.val_injective
      (fun _ _ => rfl)
  have : Module.Free ℤ L := Module.free_of_finite_type_torsion_free'
  let B := Module.Free.chooseBasis ℤ L
  let v : Module.Free.ChooseBasisIndex ℤ L → E := fun i => (B i : E)
  have hvL : ∀ i, v i ∈ L := fun i => (B i).2
  have hli : LinearIndependent ℤ v :=
    B.linearIndependent.map' L.subtype.toIntLinearMap
      (LinearMap.ker_eq_bot.mpr Subtype.val_injective)
  have hli' : LinearIndependent ℚ v := (LinearIndependent.iff_fractionRing ℤ ℚ).mp hli
  have hclos : AddSubgroup.closure (Set.range v) = L := by
    apply le_antisymm
    · exact (AddSubgroup.closure_le _).mpr (by rintro _ ⟨i, rfl⟩; exact hvL i)
    · intro x hx
      have key : ∀ y : L, (y : E) = ∑ i, (B.repr y i) • v i := by
        intro y
        have h := congrArg L.subtype (B.sum_repr y)
        rw [map_sum] at h
        refine h.symm.trans (Finset.sum_congr rfl fun i _ => ?_)
        simp [v]
      have hx' := key ⟨x, hx⟩
      simp only at hx'
      rw [hx']
      exact AddSubgroup.sum_mem _ fun i _ =>
        AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self i)) _
  have hspan : ⊤ ≤ Submodule.span ℚ (Set.range v) := by
    rw [← b.span_eq, Submodule.span_le]
    rintro _ ⟨i, rfl⟩
    have : b i ∈ AddSubgroup.closure (Set.range v) := by rw [hclos]; exact hb i
    exact (AddSubgroup.closure_le (Submodule.span ℚ (Set.range v)).toAddSubgroup).mpr
      Submodule.subset_span this
  let b2 := Module.Basis.mk hli' hspan
  let e := Fintype.equivFin (Module.Free.ChooseBasisIndex ℤ L)
  refine ⟨_, b2.reindex e, ?_, ?_⟩
  · intro i
    simpa [b2] using hvL _
  · rw [Module.Basis.range_reindex]
    have : Set.range b2 = Set.range v := by simp [b2]
    rw [this, hclos]

/-- A subgroup of a finitely generated subgroup is finitely generated. -/
theorem fg_of_le_fg {L L' : AddSubgroup E} (hL : L.FG) (hle : L' ≤ L) : L'.FG := by
  have h1 : (AddSubgroup.toIntSubmodule L).FG := by
    rw [Submodule.fg_iff_addSubgroup_fg, AddSubgroup.toIntSubmodule_toAddSubgroup]; exact hL
  have : Module.Finite ℤ (AddSubgroup.toIntSubmodule L) := Module.Finite.iff_fg.mpr h1
  have h2 : ((AddSubgroup.toIntSubmodule L').comap (AddSubgroup.toIntSubmodule L).subtype).FG :=
    IsNoetherian.noetherian _
  have h3 := h2.map (AddSubgroup.toIntSubmodule L).subtype
  rw [Submodule.map_comap_subtype, inf_eq_right.mpr (fun x hx => hle hx)] at h3
  rwa [Submodule.fg_iff_addSubgroup_fg, AddSubgroup.toIntSubmodule_toAddSubgroup] at h3

/-- **Weil, V.§1 Cor. 2 of Prop. 1**: a subgroup of a $\mathbb Q$-lattice containing a basis of $E$ is a
$\mathbb Q$-lattice. -/
@[kb "weil1973bnt" "Ch. V, §1, Cor. 2 of Prop. 1 (p. 80)"]
theorem weil_V_1_prop1_cor2 {L L' : AddSubgroup E} (hL : IsQLattice L) (hle : L' ≤ L)
    (hb : ∃ (n : ℕ) (b : Module.Basis (Fin n) ℚ E), ∀ i, b i ∈ L') : IsQLattice L' :=
  ⟨fg_of_le_fg hL.1 hle, hb⟩

variable {A : Type*} [Ring A] [Algebra ℚ A] [FiniteDimensional ℚ A]

/-- **Weil, V.§1 Def. 2**: an order of a finite-dimensional $\mathbb Q$-algebra $A$ is a subring (containing the unit)
which is a $\mathbb Q$-lattice in $A$. -/
def IsQOrder (R : Subring A) : Prop := IsQLattice R.toAddSubgroup

/-- **Weil, V.§1 Prop. 2**: every finite-dimensional algebra over $\mathbb Q$ contains an order. -/
@[kb "weil1973bnt" "Ch. V, §1, Prop. 2 (p. 81)"]
theorem weil_V_1_prop2 : ∃ R : Subring A, IsQOrder R := by
  let b := Module.finBasis ℚ A
  let N := Module.finrank ℚ A
  let c : Fin N × Fin N × Fin N → ℚ := fun p => b.repr (b p.1 * b p.2.1) p.2.2
  let m : ℕ := ∏ p, (c p).den
  have hm : 0 < m := Finset.prod_pos fun p _ => (c p).den_pos
  have hm' : (m : ℚ) ≠ 0 := by exact_mod_cast hm.ne'
  have hmc : ∀ p, ∃ z : ℤ, (m : ℚ) * c p = z := by
    intro p
    obtain ⟨k, hk⟩ := Finset.dvd_prod_of_mem (fun p => (c p).den) (Finset.mem_univ p)
    refine ⟨k * (c p).num, ?_⟩
    have hk' : (m : ℚ) = (c p).den * k := by exact_mod_cast hk
    have h := Rat.den_mul_eq_num (c p)
    rw [hk']
    push_cast
    linear_combination (k : ℚ) * h
  choose z hz using hmc
  let a : Fin N → A := fun i => (m : ℚ) • b i
  let S : Set A := insert 1 (Set.range a)
  let M : Submodule ℤ A := Submodule.span ℤ S
  have hSS : ∀ x ∈ S, ∀ y ∈ S, x * y ∈ M := by
    intro x hx y hy
    rcases hx with rfl | ⟨i, rfl⟩
    · rw [one_mul]; exact Submodule.subset_span hy
    rcases hy with rfl | ⟨j, rfl⟩
    · rw [mul_one]; exact Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)
    have hs : b i * b j = ∑ h, c (i, j, h) • b h := (b.sum_repr _).symm
    have : a i * a j = ∑ h, (z (i, j, h)) • a h := by
      show ((m : ℚ) • b i) * ((m : ℚ) • b j) = _
      rw [smul_mul_smul_comm, hs, Finset.smul_sum]
      refine Finset.sum_congr rfl fun h _ => ?_
      rw [smul_smul, ← Int.cast_smul_eq_zsmul ℚ, smul_smul]
      congr 1
      have := hz (i, j, h)
      linear_combination (m : ℚ) * this
    rw [this]
    exact M.sum_mem fun h _ =>
      M.smul_mem _ (Submodule.subset_span (Set.mem_insert_of_mem _ ⟨h, rfl⟩))
  have hMM : M * M ≤ M := by
    show Submodule.span ℤ S * Submodule.span ℤ S ≤ _
    rw [Submodule.span_mul_span]
    exact Submodule.span_le.mpr (by rintro _ ⟨x, hx, y, hy, rfl⟩; exact hSS x hx y hy)
  let R : Subring A :=
    { carrier := M
      mul_mem' := fun {x y} hx hy => hMM (Submodule.mul_mem_mul hx hy)
      one_mem' := Submodule.subset_span (Set.mem_insert _ _)
      add_mem' := fun {x y} hx hy => M.add_mem hx hy
      zero_mem' := M.zero_mem
      neg_mem' := fun {x} hx => M.neg_mem hx }
  refine ⟨R, ?_, ?_⟩
  · have hfin : S.Finite := (Set.finite_range a).insert 1
    exact (AddSubgroup.fg_iff _).mpr ⟨S, (Submodule.span_int_eq_addSubgroupClosure S).symm, hfin⟩
  · let w : Fin N → ℚˣ := fun _ => Units.mk0 (m : ℚ) hm'
    refine ⟨N, b.unitsSMul w, fun i => ?_⟩
    have : b.unitsSMul w i = a i := by
      simp [Module.Basis.unitsSMul_apply, w, a]
    rw [this]
    exact Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

/-- If `m * q` is an integer then the denominator of `q` divides `m`. -/
theorem den_dvd_of_mul_int {m : ℕ} {q : ℚ} {z : ℤ} (h : (m : ℚ) * q = z) : q.den ∣ m := by
  have h2 : (((m : ℤ) * q.num : ℤ) : ℚ) = ((z * q.den : ℤ) : ℚ) := by
    push_cast
    rw [← h, ← Rat.den_mul_eq_num]
    ring
  have h1 : (m : ℤ) * q.num = z * q.den := by exact_mod_cast h2
  have h3 := congrArg Int.natAbs h1
  simp only [Int.natAbs_mul, Int.natAbs_natCast] at h3
  have h4 : q.den ∣ m * q.num.natAbs := ⟨z.natAbs, by rw [h3]; ring⟩
  exact (Nat.Coprime.symm q.reduced).dvd_of_dvd_mul_right h4

/-- The subring `ℤ` of `ℚ` is a `ℚ`-lattice. -/
theorem isQLattice_int : IsQLattice (Int.castRingHom ℚ).range.toAddSubgroup := by
  refine ⟨(AddSubgroup.fg_iff _).mpr ⟨{1}, ?_, Set.finite_singleton _⟩, 1,
    Module.Basis.singleton (Fin 1) ℚ, fun i => ?_⟩
  · ext x
    simp [AddSubgroup.mem_closure_singleton]
  · simp [Module.Basis.singleton_apply]

/-- **Weil, V.§1 text p. 81**: $\mathbb Z$ is the only order in $\mathbb Q$. -/
@[kb "weil1973bnt" "Ch. V, §1, text p. 81 (Z is the only order of Q)"]
theorem weil_V_1_order_rat (R : Subring ℚ) : IsQOrder R ↔ (R : Set ℚ) = Set.range (Int.cast : ℤ → ℚ) := by
  constructor
  · intro hR
    obtain ⟨m, hm, hmR⟩ := weil_V_1_prop1 hR isQLattice_int
    ext r
    constructor
    · intro hr
      have hden : r.den = 1 := by
        by_contra hne
        have h2 : 2 ≤ r.den := by have := r.den_pos; omega
        have hk : ((r ^ m).den) ∣ m := by
          have := hmR (r ^ m) (R.pow_mem hr m)
          obtain ⟨z, hz⟩ := RingHom.mem_range.mp this
          have hz' : (z : ℚ) = m • r ^ m := by simpa using hz
          apply den_dvd_of_mul_int (z := z)
          rw [← nsmul_eq_mul, ← hz']
        rw [Rat.den_pow] at hk
        have h5 := Nat.le_of_dvd hm hk
        have h6 : 2 ^ m ≤ r.den ^ m := Nat.pow_le_pow_left h2 m
        have h7 := Nat.lt_two_pow_self (n := m)
        omega
      exact ⟨r.num, Rat.coe_int_num_of_den_eq_one hden⟩
    · rintro ⟨z, rfl⟩
      exact intCast_mem R z
  · intro h
    have : R = (Int.castRingHom ℚ).range := SetLike.coe_injective (by rw [h]; rfl)
    subst this
    exact isQLattice_int

end NumberFieldKB.WeilBNT
