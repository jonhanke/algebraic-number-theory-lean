import NumberFieldKB.MilneCFT.LubinTate.CyclotomicArtinQpProof
import NumberFieldKB.MilneCFT.LocalCFT.Consequences
import NumberFieldKB.MilneCFT.LocalCFT.UnconditionalYamaguchi
import NumberFieldKB.MilneCFT.LocalCFT.ReciprocityTauCeti
import NumberFieldKB.MilneCFT.LocalCFT.TotallyRamifiedTauCeti
import NumberFieldKB.MilneCFT.LocalCFT.Uniqueness
import NumberFieldKB.MilneCFT.LocalCFT.UnramifiedTauCeti

/-!
# Example 4.13: a finite abelian extension of `ℚ_5` that is not a compositum `L_t L_u` (proved)

Milne, *Class Field Theory*, Chapter I, Example 4.13. The statement is the named structure `Example413`
(`LubinTate/Complements.lean`); here it is proved for a separable closure `Ω` of `ℚ_5` in `Type`.

The extension is cut out by local class field theory. Let `ψ : ℚ_5ˣ → Multiplicative (ZMod 4)` be
`ψ(u 5^t) = t + 2 log₂ ū`, where `ū = u mod 5` and `log₂ : (ℤ/5)ˣ → ℤ/4` is the discrete logarithm to the base `2`
(`1 ↦ 0, 2 ↦ 1, 4 ↦ 2, 3 ↦ 3`; `Example413Aux.chi`, `Example413Aux.psiHom`, `Example413Aux.psiHom_formula`).
Its kernel `N` is open of index `4`. The field `L` with `Nm(L^×) = N` (existence theorem) lies in `ℚ_5(ζ_3120)`
by Example 3.13 (c) (`cyclotomicArtinQp_general`), has cyclic Galois group generated by `φ_L(5)`, and is not a
compositum of a totally ramified and an unramified extension (proof in `Example413Aux.example413_aux`).

Index shift: none (no indices are used).
-/

open scoped ValuativeRel

noncomputable section

set_option linter.unusedSectionVars false

namespace NumberFieldKB.MilneCFT.LocalCFT

open TauCeti TauCeti.ClassFieldTheory


section Example413Proof

namespace Example413Aux

/-- Discrete logarithm base `2` on `(ZMod 5)ˣ`: `1 ↦ 0, 2 ↦ 1, 4 ↦ 2, 3 ↦ 3`. -/
def chiFun (x : (ZMod 5)ˣ) : Multiplicative (ZMod 4) :=
  Multiplicative.ofAdd (match (x : ZMod 5).val with | 1 => 0 | 2 => 1 | 4 => 2 | _ => 3)

def chi : (ZMod 5)ˣ →* Multiplicative (ZMod 4) :=
  MonoidHom.mk' chiFun (by decide)

theorem chi_two : ∀ x : (ZMod 5)ˣ, (x : ZMod 5) = 2 → chi x ^ 2 ≠ 1 := by decide

theorem chi_eq_one_iff : ∀ x, chi x = 1 ↔ x = 1 := by decide

theorem gen_aux : ∀ (c : (ZMod 5)ˣ) (y : Multiplicative (ZMod 4)),
    ∃ k : Fin 4, y = (Multiplicative.ofAdd (1 : ZMod 4) * chi c ^ 2) ^ (k : ℕ) := by decide

/-- The valuation as a homomorphism. -/
def vHom : ℚ_[5]ˣ →* Multiplicative ℤ where
  toFun a := Multiplicative.ofAdd (Padic.valuation (a : ℚ_[5]))
  map_one' := by simp [Padic.valuation_one]
  map_mul' a b := by
    simp only [Units.val_mul]
    rw [Padic.valuation_mul a.ne_zero b.ne_zero]
    rfl

theorem norm_unitPartQ (a : ℚ_[5]ˣ) :
    ‖(a : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation (a : ℚ_[5]))‖ = 1 := by
  rw [norm_mul, Padic.norm_eq_zpow_neg_valuation a.ne_zero]
  have : ((5 : ℕ) : ℚ_[5]) ^ (-Padic.valuation (a : ℚ_[5])) = (5 : ℚ_[5]) ^ (-Padic.valuation (a : ℚ_[5])) := by
    norm_num
  rw [← this, Padic.norm_p_zpow, ← zpow_add₀ (by norm_num)]
  simp

/-- The unit part `a · 5^(-v(a))` of `a ∈ ℚ_5ˣ`, as an element of `ℤ_5`. -/
def upartZ (a : ℚ_[5]ˣ) : ℤ_[5] :=
  ⟨(a : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation (a : ℚ_[5])), (norm_unitPartQ a).le⟩

theorem isUnit_upartZ (a : ℚ_[5]ˣ) : IsUnit (upartZ a) := PadicInt.isUnit_iff.2 (norm_unitPartQ a)

theorem upartZ_mul (a b : ℚ_[5]ˣ) : upartZ (a * b) = upartZ a * upartZ b := by
  apply Subtype.ext
  show (((a * b : ℚ_[5]ˣ)) : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation ((a * b : ℚ_[5]ˣ) : ℚ_[5])) =
    ((a : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation (a : ℚ_[5]))) *
      ((b : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation (b : ℚ_[5])))
  rw [Units.val_mul, Padic.valuation_mul a.ne_zero b.ne_zero, neg_add, zpow_add₀ (by norm_num)]
  ring

theorem upartZ_one : upartZ 1 = 1 := by
  apply Subtype.ext
  show (((1 : ℚ_[5]ˣ)) : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation ((1 : ℚ_[5]ˣ) : ℚ_[5])) = 1
  simp [Padic.valuation_one]

/-- The unit part as a homomorphism `ℚ_5ˣ → ℤ_5ˣ`. -/
def upart : ℚ_[5]ˣ →* ℤ_[5]ˣ where
  toFun a := (isUnit_upartZ a).unit
  map_one' := Units.ext upartZ_one
  map_mul' a b := Units.ext (upartZ_mul a b)

/-- Reduction mod `5` of `ℤ_5`. -/
def toZ5 : ℤ_[5] →+* ZMod 5 := PadicInt.toZModPow 1

/-- Reduction mod `5` of a unit of `𝒪[ℚ_5]`. -/
def redU (u : 𝒪[ℚ_[5]]ˣ) : (ZMod 5)ˣ := Units.map toZ5.toMonoidHom (unitToZp 5 u)

/-- The character `ψ : ℚ_5ˣ → ℤ/4`, `ψ(u 5^t) = t + 2 log₂ ū`. -/
def psiHom : ℚ_[5]ˣ →* Multiplicative (ZMod 4) :=
  (AddMonoidHom.toMultiplicative (Int.castAddHom (ZMod 4))).comp vHom *
    ((powMonoidHom 2).comp (chi.comp ((Units.map toZ5.toMonoidHom).comp upart)))

theorem valuation_unit_zp (u : ℤ_[5]ˣ) : Padic.valuation (((u : ℤ_[5]) : ℚ_[5])) = 0 := by
  have hn : ‖((u : ℤ_[5]) : ℚ_[5])‖ = 1 := PadicInt.norm_units u
  have hne : ((u : ℤ_[5]) : ℚ_[5]) ≠ 0 := by simpa using u.ne_zero
  rw [Padic.norm_eq_zpow_neg_valuation hne] at hn
  have := (zpow_eq_one_iff_right₀ (a := ((5 : ℕ) : ℝ)) (by positivity) (by norm_num)).1 hn
  omega

theorem valuation_unitToK_mul (u : 𝒪[ℚ_[5]]ˣ) (t : ℤ) :
    Padic.valuation ((unitToK u * padicPrimeUnit 5 ^ t : ℚ_[5]ˣ) : ℚ_[5]) = t := by
  have h0 := valuation_unit_zp (unitToZp 5 u)
  rw [coe_unitToK_mul_zpow, Padic.valuation_mul (zpow_ne_zero _ (by norm_num))
    (by simpa using (unitToZp 5 u).ne_zero), Padic.valuation_zpow, Padic.valuation_p, h0]
  simp

theorem upart_unitToK_mul (u : 𝒪[ℚ_[5]]ˣ) (t : ℤ) :
    upart (unitToK u * padicPrimeUnit 5 ^ t) = unitToZp 5 u := by
  apply Units.ext
  apply Subtype.ext
  change (((unitToK u * padicPrimeUnit 5 ^ t : ℚ_[5]ˣ) : ℚ_[5])) * (5 : ℚ_[5]) ^
    (-Padic.valuation ((unitToK u * padicPrimeUnit 5 ^ t : ℚ_[5]ˣ) : ℚ_[5])) = _
  rw [valuation_unitToK_mul, coe_unitToK_mul_zpow]
  have : (((5 : ℕ) : ℚ_[5])) = 5 := by norm_num
  rw [this, mul_comm, ← mul_assoc, ← zpow_add₀ (by norm_num)]
  simp

theorem psiHom_formula (u : 𝒪[ℚ_[5]]ˣ) (t : ℤ) :
    psiHom (unitToK u * padicPrimeUnit 5 ^ t) =
      Multiplicative.ofAdd (t : ZMod 4) * chi (redU u) ^ 2 := by
  have hv : vHom (unitToK u * padicPrimeUnit 5 ^ t) = Multiplicative.ofAdd t := by
    show Multiplicative.ofAdd (Padic.valuation _) = _
    rw [valuation_unitToK_mul]
  simp only [psiHom, MonoidHom.mul_apply, MonoidHom.comp_apply, upart_unitToK_mul, hv]
  rfl

theorem decomp (a : ℚ_[5]ˣ) : ∃ (u : 𝒪[ℚ_[5]]ˣ) (t : ℤ), a = unitToK u * padicPrimeUnit 5 ^ t := by
  have hp := TauCeti.Padic.irreducible_natCast_self 5
  obtain ⟨v, hv, k, rfl⟩ := exists_unit_zpow _ hp a
  obtain ⟨u, hu⟩ := mem_unitGroup.1 hv
  have hvu : v = unitToK u := Units.ext hu.symm
  exact ⟨u, k, by rw [hvu, padicPrimeUnit_eq]⟩

theorem psiHom_prime_zpow (t : ℤ) : psiHom (padicPrimeUnit 5 ^ t) = Multiplicative.ofAdd (t : ZMod 4) := by
  have h := psiHom_formula 1 t
  have h1 : unitToK (1 : 𝒪[ℚ_[5]]ˣ) = 1 := Units.ext (by simp [unitToK])
  have h2 : redU 1 = 1 := Units.ext (by simp [redU, unitToZp])
  rw [h1, h2, map_one, one_pow, mul_one, one_mul] at h
  exact h

theorem toZ5_eq_zero_iff (z : ℤ_[5]) : toZ5 z = 0 ↔ ‖z‖ < 1 := by
  unfold toZ5
  rw [← RingHom.mem_ker, PadicInt.ker_toZModPow, pow_one, Ideal.mem_span_singleton,
    PadicInt.norm_lt_one_iff_dvd]

theorem psiHom_eq_one_of_norm_sub_one_lt (x : ℚ_[5]ˣ) (h : ‖(x : ℚ_[5]) - 1‖ < 1) : psiHom x = 1 := by
  have hn : ‖(x : ℚ_[5])‖ = 1 := by
    simpa using Padic.norm_eq_of_norm_sub_lt_right (z1 := (x : ℚ_[5])) (z2 := 1) (by simpa using h)
  have hv : Padic.valuation (x : ℚ_[5]) = 0 := by
    rw [Padic.norm_eq_zpow_neg_valuation x.ne_zero] at hn
    have := (zpow_eq_one_iff_right₀ (a := ((5 : ℕ) : ℝ)) (by positivity) (by norm_num)).1 hn
    omega
  have hu : upartZ x = ⟨(x : ℚ_[5]), hn.le⟩ := by
    apply Subtype.ext
    show (x : ℚ_[5]) * (5 : ℚ_[5]) ^ (-Padic.valuation (x : ℚ_[5])) = _
    rw [hv]; simp
  have h1 : toZ5 (upartZ x) = 1 := by
    rw [← sub_eq_zero, ← map_one toZ5, ← map_sub, toZ5_eq_zero_iff]
    rw [hu]
    exact h
  have h2 : (Units.map toZ5.toMonoidHom (upart x) : (ZMod 5)ˣ) = 1 := Units.ext h1
  have : vHom x = 1 := by
    show Multiplicative.ofAdd (Padic.valuation (x : ℚ_[5])) = 1
    rw [hv]; rfl
  simp only [psiHom, MonoidHom.mul_apply, MonoidHom.comp_apply, h2, this, map_one, mul_one]

theorem isOpen_ker_psiHom : IsOpen (psiHom.ker : Set ℚ_[5]ˣ) := by
  apply Subgroup.isOpen_of_mem_nhds _ (g := 1)
  have hopen : IsOpen {x : ℚ_[5]ˣ | ‖(x : ℚ_[5]) - 1‖ < 1} :=
    isOpen_lt (continuous_norm.comp (Units.continuous_val.sub continuous_const)) continuous_const
  refine Filter.mem_of_superset (hopen.mem_nhds (by simp)) ?_
  intro x hx
  exact psiHom_eq_one_of_norm_sub_one_lt x hx

theorem psiHom_surjective : Function.Surjective psiHom := by
  intro y
  refine ⟨padicPrimeUnit 5 ^ (y.toAdd.val : ℤ), ?_⟩
  rw [psiHom_prime_zpow]
  simp

theorem index_ker_psiHom : psiHom.ker.index = 4 := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.2 psiHom_surjective, Subgroup.card_top]
  simp

variable {Ω : Type} [Field Ω] [Algebra ℚ_[5] Ω] [IsSepClosure ℚ_[5] Ω]

/-- The cyclotomic extension `ℚ_5(ζ)` as a finite abelian extension. -/
def cyclo (ζ : Ω) (hζ : IsPrimitiveRoot ζ 3120) : FiniteAbelianExt ℚ_[5] Ω :=
  haveI : NeZero 3120 := ⟨by norm_num⟩
  haveI : IsCyclotomicExtension {3120} ℚ_[5] (IntermediateField.adjoin ℚ_[5] {ζ}) :=
    hζ.intermediateField_adjoin_isCyclotomicExtension _
  haveI : FiniteDimensional ℚ_[5] (IntermediateField.adjoin ℚ_[5] {ζ}) :=
    IntermediateField.adjoin.finiteDimensional (hζ.isIntegral (by norm_num)).tower_top
  haveI : IsAbelianGalois ℚ_[5] (IntermediateField.adjoin ℚ_[5] {ζ}) :=
    IsCyclotomicExtension.isAbelianGalois {3120} ℚ_[5] _
  { toField := IntermediateField.adjoin ℚ_[5] {ζ} }

theorem cyclo_toField (ζ : Ω) (hζ : IsPrimitiveRoot ζ 3120) :
    (cyclo ζ hζ).toField = IntermediateField.adjoin ℚ_[5] {ζ} := rfl

theorem isLocalArtinMap_tauCeti : IsLocalArtinMap (tauCetiArtin (K := ℚ_[5]) (Ω := Ω)) :=
  ⟨galRestrict_tauCetiArtin, fun hπ L hL => isFrobenius_tauCetiArtin hπ L hL,
    ker_tauCetiArtin, surjective_tauCetiArtin⟩

theorem orderOf_five_zmod : ∀ hm : Nat.Coprime 5 624, orderOf (ZMod.unitOfCoprime 5 hm) = 4 := by
  intro hm
  rw [orderOf_eq_iff (by norm_num)]
  have key : ∀ n : ℕ, ((ZMod.unitOfCoprime 5 hm ^ n : (ZMod 624)ˣ) : ZMod 624) = (5 : ZMod 624) ^ n := by
    intro n
    simp
  refine ⟨Units.ext (by rw [key]; decide), ?_⟩
  intro m hm4 hm0
  interval_cases m <;> (intro h; have := congrArg (fun x : (ZMod 624)ˣ => (x : ZMod 624)) h; simp only [key] at this; revert this; decide)

theorem normGroup_cyclo_le (ζ : Ω) (hζ : IsPrimitiveRoot ζ 3120) :
    normGroup (cyclo ζ hζ).toField ≤ psiHom.ker := by
  intro a ha
  obtain ⟨u, t, rfl⟩ := decomp a
  set M := cyclo ζ hζ with hM
  have hker : tauCetiArtin M (unitToK u * padicPrimeUnit 5 ^ t) = 1 := by
    rw [← MonoidHom.mem_ker, ker_tauCetiArtin]; exact ha
  have hm : Nat.Coprime 5 624 := by norm_num
  have hζ5 : IsPrimitiveRoot (ζ ^ 5) 624 := by
    have := hζ.pow_of_dvd (p := 5) (by norm_num) (by norm_num)
    simpa using this
  have hζ624 : IsPrimitiveRoot (ζ ^ 624) (5 ^ 1) := by
    have := hζ.pow_of_dvd (p := 624) (by norm_num) (by norm_num)
    simpa using this
  have hmem : ζ ∈ M.toField := IntermediateField.mem_adjoin_simple_self _ ζ
  have h1 : ζ ^ 5 ∈ M.toField := pow_mem hmem _
  have h2 : ζ ^ 624 ∈ M.toField := pow_mem hmem _
  obtain ⟨H1, H2⟩ := cyclotomicArtinQp_general 5 isLocalArtinMap_tauCeti 624 1 hm M (ζ ^ 5) (ζ ^ 624)
    h1 h2 hζ5 hζ624 u t
  -- the prime-to-5 part
  have ht : (4 : ℤ) ∣ t := by
    have e := H1 ((ZMod.unitOfCoprime 5 hm ^ t : (ZMod 624)ˣ) : ZMod 624).val
      (by rw [ZMod.natCast_zmod_val])
    rw [hker] at e
    have e' : (ζ ^ 5) ^ 1 = (ζ ^ 5) ^ ((ZMod.unitOfCoprime 5 hm ^ t : (ZMod 624)ˣ) : ZMod 624).val := by
      rw [pow_one]; exact e
    have e'' := cast_eq_of_pow_eq hζ5 e'
    rw [ZMod.natCast_zmod_val] at e''
    have e3 : ZMod.unitOfCoprime 5 hm ^ t = 1 := Units.ext (by simpa using e''.symm)
    have := orderOf_dvd_iff_zpow_eq_one.2 e3
    rwa [orderOf_five_zmod hm] at this
  -- the unit part
  have hu : redU u = 1 := by
    set k : ℕ := (((redU u)⁻¹ : (ZMod 5)ˣ) : ZMod 5).val with hk
    have hkc : (k : ZMod 5) = (((redU u)⁻¹ : (ZMod 5)ˣ) : ZMod 5) := ZMod.natCast_zmod_val _
    have hkm : (k : 𝒪[ℚ_[5]]) * u - 1 ∈ 𝓂[ℚ_[5]] ^ 1 := by
      rw [mem_maxIdeal_pow_iff, map_sub, map_mul, psi_natCast, psi_unit, map_one, sub_eq_zero]
      have : (k : ZMod 5) * ((redU u : (ZMod 5)ˣ) : ZMod 5) = 1 := by
        rw [hkc]; exact Units.inv_mul _
      exact this
    have e := H2 k hkm
    rw [hker] at e
    have e' : (ζ ^ 624) ^ 1 = (ζ ^ 624) ^ k := by
      rw [pow_one]; exact e
    have e'' := cast_eq_of_pow_eq hζ624 e'
    have e3 : (1 : ZMod 5) = (k : ZMod 5) := by simpa using e''
    rw [hkc] at e3
    have e4 : (redU u)⁻¹ = 1 := Units.ext e3.symm
    simpa using e4
  rw [MonoidHom.mem_ker, psiHom_formula, hu, map_one, one_pow, mul_one,
    (ZMod.intCast_zmod_eq_zero_iff_dvd t 4).2 (by exact_mod_cast ht)]
  rfl

theorem normGroup_congr {E E' : IntermediateField ℚ_[5] Ω} [FiniteDimensional ℚ_[5] E]
    [FiniteDimensional ℚ_[5] E'] (h : E = E') : normGroup E = normGroup E' := by
  subst h; rfl

theorem exists_ext_of_le (L : FiniteAbelianExt ℚ_[5] Ω) (E : IntermediateField ℚ_[5] Ω)
    [FiniteDimensional ℚ_[5] E] (h : E ≤ L.toField) : ∃ F : FiniteAbelianExt ℚ_[5] Ω, F.toField = E :=
  ⟨⟨L.toField ⊓ E⟩, inf_eq_right.2 h⟩

/-- A unit of `𝒪[ℚ_5]` whose reduction mod `5` is `2`. -/
theorem exists_unit_two : ∃ u : 𝒪[ℚ_[5]]ˣ, ((redU u : (ZMod 5)ˣ) : ZMod 5) = 2 := by
  have h : IsUnit ((2 : ℤ) : 𝒪[ℚ_[5]]) := _root_.Padic.isUnit_intCast_integerRing (by norm_num)
  refine ⟨h.unit, ?_⟩
  show toZ5 (_root_.Padic.integerRingEquiv 5 ((h.unit : 𝒪[ℚ_[5]]))) = 2
  rw [IsUnit.unit_spec, map_intCast, map_intCast]
  norm_num

theorem prime_unit_decomp {π : 𝒪[ℚ_[5]]} (hπ : Irreducible π) :
    ∃ w : 𝒪[ℚ_[5]]ˣ, primeUnit hπ = unitToK w * padicPrimeUnit 5 ^ (1 : ℤ) := by
  have hp := TauCeti.Padic.irreducible_natCast_self 5
  obtain ⟨w, hw⟩ := IsDiscreteValuationRing.associated_of_irreducible 𝒪[ℚ_[5]] hp hπ
  refine ⟨w, Units.ext ?_⟩
  simp only [primeUnit, unitToK, padicPrimeUnit, Units.val_mul, zpow_one, Units.val_mk0, Units.coe_map]
  rw [← hw]
  simp only [Subring.coe_mul]
  rw [mul_comm]
  rfl

theorem example413_aux (ζ : Ω) (hζ : IsPrimitiveRoot ζ 3120) : ∃ L : FiniteAbelianExt ℚ_[5] Ω,
    L.toField ≤ IntermediateField.adjoin ℚ_[5] {ζ} ∧ Module.finrank ℚ_[5] L.toField = 4 ∧
    IsCyclic Gal(L.toField/ℚ_[5]) ∧
    ¬ ∃ Lt Lu : IntermediateField ℚ_[5] Ω, FiniteDimensional ℚ_[5] Lt ∧ FiniteDimensional ℚ_[5] Lu ∧
      IsTotallyRamifiedExt Lt ∧ IsUnramifiedExt Lu ∧ L.toField = Lt ⊔ Lu := by
  have hfi : psiHom.ker.FiniteIndex := ⟨by rw [index_ker_psiHom]; norm_num⟩
  obtain ⟨L, hLN, -⟩ := existsUnique_normGroup_eq_unconditional Ω psiHom.ker isOpen_ker_psiHom hfi
  have hφ := isLocalArtinMap_tauCeti (Ω := Ω)
  refine ⟨L, ?_, ?_, ?_, ?_⟩
  · exact (le_iff_normGroup_le hφ L (cyclo ζ hζ)).2 ((normGroup_cyclo_le ζ hζ).trans hLN.ge)
  · rw [← index_normGroup hφ L, hLN, index_ker_psiHom]
  · refine ⟨⟨tauCetiArtin L (padicPrimeUnit 5), fun g => ?_⟩⟩
    obtain ⟨a, rfl⟩ := surjective_tauCetiArtin L g
    set k : ℤ := ((psiHom a).toAdd.val : ℤ) with hk
    have h0 : psiHom a = Multiplicative.ofAdd (k : ZMod 4) := by
      simp [hk]
    have h1 : psiHom (a * padicPrimeUnit 5 ^ (-k)) = 1 := by
      rw [map_mul, psiHom_prime_zpow, h0, ← ofAdd_add]
      simp
    have hmem : a * padicPrimeUnit 5 ^ (-k) ∈ normGroup L.toField := by rw [hLN]; exact h1
    rw [← ker_tauCetiArtin, MonoidHom.mem_ker, map_mul, map_zpow, zpow_neg, mul_inv_eq_one] at hmem
    exact Subgroup.mem_zpowers_iff.2 ⟨k, hmem.symm⟩
  · rintro ⟨Lt, Lu, hLt, hLu, htot, hun, hsup⟩
    obtain ⟨Ft, hFt⟩ := exists_ext_of_le L Lt (hsup ▸ le_sup_left)
    obtain ⟨Fu, hFu⟩ := exists_ext_of_le L Lu (hsup ▸ le_sup_right)
    have htot' : IsTotallyRamifiedExt Ft.toField := by rw [hFt]; exact htot
    have hun' : IsUnramifiedExt Fu.toField := by rw [hFu]; exact hun
    have hLsup : L.toField = Ft.toField ⊔ Fu.toField := by rw [hFt, hFu]; exact hsup
    have hN : psiHom.ker = normGroup Ft.toField ⊓ normGroup Fu.toField := by
      rw [← hLN, normGroup_congr hLsup]
      exact normGroup_sup hφ Ft Fu
    obtain ⟨π, hπ, hπmem⟩ := ((totallyRamifiedNormInput ℚ_[5] Ω).iff Ft.toField).1 htot'
    obtain ⟨w, hw⟩ := prime_unit_decomp hπ
    have hψπ : psiHom (primeUnit hπ) = Multiplicative.ofAdd (1 : ZMod 4) * chi (redU w) ^ 2 := by
      rw [hw, psiHom_formula]; simp
    obtain ⟨u, hu⟩ := exists_unit_two
    set x : ℚ_[5]ˣ := unitToK u with hx
    obtain ⟨j, hj⟩ := gen_aux (redU w) (psiHom x)
    have hxFt : x ∈ normGroup Ft.toField := by
      have h1 : x * (primeUnit hπ) ^ (-(j : ℤ)) ∈ psiHom.ker := by
        rw [MonoidHom.mem_ker, map_mul, map_zpow, hψπ, zpow_neg, zpow_natCast, ← hj, mul_inv_cancel]
      have h2 := (hN ▸ h1 : x * (primeUnit hπ) ^ (-(j : ℤ)) ∈ normGroup Ft.toField ⊓ normGroup Fu.toField).1
      have h3 := mul_mem h2 (zpow_mem hπmem (j : ℤ))
      simpa using h3
    have hxFu : x ∈ normGroup Fu.toField := by
      rw [← ker_tauCetiArtin, MonoidHom.mem_ker]
      exact artin_unit_eq_one (unramifiedInput ℚ_[5] Ω) hφ (mem_unitGroup.2 ⟨u, rfl⟩) Fu hun'
    have hxN : x ∈ psiHom.ker := by rw [hN]; exact ⟨hxFt, hxFu⟩
    have h5 : psiHom x = Multiplicative.ofAdd ((0 : ℤ) : ZMod 4) * chi (redU u) ^ 2 := by
      rw [hx, ← mul_one (unitToK u), ← zpow_zero (padicPrimeUnit 5), psiHom_formula]
    rw [MonoidHom.mem_ker] at hxN
    rw [hxN] at h5
    simp only [Int.cast_zero, ofAdd_zero, one_mul] at h5
    exact chi_two (redU u) hu h5.symm

end Example413Aux

open Example413Aux in
/-- **Example 4.13** (Milne, *CFT*, I, Example 4.13), proved for a separable closure `Ω` of `ℚ_5` in `Type`.
The character `ψ : ℚ_5ˣ → ℤ/4`, `ψ(u 5^t) = t + 2 log₂ ū` (`log₂` the discrete logarithm of `ū = u mod 5` to the
base `2` in `(ℤ/5)ˣ`), has open kernel `N` of index `4` (`Example413Aux.psiHom`). By the local existence theorem
(`existsUnique_normGroup_eq_unconditional`) `N` is the norm group of a finite abelian extension `L`, of degree `4`
(`index_normGroup`), contained in `ℚ_5(ζ_3120)` because `Nm(ℚ_5(ζ_3120)^×) ⊆ N` by Example 3.13 (c)
(`cyclotomicArtinQp_general`, `normGroup_cyclo_le`), and cyclic, generated by `φ_L(5)`. If `L = L_t L_u` with `L_t`
totally ramified and `L_u` unramified, then `Nm(L_t^×)` contains a prime element (`totallyRamifiedNormInput`), whose
image under `ψ` is odd, hence generates `ℤ/4`, so `Nm(L_t^×) = K^×`; hence the unit `2` would lie in
`Nm(L_t^×) ∩ Nm(L_u^×) = N` (units are norms from the unramified `L_u`, `artin_unit_eq_one`), but `ψ(2) = 2 ≠ 0`. -/
@[kb "milne2020cft" "Ch. I, Example 4.13"]
theorem example413 {Ω : Type} [Field Ω] [Algebra ℚ_[5] Ω] [IsSepClosure ℚ_[5] Ω] : Example413 Ω :=
  ⟨fun ζ hζ => example413_aux ζ hζ⟩

end Example413Proof

end NumberFieldKB.MilneCFT.LocalCFT
