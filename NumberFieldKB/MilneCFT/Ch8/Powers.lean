import NumberFieldKB.MilneCFT.Ch8.Reciprocity

/-!
# Milne, *Class Field Theory*, Chapter VIII §1: when are local $n$th powers global $n$th powers?

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII §1,
printed pp. 229–231 (printed page = pdf page − 9).

The primes $v$ of a number field $K$ are the finite primes `HeightOneSpectrum (𝓞 K)`, with completion
`v.adicCompletion K`. Every statement below allows finitely many exceptional primes, so the (finitely many) infinite
primes can be ignored: "for all but finitely many primes $v$" is `∀ᶠ v in Filter.cofinite`.

* **Theorem 1.1** (`theorem_1_1`): if $K$ contains a primitive $n$th root of $1$, an element of $K^\times$ that is an
  $n$th power in $K_v$ for almost all $v$ is an $n$th power in $K$.
* **Remark 1.2** (`remark_1_2`): the same with "a set of primes of Dirichlet density $> 1/2$".
* **Exercise 1.3** (`exercise_1_3`): $16$ is an $8$th power in $\mathbb R$ and in $\mathbb Q_p$ for every odd $p$, but
  not in $\mathbb Q$; and (`not_eighth_power_padic_two`, Example 2.2 (i)) not in $\mathbb Q_2$.
* **Theorem 1.4** (`theorem_1_4`): the same conclusion when $K[\zeta_{2^t}]/K$ is cyclic, $2^t \| n$.
* **Remark 1.5** (`Remark1_5a`, `Remark1_5aRat`, named statements; `remark_1_5b` proved).
-/

open NumberField IsDedekindDomain NumberFieldKB.Chebotarev

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8

variable {K : Type} [Field K] [NumberField K]

open scoped IsMulCommutative Topology
open Filter

/-! ### Helper lemmas -/

/-- The set $S(n, a)$ of primes dividing $n$ or where $a$ is not a unit is finite for $n \ne 0$, $a \ne 0$. -/
theorem Sset_finite (n : ℕ) (hn : 0 < n) (a : K) (ha : a ≠ 0) :
    (Sset n {a} : Set (HeightOneSpectrum (𝓞 K))).Finite := by
  have h1 : {v : HeightOneSpectrum (𝓞 K) | (n : 𝓞 K) ∈ v.asIdeal}.Finite := by
    refine (Ideal.finite_factors (I := Ideal.span {(n : 𝓞 K)}) ?_).subset ?_
    · simpa using hn.ne'
    · intro v hv
      exact (Ideal.dvd_span_singleton.2 hv)
  have h2 : {v : HeightOneSpectrum (𝓞 K) | v.valuation K a ≠ 1}.Finite := by
    refine ((HeightOneSpectrum.Support.finite (𝓞 K) a).union
      (HeightOneSpectrum.Support.finite (𝓞 K) a⁻¹)).subset ?_
    intro v hv
    rcases lt_or_gt_of_ne (show v.valuation K a ≠ 1 from hv) with h | h
    · right
      show 1 < v.valuation K a⁻¹
      rw [map_inv₀]
      exact one_lt_inv_iff₀.2 ⟨zero_lt_iff.2 (by simpa using ha), h⟩
    · left; exact h
  refine (h1.union h2).subset ?_
  rintro v (h | ⟨b, hb, h⟩)
  · exact Or.inl h
  · rw [Set.mem_singleton_iff.1 hb] at h; exact Or.inr h

open Polynomial in
/-- **Kummer setup**: if $K$ contains a primitive $n$th root of $1$ and $a \ne 0$, then $L = K(\alpha)$, $\alpha$ a
root of $X^n - a$ (a splitting field of $X^n - a$), is a number field, abelian Galois over $K$, generated by
$\alpha$. -/
theorem exists_kummer_field (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0) :
    ∃ (L : Type) (_ : Field L) (_ : NumberField L) (_ : Algebra K L) (_ : IsAbelianGalois K L) (α : L),
      α ^ n = algebraMap K L a ∧ IntermediateField.adjoin K {α} = ⊤ := by
  classical
  set p : K[X] := X ^ n - C a with hp
  have hpn : p.natDegree = n := by rw [hp]; exact natDegree_X_pow_sub_C
  have hp0 : p ≠ 0 := by
    intro h; rw [h] at hpn; simp at hpn; omega
  let L := p.SplittingField
  have : NumberField L := NumberField.of_module_finite K L
  have hsep : p.Separable := by
    rw [hp]
    exact separable_X_pow_sub_C a (by exact_mod_cast hn.ne') ha
  have : IsGalois K L := IsGalois.of_separable_splitting_field (p := p) hsep
  have hsplit := SplittingField.splits p
  obtain ⟨α, hα⟩ : ∃ α : L, eval α (p.map (algebraMap K L)) = 0 := by
    refine hsplit.exists_eval_eq_zero ?_
    rw [degree_map]
    intro h
    rw [degree_eq_natDegree hp0, hpn] at h
    simp at h
    omega
  have hαn : α ^ n = algebraMap K L a := by
    have h' : α ^ n - algebraMap K L a = 0 := by simpa [hp] using hα
    exact sub_eq_zero.1 h'
  have hroot : ∀ β : L, β ^ n = algebraMap K L a → ∃ i : ℕ, β = algebraMap K L ζ ^ i * α := by
    intro β hβ
    have hα0 : α ≠ 0 := by
      intro h; rw [h, zero_pow hn.ne'] at hαn
      exact ha ((map_eq_zero _).1 hαn.symm)
    have h1 : (β / α) ^ n = 1 := by
      rw [div_pow, hβ, hαn, div_self]
      exact (_root_.map_ne_zero _).2 ha
    have : NeZero n := ⟨hn.ne'⟩
    have hζL : IsPrimitiveRoot (algebraMap K L ζ) n := hζ.map_of_injective (algebraMap K L).injective
    obtain ⟨i, -, hi⟩ := hζL.eq_pow_of_pow_eq_one h1
    exact ⟨i, (div_eq_iff hα0).1 hi.symm⟩
  have hgen : IntermediateField.adjoin K {α} = ⊤ := by
    rw [eq_top_iff]
    have h1 := IsSplittingField.adjoin_rootSet L p
    have h2 : Algebra.adjoin K (p.rootSet L) ≤ (IntermediateField.adjoin K {α}).toSubalgebra := by
      rw [Algebra.adjoin_le_iff]
      intro β hβ
      rw [mem_rootSet] at hβ
      have hβn : β ^ n = algebraMap K L a := by
        have h' := hβ.2
        simp only [hp, map_sub, map_pow, aeval_X, aeval_C] at h'
        exact sub_eq_zero.1 h'
      obtain ⟨i, rfl⟩ := hroot β hβn
      exact mul_mem (pow_mem (IntermediateField.algebraMap_mem _ _) i)
        (IntermediateField.subset_adjoin K {α} rfl)
    rw [h1] at h2
    intro x _
    exact h2 (Algebra.mem_top)
  have hgen' : Algebra.adjoin K {α} = ⊤ := by
    have := IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (F := K)
      (IsAlgebraic.of_finite K α)
    rw [hgen] at this
    simpa using this.symm
  have ext_gen : ∀ σ τ : Gal(L/K), σ α = τ α → σ = τ := fun σ τ h =>
    AlgEquiv.coe_toAlgHom_injective (AlgHom.ext_of_adjoin_eq_top hgen' (by simpa using h))
  have hact : ∀ σ : Gal(L/K), ∃ i : ℕ, σ α = algebraMap K L ζ ^ i * α := by
    intro σ
    refine hroot _ ?_
    rw [← map_pow, hαn]; exact σ.commutes a
  have hcomm : ∀ σ τ : Gal(L/K), σ * τ = τ * σ := by
    intro σ τ
    obtain ⟨i, hi⟩ := hact σ
    obtain ⟨j, hj⟩ := hact τ
    apply ext_gen
    simp only [AlgEquiv.mul_apply]
    rw [hj, hi, map_mul, map_mul, map_pow, map_pow, σ.commutes, τ.commutes, hi, hj]
    ring
  have : IsMulCommutative Gal(L/K) := ⟨⟨hcomm⟩⟩
  have : IsAbelianGalois K L := {}
  exact ⟨L, inferInstance, inferInstance, inferInstance, this, α, hαn, hgen⟩

/-- In the Kummer extension, a prime outside $S(n,a)$ at which $a$ is a residue $n$th power splits completely. -/
theorem split_of_residue (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0)
    (L : Type) [Field L] [NumberField L] [Algebra K L] [IsAbelianGalois K L] (α : L)
    (hα : α ^ n = algebraMap K L a) (hgen : IntermediateField.adjoin K {α} = ⊤)
    (v : HeightOneSpectrum (𝓞 K)) (hv : v ∉ Sset n {a})
    (hx : ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1) : v ∈ splitPrimes K L := by
  have hpr : powerResidue n a v = 1 := ((item_5_2 n hn ζ hζ a v hv).out 2 1).1 hx
  obtain ⟨hunr, hfr⟩ := item_5_3 n hn ζ hζ a ha L α hα hgen v hv
  rw [hpr, map_one, one_mul] at hfr
  have hgen' : Algebra.adjoin K {α} = ⊤ := by
    have := IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic (F := K)
      (IsAlgebraic.of_finite K α)
    rw [hgen] at this
    simpa using this.symm
  have h1 : artinFrob L v = 1 :=
    AlgEquiv.coe_toAlgHom_injective (AlgHom.ext_of_adjoin_eq_top hgen' (by simpa using hfr))
  rw [splitPrimes_eq_frobSet_one]
  refine ⟨hunr, ?_⟩
  set Q : v.asIdeal.primesOver (𝓞 L) := Classical.arbitrary _
  rw [frobClass_eq_mk_frobAt K L v Q, ← artinFrob_eq L v hunr Q, h1]

omit [NumberField K] in
/-- If the Kummer extension is trivial, $a$ is an $n$th power. -/
theorem exists_pow_of_finrank_eq_one (n : ℕ) (a : K)
    (L : Type) [Field L] [Algebra K L] [FiniteDimensional K L] (α : L)
    (hα : α ^ n = algebraMap K L a) (hgen : IntermediateField.adjoin K {α} = ⊤)
    (h1 : Module.finrank K L = 1) : ∃ b : K, b ^ n = a := by
  have h2 : (⊤ : IntermediateField K L) = ⊥ := by
    rw [← IntermediateField.finrank_eq_one_iff, IntermediateField.finrank_top', h1]
  rw [h2] at hgen
  have : α ∈ (IntermediateField.adjoin K {α}) := IntermediateField.subset_adjoin K {α} rfl
  rw [hgen] at this
  obtain ⟨b, hb⟩ := IntermediateField.mem_bot.1 this
  refine ⟨b, (algebraMap K L).injective ?_⟩
  rw [map_pow, hb, hα]

/-- **Core**: if $a \ne 0$ is a residue $n$th power at the primes outside $S(n,a)$ of a set $T$ of Dirichlet
density $\delta > 1/2$, then $a$ is an $n$th power in $K$ (here $K \ni \zeta_n$). -/
theorem pow_of_residue_density (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0)
    (T : Set (HeightOneSpectrum (𝓞 K))) (δ : ℝ) (hT : T.HasDirichletDensity δ) (hδ : 1 / 2 < δ)
    (h : ∀ v ∈ T, v ∉ Sset n {a} → ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1) :
    ∃ b : K, b ^ n = a := by
  obtain ⟨L, _, _, _, _, α, hα, hgen⟩ := exists_kummer_field n hn ζ hζ a ha
  have hsub : T \ Sset n {a} ⊆ splitPrimes K L := fun v hv =>
    split_of_residue n hn ζ hζ a ha L α hα hgen v hv.2 (h v hv.1 hv.2)
  have hS := Sset_finite n hn a ha
  have hT' : (T \ Sset n {a}).HasDirichletDensity δ := by
    refine HasDirichletDensity.congr_finite hT ?_
    refine hS.subset ?_
    intro v hv
    rcases hv with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · by_contra hh; exact h2 ⟨h1, hh⟩
    · exact absurd h1.1 h2
  have hsp := splitPrimes_hasDirichletDensity_unconditional K L
  have hle : δ ≤ 1 / (Module.finrank K L : ℝ) := by
    refine le_of_tendsto_of_tendsto hT' hsp ?_
    filter_upwards [self_mem_nhdsWithin] with s (hs : 1 < s)
    exact dirichletRatio_mono hsub hs
  have h1 : Module.finrank K L = 1 := by
    by_contra hne
    have h2 : 2 ≤ Module.finrank K L := by have := Module.finrank_pos (R := K) (M := L); omega
    have h3 : (2 : ℝ) ≤ Module.finrank K L := by exact_mod_cast h2
    have h4 : 1 / (Module.finrank K L : ℝ) ≤ 1 / 2 :=
      one_div_le_one_div_of_le (by norm_num) h3
    linarith
  exact exists_pow_of_finrank_eq_one n a L α hα hgen h1

/-- The residue form of Theorem 1.1: $a$ is an $n$th power in $K \ni \zeta_n$ if it is an $n$th power modulo
almost every prime. -/
theorem pow_of_eventually_residue (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0)
    (h : ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1) :
    ∃ b : K, b ^ n = a := by
  have hfin : {v : HeightOneSpectrum (𝓞 K) | ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1}ᶜ.Finite :=
    Filter.eventually_cofinite.1 h
  have hd := HasDirichletDensity.compl (hasDirichletDensity_of_finite hfin)
  rw [compl_compl, sub_zero] at hd
  exact pow_of_residue_density n hn ζ hζ a ha _ 1 hd (by norm_num) (fun v hv _ => hv)

/-- **Theorem 1.1** (Milne, *CFT*, VIII, Theorem 1.1, p. 229): let $K$ be a number field containing a primitive $n$th
root of $1$. A nonzero element of $K$ is an $n$th power in $K$ if it is an $n$th power in $K_v$ for all but possibly
finitely many primes $v$. (Milne's proof uses Chapter VII, 4.6; here it is proved from the unconditional Chebotarev
density theorem through the density $1/[L:K]$ of the split primes, `splitPrimes_hasDirichletDensity_unconditional`.) -/
@[kb "milne2020cft" "Ch. VIII, Theorem 1.1, p. 229"]
theorem theorem_1_1 (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0)
    (h : ∀ᶠ v in Filter.cofinite, IsLocalPow n a v) : ∃ b : K, b ^ n = a := by
  have hS := Sset_finite n hn a ha
  have h' : ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1 := by
    filter_upwards [h, (Filter.eventually_cofinite.2 (by simpa using hS) :
        ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, v ∉ Sset n {a})]
      with v hv hvS
    exact ((item_5_2 n hn ζ hζ a v hvS).out 3 2).1 hv
  exact pow_of_eventually_residue n hn ζ hζ a ha h'

/-- **Remark 1.2** (Milne, *CFT*, VIII, Remark 1.2, p. 229): under the hypothesis of Theorem 1.1 ($K$ contains a
primitive $n$th root of $1$), a nonzero $a \in K$ is an $n$th power in $K$ if it is an $n$th power in $K_v$ for a set
of primes $v$ of Dirichlet density $> 1/2$ (Mathlib's `NumberField.Set.HasDirichletDensity`). -/
@[kb "milne2020cft" "Ch. VIII, Remark 1.2, p. 229"]
theorem remark_1_2 (n : ℕ) (hn : 0 < n) (ζ : K) (hζ : IsPrimitiveRoot ζ n) (a : K) (ha : a ≠ 0)
    (T : Set (HeightOneSpectrum (𝓞 K))) (δ : ℝ) (hT : T.HasDirichletDensity δ) (hδ : 1 / 2 < δ)
    (h : ∀ v ∈ T, IsLocalPow n a v) : ∃ b : K, b ^ n = a :=
  pow_of_residue_density n hn ζ hζ a ha T δ hT hδ fun v hv hvS =>
    ((item_5_2 n hn ζ hζ a v hvS).out 3 2).1 (h v hv)

/-- $x^{N\mathfrak p} \equiv x \pmod{\mathfrak p}$ for $x \in \mathcal O_K$. -/
theorem pow_absNorm_sub_self_mem (v : HeightOneSpectrum (𝓞 K)) (x : 𝓞 K) :
    x ^ Ideal.absNorm v.asIdeal - x ∈ v.asIdeal := by
  have := v.isMaximal
  have : Finite (𝓞 K ⧸ v.asIdeal) := Ideal.finiteQuotientOfFreeOfNeBot v.asIdeal v.ne_bot
  let _ : Fintype (𝓞 K ⧸ v.asIdeal) := Fintype.ofFinite _
  let _ : Field (𝓞 K ⧸ v.asIdeal) := Ideal.Quotient.field v.asIdeal
  have hq : Ideal.absNorm v.asIdeal = Fintype.card (𝓞 K ⧸ v.asIdeal) := by
    rw [Ideal.absNorm_apply, Submodule.cardQuot_apply, Nat.card_eq_fintype_card]
  rw [← Ideal.Quotient.eq, map_pow, hq]
  exact FiniteField.pow_card _

/-- **A Frobenius element fixes a root.** Let $M/K$ be an extension of number fields containing a primitive $n$th
root $z$ of $1$ and a root $\beta$ of $X^n - a$ ($a \in K$). If $\mathfrak p = v \notin S(n,a)$ and $a$ is an $n$th
power modulo $v$, then an element $\sigma$ with $\sigma y \equiv y^{N v} \pmod Q$ for all $y \in \mathcal O_M$ ($Q$ a
prime above $v$) fixes one of the roots $z^j\beta$ of $X^n - a$. -/
theorem frob_fixes_root {M : Type} [Field M] [NumberField M] [Algebra K M]
    (n : ℕ) (hn : 0 < n) (z : M) (hz : IsPrimitiveRoot z n) (a : K) (ha : a ≠ 0) (β : M)
    (hβ : β ^ n = algebraMap K M a) (v : HeightOneSpectrum (𝓞 K)) (hv : v ∉ Sset n {a})
    (x0 : 𝓞 K) (hx0 : v.valuation K ((x0 : K) ^ n - a) < 1)
    (Q : Ideal (𝓞 M)) [Q.IsPrime] [Q.LiesOver v.asIdeal] (σ : Gal(M/K))
    (hσ : ∀ y : 𝓞 M, σ • y - y ^ Ideal.absNorm v.asIdeal ∈ Q) :
    ∃ j : ℕ, σ (z ^ j * β) = z ^ j * β := by
  have : NeZero n := ⟨hn.ne'⟩
  obtain ⟨hnv, hav⟩ := (notMem_Sset_iff v n a).1 hv
  obtain ⟨d, c, hd, hc, hcd⟩ := exists_scale v hn a hav
  obtain ⟨B, hB⟩ := exists_beta hn a M β hβ d c hcd
  have hint : IsIntegral ℤ z := hz.isIntegral hn
  let z' : 𝓞 M := ⟨z, hint⟩
  have hz' : IsPrimitiveRoot z' n :=
    IsPrimitiveRoot.of_map_of_injective (f := algebraMap (𝓞 M) M) (by exact hz)
      (RingOfIntegers.coe_injective)
  have hQ_under : ∀ x : 𝓞 K, x ∈ v.asIdeal → algebraMap (𝓞 K) (𝓞 M) x ∈ Q := by
    intro x hx
    have : x ∈ Q.under (𝓞 K) := by rwa [← Ideal.over_def Q v.asIdeal]
    exact this
  have hQ_notin : ∀ x : 𝓞 K, algebraMap (𝓞 K) (𝓞 M) x ∈ Q → x ∈ v.asIdeal := fun x hx => by
    rw [Ideal.over_def Q v.asIdeal]; exact hx
  set x1 : 𝓞 K := d * x0 with hx1
  have h1 : x1 ^ n - c ∈ v.asIdeal := by
    rw [← v.valuation_lt_one_iff_mem (K := K)]
    have hcd' : algebraMap (𝓞 K) K c = (algebraMap (𝓞 K) K d) ^ n * a := hcd
    have e : algebraMap (𝓞 K) K (x1 ^ n - c) =
        (algebraMap (𝓞 K) K d) ^ n * ((algebraMap (𝓞 K) K x0) ^ n - a) := by
      rw [map_sub, map_pow, hcd', hx1, map_mul]; ring
    show v.valuation K (algebraMap (𝓞 K) K (x1 ^ n - c)) < 1
    rw [e, map_mul, map_pow, (v.valuation_eq_one_iff_notMem (K := K)).2 hd]
    simpa using hx0
  have e1 : (B : M) ^ n = algebraMap K M c := by
    rw [hB, mul_pow, hβ, ← map_pow, ← map_mul, hcd]
  have hBn : B ^ n = algebraMap (𝓞 K) (𝓞 M) c := RingOfIntegers.ext e1
  have hprod := hz'.pow_sub_pow_eq_prod_sub_mul (algebraMap (𝓞 K) (𝓞 M) x1) B hn
  have hmem : (algebraMap (𝓞 K) (𝓞 M) x1) ^ n - B ^ n ∈ Q := by
    rw [hBn, ← map_pow, ← map_sub]; exact hQ_under _ h1
  rw [hprod] at hmem
  obtain ⟨ζ0, hζ0, hmem0⟩ := (Ideal.IsPrime.prod_mem_iff (p := Q)).1 hmem
  have hζ0' : ζ0 ^ n = 1 := (Polynomial.mem_nthRootsFinset hn (1 : 𝓞 M)).1 hζ0
  obtain ⟨j, -, hj⟩ := hz'.eq_pow_of_pow_eq_one hζ0'
  rw [← hj] at hmem0
  set Y : 𝓞 M := z' ^ j * B with hY
  set X1 : 𝓞 M := algebraMap (𝓞 K) (𝓞 M) x1 with hX1
  have hYQ : σ • Y - Y ∈ Q := by
    have h2 : Y ^ Ideal.absNorm v.asIdeal - X1 ^ Ideal.absNorm v.asIdeal ∈ Q := by
      obtain ⟨q, hq⟩ := sub_dvd_pow_sub_pow Y X1 (Ideal.absNorm v.asIdeal)
      have : Y - X1 ∈ Q := by
        have := Q.neg_mem hmem0
        rwa [neg_sub] at this
      rw [hq]; exact Q.mul_mem_right _ this
    have h3 : X1 ^ Ideal.absNorm v.asIdeal - X1 ∈ Q := by
      rw [hX1, ← map_pow, ← map_sub]; exact hQ_under _ (pow_absNorm_sub_self_mem v x1)
    have key : σ • Y - Y = (σ • Y - Y ^ Ideal.absNorm v.asIdeal) +
        (Y ^ Ideal.absNorm v.asIdeal - X1 ^ Ideal.absNorm v.asIdeal) +
        (X1 ^ Ideal.absNorm v.asIdeal - X1) + (X1 - Y) := by ring
    rw [key]
    exact add_mem (add_mem (add_mem (hσ Y) h2) h3) hmem0
  -- the action of σ on the root γ = z^j β
  set γ : M := z ^ j * β with hγ
  have hγn : γ ^ n = algebraMap K M a := by
    have : (z ^ j) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hz.pow_eq_one, one_pow]
    rw [hγ, mul_pow, this, one_mul, hβ]
  have hγ0 : γ ≠ 0 := by
    intro h; rw [h, zero_pow hn.ne'] at hγn
    exact ha ((algebraMap K M).injective (by simpa using hγn.symm))
  obtain ⟨m, hm, hmσ⟩ : ∃ m < n, z ^ m = σ γ / γ := by
    refine hz.eq_pow_of_pow_eq_one ?_
    rw [div_pow, ← map_pow, hγn, AlgEquiv.commutes, div_self]
    exact (_root_.map_ne_zero _).2 ha
  have hσγ : σ γ = z ^ m * γ := by rw [hmσ]; field_simp
  have hYγ : (Y : M) = algebraMap K M d * γ := by
    have : ((z' ^ j * B : 𝓞 M) : M) = z ^ j * (B : M) := by push_cast; rfl
    rw [hY, this, hB, hγ]; ring
  have hdiff : σ • Y - Y = (z' ^ m - 1) * Y := by
    apply RingOfIntegers.ext
    change σ (Y : M) - (Y : M) = ((z ^ m - 1 : M)) * (Y : M)
    rw [hYγ, map_mul, AlgEquiv.commutes, hσγ]; ring
  have hYnot : Y ∉ Q := by
    intro hYQ'
    have h2 : Y ^ n ∈ Q := Q.pow_mem_of_mem hYQ' n hn
    have : Y ^ n = algebraMap (𝓞 K) (𝓞 M) c := by
      have h3 : (z' ^ j) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hz'.pow_eq_one, one_pow]
      rw [hY, mul_pow, h3, one_mul, hBn]
    rw [this] at h2
    exact hc (hQ_notin c h2)
  have hzm : z' ^ m - 1 ∈ Q := by
    rw [hdiff] at hYQ
    exact (Ideal.IsPrime.mem_or_mem inferInstance hYQ).resolve_right hYnot
  let 𝔮 : HeightOneSpectrum (𝓞 M) :=
    ⟨Q, inferInstance, Ideal.ne_bot_of_liesOver_of_ne_bot v.ne_bot Q⟩
  have hnQ : (n : 𝓞 M) ∉ 𝔮.asIdeal := by
    intro h
    apply hnv
    apply hQ_notin
    rw [map_natCast]; exact h
  have hval : 𝔮.valuation M (z ^ m - z ^ 0) < 1 := by
    have := (𝔮.valuation_lt_one_iff_mem (K := M) (z' ^ m - 1)).2 hzm
    have e : ((z' ^ m - 1 : 𝓞 M) : M) = z ^ m - z ^ 0 := by push_cast; rw [pow_zero]; rfl
    rw [← e]; exact this
  have hm0 : m = 0 := zeta_pow_inj 𝔮 hn hz hnQ hm hn hval
  refine ⟨j, ?_⟩
  rw [hm0, pow_zero, one_mul] at hσγ
  exact hσγ

/-- Transfer of a "residue" statement to a prime above: if $w \mid v$ and $v(z) < 1$ then $w(z) < 1$. -/
theorem val_transfer {M : Type} [Field M] [NumberField M] [Algebra K M] (w : HeightOneSpectrum (𝓞 M))
    (v : HeightOneSpectrum (𝓞 K)) (hv : v.asIdeal = w.asIdeal.under (𝓞 K)) (z : K)
    (hz : v.valuation K z < 1) : w.valuation M (algebraMap K M z) < 1 := by
  obtain ⟨u, d, hud⟩ := v.exists_primeCompl_mul_eq_of_integer z hz.le
  have hd : (d : 𝓞 K) ∉ v.asIdeal := d.2
  have h1 : v.valuation K (algebraMap (𝓞 K) K u) = v.valuation K z := by
    rw [← hud, map_mul, (v.valuation_eq_one_iff_notMem (K := K)).2 hd, mul_one]
  have hu : u ∈ v.asIdeal := (v.valuation_lt_one_iff_mem (K := K) u).1 (h1 ▸ hz)
  have hu' : algebraMap (𝓞 K) (𝓞 M) u ∈ w.asIdeal := by
    have : u ∈ w.asIdeal.under (𝓞 K) := by rwa [← hv]
    exact this
  have hd' : algebraMap (𝓞 K) (𝓞 M) d ∉ w.asIdeal := by
    intro h
    apply hd
    have : (d : 𝓞 K) ∈ w.asIdeal.under (𝓞 K) := h
    rwa [← hv] at this
  have e1 : w.valuation M (algebraMap (𝓞 M) M (algebraMap (𝓞 K) (𝓞 M) u)) < 1 :=
    (w.valuation_lt_one_iff_mem (K := M) _).2 hu'
  have e2 : w.valuation M (algebraMap (𝓞 M) M (algebraMap (𝓞 K) (𝓞 M) d)) = 1 :=
    (w.valuation_eq_one_iff_notMem (K := M)).2 hd'
  have e3 : algebraMap K M z * algebraMap (𝓞 M) M (algebraMap (𝓞 K) (𝓞 M) d) =
      algebraMap (𝓞 M) M (algebraMap (𝓞 K) (𝓞 M) u) := by
    have := congrArg (algebraMap K M) hud
    rw [map_mul] at this
    exact this
  have : w.valuation M (algebraMap K M z) = w.valuation M (algebraMap (𝓞 M) M (algebraMap (𝓞 K) (𝓞 M) u)) := by
    rw [← e3, map_mul, e2, mul_one]
  rw [this]; exact e1

/-- The "residue" hypothesis passes to a finite extension: if $a \in K$ is an $n$th power modulo almost every prime
of $K$, it is an $n$th power modulo almost every prime of $M$. -/
theorem eventually_residue_extension {M : Type} [Field M] [NumberField M] [Algebra K M] (n : ℕ) (a : K)
    (h : ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1) :
    ∀ᶠ w : HeightOneSpectrum (𝓞 M) in Filter.cofinite,
      ∃ y : 𝓞 M, w.valuation M ((y : M) ^ n - algebraMap K M a) < 1 := by
  have hF : {v : HeightOneSpectrum (𝓞 K) | ¬ ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1}.Finite :=
    Filter.eventually_cofinite.1 h
  have hfin : {w : HeightOneSpectrum (𝓞 M) | ∃ v ∈ {v : HeightOneSpectrum (𝓞 K) |
      ¬ ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1}, w.asIdeal ∣ Ideal.map (algebraMap (𝓞 K) (𝓞 M)) v.asIdeal}.Finite := by
    have : {w : HeightOneSpectrum (𝓞 M) | ∃ v ∈ {v : HeightOneSpectrum (𝓞 K) |
        ¬ ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1},
        w.asIdeal ∣ Ideal.map (algebraMap (𝓞 K) (𝓞 M)) v.asIdeal} =
        ⋃ v ∈ {v : HeightOneSpectrum (𝓞 K) | ¬ ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1},
          {w : HeightOneSpectrum (𝓞 M) | w.asIdeal ∣ Ideal.map (algebraMap (𝓞 K) (𝓞 M)) v.asIdeal} := by
      ext w; simp
    rw [this]
    refine hF.biUnion fun v _ => Ideal.finite_factors ?_
    intro h0
    exact v.ne_bot ((Ideal.map_eq_bot_iff_of_injective (FaithfulSMul.algebraMap_injective (𝓞 K) (𝓞 M))).1 h0)
  rw [Filter.eventually_cofinite]
  refine hfin.subset ?_
  intro w hw
  let v : HeightOneSpectrum (𝓞 K) := ⟨w.asIdeal.under (𝓞 K), inferInstance, Ideal.under_ne_bot (𝓞 K) w.ne_bot⟩
  by_cases hv : ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1
  · exfalso
    apply hw
    obtain ⟨x, hx⟩ := hv
    refine ⟨algebraMap (𝓞 K) (𝓞 M) x, ?_⟩
    have := val_transfer w v rfl _ hx
    convert this using 2
    simp
    rfl
  · refine ⟨v, hv, ?_⟩
    exact Ideal.dvd_iff_le.2 (Ideal.map_le_iff_le_comap.2 le_rfl)

/-- **Step 2 of Milne's proof (Frobenius version)**: let $M/K$ be a finite *cyclic* extension of number fields
containing a primitive $n$th root of $1$. If $a \in K^\times$ is an $n$th power modulo almost every prime of $K$, then
$a$ is an $n$th power in $K$. (Theorem 1.1 over $M$ gives $a = \beta^n$ with $\beta\in M$; a generator of
$\mathrm{Gal}(M/K)$ is a Frobenius element at some good prime, hence fixes a root $z^j\beta$ of $X^n - a$, hence all of
$\mathrm{Gal}(M/K)$ does.) -/
theorem pow_of_cyclic_kummer {M : Type} [Field M] [NumberField M] [Algebra K M] [IsGalois K M]
    [IsCyclic Gal(M/K)] (n : ℕ) (hn : 0 < n) (z : M) (hz : IsPrimitiveRoot z n) (a : K) (ha : a ≠ 0)
    (h : ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite,
      ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1) :
    ∃ b : K, b ^ n = a := by
  have ha' : algebraMap K M a ≠ 0 := (_root_.map_ne_zero _).2 ha
  obtain ⟨β, hβ⟩ := pow_of_eventually_residue n hn z hz (algebraMap K M a) ha'
    (eventually_residue_extension n a h)
  obtain ⟨σ0, hσ0⟩ := IsCyclic.exists_generator (α := Gal(M/K))
  have hF : {v : HeightOneSpectrum (𝓞 K) | ¬ ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1}.Finite :=
    Filter.eventually_cofinite.1 h
  obtain ⟨v, ⟨-, Q, hQ⟩, hvnot⟩ :=
    (((NumberFieldKB.HilbertClassField.setOf_frobAt_eq_infinite K M σ0).sdiff
      (hF.union (Sset_finite n hn a ha)))).nonempty
  have hvF : ∃ x : 𝓞 K, v.valuation K ((x : K) ^ n - a) < 1 := by
    by_contra hh; exact hvnot (Or.inl hh)
  have hvS : v ∉ Sset n {a} := fun hh => hvnot (Or.inr hh)
  obtain ⟨x0, hx0⟩ := hvF
  have hQ1 := Q.2.1
  have hQ2 := Q.2.2
  have hσ := isArithFrobAt_frobAt K M v Q
  rw [hQ] at hσ
  have hcard : Nat.card (𝓞 K ⧸ Q.1.under (𝓞 K)) = Ideal.absNorm v.asIdeal := by
    rw [← Ideal.over_def Q.1 v.asIdeal, Ideal.absNorm_apply, Submodule.cardQuot_apply]
  obtain ⟨j, hj⟩ := frob_fixes_root n hn z hz a ha β hβ v hvS x0 hx0 Q.1 σ0 (fun y => by
    have := hσ y
    rwa [hcard] at this)
  have hfix : ∀ τ : Gal(M/K), τ (z ^ j * β) = z ^ j * β := by
    intro τ
    have hmem : τ ∈ MulAction.stabilizer Gal(M/K) (z ^ j * β) := by
      have : Subgroup.zpowers σ0 ≤ MulAction.stabilizer Gal(M/K) (z ^ j * β) :=
        (Subgroup.zpowers_le).2 (by rw [MulAction.mem_stabilizer_iff]; exact hj)
      exact this (hσ0 τ)
    exact hmem
  obtain ⟨b, hb⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (z ^ j * β)).2 hfix
  refine ⟨b, (algebraMap K M).injective ?_⟩
  rw [map_pow, hb]
  have h3 : (z ^ j) ^ n = 1 := by rw [← pow_mul, mul_comm, pow_mul, hz.pow_eq_one, one_pow]
  rw [mul_pow, h3, one_mul, hβ]

/-- The Galois group of $K(\zeta_{p^s})/K$ is cyclic for an odd prime $p$ (it embeds in $(\mathbb Z/p^s)^\times$). -/
theorem isCyclic_gal_cyclotomic_odd (p s : ℕ) (hp : p.Prime) (hp2 : p ≠ 2) :
    IsCyclic (CyclotomicField (p ^ s) K ≃ₐ[K] CyclotomicField (p ^ s) K) := by
  have : NeZero (p ^ s) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have hz := IsCyclotomicExtension.zeta_spec (p ^ s) K (CyclotomicField (p ^ s) K)
  have := ZMod.isCyclic_units_of_prime_pow p hp hp2 s
  exact isCyclic_of_injective (hz.autToPow K) (hz.autToPow_injective K)

/-- **Prime power case** of Theorem 1.4: $n = p^k$, $0 < k \le s$, with $\mathrm{Gal}(K(\zeta_{p^s})/K)$ cyclic. -/
theorem pow_of_prime_pow (p k s : ℕ) (hp : p.Prime) (hks : k ≤ s)
    (hcyc : IsCyclic (CyclotomicField (p ^ s) K ≃ₐ[K] CyclotomicField (p ^ s) K))
    (a : K) (ha : a ≠ 0)
    (h : ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite,
      ∃ x : 𝓞 K, v.valuation K ((x : K) ^ (p ^ k) - a) < 1) :
    ∃ b : K, b ^ (p ^ k) = a := by
  have : NeZero (p ^ s) := ⟨pow_ne_zero _ hp.ne_zero⟩
  have : NumberField (CyclotomicField (p ^ s) K) :=
    IsCyclotomicExtension.numberField {p ^ s} K (CyclotomicField (p ^ s) K)
  have : IsGalois K (CyclotomicField (p ^ s) K) :=
    IsCyclotomicExtension.isGalois {p ^ s} K (CyclotomicField (p ^ s) K)
  have hz := IsCyclotomicExtension.zeta_spec (p ^ s) K (CyclotomicField (p ^ s) K)
  have hz' : IsPrimitiveRoot (IsCyclotomicExtension.zeta (p ^ s) K (CyclotomicField (p ^ s) K) ^ p ^ (s - k))
      (p ^ k) := hz.pow (pow_pos hp.pos s) (by rw [← pow_add]; congr 1; omega)
  exact pow_of_cyclic_kummer (p ^ k) (pow_pos hp.pos k) _ hz' a ha h

/-- **Theorem 1.4** (Milne, *CFT*, VIII, Theorem 1.4, p. 229): let $K$ be a number field and $n \ge 1$ an integer
such that $K[\zeta_{2^t}]$ is cyclic over $K$, where $2^t$ is the power of $2$ dividing $n$ ($K[\zeta_{2^t}]$ is
Mathlib's `CyclotomicField (2 ^ t) K`). A nonzero element of $K$ is an $n$th power in $K$ if it is an $n$th power in
$K_v$ for all but possibly finitely many primes $v$. -/
@[kb "milne2020cft" "Ch. VIII, Theorem 1.4, p. 229"]
theorem theorem_1_4 (n : ℕ) (hn : 0 < n)
    (hcyc : IsCyclic (CyclotomicField (2 ^ n.factorization 2) K ≃ₐ[K] CyclotomicField (2 ^ n.factorization 2) K))
    (a : K) (ha : a ≠ 0) (h : ∀ᶠ v in Filter.cofinite, IsLocalPow n a v) : ∃ b : K, b ^ n = a := by
  classical
  have hres : ∀ m : ℕ, 0 < m → m ∣ n → ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite,
      ∃ x : 𝓞 K, v.valuation K ((x : K) ^ m - a) < 1 := by
    intro m hm hmn
    have hS := Sset_finite m hm a ha
    filter_upwards [h, (Filter.eventually_cofinite.2 (by simpa using hS) :
        ∀ᶠ v : HeightOneSpectrum (𝓞 K) in Filter.cofinite, v ∉ Sset m {a})] with v hv hvS
    refine (exists_approx_iff_isLocalPow m hm a v hvS).2 ?_
    obtain ⟨x, hx⟩ := hv
    obtain ⟨c, hc⟩ := hmn
    refine ⟨x ^ c, ?_⟩
    rw [← pow_mul, mul_comm, ← hc]
    exact hx
  have key : ∀ m : ℕ, 0 < m → m ∣ n → ∃ b : K, b ^ m = a := by
    intro m
    induction m using Nat.recOnPosPrimePosCoprime with
    | prime_pow p k hp hk =>
      intro _ hmn
      by_cases hp2 : p = 2
      · subst hp2
        have hk' : k ≤ n.factorization 2 := (hp.pow_dvd_iff_le_factorization hn.ne').1 hmn
        exact pow_of_prime_pow 2 k _ hp hk' hcyc a ha (hres _ (pow_pos hp.pos k) hmn)
      · exact pow_of_prime_pow p k k hp le_rfl (isCyclic_gal_cyclotomic_odd p k hp hp2) a ha
          (hres _ (pow_pos hp.pos k) hmn)
    | zero => intro h0; omega
    | one => intros; exact ⟨a, pow_one a⟩
    | coprime m1 m2 h1 h2 hco ih1 ih2 =>
      intro _ hdvd
      obtain ⟨b1, hb1⟩ := ih1 (by omega) (dvd_trans (dvd_mul_right _ _) hdvd)
      obtain ⟨b2, hb2⟩ := ih2 (by omega) (dvd_trans (dvd_mul_left _ _) hdvd)
      have hbez : (m1 : ℤ) * Nat.gcdA m1 m2 + (m2 : ℤ) * Nat.gcdB m1 m2 = 1 := by
        have := Nat.gcd_eq_gcd_ab m1 m2
        rw [hco] at this
        simpa using this.symm
      set u := Nat.gcdA m1 m2
      set w := Nat.gcdB m1 m2
      have e1 : b2 ^ (m2 : ℤ) = a := by rw [zpow_natCast]; exact hb2
      have e2 : b1 ^ (m1 : ℤ) = a := by rw [zpow_natCast]; exact hb1
      refine ⟨b2 ^ u * b1 ^ w, ?_⟩
      have : (b2 ^ u * b1 ^ w) ^ ((m1 * m2 : ℕ) : ℤ) = a := by
        rw [mul_zpow, ← zpow_mul, ← zpow_mul]
        have q2 : u * ((m1 * m2 : ℕ) : ℤ) = (m2 : ℤ) * (u * m1) := by push_cast; ring
        have q1 : w * ((m1 * m2 : ℕ) : ℤ) = (m1 : ℤ) * (w * m2) := by push_cast; ring
        rw [q2, q1, zpow_mul b2 (m2 : ℤ) (u * m1), zpow_mul b1 (m1 : ℤ) (w * m2), e1, e2, ← zpow_add₀ ha]
        have : u * m1 + w * m2 = 1 := by linarith [hbez]
        rw [this, zpow_one]
      rwa [zpow_natCast] at this
  exact key n hn dvd_rfl

end NumberFieldKB.MilneCFT.Ch8
