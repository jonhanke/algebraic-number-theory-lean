import NumberFieldKB.Chebotarev.Frobenius
import NumberFieldKB.Chebotarev.FrobeniusCount

/-!
# The Frobenius map on the primes above `p` and the Deuring count
`A → C` finite flat extension of domains, `G` finite with `IsGaloisGroup G A C`, `p` a maximal ideal of `A`
unramified in `C` (`p.ramificationIdxIn C = 1`), all primes over `p` having finite residue field.
`frobMap : primesOver p C → G` sends `P` to `arithFrobAt A G P`.

* `frobMap_smul`: `Frob_{g P} = g Frob_P g⁻¹`.
* `stabilizer_primesOver_eq_zpowers`: the decomposition group of `P` is generated by `Frob_P`.
* **`card_primesOver_frob_eq`**: for `σ = Frob_{P₀}`, `#{P | p, Frob_P = σ} · ord σ = #C_G(σ)`.
-/

set_option linter.unusedSectionVars false

open Ideal Pointwise

namespace NumberFieldKB.Chebotarev

variable {A C G : Type*} [CommRing A] [CommRing C] [IsDomain A] [IsDomain C] [Algebra A C]
  [Module.Finite A C] [Module.Flat A C] [Group G] [Finite G] [MulSemiringAction G C]
  [IsGaloisGroup G A C] (p : Ideal A) [p.IsPrime]

/-- `G` acts transitively on the primes of `C` over `p`. -/
instance isPretransitive_primesOver : MulAction.IsPretransitive G (p.primesOver C) where
  exists_smul_eq P Q := by
    obtain ⟨g, hg⟩ := Algebra.IsInvariant.exists_smul_of_under_eq A C G P.1 Q.1
      (by
        have h1 : P.1.LiesOver p := P.2.2
        have h2 : Q.1.LiesOver p := Q.2.2
        rw [← P.1.over_def p, ← Q.1.over_def p])
    exact ⟨g, Subtype.ext hg.symm⟩

variable (hfin : ∀ P : p.primesOver C, Finite (C ⧸ P.1))

/-- The Frobenius element of a prime over `p`. -/
noncomputable def frobMap (P : p.primesOver C) : G :=
  have : P.1.IsPrime := P.2.1
  have := hfin P
  arithFrobAt A G P.1

variable [p.IsMaximal] [Algebra.HasSeparableResidueFieldsAt A C p]

/-- `Frob_{g • P} = g Frob_P g⁻¹`. -/
theorem frobMap_smul (he : p.ramificationIdxIn C = 1) (g : G) (P : p.primesOver C) :
    frobMap p hfin (g • P) = g * frobMap p hfin P * g⁻¹ := by
  have : P.1.IsPrime := P.2.1
  have := hfin P
  have : (g • P).1.IsPrime := (g • P).2.1
  have : (g • P).1.LiesOver p := (g • P).2.2
  have := hfin (g • P)
  have hb := inertia_eq_bot (G := G) p (g • P).1 he
  have h1 : IsArithFrobAt A (arithFrobAt A G (g • P).1) (g • P).1 :=
    IsArithFrobAt.arithFrobAt A G _
  have h2 : IsArithFrobAt A (g * arithFrobAt A G P.1 * g⁻¹) (g • P.1) :=
    (IsArithFrobAt.arithFrobAt A G P.1).conj g
  exact eq_of_congr_pow hb (n := Nat.card (A ⧸ (g • P).1.under A)) (fun x => h1 x) (fun x => h2 x)

/-- The decomposition group of an unramified prime is generated by its Frobenius element. -/
theorem stabilizer_primesOver_eq_zpowers (he : p.ramificationIdxIn C = 1) (P : p.primesOver C) :
    MulAction.stabilizer G P = Subgroup.zpowers (frobMap p hfin P) := by
  have : P.1.IsPrime := P.2.1
  have : P.1.LiesOver p := P.2.2
  have := hfin P
  have hmax : P.1.IsMaximal := Ideal.Quotient.maximal_of_isField _ (Finite.isField_of_domain _)
  have hst : MulAction.stabilizer G P = MulAction.stabilizer G P.1 := by
    ext g; simp [MulAction.mem_stabilizer_iff, Subtype.ext_iff]
  rw [hst]
  have hle : Subgroup.zpowers (frobMap p hfin P) ≤ MulAction.stabilizer G P.1 := by
    rw [Subgroup.zpowers_le]
    exact IsArithFrobAt.arithFrobAt_mem_stabilizer A G P.1
  refine (Subgroup.eq_of_le_of_card_ge hle ?_).symm
  rw [Nat.card_zpowers, Ideal.card_stabilizer_eq (G := G) p P.1, he, one_mul,
    Ideal.inertiaDegIn_eq_inertiaDeg p P.1 G]
  have := orderOf_arithFrobAt (G := G) p P.1 he
  exact this.ge

/-- **Counting primes with a prescribed Frobenius.** If `σ = Frob_{P₀}` then the number of primes `P`
of `C` over `p` with `Frob_P = σ` times `ord σ` is the order of the centralizer of `σ` in `G`. -/
theorem card_primesOver_frob_eq (he : p.ramificationIdxIn C = 1) (P₀ : p.primesOver C)
    {σ : G} (h₀ : frobMap p hfin P₀ = σ) :
    Nat.card {P : p.primesOver C // frobMap p hfin P = σ} * orderOf σ =
      Nat.card (Subgroup.centralizer {σ}) :=
  card_fiber_mul_orderOf (frobMap p hfin) (frobMap_smul p hfin he) h₀
    (h₀ ▸ stabilizer_primesOver_eq_zpowers p hfin he P₀)

end NumberFieldKB.Chebotarev
