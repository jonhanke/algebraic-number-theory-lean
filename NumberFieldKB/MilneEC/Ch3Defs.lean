import Mathlib
import QuadFormsKB.Citation

/-!
# Milne, Elliptic Curves, Chapter III: basic definitions

Chapter III ("Elliptic curves over the complex numbers") of J. S. Milne, *Elliptic Curves*
(second edition, course notes `ectext6`, 2006; bibliography key `milne2006ec`).  This file holds
the definitions shared by the Chapter III files.  Locators give the pdf page of `ectext6`
(printed page = pdf page − 8).

Conventions.
* A lattice is a `Submodule ℤ ℂ`; Mathlib's `PeriodPair` is a pair of ℝ-linearly independent
  complex numbers and `PeriodPair.lattice` the lattice they span.
* Mathlib's meromorphic functions are total functions `ℂ → ℂ` whose values at poles are
  arbitrary.  Orders (`meromorphicOrderAt`) and residues (circle integrals on small punctured
  circles) do not see the value at the point itself, so all statements about zeros, poles and
  residues are insensitive to those values.
-/

open Complex Set Filter Topology MeasureTheory Real

namespace NumberFieldKB.MilneEC.III

/-! ### Lattices (§1, pdf p. 89) -/

/-- Milne's lattice in `ℂ` (pdf p. 89): the subgroup generated by two complex numbers that are
linearly independent over `ℝ`. -/
@[kb "milne2006ec" "Ch. III, §1, def. of lattice in C, pdf p. 89"]
def IsLattice (Λ : Submodule ℤ ℂ) : Prop := ∃ L : PeriodPair, L.lattice = Λ

/-- The set `M` of Proposition 1.1 (pdf p. 90): pairs `(ω₁, ω₂)` of complex numbers with
`Im (ω₁ / ω₂) > 0`. -/
@[kb "milne2006ec" "Ch. III, Prop. 1.1, the set M, pdf p. 90"]
def OrientedPair : Type := {p : ℂ × ℂ // 0 < (p.1 / p.2).im}

/-- The lattice `ℤω₁ + ℤω₂` of a pair (Proposition 1.1). -/
def OrientedPair.lattice (p : OrientedPair) : Submodule ℤ ℂ :=
  Submodule.span ℤ {p.1.1, p.1.2}

/-- The ratio `ω₁ / ω₂ ∈ ℍ` of an oriented pair (Proposition 1.1). -/
noncomputable def OrientedPair.ratio (p : OrientedPair) : UpperHalfPlane := ⟨p.1.1 / p.1.2, p.2⟩

/-- Milne's fundamental domain (period parallelogram) of a lattice with basis `{ω₁, ω₂}`
(pdf p. 90): the interior of the parallelogram with vertices `z₀`, `z₀ + ω₁`, `z₀ + ω₂`,
`z₀ + ω₁ + ω₂`, written as the set of `z₀ + s ω₁ + t ω₂` with `0 < s, t < 1`. -/
@[kb "milne2006ec" "Ch. III, §1, def. of fundamental domain (period parallelogram), pdf p. 90"]
def periodParallelogram (ω₁ ω₂ z₀ : ℂ) : Set ℂ :=
  {z | ∃ s t : ℝ, s ∈ Ioo (0 : ℝ) 1 ∧ t ∈ Ioo (0 : ℝ) 1 ∧ z = z₀ + s * ω₁ + t * ω₂}

/-! ### Doubly periodic functions (§2, pdf p. 90) -/

/-- Condition (19) of Milne (pdf p. 90): `f (z + ω) = f z` for all `ω ∈ Λ` (as functions on
`ℂ`). -/
def IsPeriodicFor (Λ : Submodule ℤ ℂ) (f : ℂ → ℂ) : Prop :=
  ∀ ω ∈ Λ, ∀ z, f (z + ω) = f z

/-- Milne's doubly periodic function for a lattice `Λ` (pdf p. 90): a meromorphic function on
`ℂ` satisfying (19).  ("Throughout 'doubly periodic' will mean 'doubly periodic and
meromorphic'.") -/
@[kb "milne2006ec" "Ch. III, §2, def. of doubly periodic function, pdf p. 90"]
def IsDoublyPeriodic (Λ : Submodule ℤ ℂ) (f : ℂ → ℂ) : Prop :=
  Meromorphic f ∧ IsPeriodicFor Λ f

/-! ### Residues and orders -/

/-- The residue of `f` at `p` (Cartan 1963, cited by Milne for Proposition 2.1, pdf p. 91):
`(2πi)⁻¹ ∮_{|z - p| = r} f(z) dz` for small `r > 0`.  Defined as the limit as `r → 0⁺`; for a
function meromorphic at `p` the integral is constant for small `r`
(`residue_eq_circleIntegral` in `Ch3Residue.lean`). -/
noncomputable def residue (f : ℂ → ℂ) (p : ℂ) : ℂ :=
  limUnder (𝓝[>] (0 : ℝ)) fun r => (2 * π * I)⁻¹ * ∮ z in C(p, r), f z

/-- Milne's `ord_P(f)` (pdf p. 91): the order of the zero of `f` at `P`, or minus the order of
the pole; `0` if `f` vanishes near `P` (order `⊤`). -/
noncomputable def ord (f : ℂ → ℂ) (p : ℂ) : ℤ := (meromorphicOrderAt f p).untop₀

/-- The integral of `f` round the boundary of the rectangle with opposite corners `z` and `w`
(anticlockwise when `z.re < w.re` and `z.im < w.im`), in the form used by Mathlib's
`Complex.integral_boundary_rect_eq_zero_of_differentiableOn`. -/
noncomputable def rectIntegral (f : ℂ → ℂ) (z w : ℂ) : ℂ :=
  (((∫ x : ℝ in z.re..w.re, f (x + z.im * I)) - ∫ x : ℝ in z.re..w.re, f (x + w.im * I)) +
      I • ∫ y : ℝ in z.im..w.im, f (w.re + y * I)) -
    I • ∫ y : ℝ in z.im..w.im, f (z.re + y * I)

/-! ### The elliptic curve `E(Λ)` (§3, pdf p. 100) -/

/-- Milne's `E(Λ) : Y²Z = 4X³ − g₄(Λ)XZ² − g₆(Λ)Z³` (pdf p. 100) as a Mathlib Weierstrass
curve.  Mathlib's curves have the form `Y² + a₁XY + a₃Y = X³ + a₂X² + a₄X + a₆`; the change of
variables `Y ↦ 2Y` turns Milne's equation into `Y² = X³ − (g₄/4)X − g₆/4`, so the point of
Milne's `E(Λ)` with coordinates `(x, y)` is the point `(x, y/2)` here.  Milne's `g₄ = 60 G₄`,
`g₆ = 140 G₆` are Mathlib's `PeriodPair.g₂`, `PeriodPair.g₃`. -/
@[kb "milne2006ec" "Ch. III, §3, the elliptic curve E(Λ), pdf p. 100"]
noncomputable def curveOf (L : PeriodPair) : WeierstrassCurve ℂ :=
  { a₁ := 0, a₂ := 0, a₃ := 0, a₄ := -(L.g₂ / 4), a₆ := -(L.g₃ / 4) }

/-! ### The Tate module (pdf p. 107) -/

/-- The Tate module `T_ℓ A = lim← A[ℓⁿ]` of an abelian group `A` (Milne, pdf p. 107, for
`A = E(k)`), as the group of sequences `(xₙ)` with `x₀ = 0` and `ℓ x_{n+1} = xₙ`; then
`ℓⁿ xₙ = 0`, so `xₙ ∈ A[ℓⁿ]`, and the transition maps are multiplication by `ℓ`. -/
@[kb "milne2006ec" "Ch. III, §3, def. of the Tate module, pdf p. 107"]
def tateModule (ℓ : ℕ) (A : Type*) [AddCommGroup A] : AddSubgroup (ℕ → A) where
  carrier := {x | x 0 = 0 ∧ ∀ n, ℓ • x (n + 1) = x n}
  add_mem' := by
    rintro x y ⟨hx0, hx⟩ ⟨hy0, hy⟩
    refine ⟨by simp [hx0, hy0], fun n => ?_⟩
    simp [smul_add, hx n, hy n]
  zero_mem' := ⟨rfl, fun n => by simp⟩
  neg_mem' := by
    rintro x ⟨hx0, hx⟩
    refine ⟨by simp [hx0], fun n => ?_⟩
    simp [smul_neg, hx n]

lemma tateModule_smul_pow_eq_zero {ℓ : ℕ} {A : Type*} [AddCommGroup A] {x : ℕ → A}
    (hx : x ∈ tateModule ℓ A) (n : ℕ) : ℓ ^ n • x n = 0 := by
  induction n with
  | zero => simpa using hx.1
  | succ n ih => rw [pow_succ, mul_smul, hx.2 n, ih]

end NumberFieldKB.MilneEC.III
