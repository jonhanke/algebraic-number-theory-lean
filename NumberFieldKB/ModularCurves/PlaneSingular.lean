import Mathlib.Analysis.Complex.Polynomial.Basic

/-!
# The plane model $F_N(X, Y) = 0$ of $X_0(N)$ is singular (Milne, Remark V.2.6)

J. S. Milne, *Elliptic Curves* (`milne2006ec`), Chapter V, Remark 2.6 (pdf p. 194): the curve $F_N(X, Y) = 0$ is
highly singular, since otherwise the genus formula for a nonsingular plane curve would give too large a genus.

Let $G \in \mathbb Q[X_0, X_1, X_2]$ be homogeneous of degree $d$ with $G(X_0, X_1, 1) = F_N(X_0, X_1)$ (for instance
the homogenization of $F_N$; Milne's $X$ is $X_0$, the variable of $j$, and $Y$ is $X_1$, the variable of $j_N$;
0-based indices). If the projective curve $G = 0$ had no singular point over $\mathbb C$, the function field
$\mathbb Q(X_0(N)) = \mathbb Q(j, j_N)$, generated by the point $(j : j_N : 1)$ of $G = 0$, would have genus
$(d - 1)(d - 2)/2$ (Tau Ceti, `TauCeti.genus_eq_of_isHomogeneous_of_aeval_insertNth_eq_zero`, ported). But
$d \ge \deg_Y F_N = \mu = (\mathrm{SL}_2(\mathbb Z) : \Gamma_0(N)) \ge N + 1 \ge 3$ for $N \ge 2$, while the genus
formula (`genus_formula_X0`) gives $12 g \le 12 + \mu - 6\nu_\infty \le \mu + 6$, and $6 (d - 1)(d - 2) > d + 6$ for
$d \ge 3$. So $G = 0$ has a singular point over $\mathbb C$ (`remark_2_6`). For $N = 1$, $F_1 = X - Y$ is a line.
-/

open Polynomial MvPolynomial
open scoped IntermediateField

namespace NumberFieldKB.ModularCurves

variable {N : ℕ} [NeZero N]

/-- $j$ is transcendental over $\mathbb Q$ in $\mathbb Q(X_0(N))$. -/
theorem transcendental_jX0 : Transcendental ℚ (jX0 (prop2_4' N)) := by
  rw [transcendental_iff_injective]
  have h : Function.Injective (algebraMap ℚ[X] (X0 N)) := by
    rw [IsScalarTower.algebraMap_eq ℚ[X] (RatFunc ℚ) (X0 N)]
    exact (algebraMap (RatFunc ℚ) (X0 N)).injective.comp (IsFractionRing.injective ℚ[X] (RatFunc ℚ))
  rw [algebraMap_polyX0_eq] at h
  exact h

/-- $\mathbb Q(X_0(N)) = \mathbb Q(j, j_N)$ as an intermediate field. -/
theorem adjoin_jX0_jNX0 : ℚ⟮jX0 (prop2_4' N), jNX0 (prop2_4' N)⟯ = ⊤ := by
  have h := X0.subfield_eq_top (M := N) (ℚ⟮jX0 (prop2_4' N), jNX0 (prop2_4' N)⟯).toSubfield
    (IntermediateField.subset_adjoin ℚ _ (by simp)) (IntermediateField.subset_adjoin ℚ _ (by simp))
  rw [eq_top_iff]
  intro z _
  have hz : z ∈ (⊤ : Subfield (X0 N)) := Subfield.mem_top z
  rw [← h] at hz
  exact hz

/-- $(j, j_N)$ is a zero of $F_N$, read as a polynomial in two variables. -/
theorem aeval_equivMvPolynomial_modPoly :
    MvPolynomial.aeval ![jX0 (prop2_4' N), jNX0 (prop2_4' N)]
      (Polynomial.Bivariate.equivMvPolynomial ℚ (modPoly N)) = 0 := by
  have h := Polynomial.Bivariate.aeval_map_eq_aeval_equivMvPolynomial (K := RatFunc ℚ) (F := X0 N)
    (modPoly N) (AdjoinRoot.root _)
  rw [RatFunc.algebraMap_X, algebraMap_X_X0] at h
  have hroot : jNX0 (prop2_4' N) = AdjoinRoot.root _ := by
    rw [jNX0, coordToX0_mk, Polynomial.map_X, AdjoinRoot.mk_X]
  rw [hroot, ← h]
  rw [AdjoinRoot.aeval_eq, AdjoinRoot.mk_self]

/-- The number of cusps of $X_0(N)$ is at least $1$ (the divisor $d = 1$ contributes $\varphi(1) = 1$). -/
theorem one_le_cuspCount : 1 ≤ ∑ d ∈ N.divisors, Nat.totient (Nat.gcd d (N / d)) := by
  have h1 : (1 : ℕ) ∈ N.divisors := Nat.one_mem_divisors.2 (NeZero.ne N)
  calc 1 = Nat.totient (Nat.gcd 1 (N / 1)) := by simp
    _ ≤ _ := Finset.single_le_sum (f := fun d => Nat.totient (Nat.gcd d (N / d))) (fun _ _ => Nat.zero_le _) h1

/-- $12 g \le \mu + 6$ for $X_0(N)$, from the genus formula. -/
theorem twelve_mul_genus_le : 12 * MilneEC.genus ℚ (X0 N) ≤ (CongruenceSubgroup.Gamma0 N).index + 6 := by
  have h := genus_formula_X0 N
  have := one_le_cuspCount (N := N)
  omega

/-- **Milne, Remark V.2.6** (pdf p. 194): for $N \ge 2$, every projective plane model of $F_N(X, Y) = 0$ is
singular. Precisely: if $G \in \mathbb Q[X_0, X_1, X_2]$ is homogeneous of degree $d$ and $G(X_0, X_1, 1) =
F_N(X_0, X_1)$, then the curve $G = 0$ has a singular point $(b_0 : b_1 : b_2)$ over $\mathbb C$: $G$ and its three
partial derivatives vanish there. -/
@[kb "milne2006ec" "Ch. V, Remark 2.6, the curve F_N(X,Y) = 0 is singular, pdf p. 194"]
theorem remark_2_6 (hN : 2 ≤ N) {G : MvPolynomial (Fin 3) ℚ} {d : ℕ} (hG : G.IsHomogeneous d)
    (hGF : TauCeti.dehomogenize 2 G = Polynomial.Bivariate.equivMvPolynomial ℚ (modPoly N)) :
    ∃ b : Fin 3 → ℂ, b ≠ 0 ∧ MvPolynomial.aeval b G = 0 ∧ ∀ l, MvPolynomial.aeval b (pderiv l G) = 0 := by
  by_contra hcon
  push Not at hcon
  have hsm : ∀ b : Fin 3 → ℂ, b ≠ 0 → MvPolynomial.aeval b G = 0 →
      ∃ l, MvPolynomial.aeval b (pderiv l G) ≠ 0 := hcon
  have hpt : MvPolynomial.aeval ((2 : Fin 3).insertNth 1 ![jX0 (prop2_4' N), jNX0 (prop2_4' N)]) G = 0 := by
    rw [← TauCeti.aeval_dehomogenize, hGF, aeval_equivMvPolynomial_modPoly]
  have hg := TauCeti.genus_eq_of_isHomogeneous_of_aeval_insertNth_eq_zero (K := ℂ) hG hsm 2
    (Or.inl transcendental_jX0) adjoin_jX0_jNX0 hpt
  -- the degree: `d ≥ μ ≥ N + 1 ≥ 3`
  have hdeg : (CongruenceSubgroup.Gamma0 N).index ≤ d := by
    rw [← modPoly_natDegree (N := N)]
    have h1 : (Polynomial.Bivariate.equivMvPolynomial ℚ (modPoly N)).totalDegree ≤ d := by
      rw [← hGF]
      exact (TauCeti.totalDegree_dehomogenize_le 2 G).trans hG.totalDegree_le
    have h2 := Polynomial.Bivariate.natDegree_equivMvPolynomial_symm_le h1
    rwa [AlgEquiv.symm_apply_apply] at h2
  have hmu := add_one_le_index (N := N) (by omega)
  have h12 := twelve_mul_genus_le (N := N)
  rw [genus_X0_eq, hg] at h12
  have hev : 2 * ((d - 1) * (d - 2) / 2) = (d - 1) * (d - 2) :=
    Nat.two_mul_div_two_of_even (by simpa only [Nat.sub_sub] using Nat.even_mul_pred_self (d - 1))
  have hd3 : 3 ≤ d := by omega
  obtain ⟨e, rfl⟩ : ∃ e, d = e + 3 := ⟨d - 3, by omega⟩
  simp only [show e + 3 - 1 = e + 2 by omega, show e + 3 - 2 = e + 1 by omega] at hev h12
  generalize (e + 2) * (e + 1) / 2 = q at hev h12
  have h12' : 12 * q ≤ (CongruenceSubgroup.Gamma0 N).index + 6 := by exact_mod_cast h12
  nlinarith

end NumberFieldKB.ModularCurves
