import Mathlib
import NumberFieldKB.MilneCFT.Ch8.Eighth

/-!
# The algebra behind Remark VIII.1.5 (a): `n`-th powers that are locally trivial at every Frobenius

Let `M/K` be a finite Galois extension containing a primitive `q`-th root of unity `ζ`, `q = p^r`, and `α^q = a ∈ K`.
Suppose every `σ ∈ Gal(M/K)` fixes one of the roots `ζ^i α` (for `a` a local `q`-th power at almost all places
this is Chebotarev plus `R15a.exists_pow_mul_fixed_of_isLocalPow`). Then:
* `pow_of_odd`: for `p` odd, `a ∈ K^{×q}`;
* `dichotomy`: for two such `a, a'`, one of `a`, `a'`, `a/a'` lies in `K^{×q}`.

Proof. `χ : Gal(M/K) → (ℤ/q)^×` the cyclotomic character (`IsPrimitiveRoot.autToPow`). Elements fixing `ζ` fix `α`
(`fix_of_fixes_zeta`). If `χ(Γ)` is cyclic, generated by `χ(σ₀)`, the root fixed by `σ₀` is fixed by `Γ`
(`exists_fixed_of_isCyclic_map`). For `p` odd `(ℤ/q)^×` is cyclic. For `p = 2`, `Γ = U = χ⁻¹(1 + 4ℤ)` has cyclic image
(`isCyclic_ker_unitsMap_four`); if `U ≠ Gal(M/K)` pick `g₁ ∉ U`; `c = g₁β/β` lies in the cyclic group `J` of `q`-th
roots of unity fixed by `U`, `g₁` acts on `J` by `η ↦ η^e` with `e ≡ 3 mod 4`, so every square in `J` is `g₁η/η`;
if `c ∈ J²` then `β/η ∈ K`. Of `c, c', c/c'` one is a square in the cyclic group `J`.
-/

namespace NumberFieldKB.MilneCFT.Ch8.R15a

variable {K M : Type*} [Field K] [Field M] [Algebra K M] [FiniteDimensional K M] [IsGalois K M]

/-- Elements fixing `ζ` fix `α`. -/
theorem fix_of_fixes_zeta {q : ℕ} {ζ : M} (hζ : IsPrimitiveRoot ζ q) (hq : 0 < q) {α : M}
    (hfa : ∀ σ : M ≃ₐ[K] M, ∃ i : ℕ, σ (ζ ^ i * α) = ζ ^ i * α) (τ : M ≃ₐ[K] M) (hτ : τ ζ = ζ) :
    τ α = α := by
  have hζ0 : ζ ≠ 0 := hζ.ne_zero hq.ne'
  obtain ⟨i, hi⟩ := hfa τ
  rw [map_mul, map_pow, hτ] at hi
  exact mul_left_cancel₀ (pow_ne_zero _ hζ0) hi

/-- An automorphism with trivial cyclotomic character fixes `ζ`. -/
theorem fixes_zeta_of_char_eq_one {q : ℕ} [NeZero q] {ζ : M} (hζ : IsPrimitiveRoot ζ q)
    (τ : M ≃ₐ[K] M) (h : hζ.autToPow K τ = 1) : τ ζ = ζ := by
  rw [← hζ.autToPow_spec K τ, h]
  simp only [Units.val_one, ZMod.val_one_eq_one_mod]
  rcases Nat.lt_or_ge 1 q with h1 | h1
  · rw [Nat.mod_eq_of_lt h1, pow_one]
  · have hq1 : q = 1 := by
      have := NeZero.pos q
      omega
    subst hq1
    have := hζ.pow_eq_one
    simp only [pow_one] at this
    simp [this]

/-- If `β = ζ^i α` is fixed by everything, then `a` is a `q`-th power. -/
theorem pow_of_all_fixed {q : ℕ} {ζ : M} (hζ : IsPrimitiveRoot ζ q) {a : K} {α : M}
    (hα : α ^ q = algebraMap K M a) {i : ℕ} (h : ∀ g : M ≃ₐ[K] M, g (ζ ^ i * α) = ζ ^ i * α) :
    ∃ b : K, b ^ q = a := by
  obtain ⟨b, hb⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := K) (E := M) (ζ ^ i * α)).2 h
  refine ⟨b, ?_⟩
  apply (algebraMap K M).injective
  rw [map_pow, hb, mul_pow, ← pow_mul, mul_comm i q, pow_mul, hζ.pow_eq_one, one_pow, one_mul, hα]

/-- If the cyclotomic character maps `Γ` onto a cyclic group, some root `ζ^i α` is fixed by all of `Γ`. -/
theorem exists_fixed_of_isCyclic_map {q : ℕ} [NeZero q] {ζ : M} (hζ : IsPrimitiveRoot ζ q) {α : M}
    (hfa : ∀ σ : M ≃ₐ[K] M, ∃ i : ℕ, σ (ζ ^ i * α) = ζ ^ i * α) (Γ : Subgroup (M ≃ₐ[K] M))
    (hΓ : IsCyclic (Γ.map (hζ.autToPow K))) :
    ∃ i : ℕ, ∀ g ∈ Γ, g (ζ ^ i * α) = ζ ^ i * α := by
  obtain ⟨y, hy⟩ := hΓ.exists_generator
  obtain ⟨σ₀, hσ₀Γ, hσ₀⟩ := y.2
  obtain ⟨i, hi⟩ := hfa σ₀
  refine ⟨i, fun g hg => ?_⟩
  have hmem : hζ.autToPow K g ∈ Γ.map (hζ.autToPow K) := ⟨g, hg, rfl⟩
  obtain ⟨k, hk⟩ := Subgroup.mem_zpowers_iff.1 (hy ⟨_, hmem⟩)
  have hk' : (hζ.autToPow K σ₀) ^ k = hζ.autToPow K g := by
    have := congrArg Subtype.val hk
    simpa [← hσ₀] using this
  set τ : M ≃ₐ[K] M := σ₀ ^ (-k) * g with hτ
  have hχτ : hζ.autToPow K τ = 1 := by
    rw [hτ, map_mul, map_zpow, ← hk', zpow_neg]
    group
  have hτζ := fixes_zeta_of_char_eq_one hζ τ hχτ
  have hτα := fix_of_fixes_zeta hζ (NeZero.pos q) hfa τ hτζ
  have hτβ : τ (ζ ^ i * α) = ζ ^ i * α := by
    rw [map_mul, map_pow, hτζ, hτα]
  have hσβ : (σ₀ ^ k) ∈ MulAction.stabilizer (M ≃ₐ[K] M) (ζ ^ i * α) :=
    zpow_mem (by rw [MulAction.mem_stabilizer_iff, AlgEquiv.smul_def]; exact hi) k
  have hg : g = σ₀ ^ k * τ := by rw [hτ]; group
  rw [hg, AlgEquiv.mul_apply, hτβ]
  have := (MulAction.mem_stabilizer_iff.1 hσβ)
  rw [AlgEquiv.smul_def] at this
  exact this

/-- **Odd prime powers: local triviality forces a global power.** -/
theorem pow_of_odd {p r : ℕ} (hp : p.Prime) (hp2 : p ≠ 2) {ζ : M} (hζ : IsPrimitiveRoot ζ (p ^ r))
    {a : K} {α : M} (hα : α ^ (p ^ r) = algebraMap K M a)
    (hfa : ∀ σ : M ≃ₐ[K] M, ∃ i : ℕ, σ (ζ ^ i * α) = ζ ^ i * α) :
    ∃ b : K, b ^ (p ^ r) = a := by
  haveI : NeZero (p ^ r) := ⟨pow_ne_zero _ hp.ne_zero⟩
  haveI := ZMod.isCyclic_units_of_prime_pow p hp hp2 r
  obtain ⟨i, hi⟩ := exists_fixed_of_isCyclic_map hζ hfa ⊤ inferInstance
  exact pow_of_all_fixed hζ hα (fun g => hi g trivial)

theorem pow_mod_eq' {x : M} {q : ℕ} (hx : x ^ q = 1) (n : ℕ) : x ^ n = x ^ (n % q) := by
  conv_lhs => rw [← Nat.mod_add_div n q, pow_add, pow_mul, hx, one_pow, mul_one]

/-- In a cyclic group, one of `x`, `y`, `x y⁻¹` is a square. -/
theorem cyclic_trichotomy {J : Type*} [Group J] [IsCyclic J] (x y : J) :
    (∃ d : J, x = d ^ 2) ∨ (∃ d : J, y = d ^ 2) ∨ ∃ d : J, x * y⁻¹ = d ^ 2 := by
  obtain ⟨z, hz⟩ := IsCyclic.exists_generator (α := J)
  obtain ⟨m, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hz x)
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.1 (hz y)
  rcases Int.even_or_odd' m with ⟨k, hk | hk⟩
  · left
    exact ⟨z ^ k, by rw [hk, ← zpow_natCast, ← zpow_mul, mul_comm]; norm_cast⟩
  rcases Int.even_or_odd' n with ⟨l, hl | hl⟩
  · right; left
    exact ⟨z ^ l, by rw [hl, ← zpow_natCast, ← zpow_mul, mul_comm]; norm_cast⟩
  · right; right
    refine ⟨z ^ (k - l), ?_⟩
    rw [← zpow_neg, ← zpow_add, ← zpow_natCast, ← zpow_mul, hk, hl]
    congr 1
    push_cast
    ring

theorem key_square {r : ℕ} (hr : 2 ≤ r) {ζ : M} (hζ : IsPrimitiveRoot ζ (2 ^ r))
    (g₁ : M ≃ₐ[K] M) (e : ℕ) (he : e % 4 = 3) (hg₁ : g₁ ζ = ζ ^ e)
    (U : Subgroup (M ≃ₐ[K] M)) (hUg : ∀ g, g ∈ U ∨ g₁⁻¹ * g ∈ U) {β : M} {c0 : K}
    (hβ : β ^ (2 ^ r) = algebraMap K M c0) (hUβ : ∀ u ∈ U, u β = β) {d : M}
    (hd : d ^ (2 ^ r) = 1) (hdU : ∀ u ∈ U, u d = d) (hgd : g₁ β = d ^ 2 * β) :
    ∃ b : K, b ^ (2 ^ r) = c0 := by
  have hq1 : 1 < 2 ^ r := Nat.one_lt_two_pow (by omega)
  have hd0 : d ≠ 0 := by
    rintro rfl
    rw [zero_pow (by positivity)] at hd
    exact zero_ne_one hd
  set f : ℕ := 2 * (e / 4) + 1 with hf
  have hfc : Nat.Coprime f (2 ^ r) := by
    apply Nat.Coprime.pow_right r
    rw [Nat.coprime_comm, Nat.Prime.coprime_iff_not_dvd Nat.prime_two]
    omega
  obtain ⟨f', -, hf'⟩ := Nat.exists_mul_mod_eq_one_of_coprime hfc hq1
  set η : M := d ^ f' with hη
  have hηf : η ^ f = d := by
    rw [hη, ← pow_mul, pow_mod_eq' hd, mul_comm, hf', pow_one]
  have hηq : η ^ (2 ^ r) = 1 := by
    rw [hη, ← pow_mul, mul_comm, pow_mul, hd, one_pow]
  have hη0 : η ≠ 0 := by
    intro h0
    rw [h0, zero_pow (by positivity)] at hηq
    exact zero_ne_one hηq
  have hηU : ∀ u ∈ U, u η = η := fun u hu => by rw [hη, map_pow, hdU u hu]
  have hgη : g₁ η = d ^ 2 * η := by
    obtain ⟨m, -, hm⟩ := hζ.eq_pow_of_pow_eq_one hηq
    have h1 : g₁ η = η ^ e := by
      rw [← hm, map_pow, hg₁, ← pow_mul, ← pow_mul, mul_comm]
    have he2 : e = 2 * f + 1 := by omega
    rw [h1, he2, pow_succ, pow_mul', hηf]
  have hd2 : d ^ 2 ≠ 0 := pow_ne_zero _ hd0
  have hγ : g₁ (β / η) = β / η := by
    rw [map_div₀, hgd, hgη, mul_div_mul_left _ _ hd2]
  have hall : ∀ g : M ≃ₐ[K] M, g (β / η) = β / η := by
    intro g
    have hUγ : ∀ u ∈ U, u (β / η) = β / η := fun u hu => by
      rw [map_div₀, hUβ u hu, hηU u hu]
    rcases hUg g with hg | hg
    · exact hUγ g hg
    · have : g = g₁ * (g₁⁻¹ * g) := by group
      rw [this, AlgEquiv.mul_apply, hUγ _ hg, hγ]
  obtain ⟨b, hb⟩ := (IsGalois.mem_range_algebraMap_iff_fixed (F := K) (E := M) (β / η)).2 hall
  refine ⟨b, (algebraMap K M).injective ?_⟩
  rw [map_pow, hb, div_pow, hβ, hηq, div_one]

/-- **The dichotomy for prime powers.** -/
theorem dichotomy {p r : ℕ} (hp : p.Prime) {ζ : M} (hζ : IsPrimitiveRoot ζ (p ^ r)) {a a' : K}
    {α α' : M} (ha0 : a ≠ 0) (ha0' : a' ≠ 0) (hα : α ^ (p ^ r) = algebraMap K M a)
    (hα' : α' ^ (p ^ r) = algebraMap K M a')
    (hfa : ∀ σ : M ≃ₐ[K] M, ∃ i : ℕ, σ (ζ ^ i * α) = ζ ^ i * α)
    (hfa' : ∀ σ : M ≃ₐ[K] M, ∃ i : ℕ, σ (ζ ^ i * α') = ζ ^ i * α') :
    (∃ b : K, b ^ (p ^ r) = a) ∨ (∃ b : K, b ^ (p ^ r) = a') ∨ ∃ b : K, b ^ (p ^ r) * a' = a := by
  haveI : NeZero (p ^ r) := ⟨pow_ne_zero _ hp.ne_zero⟩
  by_cases hp2 : p = 2
  swap
  · left
    exact pow_of_odd hp hp2 hζ hα hfa
  subst hp2
  by_cases hr : r ≤ 2
  · left
    haveI := (ZMod.isCyclic_units_two_pow_iff r).2 hr
    obtain ⟨i, hi⟩ := exists_fixed_of_isCyclic_map hζ hfa ⊤ inferInstance
    exact pow_of_all_fixed hζ hα (fun g => hi g trivial)
  obtain ⟨s, rfl⟩ : ∃ s, r = s + 2 := ⟨r - 2, by omega⟩
  have h4 : 4 ∣ 2 ^ (s + 2) := ⟨2 ^ s, by ring⟩
  set χ := hζ.autToPow K with hχ
  set φ := ZMod.unitsMap h4 with hφ
  set U : Subgroup (M ≃ₐ[K] M) := (φ.comp χ).ker with hU
  haveI := isCyclic_ker_unitsMap_four s h4
  have hcyc : IsCyclic (U.map χ) := by
    apply Subgroup.isCyclic_of_le (H' := φ.ker)
    rintro _ ⟨u, hu, rfl⟩
    exact hu
  obtain ⟨i, hi⟩ := exists_fixed_of_isCyclic_map hζ hfa U hcyc
  obtain ⟨i', hi'⟩ := exists_fixed_of_isCyclic_map hζ hfa' U hcyc
  by_cases hUt : ∀ g, g ∈ U
  · left
    exact pow_of_all_fixed hζ hα (fun g => hi g (hUt g))
  push_neg at hUt
  obtain ⟨g₁, hg₁U⟩ := hUt
  have hφ1 : ∀ g, g ∈ U ↔ φ (χ g) = 1 := fun g => MonoidHom.mem_ker
  have h1 : φ (χ g₁) ≠ 1 := fun h => hg₁U ((hφ1 g₁).2 h)
  have hUg : ∀ g, g ∈ U ∨ g₁⁻¹ * g ∈ U := by
    intro g
    by_cases hg : g ∈ U
    · exact Or.inl hg
    · right
      have h2 : φ (χ g) ≠ 1 := fun h => hg ((hφ1 g).2 h)
      rw [hφ1]
      simp only [map_mul, map_inv]
      have hdec : ∀ x y : (ZMod 4)ˣ, x ≠ 1 → y ≠ 1 → x⁻¹ * y = 1 := by decide
      exact hdec _ _ h1 h2
  have hUnorm : ∀ u ∈ U, g₁⁻¹ * u * g₁ ∈ U := by
    intro u hu
    rw [hφ1] at hu ⊢
    simp only [map_mul, map_inv]
    rw [hu]
    simp
  set e : ℕ := ((χ g₁ : (ZMod (2 ^ (s + 2)))ˣ) : ZMod (2 ^ (s + 2))).val with he_def
  have hg₁ζ : g₁ ζ = ζ ^ e := (hζ.autToPow_spec K g₁).symm
  have he : e % 4 = 3 := by
    have h3 : ∀ u : (ZMod 4)ˣ, u ≠ 1 → (u : ZMod 4) = 3 := by decide
    have h5 := h3 _ h1
    have h6 : ((φ (χ g₁) : (ZMod 4)ˣ) : ZMod 4) = (e : ZMod 4) := by
      simp only [hφ, ZMod.unitsMap_def, Units.coe_map]
      show (ZMod.castHom h4 (ZMod 4)) _ = _
      rw [he_def, ← map_natCast (ZMod.castHom h4 (ZMod 4)), ZMod.natCast_zmod_val]
    rw [h6] at h5
    have h7 : ((e : ℕ) : ZMod 4) = ((3 : ℕ) : ZMod 4) := by rw [h5]; norm_num
    have := (ZMod.natCast_eq_natCast_iff' _ _ _).1 h7
    omega
  have hne : ∀ (γ : M) (c0 : K), c0 ≠ 0 → γ ^ (2 ^ (s + 2)) = algebraMap K M c0 → γ ≠ 0 := by
    intro γ c0 hc0 hγ
    rintro rfl
    rw [zero_pow (by positivity)] at hγ
    exact hc0 ((map_eq_zero_iff _ (algebraMap K M).injective).1 hγ.symm)
  have hβ : (ζ ^ i * α) ^ (2 ^ (s + 2)) = algebraMap K M a := by
    rw [mul_pow, ← pow_mul, mul_comm i, pow_mul, hζ.pow_eq_one, one_pow, one_mul, hα]
  have hβ' : (ζ ^ i' * α') ^ (2 ^ (s + 2)) = algebraMap K M a' := by
    rw [mul_pow, ← pow_mul, mul_comm i', pow_mul, hζ.pow_eq_one, one_pow, one_mul, hα']
  let J : Subgroup Mˣ :=
    { carrier := {x | x ^ (2 ^ (s + 2)) = 1 ∧ ∀ u ∈ U, u (x : M) = x}
      mul_mem' := by
        rintro x y ⟨hx, hx'⟩ ⟨hy, hy'⟩
        refine ⟨?_, fun u hu => ?_⟩
        · rw [mul_pow, hx, hy, one_mul]
        · simp [hx' u hu, hy' u hu]
      one_mem' := ⟨one_pow _, fun u hu => by simp⟩
      inv_mem' := by
        rintro x ⟨hx, hx'⟩
        refine ⟨by rw [inv_pow, hx, inv_one], fun u hu => ?_⟩
        simp [hx' u hu] }
  have hJle : J ≤ rootsOfUnity (2 ^ (s + 2)) M := fun x hx => (mem_rootsOfUnity _ _).2 hx.1
  haveI : Finite J :=
    Finite.of_injective (Subgroup.inclusion hJle) (Subgroup.inclusion_injective hJle)
  haveI : IsCyclic J := isCyclic_subgroup_units J
  have mkJ : ∀ (γ : M) (c0 : K), c0 ≠ 0 → γ ^ (2 ^ (s + 2)) = algebraMap K M c0 →
      (∀ u ∈ U, u γ = γ) → ∃ x : J, ((x : Mˣ) : M) = g₁ γ / γ := by
    intro γ c0 hc0 hγ hUγ
    have hγ0 := hne γ c0 hc0 hγ
    have hg0 : g₁ γ ≠ 0 := by simpa using hγ0
    have hc : (g₁ γ / γ) ^ (2 ^ (s + 2)) = 1 := by
      rw [div_pow, ← map_pow, hγ, AlgEquiv.commutes, div_self]
      simpa using hc0
    refine ⟨⟨Units.mk0 (g₁ γ / γ) (div_ne_zero hg0 hγ0), ?_, ?_⟩, rfl⟩
    · ext
      simpa using hc
    · intro u hu
      show u (g₁ γ / γ) = g₁ γ / γ
      have : u (g₁ γ) = g₁ γ := by
        have h := hUnorm u hu
        have h' : u * g₁ = g₁ * (g₁⁻¹ * u * g₁) := by group
        rw [← AlgEquiv.mul_apply, h', AlgEquiv.mul_apply, hUγ _ h]
      rw [map_div₀, this, hUγ u hu]
  have hdM : ∀ d : J, ((d : Mˣ) : M) ^ (2 ^ (s + 2)) = 1 := fun d => by
    rw [← Units.val_pow_eq_pow_val, d.2.1, Units.val_one]
  have hβ0 := hne _ _ ha0 hβ
  have hβ0' := hne _ _ ha0' hβ'
  obtain ⟨x, hx⟩ := mkJ _ _ ha0 hβ hi
  obtain ⟨x', hx'⟩ := mkJ _ _ ha0' hβ' hi'
  have hxg : g₁ (ζ ^ i * α) = (x : Mˣ) * (ζ ^ i * α) := by
    rw [hx, div_mul_cancel₀ _ hβ0]
  have hxg' : g₁ (ζ ^ i' * α') = (x' : Mˣ) * (ζ ^ i' * α') := by
    rw [hx', div_mul_cancel₀ _ hβ0']
  rcases cyclic_trichotomy x x' with ⟨d, hd⟩ | ⟨d, hd⟩ | ⟨d, hd⟩
  · left
    have hd' : ((x : Mˣ) : M) = ((d : Mˣ) : M) ^ 2 := by rw [hd]; simp
    exact key_square (by omega) hζ g₁ e he hg₁ζ U hUg hβ hi (hdM d) (fun u hu => d.2.2 u hu)
      (by rw [hxg, hd'])
  · right; left
    have hd' : ((x' : Mˣ) : M) = ((d : Mˣ) : M) ^ 2 := by rw [hd]; simp
    exact key_square (by omega) hζ g₁ e he hg₁ζ U hUg hβ' hi' (hdM d) (fun u hu => d.2.2 u hu)
      (by rw [hxg', hd'])
  · right; right
    have hd' : ((x : Mˣ) : M) * ((x' : Mˣ) : M)⁻¹ = ((d : Mˣ) : M) ^ 2 := by
      have := congrArg (fun y : J => ((y : Mˣ) : M)) hd
      simpa using this
    have hx'0 : ((x' : Mˣ) : M) ≠ 0 := Units.ne_zero _
    have hββ : (ζ ^ i * α / (ζ ^ i' * α')) ^ (2 ^ (s + 2)) = algebraMap K M (a / a') := by
      rw [div_pow, hβ, hβ', map_div₀]
    obtain ⟨b, hb⟩ := key_square (by omega) hζ g₁ e he hg₁ζ U hUg hββ
      (fun u hu => by rw [map_div₀, hi u hu, hi' u hu]) (hdM d) (fun u hu => d.2.2 u hu)
      (by rw [map_div₀, hxg, hxg', ← hd']; field_simp)
    exact ⟨b, by rw [hb]; exact div_mul_cancel₀ a ha0'⟩

end NumberFieldKB.MilneCFT.Ch8.R15a
