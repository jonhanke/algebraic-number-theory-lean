/-!
# Tensor product of a simple separable extension with a field extension

The algebraic step in Milne's proof of Proposition 8.2 (p. 136): for a finite separable extension
`L = K[α]` and any field extension `E` of `K`, the `E`-algebra `E ⊗_K L` is the product of the fields
`E[X]/(g)`, over the monic irreducible factors `g` of the minimal polynomial of `α` in `E[X]`.
-/

open Polynomial
open scoped TensorProduct

namespace NumberFieldKB.MilneANT

variable {K L : Type*} [Field K] [Field L] [Algebra K L] (E : Type*) [Field E] [Algebra K E]

/-- The monic irreducible factors of `f` in `E[X]`. -/
abbrev MonicIrredFactors (f : E[X]) := {g : E[X] // g.Monic ∧ Irreducible g ∧ g ∣ f}

/-- The power basis of `L` over `K` generated by `α`. -/
noncomputable def powerBasisOfAdjoinEqTop [FiniteDimensional K L] {α : L}
    (hα : IntermediateField.adjoin K {α} = ⊤) : PowerBasis K L :=
  PowerBasis.ofAdjoinSimpleEqTop (Algebra.IsIntegral.isIntegral α) hα

/-- The `K`-algebra map `L → E[X]/(g)` sending the primitive element `α` to the root of `g`, for `g` a factor of the
image of the minimal polynomial of `α`. -/
noncomputable def toAdjoinRoot {α : L} (hα : IntermediateField.adjoin K {α} = ⊤) [FiniteDimensional K L]
    (g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) : L →ₐ[K] AdjoinRoot g.1 :=
  (powerBasisOfAdjoinEqTop hα).lift (AdjoinRoot.root g.1) (by
    have h1 : (powerBasisOfAdjoinEqTop hα).gen = α :=
      PowerBasis.ofAdjoinSimpleEqTop_gen _ hα
    rw [h1, ← Polynomial.aeval_map_algebraMap E, AdjoinRoot.aeval_eq,
      AdjoinRoot.mk_eq_zero]
    exact g.2.2.2)

theorem toAdjoinRoot_self [FiniteDimensional K L] {α : L} (hα : IntermediateField.adjoin K {α} = ⊤)
    (g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) :
    toAdjoinRoot E hα g α = AdjoinRoot.root g.1 := by
  have h1 : (powerBasisOfAdjoinEqTop hα).gen = α :=
    PowerBasis.ofAdjoinSimpleEqTop_gen _ hα
  exact (congrArg (toAdjoinRoot E hα g) h1).symm.trans (PowerBasis.lift_gen _ _ _)

/-- Membership in the multiset of normalized factors. -/
lemma mem_normalizedFactors_iff' [DecidableEq E] {f : E[X]} (hf : f ≠ 0) (g : E[X]) :
    g ∈ UniqueFactorizationMonoid.normalizedFactors f ↔ g.Monic ∧ Irreducible g ∧ g ∣ f := by
  rw [Polynomial.mem_normalizedFactors_iff hf]
  tauto

/-- Finiteness of the index type. -/
instance [FiniteDimensional K L] {α : L} :
    Finite (MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) := by
  classical
  have hne : (minpoly K α).map (algebraMap K E) ≠ 0 :=
    ((minpoly.monic (Algebra.IsIntegral.isIntegral α)).map _).ne_zero
  refine Finite.of_injective
    (fun g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E)) =>
      (⟨g.1, by
        rw [Multiset.mem_toFinset, mem_normalizedFactors_iff' E hne]
        exact g.2⟩ :
        ↥(UniqueFactorizationMonoid.normalizedFactors
          ((minpoly K α).map (algebraMap K E))).toFinset)) ?_
  intro g h hgh
  exact Subtype.ext (by injection hgh)

/-- For a squarefree monic polynomial, the product of its monic irreducible factors is itself. -/
lemma prod_monicIrredFactors {f : E[X]} (hm : f.Monic) (hsq : Squarefree f) :
    ∃ s : Finset E[X], (∀ g, g ∈ s ↔ (g.Monic ∧ Irreducible g ∧ g ∣ f)) ∧ ∏ g ∈ s, g = f := by
  classical
  have hne : f ≠ 0 := hm.ne_zero
  refine ⟨(UniqueFactorizationMonoid.normalizedFactors f).toFinset, fun g => ?_, ?_⟩
  · rw [Multiset.mem_toFinset, mem_normalizedFactors_iff' E hne]
  · have hnd := (UniqueFactorizationMonoid.squarefree_iff_nodup_normalizedFactors hne).1 hsq
    have h1 : (UniqueFactorizationMonoid.normalizedFactors f).toFinset.val
        = UniqueFactorizationMonoid.normalizedFactors f := by
      rw [Multiset.toFinset_val, Multiset.dedup_eq_self.2 hnd]
    have h2 : ∏ g ∈ (UniqueFactorizationMonoid.normalizedFactors f).toFinset, g
        = (UniqueFactorizationMonoid.normalizedFactors f).prod := by
      rw [Finset.prod_eq_multiset_prod, h1, Multiset.map_id']
    rw [h2]
    have hassoc := UniqueFactorizationMonoid.prod_normalizedFactors hne
    refine eq_of_monic_of_associated ?_ hm hassoc
    have := Polynomial.monic_multiset_prod_of_monic
      (UniqueFactorizationMonoid.normalizedFactors f) id
      (fun g hg => ((mem_normalizedFactors_iff' E hne g).1 hg).1)
    simpa using this

theorem bijective_aux [FiniteDimensional K L] [Algebra.IsSeparable K L] {α : L}
    (hα : IntermediateField.adjoin K {α} = ⊤)
    (ψ : E ⊗[K] L →ₐ[E]
      ((g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) → AdjoinRoot g.1))
    (hψ1 : ∀ g, ψ (1 ⊗ₜ[K] α) g = AdjoinRoot.root g.1) :
    Function.Bijective ψ := by
  classical
  generalize hf : (minpoly K α).map (algebraMap K E) = f at ψ hψ1
  have hint : IsIntegral K α := Algebra.IsIntegral.isIntegral α
  have hm : f.Monic := hf ▸ (minpoly.monic hint).map _
  have hne : f ≠ 0 := hm.ne_zero
  have hsq : Squarefree f :=
    hf ▸ (Polynomial.Separable.map (Algebra.IsSeparable.isSeparable K α)).squarefree
  obtain ⟨s, hs, hprod⟩ := prod_monicIrredFactors E hm hsq
  have : Finite (MonicIrredFactors E f) := hf ▸ inferInstance
  have : Fintype (MonicIrredFactors E f) := Fintype.ofFinite _
  -- surjectivity
  have hsurj : Function.Surjective ψ := by
    have hcop : Pairwise (Function.onFun IsCoprime
        (fun g : MonicIrredFactors E f => Ideal.span ({g.1} : Set E[X]))) := by
      intro g h hgh
      simp only [Function.onFun]
      rw [Ideal.isCoprime_span_singleton_iff, Irreducible.coprime_iff_not_dvd g.2.2.1]
      intro hdvd
      exact hgh (Subtype.ext (eq_of_monic_of_associated g.2.1 h.2.1
        (g.2.2.1.associated_of_dvd h.2.2.1 hdvd)))
    intro x
    obtain ⟨y, hy⟩ := (Ideal.quotientInfRingEquivPiQuotient _ hcop).surjective x
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨aeval (1 ⊗ₜ[K] α : E ⊗[K] L) p, ?_⟩
    rw [← hy]
    funext g
    have : ψ (aeval (1 ⊗ₜ[K] α : E ⊗[K] L) p) g
        = aeval (ψ (1 ⊗ₜ[K] α) g) p := by
      rw [show ψ (aeval (1 ⊗ₜ[K] α : E ⊗[K] L) p) g
          = (Pi.evalAlgHom E (fun g : MonicIrredFactors E f => AdjoinRoot g.1) g)
            (ψ (aeval (1 ⊗ₜ[K] α : E ⊗[K] L) p)) from rfl,
        ← Polynomial.aeval_algHom_apply, ← Polynomial.aeval_algHom_apply]
      rfl
    rw [this, hψ1 g, AdjoinRoot.aeval_eq]
    rfl
  -- dimensions
  refine ⟨?_, hsurj⟩
  have hpb := powerBasisOfAdjoinEqTop hα
  have hdim1 : Module.finrank E (E ⊗[K] L) = (minpoly K α).natDegree := by
    rw [Module.finrank_baseChange, (powerBasisOfAdjoinEqTop hα).finrank]
    exact PowerBasis.ofAdjoinSimpleEqTop_dim _ hα
  have hfin : ∀ g : MonicIrredFactors E f, Module.Finite E (AdjoinRoot g.1) :=
    fun g => (AdjoinRoot.powerBasis g.2.1.ne_zero).finite
  have hdim2 : Module.finrank E ((g : MonicIrredFactors E f) → AdjoinRoot g.1)
      = (minpoly K α).natDegree := by
    rw [Module.finrank_pi_fintype]
    have hg : ∀ g : MonicIrredFactors E f,
        Module.finrank E (AdjoinRoot g.1) = g.1.natDegree := fun g => by
      rw [(AdjoinRoot.powerBasis g.2.1.ne_zero).finrank]
      rfl
    simp_rw [hg]
    have e1 : (minpoly K α).natDegree = f.natDegree := by
      rw [← hf]; exact (Polynomial.natDegree_map _).symm
    rw [e1]
    conv_rhs => rw [← hprod]
    rw [natDegree_prod s (fun g : E[X] => g) (fun g hg => ((hs g).1 hg).1.ne_zero)]
    rw [← Finset.sum_coe_sort s (fun g : E[X] => g.natDegree)]
    exact Fintype.sum_equiv (Equiv.subtypeEquivRight (fun g => (hs g).symm)) _ _
      (fun _ => rfl)
  have hlin : Module.finrank E (E ⊗[K] L) =
      Module.finrank E ((g : MonicIrredFactors E f) → AdjoinRoot g.1) := by
    rw [hdim1, hdim2]
  exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
    (f := (ψ : E ⊗[K] L →ₗ[E] _)) hlin).2 hsurj

/-- **Milne, Proposition 8.2 (algebraic step)**: for a finite separable extension `L = K[α]` and a field
extension `E` of `K`, the `E`-algebra `E ⊗_K L` is isomorphic to the product of the fields `E[X]/(g)` over the
monic irreducible factors `g` of the minimal polynomial of `α` in `E[X]`, by `b ⊗ a ↦ (b · a(root of g))_g`. -/
@[kb "milne2020ant" "v3.08, Prop. 8.2, p. 136"]
theorem exists_tensor_algEquiv_pi [FiniteDimensional K L] [Algebra.IsSeparable K L] {α : L}
    (hα : IntermediateField.adjoin K {α} = ⊤) :
    ∃ e : E ⊗[K] L ≃ₐ[E]
        ((g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) → AdjoinRoot g.1),
      ∀ (b : E) (a : L) g,
        e (b ⊗ₜ a) g = algebraMap E (AdjoinRoot g.1) b * toAdjoinRoot E hα g a := by
  let ψ := Algebra.TensorProduct.lift (Algebra.ofId E
          ((g : MonicIrredFactors E ((minpoly K α).map (algebraMap K E))) → AdjoinRoot g.1))
        (AlgHom.pi fun g => toAdjoinRoot E hα g) (fun _ _ => Commute.all _ _)
  have hψ : ∀ (b : E) (a : L) g,
      ψ (b ⊗ₜ a) g = algebraMap E (AdjoinRoot g.1) b * toAdjoinRoot E hα g a := by
    intro b a g
    simp [ψ, Algebra.TensorProduct.lift_tmul]
  refine ⟨AlgEquiv.ofBijective ψ (bijective_aux E hα ψ fun g => ?_), fun b a g => hψ b a g⟩
  rw [hψ, map_one, one_mul, toAdjoinRoot_self]

end NumberFieldKB.MilneANT
