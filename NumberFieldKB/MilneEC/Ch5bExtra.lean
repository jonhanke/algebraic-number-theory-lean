import NumberFieldKB.MilneEC.Ch5bGalois
import Mathlib.GroupTheory.Nilpotent
import Mathlib.Algebra.Field.ZMod
import Mathlib.FieldTheory.IsAlgClosed.AlgebraicClosure
import Mathlib.RingTheory.SimpleRing.Principal
import Mathlib.AlgebraicGeometry.EllipticCurve.Affine.Point
import Mathlib.AlgebraicGeometry.EllipticCurve.DivisionPolynomial.Basic

/-!
# Milne, *Elliptic Curves*, Chapter V, Sections 7–8: further named statements

Milne, *Elliptic Curves* (`milne2006ec`), Chapter V.

* **Proposition 7.3** (named `Prop7_3`, p. 226): the Frobenius map $\varphi_p : C \to C^{(p)}$ is purely inseparable
  of degree $p$, and every purely inseparable map of degree $p$ factors through it. Stated for elliptic curves in
  Weierstrass form (Mathlib has no general complete nonsingular curves), through function fields: a morphism
  $\alpha : C \to C'$ is its map $\alpha^* : k(C') \to k(C)$, and "$\varphi$ factors through $\varphi_p$" means that
  $\varphi^*$ and $\varphi_p^*$ have the same image (a morphism $C^{(p)} \to C'$ is then the inclusion of images).
* **Example 8.2, second assertion** (named `Example8_2Unramified`, p. 231).
* **The representation on $E_\ell$ is odd** (named `TorsionRepOdd`, p. 232, from the Weil pairing).
* The Tate module $T_\ell E$ of an elliptic curve over a field $k$ (definition in prose, p. 231): `tateModuleOf`.
-/

open WeierstrassCurve WeierstrassCurve.Affine

noncomputable section

namespace NumberFieldKB.MilneEC.Vb

/-- The coordinate function $x$ in the function field of a Weierstrass curve. -/
def xFn {F : Type*} [Field F] (W : WeierstrassCurve F) : W.toAffine.FunctionField :=
  algebraMap W.toAffine.CoordinateRing W.toAffine.FunctionField
    (CoordinateRing.mk W.toAffine (Polynomial.C Polynomial.X))

/-- The coordinate function $y$ in the function field of a Weierstrass curve. -/
def yFn {F : Type*} [Field F] (W : WeierstrassCurve F) : W.toAffine.FunctionField :=
  algebraMap W.toAffine.CoordinateRing W.toAffine.FunctionField (CoordinateRing.mk W.toAffine Polynomial.X)

/-- **Proposition 7.3** (named statement; Milne, *EC*, V, Proposition 7.3, p. 226; Silverman II.2.12), for elliptic
curves $C$ over $\mathbb F = \bar{\mathbb F}_p$: the Frobenius map $\varphi_p : C \to C^{(p)}$, i.e. the
$\mathbb F$-algebra map $\varphi_p^* : \mathbb F(C^{(p)}) \to \mathbb F(C)$ with $x \mapsto x^p$, $y \mapsto y^p$, is
purely inseparable of degree $p$, and every purely inseparable map $\varphi : C \to C'$ of degree $p$ factors through
it (its image $\varphi^*\mathbb F(C')$ is $\varphi_p^*\mathbb F(C^{(p)})$). -/
@[kb "milne2006ec" "Ch. V, Proposition 7.3 (Frobenius is purely inseparable of degree p; input)"]
structure Prop7_3 : Prop where
  frobenius : ∀ (p : ℕ) [Fact p.Prime] (C : WeierstrassCurve (Fpbar p)), C.IsElliptic →
    ∃ φ : (frobeniusTwist p C).toAffine.FunctionField →ₐ[Fpbar p] C.toAffine.FunctionField,
      φ (xFn (frobeniusTwist p C)) = xFn C ^ p ∧ φ (yFn (frobeniusTwist p C)) = yFn C ^ p ∧
      curveMapDegree φ = p ∧ IsPurelyInseparableCurveMap φ ∧
      ∀ (F' : Type) [Field F'] [Algebra (Fpbar p) F'] (ψ : F' →ₐ[Fpbar p] C.toAffine.FunctionField),
        curveMapDegree ψ = p → IsPurelyInseparableCurveMap ψ → ψ.fieldRange = φ.fieldRange

/-- The curve $Y^2 = X^3 + aX + b$ with integer coefficients, over $\mathbb Q$. -/
def shortCurveInt (a b : ℤ) : WeierstrassCurve ℚ := shortCurve a b

/-- **Example 8.2, second assertion** (named statement; Milne, *EC*, V, Example 8.2, p. 231: "Those who know a little
algebraic number theory will recognize that this field is unramified at the primes not dividing the discriminant
$\Delta$ of $X^3 + aX + b$"): for $a, b \in \mathbb Z$ and a prime $p \nmid -4a^3 - 27b^2$, $p$ is unramified in the
field generated by the coordinates of the points of order $2$. (Milne's "i.e., at the primes where $E$ has good
reduction (ignoring 2)" needs the equation to be minimal at $p$.) -/
@[kb "milne2006ec" "Ch. V, Example 8.2 (pdf p. 231): unramified away from the discriminant (input)"]
structure Example8_2Unramified : Prop where
  unramified : ∀ (a b : ℤ) (p : ℕ), p.Prime → ¬ (p : ℤ) ∣ (-4 * a ^ 3 - 27 * b ^ 2) →
    IsUnramifiedInField (coordField (shortCurveInt a b) (torsionPts (shortCurveInt a b) Qbar 2)) p

/-- **The representation on $E_\ell$ is odd** (named statement; Milne, *EC*, V.8, p. 232, running text: "The Weil
pairing shows that $\bigwedge^2 E_\ell \simeq \mu_\ell$ … this shows that the representation of $G_S$ on $E_\ell$ is
odd"): for an elliptic curve $E$ over $\mathbb Q$, a prime $\ell$ and a complex conjugation $c$,
$\det(c \mid E(\bar{\mathbb Q})_\ell) = -1$. -/
@[kb "milne2006ec" "Ch. V, Section 8 (pdf p. 232): the representation on E_ℓ is odd (input)"]
structure TorsionRepOdd : Prop where
  odd : ∀ (E : WeierstrassCurve ℚ) [E.IsElliptic] (ℓ : ℕ) [Fact ℓ.Prime] (c : GQ), IsComplexConjugation c →
    torsionDet E Qbar ℓ (torsionRep E Qbar ℓ c) = -1

/-- **The Tate module of an elliptic curve over a field $k$** (Milne, *EC*, V.8, p. 231, definition in prose): the
Tate module of $E_{k^{\mathrm{al}}}$, $T_\ell E = \varprojlim E(k^{\mathrm{al}})_{\ell^n}$. -/
@[kb "milne2006ec" "Ch. V, Section 8 (pdf p. 231): T_ℓE for E over k (definition in prose)"]
def tateModuleOf {K : Type*} [Field K] (W : WeierstrassCurve K) (ℓ : ℕ) [DecidableEq (AlgebraicClosure K)] :
    AddSubgroup (ℕ → pts W (AlgebraicClosure K)) :=
  tateModuleVb ℓ (pts W (AlgebraicClosure K))

end NumberFieldKB.MilneEC.Vb
