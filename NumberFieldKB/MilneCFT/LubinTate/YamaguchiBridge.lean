import NumberFieldKB.MilneCFT.LubinTate.Extension
import NumberFieldKB.MilneCFT.LubinTate.FormalGroup
import NumberFieldKB.YamaguchiPort.ClassFieldTheory.LubinTate.FiniteLevel.LevelAbelian
import NumberFieldKB.YamaguchiPort.ClassFieldTheory.LubinTate.FiniteLevel.NormUniformizer
import NumberFieldKB.YamaguchiPort.ClassFieldTheory.LubinTate.FiniteLevel.StandardLocalField

/-!
# Bridge to Yamaguchi's finite-level Lubin–Tate theory (Milne, *CFT*, I, §3)

Our Lubin–Tate objects (`LubinTate/Extension.lean`): the polynomial `ltPoly π = π T + T^q`, its iterates
`ltPolyIter π n = f^{(n)}`, the torsion points `ltTorsion` (all roots of `f^{(n)}` in `Ω`), the evaluation `ltEval`
of a power series at such a root by the Weierstrass remainder modulo `f^{(n)}`, and the action `ltAct` through our
endomorphisms `[a]_f` (`lubinTateEnd`, Corollary 2.17).

Yamaguchi's library (ported under `NumberFieldKB/YamaguchiPort/ClassFieldTheory/LubinTate/`, Apache 2.0, Naganori
Yamaguchi) works with the canonical local-field package `LubinTate.standardLocalField K` (for `K : Type`), the same
polynomial `T^q + π T`, the level field `K(λ_n)` generated by a root of the primitive polynomial
`(f^{(n)})^{q-1} + π` inside `SeparableClosure K`, with the valuation of a complete discretely valued field on it, and
*analytic* evaluation of power series at its topologically nilpotent integers.

This file identifies the two:
* `ltEval_eq_of_ringHom`: the Weierstrass evaluation at a root of `f^{(m)}` agrees with any ring homomorphism
  extending polynomial evaluation (for every `K`).
* `polynomialIterate_eq_map`: Yamaguchi's iterates are ours, transported along
  `standardLocalFieldIntegerEquiv : 𝒪[K] ≃+* (standardLocalField K).valuationSubring`.
* `map_lubinTateEnd`: Yamaguchi's endomorphism `[a]` is ours (uniqueness in Lemma 2.11).
-/

open scoped ValuativeRel
open Polynomial

noncomputable section

set_option linter.unusedSectionVars false
set_option linter.style.haveILetI false

namespace NumberFieldKB.MilneCFT.LocalCFT

section General

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type*} [Field Ω] [Algebra K Ω]

/-- `f^{(m)}` reduces to `T^{q^m} ≠ 0` modulo `𝔪`, so it is a Weierstrass divisor. -/
theorem ltPolyIter_map_residue_ne_zero {π : 𝒪[K]} (hπ : Irreducible π) (m : ℕ) :
    PowerSeries.map (IsLocalRing.residue 𝒪[K]) ((ltPolyIter π m : 𝒪[K][X]) : PowerSeries 𝒪[K]) ≠ 0 := by
  obtain ⟨-, -, hmap⟩ := ltPolyIter_aux hπ m
  intro h
  have h1 : (((ltPolyIter π m).map (IsLocalRing.residue 𝒪[K]) : 𝓀[K][X]) : PowerSeries 𝓀[K]) = 0 := by
    rw [Polynomial.polynomial_map_coe]; exact h
  have h2 : (ltPolyIter π m).map (IsLocalRing.residue 𝒪[K]) = X ^ (resCard K ^ m) := by
    have : (IsLocalRing.residue 𝒪[K]) = Ideal.Quotient.mk 𝓂[K] := rfl
    rw [this]; exact hmap
  rw [h2, Polynomial.coe_pow, Polynomial.coe_X] at h1
  exact pow_ne_zero _ PowerSeries.X_ne_zero h1

/-- **The Weierstrass evaluation is the evaluation** at a root `α` of `f^{(m)}`: any ring homomorphism
`φ : 𝒪_K[[T]] → Ω` extending the evaluation of polynomials at `α` agrees with `ltEval π m · α`. -/
theorem ltEval_eq_of_ringHom {π : 𝒪[K]} (hπ : Irreducible π) (m : ℕ) (φ : PowerSeries 𝒪[K] →+* Ω) (α : Ω)
    (hφ : ∀ p : 𝒪[K][X], φ (p : PowerSeries 𝒪[K]) = aeval α (p.map (algebraMap 𝒪[K] K)))
    (hα : aeval α ((ltPolyIter π m).map (algebraMap 𝒪[K] K)) = 0) (P : PowerSeries 𝒪[K]) :
    ltEval π m P α = φ P := by
  have hg := ltPolyIter_map_residue_ne_zero hπ m
  have h := PowerSeries.eq_mul_weierstrassDiv_add_weierstrassMod (f := P) hg
  conv_rhs => rw [h]
  rw [map_add, map_mul, hφ, hφ, hα, zero_mul, zero_add]
  rfl

end General

section Yamaguchi

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

/-- The canonical local-field package of Yamaguchi. -/
local notation "𝔽" => LubinTate.standardLocalField K

/-- The identification `𝒪[K] ≃+* 𝒪_𝔽`. -/
local notation "𝔢" => LubinTate.standardLocalFieldIntegerEquiv K

/-- A prime element of `𝒪[K]` is a uniformizer of Yamaguchi's package. -/
theorem isUniformizer_of_irreducible {π : 𝒪[K]} (hπ : Irreducible π) :
    (𝔽).toCompleteDVF.valuation.IsUniformizer (((𝔢 π : (𝔽).valuationSubring)) : K) :=
  Valuation.isUniformizer_of_maximalIdeal_eq_span (v := (𝔽).valuation) (hπ.map 𝔢).maximalIdeal_eq

theorem resCard_eq : Nat.card (𝔽).residueField = resCard K := rfl

/-- Yamaguchi's polynomial `T^q + π T` is ours. -/
theorem standardPolynomial_eq_map (π : 𝒪[K]) :
    LubinTate.standardLubinTatePolynomial 𝔽 (𝔢 π) = (ltPoly π).map (𝔢 : 𝒪[K] →+* (𝔽).valuationSubring) := by
  rw [LubinTate.standardLubinTatePolynomial_formula, ltPoly, resCard_eq]
  simp [Polynomial.map_add, Polynomial.map_mul, add_comm]

/-- Yamaguchi's iterates `f^{(n)}` are ours. -/
theorem polynomialIterate_eq_map (π : 𝒪[K]) (n : ℕ) :
    LubinTate.standardLubinTatePolynomialIterate 𝔽 (𝔢 π) n =
      (ltPolyIter π n).map (𝔢 : 𝒪[K] →+* (𝔽).valuationSubring) := by
  induction n with
  | zero => simp [ltPolyIter]
  | succ n ih =>
    rw [LubinTate.standardLubinTatePolynomialIterate, Function.iterate_succ_apply',
      ← LubinTate.standardLubinTatePolynomialIterate, ih, ltPolyIter_succ, Polynomial.map_comp,
      standardPolynomial_eq_map]

/-- Yamaguchi's standard series is the power series of `ltPoly`, transported. -/
theorem standardSeries_eq_map {π : 𝒪[K]} (hπ : Irreducible π) :
    (LubinTate.standardLubinTateSeries (isUniformizer_of_irreducible hπ)).toPowerSeries =
      PowerSeries.map (𝔢 : 𝒪[K] →+* (𝔽).valuationSubring) ((ltPoly π : 𝒪[K][X]) : PowerSeries 𝒪[K]) := by
  change LubinTate.standardLubinTatePowerSeries 𝔽 (𝔢 π) = _
  rw [LubinTate.standardLubinTatePowerSeries, ltPoly_coe, resCard_eq]
  simp

/-- **Yamaguchi's `[a]` is ours** (uniqueness in Milne, *CFT*, I, Lemma 2.11): transported to `𝒪[K]`, the
endomorphism `standardLubinTateEndomorphism` of linear coefficient `𝔢 a` is `[a]_f` for `f = ltPoly π`. -/
theorem map_lubinTateEnd {π : 𝒪[K]} (hπ : Irreducible π) (a : 𝒪[K]) :
    PowerSeries.map (𝔢 : 𝒪[K] →+* (𝔽).valuationSubring)
        (lubinTateEnd (lubinTateHyp_of_isNonarchimedeanLocalField K hπ) (ltPoly_mem hπ) a).toPowerSeries =
      LubinTate.SameUniformizer.standardLubinTateEndomorphism (isUniformizer_of_irreducible hπ) (𝔢 a) := by
  set hY := isUniformizer_of_irreducible hπ
  set Y := LubinTate.SameUniformizer.standardLubinTateEndomorphism hY (𝔢 a)
  set e' : (𝔽).valuationSubring →+* 𝒪[K] := ((𝔢).symm : (𝔽).valuationSubring →+* 𝒪[K])
  have hmapmap : ∀ P : PowerSeries 𝒪[K], PowerSeries.map e' (PowerSeries.map (𝔢 : 𝒪[K] →+* _) P) = P := by
    intro P; ext n; simp [e']
  suffices h : PowerSeries.map e' Y =
      (lubinTateEnd (lubinTateHyp_of_isNonarchimedeanLocalField K hπ) (ltPoly_mem hπ) a).toPowerSeries by
    rw [← h]; ext n; simp [e']
  have hlin := LubinTate.SameUniformizer.standardLubinTateEndomorphism_hasLinearTerm hY (𝔢 a)
  have hint := LubinTate.SameUniformizer.standardLubinTateEndomorphism_intertwines hY (𝔢 a)
  have h0 : PowerSeries.constantCoeff Y = 0 := hlin.constantCoeff_eq_zero
  have h1 : PowerSeries.coeff 1 Y = 𝔢 a := LubinTate.SameUniformizer.standardLubinTateEndomorphism_coeff_one hY (𝔢 a)
  have hsY : PowerSeries.HasSubst Y := PowerSeries.HasSubst.of_constantCoeff_zero h0
  -- the intertwining equation, in one-variable form
  have hint' : (LubinTate.standardLubinTateSeries hY).toPowerSeries.subst Y =
      Y.subst (LubinTate.standardLubinTateSeries hY).toPowerSeries := by
    have := hint
    unfold LubinTate.SameUniformizer.Intertwines LubinTate.SameUniformizer.inVariable at this
    rw [this]
    have hX : ∀ i : Unit, PowerSeries.subst (MvPowerSeries.X i : MvPowerSeries Unit (𝔽).valuationSubring)
        (LubinTate.standardLubinTateSeries hY).toPowerSeries =
        (LubinTate.standardLubinTateSeries hY).toPowerSeries := fun i =>
      PowerSeries.X_subst _
    simp_rw [hX]
    rfl
  refine eq_lubinTateSeriesHom (lubinTateHyp_of_isNonarchimedeanLocalField K hπ) (ltPoly_mem hπ) (ltPoly_mem hπ) a ?_ ?_ ?_
  · rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply, PowerSeries.coeff_map,
      PowerSeries.coeff_zero_eq_constantCoeff_apply, h0, map_zero]
  · rw [PowerSeries.coeff_map, h1]; simp [e']
  have hsF : PowerSeries.HasSubst ((LubinTate.standardLubinTateSeries hY).toPowerSeries) :=
    PowerSeries.HasSubst.of_constantCoeff_zero (LubinTate.standardLubinTateSeries hY).constantCoeff_eq_zero
  have := congrArg (PowerSeries.map e') hint'
  have hA : PowerSeries.map e' ((LubinTate.standardLubinTateSeries hY).toPowerSeries.subst Y) =
      (PowerSeries.map e' (LubinTate.standardLubinTateSeries hY).toPowerSeries).subst (PowerSeries.map e' Y) :=
    PowerSeries.map_subst hsY (h := e') _
  have hB : PowerSeries.map e' (Y.subst (LubinTate.standardLubinTateSeries hY).toPowerSeries) =
      (PowerSeries.map e' Y).subst (PowerSeries.map e' (LubinTate.standardLubinTateSeries hY).toPowerSeries) :=
    PowerSeries.map_subst hsF (h := e') _
  rw [hA, hB, show (LubinTate.standardLubinTateSeries hY).toPowerSeries = _ from standardSeries_eq_map hπ,
    hmapmap] at this
  exact this

end Yamaguchi

end NumberFieldKB.MilneCFT.LocalCFT
