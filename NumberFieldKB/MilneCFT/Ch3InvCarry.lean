import Mathlib
import QuadFormsKB.Citation
import NumberFieldKB.MilneCFT.Ch3InvInfl
import NumberFieldKB.MilneCFT.Ch3Split

/-!
# Milne, *Class Field Theory*, Chapter III §1: the invariant of the carry cocycle

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`.

For a cyclic group $G$ of order $n$ generated by $\sigma$, a $G$-module $M$ with a $G$-map $w : M \to \mathbb Z$ and a
fixed element $p \in M^G$, the invariant map `invOf M w σ` of p. 99 sends the class of the carry cocycle
$\varphi(\sigma^i, \sigma^j) = 0$ or $p$ (`carryCocycle`, p. 102) to $w(p)/n \bmod \mathbb Z$
(`invOf_carryCocycle`). Proof: $w_*\varphi$ is the carry cocycle of $w(p) \in \mathbb Z$, which is
$\delta\chi$ for the character $\chi(\sigma^i) = w(p)\, i/n$ (lift $\chi$ to $\mathbb Q$ and take the coboundary).
-/

namespace NumberFieldKB.MilneCFT.Ch3

open CategoryTheory Rep groupCohomology Limits NumberFieldKB.MilneCFT

variable {G : Type} [Group G] [Fintype G] {σ : G} (hσ : ∀ τ : G, τ ∈ Subgroup.zpowers σ)

/-- The rational lift $\sigma^i \mapsto m\,i/n$ ($0 \le i < n$) of the character $\chi_m$. -/
noncomputable def cycLift (m : ℤ) (τ : G) : ℚ := (m : ℚ) * (cycExp hσ τ : ℚ) / (Nat.card G : ℚ)

theorem cycLift_mul (m : ℤ) (g h : G) :
    cycLift hσ m (g * h) = cycLift hσ m g + cycLift hσ m h -
      (if cycExp hσ g + cycExp hσ h < Nat.card G then 0 else (m : ℚ)) := by
  have hn : (0 : ℚ) < Nat.card G := by exact_mod_cast Nat.card_pos
  have hg := cycExp_lt hσ g
  have hh := cycExp_lt hσ h
  unfold cycLift
  rw [cycExp_mul hσ]
  split_ifs with h1
  · rw [Nat.mod_eq_of_lt h1]; push_cast; field_simp; ring
  · have e : (cycExp hσ g + cycExp hσ h) % Nat.card G = cycExp hσ g + cycExp hσ h - Nat.card G := by
      rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
    rw [e, Nat.cast_sub (by omega)]; push_cast; field_simp

/-- The character $\chi_m : \sigma^i \mapsto m\,i/n \bmod \mathbb Z$, as a $1$-cocycle with values in the trivial
module $\mathbb Q/\mathbb Z$. -/
theorem cycLift_mk_mul (m : ℤ) (g h : G) :
    (QuotientAddGroup.mk (cycLift hσ m (g * h)) : QZ) =
      QuotientAddGroup.mk (cycLift hσ m h) + QuotientAddGroup.mk (cycLift hσ m g) := by
  rw [cycLift_mul, ← QuotientAddGroup.mk_add, QuotientAddGroup.eq]
  refine ⟨(if cycExp hσ g + cycExp hσ h < Nat.card G then 0 else m), ?_⟩
  split_ifs <;> simp <;> ring

noncomputable def cycChar (m : ℤ) : cocycles₁ (seqZQ G).X₃ :=
  ⟨(fun τ => (QuotientAddGroup.mk (cycLift hσ m τ) : QZ) : G → (seqZQ G).X₃),
    (mem_cocycles₁_iff (A := (seqZQ G).X₃) _).2 fun g h => cycLift_mk_mul hσ m g h⟩

/-- **$\delta\chi_m$ is the carry cocycle of $m$** in $H^2(G, \mathbb Z)$. -/
theorem delta_cycChar (m : ℤ) :
    (δ (seqZQ_shortExact G) 1 2 rfl).hom (H1π _ (cycChar hσ m)) =
      H2π _ (carryCocycle hσ (seqZQ G).X₁ m (fun _ => rfl)) := by
  rw [δ₁_apply (seqZQ_shortExact G) (cycChar hσ m) (fun τ => cycLift hσ m τ) rfl]
  funext x
  change ((if cycExp hσ x.1 + cycExp hσ x.2 < Nat.card G then 0 else m : ℤ) : ℚ) =
    cycLift hσ m x.2 - cycLift hσ m (x.1 * x.2) + cycLift hσ m x.1
  rw [cycLift_mul]
  split_ifs <;> push_cast <;> ring

theorem cycChar_apply_gen (m : ℤ) :
    ((cycChar hσ m : G → QZ) σ) = qz ((m : ℚ) / Nat.card G) := by
  change (QuotientAddGroup.mk (cycLift hσ m σ) : QZ) = QuotientAddGroup.mk _
  by_cases h1 : Nat.card G = 1
  · have : cycExp hσ σ = 0 := by have := cycExp_lt hσ σ; omega
    have h1' : Fintype.card G = 1 := by rwa [← Nat.card_eq_fintype_card]
    rw [QuotientAddGroup.eq]
    refine ⟨m, ?_⟩
    simp [cycLift, this, h1']
  · have h2 : 1 < Nat.card G := lt_of_le_of_ne Nat.card_pos (Ne.symm h1)
    have : cycExp hσ σ = 1 := by
      have hp := pow_cycExp hσ σ
      have hlt := cycExp_lt hσ σ
      have hord : orderOf σ = Nat.card G := by
        rw [← Nat.card_zpowers σ]
        exact Nat.card_congr (Equiv.subtypeUnivEquiv hσ)
      have h1' : σ ^ (cycExp hσ σ) = σ ^ 1 := by rw [hp, pow_one]
      rw [pow_eq_pow_iff_modEq, hord, Nat.ModEq, Nat.mod_eq_of_lt hlt, Nat.mod_eq_of_lt h2] at h1'
      exact h1'
    simp [cycLift, this]

/-- **The invariant of the carry cocycle** (Milne, *CFT*, III, §1, p. 101–102): for $G$ cyclic of order $n$
generated by $\sigma$, a $G$-map $w : M \to \mathbb Z$ and $p \in M^G$, the invariant `invOf M w σ` of the class of
the carry cocycle of $p$ is $w(p)/n \bmod \mathbb Z$. -/
@[kb "milne2020cft" "v4.03, Ch. III, §1, the cocycle representing u_{L/K} has invariant 1/n, p. 101–102"]
theorem invOf_carryCocycle (M : Rep ℤ G) (w : M ⟶ (seqZQ G).X₁) (p : M) (hp : ∀ g : G, M.ρ g p = p) :
    invOf M w σ (H2π M (carryCocycle hσ M p hp)) = qz (((show ℤ from w.hom p) : ℚ) / Nat.card G) := by
  have hmap : (groupCohomology.map (MonoidHom.id G) w 2).hom (H2π M (carryCocycle hσ M p hp)) =
      H2π _ (carryCocycle hσ (seqZQ G).X₁ (w.hom p) (fun _ => rfl)) := by
    rw [← ModuleCat.comp_apply, H2π_comp_map, ModuleCat.comp_apply]
    congr 1
    apply Subtype.ext
    funext x
    change w.hom ((carryCocycle hσ M p hp : G × G → M) x) = _
    refine Eq.trans ?_ (carryCocycle_apply hσ (seqZQ G).X₁ _ (fun _ => rfl) x).symm
    simp only [carryCocycle_apply]
    split_ifs <;> simp
  change h2IntToHom.hom ((groupCohomology.map (MonoidHom.id G) w 2).hom _) (Additive.ofMul σ) = _
  rw [hmap]
  erw [← delta_cycChar hσ (show ℤ from w.hom p)]
  rw [h2IntToHom_apply_delta]
  erw [H1IsoOfIsTrivial_H1π_apply_apply]
  exact cycChar_apply_gen hσ _

end NumberFieldKB.MilneCFT.Ch3
