import NumberFieldKB.WeilBNT.KLatticesLocalGlobal

/-!
# Weil, *Basic Number Theory*, V.§3, text p. 85–86: $(\mathfrak aL)_v=\mathfrak a_vL_v$ and $(\mathfrak{ab})_v=\mathfrak a_v\mathfrak b_v$

$k$ is a number field (`K`), $\mathfrak r$ its ring of integers, $E=k^n$, $v$ a finite place. For an
$\mathfrak r$-submodule $\mathfrak a$ of $k$ (a fractional ideal, Weil's Def. 4) and an $\mathfrak r$-submodule $L$ of $E$,
$\mathfrak aL$ is the $\mathfrak r$-module generated by the $\xi e$ with $\xi\in\mathfrak a$, $e\in L$ (`idealSmul`);
$\mathfrak a_v$ is the $r_v$-module generated by $\mathfrak a$ in $k_v$ (`localIdeal'`), which is the closure of
$\mathfrak a$ in $k_v$ when $\mathfrak a$ is a fractional ideal (V.§2 Prop. 4 with $E=k$), and $L_v$ is `localLattice L v`.

* `weil_V_3_text86_smul`: $(\mathfrak aL)_v$ is the $r_v$-module $\mathfrak a_vL_v$ generated by the $\alpha e$ with
  $\alpha\in\mathfrak a_v$, $e\in L_v$.
* `weil_V_3_text86_mul`: $(\mathfrak{ab})_v=\mathfrak a_v\mathfrak b_v$ for $\mathfrak r$-submodules $\mathfrak a,\mathfrak b$
  of $k$ (`Submodule` products).

Weil: "this makes it clear", the two sides being generated by the same elements; the proof is that remark.
-/

open IsDedekindDomain NumberField Filter Topology
open scoped Pointwise

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {K : Type} [Field K] [NumberField K] {n : ℕ}

/-- $\mathfrak aL$: the $\mathfrak r$-module generated by the $\xi e$, $\xi\in\mathfrak a$, $e\in L$. -/
def idealSmul (𝔞 : Submodule (𝓞 K) K) (L : Submodule (𝓞 K) (Fin n → K)) : Submodule (𝓞 K) (Fin n → K) :=
  Submodule.span (𝓞 K) {x | ∃ ξ ∈ 𝔞, ∃ e ∈ L, x = ξ • e}

/-- $\mathfrak a_v$: the $r_v$-module generated by $\mathfrak a$ in $k_v$. -/
def localIdeal' (𝔞 : Submodule (𝓞 K) K) (v : HeightOneSpectrum (𝓞 K)) :
    Submodule (v.adicCompletionIntegers K) (v.adicCompletion K) :=
  Submodule.span (v.adicCompletionIntegers K) ((fun ξ : K => (ξ : v.adicCompletion K)) '' (𝔞 : Set K))

/-- The $r_v$-module $\mathfrak a_vL_v$ generated by the $\alpha e$, $\alpha\in\mathfrak a_v$, $e\in L_v$. -/
def localIdealSmul {v : HeightOneSpectrum (𝓞 K)} (A : Submodule (v.adicCompletionIntegers K) (v.adicCompletion K))
    (M : Submodule (v.adicCompletionIntegers K) (Fin n → v.adicCompletion K)) :
    Submodule (v.adicCompletionIntegers K) (Fin n → v.adicCompletion K) :=
  Submodule.span (v.adicCompletionIntegers K) {y | ∃ α ∈ A, ∃ z ∈ M, y = α • z}

/-- **Weil, V.§3, text p. 85–86**: $(\mathfrak aL)_v=\mathfrak a_vL_v$. -/
@[kb "weil1973bnt" "Ch. V, §3, text p. 85-86, (aL)_v = a_v L_v, E = k^n"]
theorem weil_V_3_text86_smul (𝔞 : Submodule (𝓞 K) K) (L : Submodule (𝓞 K) (Fin n → K))
    (v : HeightOneSpectrum (𝓞 K)) :
    localLattice (idealSmul 𝔞 L) v = localIdealSmul (localIdeal' 𝔞 v) (localLattice L v) := by
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨x, hx, rfl⟩
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨ξ, hξ, e, he, rfl⟩ := hx
      rw [toLocal_smul]
      exact Submodule.subset_span ⟨_, Submodule.subset_span ⟨ξ, hξ, rfl⟩, _,
        toLocal_mem_localLattice L v ⟨e, he⟩, rfl⟩
    | zero => rw [toLocal_zero]; exact zero_mem _
    | add x y _ _ hx hy => rw [toLocal_add]; exact add_mem hx hy
    | smul a x _ hx => rw [toLocal_osmul]; exact Submodule.smul_mem _ _ hx
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨α, hα, z, hz, rfl⟩
    -- first: `ξ • z` for `ξ ∈ 𝔞` and `z ∈ L_v`
    have hgen : ∀ ξ ∈ 𝔞, ∀ z ∈ localLattice L v,
        (ξ : v.adicCompletion K) • z ∈ localLattice (idealSmul 𝔞 L) v := by
      intro ξ hξ z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨e, he, rfl⟩ := hz
        rw [← toLocal_smul]
        exact toLocal_mem_localLattice (idealSmul 𝔞 L) v ⟨_, Submodule.subset_span ⟨ξ, hξ, e, he, rfl⟩⟩
      | zero => rw [smul_zero]; exact zero_mem _
      | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
      | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ _ hx
    induction hα using Submodule.span_induction with
    | mem α hα =>
      obtain ⟨ξ, hξ, rfl⟩ := hα
      exact hgen ξ hξ z hz
    | zero => rw [zero_smul]; exact zero_mem _
    | add α β _ _ hα hβ => rw [add_smul]; exact add_mem hα hβ
    | smul c α _ hα => rw [smul_assoc]; exact Submodule.smul_mem _ _ hα

/-- **Weil, V.§3, text p. 86**: $(\mathfrak{ab})_v=\mathfrak a_v\mathfrak b_v$. -/
@[kb "weil1973bnt" "Ch. V, §3, text p. 86, (ab)_v = a_v b_v"]
theorem weil_V_3_text86_mul (𝔞 𝔟 : Submodule (𝓞 K) K) (v : HeightOneSpectrum (𝓞 K)) :
    localIdeal' (𝔞 * 𝔟) v = localIdeal' 𝔞 v * localIdeal' 𝔟 v := by
  have hcoe : ∀ x y : K, ((x * y : K) : v.adicCompletion K) = (x : v.adicCompletion K) * (y : v.adicCompletion K) :=
    fun x y => by rw [coe_eq_algebraMap, coe_eq_algebraMap, coe_eq_algebraMap, map_mul]
  apply le_antisymm
  · refine Submodule.span_le.mpr ?_
    rintro _ ⟨x, hx, rfl⟩
    induction hx using Submodule.mul_induction_on' with
    | mem_mul_mem a ha b hb =>
      show ((a * b : K) : v.adicCompletion K) ∈ localIdeal' 𝔞 v * localIdeal' 𝔟 v
      rw [hcoe]
      exact Submodule.mul_mem_mul (Submodule.subset_span ⟨a, ha, rfl⟩) (Submodule.subset_span ⟨b, hb, rfl⟩)
    | add x _ y _ hx hy =>
      show ((x + y : K) : v.adicCompletion K) ∈ localIdeal' 𝔞 v * localIdeal' 𝔟 v
      rw [coe_eq_algebraMap, map_add]
      exact add_mem hx hy
  · rw [Submodule.mul_le]
    intro α hα β hβ
    induction hα using Submodule.span_induction with
    | mem α hα =>
      obtain ⟨a, ha, rfl⟩ := hα
      induction hβ using Submodule.span_induction with
      | mem β hβ =>
        obtain ⟨b, hb, rfl⟩ := hβ
        rw [← hcoe]
        exact Submodule.subset_span ⟨_, Submodule.mul_mem_mul ha hb, rfl⟩
      | zero => rw [mul_zero]; exact zero_mem _
      | add x y _ _ hx hy => rw [mul_add]; exact add_mem hx hy
      | smul c x _ hx => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hx
    | zero => rw [zero_mul]; exact zero_mem _
    | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
    | smul c x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hx

end NumberFieldKB.WeilBNT
