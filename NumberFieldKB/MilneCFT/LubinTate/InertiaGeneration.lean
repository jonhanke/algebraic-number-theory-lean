import NumberFieldKB.MilneCFT.LubinTate.KroneckerWeber
import Mathlib.NumberTheory.NumberField.ExistsRamified
import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.Frobenius.FixedField.Inertia
import NumberFieldKB.TauCetiPort.NumberTheory.NumberField.Ideal.IntegersRat
import NumberFieldKB.TauCetiPort.RingTheory.RamificationInertia.Unramified

/-!
# Inertia groups generate $\mathrm{Gal}(L/\mathbb Q)$ (Milne, *CFT*, I, Lemma 4.17)

Minkowski's theorem: let $H$ be the subgroup generated by all inertia groups and $F = L^H$. Every prime of $F$ is
unramified over $\mathbb Z$ (its ramification index is $[I(Q) : I(Q) \cap H] = 1$, by
`Ideal.ramificationIdx_under_fixedField_eq_one_iff`), so no prime divides $\operatorname{disc} F$
(`NumberField.not_dvd_discr_iff_forall_liesOver`); hence $|\operatorname{disc} F| \le 2$ and
`NumberField.abs_discr_gt_two` forces $F = \mathbb Q$, i.e. $H = \mathrm{Gal}(L/\mathbb Q)$.
-/

open NumberField

namespace NumberFieldKB.MilneCFT.LocalCFT

/-- **Lemma 4.17, proved** (Milne, *CFT*, I, Lemma 4.17): the named statement `InertiaGeneration` holds, by
Minkowski's theorem that $\mathbb Q$ has no nontrivial unramified extension. -/
@[kb "milne2020cft" "Ch. I, Lemma 4.17"]
theorem inertiaGeneration : InertiaGeneration := by
  refine ⟨fun L _ _ _ => ?_⟩
  set H : Subgroup Gal(L/ℚ) := Subgroup.closure (⋃ (P : Ideal (NumberField.RingOfIntegers L))
    (_ : P.IsMaximal), (P.toAddSubgroup.inertia Gal(L/ℚ) : Set Gal(L/ℚ))) with hH
  set F := IntermediateField.fixedField H with hF
  have hfin : Module.finrank ℚ F = 1 := by
    by_contra hne
    obtain ⟨P, hPm, hPu⟩ := NumberField.exists_not_isUnramifiedAt_int (K := F)
      (𝒪 := NumberField.RingOfIntegers F) hne
    apply hPu
    obtain ⟨Q, hQm, hQP⟩ := Ideal.exists_maximal_ideal_liesOver_of_isIntegral
      (S := NumberField.RingOfIntegers L) P
    have hle : Q.inertia Gal(L/ℚ) ≤ H :=
      le_trans (le_of_eq_of_le rfl (fun x hx => Subgroup.subset_closure
        (Set.mem_iUnion₂.mpr ⟨Q, hQm, hx⟩))) le_rfl
    have he := (Ideal.ramificationIdx_under_fixedField_eq_one_iff (K := ℚ) Q H).mpr hle
    have hPQ : Q.under (NumberField.RingOfIntegers F) = P := hQP.over.symm
    rw [hPQ, Ideal.ramificationIdx_ringOfIntegers_rat_eq_int] at he
    refine (Ideal.isUnramifiedAt_iff_ramificationIdx_eq_one_and_isSeparable_residueField
      (R := ℤ) P).mpr ⟨he, ?_⟩
    let := Localization.AtPrime.algebraOfLiesOver (P.under ℤ) P
    have : Finite ((P.under ℤ).ResidueField) := by
      have hm : (P.under ℤ).IsMaximal := Ideal.IsMaximal.under ℤ P
      have hne : P.under ℤ ≠ ⊥ := (Ideal.bot_lt_of_maximal _ Int.not_isField).ne'
      have := Ideal.finiteQuotientOfFreeOfNeBot (P.under ℤ) hne
      infer_instance
    exact Algebra.IsAlgebraic.isSeparable_of_perfectField
  have hbot : F = ⊥ := IntermediateField.finrank_eq_one_iff.mp hfin
  have : H = ⊤ := by
    rw [← IntermediateField.fixingSubgroup_fixedField H, ← hF, hbot]
    exact IntermediateField.fixingSubgroup_bot
  exact this

end NumberFieldKB.MilneCFT.LocalCFT
