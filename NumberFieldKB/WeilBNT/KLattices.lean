import NumberFieldKB.WeilBNT.IntegersDense

/-!
# Weil, *Basic Number Theory*, V.§2, Definition 3 and Proposition 4: $k$-lattices are dense in $\prod_v L_v$

$k$ is a number field (`K`), $\mathfrak r$ its ring of integers, and $E=k^n$ (Weil's $E$ is any $n$-dimensional vector
space over $k$; choosing a basis identifies it with $k^n$, and $E_v=k_v^n$).

* **Def. 3** (p. 83): a *$k$-lattice* in $E$ is a finitely generated $\mathfrak r$-submodule $L$ of $E$ containing a basis
  of $E$ over $k$ (`IsKLattice`).
* For a finite place $v$, $L_v$ is the $r_v$-module generated by $L$ in $E_v$ (`localLattice L v`; Weil, V.§2 text p. 84
  and III.§1), and $\psi_L$ is the diagonal map $L\to\prod_vL_v$ (`psiL L`).
* **Prop. 4** (p. 84): $\psi_L(L)$ is dense in $\prod_vL_v$ (`weil_V_2_prop4`) and in every partial product
  (`weil_V_2_prop4_partial`), and $L_v$ is the closure of $L$ in $E_v$ (`weil_V_2_prop4_closure`).

*Proof* (Weil's): with generators $l_1,\dots,l_m$ of $L$, the map $(a_j)\mapsto\sum_ja_jl_j$ sends $\prod_vr_v^m$
continuously onto $\prod_vL_v$, and $\mathfrak r^m$ is dense in $\prod_vr_v^m$ by Cor. 1 of Thm. 1 (`weil_V_2_cor1`).
$L_v$ is compact (a continuous image of $r_v^m$), hence closed in $E_v$.
-/

open IsDedekindDomain NumberField Filter Topology

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {K : Type} [Field K] [NumberField K] {n : ℕ}

variable (K n) in
/-- **Weil, V.§2, Definition 3** ($E=k^n$): a $k$-lattice is a finitely generated $\mathfrak r$-submodule of $k^n$
containing a basis of $k^n$ over $k$. -/
def IsKLattice (L : Submodule (𝓞 K) (Fin n → K)) : Prop :=
  L.FG ∧ ∃ b : Module.Basis (Fin n) K (Fin n → K), ∀ i, b i ∈ L

/-- The embedding $E=k^n\to E_v=k_v^n$, coordinatewise. -/
def toLocal (v : HeightOneSpectrum (𝓞 K)) (x : Fin n → K) : Fin n → v.adicCompletion K :=
  fun i => (x i : v.adicCompletion K)

/-- $L_v$: the $r_v$-module generated by $L$ in $E_v=k_v^n$. -/
def localLattice (L : Submodule (𝓞 K) (Fin n → K)) (v : HeightOneSpectrum (𝓞 K)) :
    Submodule (v.adicCompletionIntegers K) (Fin n → v.adicCompletion K) :=
  Submodule.span (v.adicCompletionIntegers K) (toLocal v '' (L : Set (Fin n → K)))

theorem toLocal_mem_localLattice (L : Submodule (𝓞 K) (Fin n → K)) (v : HeightOneSpectrum (𝓞 K)) (l : L) :
    toLocal v (l : Fin n → K) ∈ localLattice L v :=
  Submodule.subset_span ⟨l, l.2, rfl⟩

/-- Weil's $\psi_L$: the diagonal map $L\to\prod_vL_v$ over all finite places. -/
def psiL (L : Submodule (𝓞 K) (Fin n → K)) (l : L) : ∀ v : HeightOneSpectrum (𝓞 K), localLattice L v :=
  fun v => ⟨toLocal v (l : Fin n → K), toLocal_mem_localLattice L v l⟩

/-- The map $(c_j)\mapsto\sum_jc_jl_j$ from $r_v^m$ to $E_v$. -/
def lcLocal {m : ℕ} (l : Fin m → (Fin n → K)) (v : HeightOneSpectrum (𝓞 K))
    (c : Fin m → v.adicCompletionIntegers K) : Fin n → v.adicCompletion K :=
  ∑ j, ((c j : v.adicCompletion K)) • toLocal v (l j)

theorem continuous_lcLocal {m : ℕ} (l : Fin m → (Fin n → K)) (v : HeightOneSpectrum (𝓞 K)) :
    Continuous (lcLocal l v) := by
  unfold lcLocal
  refine continuous_finsetSum _ fun j _ => ?_
  have h : Continuous fun c : Fin m → v.adicCompletionIntegers K => (c j : v.adicCompletion K) :=
    continuous_subtype_val.comp (continuous_apply j)
  exact h.smul continuous_const

/-- `toLocal` of an $\mathfrak r$-linear combination. -/
theorem toLocal_sum {m : ℕ} (l : Fin m → (Fin n → K)) (v : HeightOneSpectrum (𝓞 K)) (a : Fin m → 𝓞 K) :
    toLocal v (∑ j, a j • l j) = ∑ j, ((a j : K) : v.adicCompletion K) • toLocal v (l j) := by
  funext i
  have hc : ∀ x : K, (x : v.adicCompletion K) = algebraMap K (v.adicCompletion K) x := fun _ => rfl
  simp only [toLocal, Finset.sum_apply, Pi.smul_apply, Algebra.smul_def, hc, map_sum, map_mul]
  rfl

/-- For generators $l$ of $L$, $y\in L_v$ iff $y=\sum_jc_jl_j$ with $c_j\in r_v$. -/
theorem mem_localLattice_iff {L : Submodule (𝓞 K) (Fin n → K)} {m : ℕ} {l : Fin m → (Fin n → K)}
    (hl : Submodule.span (𝓞 K) (Set.range l) = L) (v : HeightOneSpectrum (𝓞 K))
    (y : Fin n → v.adicCompletion K) :
    y ∈ localLattice L v ↔ ∃ c : Fin m → v.adicCompletionIntegers K, lcLocal l v c = y := by
  have hlL : ∀ j, l j ∈ L := fun j => hl ▸ Submodule.subset_span ⟨j, rfl⟩
  constructor
  · intro hy
    have hle : localLattice L v ≤ Submodule.span (v.adicCompletionIntegers K)
        (Set.range fun j => toLocal v (l j)) := by
      refine Submodule.span_le.mpr ?_
      rintro _ ⟨x, hx, rfl⟩
      rw [← hl] at hx
      obtain ⟨a, rfl⟩ := (Submodule.mem_span_range_iff_exists_fun (𝓞 K)).mp hx
      have := toLocal_sum l v a
      rw [SetLike.mem_coe, this]
      refine Submodule.sum_mem _ fun j _ => ?_
      have h1 : ((a j : K) : v.adicCompletion K) • toLocal v (l j) =
          (algebraMap (𝓞 K) (v.adicCompletionIntegers K) (a j)) • toLocal v (l j) := rfl
      rw [h1]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩)
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (v.adicCompletionIntegers K)).mp (hle hy)
    exact ⟨c, hc⟩
  · rintro ⟨c, rfl⟩
    refine Submodule.sum_mem _ fun j _ => ?_
    exact Submodule.smul_mem _ (c j) (toLocal_mem_localLattice L v ⟨l j, hlL j⟩)

omit [NumberField K] in
/-- A finite generating family of a finitely generated lattice. -/
theorem exists_gen_family {L : Submodule (𝓞 K) (Fin n → K)} (hL : L.FG) :
    ∃ (m : ℕ) (l : Fin m → (Fin n → K)), Submodule.span (𝓞 K) (Set.range l) = L := by
  obtain ⟨m, l, hl⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hL
  exact ⟨m, l, hl⟩

/-- $\mathfrak r^m$ is dense in $\prod_v r_v^m$. -/
theorem denseRange_diag_pow (m : ℕ) :
    DenseRange (fun (a : Fin m → 𝓞 K) (v : HeightOneSpectrum (𝓞 K)) (j : Fin m) => psiIntegers K (a j) v) := by
  have h1 : DenseRange (Pi.map fun _ : Fin m => psiIntegers K) :=
    DenseRange.piMap fun _ => weil_V_2_cor1
  have hcont : Continuous (fun (f : Fin m → ∀ v : HeightOneSpectrum (𝓞 K), v.adicCompletionIntegers K)
      (v : HeightOneSpectrum (𝓞 K)) (j : Fin m) => f j v) :=
    continuous_pi fun v => continuous_pi fun j => (continuous_apply v).comp (continuous_apply j)
  have hsurj : Function.Surjective (fun (f : Fin m → ∀ v : HeightOneSpectrum (𝓞 K), v.adicCompletionIntegers K)
      (v : HeightOneSpectrum (𝓞 K)) (j : Fin m) => f j v) := fun z => ⟨fun j v => z v j, rfl⟩
  exact hsurj.denseRange.comp h1 hcont

/-- **Weil, V.§2, Proposition 4** (p. 84): for a $k$-lattice $L$, $\psi_L(L)$ is dense in $\prod_vL_v$. -/
@[kb "weil1973bnt" "Ch. V, §2, Prop. 4 (p. 84), E = k^n, density in the full product"]
theorem weil_V_2_prop4 {L : Submodule (𝓞 K) (Fin n → K)} (hL : IsKLattice K n L) : DenseRange (psiL L) := by
  obtain ⟨m, l, hl⟩ := exists_gen_family hL.1
  have hlL : ∀ j, l j ∈ L := fun j => hl ▸ Submodule.subset_span ⟨j, rfl⟩
  let G : (∀ v : HeightOneSpectrum (𝓞 K), Fin m → v.adicCompletionIntegers K) →
      ∀ v : HeightOneSpectrum (𝓞 K), localLattice L v :=
    fun c v => ⟨lcLocal l v (c v), (mem_localLattice_iff hl v _).mpr ⟨c v, rfl⟩⟩
  have hG : Continuous G :=
    continuous_pi fun v => Continuous.subtype_mk ((continuous_lcLocal l v).comp (continuous_apply v)) _
  have hGs : Function.Surjective G := by
    intro z
    choose c hc using fun v => (mem_localLattice_iff hl v (z v).1).mp (z v).2
    exact ⟨c, funext fun v => Subtype.ext (hc v)⟩
  have hd := hGs.denseRange.comp (denseRange_diag_pow (K := K) m) hG
  refine hd.mono ?_
  rintro _ ⟨a, rfl⟩
  refine ⟨⟨∑ j, a j • l j, Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (hlL j)⟩, ?_⟩
  funext v
  exact Subtype.ext (toLocal_sum l v a)

/-- **Weil, V.§2, Proposition 4**: $\psi_L(L)$ is dense in every partial product $\prod_{v\in T}L_v$. -/
@[kb "weil1973bnt" "Ch. V, §2, Prop. 4 (p. 84), E = k^n, partial products"]
theorem weil_V_2_prop4_partial {L : Submodule (𝓞 K) (Fin n → K)} (hL : IsKLattice K n L)
    (T : Set (HeightOneSpectrum (𝓞 K))) :
    DenseRange (fun l : L => fun v : T => psiL L l v.1) := by
  have hproj : Continuous (fun y : (∀ v : HeightOneSpectrum (𝓞 K), localLattice L v) =>
      fun v : T => y v.1) := continuous_pi fun v => continuous_apply v.1
  have hsurj : Function.Surjective (fun y : (∀ v : HeightOneSpectrum (𝓞 K), localLattice L v) =>
      fun v : T => y v.1) := by
    classical
    intro z
    exact ⟨fun v => if hv : v ∈ T then z ⟨v, hv⟩ else 0, funext fun v => by simp [v.2]⟩
  exact hsurj.denseRange.comp (weil_V_2_prop4 hL) hproj

/-- **Weil, V.§2, Proposition 4**: $L_v$ is the closure of $L$ in $E_v$. -/
@[kb "weil1973bnt" "Ch. V, §2, Prop. 4 (p. 84), E = k^n, closure"]
theorem weil_V_2_prop4_closure {L : Submodule (𝓞 K) (Fin n → K)} (hL : IsKLattice K n L)
    (v : HeightOneSpectrum (𝓞 K)) :
    closure (toLocal v '' (L : Set (Fin n → K))) = (localLattice L v : Set (Fin n → v.adicCompletion K)) := by
  obtain ⟨m, l, hl⟩ := exists_gen_family hL.1
  have hlL : ∀ j, l j ∈ L := fun j => hl ▸ Submodule.subset_span ⟨j, rfl⟩
  apply le_antisymm
  · refine closure_minimal ?_ ?_
    · rintro _ ⟨x, hx, rfl⟩
      exact toLocal_mem_localLattice L v ⟨x, hx⟩
    · have hrange : (localLattice L v : Set (Fin n → v.adicCompletion K)) = Set.range (lcLocal l v) := by
        ext y
        exact mem_localLattice_iff hl v y
      rw [hrange]
      exact (isCompact_range (continuous_lcLocal l v)).isClosed
  · intro y hy
    obtain ⟨c, rfl⟩ := (mem_localLattice_iff hl v y).mp hy
    have hdv : DenseRange (fun a : 𝓞 K => psiIntegers K a v) := by
      classical
      have hs : Function.Surjective (fun y : (∀ w : HeightOneSpectrum (𝓞 K), w.adicCompletionIntegers K) => y v) :=
        fun z => ⟨Function.update (fun w => 0) v z, by simp⟩
      exact hs.denseRange.comp weil_V_2_cor1 (continuous_apply v)
    have hd : DenseRange (fun (a : Fin m → 𝓞 K) (j : Fin m) => psiIntegers K (a j) v) :=
      DenseRange.piMap fun _ => hdv
    have hc : c ∈ closure (Set.range (fun (a : Fin m → 𝓞 K) (j : Fin m) => psiIntegers K (a j) v)) := hd.closure_range ▸ Set.mem_univ c
    refine map_mem_closure (continuous_lcLocal l v) hc ?_
    rintro _ ⟨a, rfl⟩
    exact ⟨∑ j, a j • l j, Submodule.sum_mem _ fun j _ => Submodule.smul_mem _ _ (hlL j), toLocal_sum l v a⟩

end NumberFieldKB.WeilBNT
