/-!
# The unit filtration of $\mathbb Q_p[\zeta_p]$ (for Milne, *CFT*, VIII, Prop. 5.12)

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII, §5, the
paragraph before Proposition 5.12 (p. 248): "If $u \in U_{p+1}$, then $u$ is a $p$th power in $K_\lambda$ (see VII
A.6a). From this, one can deduce that $K_\lambda^\times/K_\lambda^{\times p}$ is freely generated (as an
$\mathbb F_p$-vector space) by the elements $\lambda, \eta_1 = 1 - \lambda, \dots, \eta_p = 1 - \lambda^p$."

**Setting** (abstracting $K_\lambda = \mathbb Q_p[\zeta_p]$): $K$ a nonarchimedean local field with integers
$\mathcal O$ = `𝒪[K]`, $\lambda \in \mathcal O$ a uniformizer (`Irreducible λ`), $p$ prime with
$p = \varepsilon \lambda^{p-1}$ for a unit $\varepsilon$ (total ramification of index $p - 1$), and residue field with
$p$ elements. For $\mathbb Q_p[\zeta_p]$ and $\lambda = 1 - \zeta$ these hold (Milne, p. 248: $p$ is totally ramified
and $(p) = (\lambda)^{p-1}$); conversely a local field of characteristic $0$ with these invariants that contains
$\zeta_p$ is $\mathbb Q_p[\zeta_p]$. $U_k = 1 + \lambda^k\mathcal O$.

## What is formalized
* `exists_pow_eq_one_add`: **$U_{p+1} \subseteq \mathcal O^{p}$** (Milne VII A.6a): $1 + \lambda^{p+1}c = x^p$. Proof:
  with $x = 1 + \lambda y$, $F(y) = ((1 + \lambda y)^p - 1 - \lambda^{p+1}c)/\lambda^p$ is a monic polynomial over
  $\mathcal O$ with $F \equiv y^p + \varepsilon y \pmod{\lambda}$; Hensel at $y = 0$ (Mathlib's
  `HenselianRing`, from `IsAdicComplete 𝓂[K] 𝒪[K]`).
* `exists_mul_eta_pow`: $U_k \cdot \eta_k^m \subseteq U_{k+1}$ for a suitable $m$ (residue field $\mathbb F_p$).
* `mem_closure_eta_mul_pow`: every $u \in U_k$ ($k \ge 1$) is a product of powers of $\eta_k, \dots, \eta_p$ and a
  $p$-th power.
* `IsSteinbergPairing.cond_c`: **condition (c) in full**: a Steinberg pairing is trivial on $U_i \times U_j$ for
  $i + j \ge p + 1$.
* `units_mem_closure_mul_pow`: $K^\times$ is generated by $\lambda, \eta_1, \dots, \eta_p$ and $K^{\times p}$.
* **`steinberg_pairings_eq_of_local`**: two Steinberg pairings of exponent $p$ ($p$ odd) with the same value
  $(\eta_p, \lambda)$ are equal (on all of $K^\times \times K^\times$).
-/

open scoped ValuativeRel
open Polynomial

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]

theorem exists_nat_sub_mem {p : ℕ} (hp : p.Prime) (hres : Nat.card 𝓀[K] = p) (c : 𝒪[K]) :
    ∃ n : ℕ, c - n ∈ 𝓂[K] := by
  have : Fact p.Prime := ⟨hp⟩
  have : Fintype 𝓀[K] := Fintype.ofFinite _
  have hc : Fintype.card 𝓀[K] = p := by rw [← Nat.card_eq_fintype_card]; exact hres
  have : CharP 𝓀[K] p := charP_of_card_eq_prime hc
  let f : ZMod p →+* 𝓀[K] := ZMod.castHom (dvd_refl p) _
  have hsurj : Function.Surjective f := by
    have h2 : Fintype.card (ZMod p) = Fintype.card 𝓀[K] := by rw [ZMod.card, hc]
    exact ((Fintype.bijective_iff_injective_and_card f).2 ⟨f.injective, h2⟩).2
  obtain ⟨n, hn⟩ := hsurj (IsLocalRing.residue 𝒪[K] c)
  refine ⟨n.val, ?_⟩
  rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hn, map_natCast]
  have : f n = ((n.val : ℕ) : 𝓀[K]) := by simp [f]
  rw [this, sub_self]

theorem irr_mem_max {lam : 𝒪[K]} (h : Irreducible lam) : lam ∈ 𝓂[K] :=
  (IsLocalRing.mem_maximalIdeal _).2 h.not_isUnit

/-- **$U_{p+1}$ consists of $p$-th powers** (Milne, *CFT*, VII A.6a; VIII, p. 248): if $p = \varepsilon\lambda^{p-1}$
with $\varepsilon$ a unit and $\lambda \in \mathfrak m$, then $1 + \lambda^{p+1} c$ is a $p$-th power in
$\mathcal O$. -/
theorem exists_pow_eq_one_add {p : ℕ} (hp : p.Prime) {lam ε : 𝒪[K]} (hε : IsUnit ε)
    (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1)) (hlam : lam ∈ 𝓂[K]) (c : 𝒪[K]) :
    ∃ x : 𝒪[K], x ^ p = 1 + lam ^ (p + 1) * c := by
  have hcomp : IsAdicComplete 𝓂[K] 𝒪[K] := by
    let := IsTopologicalAddGroup.rightUniformSpace K
    have : IsUniformAddGroup K := isUniformAddGroup_of_addCommGroup
    infer_instance
  have := IsAdicComplete.henselianRing 𝒪[K] 𝓂[K]
  have hp1 := hp.one_lt
  let m : ℕ → ℕ := fun k => p.choose k / p
  have hm : ∀ k ∈ Finset.Ico 1 p, p.choose k = p * m k := by
    intro k hk
    rw [Finset.mem_Ico] at hk
    exact (Nat.mul_div_cancel' (hp.dvd_choose_self (by omega) hk.2)).symm
  let S : 𝒪[K][X] := ∑ k ∈ Finset.Ico 1 p, C ((m k : 𝒪[K]) * ε * lam ^ (k - 1)) * X ^ k
  let F : 𝒪[K][X] := X ^ p + (S - C (lam * c))
  have hSdeg : S.natDegree ≤ p - 1 := by
    apply natDegree_sum_le_of_forall_le
    intro k hk
    rw [Finset.mem_Ico] at hk
    exact (natDegree_C_mul_X_pow_le _ _).trans (by omega)
  have hFmon : F.Monic := by
    apply monic_X_pow_add
    have h1 : (S - C (lam * c)).natDegree ≤ p - 1 :=
      (natDegree_sub_le _ _).trans (max_le hSdeg (by rw [natDegree_C]; exact Nat.zero_le _))
    calc (S - C (lam * c)).degree ≤ ((p - 1 : ℕ) : WithBot ℕ) := degree_le_of_natDegree_le h1
      _ < p := by exact_mod_cast (by omega : p - 1 < p)
  have hev : ∀ y, F.eval y = y ^ p + (∑ k ∈ Finset.Ico 1 p, (m k : 𝒪[K]) * ε * lam ^ (k - 1) * y ^ k
      - lam * c) := by
    intro y
    simp [F, S, eval_finset_sum]
  have hid : ∀ y : 𝒪[K], (1 + lam * y) ^ p - (1 + lam ^ (p + 1) * c) = lam ^ p * F.eval y := by
    intro y
    rw [hev, add_comm 1 (lam * y), add_pow]
    rw [Finset.sum_range_succ, Finset.range_eq_Ico, Finset.sum_eq_sum_Ico_succ_bot (by omega)]
    have hmid : ∑ k ∈ Finset.Ico 1 p, (lam * y) ^ k * 1 ^ (p - k) * (p.choose k : 𝒪[K]) =
        lam ^ p * ∑ k ∈ Finset.Ico 1 p, (m k : 𝒪[K]) * ε * lam ^ (k - 1) * y ^ k := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      have hk' := Finset.mem_Ico.1 hk
      rw [hm k hk]
      push_cast
      rw [hplam]
      have h : lam ^ k * lam ^ (p - 1) = lam ^ p * lam ^ (k - 1) := by
        rw [← pow_add, ← pow_add]; congr 1; omega
      rw [one_pow, mul_pow]
      linear_combination (y ^ k * (m k : 𝒪[K]) * ε) * h
    rw [hmid]
    simp only [pow_zero, one_pow, mul_one, Nat.choose_zero_right, Nat.cast_one, Nat.sub_zero,
      Nat.choose_self, tsub_self, mul_pow, pow_succ, one_mul, zero_add]
    ring
  have hF0 : F.eval 0 = -(lam * c) := by
    rw [hev, zero_pow (by omega)]
    have : ∑ k ∈ Finset.Ico 1 p, (m k : 𝒪[K]) * ε * lam ^ (k - 1) * (0 : 𝒪[K]) ^ k = 0 := by
      apply Finset.sum_eq_zero
      intro k hk
      rw [zero_pow (by have := Finset.mem_Ico.1 hk; omega), mul_zero]
    rw [this]; ring
  have hF1 : (derivative F).eval 0 = ε := by
    rw [← coeff_zero_eq_eval_zero, coeff_derivative]
    have : F.coeff 1 = ε := by
      simp only [F, S, coeff_add, coeff_sub, coeff_X_pow, finset_sum_coeff, coeff_C_mul, coeff_C]
      rw [if_neg (by omega)]
      rw [Finset.sum_eq_single 1]
      · simp [m, Nat.choose_one_right, Nat.div_self hp.pos]
      · intro b _ hb; simp [Ne.symm hb]
      · intro h; exact absurd (Finset.mem_Ico.2 ⟨le_refl _, hp1⟩) h
    simp [this]
  obtain ⟨a, ha, -⟩ := HenselianRing.is_henselian F hFmon 0
    (by rw [hF0]; exact neg_mem (Ideal.mul_mem_right _ _ hlam)) (by rw [hF1]; exact hε.map _)
  refine ⟨1 + lam * a, ?_⟩
  have := hid a
  rw [ha.eq_zero, mul_zero] at this
  exact sub_eq_zero.1 this


theorem exists_eq_add_of_mem_max {lam : 𝒪[K]} (hlam : Irreducible lam) {a b : 𝒪[K]}
    (h : a - b ∈ 𝓂[K]) : ∃ d, a = b + lam * d := by
  rw [hlam.maximalIdeal_eq, Ideal.mem_span_singleton'] at h
  obtain ⟨d, hd⟩ := h
  exact ⟨d, by linear_combination -hd⟩

theorem step_aux {R : Type*} [CommRing R] (lam : R) (j : ℕ) (n : ℕ) (a : R) :
    ∃ c', (1 + lam ^ (j + 1) * a) * (1 - lam ^ (j + 1)) ^ n =
      1 + lam ^ (j + 1) * (a - n) + lam ^ (j + 1 + 1) * c' := by
  induction n with
  | zero => exact ⟨0, by simp⟩
  | succ n ih =>
    obtain ⟨c', h⟩ := ih
    refine ⟨c' - lam ^ j * (a - n) - lam ^ (j + 1) * c', ?_⟩
    rw [pow_succ (1 - lam ^ (j + 1)) n, ← mul_assoc, h]
    push_cast
    ring

/-- **One step of the filtration** (residue field $\mathbb F_p$, $\lambda$ a uniformizer): for $k \ge 1$ and
$c \in \mathcal O$ there are $m \in \mathbb N$ and $c'$ with $(1 + \lambda^k c)(1 - \lambda^k)^m = 1 + \lambda^{k+1}c'$. -/
theorem exists_mul_eta_pow {p : ℕ} (hp : p.Prime) {lam : 𝒪[K]} (hlam : Irreducible lam)
    (hres : Nat.card 𝓀[K] = p) {k : ℕ} (hk : 1 ≤ k) (c : 𝒪[K]) :
    ∃ (m : ℕ) (c' : 𝒪[K]), (1 + lam ^ k * c) * (1 - lam ^ k) ^ m = 1 + lam ^ (k + 1) * c' := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by omega⟩
  obtain ⟨n, hn⟩ := exists_nat_sub_mem hp hres c
  obtain ⟨d, hd⟩ := exists_eq_add_of_mem_max hlam (b := 0) (a := c - n) (by simpa using hn)
  obtain ⟨c', hc'⟩ := step_aux lam j n c
  refine ⟨n, d + c', ?_⟩
  rw [hc']
  have hd' : c - n = lam * d := by simpa using hd
  have : lam ^ (j + 1) * (c - n) = lam ^ (j + 1 + 1) * d := by rw [hd']; ring
  linear_combination this

theorem coe_lam_ne_zero {lam : 𝒪[K]} (hlam : Irreducible lam) : (lam : K) ≠ 0 := fun h =>
  hlam.ne_zero (Subtype.ext h)

/-- The uniformizer $\lambda$ as an element of $K^\times$. -/
def lamUnit {lam : 𝒪[K]} (hlam : Irreducible lam) : Kˣ := Units.mk0 (lam : K) (coe_lam_ne_zero hlam)

theorem one_sub_pow_ne_zero {lam : 𝒪[K]} (hlam : Irreducible lam) {k : ℕ} (hk : k ≠ 0) :
    1 - (lam : K) ^ k ≠ 0 := by
  intro h
  have h1 : lam ^ k = 1 := Subtype.ext (by
    have := sub_eq_zero.1 h
    simpa using this.symm)
  exact hlam.not_isUnit (IsUnit.of_pow_eq_one h1 hk)

/-- The elements $\eta_k = 1 - \lambda^k$ of $K^\times$ ($k \ge 1$), for a uniformizer $\lambda$; `etaUnit lam k` for
$k = 0$ is $1$ (unused). -/
def etaUnit {lam : 𝒪[K]} (hlam : Irreducible lam) (k : ℕ) : Kˣ :=
  if hk : k = 0 then 1 else
    Units.mk0 (1 - (lam : K) ^ k) (by
      exact one_sub_pow_ne_zero hlam hk)

theorem etaUnit_val {lam : 𝒪[K]} (hlam : Irreducible lam) {k : ℕ} (hk : 1 ≤ k) :
    (etaUnit hlam k : K) = 1 - (lam : K) ^ k := by
  unfold etaUnit
  rw [dif_neg (by omega)]
  rfl

theorem exists_unit_pow_of_mem {p : ℕ} (hp : p.Prime) {lam ε : 𝒪[K]} (hε : IsUnit ε)
    (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1)) (hlam : lam ∈ 𝓂[K]) {k : ℕ} (hk : p + 1 ≤ k) (u : Kˣ)
    (hu : ∃ c : 𝒪[K], (u : K) = 1 + (lam : K) ^ k * c) : ∃ β : Kˣ, β ^ p = u := by
  obtain ⟨c, hc⟩ := hu
  obtain ⟨x, hx⟩ := exists_pow_eq_one_add hp hε hplam hlam (lam ^ (k - (p + 1)) * c)
  have hx' := congrArg (fun z : 𝒪[K] => (z : K)) hx
  push_cast at hx'
  have e : p + 1 + (k - (p + 1)) = k := by omega
  have hxK : (x : K) ^ p = (u : K) := by
    rw [hx', hc, ← mul_assoc, ← pow_add, e]
  have hx0 : (x : K) ≠ 0 := by
    intro h0
    rw [h0, zero_pow hp.ne_zero] at hxK
    exact u.ne_zero hxK.symm
  refine ⟨Units.mk0 (x : K) hx0, ?_⟩
  apply Units.ext
  simpa using hxK

/-- **Every $u \in U_k$ ($k \ge 1$) is a product of powers of $\eta_k, \dots, \eta_p$ and a $p$-th power**
(Milne, p. 248). -/
theorem mem_closure_eta_mul_pow {p : ℕ} (hp : p.Prime) {lam ε : 𝒪[K]} (hlam : Irreducible lam) (hε : IsUnit ε)
    (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1)) (hres : Nat.card 𝓀[K] = p) {k : ℕ} (hk : 1 ≤ k) (u : Kˣ)
    (hu : ∃ c : 𝒪[K], (u : K) = 1 + (lam : K) ^ k * c) :
    ∃ v ∈ Subgroup.closure (etaUnit hlam '' Set.Icc k p), ∃ β : Kˣ, u = v * β ^ p := by
  have hlam' : lam ∈ 𝓂[K] := irr_mem_max hlam
  suffices H : ∀ d k : ℕ, 1 ≤ k → p + 1 ≤ k + d → ∀ u : Kˣ, (∃ c : 𝒪[K], (u : K) = 1 + (lam : K) ^ k * c) →
      ∃ v ∈ Subgroup.closure (etaUnit hlam '' Set.Icc k p), ∃ β : Kˣ, u = v * β ^ p from
    H (p + 1) k hk (by omega) u hu
  intro d
  induction d with
  | zero =>
    intro k hk hkd u hu
    obtain ⟨β, hβ⟩ := exists_unit_pow_of_mem hp hε hplam hlam' (by omega) u hu
    exact ⟨1, Subgroup.one_mem _, β, by rw [hβ, one_mul]⟩
  | succ d ih =>
    intro k hk hkd u hu
    by_cases hkp : p + 1 ≤ k
    · obtain ⟨β, hβ⟩ := exists_unit_pow_of_mem hp hε hplam hlam' hkp u hu
      exact ⟨1, Subgroup.one_mem _, β, by rw [hβ, one_mul]⟩
    · obtain ⟨c, hc⟩ := hu
      obtain ⟨m, c', hmc⟩ := exists_mul_eta_pow hp hlam hres hk c
      have hmcK := congrArg (fun z : 𝒪[K] => (z : K)) hmc
      push_cast at hmcK
      obtain ⟨v', hv', β, hβ⟩ := ih (k + 1) (by omega) (by omega) (u * etaUnit hlam k ^ m) ⟨c', by
        rw [Units.val_mul, Units.val_pow_eq_pow_val, etaUnit_val hlam hk, hc, hmcK]⟩
      have hηmem : etaUnit hlam k ∈ Subgroup.closure (etaUnit hlam '' Set.Icc k p) :=
        Subgroup.subset_closure ⟨k, ⟨le_refl _, by omega⟩, rfl⟩
      refine ⟨v' * (etaUnit hlam k ^ m)⁻¹, Subgroup.mul_mem _ ?_ (Subgroup.inv_mem _ (Subgroup.pow_mem _ hηmem m)),
        β, ?_⟩
      · refine Subgroup.closure_mono (Set.image_mono ?_) hv'
        intro x hx
        exact ⟨by have := hx.1; omega, hx.2⟩
      · have : u = (u * etaUnit hlam k ^ m) * (etaUnit hlam k ^ m)⁻¹ := by simp
        rw [this, hβ]
        exact mul_right_comm _ _ _

theorem pairing_mul_pow {M : Type*} [CommGroup M] {P : Kˣ →* Kˣ →* M} {p : ℕ}
    (hP : IsSteinbergPairing P p) (v β v' β' : Kˣ) : P (v * β ^ p) (v' * β' ^ p) = P v v' := by
  rw [map_mul P v, MonoidHom.mul_apply, (hP.eq_one_of_pow ⟨β, rfl⟩ _).1, mul_one, map_mul (P v),
    (hP.eq_one_of_pow ⟨β', rfl⟩ _).2, mul_one]

theorem pairing_closure_one {M : Type*} [CommGroup M] (P : Kˣ →* Kˣ →* M) (eta : ℕ → Kˣ) (i j p : ℕ)
    (h : ∀ a b, i ≤ a → a ≤ p → j ≤ b → b ≤ p → P (eta a) (eta b) = 1) {v v' : Kˣ}
    (hv : v ∈ Subgroup.closure (eta '' Set.Icc i p)) (hv' : v' ∈ Subgroup.closure (eta '' Set.Icc j p)) :
    P v v' = 1 := by
  induction hv using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    induction hv' using Subgroup.closure_induction with
    | mem y hy =>
      obtain ⟨b, hb, rfl⟩ := hy
      exact h a b ha.1 ha.2 hb.1 hb.2
    | one => simp
    | mul y z _ _ hy hz => rw [map_mul, hy, hz, mul_one]
    | inv y _ hy => rw [map_inv, hy, inv_one]
  | one => simp
  | mul x y _ _ hx hy => rw [map_mul, MonoidHom.mul_apply, hx, hy, mul_one]
  | inv x _ hx => simp [hx]

/-- **Condition (c) of Prop. 5.12 in full** (Milne, *CFT*, VIII, Prop. 5.12 (c), p. 248): a Steinberg pairing of
exponent $p$ ($p$ an odd prime) is trivial on $U_i \times U_j$ for $i, j \ge 1$, $i + j \ge p + 1$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Prop. 5.12 (c), p. 248"]
theorem IsSteinbergPairing.cond_c {M : Type*} [CommGroup M] {P : Kˣ →* Kˣ →* M} {p : ℕ}
    (hP : IsSteinbergPairing P p) (hp : p.Prime) (hp2 : p ≠ 2) {lam ε : 𝒪[K]} (hlam : Irreducible lam)
    (hε : IsUnit ε) (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1)) (hres : Nat.card 𝓀[K] = p) {i j : ℕ} (hi : 1 ≤ i)
    (hj : 1 ≤ j) (hij : p + 1 ≤ i + j) (u w : Kˣ) (hu : ∃ c : 𝒪[K], (u : K) = 1 + (lam : K) ^ i * c)
    (hw : ∃ c : 𝒪[K], (w : K) = 1 + (lam : K) ^ j * c) : P u w = 1 := by
  have hlam' : lam ∈ 𝓂[K] := irr_mem_max hlam
  obtain ⟨v, hv, β, rfl⟩ := mem_closure_eta_mul_pow hp hlam hε hplam hres hi u hu
  obtain ⟨v', hv', β', rfl⟩ := mem_closure_eta_mul_pow hp hlam hε hplam hres hj w hw
  rw [pairing_mul_pow hP]
  have heta : ∀ i, 1 ≤ i → (etaUnit hlam i : K) = 1 - ((lamUnit hlam : Kˣ) : K) ^ i := by
    intro i hi
    rw [etaUnit_val hlam hi]
    rfl
  have hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = etaUnit hlam k := by
    intro k hk
    refine exists_unit_pow_of_mem hp hε hplam hlam' hk _ ⟨-1, ?_⟩
    rw [etaUnit_val hlam (by omega)]
    push_cast
    ring
  have hodd : Odd p := hp.odd_of_ne_two hp2
  exact pairing_closure_one P (etaUnit hlam) i j p
    (fun a b ha hap hb hbp => hP.cond_c_eta heta hodd hpow a b (by omega) (by omega) (by omega)) hv hv'

/-- **$K^\times$ is generated by $\lambda, \eta_1, \dots, \eta_p$ modulo $p$-th powers** (Milne, p. 248). -/
theorem units_mem_closure_mul_pow {p : ℕ} (hp : p.Prime) {lam ε : 𝒪[K]} (hlam : Irreducible lam) (hε : IsUnit ε)
    (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1)) (hres : Nat.card 𝓀[K] = p) (x : Kˣ) :
    ∃ v ∈ Subgroup.closure (insert (lamUnit hlam) (etaUnit hlam '' Set.Icc 1 p)),
      ∃ β : Kˣ, x = v * β ^ p := by
  have hlam' : lam ∈ 𝓂[K] := irr_mem_max hlam
  have : Fintype 𝓀[K] := Fintype.ofFinite _
  have hres' : Fintype.card 𝓀[K] = p := by rw [← Nat.card_eq_fintype_card]; exact hres
  obtain ⟨n, w, hx⟩ := IsDiscreteValuationRing.exists_units_eq_smul_zpow_of_irreducible (K := K) hlam x.ne_zero
  let f : 𝒪[K] →* K := (algebraMap 𝒪[K] K : 𝒪[K] →+* K)
  let w' : Kˣ := Units.map f w
  have hxeq : x = w' * lamUnit hlam ^ n := by
    apply Units.ext
    rw [Units.val_mul, Units.val_zpow_eq_zpow_val, hx, Units.smul_def, Algebra.smul_def]
    simp [lamUnit, w', f]
    rfl
  have hg : ∀ a : Kˣ, a = a ^ p * (a ^ (p - 1))⁻¹ := by
    intro a
    have : a ^ p = a ^ (p - 1) * a := by
      rw [← pow_succ]; congr 1; have := hp.one_lt; omega
    rw [this]; simp
  -- the inverse of w^(p-1) lies in U_1
  let v : 𝒪[K]ˣ := (w ^ (p - 1))⁻¹
  have hne : IsLocalRing.residue 𝒪[K] (w : 𝒪[K]) ≠ 0 := by
    intro h
    rw [IsLocalRing.residue_eq_zero_iff, IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] at h
    exact h w.isUnit
  have hpow1 : IsLocalRing.residue 𝒪[K] (w : 𝒪[K]) ^ (p - 1) = 1 := by
    have := FiniteField.pow_card_sub_one_eq_one _ hne
    rwa [hres'] at this
  have hvw : (v : 𝒪[K]) * (w : 𝒪[K]) ^ (p - 1) = 1 := by
    have := (w ^ (p - 1))⁻¹.inv_mul
    simpa [v, mul_comm] using this
  have hresv : IsLocalRing.residue 𝒪[K] (v : 𝒪[K]) = 1 := by
    have := congrArg (IsLocalRing.residue 𝒪[K]) hvw
    rw [map_mul, map_pow, hpow1, mul_one, map_one] at this
    exact this
  have hv1 : (v : 𝒪[K]) - 1 ∈ 𝓂[K] := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, hresv, map_one, sub_self]
  obtain ⟨d, hd⟩ := exists_eq_add_of_mem_max hlam hv1
  let v' : Kˣ := Units.map f v
  have hv'eq : v' = (w' ^ (p - 1))⁻¹ := by simp only [v', w', v, map_inv, map_pow]
  have hv'K : (v' : K) = 1 + (lam : K) ^ 1 * d := by
    have := congrArg (fun z : 𝒪[K] => (z : K)) hd
    simp only [v', f] at this ⊢
    push_cast at this ⊢
    rw [pow_one]
    exact this
  obtain ⟨v'', hv'', β, hβ⟩ := mem_closure_eta_mul_pow hp hlam hε hplam hres le_rfl v' ⟨d, hv'K⟩
  refine ⟨lamUnit hlam ^ n * v'', Subgroup.mul_mem _ (Subgroup.zpow_mem _
    (Subgroup.subset_closure (Set.mem_insert _ _)) _)
    (Subgroup.closure_mono (Set.subset_insert _ _) hv''), w' * β, ?_⟩
  rw [hxeq]
  conv_lhs => rw [hg w', ← hv'eq, hβ]
  rw [mul_pow]
  ac_rfl

/-- **Prop. 5.12, uniqueness on all of $K^\times$** (Milne, *CFT*, VIII, Prop. 5.12, p. 248): on a local field with
the invariants of $\mathbb Q_p[\zeta_p]$ ($p$ an odd prime, uniformizer $\lambda$, $p = \varepsilon\lambda^{p-1}$,
residue field $\mathbb F_p$), two Steinberg pairings of exponent $p$ with the same value $(\eta_p, \lambda)$ are
equal. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Prop. 5.12, p. 248 (uniqueness on all of K^×)"]
theorem steinberg_pairings_eq_of_local {M : Type*} [CommGroup M] {P P' : Kˣ →* Kˣ →* M} {p : ℕ}
    (hP : IsSteinbergPairing P p) (hP' : IsSteinbergPairing P' p) (hp : p.Prime) (hp2 : p ≠ 2)
    {lam ε : 𝒪[K]} (hlam : Irreducible lam) (hε : IsUnit ε) (hplam : (p : 𝒪[K]) = ε * lam ^ (p - 1))
    (hres : Nat.card 𝓀[K] = p)
    (hval : P (etaUnit hlam p) (lamUnit hlam) =
      P' (etaUnit hlam p) (lamUnit hlam)) :
    P = P' := by
  have hlam' : lam ∈ 𝓂[K] := irr_mem_max hlam
  have heta : ∀ i, 1 ≤ i → (etaUnit hlam i : K) = 1 - ((lamUnit hlam : Kˣ) : K) ^ i := by
    intro i hi
    rw [etaUnit_val hlam hi]
    rfl
  have hpow : ∀ k, p + 1 ≤ k → ∃ β : Kˣ, β ^ p = etaUnit hlam k := by
    intro k hk
    refine exists_unit_pow_of_mem hp hε hplam hlam' hk _ ⟨-1, ?_⟩
    rw [etaUnit_val hlam (by omega)]
    push_cast
    ring
  have hsub : Subgroup.closure (insert (lamUnit hlam) (etaUnit hlam '' Set.Icc 1 p)) ≤
      Subgroup.closure (insert (lamUnit hlam) (etaUnit hlam '' Set.Ici 1)) :=
    Subgroup.closure_mono (Set.insert_subset_insert (Set.image_mono Set.Icc_subset_Ici_self))
  apply MonoidHom.ext
  intro x
  apply MonoidHom.ext
  intro y
  obtain ⟨v, hv, β, rfl⟩ := units_mem_closure_mul_pow hp hlam hε hplam hres x
  obtain ⟨v', hv', β', rfl⟩ := units_mem_closure_mul_pow hp hlam hε hplam hres y
  rw [pairing_mul_pow hP, pairing_mul_pow hP']
  exact steinberg_pairings_eq hP hP' hp hp2 heta hpow hval v (hsub hv) v' (hsub hv')

end NumberFieldKB.MilneCFT.Ch8
