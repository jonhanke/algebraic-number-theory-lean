import QuadFormsKB.Tamagawa.Measure.Weil.BaseChangeLocalConst
import QuadFormsKB.Citation

/-!
# Weil, *Basic Number Theory*, III.§4, Thm. 4 (finite places, number fields)

$k'/k$ is an extension of number fields (`K/k`), $v$ a finite place of $k$, $w$ ranges over the places of $k'$ above
$v$ (QuadFormsKB's `underPlace w = v`), $\lambda_w:k'\to k'_w$ the natural injection and $k_v\to k'_w$ the local map
(QuadFormsKB's `localRingHom`, the restriction of the global base change of finite adeles).

* **`weil_III_4_thm4`**: Thm. 4, first assertion: $k'\otimes_kk_v\cong\bigoplus_{w\mid v}k'_w$ as rings, by
  $x\otimes c\mapsto(\lambda_w(x)c)_w$.
* **`weil_III_4_thm4_integral`**: Thm. 4, second assertion: for a basis $\alpha$ of $k'$ over $k$ and almost all $v$,
  this isomorphism maps the $r_v$-module generated by $\alpha$ onto $\bigoplus_{w\mid v}r'_w$.

QuadFormsKB proves the additive version in coordinates (`localBaseChange`, `range_localBaseChange`, idempotent route,
no valuation comparison); here it is packaged in Weil's form. The infinite places and Cor. 3–4 of Thm. 4 are not
formalized here.
-/

open IsDedekindDomain NumberField
open QuadFormsKB.Tamagawa.Measure.Weil
open scoped TensorProduct

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {k K : Type} [Field k] [NumberField k] [Field K] [NumberField K] [Algebra k K]

/-- The places of $k'$ above the finite place $v$ of $k$. -/
abbrev PlacesAbove (v : HeightOneSpectrum (𝓞 k)) : Type :=
  {w : HeightOneSpectrum (𝓞 K) // underPlace (k := k) w = v}

/-- Every element of $K\otimes_kk_v$ is $\sum_ib_i\otimes c_i$ for a basis $b$ of $K$ over $k$. -/
theorem exists_sum_tmul_basis {ι : Type} [Fintype ι] (b : Module.Basis ι k K) (v : HeightOneSpectrum (𝓞 k))
    (t : K ⊗[k] v.adicCompletion k) :
    ∃ c : ι → v.adicCompletion k, t = ∑ i, b i ⊗ₜ[k] c i := by
  induction t using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp⟩
  | tmul x a =>
    refine ⟨fun i => b.repr x i • a, ?_⟩
    simp_rw [← TensorProduct.smul_tmul]
    rw [← TensorProduct.sum_tmul, b.sum_repr]
  | add t t' ht ht' =>
    obtain ⟨c, rfl⟩ := ht
    obtain ⟨c', rfl⟩ := ht'
    exact ⟨c + c', by simp [TensorProduct.tmul_add, Finset.sum_add_distrib]⟩

@[kb "weil1973bnt" "Ch. III, §4, Thm. 4, first assertion (finite places, number fields)"]
theorem weil_III_4_thm4 (v : HeightOneSpectrum (𝓞 k)) :
    ∃ Φ : K ⊗[k] v.adicCompletion k ≃+* ((w : PlacesAbove (K := K) v) → w.1.adicCompletion K),
      ∀ (x : K) (c : v.adicCompletion k) (w : PlacesAbove (K := K) v),
        Φ (x ⊗ₜ c) w = (x : w.1.adicCompletion K) * localRingHom v w.1 w.2 c := by
  classical
  let b := Module.finBasis k K
  letI : Algebra k ((w : PlacesAbove (K := K) v) → w.1.adicCompletion K) :=
    (RingHom.pi fun w : PlacesAbove (K := K) v =>
      (algebraMap K (w.1.adicCompletion K)).comp (algebraMap k K)).toAlgebra
  let fK : K →ₐ[k] ((w : PlacesAbove (K := K) v) → w.1.adicCompletion K) :=
    { RingHom.pi (fun w : PlacesAbove (K := K) v => algebraMap K (w.1.adicCompletion K)) with
      commutes' := fun r => rfl }
  let fv : v.adicCompletion k →ₐ[k] ((w : PlacesAbove (K := K) v) → w.1.adicCompletion K) :=
    { RingHom.pi (fun w : PlacesAbove (K := K) v => localRingHom v w.1 w.2) with
      commutes' := fun r => by
        funext w
        exact localRingHom_algebraMap v w.1 w.2 r }
  let Φ₀ := Algebra.TensorProduct.productMap fK fv
  have hΦ : ∀ (x : K) (c : v.adicCompletion k) (w : PlacesAbove (K := K) v),
      Φ₀ (x ⊗ₜ c) w = (x : w.1.adicCompletion K) * localRingHom v w.1 w.2 c := by
    intro x c w
    rw [Algebra.TensorProduct.productMap_apply_tmul]
    rfl
  have hψ : ∀ c : Fin (Module.finrank k K) → v.adicCompletion k,
      Φ₀ (∑ i, b i ⊗ₜ[k] c i) = localPi b v c := by
    intro c
    funext w
    rw [map_sum, Finset.sum_apply, localPi_apply]
    exact Finset.sum_congr rfl fun i _ => hΦ _ _ w
  have hbij : Function.Bijective Φ₀.toRingHom := by
    constructor
    · intro t t' h
      obtain ⟨c, rfl⟩ := exists_sum_tmul_basis b v t
      obtain ⟨c', rfl⟩ := exists_sum_tmul_basis b v t'
      have h1 : localPi b v c = localPi b v c' := by
        rw [← hψ, ← hψ]; exact h
      rw [localPi_injective b v h1]
    · intro y
      obtain ⟨c, hc⟩ := localPi_surjective b v y
      exact ⟨∑ i, b i ⊗ₜ[k] c i, by
        show Φ₀ _ = y
        rw [hψ, hc]⟩
  exact ⟨RingEquiv.ofBijective Φ₀.toRingHom hbij, hΦ⟩

/-- Thm. 4, second assertion: for almost all $v$, $(c_i)\mapsto(\sum_i\lambda_w(b_i)c_i)_w$ maps $r_v^n$ onto
$\prod_{w\mid v}r'_w$ (in coordinates of the basis $b$). -/
@[kb "weil1973bnt" "Ch. III, §4, Thm. 4, second assertion (finite places, number fields)"]
theorem weil_III_4_thm4_integral {ι : Type} [Fintype ι] (b : Module.Basis ι k K) :
    ∀ᶠ v in Filter.cofinite, ∀ y : (w : PlacesAbove (K := K) v) → w.1.adicCompletion K,
      (∀ w, y w ∈ w.1.adicCompletionIntegers K) ↔
        ∃ c : ι → v.adicCompletion k, (∀ i, c i ∈ v.adicCompletionIntegers k) ∧
          ∀ w, y w = ∑ i, ((b i : K) : w.1.adicCompletion K) * localRingHom v w.1 w.2 (c i) := by
  classical
  -- a nonzero integer `a` with `a • b i` integral for all `i`
  obtain ⟨a, ha0, ha⟩ := exists_int_isIntegral_mul_basis b
  have ha0' : (a : k) ≠ 0 := by exact_mod_cast ha0
  let b' : Module.Basis ι k K := b.unitsSMul (fun _ => Units.mk0 (a : k) ha0')
  have hb'i : ∀ i, b' i = (a : k) • b i := fun i => by
    simp only [b', Module.Basis.unitsSMul_apply]; rfl
  have hb' : ∀ i, IsIntegral ℤ (b' i) := fun i => by
    rw [hb'i, Algebra.smul_def, map_intCast]
    exact ha i
  -- good places
  have E1 : ∀ᶠ v : HeightOneSpectrum (𝓞 k) in Filter.cofinite, v.valuation k (Algebra.discr k b') = 1 := by
    rw [Filter.eventually_cofinite]
    refine (finite_valuation_ne_one (Algebra.discr k b') (Algebra.discr_not_zero_of_basis k b')).subset ?_
    intro v hv
    exact hv
  have E2 : ∀ᶠ v : HeightOneSpectrum (𝓞 k) in Filter.cofinite, ∀ w : HeightOneSpectrum (𝓞 K), underPlace (k := k) w = v →
      ∀ i, w.valuation K (b i) ≤ 1 := by
    rw [Filter.eventually_cofinite]
    have hS : {w : HeightOneSpectrum (𝓞 K) | ∃ i, ¬ w.valuation K (b i) ≤ 1}.Finite := by
      have : {w : HeightOneSpectrum (𝓞 K) | ∃ i, ¬ w.valuation K (b i) ≤ 1} ⊆
          ⋃ i, {w : HeightOneSpectrum (𝓞 K) | w.valuation K (b i) ≠ 1} := by
        intro w ⟨i, hi⟩
        exact Set.mem_iUnion.mpr ⟨i, fun h => hi h.le⟩
      exact (Set.finite_iUnion fun i => finite_valuation_ne_one (b i) (b.ne_zero i)).subset this
    refine (hS.image (underPlace (k := k))).subset ?_
    intro v hv
    simp only [Set.mem_setOf_eq, not_forall] at hv
    obtain ⟨w, hw, i, hi⟩ := hv
    exact ⟨w, ⟨i, hi⟩, hw⟩
  filter_upwards [E1, E2] with v hd hint y
  have key : ∀ (c' : ι → v.adicCompletion k) (w : PlaceSet (K := K) v),
      localPi b' v c' w = ∑ i, ((b i : K) : w.1.adicCompletion K) *
        localRingHom v w.1 w.2 (algebraMap k (v.adicCompletion k) (a : k) * c' i) := by
    intro c' w
    rw [localPi_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    have hφ : localRingHom v w.1 w.2 (algebraMap k (v.adicCompletion k) (a : k)) =
        ((algebraMap k K (a : k) : K) : w.1.adicCompletion K) :=
      localRingHom_algebraMap v w.1 w.2 _
    rw [map_mul, hφ, hb'i, Algebra.smul_def]
    have : ((algebraMap k K (a : k) * b i : K) : w.1.adicCompletion K) =
        ((algebraMap k K (a : k) : K) : w.1.adicCompletion K) * ((b i : K) : w.1.adicCompletion K) :=
      map_mul (algebraMap K (w.1.adicCompletion K)) _ _
    rw [this]; ring
  constructor
  · intro hy
    have hy' : (y : PlaceProd (K := K) v) ∈ intPlace (K := K) v := fun w =>
      (HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp (hy w)
    rw [← localPi_image_integers b' v hb' hd] at hy'
    obtain ⟨c', hc', hcy⟩ := hy'
    refine ⟨fun i => algebraMap k (v.adicCompletion k) (a : k) * c' i, fun i => ?_, fun w => ?_⟩
    · rw [HeightOneSpectrum.mem_adicCompletionIntegers, map_mul]
      have h1 : Valued.v (algebraMap k (v.adicCompletion k) (a : k)) ≤ 1 := by
        have e : Valued.v (algebraMap k (v.adicCompletion k) (a : k)) = v.valuation k (a : k) :=
          HeightOneSpectrum.valuedAdicCompletion_eq_valuation' (K := k) v (a : k)
        rw [e]
        have : (a : k) = ((a : 𝓞 k) : k) := by simp
        rw [this]
        exact v.valuation_le_one _
      calc _ ≤ 1 * 1 := mul_le_mul' h1 (hc' i)
        _ = 1 := one_mul 1
    · rw [← hcy, key]
  · rintro ⟨c, hc, hyc⟩ w
    rw [HeightOneSpectrum.mem_adicCompletionIntegers, hyc w]
    refine Valuation.map_sum_le _ fun i _ => ?_
    rw [map_mul]
    have h1 : Valued.v ((b i : K) : w.1.adicCompletion K) ≤ 1 := by
      have : Valued.v ((b i : K) : w.1.adicCompletion K) = w.1.valuation K (b i) :=
        HeightOneSpectrum.valuedAdicCompletion_eq_valuation' (K := K) w.1 (b i)
      rw [this]
      exact hint w.1 w.2 i
    calc _ ≤ 1 * 1 := mul_le_mul' h1
          (localRingHom_valued_le_one v w.1 w.2 _
            ((HeightOneSpectrum.mem_adicCompletionIntegers _ _ _).mp (hc i)))
      _ = 1 := one_mul 1

end NumberFieldKB.WeilBNT
