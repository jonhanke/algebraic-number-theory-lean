import NumberFieldKB.WeilBNT.KLatticesLocalGlobal
import NumberFieldKB.WeilBNT.StandardCharacter

/-!
# Weil, *Basic Number Theory*, IV.§2, Corollary 3 of Theorem 3, for $E=E'=k^n$ and the standard character

$k$ is a number field (`K`), $E=k^n$, and $E'=k^n$ is identified with the algebraic dual of $E$ by
$[x,y]=\sum_ix_iy_i$ (Weil, IV.§2 text p. 65, in coordinates). $\chi$ is the standard character `chiA` of
$k_{\mathbb A}$ and $\chi_v$ its component at the finite place $v$ (`chiAtFinite`, `StandardCharacter.lean`).

**Cor. 3 of Thm. 3** (p. 70): if $e\subset E$, $e'\subset E'$ are finite sets generating $E$, $E'$ over $k$, then for
almost all $v$ the $r_v$-module $e'_v$ generated by $e'$ is the dual of $e_v$, i.e.
$e'_v=\{y\in E'_v:\chi_v([x,y])=1\text{ for all }x\in e_v\}$. The $\mathfrak r$-module generated by such a set is a
$k$-lattice, and $e_v$ is its $r_v$-module $L_v$, so we state it for $k$-lattices $L$, $L'$
(`weil_IV_2_thm3_cor3`).

*Proof* (Weil's): for almost all $v$, $L_v=L'_v=r_v^n$ (V.§2 Thm. 2, "only if" direction, applied against
$\mathfrak r^n$: `finite_of_localLattice_eq`) and $\chi_v$ has order $0$ (Cor. 1, `weil_IV_2_thm3_cor1_order`); then the
dual of $r_v^n$ is $r_v^n$.

Weil's Cor. 3 precedes V.§2 in the book; it only uses that $e_v=r_v^n$ for almost all $v$, which is elementary, and
we take it from Thm. 2 because that is where it is proved here.
-/

open IsDedekindDomain NumberField Filter Topology

noncomputable section

namespace NumberFieldKB.WeilBNT

variable {K : Type} [Field K] [NumberField K] {n : ℕ}

/-- $(\mathfrak r^n)_v=r_v^n$. -/
theorem coe_localLattice_intVec (v : HeightOneSpectrum (𝓞 K)) :
    (localLattice (intVec K n) v : Set (Fin n → v.adicCompletion K)) = intLocal v := by
  apply Set.Subset.antisymm
  · intro y hy; exact localLattice_subset_intLocal le_rfl v hy
  · intro z hz
    have hz' : z = ∑ i, z i • (Pi.single i 1 : Fin n → v.adicCompletion K) := by
      funext j; simp [Finset.sum_apply, Pi.single_apply]
    rw [SetLike.mem_coe, hz']
    refine Submodule.sum_mem _ fun i _ => ?_
    have hi : z i • (Pi.single i 1 : Fin n → v.adicCompletion K) =
        (⟨z i, hz i⟩ : v.adicCompletionIntegers K) • toLocal v (Pi.single i 1 : Fin n → K) := by
      rw [toLocal_single]; rfl
    rw [hi]
    exact Submodule.smul_mem _ _ (toLocal_mem_localLattice (intVec K n) v
      ⟨_, Submodule.subset_span ⟨i, rfl⟩⟩)

/-- The dual of an $r_v$-module $N\subset E_v$ for $[x,y]=\sum_ix_iy_i$ and $\chi_v$. -/
def dualLocal (v : HeightOneSpectrum (𝓞 K)) (N : Set (Fin n → v.adicCompletion K)) :
    Set (Fin n → v.adicCompletion K) :=
  {y | ∀ x ∈ N, chiAtFinite K v (∑ i, x i * y i) = 1}

/-- If $\chi_v$ has order $0$, the dual of $r_v^n$ is $r_v^n$. -/
theorem dualLocal_intLocal {v : HeightOneSpectrum (𝓞 K)}
    (hv : {y : v.adicCompletion K | ∀ x : v.adicCompletion K, Valued.v x ≤ 1 → chiAtFinite K v (x * y) = 1} =
      {y | Valued.v y ≤ 1}) :
    dualLocal v (intLocal (n := n) v) = intLocal v := by
  have h1 : ∀ z : v.adicCompletion K, Valued.v z ≤ 1 → chiAtFinite K v z = 1 := by
    intro z hz
    have : (1 : v.adicCompletion K) ∈ {y : v.adicCompletion K | ∀ x : v.adicCompletion K, Valued.v x ≤ 1 →
        chiAtFinite K v (x * y) = 1} := by
      rw [hv]; simp
    simpa using this z hz
  ext y
  constructor
  · intro hy i
    have hmem : y i ∈ {y : v.adicCompletion K | ∀ x : v.adicCompletion K, Valued.v x ≤ 1 →
        chiAtFinite K v (x * y) = 1} := by
      intro t ht
      have hx : (Pi.single i t : Fin n → v.adicCompletion K) ∈ intLocal v := by
        intro j
        by_cases hj : j = i
        · subst hj; rw [Pi.single_eq_same]; exact ht
        · simp [hj]
      have := hy _ hx
      simpa [Pi.single_apply] using this
    rw [hv] at hmem
    exact hmem
  · intro hy x hx
    apply h1
    exact sum_mem fun i _ => mul_mem (hx i) (hy i)

/-- **Weil, IV.§2, Corollary 3 of Theorem 3** (p. 70), for $E=E'=k^n$, $[x,y]=\sum_ix_iy_i$ and the standard
character: for $k$-lattices $L\subset E$, $L'\subset E'$, the dual of $L_v$ is $L'_v$ for almost all finite $v$. -/
@[kb "weil1973bnt" "Ch. IV, §2, Cor. 3 of Thm. 3 (p. 70), E = k^n, standard character, number field case"]
theorem weil_IV_2_thm3_cor3 {L L' : Submodule (𝓞 K) (Fin n → K)} (hL : IsKLattice K n L)
    (hL' : IsKLattice K n L') :
    {v : HeightOneSpectrum (𝓞 K) |
      dualLocal v (localLattice L v : Set (Fin n → v.adicCompletion K)) ≠ localLattice L' v}.Finite := by
  have h0 := weil_IV_2_thm3_cor1_order (K := K)
  have hA : {v : HeightOneSpectrum (𝓞 K) | localLattice (intVec K n) v ≠ localLattice L v}.Finite :=
    finite_of_localLattice_eq (Mloc := localLattice (intVec K n)) hL isKLattice_intVec fun _ => rfl
  have hB : {v : HeightOneSpectrum (𝓞 K) | localLattice (intVec K n) v ≠ localLattice L' v}.Finite :=
    finite_of_localLattice_eq (Mloc := localLattice (intVec K n)) hL' isKLattice_intVec fun _ => rfl
  refine ((h0.union hA).union hB).subset fun v hv => ?_
  by_contra hnot
  simp only [Set.mem_union, Set.mem_ofPred_eq, not_or, not_not] at hnot
  obtain ⟨⟨h0v, hAv⟩, hBv⟩ := hnot
  apply hv
  rw [← hAv, ← hBv, coe_localLattice_intVec]
  exact dualLocal_intLocal h0v

end NumberFieldKB.WeilBNT
