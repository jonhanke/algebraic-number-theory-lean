import NumberFieldKB.ModularCurves.CuspScale
import NumberFieldKB.TauCetiPort.NumberTheory.ModularForms.CongruenceSubgroups.Cusp.Label

/-!
# The number of cusps of $X_0(N)$

J. S. Milne, *Elliptic Curves* (`milne2006ec`), Ch. V, §2 (pdf p. 196). By `CuspScale.lean`,
$N \sum_{P' \mid \infty} f(P') = \sum_c \gcd(N, a_c^2)$, the sum over the $\mu$ cosets $c = \gamma\Gamma_0(N)$, with
$a_c = \gcd(N, r)$ for the lower left entry $r$ of $\gamma^{-1}$. This file evaluates the sum:
$$\sum_c \gcd(N, a_c^2) = N \sum_{g \mid N} \varphi(\gcd(g, N/g)),$$
so the number of geometric cusps of $X_0(N)$ is $\nu_\infty = \sum_{g \mid N} \varphi(\gcd(g, N/g))$
(`geomCount_infty_eq`).

The cosets are grouped by the label of $\gamma^{-1}$ (Tau Ceti's `TauCeti.gamma0CuspLabel`: the divisor
$\gcd(r, N)$ and a unit modulo $\gcd(g, N/g)$). Two cosets have the same label exactly when they lie in one orbit of
$T = \begin{pmatrix} 1 & 1 \\ 0 & 1 \end{pmatrix}$ acting on the left (`cosetLabel_eq_iff`), the stabilizer of $c$
is generated by $T^{w}$ with $w = N/\gcd(N, a_c^2)$ (`T_zpow_smul_eq_self_iff`), so each label class has $w$
elements, each contributing $\gcd(N, a_c^2) = N / w$; and every label occurs (`cosetLabel_surjective`).
-/

open Matrix Matrix.SpecialLinearGroup CongruenceSubgroup ModularGroup MulAction
open scoped MatrixGroups

noncomputable section

namespace NumberFieldKB.ModularCurves

/-! ### Arithmetic -/

/-- $N \mid xj \iff N \mid \gcd(N, x) j$. -/
theorem dvd_mul_iff_dvd_gcd_mul (N : ℕ) (x j : ℤ) :
    (N : ℤ) ∣ x * j ↔ (N : ℤ) ∣ (Int.gcd N x : ℤ) * j := by
  constructor
  · intro h
    have := Int.dvd_coe_gcd (dvd_mul_right (N : ℤ) j) h
    rw [Int.gcd_mul_right, Nat.cast_mul, Int.natCast_natAbs, ← abs_of_nonneg (Int.natCast_nonneg (Int.gcd N x)),
      ← abs_mul, dvd_abs] at this
    exact this
  · intro h
    exact h.trans (mul_dvd_mul_right (Int.gcd_dvd_right _ _) j)

/-- $\gcd(N, x^2) = \gcd(N, \gcd(N, x)^2)$. -/
theorem gcd_sq_eq (N x : ℕ) : Nat.gcd N (x ^ 2) = Nat.gcd N (Nat.gcd N x ^ 2) := by
  apply Nat.dvd_antisymm
  · refine Nat.dvd_gcd (Nat.gcd_dvd_left _ _) ?_
    rw [sq, sq]
    exact Nat.gcd_mul_right_dvd_mul_gcd N x x
  · exact Nat.dvd_gcd (Nat.gcd_dvd_left _ _)
      ((Nat.gcd_dvd_right _ _).trans (pow_dvd_pow_of_dvd (Nat.gcd_dvd_right _ _) 2))

/-! ### The lower left entry of $\delta T^j \delta'^{-1}$ -/

theorem lowerLeft_mul_T_zpow_mul_inv (δ δ' : SL(2, ℤ)) (j : ℤ) :
    (δ * T ^ j * δ'⁻¹) 1 0 = δ 1 0 * δ' 1 1 - δ' 1 0 * δ 1 1 - j * δ 1 0 * δ' 1 0 := by
  simp only [coe_mul, coe_inv, coe_T_zpow, adjugate_fin_two, Matrix.mul_apply, Fin.sum_univ_two, of_apply,
    cons_val', cons_val_zero, cons_val_one, empty_val', cons_val_fin_one]
  ring

variable (N : ℕ) [NeZero N]

theorem mem_Gamma0_iff_dvd' (A : SL(2, ℤ)) : A ∈ Gamma0 N ↔ (N : ℤ) ∣ A 1 0 := by
  rw [Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd]

/-- **Equal labels**: $\delta$ and $\delta'$ have the same label iff $\delta T^j \delta'^{-1} \in \Gamma_0(N)$ for
some $j$. -/
theorem gamma0CuspLabel_eq_iff_exists_mem (δ δ' : SL(2, ℤ)) :
    TauCeti.gamma0CuspLabel N δ = TauCeti.gamma0CuspLabel N δ' ↔ ∃ j : ℤ, δ * T ^ j * δ'⁻¹ ∈ Gamma0 N := by
  rw [TauCeti.gamma0CuspLabel_eq_iff_exists_dvd]
  constructor
  · rintro ⟨j, hj⟩
    refine ⟨-j, ?_⟩
    rw [mem_Gamma0_iff_dvd', lowerLeft_mul_T_zpow_mul_inv]
    convert hj using 1
    ring
  · rintro ⟨j, hj⟩
    refine ⟨-j, ?_⟩
    rw [mem_Gamma0_iff_dvd', lowerLeft_mul_T_zpow_mul_inv] at hj
    convert hj using 1
    ring

/-! ### Labels of cosets -/

/-- The label of the coset $c = \gamma\Gamma_0(N)$: that of $\gamma^{-1}$ (`cosetMat N c`). -/
def cosetLabel (c : Cosets N) : Σ g : N.divisors, (ZMod (Nat.gcd g (N / g)))ˣ :=
  TauCeti.gamma0CuspLabel N (cosetMat N c)

theorem coe_cosetLabel_fst (c : Cosets N) : ((cosetLabel N c).1 : ℕ) = cosetA N c := by
  rw [cosetLabel, TauCeti.coe_gamma0CuspLabel_fst, cosetA, cuspA, Int.gcd_comm]
  rfl

theorem cosetMat_mk (γ : SL(2, ℤ)) : ∃ h ∈ Gamma0 N, cosetMat N (QuotientGroup.mk γ) = h * γ⁻¹ := by
  have := QuotientGroup.out_eq' (s := Gamma0 N) (QuotientGroup.mk γ)
  rw [QuotientGroup.eq] at this
  exact ⟨_, this, by rw [cosetMat]; group⟩

theorem cosetLabel_mk (γ : SL(2, ℤ)) : cosetLabel N (QuotientGroup.mk γ) = TauCeti.gamma0CuspLabel N γ⁻¹ := by
  obtain ⟨h, hh, he⟩ := cosetMat_mk N γ
  rw [cosetLabel, he, gamma0CuspLabel_eq_iff_exists_mem]
  exact ⟨0, by simpa using hh⟩

/-- **Same label iff same $T$-orbit.** -/
theorem cosetLabel_eq_iff (c c' : Cosets N) :
    cosetLabel N c = cosetLabel N c' ↔ ∃ j : ℤ, T ^ j • c' = c := by
  induction c using QuotientGroup.induction_on with | H γ =>
  induction c' using QuotientGroup.induction_on with | H γ' =>
  rw [cosetLabel_mk, cosetLabel_mk, gamma0CuspLabel_eq_iff_exists_mem]
  refine exists_congr fun j => ?_
  rw [MulAction.Quotient.smul_mk, eq_comm, QuotientGroup.eq, inv_inv, smul_eq_mul, ← mul_assoc]

/-- Every label is the label of a coset. -/
theorem cosetLabel_surjective : Function.Surjective (cosetLabel N) := by
  intro ℓ
  obtain ⟨γ, rfl⟩ := TauCeti.gamma0CuspLabel_surjective ℓ
  exact ⟨QuotientGroup.mk γ⁻¹, by rw [cosetLabel_mk, inv_inv]⟩

/-! ### The stabilizer of a coset -/

/-- The width $N / \gcd(N, a_c^2)$. -/
def cosetWidth (c : Cosets N) : ℕ := N / cuspGcd N c

theorem cosetWidth_mul_cuspGcd (c : Cosets N) : cosetWidth N c * cuspGcd N c = N :=
  Nat.div_mul_cancel (Nat.gcd_dvd_left _ _)

theorem cosetWidth_pos (c : Cosets N) : 0 < cosetWidth N c :=
  Nat.div_pos (Nat.le_of_dvd (Nat.pos_of_ne_zero (NeZero.ne N)) (Nat.gcd_dvd_left _ _)) (cuspGcd_pos N c)

/-- **The stabilizer of $c$ in $\langle T\rangle$**: $T^j c = c$ iff $N \mid \gcd(N, a_c^2) j$. -/
theorem T_zpow_smul_eq_self_iff (c : Cosets N) (j : ℤ) :
    T ^ j • c = c ↔ (N : ℤ) ∣ (cuspGcd N c : ℤ) * j := by
  have hc : c = QuotientGroup.mk (cosetMat N c)⁻¹ := by rw [cosetMat, inv_inv, QuotientGroup.out_eq']
  conv_lhs => rw [hc]
  rw [MulAction.Quotient.smul_mk, QuotientGroup.eq, smul_eq_mul, _root_.mul_inv_rev, inv_inv, mul_assoc,
    ← mul_assoc _ _ (cosetMat N c)⁻¹, ← _root_.zpow_neg, mem_Gamma0_iff_dvd',
    lowerLeft_mul_T_zpow_mul_inv]
  have e : cosetMat N c 1 0 * cosetMat N c 1 1 - cosetMat N c 1 0 * cosetMat N c 1 1 -
      -j * cosetMat N c 1 0 * cosetMat N c 1 0 = cosetMat N c 1 0 ^ 2 * j := by ring
  rw [e, dvd_mul_iff_dvd_gcd_mul, Int.gcd, Int.natAbs_natCast, Int.natAbs_pow, gcd_sq_eq]
  rfl

theorem T_zpow_smul_eq_self_iff_width (c : Cosets N) (j : ℤ) :
    T ^ j • c = c ↔ (cosetWidth N c : ℤ) ∣ j := by
  have h : (N : ℤ) = (cosetWidth N c : ℤ) * cuspGcd N c := by exact_mod_cast (cosetWidth_mul_cuspGcd N c).symm
  rw [T_zpow_smul_eq_self_iff, h, mul_comm (cuspGcd N c : ℤ) j,
    mul_dvd_mul_iff_right (by exact_mod_cast (cuspGcd_pos N c).ne')]

/-! ### Orbits of $T$ -/

/-- **The $T$-orbit of a coset is its label class.** -/
theorem mem_orbit_T_iff (c c' : Cosets N) :
    c' ∈ orbit (Subgroup.zpowers T) c ↔ cosetLabel N c' = cosetLabel N c := by
  rw [cosetLabel_eq_iff, MulAction.mem_orbit_iff]
  constructor
  · rintro ⟨⟨g, hg⟩, rfl⟩
    obtain ⟨k, rfl⟩ := Subgroup.mem_zpowers_iff.1 hg
    exact ⟨k, rfl⟩
  · rintro ⟨k, rfl⟩
    exact ⟨⟨T ^ k, Subgroup.zpow_mem_zpowers T k⟩, rfl⟩

theorem minimalPeriod_T (c : Cosets N) : Function.minimalPeriod (T • ·) c = cosetWidth N c := by
  have hper : ∀ n : ℕ, Function.IsPeriodicPt (T • ·) n c ↔ cosetWidth N c ∣ n := by
    intro n
    rw [Function.IsPeriodicPt, Function.IsFixedPt, smul_iterate, ← zpow_natCast,
      T_zpow_smul_eq_self_iff_width, Int.natCast_dvd_natCast]
  apply Nat.dvd_antisymm
  · exact ((hper _).2 dvd_rfl).minimalPeriod_dvd
  · exact (hper _).1 (Function.isPeriodicPt_minimalPeriod _ _)

/-- **Each label class has $N / \gcd(N, a_c^2)$ elements.** -/
theorem card_orbit_T (c : Cosets N) [Fintype (orbit (Subgroup.zpowers T) c)] :
    Fintype.card (orbit (Subgroup.zpowers T) c) = cosetWidth N c := by
  rw [← minimalPeriod_eq_card, minimalPeriod_T]

/-! ### The sum over the cosets -/

instance neZero_gcd_divisors (g : N.divisors) : NeZero (Nat.gcd g (N / g)) :=
  ⟨Nat.gcd_ne_zero_left (Nat.pos_of_mem_divisors g.2).ne'⟩

theorem cuspGcd_eq_of_cosetLabel_eq {c c' : Cosets N} (h : cosetLabel N c = cosetLabel N c') :
    cuspGcd N c = cuspGcd N c' := by
  have := congrArg (fun ℓ => (ℓ.1 : ℕ)) h
  simp only [coe_cosetLabel_fst] at this
  rw [cuspGcd, cuspGcd, this]

/-- **The sum over the cosets**: $\sum_c \gcd(N, a_c^2) = N \sum_{g \mid N}\varphi(\gcd(g, N/g))$. -/
theorem sum_cuspGcd :
    ∑ c, cuspGcd N c = N * ∑ g ∈ N.divisors, Nat.totient (Nat.gcd g (N / g)) := by
  classical
  rw [← Finset.sum_fiberwise Finset.univ (cosetLabel N) (cuspGcd N)]
  have hfib : ∀ ℓ, ∑ c ∈ Finset.univ.filter (fun c => cosetLabel N c = ℓ), cuspGcd N c = N := by
    intro ℓ
    obtain ⟨c₀, rfl⟩ := cosetLabel_surjective N ℓ
    have hset : Finset.univ.filter (fun c => cosetLabel N c = cosetLabel N c₀) =
        (orbit (Subgroup.zpowers T) c₀).toFinset := by
      ext c
      simp [mem_orbit_T_iff]
    rw [Finset.sum_congr rfl fun c hc => cuspGcd_eq_of_cosetLabel_eq N (Finset.mem_filter.1 hc).2,
      Finset.sum_const, hset, Set.toFinset_card, card_orbit_T, smul_eq_mul, cosetWidth_mul_cuspGcd]
  rw [Finset.sum_congr rfl fun ℓ _ => hfib ℓ, Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_comm,
    Fintype.card_sigma, ← Finset.sum_coe_sort N.divisors]
  congr 1
  refine Finset.sum_congr rfl fun g _ => ?_
  rw [ZMod.card_units_eq_totient]

/-- **The number of cusps of $X_0(N)$** (Milne V §2, the cusp count in the genus formula): the geometric number of
places of $\mathbb Q(X_0(N))$ over the cusp of $X(1)$ is $\nu_\infty = \sum_{g \mid N} \varphi(\gcd(g, N/g))$. -/
theorem geomCount_infty_eq :
    geomCount N (TauCeti.Place.infty ℚ) = ∑ g ∈ N.divisors, Nat.totient (Nat.gcd g (N / g)) := by
  have h := mul_geomCount_infty_eq_sum_gcd N
  rw [sum_cuspGcd] at h
  exact Nat.eq_of_mul_eq_mul_left (Nat.pos_of_ne_zero (NeZero.ne N)) h

end NumberFieldKB.ModularCurves
