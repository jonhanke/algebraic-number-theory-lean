import NumberFieldKB.ModularCurves.HeckeTrace
import NumberFieldKB.ModularCurves.AtkinLehner

/-!
# Hecke operators commute on $\mathbb Q(X_0(N))$

J. S. Milne, *Elliptic Curves* (`milne2006ec`), Ch. V, §4 (pdf p. 205). For distinct primes $p, q$ the operators
$T(p)$ and $T(q)$ on the function field $\mathbb Q(X_0(N))$ commute (`heckeOnFunctions_comm`). The proof is
algebraic. With $M = pqN$,
$$T(p)T(q)f = \operatorname{Tr}_{X_0(pN)/X_0(N)}\,\iota_p\,\operatorname{Tr}_{X_0(qN)/X_0(N)}\,\iota_q f
  = \operatorname{Tr}_{X_0(M)/X_0(N)}\,\iota_{pq} f,$$
which is symmetric in $p, q$. The middle step moves $\iota_p$ past a trace (`degeneracy_trace_coprime`): the square
$\mathbb Q(X_0(N)) \to \mathbb Q(X_0(qN))$, $\mathbb Q(X_0(pN)) \to \mathbb Q(X_0(M))$ is a base change, because
$\mathbb Q(X_0(M))$ is generated by $j$ and $j_M$ (`X0.subfield_eq_top`) and the degrees agree:
$(\Gamma_0(pN):\Gamma_0(pqN)) = (\Gamma_0(N):\Gamma_0(qN))$ (`relIndex_gamma0_coprime`, from
$\Gamma_0(N) = \Gamma_0(pN)\Gamma_0(qN)$, `exists_gamma0_cover`). The trace commutes with such a base change
(`trace_algHom_eq_of_adjoin`, general). Degeneracy maps compose (`degeneracy_comp`).
-/

open TensorProduct

namespace NumberFieldKB.ModularCurves

/-- **Trace and base change.** Let $K \to L$ be finite and $K \to K' \to L'$. Let $\iota : L \to L'$ be a
$K$-algebra map whose image generates $L'$ over $K'$, with $[L':K'] = [L:K]$ (so $L' = K' \otimes_K L$). Then
$\operatorname{Tr}_{L'/K'}(\iota x) = \operatorname{Tr}_{L/K}(x)$. -/
theorem trace_algHom_eq_of_adjoin {K L K' L' : Type*} [Field K] [Field L] [Field K'] [Field L']
    [Algebra K L] [Algebra K K'] [Algebra K' L'] [Algebra K L'] [IsScalarTower K K' L']
    [FiniteDimensional K L] (ι : L →ₐ[K] L') (hadj : Algebra.adjoin K' (Set.range ι) = ⊤)
    (hrank : Module.finrank K' L' = Module.finrank K L) (x : L) :
    Algebra.trace K' L' (ι x) = algebraMap K K' (Algebra.trace K L x) := by
  classical
  let e : K' ⊗[K] L →ₗ[K'] L' := ι.toLinearMap.liftBaseChange K'
  have hspan : Submodule.span K' (Set.range ι) = ⊤ := by
    have h1 := Algebra.adjoin_eq_span K' (Set.range ι)
    have hc : (Submonoid.closure (Set.range ι) : Set L') = Set.range ι := by
      have : Set.range ι = ((MonoidHom.mrange (ι : L →* L')) : Set L') := by ext; simp
      rw [this, Submonoid.closure_eq]
    rw [hc, hadj, Algebra.top_toSubmodule] at h1
    exact h1.symm
  have hsurj : Function.Surjective e := by
    rw [← LinearMap.range_eq_top, eq_top_iff, ← hspan, Submodule.span_le]
    rintro _ ⟨y, rfl⟩
    exact ⟨1 ⊗ₜ y, by simp [e]⟩
  have : FiniteDimensional K' L' := Module.Finite.of_surjective e hsurj
  have hinj : Function.Injective e :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      (by rw [Module.finrank_baseChange, hrank])).2 hsurj
  let E := LinearEquiv.ofBijective e ⟨hinj, hsurj⟩
  have hcomm : (Algebra.lmul K' L' (ι x)).comp e =
      e.comp ((Algebra.lmul K L x).baseChange K') := by
    apply TensorProduct.AlgebraTensorModule.ext
    intro a y
    simp [e]
  have hconj : Algebra.lmul K' L' (ι x) = E.conj ((Algebra.lmul K L x).baseChange K') := by
    apply LinearMap.ext
    intro w
    obtain ⟨v, rfl⟩ := hsurj w
    rw [LinearEquiv.conj_apply, LinearMap.comp_apply, LinearMap.comp_apply]
    have hv : (E.symm : L' →ₗ[K'] K' ⊗[K] L) (e v) = v := E.symm_apply_apply v
    rw [hv]
    exact LinearMap.congr_fun hcomm v
  rw [Algebra.trace_apply, Algebra.trace_apply]
  change LinearMap.trace K' L' (Algebra.lmul K' L' (ι x)) = _
  rw [hconj, LinearMap.trace_conj', LinearMap.trace_baseChange]


/-- If $H \le L$ and every $g \in L$ is $hk$ ($h \in H$, $k \in K$), then $(H : H \cap K) = (L : L \cap K)$. -/
theorem relIndex_eq_of_cover {G : Type*} [Group G] {H L K : Subgroup G} (hHL : H ≤ L)
    (hcov : ∀ g ∈ L, ∃ h ∈ H, h⁻¹ * g ∈ K) : K.relIndex H = K.relIndex L := by
  unfold Subgroup.relIndex Subgroup.index
  apply Nat.card_congr
  refine Equiv.ofBijective (Quotient.map' (Subgroup.inclusion hHL) ?_) ⟨?_, ?_⟩
  · intro a b hab
    rw [QuotientGroup.leftRel_apply] at hab ⊢
    simpa [Subgroup.mem_subgroupOf] using hab
  · intro x y hxy
    induction x using QuotientGroup.induction_on
    induction y using QuotientGroup.induction_on
    rename_i a b
    simp only [Quotient.map'_mk''] at hxy
    rw [QuotientGroup.eq] at hxy ⊢
    simpa [Subgroup.mem_subgroupOf] using hxy
  · intro y
    induction y using QuotientGroup.induction_on
    rename_i g
    obtain ⟨h, hh, hk⟩ := hcov g g.2
    refine ⟨QuotientGroup.mk ⟨h, hh⟩, ?_⟩
    simp only [Quotient.map'_mk'']
    rw [QuotientGroup.eq]
    simpa [Subgroup.mem_subgroupOf] using hk

open CongruenceSubgroup in
theorem gamma0_mul_eq_inf {p q N : ℕ} (hN : N ≠ 0) (hpq : Nat.Coprime p q) :
    Gamma0 (p * (q * N)) = Gamma0 (p * N) ⊓ Gamma0 (q * N) := by
  ext A
  simp only [Subgroup.mem_inf, Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd]
  push_cast
  constructor
  · rintro h
    exact ⟨dvd_trans ⟨q, by ring⟩ h, dvd_trans ⟨p, by ring⟩ h⟩
  · rintro ⟨⟨a, ha⟩, ⟨b, hb⟩⟩
    have hN' : (N : ℤ) ≠ 0 := by exact_mod_cast hN
    have hab : (q : ℤ) * b = p * a := by
      apply mul_left_cancel₀ hN'
      linear_combination ha - hb
    have hpb : (p : ℤ) ∣ b := by
      have : (p : ℤ) ∣ q * b := ⟨a, hab⟩
      exact (Int.isCoprime_iff_gcd_eq_one.2 (by simpa [Int.gcd_natCast_natCast] using hpq)).dvd_of_dvd_mul_left this
    obtain ⟨c, rfl⟩ := hpb
    exact ⟨c, by rw [hb]; ring⟩

open CongruenceSubgroup MatrixGroups in
theorem exists_gamma0_cover {p q N : ℕ} (hp : p.Prime) (hpq : Nat.Coprime p q) (g : SL(2, ℤ))
    (hg : g ∈ Gamma0 N) : ∃ h ∈ Gamma0 (p * N), h⁻¹ * g ∈ Gamma0 (q * N) := by
  rw [Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd] at hg
  obtain ⟨c', hc'⟩ := hg
  have hpZ : Prime (p : ℤ) := Nat.prime_iff_prime_int.1 hp
  have hdet : g 0 0 * g 1 1 - g 0 1 * g 1 0 = 1 := by
    have := g.2
    rw [Matrix.det_fin_two] at this
    exact this
  set u : ℤ := if (p : ℤ) ∣ g 1 1 then 1 else 0 with hu
  have hd' : ¬ (p : ℤ) ∣ g 1 0 * u + g 1 1 := by
    intro hdiv
    by_cases h11 : (p : ℤ) ∣ g 1 1
    · simp only [hu, h11, ite_true, mul_one] at hdiv
      have h10 : (p : ℤ) ∣ g 1 0 := by simpa using dvd_sub hdiv h11
      have : (p : ℤ) ∣ 1 := by
        rw [← hdet]
        exact dvd_sub (dvd_mul_of_dvd_right h11 _) (dvd_mul_of_dvd_right h10 _)
      exact hpZ.not_dvd_one this
    · simp [hu, h11] at hdiv
  have hq : ¬ (p : ℤ) ∣ q := by
    intro hdiv
    have : p ∣ q := by exact_mod_cast hdiv
    exact hp.one_lt.ne' (Nat.Coprime.eq_one_of_dvd hpq this)
  have hcop : IsCoprime ((g 1 0 * u + g 1 1) * q) (p : ℤ) := by
    refine IsCoprime.symm ?_
    rw [Prime.coprime_iff_not_dvd hpZ]
    intro hdiv
    rcases hpZ.dvd_or_dvd hdiv with h | h
    · exact hd' h
    · exact hq h
  obtain ⟨x, y, hxy⟩ := hcop
  set m : ℤ := q * N * (-c' * x) with hm
  let δ : SL(2, ℤ) := ⟨!![1 + u * m, u; m, 1], by rw [Matrix.det_fin_two_of]; ring⟩
  have hδ : δ ∈ Gamma0 (q * N) := by
    rw [Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd]
    exact ⟨-c' * x, by simp [δ, hm]⟩
  refine ⟨g * δ, ?_, ?_⟩
  · rw [Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd]
    refine ⟨c' * y, ?_⟩
    have e : (g * δ) 1 0 = g 1 0 * (1 + u * m) + g 1 1 * m := by
      rw [Matrix.SpecialLinearGroup.coe_mul]
      simp [δ, Matrix.mul_apply, Fin.sum_univ_two]
    rw [e, hm]
    push_cast
    linear_combination hc' - (↑N * c') * hxy
  · rw [mul_inv_rev, mul_assoc, inv_mul_cancel, mul_one]
    exact (Gamma0 (q * N)).inv_mem hδ

open CongruenceSubgroup in
theorem relIndex_gamma0_coprime {p q N : ℕ} (hN : N ≠ 0) (hp : p.Prime) (hpq : Nat.Coprime p q) :
    (Gamma0 (p * (q * N))).relIndex (Gamma0 (p * N)) = (Gamma0 (q * N)).relIndex (Gamma0 N) := by
  rw [gamma0_mul_eq_inf hN hpq, Subgroup.inf_relIndex_left]
  refine relIndex_eq_of_cover ?_ fun g hg => exists_gamma0_cover hp hpq g hg
  intro A hA
  rw [Gamma0_mem, ZMod.intCast_zmod_eq_zero_iff_dvd] at hA ⊢
  exact dvd_trans ⟨p, by push_cast; ring⟩ hA

end NumberFieldKB.ModularCurves

open UpperHalfPlane hiding I
open Polynomial Filter Complex Topology
open scoped Manifold MatrixGroups Real

namespace NumberFieldKB.ModularCurves

open NumberFieldKB.MilneEC.V

variable {N M : ℕ} [NeZero N] [NeZero M]

theorem toGerm_degeneracy_x0Frac {d : ℕ} (h : d * N ∣ M) {P Q : ℚ[X][X]} {f : ℍ → ℂ}
    (hQ : evalJJNRat N Q ≠ 0) (hf : ∀ z, f z * evalJJNRat N Q z = evalJJNRat N P z) :
    toGerm M (degeneracy N M d h (x0Frac N P Q)) = germ (fun z => f (ofComplex ((d : ℂ) * (z : ℂ)))) := by
  have hd : 1 ≤ d := one_le_of_dvd (dvd_trans (dvd_mul_right d N) h)
  let ψ : X0 N →+* HGerm := (toGerm M).comp (degeneracy N M d h)
  have hx : ψ (jX0 (prop2_4' N)) = germ (jN d) := toGerm_degeneracy_jX0 h
  have hy : ψ (jNX0 (prop2_4' N)) = germ (jN (d * N)) := toGerm_degeneracy_jNX0 h
  have hG : ∀ G : ℚ[X][X], ψ (coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ G)) =
      germ (fun z => evalJJNRat N G (ofComplex ((d : ℂ) * (z : ℂ)))) := by
    intro G
    rw [coordToX0_eq_eval₂, ringHom_eval₂_aeval ψ hx hy]
    congr 1
    funext z
    rw [evalJJNRat_ofComplex_mul hd]
  have hQ0 : coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ Q) ≠ 0 := by
    intro h0
    have := toGerm_coordToX0 (N := N) Q
    rw [h0, map_zero] at this
    exact hQ ((germ_eq_zero_iff (mdifferentiable_evalJJNHom _ (Nat.one_le_iff_ne_zero.mpr (NeZero.ne N)) Q)).1
      this.symm)
  have hu : IsUnit (ψ (coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ Q))) :=
    (IsUnit.mk0 _ ((map_ne_zero (degeneracy N M d h)).2 hQ0)).map (toGerm M)
  have hmul : x0Frac N P Q * coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ Q) =
      coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ P) := div_mul_cancel₀ _ hQ0
  have h2 := congrArg ψ hmul
  rw [map_mul, hG P] at h2
  have h3 : germ (fun z => evalJJNRat N P (ofComplex ((d : ℂ) * (z : ℂ)))) =
      germ (fun z => f (ofComplex ((d : ℂ) * (z : ℂ)))) * ψ (coordToX0 (prop2_4' N) (Ideal.Quotient.mk _ Q)) := by
    rw [hG Q, ← Filter.Germ.coe_mul]
    congr 1
    funext z
    exact (hf _).symm
  rw [h3] at h2
  exact hu.mul_left_inj.1 h2

/-- $\iota_d(j_e) = j_{de}$. -/
theorem toGerm_degeneracy_jNElt {d e : ℕ} (h : d * N ∣ M) (he : e ∣ N) :
    toGerm M (degeneracy N M d h (jNElt N e he)) = germ (jN (d * e)) := by
  have hd : 1 ≤ d := one_le_of_dvd (dvd_trans (dvd_mul_right d N) h)
  have he1 : 1 ≤ e := one_le_of_dvd he
  rw [jNElt, toGerm_degeneracy_x0Frac h (exists_rat_jN_of_dvd he).choose_spec.choose_spec.1
    (exists_rat_jN_of_dvd he).choose_spec.choose_spec.2]
  congr 1
  funext z
  rw [jN_ofComplex_mul hd he1]

/-- **Composition of degeneracy maps**: $(z \mapsto d'z) \circ (z \mapsto dz) = (z \mapsto d'dz)$. -/
theorem degeneracy_comp {N' d d' D : ℕ} [NeZero N'] (h1 : d * N ∣ N') (h2 : d' * N' ∣ M) (h : D * N ∣ M)
    (hD : d' * d = D) :
    (degeneracy N' M d' h2).comp (degeneracy N N' d h1) = degeneracy N M D h := by
  apply X0.ringHom_ext <;> apply toGerm_injective (N := M) <;> rw [RingHom.comp_apply]
  · rw [degeneracy_jX0, toGerm_degeneracy_jNElt, toGerm_degeneracy_jX0, hD]
  · rw [degeneracy_jNX0, toGerm_degeneracy_jNElt, toGerm_degeneracy_jNX0, ← hD, mul_assoc]

/-- **$\mathbb Q(X_0(M))$ is generated by $j$ and $j_M$**: a subfield containing both is everything. -/
theorem X0.subfield_eq_top (F : Subfield (X0 M)) (hj : jX0 (prop2_4' M) ∈ F)
    (hjM : jNX0 (prop2_4' M) ∈ F) : F = ⊤ := by
  have hpoly : ∀ G : ℚ[X][X], coordToX0 (prop2_4' M) (Ideal.Quotient.mk _ G) ∈ F := by
    intro G
    rw [coordToX0_eq_eval₂]
    induction G using Polynomial.induction_on' with
    | add p q hp hq => rw [eval₂_add]; exact add_mem hp hq
    | monomial n a =>
      rw [eval₂_monomial]
      refine mul_mem ?_ (pow_mem hjM n)
      change aeval (jX0 (prop2_4' M)) a ∈ F
      induction a using Polynomial.induction_on' with
      | add p q hp hq => rw [map_add]; exact add_mem hp hq
      | monomial k r =>
        rw [aeval_monomial]
        refine mul_mem ?_ (pow_mem hj k)
        rw [eq_ratCast]
        exact SubfieldClass.ratCast_mem F r
  let : Algebra (coordRing (prop2_4' M)) (X0 M) := (coordToX0 (prop2_4' M)).toAlgebra
  have := isFractionRing_coordToX0 (prop2_4' M)
  rw [eq_top_iff]
  intro x _
  obtain ⟨a, b, -, rfl⟩ := IsFractionRing.div_surjective (A := coordRing (prop2_4' M)) x
  obtain ⟨A, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨B, rfl⟩ := Ideal.Quotient.mk_surjective b
  exact div_mem (hpoly A) (hpoly B)

/-! ### $T(p)\,T(q) = T(q)\,T(p)$ -/

section Commute

variable (N p q : ℕ) [NeZero N] [NeZero p] [NeZero q]

omit [NeZero N] [NeZero p] [NeZero q] in
theorem one_mul_pN_dvd : 1 * (p * N) ∣ p * (q * N) := ⟨q, by ring⟩

omit [NeZero N] [NeZero p] [NeZero q] in
theorem pN_dvd : p * N ∣ p * (q * N) := ⟨q, by ring⟩

omit [NeZero N] [NeZero p] [NeZero q] in
theorem one_mul_N_dvd_pqN : 1 * N ∣ p * (q * N) := ⟨p * q, by ring⟩

omit [NeZero N] [NeZero p] [NeZero q] in
theorem pq_mul_N_dvd : p * q * N ∣ p * (q * N) := ⟨1, by ring⟩

/-- **$\iota_p$ moves past the trace** (for $p$ prime, $(p, q) = 1$): $\iota_p \circ \operatorname{Tr}_{X_0(qN)/X_0(N)} =
\operatorname{Tr}_{X_0(pqN)/X_0(pN)} \circ \iota_p$, where $\iota_p$ is $z \mapsto pz$. -/
theorem degeneracy_trace_coprime (hp : p.Prime) (hpq : Nat.Coprime p q) (z : X0 (q * N)) :
    letI := forgetAlgebra N (q * N) (one_mul_dvd_mul N q)
    letI := forgetAlgebra (p * N) (p * (q * N)) (one_mul_pN_dvd N p q)
    degeneracy N (p * N) p dvd_rfl (Algebra.trace (X0 N) (X0 (q * N)) z) =
      Algebra.trace (X0 (p * N)) (X0 (p * (q * N))) (degeneracy (q * N) (p * (q * N)) p dvd_rfl z) := by
  let := forgetAlgebra N (q * N) (one_mul_dvd_mul N q)
  let := forgetAlgebra (p * N) (p * (q * N)) (one_mul_pN_dvd N p q)
  let : Algebra (X0 N) (X0 (p * N)) := (degeneracy N (p * N) p dvd_rfl).toAlgebra
  let : Algebra (X0 N) (X0 (p * (q * N))) := (degeneracy N (p * (q * N)) p (pN_dvd N p q)).toAlgebra
  have : IsScalarTower (X0 N) (X0 (p * N)) (X0 (p * (q * N))) :=
    IsScalarTower.of_algebraMap_eq fun r => (RingHom.congr_fun
      (degeneracy_comp dvd_rfl (one_mul_pN_dvd N p q) (pN_dvd N p q) (one_mul p)) r).symm
  have := finite_forget (N := N) (M := q * N) (one_mul_dvd_mul N q)
  have : Module.Finite (X0 (p * N)) (X0 (p * (q * N))) := finite_forget (one_mul_pN_dvd N p q)
  let ι : X0 (q * N) →ₐ[X0 N] X0 (p * (q * N)) :=
    { degeneracy (q * N) (p * (q * N)) p dvd_rfl with
      commutes' := fun r => RingHom.congr_fun
        (degeneracy_comp (one_mul_dvd_mul N q) dvd_rfl (pN_dvd N p q) (mul_one p)) r }
  have hrank : Module.finrank (X0 (p * N)) (X0 (p * (q * N))) = Module.finrank (X0 N) (X0 (q * N)) := by
    rw [finrank_forget, finrank_forget]
    exact relIndex_gamma0_coprime (NeZero.ne N) hp hpq
  have hadj : Algebra.adjoin (X0 (p * N)) (Set.range ι) = ⊤ := by
    set S := Algebra.adjoin (X0 (p * N)) (Set.range ι)
    have hS : IsField S := Subalgebra.isField_of_algebraic S
    let F := (S.toIntermediateField' hS).toSubfield
    have hj : jX0 (prop2_4' (p * (q * N))) ∈ F := by
      have e : algebraMap (X0 (p * N)) (X0 (p * (q * N))) (jX0 (prop2_4' (p * N))) =
          jX0 (prop2_4' (p * (q * N))) := by
        change degeneracy (p * N) (p * (q * N)) 1 _ _ = _
        rw [degeneracy_jX0, jNElt_one]
      rw [← e]
      exact S.algebraMap_mem _
    have hjM : jNX0 (prop2_4' (p * (q * N))) ∈ F := by
      have e : ι (jNX0 (prop2_4' (q * N))) = jNX0 (prop2_4' (p * (q * N))) := by
        change degeneracy (q * N) (p * (q * N)) p dvd_rfl _ = _
        rw [degeneracy_jNX0, jNElt_self]
      rw [← e]
      exact Algebra.subset_adjoin ⟨_, rfl⟩
    have hF := X0.subfield_eq_top F hj hjM
    rw [eq_top_iff]
    intro x _
    have hx : x ∈ F := by rw [hF]; trivial
    exact hx
  exact (trace_algHom_eq_of_adjoin ι hadj hrank z).symm

/-- **$T(p)\,T(q) = \operatorname{Tr}_{X_0(pqN)/X_0(N)} \circ \iota_{pq}$** for $p$ prime and $(p, q) = 1$. -/
theorem heckeOnFunctions_heckeOnFunctions (hp : p.Prime) (hpq : Nat.Coprime p q) (f : X0 N) :
    letI := forgetAlgebra N (p * (q * N)) (one_mul_N_dvd_pqN N p q)
    heckeOnFunctions N p (heckeOnFunctions N q f) =
      Algebra.trace (X0 N) (X0 (p * (q * N))) (degeneracy N (p * (q * N)) (p * q) (pq_mul_N_dvd N p q) f) := by
  let := forgetAlgebra N (p * N) (one_mul_dvd_mul N p)
  let := forgetAlgebra (p * N) (p * (q * N)) (one_mul_pN_dvd N p q)
  let := forgetAlgebra N (p * (q * N)) (one_mul_N_dvd_pqN N p q)
  let := forgetAlgebra N (q * N) (one_mul_dvd_mul N q)
  have : IsScalarTower (X0 N) (X0 (p * N)) (X0 (p * (q * N))) :=
    IsScalarTower.of_algebraMap_eq fun r => (RingHom.congr_fun
      (degeneracy_comp (one_mul_dvd_mul N p) (one_mul_pN_dvd N p q) (one_mul_N_dvd_pqN N p q) (one_mul 1)) r).symm
  have := finite_forget (N := N) (M := p * N) (one_mul_dvd_mul N p)
  have : Module.Finite (X0 (p * N)) (X0 (p * (q * N))) := finite_forget (one_mul_pN_dvd N p q)
  have e1 : heckeOnFunctions N q f = Algebra.trace (X0 N) (X0 (q * N)) (degeneracy N (q * N) q dvd_rfl f) := rfl
  have e2 : ∀ y, heckeOnFunctions N p y =
      Algebra.trace (X0 N) (X0 (p * N)) (degeneracy N (p * N) p dvd_rfl y) := fun _ => rfl
  rw [e1, e2, degeneracy_trace_coprime N p q hp hpq, Algebra.trace_trace, ← RingHom.comp_apply,
    degeneracy_comp (dvd_rfl) dvd_rfl (pq_mul_N_dvd N p q) rfl]

omit [NeZero p] [NeZero q] in
theorem trace_degeneracy_congr {M M' d d' : ℕ} [NeZero M] [NeZero M'] (hM : M = M') (hd : d = d')
    (h1 : 1 * N ∣ M) (h1' : 1 * N ∣ M') (h : d * N ∣ M) (h' : d' * N ∣ M') (f : X0 N) :
    (letI := forgetAlgebra N M h1; Algebra.trace (X0 N) (X0 M) (degeneracy N M d h f)) =
      (letI := forgetAlgebra N M' h1'; Algebra.trace (X0 N) (X0 M') (degeneracy N M' d' h' f)) := by
  subst hM hd
  rfl

/-- **The Hecke operators commute** (Milne V §4): for distinct primes $p, q$,
$T(p)\,T(q) = T(q)\,T(p)$ on $\mathbb Q(X_0(N))$. -/
@[kb "milne2006ec" "Ch. V, §4, the Hecke operators T(p) commute (running text), pdf p. 205"]
theorem heckeOnFunctions_comm (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) (f : X0 N) :
    heckeOnFunctions N p (heckeOnFunctions N q f) = heckeOnFunctions N q (heckeOnFunctions N p f) := by
  have hcop : Nat.Coprime p q := (Nat.coprime_primes hp hq).2 hpq
  rw [heckeOnFunctions_heckeOnFunctions N p q hp hcop, heckeOnFunctions_heckeOnFunctions N q p hq hcop.symm]
  exact trace_degeneracy_congr N (by ring) (mul_comm p q) _ _ _ _ f

end Commute

