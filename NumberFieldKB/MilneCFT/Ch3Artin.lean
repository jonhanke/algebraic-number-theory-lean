import Mathlib
import QuadFormsKB.Citation
import NumberFieldKB.MilneCFT.Ch3Ramified
import NumberFieldKB.MilneCFT.Ch3TateZero
import NumberFieldKB.MilneCFT.Ch2Cite

/-!
# Milne, *Class Field Theory*, Chapter III §3: the local Artin map

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`.
Locators give Milne's printed page numbers (printed page = pdf page − 9).

* `theorem_3_1` — Theorem 3.1: for $L/K$ finite Galois with group $G$, $H^r_T(G, \mathbb Z) \simeq
  H^{r+2}_T(G, L^\times)$ for all $r$, proved from Tate's theorem (Chapter II, `Thm3_11`, named), Hilbert's
  Theorem 90 for every subgroup and the system of invariant maps of Theorem 2.1 (which makes $H^2(H, L^\times)$
  cyclic of order $|H|$, generated by the fundamental class); `theorem_3_1_ab`, the case $r = -2$:
  $\operatorname{Gal}(L/K)^{\mathrm{ab}} \simeq K^\times/\mathrm{Nm}_{L/K}(L^\times)$. **Deviation:** Milne's isomorphism is
  $x \mapsto x \cup u_{L/K}$; the library has no cup product on Tate cohomology, and `Thm3_11` provides an
  isomorphism attached to the generator $u_{L/K}$ (by Chapter II, Remark 3.13, it is cup product with
  $u_{L/K}$), so the statement records the existence of the isomorphism.
* `theorem_3_4` — Theorem 3.4 in the book's form, from Chapter I's named statement `LocalReciprocityExistence`
  (Chapter I, Theorem 1.1, which is the same theorem; Milne derives it from Theorem 3.1, (3.3) and Proposition 1.9).
* `Thm3_5` — the norm limitation theorem (named statement).
-/

open scoped ValuativeRel

namespace NumberFieldKB.MilneCFT.Ch3

open CategoryTheory Rep groupCohomology Limits NumberFieldKB.MilneCFT NumberFieldKB.MilneCFT.LocalCFT

set_option synthInstance.maxHeartbeats 400000
set_option linter.unusedSectionVars false

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

/-! ## Theorem 3.1 -/

/-- Hilbert's Theorem 90 for $L/L^H$: $H^1(H, L^\times) = 0$ for every subgroup $H$ of
$\operatorname{Gal}(L/K)$ (Milne, Chapter II, 1.22, applied to $L$ over the fixed field of $H$). -/
theorem isZero_h1_res (L : IntermediateField K Ω) [FiniteDimensional K L] (H : Subgroup Gal(L/K)) :
    IsZero (groupCohomology (res H.subtype (Rep.ofAlgebraAutOnUnits K L)) 1) := by
  have := isZero_h1_fixingSubgroup K L (IntermediateField.fixedField H)
  rwa [IntermediateField.fixingSubgroup_fixedField] at this

/-- $H^2(H, L^\times)$ is cyclic of order $|H|$ for every subgroup $H$ of $\operatorname{Gal}(L/K)$ (from the
invariant maps, diagram (28)). -/
theorem h2rel_cyclic (s : InvariantSystem K Ω) (L : IntermediateField K Ω) [FiniteDimensional K L]
    [IsGalois K L] (H : Subgroup Gal(L/K)) :
    IsAddCyclic (H2rel L H) ∧ Nat.card (H2rel L H) = Nat.card H := by
  let e : H2rel L H ≃+ qzOver (Nat.card H) :=
    (AddMonoidHom.ofInjective (s.injective L H)).trans (AddEquiv.addSubgroupCongr (s.range L H))
  refine ⟨?_, ?_⟩
  · have : IsAddCyclic (qzOver (Nat.card H)) := by
      unfold qzOver; infer_instance
    exact isAddCyclic_of_surjective e.symm.toAddMonoidHom e.symm.surjective
  · rw [Nat.card_congr e.toEquiv, card_qzOver _ Nat.card_pos]

/-- The fundamental class $u_{L/K}$ generates $H^2(L/K)$. -/
theorem fundClass_generates (s : InvariantSystem K Ω) (L : IntermediateField K Ω) [FiniteDimensional K L]
    [IsGalois K L] (x : H2 L) : x ∈ AddSubgroup.zmultiples (fundClass s L) := by
  have hx : s.invK L x ∈ qzOver (Module.finrank K L) := by rw [← s.range_top]; exact ⟨x, rfl⟩
  obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.1 hx
  refine AddSubgroup.mem_zmultiples_iff.2 ⟨k, s.injective_top L ?_⟩
  rw [map_zsmul, invK_fundClass, hk]

/-- **Theorem 3.1** (p. 107). For every finite Galois extension of local fields $L/K$ and every $r \in \mathbb Z$,
$H^r_T(\operatorname{Gal}(L/K), \mathbb Z) \simeq H^{r+2}_T(\operatorname{Gal}(L/K), L^\times)$ (Milne: the map
$x \mapsto x \cup u_{L/K}$; see the module docstring for the deviation). Proved, as in Milne ("the pair
$(G, L^\times)$ satisfies the hypotheses of Tate's theorem"), from Tate's theorem (named), Hilbert's Theorem 90 and
the system of invariant maps (Theorem 2.1, named), with $\gamma = u_{L/K}$. -/
@[kb "milne2020cft" "v4.03, Ch. III, Thm. 3.1, p. 107"]
theorem theorem_3_1 (h311 : Thm3_11) (s : InvariantSystem K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] [IsGalois K L] (r : ℤ) :
    Nonempty (tateCohomology (trivial ℤ Gal(L/K) ℤ) r ≅
      tateCohomology (Rep.ofAlgebraAutOnUnits K L) (r + 2)) :=
  h311.iso Gal(L/K) (Rep.ofAlgebraAutOnUnits K L)
    (fun H => ⟨isZero_h1_res L H, h2rel_cyclic s L H⟩) (fundClass s L) (fundClass_generates s L) r

/-- **Theorem 3.1, $r = -2$** (p. 107): $\operatorname{Gal}(L/K)^{\mathrm{ab}} \simeq K^\times/\mathrm{Nm}_{L/K}(L^\times)$,
via $H^{-2}_T(G, \mathbb Z) \simeq H_1(G, \mathbb Z) \simeq G^{\mathrm{ab}}$ (Chapter II, Proposition 2.7) and
$H^0_T(G, L^\times) = K^\times/\mathrm{Nm}(L^\times)$ (`tateZeroUnitsEquiv`). Milne's inverse of this
isomorphism is the local Artin map $\phi_{L/K}$. -/
@[kb "milne2020cft" "v4.03, Ch. III, Thm. 3.1 (r = -2), p. 107"]
theorem theorem_3_1_ab (h311 : Thm3_11) (s : InvariantSystem K Ω) (L : IntermediateField K Ω)
    [FiniteDimensional K L] [IsGalois K L] :
    Nonempty (Additive (Abelianization Gal(L/K)) ≃+ Additive (Kˣ ⧸ normGroup L)) := by
  obtain ⟨e⟩ := theorem_3_1 h311 s L (-2)
  rw [show (-2 : ℤ) + 2 = 0 by norm_num] at e
  obtain ⟨e1⟩ := prop_2_7 Gal(L/K)
  let e2 := (TateCohomology.isoGroupHomology (R := ℤ) (G := Gal(L/K)) (-2) 1 (by norm_num)).app
    (trivial ℤ Gal(L/K) ℤ)
  exact ⟨((e2.symm ≪≫ e).toLinearEquiv.toAddEquiv.symm.trans e1).symm.trans
    (tateZeroUnitsEquiv K L)⟩

/-! ## Theorem 3.4 -/

/-- **Theorem 3.4** (p. 108). For every local field $K$ there is a homomorphism (the local Artin map)
$\phi_K : K^\times \to \operatorname{Gal}(K^{\mathrm{ab}}/K)$ — here a family $\phi_L : K^\times \to
\operatorname{Gal}(L/K)$ over the finite abelian extensions $L$, compatible with restriction (Chapter I's
encoding) — such that (a) for every prime element $\pi$, $\phi_K(\pi)|_{K^{\mathrm{un}}} = \mathrm{Frob}_K$ (on
every finite unramified $L$, $\phi_L(\pi)$ is the Frobenius element); (b) for every finite abelian $L/K$,
$\mathrm{Nm}_{L/K}(L^\times) \subseteq \ker(a \mapsto \phi_K(a)|_L)$ and $\phi_K$ induces an isomorphism
$K^\times/\mathrm{Nm}_{L/K}(L^\times) \to \operatorname{Gal}(L/K)$. Derived here from Chapter I's named statement
`LocalReciprocityExistence` (Chapter I, Theorem 1.1, the same theorem); Milne obtains it from Theorem 3.1, (3.3) and
Proposition 1.9. -/
@[kb "milne2020cft" "v4.03, Ch. III, Thm. 3.4, p. 108"]
theorem theorem_3_4 (h : LocalReciprocityExistence K Ω) :
    ∃ φ : ∀ L : FiniteAbelianExt K Ω, Kˣ →* Gal(L.toField/K),
      (∀ (L L' : FiniteAbelianExt K Ω) (h : L.toField ≤ L'.toField) (a : Kˣ), galRestrict h (φ L' a) = φ L a) ∧
      (∀ {π : 𝒪[K]} (hπ : Irreducible π) (L : FiniteAbelianExt K Ω), IsUnramifiedExt L.toField →
        IsFrobenius L.toField (φ L (primeUnit hπ))) ∧
      ∀ L : FiniteAbelianExt K Ω, normGroup L.toField ≤ (φ L).ker ∧
        ∃ e : Kˣ ⧸ normGroup L.toField ≃* Gal(L.toField/K), ∀ a : Kˣ, e a = φ L a := by
  obtain ⟨φ, hφ⟩ := h.exists_artin
  refine ⟨φ, hφ.compat, fun hπ L hL => hφ.frobenius hπ L hL, fun L => ⟨(hφ.ker_eq L).ge, ?_⟩⟩
  exact ⟨(QuotientGroup.quotientMulEquivOfEq (hφ.ker_eq L).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective (φ L) (hφ.surjective L)), fun a => rfl⟩

/-! ## Theorem 3.5 -/

/-- $E$ is **the largest abelian extension of $K$ contained in $L$**: $E \subseteq L$, $E/K$ is abelian (Galois with
abelian group), and every abelian extension of $K$ inside $L$ is contained in $E$. -/
def IsMaxAbelianSub (L E : IntermediateField K Ω) : Prop :=
  E ≤ L ∧ IsAbelianGalois K E ∧ ∀ E' : IntermediateField K Ω, E' ≤ L → IsAbelianGalois K E' → E' ≤ E

variable (K Ω) in
/-- **Theorem 3.5, norm limitation theorem** (named statement; Milne, p. 108). Let $L$ be a finite extension of
$K$, and let $E$ be the largest abelian extension of $K$ contained in $L$; then $\mathrm{Nm}_{L/K}(L^\times) =
\mathrm{Nm}_{E/K}(E^\times)$. (Milne's proof: for $L/K$ Galois both groups have index $[E:K]$ by Theorem 3.1; in
general, pass to a Galois closure and use the Artin maps of $L'/L$ and $L'/K$.) -/
@[kb "milne2020cft" "v4.03, Ch. III, Thm. 3.5, p. 108 (input)"]
structure Thm3_5 : Prop where
  norm_limitation : ∀ (L E : IntermediateField K Ω) [FiniteDimensional K L] [FiniteDimensional K E],
    IsMaxAbelianSub L E → normGroup L = normGroup E

end NumberFieldKB.MilneCFT.Ch3
