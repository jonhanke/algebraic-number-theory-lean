/-!
# Milne, *Class Field Theory*, Chapter VIII, Corollary 4.3: the relative fundamental exact sequence

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter VIII, §4, Corollary 4.3
(pdf p. 250, printed p. 241). Locators give Milne's printed page numbers (printed page = pdf page − 9).

"For every finite extension $L/K$, the sequence
$$0 \to \mathrm{Br}(L/K) \to \bigoplus_v \mathrm{Br}(L_v/K_v) \xrightarrow{\ \Sigma\ } \tfrac1{n_0}\mathbb Z/\mathbb Z \to 0,
\qquad n_0 = \mathrm{lcm}(n_v),$$
is exact. *Proof.* Apply the snake lemma to the diagram obtained by mapping the fundamental exact sequence for $K$ to
that for $L$." Milne's discussion before Lemma 4.1 (p. 240) is for $L/K$ Galois, where $L_v$ means $L_w$ for any $w \mid v$
and $n_v = [L_w : K_v]$; the corollary is stated here for $L/K$ Galois.

## Formalization

* The local relative Brauer group $\mathrm{Br}(L_v/K_v) \subseteq \mathrm{Br}(K_v)$ (`localRelBr`): the classes split by
  $K_v \otimes_K L$. Since $K_v \otimes_K L \cong \prod_{w \mid v} L_w$, these are the classes split by $L_w$ for every
  $w \mid v$. This avoids completions of $L$ and algebra maps between completions (which the libraries do not provide);
  the price is that comparisons with the Brauer groups of the $L_w$ are not formalized.
* $n_v$ is Chapter VII's `Ch7.localDegree` ($e f$ at a finite prime, $2$ or $1$ at an infinite place). The target
  $\frac1{n_0}\mathbb Z/\mathbb Z$ is the set of $q \in \mathbb Q/\mathbb Z$ killed by every common multiple of the
  $n_v$ (equivalently by their least common multiple, which avoids defining it).
* `Corollary4_3` (named statement): the exact sequence, with local invariants quantified existentially as in
  Chapter IV's `Ch4.Example2_14e` (Theorem 4.2).

## Proved here

* `mem_sum_torsion_iff`: the finite sums of elements $x_v$ with $n_v x_v = 0$ are exactly the $q$ killed by every common
  multiple of the $n_v$ (the subgroup generated by the $\frac1{n_v}\mathbb Z/\mathbb Z$ is $\frac1{n_0}\mathbb Z/\mathbb Z$).
* `image_eq_torsion_of_card`: an injective homomorphism $H \to \mathbb Q/\mathbb Z$ maps a subgroup of order $n$ onto
  $\frac1n\mathbb Z/\mathbb Z$ ($\mathbb Q/\mathbb Z$ has exactly one subgroup of each finite order).
* `corollary4_3_of`: Corollary 4.3 from Theorem 4.2 (`Ch4.Example2_14e K`) and two named local-to-global inputs:
  `LocalRelBrOrder` ($\mathrm{Br}(L_v/K_v)$ is a subgroup of order $n_v$: local class field theory, Milne III and IV §4)
  and `RelativeHasse` (the Hasse principle for $\mathrm{Br}(L)$ read through $K_v \otimes_K L$, i.e. injectivity in
  Theorem 4.2 for $L$ together with $K_v \otimes_K L \cong \prod_{w\mid v} L_w$). This is Milne's snake-lemma argument.
* `corollary4_3_cyclic_target`: for $L/K$ cyclic of degree $n$, the target is $\frac1n\mathbb Z/\mathbb Z$ ($n_0 = n$,
  Lemma 4.1, proved from the Chebotarev density theorem).
-/

open NumberField IsDedekindDomain TensorProduct

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch8

open Ch4

/-! ## Torsion subgroups of $\mathbb Q/\mathbb Z$ -/

theorem qz_split {a b : ℕ} (ha : 0 < a) (_hb : 0 < b) (q : QZ) (h : Nat.lcm a b • q = 0) :
    ∃ u v : QZ, a • u = 0 ∧ b • v = 0 ∧ u + v = q := by
  have hgpos : 0 < Nat.gcd a b := Nat.gcd_pos_of_pos_left _ ha
  have hcop := Nat.coprime_div_gcd_div_gcd hgpos
  set g := Nat.gcd a b with hg
  set a' := a / g with ha'
  set b' := b / g with hb'
  have ha_eq : a = g * a' := (Nat.mul_div_cancel' (Nat.gcd_dvd_left a b)).symm
  have hb_eq : b = g * b' := (Nat.mul_div_cancel' (Nat.gcd_dvd_right a b)).symm
  have hl : Nat.lcm a b = g * a' * b' := by
    have h1 := Nat.gcd_mul_lcm a b
    rw [← hg] at h1
    have h2 : g * Nat.lcm a b = g * (g * a' * b') := by
      rw [h1]; conv_lhs => rw [ha_eq, hb_eq]
      ring
    exact Nat.eq_of_mul_eq_mul_left hgpos h2
  obtain ⟨u', v', huv⟩ := Nat.isCoprime_iff_coprime.2 hcop
  rw [hl] at h
  refine ⟨((v' * b' : ℤ)) • q, ((u' * a' : ℤ)) • q, ?_, ?_, ?_⟩
  · rw [← natCast_zsmul, smul_smul]
    have : ((a:ℤ) * (v' * b')) = v' * ((g * a' * b' : ℕ) : ℤ) := by
      push_cast; rw [ha_eq]; push_cast; ring
    rw [this, mul_smul, natCast_zsmul, h, smul_zero]
  · rw [← natCast_zsmul, smul_smul]
    have : ((b:ℤ) * (u' * a')) = u' * ((g * a' * b' : ℕ) : ℤ) := by
      push_cast; rw [hb_eq]; push_cast; ring
    rw [this, mul_smul, natCast_zsmul, h, smul_zero]
  · rw [← add_smul]
    have : v' * b' + u' * a' = 1 := by linarith
    rw [this, one_smul]

theorem qz_split_finset {ι : Type*} [DecidableEq ι] (n : ι → ℕ) (N : ℕ) (hN : 0 < N)
    (s : Finset ι) (hs : ∀ i ∈ s, n i ∣ N) :
    ∀ q : QZ, s.lcm n • q = 0 → ∃ x : ι → QZ, (∀ i ∈ s, n i • x i = 0) ∧ ∑ i ∈ s, x i = q := by
  induction s using Finset.induction_on with
  | empty =>
    intro q h
    refine ⟨fun _ => 0, by simp, ?_⟩
    simpa using h.symm
  | insert a s has ih =>
    intro q h
    have hs' : ∀ i ∈ s, n i ∣ N := fun i hi => hs i (Finset.mem_insert_of_mem hi)
    have hna : 0 < n a := Nat.pos_of_dvd_of_pos (hs a (Finset.mem_insert_self _ _)) hN
    have hb : 0 < s.lcm n := Nat.pos_of_dvd_of_pos (Finset.lcm_dvd hs') hN
    rw [Finset.lcm_insert] at h
    obtain ⟨u, v, hu, hv, huv⟩ := qz_split hna hb q h
    obtain ⟨x, hx, hxs⟩ := ih hs' v hv
    refine ⟨Function.update x a u, ?_, ?_⟩
    · intro i hi
      rcases Finset.mem_insert.1 hi with rfl | hi
      · simpa using hu
      · have : i ≠ a := fun h => has (h ▸ hi)
        rw [Function.update_of_ne this]; exact hx i hi
    · rw [Finset.sum_insert has, Function.update_self]
      have hcongr : ∑ i ∈ s, Function.update x a u i = ∑ i ∈ s, x i := by
        refine Finset.sum_congr rfl (fun i hi => ?_)
        have hia : i ≠ a := fun h => has (h ▸ hi)
        exact Function.update_of_ne hia u x
      rw [hcongr, hxs, huv]

/-- The finite sums of elements $x_i \in \mathbb Q/\mathbb Z$ with $n_i x_i = 0$ are exactly the elements killed by every
common multiple of the $n_i$, provided the $n_i$ are positive and have a common multiple $N > 0$. -/
theorem mem_sum_torsion_iff {ι : Type*} (n : ι → ℕ) (hn : ∀ i, 0 < n i) (hN : ∃ N, 0 < N ∧ ∀ i, n i ∣ N)
    (q : QZ) :
    (∃ (s : Finset ι) (x : ι → QZ), (∀ i, n i • x i = 0) ∧ ∑ i ∈ s, x i = q) ↔
      ∀ m : ℕ, (∀ i, n i ∣ m) → m • q = 0 := by
  classical
  constructor
  · rintro ⟨s, x, hx, rfl⟩ m hm
    rw [Finset.smul_sum]
    refine Finset.sum_eq_zero fun i _ => ?_
    obtain ⟨k, hk⟩ := hm i
    rw [hk, mul_comm, mul_smul, hx i, smul_zero]
  · intro h
    obtain ⟨N, hNpos, hN⟩ := hN
    have hfinr : (Set.range n).Finite := (Nat.divisors N).finite_toSet.subset (by
      rintro _ ⟨i, rfl⟩
      simp only [Finset.mem_coe, Nat.mem_divisors]
      exact ⟨hN i, hNpos.ne'⟩)
    have hsub : ↑hfinr.toFinset ⊆ n '' (Set.univ : Set ι) := by
      rw [Set.image_univ]; intro y hy; simpa using hy
    obtain ⟨s, -, hs⟩ := Finset.subset_set_image_iff.1 hsub
    have hdvd : ∀ i, n i ∣ s.lcm n := by
      intro i
      have : n i ∈ s.image n := by rw [hs]; simp
      obtain ⟨j, hj, hji⟩ := Finset.mem_image.1 this
      rw [← hji]
      exact Finset.dvd_lcm hj
    obtain ⟨x, hx, hxs⟩ := qz_split_finset n N hNpos s (fun i _ => hN i) q (h _ hdvd)
    refine ⟨s, fun i => if i ∈ s then x i else 0, fun i => ?_, ?_⟩
    · by_cases hi : i ∈ s
      · simp only [hi, if_true]; exact hx i hi
      · simp [hi]
    · rw [← hxs]
      exact Finset.sum_congr rfl (fun i hi => if_pos hi)

/-- $\mathbb Q/\mathbb Z$ has exactly one subgroup of each finite order: an injective homomorphism $f : H \to \mathbb Q/\mathbb Z$
maps a subgroup $S$ of order $n > 0$ onto $\{q : nq = 0\}$. -/
theorem image_eq_torsion_of_card {H : Type*} [AddCommGroup H] (f : H →+ QZ) (hf : Function.Injective f)
    (S : AddSubgroup H) (n : ℕ) (hn : 0 < n) (hS : Nat.card S = n) :
    f '' (S : Set H) = {q : QZ | n • q = 0} := by
  classical
  have hsub : f '' (S : Set H) ⊆ {q : QZ | n • q = 0} := by
    rintro _ ⟨y, hy, rfl⟩
    show n • f y = 0
    rw [← map_nsmul, ← hS]
    have h1 : Nat.card S • (⟨y, hy⟩ : S) = 0 := card_nsmul_eq_zero'
    have h2 := congrArg Subtype.val h1
    simp only [AddSubgroup.coe_nsmul, AddSubgroup.coe_zero] at h2
    rw [h2, map_zero]
  let g : ℕ → QZ := fun k => QuotientAddGroup.mk ((k : ℚ) / n)
  have hnq : (n : ℚ) ≠ 0 := by exact_mod_cast hn.ne'
  have htor : {q : QZ | n • q = 0} ⊆ ↑((Finset.range n).image g) := by
    intro q hq
    obtain ⟨r, rfl⟩ := QuotientAddGroup.mk_surjective q
    have hq' : n • (QuotientAddGroup.mk r : QZ) = 0 := hq
    rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff] at hq'
    obtain ⟨z, hz⟩ := hq'
    have hz' : (z : ℚ) = n * r := by
      have : (Int.castAddHom ℚ) z = n • r := hz
      simpa [nsmul_eq_mul] using this
    have hm0 : 0 ≤ z % (n : ℤ) := Int.emod_nonneg _ (by exact_mod_cast hn.ne')
    have hmn : z % (n : ℤ) < n := Int.emod_lt_of_pos _ (by exact_mod_cast hn)
    simp only [Finset.coe_image, Finset.coe_range, Set.mem_image, Set.mem_Iio]
    refine ⟨(z % (n : ℤ)).toNat, by omega, ?_⟩
    have hk : (((z % (n : ℤ)).toNat : ℕ) : ℚ) = ((z % (n : ℤ) : ℤ) : ℚ) := by
      exact_mod_cast Int.toNat_of_nonneg hm0
    have hdiv : (z : ℚ) = n * ((z / (n : ℤ) : ℤ) : ℚ) + ((z % (n : ℤ) : ℤ) : ℚ) := by
      exact_mod_cast (Int.mul_ediv_add_emod z n).symm
    show QuotientAddGroup.mk (((z % (n : ℤ)).toNat : ℚ) / n) = QuotientAddGroup.mk r
    rw [QuotientAddGroup.eq]
    refine ⟨z / (n : ℤ), ?_⟩
    show (((z / (n : ℤ) : ℤ)) : ℚ) = -(((z % (n : ℤ)).toNat : ℚ) / n) + r
    rw [hk]
    field_simp
    linarith
  have hfin : ((Finset.range n).image g : Set QZ).Finite := Finset.finite_toSet _
  have hcard : {q : QZ | n • q = 0}.ncard ≤ (f '' (S : Set H)).ncard := by
    calc {q : QZ | n • q = 0}.ncard ≤ (((Finset.range n).image g : Finset QZ) : Set QZ).ncard :=
          Set.ncard_le_ncard htor hfin
      _ = ((Finset.range n).image g).card := Set.ncard_coe_finset _
      _ ≤ n := by simpa using Finset.card_image_le (s := Finset.range n) (f := g)
      _ = (f '' (S : Set H)).ncard := by
          rw [Set.ncard_image_of_injective _ hf, ← Nat.card_coe_set_eq]
          exact hS.symm
  exact Set.eq_of_subset_of_ncard_le hsub hcard (hfin.subset htor)

/-! ## The local relative Brauer groups -/

variable (K : Type) [Field K] [NumberField K] (L : Type) [Field L] [NumberField L] [Algebra K L]

/-- A central simple $F$-algebra $A$ is split by the commutative $F$-algebra $R$: $R \otimes_F A \cong M_n(R)$ for some
$n \ge 1$. -/
def SplitsOverRing {F : Type} [Field F] (R : Type) [CommRing R] [Algebra F R] (A : CSA.{0, 0} F) : Prop :=
  ∃ n : ℕ, n ≠ 0 ∧ Nonempty (R ⊗[F] A ≃ₐ[R] Matrix (Fin n) (Fin n) R)

/-- **$\mathrm{Br}(L_v/K_v)$** (Milne, *CFT*, VIII, §4, p. 240), for a field $F \supseteq K$ (a completion $K_v$): the
classes of $\mathrm{Br}(F)$ split by $F \otimes_K L$ ($\cong \prod_{w\mid v} L_w$ when $F = K_v$). -/
@[kb "milne2020cft" "v4.03, Ch. VIII, §4, Br(L_v/K_v), p. 240"]
def localRelBr (F : Type) [Field F] [Algebra K F] : Set (BrauerGroup.{0, 0} F) :=
  {x | ∃ A : CSA.{0, 0} F, BrauerGroup.mk A = x ∧ SplitsOverRing (F ⊗[K] L) A}

variable [IsGalois K L]

/-- The localization $x \mapsto ((x_v)_{v \text{ finite}}, (x_w)_{w \text{ infinite}})$ of Theorem 4.2. -/
def brLoc (x : BrauerGroup.{0, 0} K) :
    (∀ v : HeightOneSpectrum (𝓞 K), BrauerGroup.{0, 0} (v.adicCompletion K)) ×
      (∀ w : InfinitePlace K, BrauerGroup.{0, 0} w.Completion) :=
  ((fun v => baseChange (v.adicCompletion K) x), (fun w => baseChange w.Completion x))

/-- **Corollary 4.3** (named statement; Milne, *CFT*, VIII, Corollary 4.3, p. 241): for a finite Galois extension $L/K$
of number fields,
$0 \to \mathrm{Br}(L/K) \to \bigoplus_v \mathrm{Br}(L_v/K_v) \to \frac1{n_0}\mathbb Z/\mathbb Z \to 0$ is exact, the second
map being the sum of local invariants. As in `Ch4.Example2_14e` the local invariants are quantified existentially
(isomorphisms $\mathrm{Br}(K_v) \cong \mathbb Q/\mathbb Z$ at the finite primes, injections at the infinite places). -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Cor. 4.3, p. 241 (input)"]
structure Corollary4_3 : Prop where
  exact : ∃ (invf : ∀ v : HeightOneSpectrum (𝓞 K),
      Additive (BrauerGroup.{0, 0} (v.adicCompletion K)) →+ QZ)
    (invi : ∀ w : InfinitePlace K, Additive (BrauerGroup.{0, 0} w.Completion) →+ QZ),
    (∀ v, Function.Bijective (invf v)) ∧ (∀ w, Function.Injective (invi w)) ∧
    -- the localization of a class of Br(L/K) has finitely many nonzero components, all in the Br(L_v/K_v)
    (∀ x ∈ relBrauer K L,
      Set.Finite {v : HeightOneSpectrum (𝓞 K) | (brLoc K x).1 v ≠ 1} ∧
      (∀ v, (brLoc K x).1 v ∈ localRelBr K L (v.adicCompletion K)) ∧
      ∀ w, (brLoc K x).2 w ∈ localRelBr K L w.Completion) ∧
    -- exactness at Br(L/K)
    Set.InjOn (brLoc K) (relBrauer K L) ∧
    -- the composite is zero
    (∀ x ∈ relBrauer K L,
      (∑ᶠ v, invf v (Additive.ofMul ((brLoc K x).1 v))) + ∑ w, invi w (Additive.ofMul ((brLoc K x).2 w)) = 0) ∧
    -- exactness in the middle
    (∀ (y : ∀ v : HeightOneSpectrum (𝓞 K), BrauerGroup.{0, 0} (v.adicCompletion K))
        (z : ∀ w : InfinitePlace K, BrauerGroup.{0, 0} w.Completion),
        Set.Finite {v | y v ≠ 1} → (∀ v, y v ∈ localRelBr K L (v.adicCompletion K)) →
        (∀ w, z w ∈ localRelBr K L w.Completion) →
        (∑ᶠ v, invf v (Additive.ofMul (y v))) + ∑ w, invi w (Additive.ofMul (z w)) = 0 →
        ∃ x ∈ relBrauer K L, brLoc K x = (y, z)) ∧
    -- the image of the sum is (1/n₀)ℤ/ℤ
    (∀ q : QZ, (∃ (y : ∀ v : HeightOneSpectrum (𝓞 K), BrauerGroup.{0, 0} (v.adicCompletion K))
        (z : ∀ w : InfinitePlace K, BrauerGroup.{0, 0} w.Completion),
        Set.Finite {v | y v ≠ 1} ∧ (∀ v, y v ∈ localRelBr K L (v.adicCompletion K)) ∧
        (∀ w, z w ∈ localRelBr K L w.Completion) ∧
        (∑ᶠ v, invf v (Additive.ofMul (y v))) + ∑ w, invi w (Additive.ofMul (z w)) = q) ↔
      ∀ m : ℕ, (∀ v, Ch7.localDegree K L v ∣ m) → m • q = 0)

/-- **$\mathrm{Br}(L_v/K_v)$ has order $n_v$** (named statement; Milne, *CFT*, IV, §4 and III: for a finite Galois
extension of local fields of degree $n$, $\mathrm{Br}(L_w/K_v) \cong \frac1n\mathbb Z/\mathbb Z$; at a real place
ramified in $L$, $\mathrm{Br}(\mathbb C/\mathbb R) = \mathrm{Br}(\mathbb R)$ has order 2): the local relative Brauer
group is a subgroup of order the local degree. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, §4, p. 240, Br(L_v/K_v) of order n_v (input)"]
structure LocalRelBrOrder : Prop where
  finite : ∀ v : HeightOneSpectrum (𝓞 K), ∃ S : Subgroup (BrauerGroup.{0, 0} (v.adicCompletion K)),
    (S : Set _) = localRelBr K L (v.adicCompletion K) ∧ Nat.card S = Ch7.localDegree K L (.inr v)
  infinite : ∀ w : InfinitePlace K, ∃ S : Subgroup (BrauerGroup.{0, 0} w.Completion),
    (S : Set _) = localRelBr K L w.Completion ∧ Nat.card S = Ch7.localDegree K L (.inl w)

/-- **The Hasse principle for $\mathrm{Br}(L)$, read over $K$** (named statement; Milne, *CFT*, VIII, Theorem 4.2 for $L$
(injectivity), transported by $K_v \otimes_K L \cong \prod_{w\mid v} L_w$): a class of $\mathrm{Br}(K)$ whose
localizations are split by $K_v \otimes_K L$ for every place $v$ of $K$ is split by $L$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Thm. 4.2 for L, read over K (input)"]
structure RelativeHasse : Prop where
  mem_relBrauer : ∀ x : BrauerGroup.{0, 0} K,
    (∀ v : HeightOneSpectrum (𝓞 K), (brLoc K x).1 v ∈ localRelBr K L (v.adicCompletion K)) →
    (∀ w : InfinitePlace K, (brLoc K x).2 w ∈ localRelBr K L w.Completion) → x ∈ relBrauer K L

theorem fin_ef_dvd (v : HeightOneSpectrum (𝓞 K)) (Q : v.asIdeal.primesOver (𝓞 L)) :
    Q.1.ramificationIdx (𝓞 K) * Q.1.inertiaDeg (𝓞 K) ∣ Module.finrank K L := by
  have hid := Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn v.asIdeal (𝓞 L) Gal(L/K)
  haveI := Q.2.1
  haveI := Q.2.2
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx v.asIdeal Q.1 Gal(L/K),
    Ideal.inertiaDegIn_eq_inertiaDeg v.asIdeal Q.1 Gal(L/K),
    IsGaloisGroup.card_eq_finrank Gal(L/K) K L] at hid
  exact Dvd.intro_left _ hid

/-- The local degrees of a Galois extension divide the global degree. -/
theorem localDegree_dvd_finrank (v : InfinitePlace K ⊕ HeightOneSpectrum (𝓞 K)) :
    Ch7.localDegree K L v ∣ Module.finrank K L := by
  rcases v with w | v
  · simp only [Ch7.localDegree]
    by_cases h : InfinitePlace.RamifiesIn L w
    · rw [if_pos h]
      obtain ⟨hr, w', hw', hc⟩ := h
      have hn : ¬ w'.IsUnramified K :=
        (InfinitePlace.not_isUnramified_iff).2 ⟨hc, by rw [hw']; exact hr⟩
      exact (InfinitePlace.even_finrank_of_not_isUnramified hn).two_dvd
    · rw [if_neg h]; exact one_dvd _
  · simp only [Ch7.localDegree]
    exact fin_ef_dvd K L v _

/-- The local degrees are positive. -/
theorem localDegree_pos (v : InfinitePlace K ⊕ HeightOneSpectrum (𝓞 K)) : 0 < Ch7.localDegree K L v := by
  rcases v with w | v
  · simp only [Ch7.localDegree]
    split_ifs <;> norm_num
  · simp only [Ch7.localDegree]
    set Q := Classical.arbitrary (v.asIdeal.primesOver (𝓞 L))
    haveI := Q.2.1
    haveI := Q.2.2
    exact Nat.mul_pos (Q.1.ramificationIdx_pos (𝓞 K)) (Q.1.inertiaDeg_pos (𝓞 K))

theorem local_torsion {G : Type*} [CommGroup G] (f : Additive G →+ QZ) (hf : Function.Injective f)
    (T : Set G) (S : Subgroup G) (hSeq : (S : Set G) = T) (n : ℕ) (hn : 0 < n) (hS : Nat.card S = n) :
    (∀ g, g ∈ T ↔ n • f (Additive.ofMul g) = 0) ∧
      (∀ t : QZ, n • t = 0 → ∃ g ∈ T, f (Additive.ofMul g) = t) := by
  have hS' : Nat.card S.toAddSubgroup = n := hS
  have himg := image_eq_torsion_of_card f hf S.toAddSubgroup n hn hS'
  constructor
  · intro g
    rw [← hSeq]
    constructor
    · intro hg
      have : f (Additive.ofMul g) ∈ f '' (S.toAddSubgroup : Set (Additive G)) :=
        ⟨Additive.ofMul g, hg, rfl⟩
      rw [himg] at this
      exact this
    · intro h
      have : f (Additive.ofMul g) ∈ {q : QZ | n • q = 0} := h
      rw [← himg] at this
      obtain ⟨a, ha, hfa⟩ := this
      have : a = Additive.ofMul g := hf hfa
      subst this
      exact ha
  · intro t ht
    have : t ∈ {q : QZ | n • q = 0} := ht
    rw [← himg] at this
    obtain ⟨a, ha, hfa⟩ := this
    exact ⟨Additive.toMul a, by rw [← hSeq]; exact ha, hfa⟩

/-- `bcMatK` for a commutative ring (rather than field) base change. -/
noncomputable def bcMatKR {k : Type} [Field k] (M : Type) [CommRing M] [Algebra k M] (n : ℕ)
    (A : Type) [Ring A] [Algebra k A] :
    M ⊗[k] Matrix (Fin n) (Fin n) A ≃ₐ[k] Matrix (Fin n) (Fin n) (M ⊗[k] A) :=
  (Algebra.TensorProduct.congr AlgEquiv.refl (matrixEquivTensor (Fin n) k A)).trans
    ((Algebra.TensorProduct.assoc k k k M A (Matrix (Fin n) (Fin n) k)).symm.trans
      (matrixEquivTensor (Fin n) k (M ⊗[k] A)).symm)

/-- `bcMat` for a commutative ring (rather than field) base change. -/
noncomputable def bcMatR {k : Type} [Field k] (M : Type) [CommRing M] [Algebra k M] (n : ℕ)
    (A : Type) [Ring A] [Algebra k A] :
    M ⊗[k] Matrix (Fin n) (Fin n) A ≃ₐ[M] Matrix (Fin n) (Fin n) (M ⊗[k] A) :=
  AlgEquiv.ofRingEquiv (f := (bcMatKR M n A).toRingEquiv) fun l => by
    have h1 : algebraMap M (M ⊗[k] Matrix (Fin n) (Fin n) A) l = l ⊗ₜ[k] 1 := rfl
    show bcMatKR M n A (algebraMap M _ l) = _
    rw [h1]
    have h2 : bcMatKR M n A (l ⊗ₜ[k] 1) = (matrixEquivTensor (Fin n) k (M ⊗[k] A)).symm
        ((l ⊗ₜ[k] (1 : A)) ⊗ₜ[k] (1 : Matrix (Fin n) (Fin n) k)) := by
      simp only [bcMatKR, AlgEquiv.trans_apply, Algebra.TensorProduct.congr_apply,
        Algebra.TensorProduct.map_tmul, map_one]
      rw [Algebra.TensorProduct.one_def (A := A), Algebra.TensorProduct.assoc_symm_tmul]
      rfl
    rw [h2, matrixEquivTensor_apply_symm, Matrix.map_one _ (map_zero _) (map_one _),
      Matrix.smul_one_eq_diagonal, Matrix.algebraMap_eq_diagonal]
    rfl

/-- If `L'` splits `A`, then any commutative `k`-algebra `M` receiving `L'` splits `A` in the sense
`M ⊗ A ≅ M_n(M)`. (Cf. `Ch4.isSplitBy_of_algHom`, for a commutative ring `M`.) -/
theorem split_extend {k : Type} [Field k] (A : Type) [Ring A] [Algebra k A] (L' M : Type) [Field L']
    [CommRing M] [Algebra k L'] [Algebra k M] (e : L' →ₐ[k] M) (n : ℕ)
    (f : L' ⊗[k] A ≃ₐ[L'] Matrix (Fin n) (Fin n) L') :
    Nonempty (M ⊗[k] A ≃ₐ[M] Matrix (Fin n) (Fin n) M) := by
  let _ : Algebra L' M := e.toRingHom.toAlgebra
  have : IsScalarTower k L' M := IsScalarTower.of_algebraMap_eq fun x => (e.commutes x).symm
  exact ⟨((Algebra.TensorProduct.congr (Algebra.TensorProduct.rid L' M M).symm
      AlgEquiv.refl).trans (Algebra.TensorProduct.assoc k L' M M L' A)).trans
    ((Algebra.TensorProduct.congr AlgEquiv.refl f).trans
      ((bcMatR (k := L') M n L').trans (AlgEquiv.mapMatrix (Algebra.TensorProduct.rid L' M M))))⟩

/-- The localization of a class split by `L` is split by `F ⊗_K L`. -/
theorem baseChange_mem_localRelBr (F : Type) [Field F] [Algebra K F] {x : BrauerGroup.{0, 0} K}
    (hx : x ∈ relBrauer K L) : baseChange F x ∈ localRelBr K L F := by
  induction x using Quotient.inductionOn with | _ A => ?_
  obtain ⟨n, hn, ⟨f⟩⟩ := (mk_mem_relBrauer_iff (K := K) L A).1 hx
  refine ⟨CSA.baseChange F A, rfl, n, hn, ?_⟩
  obtain ⟨g⟩ := split_extend (k := K) A L (F ⊗[K] L) Algebra.TensorProduct.includeRight n f
  exact ⟨((Algebra.TensorProduct.assoc K F (F ⊗[K] L) (F ⊗[K] L) F A).symm.trans
    (Algebra.TensorProduct.congr (Algebra.TensorProduct.rid F (F ⊗[K] L) (F ⊗[K] L))
      (AlgEquiv.refl : A ≃ₐ[K] A))).trans g⟩

/-- **Corollary 4.3 from Theorem 4.2** (Milne's proof, the snake lemma): `Ch4.Example2_14e K` with the local orders
(`LocalRelBrOrder`) and the Hasse principle for $L$ read over $K$ (`RelativeHasse`) give Corollary 4.3. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, Cor. 4.3, p. 241 (proof)"]
theorem corollary4_3_of (h42 : Example2_14e K) (hloc : LocalRelBrOrder K L) (hH : RelativeHasse K L) :
    Corollary4_3 K L := by
  classical
  obtain ⟨invf, invi, hbf, hii, hfin, hinj, hcomp, hmid, -⟩ := h42.exact
  have hF : ∀ v : HeightOneSpectrum (𝓞 K),
      (∀ g, g ∈ localRelBr K L (v.adicCompletion K) ↔
        Ch7.localDegree K L (.inr v) • invf v (Additive.ofMul g) = 0) ∧
      (∀ t : QZ, Ch7.localDegree K L (.inr v) • t = 0 →
        ∃ g ∈ localRelBr K L (v.adicCompletion K), invf v (Additive.ofMul g) = t) := fun v => by
    obtain ⟨S, hS1, hS2⟩ := hloc.finite v
    exact local_torsion (invf v) (hbf v).1 _ S hS1 _ (localDegree_pos K L _) hS2
  have hI : ∀ w : InfinitePlace K,
      (∀ g, g ∈ localRelBr K L w.Completion ↔
        Ch7.localDegree K L (.inl w) • invi w (Additive.ofMul g) = 0) ∧
      (∀ t : QZ, Ch7.localDegree K L (.inl w) • t = 0 →
        ∃ g ∈ localRelBr K L w.Completion, invi w (Additive.ofMul g) = t) := fun w => by
    obtain ⟨S, hS1, hS2⟩ := hloc.infinite w
    exact local_torsion (invi w) (hii w) _ S hS1 _ (localDegree_pos K L _) hS2
  refine ⟨⟨invf, invi, hbf, hii, ?_, ?_, ?_, ?_, ?_⟩⟩
  · intro x hx
    exact ⟨hfin x, fun v => baseChange_mem_localRelBr K L _ hx,
      fun w => baseChange_mem_localRelBr K L _ hx⟩
  · intro x _ y _ hxy
    exact hinj hxy
  · intro x _
    exact hcomp x
  · intro y z hy hyl hzl hs
    obtain ⟨x, hx1, hx2⟩ := hmid y z hy hs
    have hxr : x ∈ relBrauer K L := hH.mem_relBrauer x
      (fun v => by
        show baseChange (v.adicCompletion K) x ∈ _
        rw [hx1 v]; exact hyl v)
      (fun w => by
        show baseChange w.Completion x ∈ _
        rw [hx2 w]; exact hzl w)
    exact ⟨x, hxr, Prod.ext (funext hx1) (funext hx2)⟩
  · intro q
    have key := mem_sum_torsion_iff (Ch7.localDegree K L) (localDegree_pos K L)
      ⟨Module.finrank K L, Module.finrank_pos, localDegree_dvd_finrank K L⟩ q
    rw [← key]
    constructor
    · rintro ⟨y, z, hyf, hy, hz, hsum⟩
      let x : InfinitePlace K ⊕ HeightOneSpectrum (𝓞 K) → QZ :=
        Sum.elim (fun w => invi w (Additive.ofMul (z w))) (fun v => invf v (Additive.ofMul (y v)))
      refine ⟨Finset.univ.disjSum hyf.toFinset, x, ?_, ?_⟩
      · rintro (w | v)
        · exact ((hI w).1 (z w)).1 (hz w)
        · exact ((hF v).1 (y v)).1 (hy v)
      · rw [Finset.sum_disjSum]
        have hfs : ∑ᶠ v, invf v (Additive.ofMul (y v)) =
            ∑ v ∈ hyf.toFinset, invf v (Additive.ofMul (y v)) := by
          apply finsum_eq_sum_of_support_subset
          intro v hv
          simp only [Function.mem_support] at hv
          simp only [Finset.mem_coe, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
          intro h1
          apply hv
          rw [h1]
          simp
        rw [hfs] at hsum
        simp only [x, Sum.elim_inl, Sum.elim_inr]
        rw [← hsum, add_comm]
    · rintro ⟨s, x, hx, hxs⟩
      let x' : InfinitePlace K ⊕ HeightOneSpectrum (𝓞 K) → QZ := fun i => if i ∈ s then x i else 0
      have hx' : ∀ i, Ch7.localDegree K L i • x' i = 0 := by
        intro i
        by_cases h : i ∈ s
        · simp only [x', if_pos h]; exact hx i
        · simp only [x', if_neg h, smul_zero]
      have hxs' : ∑ i ∈ s, x' i = q := by
        rw [← hxs]; exact Finset.sum_congr rfl (fun i hi => if_pos hi)
      have hx0 : ∀ i, i ∉ s → x' i = 0 := fun i h => if_neg h
      choose y hy1 hy2 using fun v => (hF v).2 (x' (Sum.inr v)) (hx' (Sum.inr v))
      choose z hz1 hz2 using fun w => (hI w).2 (x' (Sum.inl w)) (hx' (Sum.inl w))
      have hone : ∀ v, y v = 1 ↔ x' (Sum.inr v) = 0 := by
        intro v
        constructor
        · intro h; rw [← hy2 v, h]; simp
        · intro h
          have : invf v (Additive.ofMul (y v)) = invf v (Additive.ofMul 1) := by
            rw [hy2, h]; simp
          exact (hbf v).1 this
      have hsupp : {v | y v ≠ 1} ⊆ Sum.inr ⁻¹' (s : Set (InfinitePlace K ⊕ HeightOneSpectrum (𝓞 K))) := by
        intro v hv
        by_contra h
        exact hv ((hone v).2 (hx0 _ h))
      have hfin' : Set.Finite {v | y v ≠ 1} :=
        (Set.Finite.preimage Sum.inr_injective.injOn s.finite_toSet).subset hsupp
      refine ⟨y, z, hfin', hy1, hz1, ?_⟩
      have hB : ∑ᶠ v, invf v (Additive.ofMul (y v)) = ∑ v ∈ hfin'.toFinset, x' (Sum.inr v) := by
        rw [finsum_eq_sum_of_support_subset _ (s := hfin'.toFinset) ?_]
        · exact Finset.sum_congr rfl (fun v _ => hy2 v)
        · intro v hv
          simp only [Function.mem_support] at hv
          simp only [Finset.mem_coe, Set.Finite.mem_toFinset, Set.mem_setOf_eq]
          intro h1
          apply hv
          rw [h1]
          simp
      have hI' : ∑ w, invi w (Additive.ofMul (z w)) = ∑ w, x' (Sum.inl w) :=
        Finset.sum_congr rfl (fun w _ => hz2 w)
      rw [hB, hI', add_comm, ← Finset.sum_disjSum (s := Finset.univ) (t := hfin'.toFinset) (f := x')]
      have h1 : ∑ i ∈ s, x' i = ∑ i ∈ s ∪ Finset.univ.disjSum hfin'.toFinset, x' i :=
        Finset.sum_subset Finset.subset_union_left (fun i _ his => hx0 i his)
      have h2 : ∑ i ∈ Finset.univ.disjSum hfin'.toFinset, x' i =
          ∑ i ∈ s ∪ Finset.univ.disjSum hfin'.toFinset, x' i := by
        refine Finset.sum_subset Finset.subset_union_right (fun i hiC hiB => ?_)
        rcases i with w | v
        · exact absurd (Finset.inl_mem_disjSum.2 (Finset.mem_univ w)) hiB
        · apply (hone v).1
          by_contra hne
          exact hiB (Finset.inr_mem_disjSum.2 (by simpa using hne))
      rw [h2, ← h1]
      exact hxs'

/-- **Corollary 4.3, cyclic case** (Milne, *CFT*, VIII, Lemma 4.1 and (c) before it, p. 240): if $L/K$ is cyclic of
degree $n$, the target $\frac1{n_0}\mathbb Z/\mathbb Z$ of Corollary 4.3 is $\frac1n\mathbb Z/\mathbb Z$. -/
@[kb "milne2020cft" "v4.03, Ch. VIII, §4, p. 240, (c): n = n₀ for cyclic L/K"]
theorem corollary4_3_cyclic_target (hcyc : IsCyclic Gal(L/K)) (q : QZ) :
    (∀ m : ℕ, (∀ v, Ch7.localDegree K L v ∣ m) → m • q = 0) ↔ Module.finrank K L • q = 0 := by
  constructor
  · intro h
    exact h _ (localDegree_dvd_finrank K L)
  · intro hq m hm
    have hdvd : Module.finrank K L ∣ m := by
      refine lemma_4_1 K L hcyc m (fun v Q => ?_)
      have h0 := hm (Sum.inr v)
      simp only [Ch7.localDegree] at h0
      set Q0 := Classical.arbitrary (v.asIdeal.primesOver (𝓞 L))
      haveI := Q.2.1
      haveI := Q.2.2
      haveI := Q0.2.1
      haveI := Q0.2.2
      have e1 : Q.1.ramificationIdx (𝓞 K) = Q0.1.ramificationIdx (𝓞 K) :=
        (Ideal.ramificationIdxIn_eq_ramificationIdx v.asIdeal Q.1 Gal(L/K)).symm.trans
          (Ideal.ramificationIdxIn_eq_ramificationIdx v.asIdeal Q0.1 Gal(L/K))
      have e2 : Q.1.inertiaDeg (𝓞 K) = Q0.1.inertiaDeg (𝓞 K) :=
        (Ideal.inertiaDegIn_eq_inertiaDeg v.asIdeal Q.1 Gal(L/K)).symm.trans
          (Ideal.inertiaDegIn_eq_inertiaDeg v.asIdeal Q0.1 Gal(L/K))
      rw [e1, e2]
      exact h0
    obtain ⟨k, hk⟩ := hdvd
    rw [hk, mul_comm, mul_smul, hq, smul_zero]

end NumberFieldKB.MilneCFT.Ch8
