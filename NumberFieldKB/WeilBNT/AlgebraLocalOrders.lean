import QuadFormsKB.Tamagawa.Measure.Weil.AdditiveAdele
import Mathlib.Topology.Algebra.Module.ModuleTopology

/-!
# Weil, *Basic Number Theory*, III.§1, Cor. 2 of Thm. 3: the $r_v$-orders $\alpha_v$ (number fields)

$k$ is a number field (`F`), $\mathcal A$ a finite-dimensional $k$-algebra and $\alpha$ a finite subset of
$\mathcal A$ containing a basis (here: spanning $\mathcal A$ over $k$). For a finite place $v$,
$\mathcal A_v=k_v\otimes_k\mathcal A$ (`algLocal F A v`) with its natural topology (the module topology over $k_v$),
and $\alpha_v$ (`alphaV α v`) is the $r_v$-module generated by $\alpha$ (the image $1\otimes a$ of $a\in\alpha$):
the sums $\sum_{a\in\alpha}c_a(1\otimes a)$ with $c_a\in r_v$.

* **`weil_III_1_cor2_thm3`**: for almost all $v$, $\alpha_v$ is a compact subring of $\mathcal A_v$.

Weil's proof: write $a_ia_j=\sum_hc_{ijh}a_h$ and $1=\sum_h c_ha_h$ with $c\in k$; all $|c|_v\le1$ for almost
all $v$, and then $\alpha_v$ is a ring; it is compact as the image of $r_v^\alpha$.
-/

open IsDedekindDomain NumberField
open scoped TensorProduct

noncomputable section

namespace NumberFieldKB.WeilBNT

variable (F : Type) [Field F] [NumberField F] (A : Type) [Ring A] [Algebra F A] [FiniteDimensional F A]

/-- $\mathcal A_v=k_v\otimes_k\mathcal A$. -/
abbrev algLocal (v : HeightOneSpectrum (𝓞 F)) : Type := v.adicCompletion F ⊗[F] A

/-- The natural topology of $\mathcal A_v$: the module topology over $k_v$. -/
instance algLocal_topology (v : HeightOneSpectrum (𝓞 F)) : TopologicalSpace (algLocal F A v) :=
  moduleTopology (v.adicCompletion F) (algLocal F A v)

instance (v : HeightOneSpectrum (𝓞 F)) : IsModuleTopology (v.adicCompletion F) (algLocal F A v) :=
  ⟨rfl⟩

variable {F A}

/-- $\alpha_v$: the $r_v$-module generated by $\alpha$ in $\mathcal A_v$. -/
def alphaV (α : Finset A) (v : HeightOneSpectrum (𝓞 F)) : Set (algLocal F A v) :=
  {x | ∃ c : α → v.adicCompletion F, (∀ a, c a ∈ v.adicCompletionIntegers F) ∧
    x = ∑ a, c a • ((1 : v.adicCompletion F) ⊗ₜ[F] (a : A))}

/-- **Weil, III.§1, Cor. 2 of Thm. 3** (number fields). For a finite set $\alpha$ spanning $\mathcal A$ over $k$, for
almost all finite places $v$ the $r_v$-module $\alpha_v$ generated by $\alpha$ is a compact subring of
$\mathcal A_v$. -/
@[kb "weil1973bnt" "Ch. III, §1, Cor. 2 of Thm. 3 (number fields)"]
theorem weil_III_1_cor2_thm3 (α : Finset A) (hα : Submodule.span F (α : Set A) = ⊤) :
    ∀ᶠ v in Filter.cofinite,
      (∃ S : Subring (algLocal F A v), (S : Set (algLocal F A v)) = alphaV α v) ∧ IsCompact (alphaV α v) := by
  classical
  have hspan : Submodule.span F (Set.range (Subtype.val : α → A)) = ⊤ := by
    simpa using hα
  choose C hC using fun a a' : α =>
    (Submodule.mem_span_range_iff_exists_fun F).mp
      (hspan ▸ Submodule.mem_top : ((a : A) * a') ∈ Submodule.span F (Set.range (Subtype.val : α → A)))
  choose c1 hc1 using
    (Submodule.mem_span_range_iff_exists_fun F).mp
      (hspan ▸ Submodule.mem_top : (1 : A) ∈ Submodule.span F (Set.range (Subtype.val : α → A)))
  have key : ∀ x : F, ∀ᶠ v : HeightOneSpectrum (𝓞 F) in Filter.cofinite,
      algebraMap F (v.adicCompletion F) x ∈ v.adicCompletionIntegers F := fun x =>
    (FiniteAdeleRing.algebraMap (𝓞 F) F x).cofinite_mem_adicCompletionIntegers
  have hgood : ∀ᶠ v : HeightOneSpectrum (𝓞 F) in Filter.cofinite,
      (∀ a a' b, algebraMap F (v.adicCompletion F) (C a a' b) ∈ v.adicCompletionIntegers F) ∧
      ∀ b, algebraMap F (v.adicCompletion F) (c1 b) ∈ v.adicCompletionIntegers F :=
    (Filter.eventually_all.2 fun a => Filter.eventually_all.2 fun a' =>
      Filter.eventually_all.2 fun b => key _).and (Filter.eventually_all.2 fun b => key _)
  filter_upwards [hgood] with v hv
  obtain ⟨hCv, h1v⟩ := hv
  obtain ⟨e, he⟩ : ∃ e : α → algLocal F A v, ∀ a, e a = (1 : v.adicCompletion F) ⊗ₜ[F] (a : A) :=
    ⟨_, fun _ => rfl⟩
  have emul : ∀ a a', e a * e a' = ∑ b, algebraMap F (v.adicCompletion F) (C a a' b) • e b := by
    intro a a'
    rw [he, he, Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← hC a a', TensorProduct.tmul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [TensorProduct.tmul_smul, he, algebraMap_smul]
  have hA : alphaV α v = {x | ∃ c : α → v.adicCompletion F, (∀ a, c a ∈ v.adicCompletionIntegers F) ∧
      x = ∑ a, c a • e a} := by
    ext x
    simp only [alphaV, he]
  rw [hA]
  obtain ⟨S, hS⟩ : ∃ S : Set (algLocal F A v), S = {x | ∃ c : α → v.adicCompletion F,
      (∀ a, c a ∈ v.adicCompletionIntegers F) ∧ x = ∑ a, c a • e a} := ⟨_, rfl⟩
  rw [← hS]
  refine ⟨⟨{ carrier := S, mul_mem' := ?_, one_mem' := ?_, add_mem' := ?_, zero_mem' := ?_ ,
              neg_mem' := ?_ }, rfl⟩, ?_⟩
  all_goals subst hS
  · rintro x y ⟨c, hc, rfl⟩ ⟨c', hc', rfl⟩
    refine ⟨fun b => ∑ a, ∑ a', c a * c' a' * algebraMap F (v.adicCompletion F) (C a a' b),
      fun b => sum_mem fun a _ => sum_mem fun a' _ => mul_mem (mul_mem (hc a) (hc' a')) (hCv a a' b), ?_⟩
    calc (∑ a, c a • e a) * (∑ a', c' a' • e a')
        = ∑ a, ∑ a', (c a * c' a') • (e a * e a') := by
          rw [Finset.sum_mul_sum]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun a' _ => ?_
          rw [smul_mul_smul_comm]
      _ = ∑ a, ∑ a', ∑ b, (c a * c' a' * algebraMap F (v.adicCompletion F) (C a a' b)) • e b := by
          simp only [emul, Finset.smul_sum, smul_smul]
      _ = ∑ a, ∑ b, ∑ a', (c a * c' a' * algebraMap F (v.adicCompletion F) (C a a' b)) • e b :=
          Finset.sum_congr rfl fun a _ => Finset.sum_comm
      _ = ∑ b, ∑ a, ∑ a', (c a * c' a' * algebraMap F (v.adicCompletion F) (C a a' b)) • e b :=
          Finset.sum_comm
      _ = _ := by simp only [Finset.sum_smul]
  · refine ⟨fun b => algebraMap F (v.adicCompletion F) (c1 b), h1v, ?_⟩
    rw [Algebra.TensorProduct.one_def, ← hc1, TensorProduct.tmul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [TensorProduct.tmul_smul, he, algebraMap_smul]
  · rintro x y ⟨c, hc, rfl⟩ ⟨c', hc', rfl⟩
    exact ⟨c + c', fun a => add_mem (hc a) (hc' a), by simp [add_smul, Finset.sum_add_distrib]⟩
  · exact ⟨0, fun a => zero_mem _, by simp⟩
  · rintro x ⟨c, hc, rfl⟩
    exact ⟨-c, fun a => neg_mem (hc a), by simp [Finset.sum_neg_distrib]⟩
  · have himg : {x | ∃ c : α → v.adicCompletion F, (∀ a, c a ∈ v.adicCompletionIntegers F) ∧
        x = ∑ a, c a • e a} =
        (fun c : α → v.adicCompletion F => ∑ a, c a • e a) ''
          Set.pi Set.univ (fun _ => (v.adicCompletionIntegers F : Set (v.adicCompletion F))) := by
      ext x
      constructor
      · rintro ⟨c, hc, rfl⟩
        exact ⟨c, fun a _ => hc a, rfl⟩
      · rintro ⟨c, hc, rfl⟩
        exact ⟨c, fun a => hc a (Set.mem_univ a), rfl⟩
    rw [himg]
    have : ContinuousAdd (algLocal F A v) :=
      IsModuleTopology.toContinuousAdd (v.adicCompletion F) (algLocal F A v)
    refine IsCompact.image (isCompact_univ_pi fun _ =>
      QuadFormsKB.Tamagawa.Measure.Weil.isCompact_adicCompletionIntegers v) ?_
    exact continuous_finsetSum _ fun a _ => (continuous_apply a).smul continuous_const

end NumberFieldKB.WeilBNT
