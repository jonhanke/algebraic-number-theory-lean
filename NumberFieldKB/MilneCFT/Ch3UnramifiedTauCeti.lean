import NumberFieldKB.MilneCFT.Ch3Unramified
import NumberFieldKB.MilneCFT.LocalCFT.UnramifiedTauCeti
import NumberFieldKB.TauCetiPort.NumberTheory.LocalField.NormalizedValuation

/-!
# Milne, *Class Field Theory*, Chapter III §1: the unramified inputs, proved from Tau Ceti

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter III, §1, pp. 97–99.

The named statements `UnramifiedCyclic` (the Galois group of a finite unramified extension is cyclic, generated by
the Frobenius element) and `UnitPrimeDecomposition` (display (26): $L^\times = U_L\cdot\pi^{\mathbb Z}$ for $L/K$
unramified) are proved from the ported Tau Ceti files (Apache 2.0, `NumberFieldKB/TauCetiPort/`):
`TauCeti.zpowers_frobeniusAlgEquiv`, `TauCeti.valuation_frobeniusAlgEquiv_sub_pow`,
`TauCeti.IsUnramified.irreducible_algebraMap` and `TauCeti.exists_eq_mul_zpow_of_irreducible`, through the
comparisons of `LocalCFT/UnramifiedTauCeti.lean` (`isUnramified_iff_isUnramifiedExt`,
`eq_frobeniusAlgEquiv_of_isFrobenius`) and `LubinTate/HerbrandTauCeti.lean` (`mem_maxIdealL_pow_iff`).
On a finite intermediate field $L$ of $\Omega/K$ we use Tau Ceti's local-field structure
(`TauCeti.finiteIntermediateFieldValuativeRel`).
-/

open scoped ValuativeRel

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch3

open NumberFieldKB.MilneCFT NumberFieldKB.MilneCFT.LocalCFT

set_option linter.unusedSectionVars false

variable {K : Type} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

section LocalStructure

variable (L : IntermediateField K Ω) [FiniteDimensional K L] [ValuativeRel L] [TopologicalSpace L]
  [ValuativeExtension K L] [IsNonarchimedeanLocalField L]

/-- In an unramified $L/K$, $\mathfrak m_K\mathcal O_L$ is the radical `maxIdealL L`. -/
theorem map_maximalIdeal_eq_maxIdealL (hL : IsUnramifiedExt L) :
    (𝓂[K]).map (algebraMap 𝒪[K] (integers L)) = maxIdealL L := by
  unfold maxIdealL
  exact (Ideal.IsMaximal.isPrime hL).radical.symm

/-- Tau Ceti's Frobenius satisfies our Frobenius condition `IsFrobenius`. -/
theorem isFrobenius_frobeniusAlgEquiv [IsGalois K L] [TauCeti.IsUnramified K L] :
    IsFrobenius L (TauCeti.frobeniusAlgEquiv (K := K) (L := L)) := by
  have hL : IsUnramifiedExt L := (isUnramified_iff_isUnramifiedExt L).1 ‹_›
  intro x hx
  set e := TauCeti.integerRingEquivIntegralClosure K L
  set σ := TauCeti.frobeniusAlgEquiv (K := K) (L := L)
  let y : 𝒪[L] := e.symm ⟨x, hx⟩
  have hy : (y : L) = x := by
    rw [TauCeti.coe_integerRingEquivIntegralClosure_symm_apply]
  have hσx : σ x ∈ integers L := galMap_mem_integers L σ hx
  have hxq : x ^ Nat.card 𝓀[K] ∈ integers L := Subalgebra.pow_mem _ hx _
  let b : integers L := ⟨σ x - x ^ Nat.card 𝓀[K], Subalgebra.sub_mem _ hσx hxq⟩
  refine ⟨b, ?_, rfl⟩
  rw [map_maximalIdeal_eq_maxIdealL L hL, ← pow_one (maxIdealL L), mem_maxIdealL_pow_iff L 1 b, pow_one,
    IsLocalRing.mem_maximalIdeal, mem_nonunits_iff,
    (Valuation.integer.integers _).isUnit_iff_valuation_eq_one]
  change ¬ ValuativeRel.valuation L ((e.symm b : 𝒪[L]) : L) = 1
  rw [TauCeti.coe_integerRingEquivIntegralClosure_symm_apply]
  have h := TauCeti.valuation_frobeniusAlgEquiv_sub_pow (K := K) (L := L) y
  rw [hy] at h
  exact h.ne

end LocalStructure

/-- Install Tau Ceti's local-field structure on a finite intermediate field. -/
private theorem withLocal (L : IntermediateField K Ω) [FiniteDimensional K L] {P : Prop}
    (h : ∀ (_ : ValuativeRel L) (_ : TopologicalSpace L) (_ : ValuativeExtension K L)
      (_ : IsNonarchimedeanLocalField L), P) : P := by
  let _ : ValuativeRel L := TauCeti.finiteIntermediateFieldValuativeRel K Ω L
  let _ : TopologicalSpace L := TauCeti.finiteIntermediateFieldTopology K Ω L
  exact h _ _ (TauCeti.finiteIntermediateField_valuativeExtension K Ω L)
    (TauCeti.finiteIntermediateField_isNonarchimedeanLocalField K Ω L)

variable (K Ω) in
/-- **The Galois group of an unramified extension, proved** (Milne, *CFT*, III, §1, pp. 98–99): the named statement
`UnramifiedCyclic` holds. Tau Ceti's Frobenius satisfies our Frobenius condition (`isFrobenius_frobeniusAlgEquiv`)
and generates the Galois group (`TauCeti.zpowers_frobeniusAlgEquiv`); an automorphism satisfying our condition is
Tau Ceti's Frobenius (`eq_frobeniusAlgEquiv_of_isFrobenius`). -/
@[kb "milne2020cft" "v4.03, Ch. III, §1, p. 98–99, G ≃ Gal(l/k) generated by Frobenius"]
theorem unramifiedCyclic : UnramifiedCyclic K Ω := by
  refine ⟨fun L _ _ hL => ?_, fun L _ _ hL σ hσ τ => ?_⟩
  · refine withLocal L fun _ _ _ _ => ?_
    have : TauCeti.IsUnramified K L := (isUnramified_iff_isUnramifiedExt L).2 hL
    refine ⟨TauCeti.frobeniusAlgEquiv (K := K) (L := L), isFrobenius_frobeniusAlgEquiv L, fun τ => ?_⟩
    rw [TauCeti.zpowers_frobeniusAlgEquiv]
    exact Subgroup.mem_top τ
  · refine withLocal L fun _ _ _ _ => ?_
    have : TauCeti.IsUnramified K L := (isUnramified_iff_isUnramifiedExt L).2 hL
    rw [eq_frobeniusAlgEquiv_of_isFrobenius L σ hσ, TauCeti.zpowers_frobeniusAlgEquiv]
    exact Subgroup.mem_top τ

variable (K Ω) in
/-- **Display (26), proved** (Milne, *CFT*, III, §1, p. 97): the named statement `UnitPrimeDecomposition` holds. In an
unramified $L/K$ a prime element $\pi$ of $K$ stays irreducible in $\mathcal O_L$
(`TauCeti.IsUnramified.irreducible_algebraMap`), so every $x \in L^\times$ is $u\pi^m$ with $u$ of valuation $1$
(`TauCeti.exists_eq_mul_zpow_of_irreducible`); such a $u$ and its inverse are integral over $\mathcal O_K$. -/
@[kb "milne2020cft" "v4.03, Ch. III, §1, display (26), p. 97"]
theorem unitPrimeDecomposition : UnitPrimeDecomposition K Ω := by
  refine ⟨fun L _ hL π hπ x => ?_⟩
  refine withLocal L fun _ _ _ _ => ?_
  have : TauCeti.IsUnramified K L := (isUnramified_iff_isUnramifiedExt L).2 hL
  have hπL := TauCeti.IsUnramified.irreducible_algebraMap (K := K) (L := L) hπ
  obtain ⟨u, m, hu, hx⟩ := TauCeti.exists_eq_mul_zpow_of_irreducible hπL x
  have hunit : Units.mk0 ((algebraMap 𝒪[K] 𝒪[L] π : 𝒪[L]) : L)
      (fun h => hπL.ne_zero (Subtype.ext h)) = embUnits L (primeUnit hπ) := by
    apply Units.ext
    show ((algebraMap 𝒪[K] 𝒪[L] π : 𝒪[L]) : L) = algebraMap K L (π : K)
    rfl
  have hint : ∀ z : L, ValuativeRel.valuation L z ≤ 1 → z ∈ integers L := by
    intro z hz
    let w : 𝒪[L] := ⟨z, hz⟩
    have := (TauCeti.integerRingEquivIntegralClosure K L w).2
    rwa [TauCeti.coe_integerRingEquivIntegralClosure_apply] at this
  refine ⟨u, ⟨hint _ hu.le, hint _ ?_⟩, m, ?_⟩
  · rw [Units.val_inv_eq_inv_val, map_inv₀, hu, inv_one]
  · rw [hx, hunit]
