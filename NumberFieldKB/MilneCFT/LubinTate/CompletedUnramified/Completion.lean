import Mathlib.RingTheory.AdicCompletion.LocalRing
import Mathlib.RingTheory.AdicCompletion.AsTensorProduct
import Mathlib.RingTheory.AdicCompletion.RingHom
import Mathlib.RingTheory.DiscreteValuationRing.Basic

/-!
# The completion of a discrete valuation ring is a discrete valuation ring

Generic commutative algebra, no number theory.  For a discrete valuation ring `R` write `C R` for its
completion with respect to the powers of its maximal ideal.  We prove:

* `C R` is again a discrete valuation ring, complete for its maximal ideal, whose maximal ideal is
  generated by the image of the maximal ideal of `R` and whose residue field is the residue field of `R`;
* every ring automorphism of `R` extends uniquely to a ring automorphism `completionMap σ` of `C R`;
* if an automorphism `σ` of `R` satisfies `σ r ≡ r ^ q` modulo the maximal ideal for all `r`, then the
  same congruence holds on all of `C R`.
-/

open IsLocalRing

noncomputable section

namespace NumberFieldKB.MilneCFT.CompletedUnramified

/-- The completion of a local ring with respect to the powers of its maximal ideal. -/
abbrev C (R : Type) [CommRing R] [IsLocalRing R] : Type :=
  AdicCompletion (maximalIdeal R) R

section Domain

variable {R : Type} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- Completion of a discrete valuation ring is complete for its maximal ideal. -/
theorem completion_isAdicComplete :
    IsAdicComplete (maximalIdeal (C R)) (C R) := inferInstance

/-- The maximal ideal of the completion is generated by the maximal ideal of the base ring. -/
theorem maximalIdeal_completion :
    maximalIdeal (C R) = (maximalIdeal R).map (algebraMap R (C R)) :=
  AdicCompletion.maximalIdeal_eq_map

/-- The residue field of the completion is the residue field of the base ring. -/
theorem completion_residue_bijective :
    Function.Bijective (IsLocalRing.ResidueField.map (algebraMap R (C R))) :=
  AdicCompletion.residueField_map_bijective R

/-- Multiplication by the image of a uniformizer is injective on the completion. -/
theorem completion_uniformizer_regular {ϖ : R} (hϖ : Irreducible ϖ) :
    IsSMulRegular (C R) (algebraMap R (C R) ϖ) := by
  have h : IsSMulRegular R ϖ := by
    intro a b hab
    exact mul_left_cancel₀ hϖ.ne_zero hab
  exact h.of_flat

/-- The maximal ideal of the completion is generated by the image of a uniformizer. -/
theorem maximalIdeal_completion_eq_span {ϖ : R} (hϖ : Irreducible ϖ) :
    maximalIdeal (C R) = Ideal.span {algebraMap R (C R) ϖ} := by
  rw [maximalIdeal_completion]
  have h := congrArg (Ideal.map (algebraMap R (C R))) hϖ.maximalIdeal_eq
  rw [h, Ideal.map_span, Set.image_singleton]

/-- Every nonzero element of the completion is a unit times a power of the uniformizer. -/
theorem completion_exists_associated_pow {ϖ : R} (hϖ : Irreducible ϖ) {x : C R} (hx : x ≠ 0) :
    ∃ n : ℕ, Associated (algebraMap R (C R) ϖ ^ n) x := by
  set p := algebraMap R (C R) ϖ with hp
  have hm : maximalIdeal (C R) = Ideal.span {p} := maximalIdeal_completion_eq_span hϖ
  have hH : IsHausdorff (maximalIdeal (C R)) (C R) := inferInstance
  have hex : ∃ n : ℕ, x ∉ maximalIdeal (C R) ^ (n + 1) := by
    by_contra hcon
    push Not at hcon
    apply hx
    have : x ∈ (⨅ n : ℕ, maximalIdeal (C R) ^ n • ⊤ : Submodule (C R) (C R)) := by
      rw [Submodule.mem_iInf]
      intro n
      cases n with
      | zero => simp
      | succ n => simpa using hcon n
    rwa [hH.iInf_pow_smul, Submodule.mem_bot] at this
  classical
  let n := Nat.find hex
  have hn : x ∉ maximalIdeal (C R) ^ (n + 1) := Nat.find_spec hex
  have hxn : x ∈ maximalIdeal (C R) ^ n := by
    by_cases h0 : n = 0
    · rw [h0]; simp
    · obtain ⟨k, hk⟩ := Nat.exists_eq_succ_of_ne_zero h0
      have := Nat.find_min hex (show n - 1 < n by omega)
      push Not at this
      have hk' : n - 1 + 1 = n := by omega
      rwa [hk'] at this
  rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton'] at hxn
  obtain ⟨u, hu⟩ := hxn
  refine ⟨n, ?_⟩
  have hun : IsUnit u := by
    by_contra hnu
    apply hn
    have hu_m : u ∈ maximalIdeal (C R) := hnu
    rw [hm, Ideal.mem_span_singleton'] at hu_m
    obtain ⟨v, hv⟩ := hu_m
    rw [hm, Ideal.span_singleton_pow, Ideal.mem_span_singleton']
    refine ⟨v, ?_⟩
    rw [← hu, ← hv]
    ring
  obtain ⟨w, rfl⟩ := hun
  exact ⟨w, by rw [← hu]; ring⟩

/-- The completion of a discrete valuation ring has no zero divisors. -/
theorem completion_noZeroDivisors : NoZeroDivisors (C R) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hreg := completion_uniformizer_regular hϖ
  have hpow : ∀ n : ℕ, IsSMulRegular (C R) (algebraMap R (C R) ϖ ^ n) := fun n =>
    hreg.pow n
  refine ⟨fun {a b} hab => ?_⟩
  by_contra hne
  push Not at hne
  obtain ⟨m, hm⟩ := completion_exists_associated_pow hϖ hne.1
  obtain ⟨n, hn⟩ := completion_exists_associated_pow hϖ hne.2
  obtain ⟨u, rfl⟩ := hm
  obtain ⟨v, rfl⟩ := hn
  have h0 : algebraMap R (C R) ϖ ^ (m + n) * ((u : C R) * v) = 0 := by
    rw [pow_add]
    calc _ = (algebraMap R (C R) ϖ ^ m * u) * (algebraMap R (C R) ϖ ^ n * v) := by ring
      _ = 0 := hab
  have h1 : (algebraMap R (C R) ϖ ^ (m + n)) * ((u : C R) * v) =
      (algebraMap R (C R) ϖ ^ (m + n)) * 0 := by rw [h0, mul_zero]
  have h2 := (hpow (m + n)) h1
  have : IsUnit ((u : C R) * v) := (u * v : (C R)ˣ).isUnit
  exact this.ne_zero h2

instance completion_isDomain : IsDomain (C R) :=
  haveI := completion_noZeroDivisors (R := R)
  NoZeroDivisors.to_isDomain _

instance : IsDiscreteValuationRing (C R) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  have hm : maximalIdeal (C R) = Ideal.span {algebraMap R (C R) ϖ} :=
    maximalIdeal_completion_eq_span hϖ
  have hne : algebraMap R (C R) ϖ ≠ 0 := by
    intro h0
    have hreg := completion_uniformizer_regular hϖ
    have : (1 : C R) = 0 := by
      apply hreg
      simp [h0]
    exact one_ne_zero this
  apply IsDiscreteValuationRing.ofHasUnitMulPowIrreducibleFactorization
  refine ⟨algebraMap R (C R) ϖ, ?_, fun {x} hx => completion_exists_associated_pow hϖ hx⟩
  exact IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal _ hne hm

end Domain

section Automorphism

variable {R : Type} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- A ring automorphism of a local ring maps the maximal ideal onto itself. -/
theorem map_maximalIdeal_equiv (σ : R ≃+* R) :
    (maximalIdeal R).map σ = maximalIdeal R := by
  rw [← Ideal.comap_symm]
  ext x
  simp only [Ideal.mem_comap, mem_maximalIdeal]
  exact map_mem_nonunits_iff σ.symm x

/-- The automorphism induced by `σ` on the quotient of `R` by the `n`-th power of its maximal ideal. -/
def quotientMap (σ : R ≃+* R) (n : ℕ) : R ⧸ maximalIdeal R ^ n ≃+* R ⧸ maximalIdeal R ^ n :=
  Ideal.quotientEquiv _ _ σ (by
    rw [Ideal.map_pow]
    exact congrArg (· ^ n) (map_maximalIdeal_equiv σ).symm)

theorem quotientMap_mk (σ : R ≃+* R) (n : ℕ) (r : R) :
    quotientMap σ n (Ideal.Quotient.mk _ r) = Ideal.Quotient.mk _ (σ r) :=
  Ideal.quotientEquiv_mk _ _ _ _ _

/-- The projections of an element of the completion are compatible with the transition maps. -/
theorem factorPow_evalₐ {m n : ℕ} (hle : m ≤ n) (x : C R) :
    Ideal.Quotient.factorPow (maximalIdeal R) hle (AdicCompletion.evalₐ (maximalIdeal R) n x) =
      AdicCompletion.evalₐ (maximalIdeal R) m x := by
  obtain ⟨s, rfl⟩ := AdicCompletion.mk_surjective (maximalIdeal R) R x
  simp only [AdicCompletion.evalₐ_mk]
  rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk, Ideal.Quotient.eq]
  have := (SModEq.sub_mem.1 (s.2 hle).symm)
  simpa using this

/-- The ring map from the completion to `R ⧸ m ^ n` obtained by projecting and then applying `σ`. -/
def projectTwist (σ : R ≃+* R) (n : ℕ) : C R →+* R ⧸ maximalIdeal R ^ n :=
  (quotientMap σ n : _ →+* _).comp (AdicCompletion.evalₐ (maximalIdeal R) n).toRingHom

theorem projectTwist_compat (σ : R ≃+* R) {m n : ℕ} (hle : m ≤ n) :
    (Ideal.Quotient.factorPow (maximalIdeal R) hle).comp (projectTwist σ n) = projectTwist σ m := by
  refine RingHom.ext fun x => ?_
  simp only [RingHom.comp_apply, projectTwist, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
  rw [← factorPow_evalₐ hle x]
  obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ (maximalIdeal R) n x)
  rw [← hy]
  simp [quotientMap_mk, Ideal.Quotient.factorPow]

/-- The ring endomorphism of the completion induced by an automorphism of `R`. -/
def completionHom (σ : R ≃+* R) : C R →+* C R :=
  AdicCompletion.liftRingHom (maximalIdeal R) (fun n => projectTwist σ n)
    (fun hle => projectTwist_compat σ hle)

theorem evalₐ_completionHom (σ : R ≃+* R) (n : ℕ) (x : C R) :
    AdicCompletion.evalₐ (maximalIdeal R) n (completionHom σ x) =
      quotientMap σ n (AdicCompletion.evalₐ (maximalIdeal R) n x) :=
  AdicCompletion.evalₐ_liftRingHom _ _ _ n x

theorem completionHom_algebraMap (σ : R ≃+* R) (r : R) :
    completionHom σ (algebraMap R (C R) r) = algebraMap R (C R) (σ r) := by
  apply AdicCompletion.ext_evalₐ
  intro n
  rw [evalₐ_completionHom, AdicCompletion.algebraMap_apply, AdicCompletion.algebraMap_apply,
    AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of, quotientMap_mk]
  simp

theorem quotientMap_symm_cancel (σ : R ≃+* R) (n : ℕ) (y : R ⧸ maximalIdeal R ^ n) :
    quotientMap σ n (quotientMap σ.symm n y) = y := by
  obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective y
  rw [quotientMap_mk, quotientMap_mk, RingEquiv.apply_symm_apply]

/-- **Extension of an automorphism to the completion**: a ring automorphism of a discrete valuation
ring extends to a ring automorphism of its completion. -/
def completionMap (σ : R ≃+* R) : C R ≃+* C R :=
  RingEquiv.ofRingHom (completionHom σ) (completionHom σ.symm)
    (by
      refine RingHom.ext fun x => AdicCompletion.ext_evalₐ fun n => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply, evalₐ_completionHom]
      exact quotientMap_symm_cancel σ n _)
    (by
      refine RingHom.ext fun x => AdicCompletion.ext_evalₐ fun n => ?_
      simp only [RingHom.comp_apply, RingHom.id_apply, evalₐ_completionHom]
      simpa using quotientMap_symm_cancel σ.symm n _)

/-- The extension of `σ` to the completion agrees with `σ` on the image of the base ring. -/
theorem completionMap_algebraMap (σ : R ≃+* R) (r : R) :
    completionMap σ (algebraMap R (C R) r) = algebraMap R (C R) (σ r) :=
  completionHom_algebraMap σ r

theorem completionMap_mem_maximalIdeal (σ : R ≃+* R) {y : C R}
    (hy : y ∈ maximalIdeal (C R)) : completionMap σ y ∈ maximalIdeal (C R) := by
  rw [maximalIdeal_completion] at hy ⊢
  have h : (completionMap σ : C R →+* C R).comp (algebraMap R (C R)) =
      (algebraMap R (C R)).comp (σ : R →+* R) := by
    exact RingHom.ext fun r => completionMap_algebraMap σ r
  have h2 : ((maximalIdeal R).map (algebraMap R (C R))).map (completionMap σ : C R →+* C R) ≤
      (maximalIdeal R).map (algebraMap R (C R)) := by
    rw [Ideal.map_map, h, ← Ideal.map_map]
    rw [show Ideal.map (σ : R →+* R) (maximalIdeal R) = maximalIdeal R from
      map_maximalIdeal_equiv σ]
  exact h2 (Ideal.mem_map_of_mem _ hy)

/-- **Frobenius congruence on the completion**: if `σ r ≡ r ^ q` modulo the maximal ideal for all
`r` in the base ring, then `σ b ≡ b ^ q` modulo the maximal ideal for all `b` in the completion. -/
theorem completionMap_sub_pow_mem (σ : R ≃+* R) (q : ℕ)
    (h : ∀ r : R, σ r - r ^ q ∈ maximalIdeal R) (b : C R) :
    completionMap σ b - b ^ q ∈ maximalIdeal (C R) := by
  obtain ⟨x, hx⟩ := (completion_residue_bijective (R := R)).2 (IsLocalRing.residue (C R) b)
  obtain ⟨r, rfl⟩ := IsLocalRing.residue_surjective x
  rw [IsLocalRing.ResidueField.map_residue] at hx
  have hba : b - algebraMap R (C R) r ∈ maximalIdeal (C R) := by
    rw [← IsLocalRing.residue_eq_zero_iff, map_sub, ← hx, sub_self]
  set a := algebraMap R (C R) r with ha
  have h1 : completionMap σ (b - a) ∈ maximalIdeal (C R) := by
    exact completionMap_mem_maximalIdeal σ hba
  have h2 : completionMap σ a - a ^ q ∈ maximalIdeal (C R) := by
    rw [ha, completionMap_algebraMap, ← map_pow, ← map_sub, maximalIdeal_completion]
    exact Ideal.mem_map_of_mem _ (h r)
  have h3 : b ^ q - a ^ q ∈ maximalIdeal (C R) := by
    obtain ⟨c, hc⟩ := sub_dvd_pow_sub_pow b a q
    rw [hc]
    exact Ideal.mul_mem_right _ _ hba
  have : completionMap σ b - b ^ q =
      completionMap σ (b - a) + (completionMap σ a - a ^ q) - (b ^ q - a ^ q) := by
    rw [map_sub]; ring
  rw [this]
  exact Ideal.sub_mem _ (Ideal.add_mem _ h1 h2) h3

end Automorphism

end NumberFieldKB.MilneCFT.CompletedUnramified
