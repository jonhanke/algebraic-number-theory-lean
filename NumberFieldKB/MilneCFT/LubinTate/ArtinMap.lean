import NumberFieldKB.MilneCFT.LubinTate.Extension

/-!
# The local Artin map $\phi_\pi$ (Milne, *Class Field Theory*, Chapter I, §3, pp. 40–44)

* `unramifiedClosure` — $K^{\mathrm{un}}$, the union of the finite unramified extensions of $K$ in $K^{\mathrm{al}}$.
* `IsLubinTateArtin` — Milne's definition of $\phi_\pi$ (p. 40): for $a = u\pi^m$, $\phi_\pi(a)$ acts on $K^{\mathrm{un}}$
  as $\mathrm{Frob}^m$ and on $\Lambda_n$ by $[u^{-1}]_f$. As in `LocalCFT/Basic.lean`, a homomorphism to
  $\mathrm{Gal}((K_\pi K^{\mathrm{un}})/K)$ is a family over the finite abelian extensions inside
  $K_\pi K^{\mathrm{un}}$, compatible with restriction.
* `LubinTateArtinIndependence` — **Theorem 3.9** (named statement): $K_\pi K^{\mathrm{un}}$ and $\phi_\pi$ do not
  depend on $\pi$; with the existence of $\phi_\pi$ (Milne: "because $K_\pi \cap K^{\mathrm{un}} = K$, it suffices to
  describe the actions on $K_\pi$ and $K^{\mathrm{un}}$ separately").
* `torsionField`, `TorsionFieldIndependence` — $K[\Lambda_{f,n}]$ for any Lubin–Tate polynomial $f$, and the claim of
  p. 36 that it does not depend on $f$ (the canonical isomorphism $F_f \cong F_g$ of Corollary 2.16 maps
  $\Lambda_{f,n}$ onto $\Lambda_{g,n}$).
* **Example 3.8** (`example_3_8`): $(\mathbb Q_p)_{p,n} = \mathbb Q_p[\zeta_{p^n}]$, from Example 3.2 and
  `TorsionFieldIndependence`.

Proposition 3.10, Lemmas 3.11, 3.12 and Example 3.13 are named statements in `LubinTate/Complements.lean`
(Proposition 3.10 and Lemma 3.11 over a characterization of the integers of $\widehat{K^{\mathrm{un}}}$, which is not
a subfield of $\Omega$).
-/

open scoped ValuativeRel
open Polynomial

noncomputable section

set_option linter.unusedSectionVars false

namespace NumberFieldKB.MilneCFT.LocalCFT

variable {K : Type*} [Field K] [ValuativeRel K] [TopologicalSpace K] [IsNonarchimedeanLocalField K]
variable {Ω : Type*} [Field Ω] [Algebra K Ω] [IsSepClosure K Ω]

variable (K Ω) in
/-- **$K^{\mathrm{un}}$** (Milne, *CFT*, I, §1 and §3): the composite in $K^{\mathrm{al}}$ of all finite unramified
extensions of $K$. -/
@[kb "milne2020cft" "Ch. I, §3 (K^un)"]
def unramifiedClosure : IntermediateField K Ω :=
  ⨆ (L : IntermediateField K Ω) (_ : FiniteDimensional K L ∧ IsUnramifiedExt L), L

/-- The unit $u \in \mathcal O_K^\times$ as an element of $K^\times$. -/
def unitToK (u : 𝒪[K]ˣ) : Kˣ := Units.map (algebraMap 𝒪[K] K).toMonoidHom u

/-- **The local Artin map $\phi_\pi$** (Milne, *CFT*, I, §3, p. 40, definition in prose): a family
$\phi_L : K^\times \to \mathrm{Gal}(L/K)$ over the finite abelian extensions $L \subseteq K_\pi K^{\mathrm{un}}$,
compatible with restriction, such that for $a = u\pi^m$ ($u \in \mathcal O_K^\times$, $m \in \mathbb Z$):
$\phi_\pi(a)$ is $\mathrm{Frob}^m$ on every finite unramified $L$, and acts on $\Lambda_n$ by
$\lambda \mapsto [u^{-1}]_f(\lambda)$ (in every $L \supseteq K_{\pi,n}$). -/
@[kb "milne2020cft" "Ch. I, §3, p. 40 (the local Artin map φ_π)"]
structure IsLubinTateArtin {π : 𝒪[K]} (hπ : Irreducible π)
    (φ : ∀ L : FiniteAbelianExt K Ω, Kˣ →* Gal(L.toField/K)) : Prop where
  compat : ∀ (L L' : FiniteAbelianExt K Ω) (h : L.toField ≤ L'.toField),
    L'.toField ≤ ltTower Ω π ⊔ unramifiedClosure K Ω → ∀ a : Kˣ, galRestrict h (φ L' a) = φ L a
  frobenius : ∀ (L : FiniteAbelianExt K Ω), IsUnramifiedExt L.toField → ∀ σ : Gal(L.toField/K),
    IsFrobenius L.toField σ → ∀ (u : 𝒪[K]ˣ) (m : ℤ), φ L (unitToK u * primeUnit hπ ^ m) = σ ^ m
  torsion : ∀ (n : ℕ) (L : FiniteAbelianExt K Ω) (hL : ltField Ω π n ≤ L.toField),
    L.toField ≤ ltTower Ω π ⊔ unramifiedClosure K Ω → ∀ (u : 𝒪[K]ˣ) (m : ℤ) (α : Ω) (hα : α ∈ ltTorsion Ω π n),
      ((φ L (unitToK u * primeUnit hπ ^ m) ⟨α, hL (mem_ltField hα)⟩ : L.toField) : Ω) =
        ltAct hπ n ((u⁻¹ : 𝒪[K]ˣ) : 𝒪[K]) α

variable (K Ω) in
/-- **Theorem 3.9** (named statement; Milne, *CFT*, I, Theorem 3.9): $K_\pi K^{\mathrm{un}}$ and $\phi_\pi$ are
independent of the choice of the prime element $\pi$. Together with the existence of $\phi_\pi$ (its definition,
p. 40). -/
@[kb "milne2020cft" "Ch. I, Theorem 3.9 (input)"]
structure LubinTateArtinIndependence : Prop where
  exists_artin : ∀ {π : 𝒪[K]} (hπ : Irreducible π), ∃ φ, IsLubinTateArtin (Ω := Ω) hπ φ
  field_eq : ∀ {π ϖ : 𝒪[K]}, Irreducible π → Irreducible ϖ →
    ltTower Ω π ⊔ unramifiedClosure K Ω = ltTower Ω ϖ ⊔ unramifiedClosure K Ω
  artin_eq : ∀ {π ϖ : 𝒪[K]} (hπ : Irreducible π) (hϖ : Irreducible ϖ) (φ ψ)
    (_ : IsLubinTateArtin (Ω := Ω) hπ φ) (_ : IsLubinTateArtin (Ω := Ω) hϖ ψ) (L : FiniteAbelianExt K Ω),
    L.toField ≤ ltTower Ω π ⊔ unramifiedClosure K Ω → φ L = ψ L

/-! ## Independence of $f$ and Example 3.8 -/

variable (Ω) in
/-- $K[\Lambda_{f,n}]$ for a polynomial $f$: the field generated by the roots of $f^{(n)}$. -/
def torsionField (f : 𝒪[K][X]) (n : ℕ) : IntermediateField K Ω :=
  IntermediateField.adjoin K ((((fun p => f.comp p)^[n] X).map (algebraMap 𝒪[K] K)).rootSet Ω)

theorem ltField_eq_torsionField (π : 𝒪[K]) (n : ℕ) : ltField Ω π n = torsionField Ω (ltPoly π) n := rfl

variable (K Ω) in
/-- **$K[\Lambda_n]$ does not depend on $f$** (named statement; Milne, *CFT*, I, §3, p. 36: "the canonical
$A$-isomorphism $F_f \to F_g$ induces an $A$-isomorphism $\Lambda_f \to \Lambda_g$"): for Lubin–Tate polynomials $f, g$
for the same $\pi$ (elements of $\mathcal F_\pi$ that are distinguished polynomials, so that $\Lambda_{f,n}$ is the set
of all roots of $f^{(n)}$, as in Remark 3.1), $K[\Lambda_{f,n}] = K[\Lambda_{g,n}]$. -/
@[kb "milne2020cft" "Ch. I, §3, p. 36 (Λ_f ≅ Λ_g; input)"]
structure TorsionFieldIndependence : Prop where
  eq : ∀ {π : 𝒪[K]}, Irreducible π → ∀ (f g : 𝒪[K][X]),
    (f : PowerSeries 𝒪[K]) ∈ lubinTateSeries π (resCard K) → f.IsDistinguishedAt 𝓂[K] →
    (g : PowerSeries 𝒪[K]) ∈ lubinTateSeries π (resCard K) → g.IsDistinguishedAt 𝓂[K] →
    ∀ n : ℕ, torsionField Ω f n = torsionField Ω g n

theorem padic_mem_int_iff (p : ℕ) [Fact p.Prime] (x : ℚ_[p]) :
    x ∈ 𝒪[ℚ_[p]] ↔ ‖x‖ ≤ 1 := by
  have h1 : ValuativeRel.valuation ℚ_[p] x ≤ 1 ↔ Padic.mulValuation x ≤ 1 :=
    (ValuativeRel.isEquiv (ValuativeRel.valuation ℚ_[p]) (Padic.mulValuation (p := p))).le_one_iff_le_one
  have h2 : ‖x‖ ≤ 1 ↔ Padic.mulValuation x ≤ 1 := by
    have := Padic.norm_lt_norm_iff_mulValuation_lt (p := p) (x := 1) (y := x)
    rw [norm_one, map_one] at this
    rw [← not_lt, ← not_lt, this]
  rw [h2, ← h1]
  exact Valuation.mem_integer_iff (ValuativeRel.valuation ℚ_[p]) x

/-- `ℤ_[p] ≃+* 𝒪[ℚ_[p]]`. -/
def padicIntEquivIntegers (p : ℕ) [Fact p.Prime] : ℤ_[p] ≃+* 𝒪[ℚ_[p]] where
  toFun x := ⟨(x : ℚ_[p]), (padic_mem_int_iff p _).2 x.2⟩
  invFun y := ⟨(y : ℚ_[p]), (padic_mem_int_iff p _).1 y.2⟩
  left_inv x := rfl
  right_inv y := rfl
  map_mul' x y := rfl
  map_add' x y := rfl

theorem resCard_padic (p : ℕ) [Fact p.Prime] : resCard ℚ_[p] = p := by
  have e := IsLocalRing.ResidueField.mapEquiv (padicIntEquivIntegers p).symm
  unfold resCard
  rw [Nat.card_congr e.toEquiv, Nat.card_congr (PadicInt.residueField (p := p)).toEquiv, Nat.card_zmod]

/-- `(X+1)^q - 1` as a polynomial. -/
theorem sub_one_pow_mem {A : Type*} [CommRing A] {q : ℕ} (H : LubinTateHyp A (q : A) q) :
    (((X + 1) ^ q - 1 : A[X]) : PowerSeries A) ∈ lubinTateSeries (q : A) q := by
  have hq := H.one_lt
  have hc : ((((X + 1) ^ q - 1 : A[X]) : PowerSeries A)) = (1 + PowerSeries.X) ^ q - 1 := by
    simp [add_comm]
  rw [hc]
  refine ⟨by simp [show q ≠ 0 by omega], ?_, ?_⟩
  · simp [coeff_one_add_X_pow', PowerSeries.coeff_one]
  · intro n
    rw [map_sub, coeff_one_add_X_pow', PowerSeries.coeff_one, PowerSeries.coeff_X_pow]
    rcases Nat.eq_zero_or_pos n with rfl | hn
    · have : (0 : ℕ) ≠ q := by omega
      simp [this]
    rcases lt_trichotomy n q with h | rfl | h
    · have h1 : n ≠ 0 := by omega
      have h2 : n ≠ q := by omega
      simp only [h1, h2, ite_false, sub_zero]
      exact H.choose_mem n hn h
    · have h1 : n ≠ 0 := by omega
      simp [h1]
    · have h1 : n ≠ 0 := by omega
      have h2 : n ≠ q := by omega
      simp [Nat.choose_eq_zero_of_lt h, h1, h2]


theorem sub_one_pow_distinguished {A : Type*} [CommRing A] [IsLocalRing A] {q : ℕ} (H : LubinTateHyp A (q : A) q)
    (hq : (q : A) ∈ IsLocalRing.maximalIdeal A) :
    (((X + 1) ^ q - 1 : A[X])).IsDistinguishedAt (IsLocalRing.maximalIdeal A) := by
  have hq1 := H.one_lt
  have hm : ((X + 1) ^ q : A[X]).Monic := (monic_X_add_C 1).pow _
  have hdeg : ((X + 1) ^ q : A[X]).natDegree = q := by
    rw [show (X + 1 : A[X]) = X + C 1 by simp, (monic_X_add_C (1:A)).natDegree_pow, natDegree_X_add_C, mul_one]
  have hmon : ((X + 1) ^ q - 1 : A[X]).Monic := by
    refine hm.sub_of_left ?_
    rw [degree_one, degree_eq_natDegree hm.ne_zero, hdeg]
    exact_mod_cast (by omega : 0 < q)
  have hd : ((X + 1) ^ q - 1 : A[X]).natDegree = q := by
    rw [natDegree_sub_eq_left_of_natDegree_lt (by simp [hdeg]; omega), hdeg]
  refine ⟨⟨fun {i} hi => ?_⟩, hmon⟩
  rw [hd] at hi
  rw [coeff_sub, coeff_one, coeff_X_add_one_pow]
  rcases Nat.eq_zero_or_pos i with rfl | hn
  · simp
  · have : i ≠ 0 := by omega
    simp only [this, ite_false, sub_zero]
    exact (Ideal.span_singleton_le_iff_mem _ |>.2 hq) (H.choose_mem i hn hi)

theorem map_iter_sub_one_pow (p : ℕ) [Fact p.Prime] (m : ℕ) :
    (((fun r : 𝒪[ℚ_[p]][X] => ((X + 1) ^ p - 1 : 𝒪[ℚ_[p]][X]).comp r)^[m] X).map
      (algebraMap 𝒪[ℚ_[p]] ℚ_[p])) = (X + 1) ^ (p ^ m) - 1 := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [Function.iterate_succ_apply', Polynomial.map_comp, ih]
    simp [sub_comp, pow_comp, add_comp, ← pow_mul, pow_succ]

/-- **Example 3.8** (Milne, *CFT*, I): for $K = \mathbb Q_p$ and $\pi = p$, $(\mathbb Q_p)_{p,n} =
\mathbb Q_p[\zeta_{p^n}]$, the field generated by the $p^n$-th roots of unity (from Example 3.2 and the independence
of $f$). -/
@[kb "milne2020cft" "Ch. I, Example 3.8 (K_{p,n} = Q_p[ζ_{p^n}])"]
theorem example_3_8 (p : ℕ) [Fact p.Prime] (Ω : Type*) [Field Ω] [Algebra ℚ_[p] Ω] [IsSepClosure ℚ_[p] Ω]
    (hI : TorsionFieldIndependence ℚ_[p] Ω) (hp : Irreducible (p : 𝒪[ℚ_[p]])) (n : ℕ) :
    ltField Ω (p : 𝒪[ℚ_[p]]) n =
      IntermediateField.adjoin ℚ_[p] ((X ^ (p ^ n) - 1 : ℚ_[p][X]).rootSet Ω) := by
  have hres := resCard_padic p
  have hH : LubinTateHyp 𝒪[ℚ_[p]] (p : 𝒪[ℚ_[p]]) p := by
    have := lubinTateHyp_of_isNonarchimedeanLocalField ℚ_[p] hp
    have hres' : Nat.card 𝓀[ℚ_[p]] = p := hres
    rwa [hres'] at this
  have hpm : ((p : ℕ) : 𝒪[ℚ_[p]]) ∈ IsLocalRing.maximalIdeal 𝒪[ℚ_[p]] :=
    (IsLocalRing.mem_maximalIdeal _).2 hp.not_isUnit
  have h1 := ltPoly_mem hp
  have h2 := ltPolyIter_isDistinguishedAt hp 1
  have h3 := sub_one_pow_mem hH
  have h4 := sub_one_pow_distinguished hH hpm
  have h2' : (ltPoly (p : 𝒪[ℚ_[p]])).IsDistinguishedAt 𝓂[ℚ_[p]] := by
    simpa [ltPolyIter] using h2
  have key := hI.eq (π := (p : 𝒪[ℚ_[p]])) hp (ltPoly (p : 𝒪[ℚ_[p]])) ((X + 1) ^ p - 1)
    h1 h2' (by rw [hres]; exact h3) h4 n
  rw [ltField_eq_torsionField, key]
  unfold torsionField
  rw [map_iter_sub_one_pow]
  have hne : ((X + 1) ^ (p ^ n) - 1 : ℚ_[p][X]) ≠ 0 := by
    intro h
    have h1 : ((X + 1) ^ (p ^ n) : ℚ_[p][X]) = 1 := sub_eq_zero.1 h
    have h2 := congrArg Polynomial.natDegree h1
    have hp : 0 < p ^ n := pow_pos (Fact.out : p.Prime).pos n
    simp [natDegree_pow] at h2
    have := (Fact.out : p.Prime).pos
    omega
  have hne' : (X ^ (p ^ n) - 1 : ℚ_[p][X]) ≠ 0 := by
    intro h
    have h1 : ((X) ^ (p ^ n) : ℚ_[p][X]) = 1 := sub_eq_zero.1 h
    have h2 := congrArg Polynomial.natDegree h1
    have hp : 0 < p ^ n := pow_pos (Fact.out : p.Prime).pos n
    simp [natDegree_pow] at h2
    have := (Fact.out : p.Prime).pos
    omega
  have hS1 : ((X + 1) ^ (p ^ n) - 1 : ℚ_[p][X]).rootSet Ω = {α : Ω | (α + 1) ^ (p ^ n) = 1} := by
    ext α; rw [Polynomial.mem_rootSet]; simp [hne, sub_eq_zero]
  have hS2 : (X ^ (p ^ n) - 1 : ℚ_[p][X]).rootSet Ω = {α : Ω | α ^ (p ^ n) = 1} := by
    ext α; rw [Polynomial.mem_rootSet]; simp [hne', sub_eq_zero]
  rw [hS1, hS2]
  apply le_antisymm
  · rw [IntermediateField.adjoin_le_iff]
    intro α hα
    have h : α = (α + 1) - 1 := by ring
    rw [SetLike.mem_coe, h]
    exact sub_mem (IntermediateField.subset_adjoin _ _ hα) (one_mem _)
  · rw [IntermediateField.adjoin_le_iff]
    intro ζ hζ
    have h : ζ = (ζ - 1) + 1 := by ring
    rw [SetLike.mem_coe, h]
    refine add_mem (IntermediateField.subset_adjoin _ _ ?_) (one_mem _)
    simpa using hζ


end NumberFieldKB.MilneCFT.LocalCFT
