import NumberFieldKB.WeilBNT.FieldVectorSpaces
import NumberFieldKB.WeilBNT.FieldClassification
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs

/-!
# Weil, *Basic Number Theory*, III.§1, Prop. 1: closures of subfields of a local field

$K$ is a local field: a commutative nondiscrete locally compact field (I.§4, text p. 21), with Weil's module
`modK` (`FieldModule`). $k$ is any field, $k_0\subseteq k$ an infinite subfield and $\lambda:k\to K$ an embedding.

* `subfield_isTopologicalDivisionRing`: a subfield of $K$, with the subspace topology, is a topological field.
* **`weil_III_1_prop1_local`**: the closure $K_0$ of $\lambda(k_0)$ in $K$ is a local field (locally compact and not
  discrete; it is closed, and a topological field by the instance above).
* **`weil_III_1_prop1_closure`**: the closure of $\lambda(k)$ in $K$ is the field generated by $\lambda(k)$ over
  $K_0$.

*Proof* (Weil's). $K_0$ is closed in $K$, hence locally compact. If it were discrete, the elements of module $\le1$
would form a finite set closed under multiplication, so all its nonzero elements would have module $1$ and $K_0$
would be compact and discrete, i.e. finite, against $k_0$ infinite. $K$ is then a locally compact vector space over the
nondiscrete locally compact field $K_0$, of finite dimension (I.§2, Cor. 2 of Thm. 3), so every $K_0$-subspace of $K$ is
closed (I.§2, Thm. 3: it is locally compact); the field generated by $\lambda(k)$ over $K_0$ is such a subspace, is
contained in the closure of $\lambda(k)$ (a closed subfield containing $K_0$ and $\lambda(k)$), and contains $\lambda(k)$.
-/

open Topology Filter

noncomputable section

set_option linter.unusedSectionVars false

namespace NumberFieldKB.WeilBNT.FieldModule

variable {K : Type*} [Field K] [TopologicalSpace K] [IsTopologicalDivisionRing K]
  [LocallyCompactSpace K] [T2Space K] [(𝓝[≠] (0 : K)).NeBot]

/-- A subfield of a topological field, with the subspace topology, is a topological field. -/
instance subfield_isTopologicalDivisionRing (F : Subfield K) : IsTopologicalDivisionRing F := by
  have : IsTopologicalRing F := inferInstanceAs (IsTopologicalRing F.toSubring)
  have : ContinuousInv₀ F :=
    ⟨fun x hx => by
      rw [Topology.IsInducing.subtypeVal.continuousAt_iff]
      have hx' : (x : K) ≠ 0 := fun h => hx (Subtype.ext h)
      exact (continuousAt_inv₀ hx').comp continuous_subtype_val.continuousAt⟩
  exact ⟨⟩

/-- **Prop. 1**, first assertion: the closure $K_0$ of $\lambda(k_0)$ is a local field. -/
@[kb "weil1973bnt" "Ch. III, §1, Prop. 1 (the closure of an infinite subfield is a local field)"]
theorem weil_III_1_prop1_local {k : Type*} [Field k] (k₀ : Subfield k) (hinf : (k₀ : Set k).Infinite)
    (emb : k →+* K) :
    IsClosed ((k₀.map emb).topologicalClosure : Set K) ∧
      LocallyCompactSpace (k₀.map emb).topologicalClosure ∧
      (𝓝[≠] (0 : (k₀.map emb).topologicalClosure)).NeBot := by
  have hcl : IsClosed ((k₀.map emb).topologicalClosure : Set K) :=
    Subfield.isClosed_topologicalClosure _
  refine ⟨hcl, hcl.isClosedEmbedding_subtypeVal.locallyCompactSpace, ?_⟩
  by_contra hne
  rw [Filter.not_neBot] at hne
  have hdisc : DiscreteTopology (k₀.map emb).topologicalClosure := by
    rw [discreteTopology_iff_isOpen_singleton_zero, isOpen_singleton_iff_punctured_nhds]
    exact hne
  have hfin := finite_of_discreteTopology (K := K) (k₀.map emb).topologicalClosure
  have hinf' : Set.Infinite ((k₀.map emb : Subfield K) : Set K) := by
    have : ((k₀.map emb : Subfield K) : Set K) = emb '' (k₀ : Set k) := by
      ext x; simp
    rw [this]
    exact hinf.image emb.injective.injOn
  apply hinf'
  have hsub : ((k₀.map emb : Subfield K) : Set K) ⊆
      Set.range ((↑) : (k₀.map emb).topologicalClosure → K) := by
    intro x hx
    exact ⟨⟨x, (k₀.map emb).le_topologicalClosure hx⟩, rfl⟩
  exact (Set.finite_range _).subset hsub

/-- **Prop. 1**, second assertion: the closure of $\lambda(k)$ is the field generated by $\lambda(k)$ over $K_0$. -/
@[kb "weil1973bnt" "Ch. III, §1, Prop. 1 (the closure of λ(k) is generated by λ(k) over K₀)"]
theorem weil_III_1_prop1_closure {k : Type*} [Field k] (k₀ : Subfield k) (hinf : (k₀ : Set k).Infinite)
    (emb : k →+* K) :
    emb.fieldRange.topologicalClosure = (k₀.map emb).topologicalClosure ⊔ emb.fieldRange := by
  obtain ⟨hcl, hlc, hnd⟩ := weil_III_1_prop1_local k₀ hinf emb
  set K₀ := (k₀.map emb).topologicalClosure with hK₀
  have := hlc
  have := hnd
  let _ : Algebra K₀ K := (Subfield.subtype K₀).toAlgebra
  have hsm : ∀ (c : K₀) (x : K), c • x = (c : K) * x := fun _ _ => rfl
  have : ContinuousSMul K₀ K :=
    ⟨by simp_rw [hsm]; exact (continuous_subtype_val.comp continuous_fst).mul continuous_snd⟩
  have : FiniteDimensional K₀ K := weil_I_2_thm3_cor2_finiteDimensional (K := K₀) (V := K)
  set A : IntermediateField K₀ K := IntermediateField.adjoin K₀ (emb.fieldRange : Set K) with hA
  have hAeq : A.toSubfield = K₀ ⊔ emb.fieldRange := by
    rw [hA, IntermediateField.adjoin_toSubfield, Subfield.closure_union]
    have : Set.range (algebraMap K₀ K) = (K₀ : Set K) := Subtype.range_coe
    rw [this, Subfield.closure_eq]
    congr 1
    exact Subfield.closure_eq _
  have hAcl : IsClosed (A.toSubfield : Set K) := by
    let W : Submodule K₀ K := A.toSubalgebra.toSubmodule
    have h2 := isClosed_of_finiteDimensional (K := K₀) (V := K) W
    exact h2
  apply le_antisymm
  · rw [← hAeq]
    exact emb.fieldRange.topologicalClosure_minimal (by
      rw [hAeq]; exact le_sup_right) hAcl
  · refine sup_le ?_ (emb.fieldRange.le_topologicalClosure)
    refine Subfield.topologicalClosure_minimal _ ?_ (Subfield.isClosed_topologicalClosure _)
    intro x hx
    obtain ⟨y, hy, rfl⟩ := hx
    exact emb.fieldRange.le_topologicalClosure ⟨y, rfl⟩

end NumberFieldKB.WeilBNT.FieldModule
