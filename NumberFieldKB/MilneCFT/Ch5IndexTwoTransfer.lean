import QuadFormsKB.Citation
import Mathlib.GroupTheory.Transfer
import Mathlib.NumberTheory.NumberField.CMField
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.IndexNormal

/-!
# The setting of Milne's Theorem 3.33: CM fields and the Verlagerung for a subgroup of index 2

Source: J. S. Milne, *Class Field Theory*, version 4.03 (2020), bib key `milne2020cft`, Chapter V, §3, the paragraph
before Theorem 3.33 and Theorem 3.33 itself (pdf p. 177, printed p. 168).

Milne: "let $K$ be a CM-field and let $F$ be the largest totally real subfield of $K$. Then
$G = \operatorname{Gal}(\mathbb Q^{\mathrm{al}}/K)$ is a subgroup of index 2 in $G' = \operatorname{Gal}(\mathbb
Q^{\mathrm{al}}/F)$, and the corresponding Verlagerung is a homomorphism $V : G'^{ab} \to G^{ab}$. In this case, $V$ has
a very simple description." Theorem 3.33 (Wei) then identifies the field generated by special values of automorphic
functions on Shimura varieties with $(K^{ab})^H\mathbb Q^{ab}$, $H = \operatorname{im} V$; that statement is out of
reach (no library has Shimura varieties or their canonical models) and is not stated.

## What is formalized here

* `transfer_eq_sq_of_not_mem`, `transfer_eq_mul_conj_of_mem`: **the simple description of $V$** for a subgroup $H$ of
  index 2 in any group $G$ (Milne's $G \subset G'$): with a coset representative $t \notin H$,
  $$V(g) = g^2 \bmod [H,H] \quad (g \notin H), \qquad V(g) = g \cdot t g t^{-1} \bmod [H,H] \quad (g \in H).$$
  In particular `transfer_eq_one_of_not_mem_of_sq_eq_one`: an involution outside $H$ (for a CM field, any complex
  conjugation in $G'$) has trivial Verlagerung.
* `isCMField_iff`: Milne's definition of a CM field ("a quadratic totally imaginary extension $K$ of a totally real
  field $F$") agrees with Mathlib's `NumberField.IsCMField` (stated with the maximal real subfield).

## Formalized elsewhere (cited, not re-proved)

* Mathlib `NumberField.IsCMField` and `NumberField.CMExtension.eq_maximalRealSubfield`,
  `NumberField.IsCMField.ofCMExtension` (the totally real subfield of index 2 is unique: it is $K^+$),
  `NumberField.IsCMField.complexConj` (complex conjugation is a well-defined element of $\operatorname{Gal}(K/K^+)$,
  the same for every embedding), `NumberField.IsCMField.indexRealUnits_eq_one_or_two` (Hasse's unit index
  $Q = [\mathcal O_K^\times : \mu_K \mathcal O_{K^+}^\times] \in \{1,2\}$),
  `NumberField.IsCMField.regulator_div_regulator_eq_two_pow_mul_indexRealUnits_inv` ($R_K/R_{K^+} = 2^{r}/Q$).
  All in `Mathlib/NumberTheory/NumberField/CMField.lean`.
* QuadFormsKB `QuadFormsKB.Binary.Rel.relativeClassNumberFormula_hasse` (`QuadFormsKB/Binary/RelativeCNF.lean`): the
  relative class number formula $h_K/h_{K^+} = \frac{Q_K w_K}{(2\pi)^d}\sqrt{|d_K|/|d_{K^+}|}\,L(1,\chi_{K/K^+})$.
-/

noncomputable section

namespace NumberFieldKB.MilneCFT

section Transfer

variable {G : Type*} [Group G] {H : Subgroup G}

/-- Conjugating an element of `H` by an element of `H` does not change its image in the abelianization. -/
lemma of_conj_eq {x y : G} (hx : x ∈ H) (hy : y ∈ H) (hm : x⁻¹ * y * x ∈ H) :
    (Abelianization.of ⟨x⁻¹ * y * x, hm⟩ : Abelianization H) = Abelianization.of ⟨y, hy⟩ := by
  have : (⟨x⁻¹ * y * x, hm⟩ : H) = (⟨x, hx⟩ : H)⁻¹ * ⟨y, hy⟩ * ⟨x, hx⟩ := rfl
  rw [this, map_mul, map_mul, map_inv, mul_right_comm, inv_mul_cancel, one_mul]

/-- For a normal subgroup, `g ∈ H` fixes every coset `xH`. -/
lemma smul_mk_eq_of_mem [H.Normal] {g : G} (hg : g ∈ H) (x : G) :
    g • (x : G ⧸ H) = (x : G ⧸ H) := by
  show ((g * x : G) : G ⧸ H) = _
  rw [QuotientGroup.eq]
  have := (inferInstance : H.Normal).conj_mem g⁻¹ (H.inv_mem hg) x⁻¹
  simpa [mul_assoc] using this

/-- For `g ∉ H` with `H` of index 2, the generator `g` moves every coset. -/
lemma smul_mk_ne_of_not_mem (hH : H.index = 2) {g : G} (hg : g ∉ H) (x : G) :
    g • (x : G ⧸ H) ≠ (x : G ⧸ H) := by
  have := Subgroup.normal_of_index_eq_two hH
  intro h
  change ((g * x : G) : G ⧸ H) = _ at h
  rw [QuotientGroup.eq] at h
  apply hg
  have := (inferInstance : H.Normal).conj_mem _ h x
  simpa [mul_assoc] using H.inv_mem this

/-- **The Verlagerung to a subgroup of index 2, outside the subgroup** (Milne, *CFT*, V, before Theorem 3.33, p. 168):
if $[G:H] = 2$ and $g \notin H$, then $V(g) = g^2 \bmod [H,H]$. -/
@[kb "milne2020cft" "v4.03, Ch. V, before Theorem 3.33: the Verlagerung for an index-2 subgroup, p. 168"]
theorem transfer_eq_sq_of_not_mem (hH : H.index = 2) {g : G} (hg : g ∉ H) (h : H) (hh : (h : G) = g ^ 2) :
    haveI : H.FiniteIndex := ⟨by omega⟩
    (Abelianization.of : H →* Abelianization H).transfer g = Abelianization.of h := by
  have : H.FiniteIndex := ⟨by omega⟩
  change (Abelianization.of : H →* Abelianization H).transfer g = _
  have := Subgroup.normal_of_index_eq_two hH
  classical
  have hsq : g ^ 2 ∈ H := Subgroup.sq_mem_of_index_two hH g
  have key : ∀ (x : G) (n : ℕ), n = 2 → ∀ hm : x⁻¹ * g ^ n * x ∈ H,
      (Abelianization.of ⟨x⁻¹ * g ^ n * x, hm⟩ : Abelianization H) = Abelianization.of h := by
    intro x n hn hm
    subst hn
    have hh' : h = ⟨g ^ 2, hsq⟩ := Subtype.ext hh
    rw [hh']
    by_cases hx : x ∈ H
    · exact of_conj_eq hx hsq hm
    · have hk : g⁻¹ * x ∈ H := by
        rw [Subgroup.mul_mem_iff_of_index_two hH]
        simp [hg, hx]
      have e : x⁻¹ * g ^ 2 * x = (g⁻¹ * x)⁻¹ * g ^ 2 * (g⁻¹ * x) := by group
      have hm' : (g⁻¹ * x)⁻¹ * g ^ 2 * (g⁻¹ * x) ∈ H := e ▸ hm
      have : (⟨x⁻¹ * g ^ 2 * x, hm⟩ : H) = ⟨(g⁻¹ * x)⁻¹ * g ^ 2 * (g⁻¹ * x), hm'⟩ :=
        Subtype.ext e
      rw [this]
      exact of_conj_eq hk hsq hm'
  haveI : Fintype (Quotient (MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H))) := Fintype.ofFinite _
  have : Subsingleton (Quotient (MulAction.orbitRel (Subgroup.zpowers g) (G ⧸ H))) := by
    refine ⟨fun a b => ?_⟩
    induction a using Quotient.inductionOn with | _ y1 => ?_
    induction b using Quotient.inductionOn with | _ y2 => ?_
    obtain ⟨x1, rfl⟩ := QuotientGroup.mk_surjective y1
    obtain ⟨x2, rfl⟩ := QuotientGroup.mk_surjective y2
    apply Quotient.sound
    by_cases hx : x2⁻¹ * x1 ∈ H
    · refine ⟨1, ?_⟩
      show (1 : Subgroup.zpowers g) • (x2 : G ⧸ H) = x1
      rw [one_smul, QuotientGroup.eq]
      exact hx
    · refine ⟨⟨g, Subgroup.mem_zpowers g⟩, ?_⟩
      show g • (x2 : G ⧸ H) = x1
      change ((g * x2 : G) : G ⧸ H) = _
      rw [QuotientGroup.eq]
      have h2 : (g * x2)⁻¹ * x1 = (x2⁻¹ * g⁻¹ * x2) * (x2⁻¹ * x1) := by group
      have h3 : x2⁻¹ * g⁻¹ * x2 ∉ H := fun h => hg (by
        have h5 := (inferInstance : H.Normal).conj_mem _ h x2
        have h6 : g⁻¹ ∈ H := by simpa [mul_assoc] using h5
        simpa using H.inv_mem h6)
      rw [h2, Subgroup.mul_mem_iff_of_index_two hH]
      simp [h3, hx]
  rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot, Fintype.prod_subsingleton _ (Quotient.mk _ 1)]
  refine key _ _ ?_ _
  have hper : ∀ y : G ⧸ H, Function.minimalPeriod (g • ·) y = 2 := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    apply Function.minimalPeriod_eq_prime
    · show g • g • (x : G ⧸ H) = x
      rw [smul_smul, ← pow_two]
      exact smul_mk_eq_of_mem hsq x
    · exact smul_mk_ne_of_not_mem hH hg x
  exact hper _

/-- **The Verlagerung to a subgroup of index 2, inside the subgroup** (Milne, *CFT*, V, before Theorem 3.33, p. 168):
if $[G:H] = 2$, $t \notin H$ and $g \in H$, then $V(g) = g \cdot tgt^{-1} \bmod [H,H]$. -/
@[kb "milne2020cft" "v4.03, Ch. V, before Theorem 3.33: the Verlagerung for an index-2 subgroup, p. 168"]
theorem transfer_eq_mul_conj_of_mem (hH : H.index = 2) {t : G} (ht : t ∉ H) (h₁ h₂ : H)
    (h₂_eq : (h₂ : G) = t * h₁ * t⁻¹) :
    haveI : H.FiniteIndex := ⟨by omega⟩
    (Abelianization.of : H →* Abelianization H).transfer (h₁ : G) =
      Abelianization.of h₁ * Abelianization.of h₂ := by
  have : H.FiniteIndex := ⟨by omega⟩
  change (Abelianization.of : H →* Abelianization H).transfer (h₁ : G) = _
  have := Subgroup.normal_of_index_eq_two hH
  classical
  haveI : Fintype (G ⧸ H) := H.fintypeQuotientOfFiniteIndex
  have hsq : t ^ 2 ∈ H := Subgroup.sq_mem_of_index_two hH t
  have key : ∀ (x : G) (n : ℕ), n = 1 → ∀ hm : x⁻¹ * (h₁ : G) ^ n * x ∈ H,
      (Abelianization.of ⟨x⁻¹ * (h₁ : G) ^ n * x, hm⟩ : Abelianization H) =
        if x ∈ H then Abelianization.of h₁ else Abelianization.of h₂ := by
    intro x n hn hm
    subst hn
    by_cases hx : x ∈ H
    · rw [if_pos hx]
      have e : x⁻¹ * (h₁ : G) ^ 1 * x = x⁻¹ * (h₁ : G) * x := by rw [pow_one]
      have hm' : x⁻¹ * (h₁ : G) * x ∈ H := e ▸ hm
      have : (⟨x⁻¹ * (h₁ : G) ^ 1 * x, hm⟩ : H) = ⟨x⁻¹ * (h₁ : G) * x, hm'⟩ := Subtype.ext e
      rw [this]
      exact of_conj_eq hx h₁.2 hm'
    · rw [if_neg hx]
      have hk : t⁻¹ * x ∈ H := by
        rw [Subgroup.mul_mem_iff_of_index_two hH]
        simp [ht, hx]
      obtain ⟨k, hk', rfl⟩ : ∃ k, k ∈ H ∧ x = t * k := ⟨t⁻¹ * x, hk, by group⟩
      have hz : t ^ 2 * k ∈ H := H.mul_mem hsq hk'
      have hm' : (t ^ 2 * k)⁻¹ * (h₂ : G) * (t ^ 2 * k) ∈ H :=
        H.mul_mem (H.mul_mem (H.inv_mem hz) h₂.2) hz
      have : (⟨(t * k)⁻¹ * (h₁ : G) ^ 1 * (t * k), hm⟩ : H) =
          ⟨(t ^ 2 * k)⁻¹ * (h₂ : G) * (t ^ 2 * k), hm'⟩ :=
        Subtype.ext (by
          show (t * k)⁻¹ * (h₁ : G) ^ 1 * (t * k) = (t ^ 2 * k)⁻¹ * (h₂ : G) * (t ^ 2 * k)
          rw [h₂_eq]; group)
      rw [this]
      exact of_conj_eq hz h₂.2 hm'
  haveI : Fintype (Quotient (MulAction.orbitRel (Subgroup.zpowers (h₁ : G)) (G ⧸ H))) :=
    Fintype.ofFinite _
  have hfix : ∀ (y : G ⧸ H), ∀ m ∈ Subgroup.zpowers (h₁ : G), m • y = y := by
    intro y m hm
    have : Subgroup.zpowers (h₁ : G) ≤ MulAction.stabilizer G y :=
      Subgroup.zpowers_le.mpr (by
        rw [MulAction.mem_stabilizer_iff]
        obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
        exact smul_mk_eq_of_mem h₁.2 x)
    exact (MulAction.mem_stabilizer_iff.mp (this hm))
  let e : Quotient (MulAction.orbitRel (Subgroup.zpowers (h₁ : G)) (G ⧸ H)) ≃ G ⧸ H :=
    { toFun := fun q => q.out
      invFun := fun y => Quotient.mk _ y
      left_inv := fun q => Quotient.out_eq q
      right_inv := fun y => by
        have hm := Quotient.mk_out (s := MulAction.orbitRel (Subgroup.zpowers (h₁ : G)) (G ⧸ H)) y
        obtain ⟨m, hm⟩ := hm
        exact hm.symm.trans (hfix y m m.2) }
  have hper : ∀ y : G ⧸ H, Function.minimalPeriod ((h₁ : G) • ·) y = 1 := by
    intro y
    obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
    rw [Function.minimalPeriod_eq_one_iff_isFixedPt]
    exact smul_mk_eq_of_mem h₁.2 x
  have hmem : ∀ y : G ⧸ H, y.out ∈ H ↔ y = 1 := fun y => by
    rw [← QuotientGroup.eq_one_iff, QuotientGroup.out_eq']
  rw [MonoidHom.transfer_eq_prod_quotient_orbitRel_zpowers_quot]
  refine (Fintype.prod_equiv e _
    (fun y : G ⧸ H => if y.out ∈ H then Abelianization.of h₁ else Abelianization.of h₂) ?_).trans ?_
  · intro q
    exact key _ _ (hper _) _
  · have ht1 : ((t : G) : G ⧸ H) ≠ 1 := fun h => ht ((QuotientGroup.eq_one_iff t).mp h)
    rw [Fintype.prod_eq_mul (1 : G ⧸ H) ((t : G) : G ⧸ H) ht1.symm]
    · simp only [hmem, if_true, ht1, if_false]
    · intro y ⟨hy1, hyt⟩
      exfalso
      obtain ⟨x, rfl⟩ := QuotientGroup.mk_surjective y
      apply hyt
      have hx : x ∉ H := fun h => hy1 ((QuotientGroup.eq_one_iff x).mpr h)
      rw [QuotientGroup.eq, Subgroup.mul_mem_iff_of_index_two hH]
      simp [ht, hx]

/-- **An involution outside an index-2 subgroup has trivial Verlagerung** (for a CM field $K$ over $F = K^+$, a
complex conjugation $c \in \operatorname{Gal}(\mathbb Q^{\mathrm{al}}/F) \setminus \operatorname{Gal}(\mathbb
Q^{\mathrm{al}}/K)$ satisfies $V(c) = c^2 = 1$). -/
@[kb "milne2020cft" "v4.03, Ch. V, before Theorem 3.33, p. 168"]
theorem transfer_eq_one_of_not_mem_of_sq_eq_one (hH : H.index = 2) {g : G} (hg : g ∉ H) (hg2 : g ^ 2 = 1) :
    haveI : H.FiniteIndex := ⟨by omega⟩
    (Abelianization.of : H →* Abelianization H).transfer g = 1 := by
  have h := transfer_eq_sq_of_not_mem hH hg 1 (by simp [hg2])
  exact h.trans (map_one _)

end Transfer

section CM

open NumberField Algebra

/-- **Milne's definition of a CM field agrees with Mathlib's** (Milne, *CFT*, V, before Theorem 3.33, p. 168: "a
quadratic totally imaginary extension $K$ of a totally real field $F$"): a number field $K$ is CM (Mathlib's
`IsCMField`, stated with the maximal real subfield $K^+$) iff it is totally complex and quadratic over some totally
real subfield. The subfield is then $K^+$ (Mathlib `CMExtension.eq_maximalRealSubfield`). -/
@[kb "milne2020cft" "v4.03, Ch. V, before Theorem 3.33: CM fields, p. 168"]
theorem isCMField_iff (K : Type*) [Field K] [NumberField K] :
    IsCMField K ↔ IsTotallyComplex K ∧ ∃ F : Subfield K, IsTotallyReal F ∧ IsQuadraticExtension F K := by
  constructor
  · intro h
    exact ⟨inferInstance, maximalRealSubfield K, inferInstance, inferInstance⟩
  · rintro ⟨hc, F, hF, hq⟩
    exact IsCMField.ofCMExtension F K

end CM

end NumberFieldKB.MilneCFT
