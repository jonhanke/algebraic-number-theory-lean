/-!
# Milne, *Class Field Theory*, Chapter VI §4: primes in ray classes and the second inequality

Source: J. S. Milne, *Class Field Theory*, course notes, version 4.03 (2020), bib key `milne2020cft`. Locators give
Milne's printed page numbers (printed page = pdf page − 9).

$\mathfrak m$ is a modulus of the number field $K$ (Introduction), $C_\mathfrak m$ its ray class group. A congruence
subgroup $I^{S(\mathfrak m)}\supseteq H\supseteq i(K_{\mathfrak m,1})$ is the same as a subgroup $H$ of $C_\mathfrak m$.

* **Theorem 4.8** (`Theorem4_8`, named statement; not in the audit's item list): the primes in $H$ have Dirichlet
  density $1/(C_\mathfrak m : H)$ if $L(1,\chi)\ne0$ for every nontrivial character $\chi$ of $C_\mathfrak m/H$, and
  $0$ otherwise. $L(1,\chi)\ne0$ means: $L(s,\chi)$ (`weberLSeries`) tends to a nonzero limit as $s\downarrow1$
  (`WeberLOneNeZero`).
* **Theorem 4.9** (`thm_4_9`, the second inequality, ideal form): for a Galois extension $L/K$,
  $(I^{S(\mathfrak m)} : i(K_{\mathfrak m,1})\cdot\mathrm{Nm}(I_L^{S(\mathfrak m)}))\le[L:K]$. Proved from Theorem 4.8 and
  the density $1/[L:K]$ of the primes splitting in $L$ (unconditional Chebotarev theorem of this library), following
  Milne's proof.
* **Corollary 4.10** (`cor_4_10`): $L(1,\chi)\ne0$ for a nontrivial $\chi$ of $C_\mathfrak m$ trivial on the norms from
  a Galois extension; proved from Theorem 4.8 in the same way. The library proves more, unconditionally, in idelic
  language: $L(s,\chi)\ne0$ on $\mathrm{Re}\,s = 1$ for every unitary Hecke character that is not a power of the norm
  (`cor_4_10_idelic`, citing `NumberFieldKB.NonVanishing.heckeLCont_ne_zero_of_re_eq_one`); the bridge from ray class
  characters to Hecke characters is not formalized here.

The group $\mathrm{Nm}(I_L^{S(\mathfrak m)})$ is generated by the norms $\mathrm{Nm}\,\mathfrak P = \mathfrak p^{f(\mathfrak
P/\mathfrak p)}$ of the primes $\mathfrak P$ of $L$ not above $\mathfrak m_0$; its image in $C_\mathfrak m$ is
`normClasses m L` (the same subgroup as in `ArtinReciprocity`, Introduction).
-/

open Filter Topology NumberField IsDedekindDomain
open NumberFieldKB.Chebotarev NumberFieldKB.HilbertClassField

noncomputable section

namespace NumberFieldKB.MilneCFT.Ch6

variable {K : Type} [Field K] [NumberField K]

/-- The primes $\mathfrak p\nmid\mathfrak m_0$ whose class in $C_\mathfrak m$ lies in $H$ ("$\{\mathfrak p\in H\}$"). -/
def primesIn (m : Modulus K) (H : Subgroup (RayClassGroup m)) : Set (HeightOneSpectrum (𝓞 K)) :=
  {v | ∃ hv : ¬ v.asIdeal ∣ m.finite, rayClass m v hv ∈ H}

/-- **$L(1,\chi)\ne0$** for a character $\chi$ of $C_\mathfrak m$: the Weber $L$-series $L(s,\chi)$ tends to a nonzero
limit as $s\downarrow1$ through real numbers (for $\chi\ne1$, $L(s,\chi)$ is analytic near $1$, Milne's Corollary 2.11,
and the limit is $L(1,\chi)$). -/
def WeberLOneNeZero (m : Modulus K) (χ : RayClassGroup m →* ℂˣ) : Prop :=
  ∃ c : ℂ, c ≠ 0 ∧ Tendsto (fun s : ℝ => weberLSeries m χ s) (𝓝[>] 1) (𝓝 c)

open Classical in
variable (K) in
/-- **Theorem 4.8** (named statement; Milne, *CFT*, Chapter VI, p. 197): for a modulus $\mathfrak m$ and a congruence
subgroup $H$ (a subgroup of $C_\mathfrak m$), the set of primes in $H$ has Dirichlet density $1/(C_\mathfrak m:H)$ if
$L(1,\chi)\ne0$ for all characters $\chi\ne1$ of $C_\mathfrak m/H$, and $0$ otherwise. -/
@[kb "milne2020cft" "Ch. VI, Thm. 4.8 (input)"]
structure Theorem4_8 : Prop where
  density : ∀ (m : Modulus K) (H : Subgroup (RayClassGroup m)),
    MilneHasDirichletDensity (primesIn m H)
      (if ∀ χ : RayClassGroup m →* ℂˣ, (∀ h ∈ H, χ h = 1) → χ ≠ 1 → WeberLOneNeZero m χ
        then 1 / (H.index : ℝ) else 0)

/-- The image in $C_\mathfrak m$ of $\mathrm{Nm}_{L/K}(I_L^{S(\mathfrak m)})$: generated by the classes of
$\mathrm{Nm}\,\mathfrak P = \mathfrak p^{f(\mathfrak P/\mathfrak p)}$, $\mathfrak p\nmid\mathfrak m_0$. -/
def normClasses (m : Modulus K) (L : Type) [Field L] [NumberField L] [Algebra K L] : Subgroup (RayClassGroup m) :=
  Subgroup.closure {c | ∃ (v : HeightOneSpectrum (𝓞 K)) (hv : ¬ v.asIdeal ∣ m.finite)
    (Q : v.asIdeal.primesOver (𝓞 L)), c = rayClass m v hv ^ Q.1.inertiaDeg (𝓞 K)}

/-- Dirichlet densities (Mathlib's ratio form) are monotone. -/
theorem hasDirichletDensity_mono {S T : Set (HeightOneSpectrum (𝓞 K))} (hST : S ⊆ T) {a b : ℝ}
    (hS : S.HasDirichletDensity a) (hT : T.HasDirichletDensity b) : a ≤ b := by
  refine le_of_tendsto_of_tendsto hS hT ?_
  filter_upwards [eventually_primeIdealZetaSum_univ_pos (F := K), self_mem_nhdsWithin] with s hpos hs
  exact div_le_div_of_nonneg_right (primeIdealZetaSum_mono hST hs) hpos.le

variable {L : Type} [Field L] [NumberField L] [Algebra K L] [IsGalois K L]

/-- The primes $\mathfrak p\nmid\mathfrak m_0$ splitting in $L$ lie in `normClasses m L`, and the primes in
`normClasses m L` have Dirichlet density at least $1/[L:K]$. -/
theorem one_div_finrank_le_density (m : Modulus K) {δ : ℝ}
    (hδ : (primesIn m (normClasses m L)).HasDirichletDensity δ) :
    1 / (Module.finrank K L : ℝ) ≤ δ := by
  have hfin : {v : HeightOneSpectrum (𝓞 K) | v.asIdeal ∣ m.finite}.Finite :=
    Ideal.finite_factors m.finite_ne_bot
  have h1 : (splitPrimes K L \ {v | v.asIdeal ∣ m.finite}).HasDirichletDensity
      (1 / Module.finrank K L) :=
    HasDirichletDensity.congr_finite (splitPrimes_hasDirichletDensity_unconditional K L)
      (hfin.subset fun v hv => by
        rcases hv with ⟨h1, h2⟩ | ⟨h1, h2⟩
        · by_contra h; exact h2 ⟨h1, h⟩
        · exact absurd h1.1 h2)
  refine hasDirichletDensity_mono ?_ h1 hδ
  rintro v ⟨hs, hv⟩
  have Q : v.asIdeal.primesOver (𝓞 L) := Classical.arbitrary _
  refine ⟨hv, Subgroup.subset_closure ⟨v, hv, Q, ?_⟩⟩
  rw [((mem_splitPrimes_iff K L v).mp hs _ Q.2.1 Q.2.2).2, pow_one]

/-- From Theorem 4.8: the primes in `normClasses m L` have density $1/(C_\mathfrak m : \mathrm{Nm})$, this index is
nonzero, and $L(1,\chi)\ne0$ for every nontrivial $\chi$ trivial on the norms (Milne's (a), (b) in the proof of
Theorem 4.9). -/
theorem normClasses_density (h48 : Theorem4_8 K) (m : Modulus K) :
    (normClasses m L).index ≠ 0 ∧ 1 / (Module.finrank K L : ℝ) ≤ 1 / ((normClasses m L).index : ℝ) ∧
      ∀ χ : RayClassGroup m →* ℂˣ, (∀ h ∈ normClasses m L, χ h = 1) → χ ≠ 1 → WeberLOneNeZero m χ := by
  classical
  have hd := one_div_finrank_le_density (L := L) m (h48.density m (normClasses m L)).hasDirichletDensity
  have hn : (0 : ℝ) < 1 / (Module.finrank K L : ℝ) := by
    have : 0 < Module.finrank K L := Module.finrank_pos
    positivity
  by_cases hP : ∀ χ : RayClassGroup m →* ℂˣ, (∀ h ∈ normClasses m L, χ h = 1) → χ ≠ 1 → WeberLOneNeZero m χ
  · rw [ite_eq_left_of_eq_true _ _ (eq_true hP)] at hd
    refine ⟨fun h0 => ?_, hd, hP⟩
    rw [h0, Nat.cast_zero, div_zero] at hd
    linarith
  · rw [ite_eq_right_of_eq_false _ _ (eq_false hP)] at hd
    linarith

/-- **Theorem 4.9** (the second inequality; Milne, *CFT*, Chapter VI, p. 198; conditional on Theorem 4.8): for every
Galois extension $L$ of $K$ and modulus $\mathfrak m$ of $K$,
$(I^{S(\mathfrak m)} : i(K_{\mathfrak m,1})\cdot\mathrm{Nm}(I_L^{S(\mathfrak m)}))\le[L:K]$; the index is finite. -/
@[kb "milne2020cft" "Ch. VI, Thm. 4.9"]
theorem thm_4_9 (h48 : Theorem4_8 K) (m : Modulus K) :
    (normClasses m L).FiniteIndex ∧ (normClasses m L).index ≤ Module.finrank K L := by
  obtain ⟨h0, hle, -⟩ := normClasses_density (L := L) h48 m
  refine ⟨⟨h0⟩, ?_⟩
  have hi : (0 : ℝ) < (normClasses m L).index := by exact_mod_cast Nat.pos_of_ne_zero h0
  have hn : (0 : ℝ) < Module.finrank K L := by exact_mod_cast Module.finrank_pos
  rw [div_le_div_iff₀ hn hi, one_mul, one_mul] at hle
  exact_mod_cast hle

/-- **Corollary 4.10** (Milne, *CFT*, Chapter VI, p. 198; conditional on Theorem 4.8): if $\chi$ is a nontrivial
character of $C_\mathfrak m$ and $L/K$ is a Galois extension with $\mathrm{Nm}_{L/K}(C_{\mathfrak m,L})\subseteq
\ker\chi$, then $L(1,\chi)\ne0$. -/
@[kb "milne2020cft" "Ch. VI, Cor. 4.10"]
theorem cor_4_10 (h48 : Theorem4_8 K) (m : Modulus K) (χ : RayClassGroup m →* ℂˣ) (hχ : χ ≠ 1)
    (hL : ∀ h ∈ normClasses m L, χ h = 1) : WeberLOneNeZero m χ :=
  (normClasses_density h48 m).2.2 χ hL hχ

/-- **Corollary 4.10, idelic form, unconditional** (Milne, *CFT*, Chapter VI, Cor. 4.10, p. 198; Milne remarks that
$L(1,\chi)\ne0$ can be proved without class field theory): for a unitary Hecke character $\chi$ of $K$ (a character of
the idele class group) that is not a power of the norm, $L(1,\chi)\ne0$; no norm hypothesis is needed. This library's
`NumberFieldKB.NonVanishing.heckeLCont_ne_zero_of_re_eq_one` at $s = 1$. A character of a ray class group defines such
a Hecke character of finite order; that bridge is not formalized here. -/
@[kb "milne2020cft" "Ch. VI, Cor. 4.10 (idelic form, without the norm hypothesis)"]
theorem cor_4_10_idelic {χ : HeckeCharacter K} (hχ : χ.IsUnitary)
    (hnp : ∀ c : ℂ, χ ≠ HeckeCharacter.normPow K c) : HeckeL.heckeLCont χ 1 ≠ 0 :=
  NonVanishing.heckeLCont_ne_zero_of_re_eq_one hχ hnp Complex.one_re

end NumberFieldKB.MilneCFT.Ch6
