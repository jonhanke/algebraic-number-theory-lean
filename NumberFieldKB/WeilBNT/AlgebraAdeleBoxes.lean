import NumberFieldKB.WeilBNT.AlgebraAdeleTopology
import NumberFieldKB.WeilBNT.AdeleBoxes

/-!
# Weil, *Basic Number Theory*, IV.§1 Cor. 2 of Prop. 1: the open subrings $\mathcal A_{\mathbb A}(P,\alpha)$

Notation as in `NumberFieldKB.WeilBNT.AlgebraAdeleTopology`: $k$ a number field (`F`), $\mathcal A$ a
finite-dimensional $k$-algebra, $\mathcal A_{\mathbb A}=k_{\mathbb A}\otimes_k\mathcal A$ with the topology of
$k_{\mathbb A}^n$ in the basis $\alpha=$ `Module.finBasis F A` (`algAdeleTop`). For a set $S$ of finite places,
$P=P_\infty\cup S$, Weil's
$$\mathcal A_{\mathbb A}(P,\alpha)=\prod_{v\in P}\mathcal A_v\times\prod_{v\notin P}\alpha_v,$$
$\alpha_v$ the $r_v$-module generated by $\alpha$, is the set of $x$ whose coordinates in $\alpha$ lie in the box
$k_{\mathbb A}(P)$ (`algBox S`).

* **`weil_IV_1_prop1_cor2`**: there is a finite set $S_0$ such that $\mathcal A_{\mathbb A}(P,\alpha)$ is an open
  subring of $\mathcal A_{\mathbb A}$ whenever $S\supseteq S_0$; these sets increase with $S$ and $\mathcal A_{\mathbb A}$
  is their union.

Weil takes for $\alpha$ any finite subset containing a basis; here $\alpha$ is a basis (the general case changes
$\alpha_v$ only at finitely many $v$, Weil III.1 Cor. 2 of Thm. 3). The proof is Weil's: the structure constants
$c_{ijh}$ ($\alpha_i\alpha_j=\sum_hc_{ijh}\alpha_h$) and the coordinates of $1$ lie in $r_v$ for almost all $v$, and then
$\alpha_v$ is a ring; openness and the union are Prop. 1 coordinatewise.
-/

open IsDedekindDomain NumberField QuadFormsKB.Tamagawa.Measure.Weil Topology
open scoped TensorProduct

noncomputable section

namespace NumberFieldKB.WeilBNT

attribute [local instance] adelesAlgebra algAdeleTop

variable {F : Type} [Field F] [NumberField F] {A : Type} [Ring A] [Algebra F A] [FiniteDimensional F A]

variable (F A) in
/-- **Weil's $\mathcal A_{\mathbb A}(P,\alpha)$** for $P=P_\infty\cup S$ and $\alpha$ = `Module.finBasis F A`: the elements
of $\mathcal A_{\mathbb A}$ whose coordinates in $\alpha$ have finite components in $r_v$ for every finite $v\notin S$. -/
def algBox (S : Set (HeightOneSpectrum (𝓞 F))) : Set (Adeles F ⊗[F] A) :=
  {x | ∀ i, (coordsA F A x i).2 ∈ FiniteAdeleRing.box (𝓞 F) F S}

open QuadFormsKB.Tamagawa.Measure.Weil in
theorem algAdelesBasis_apply (i : AIdx F A) :
    algAdelesBasis (Module.finBasis F A) i = (1 : Adeles F) ⊗ₜ[F] (Module.finBasis F A i) := by
  simp [algAdelesBasis, Algebra.TensorProduct.basis_apply]

theorem leftMulMatrix_entry (i k j : AIdx F A) :
    Algebra.leftMulMatrix (algAdelesBasis (Module.finBasis F A)) (algAdelesBasis (Module.finBasis F A) i) k j =
      diag F ((Module.finBasis F A).equivFun (Module.finBasis F A i * Module.finBasis F A j) k) := by
  have hj : (algCoords (Module.finBasis F A)).symm (Pi.single j 1) =
      algAdelesBasis (Module.finBasis F A) j := by
    rw [LinearEquiv.symm_apply_eq]
    funext l
    show _ = (algAdelesBasis (Module.finBasis F A)).equivFun (algAdelesBasis (Module.finBasis F A) j) l
    rw [Module.Basis.equivFun_self, Pi.single_apply]
    simp [eq_comm]
  have h := algCoords_mul (Module.finBasis F A) (algAdelesBasis (Module.finBasis F A) i) (Pi.single j 1)
  rw [hj] at h
  have h2 := congrFun h k
  rw [algAdelesBasis_apply, algAdelesBasis_apply, Algebra.TensorProduct.tmul_mul_tmul, one_mul] at h2
  have h3 := congrFun (coords_tmul (F := F) (A := A) (Module.finBasis F A i * Module.finBasis F A j)) k
  rw [coordsA_eq] at h3
  rw [h3] at h2
  rw [algAdelesBasis_apply i]
  simpa [Matrix.mulVec, dotProduct, Pi.single_apply] using h2.symm

theorem exists_box_fin {ι : Type} [Fintype ι] (f : ι → FiniteAdeleRing (𝓞 F) F) :
    ∃ S : Finset (HeightOneSpectrum (𝓞 F)), ∀ i, f i ∈ FiniteAdeleRing.box (𝓞 F) F (S : Set _) := by
  classical
  choose g hg using fun i => FiniteAdeleRing.exists_mem_box (f i)
  refine ⟨Finset.univ.biUnion g, fun i => FiniteAdeleRing.box_mono ?_ (hg i)⟩
  intro v hv
  exact Finset.mem_coe.2 (Finset.mem_biUnion.2 ⟨i, Finset.mem_univ _, hv⟩)

/-- **Weil, IV.§1, Cor. 2 of Prop. 1** (number field $k$, $\alpha$ a basis of $\mathcal A$). There is a finite set
$S_0$ of finite places such that for every $S\supseteq S_0$ the set $\mathcal A_{\mathbb A}(P,\alpha)$ is an open subring
of $\mathcal A_{\mathbb A}$; the sets increase with $S$, and $\mathcal A_{\mathbb A}$ is their union. -/
@[kb "weil1973bnt" "Ch. IV, §1, Cor. 2 of Prop. 1 (p. 62), alpha a basis"]
theorem weil_IV_1_prop1_cor2 :
    (∃ S₀ : Finset (HeightOneSpectrum (𝓞 F)), ∀ S : Set (HeightOneSpectrum (𝓞 F)), (S₀ : Set _) ⊆ S →
      ∃ R : Subring (Adeles F ⊗[F] A), (R : Set (Adeles F ⊗[F] A)) = algBox F A S ∧
        IsOpen (R : Set (Adeles F ⊗[F] A))) ∧
    (∀ S T : Set (HeightOneSpectrum (𝓞 F)), S ⊆ T → algBox F A S ⊆ algBox F A T) ∧
    (∀ x : Adeles F ⊗[F] A, ∃ S : Finset (HeightOneSpectrum (𝓞 F)),
      x ∈ algBox F A (S : Set (HeightOneSpectrum (𝓞 F)))) := by
  classical
  obtain ⟨S₁, h₁⟩ := exists_box_fin (F := F)
    (fun p : AIdx F A × AIdx F A × AIdx F A =>
      (diag F ((Module.finBasis F A).equivFun (Module.finBasis F A p.1 * Module.finBasis F A p.2.2) p.2.1)).2)
  obtain ⟨S₂, h₂⟩ := exists_box_fin (F := F)
    (fun i : AIdx F A => (coordsA F A (1 : Adeles F ⊗[F] A) i).2)
  have hmono : ∀ S T : Set (HeightOneSpectrum (𝓞 F)), S ⊆ T → algBox F A S ⊆ algBox F A T :=
    fun S T h x hx i => FiniteAdeleRing.box_mono h (hx i)
  refine ⟨⟨S₁ ∪ S₂, fun S hS => ?_⟩, hmono, fun x => ?_⟩
  · have hS1 : ((S₁ : Finset _) : Set _) ⊆ S := fun v hv => hS (by simp [hv])
    have hS2 : ((S₂ : Finset _) : Set _) ⊆ S := fun v hv => hS (by simp [hv])
    have hc : ∀ i k j : AIdx F A, (Algebra.leftMulMatrix (algAdelesBasis (Module.finBasis F A))
        (algAdelesBasis (Module.finBasis F A) i) k j).2 ∈ FiniteAdeleRing.box (𝓞 F) F S := by
      intro i k j
      rw [leftMulMatrix_entry]
      exact FiniteAdeleRing.box_mono hS1 (h₁ (i, k, j))
    let R : Subring (Adeles F ⊗[F] A) :=
      { carrier := algBox F A S
        mul_mem' := by
          intro x y hx hy i
          rw [coordsA_mul]
          rw [Finset.sum_apply, Prod.snd_sum]
          refine sum_mem fun j _ => ?_
          simp only [Pi.smul_apply, smul_eq_mul, Prod.snd_mul]
          refine mul_mem (hx j) ?_
          simp only [Matrix.mulVec, dotProduct, Prod.snd_sum, Prod.snd_mul]
          exact sum_mem fun k _ => mul_mem (hc _ _ _) (hy k)
        one_mem' := fun i => FiniteAdeleRing.box_mono hS2 (h₂ i)
        add_mem' := fun hx hy i => by rw [map_add]; exact add_mem (hx i) (hy i)
        zero_mem' := fun i => by simp
        neg_mem' := fun hx i => by rw [map_neg]; exact neg_mem (hx i) }
    refine ⟨R, rfl, ?_⟩
    have : (R : Set (Adeles F ⊗[F] A)) = coordsA F A ⁻¹' {y | ∀ i, (y i).2 ∈ FiniteAdeleRing.box (𝓞 F) F S} := rfl
    rw [this]
    have : {y : AIdx F A → Adeles F | ∀ i, (y i).2 ∈ FiniteAdeleRing.box (𝓞 F) F S} =
        ⋂ i, (fun y : AIdx F A → Adeles F => (y i).2) ⁻¹' (FiniteAdeleRing.box (𝓞 F) F S) := by
      ext y; simp
    refine IsOpen.preimage continuous_coordsA ?_
    rw [this]
    exact isOpen_iInter_of_finite fun i =>
      (FiniteAdeleRing.isOpen_box S).preimage (continuous_snd.comp (continuous_apply i))
  · obtain ⟨S, hS⟩ := exists_box_fin (F := F) (fun i : AIdx F A => (coordsA F A x i).2)
    exact ⟨S, hS⟩

end NumberFieldKB.WeilBNT
