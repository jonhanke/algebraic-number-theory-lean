import Mathlib.LinearAlgebra.QuadraticForm.IsometryEquiv
import Mathlib.MeasureTheory.Group.GeometryOfNumbers
import Mathlib.RingTheory.Flat.TorsionFree
import Mathlib.RingTheory.SimpleRing.Principal
import Mathlib.Algebra.Module.ZLattice.Basic
import Mathlib.Algebra.Order.Star.Real
import Mathlib.Analysis.Normed.Lp.MeasurableSpace
import QuadFormsKB.Citation

/-!
# Milne, Elliptic Curves, Chapter IV §6: lattices, Minkowski's theorem, positive definiteness

J. S. Milne, *Elliptic Curves* (2006; bibliography key `milne2006ec`), Chapter IV, Section 6 ("The Néron-Tate
pairing"), the statements about real vector spaces: the definition of a lattice, Lemma 6.2 and Minkowski's
Theorem 6.3.  Theorem 6.1 (positive definiteness of the Néron–Tate pairing) is in `Ch4NeronTate`.
Locators give the pdf page of the text `ectext6` (printed page = pdf page − 8).

A **lattice** in a real vector space $V$ (pdf p. 139) is, for Milne, the $\mathbb{Z}$-submodule generated by a
basis of $V$ ("full" or "complete" lattice): here `Submodule.span ℤ (Set.range b)` for a basis `b`.  Compared
with Mathlib's `IsZLattice` (discrete subgroups spanning the space) in `isZLattice_iff_exists_basis`.
-/

open MeasureTheory Module

namespace NumberFieldKB.MilneEC

/-- Milne's lattices (pdf p. 139) are Mathlib's `IsZLattice`: in a finite-dimensional real normed space, a
subgroup is discrete and spans the space if and only if it is the $\mathbb{Z}$-span of a basis. -/
@[kb "milne2006ec" "Ch. IV, §6, definition of a lattice in a real vector space, pdf p. 139"]
theorem isZLattice_iff_exists_basis {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
    [FiniteDimensional ℝ V] (L : Submodule ℤ V) :
    (DiscreteTopology L ∧ Submodule.span ℝ (L : Set V) = ⊤) ↔
      ∃ (ι : Type) (_ : Fintype ι) (b : Basis ι ℝ V), L = Submodule.span ℤ (Set.range b) := by
  constructor
  · rintro ⟨hd, hs⟩
    have : IsZLattice ℝ L := ⟨hs⟩
    refine ⟨Fin (finrank ℤ L), inferInstance, (Module.finBasis ℤ L).ofZLatticeBasis ℝ L, ?_⟩
    exact ((Module.finBasis ℤ L).ofZLatticeBasis_span ℝ L).symm
  · rintro ⟨ι, hι, b, rfl⟩
    exact ⟨inferInstance, ZSpan.span_top b⟩

/-- Minkowski's theorem for a box in `Fin d → ℝ` with positive half-widths `r i` (`0 < d`). -/
lemma minkowski_pi {d : ℕ} [NeZero d] (b' : Basis (Fin d) ℝ (Fin d → ℝ)) (r : Fin d → ℝ)
    (hr : ∀ i, 0 < r i)
    (h : 2 ^ d * volume (ZSpan.fundamentalDomain b') ≤ ENNReal.ofReal (∏ i, 2 * r i)) :
    ∃ x ∈ Submodule.span ℤ (Set.range b'), x ≠ 0 ∧ ∀ i, |x i| ≤ r i := by
  have hc : Countable (Submodule.span ℤ (Set.range b')) := inferInstance
  have hvol : volume (Set.Icc (-r) r) = ENNReal.ofReal (∏ i, 2 * r i) := by
    rw [Real.volume_Icc_pi, ENNReal.ofReal_prod_of_nonneg (fun i _ => by have := hr i; positivity)]
    refine Finset.prod_congr rfl fun i _ => ?_
    simp only [Pi.neg_apply]
    ring_nf
  obtain ⟨x, hx0, hxB⟩ :=
    MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure
    (μ := volume) (L := (Submodule.span ℤ (Set.range b')).toAddSubgroup)
    (s := Set.Icc (-r) r)
    (ZSpan.isAddFundamentalDomain' b' volume)
    (fun x hx => by
      simp only [Set.mem_Icc] at hx ⊢
      exact ⟨neg_le_neg_iff.mpr hx.2, neg_le.mpr hx.1⟩)
    (convex_Icc _ _) isCompact_Icc
    (by rw [hvol, finrank_fintype_fun_eq_card, Fintype.card_fin, mul_comm]; exact h)
  refine ⟨x, x.2, fun h0 => hx0 (Subtype.ext h0), fun i => ?_⟩
  rw [abs_le]
  exact ⟨by simpa using hxB.1 i, hxB.2 i⟩

/-- Under (a) and (b) of Lemma 6.2, `q` is strictly positive on nonzero lattice points: a lattice point
with `q P < 0` would give the infinitely many points `n • P` with `q ≤ 0`. -/
lemma pos_of_finite_lattice {V : Type*} [AddCommGroup V] [Module ℝ V]
    (q : QuadraticForm ℝ V) (L : Submodule ℤ V)
    (ha : ∀ C : ℝ, {P : V | P ∈ L ∧ q P ≤ C}.Finite)
    (hb : ∀ P ∈ L, q P = 0 → P = 0) : ∀ P ∈ L, P ≠ 0 → 0 < q P := by
  intro P hP hP0
  by_contra hle
  have hle' : q P ≤ 0 := not_lt.mp hle
  have hne : q P ≠ 0 := fun h0 => hP0 (hb P hP h0)
  have hneg : q P < 0 := lt_of_le_of_ne hle' hne
  have hinj : Function.Injective (fun n : ℕ => ((n : ℤ) • P)) := by
    intro m n hmn
    have h1 : ((m : ℝ)) • P = ((n : ℝ)) • P := by
      have h2 := hmn
      simp only [natCast_zsmul] at h2
      rwa [Nat.cast_smul_eq_nsmul ℝ, Nat.cast_smul_eq_nsmul ℝ]
    exact Nat.cast_injective (R := ℝ) (smul_left_injective ℝ hP0 h1)
  apply Set.infinite_range_of_injective hinj
  refine (ha 0).subset ?_
  rintro _ ⟨n, rfl⟩
  refine ⟨L.smul_of_tower_mem _ hP |> fun h => by simpa using h, ?_⟩
  have : q ((n : ℤ) • P) = (n : ℝ) ^ 2 * q P := by
    rw [← Int.cast_smul_eq_zsmul ℝ, QuadraticMap.map_smul]
    simp [sq]
  rw [this]
  nlinarith [sq_nonneg (n : ℝ)]

/-- **Lemma 6.2** (pdf p. 140).  Let $q$ be a quadratic form on a finite-dimensional real vector space $V$.
If there is a lattice $\Lambda$ in $V$ such that (a) for every constant $C$ the set
$\{P \in \Lambda \mid q(P) \le C\}$ is finite and (b) the only $P \in \Lambda$ with $q(P) = 0$ is $P = 0$, then $q$
is positive definite on $V$. -/
@[kb "milne2006ec" "Ch. IV, Lemma 6.2, pdf p. 140"]
theorem lemma_6_2 {V : Type*} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
    (q : QuadraticForm ℝ V) {ι : Type*} (b : Basis ι ℝ V)
    (ha : ∀ C : ℝ, {P : V | P ∈ Submodule.span ℤ (Set.range b) ∧ q P ≤ C}.Finite)
    (hb : ∀ P ∈ Submodule.span ℤ (Set.range b), q P = 0 → P = 0) :
    q.PosDef := by
  have hpos := pos_of_finite_lattice q _ ha hb
  obtain ⟨w, ⟨e⟩⟩ := QuadraticForm.equivalent_weightedSumSquares q
  have hq : ∀ x, q x = ∑ i, w i * (e x i) ^ 2 := by
    intro x
    have h := e.map_app x
    rw [QuadraticMap.weightedSumSquares_apply] at h
    rw [← h]
    simp [sq]
  by_cases hw : ∀ i, 0 < w i
  · intro x hx
    have hex : e x ≠ 0 := fun h0 => hx (e.toLinearEquiv.map_eq_zero_iff.mp h0)
    obtain ⟨j, hj⟩ : ∃ j, e x j ≠ 0 := by
      by_contra hcon
      push Not at hcon
      exact hex (funext hcon)
    rw [hq]
    refine Finset.sum_pos' (fun i _ => mul_nonneg (hw i).le (sq_nonneg _))
      ⟨j, Finset.mem_univ _, mul_pos (hw j) (by positivity)⟩
  · exfalso
    push Not at hw
    obtain ⟨i0, hi0⟩ := hw
    let d : ℕ := Module.finrank ℝ V
    have : Finite ι := Module.Finite.finite_basis b
    have : Fintype ι := Fintype.ofFinite ι
    have hcard : Fintype.card ι = d := (Module.finrank_eq_card_basis b).symm
    let σ : ι ≃ Fin d := Fintype.equivFinOfCardEq hcard
    let b' : Basis (Fin d) ℝ (Fin d → ℝ) := (b.map e.toLinearEquiv).reindex σ
    have : NeZero d := ⟨(Fin.pos i0).ne'⟩
    have hmem : ∀ x ∈ Submodule.span ℤ (Set.range b'), ∃ P ∈ Submodule.span ℤ (Set.range b),
        e P = x := by
      intro x hx
      have hr : Set.range b' = e.toLinearEquiv '' Set.range b := by
        simp only [b', Basis.range_reindex]
        ext y
        simp [Basis.map_apply]
      rw [hr] at hx
      have : Submodule.span ℤ (e.toLinearEquiv '' Set.range b) =
          (Submodule.span ℤ (Set.range b)).map
            (e.toLinearEquiv.toLinearMap.restrictScalars ℤ) := by
        rw [Submodule.map_span]; rfl
      rw [this] at hx
      obtain ⟨P, hP, hPx⟩ := hx
      exact ⟨P, hP, hPx⟩
    -- a positive lower bound for `q` on short nonzero lattice points
    obtain ⟨m, hm0, hm⟩ : ∃ m : ℝ, 0 < m ∧ ∀ P ∈ Submodule.span ℤ (Set.range b), P ≠ 0 → q P ≤ 1 →
        m ≤ q P := by
      have hfin : {P : V | P ∈ Submodule.span ℤ (Set.range b) ∧ q P ≤ 1 ∧ P ≠ 0}.Finite :=
        (ha 1).subset fun P hP => ⟨hP.1, hP.2.1⟩
      by_cases hne : {P : V | P ∈ Submodule.span ℤ (Set.range b) ∧ q P ≤ 1 ∧ P ≠ 0}.Nonempty
      · obtain ⟨P0, hP0, hmin⟩ := Set.exists_min_image _ q hfin hne
        refine ⟨q P0, hpos P0 hP0.1 hP0.2.2, fun P hP hP0' hP1 => hmin P ⟨hP, hP1, hP0'⟩⟩
      · refine ⟨1, one_pos, fun P hP hP0' hP1 => ?_⟩
        exact absurd ⟨P, hP, hP1, hP0'⟩ hne
    set W : ℝ := ∑ j, |w j| + 1 with hW
    have hSum0 : 0 ≤ ∑ j, |w j| := Finset.sum_nonneg fun j _ => abs_nonneg _
    have hWpos : 0 < W := by linarith
    set δ : ℝ := min m 1 with hδ
    have hδpos : 0 < δ := lt_min hm0 one_pos
    set ε : ℝ := Real.sqrt (δ / (2 * W)) with hε
    have hεpos : 0 < ε := Real.sqrt_pos.mpr (by positivity)
    have hε2 : ε ^ 2 = δ / (2 * W) := Real.sq_sqrt (by positivity)
    have hK : volume (ZSpan.fundamentalDomain b') < ⊤ :=
      (ZSpan.fundamentalDomain_isBounded b').measure_lt_top
    set Kr : ℝ := (volume (ZSpan.fundamentalDomain b')).toReal with hKr
    have hKr0 : 0 ≤ Kr := ENNReal.toReal_nonneg
    set P0 : ℝ := (2 * ε) ^ ((Finset.univ : Finset (Fin d)).erase i0).card with hP0
    have hP0pos : 0 < P0 := by positivity
    set R : ℝ := 2 ^ d * Kr / (2 * P0) + 1 with hR
    have hRpos : 0 < R := by positivity
    let r : Fin d → ℝ := fun j => if j = i0 then R else ε
    have hr : ∀ j, 0 < r j := fun j => by
      by_cases h : j = i0 <;> simp [r, h, hRpos, hεpos]
    have hprod : ∏ j, 2 * r j = 2 * R * P0 := by
      rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ i0)]
      have : ∏ j ∈ (Finset.univ : Finset (Fin d)).erase i0, 2 * r j = P0 := by
        rw [hP0, ← Finset.prod_const]
        refine Finset.prod_congr rfl fun j hj => ?_
        simp [r, Finset.ne_of_mem_erase hj]
      rw [this]
      simp [r]
    have hvolcond : 2 ^ d * volume (ZSpan.fundamentalDomain b') ≤
        ENNReal.ofReal (∏ j, 2 * r j) := by
      rw [hprod]
      have h1 : 2 ^ d * volume (ZSpan.fundamentalDomain b') = ENNReal.ofReal (2 ^ d * Kr) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_pow (by norm_num),
          hKr, ENNReal.ofReal_toReal hK.ne]
        simp
      rw [h1]
      apply ENNReal.ofReal_le_ofReal
      have h2 : 2 * R * P0 = 2 ^ d * Kr + 2 * P0 := by
        rw [hR]; field_simp
      linarith
    obtain ⟨x, hx, hx0, hxr⟩ := minkowski_pi b' r hr hvolcond
    obtain ⟨P, hP, rfl⟩ := hmem x hx
    have hP0' : P ≠ 0 := fun h => hx0 (by rw [h]; simp)
    have hqP : q P ≤ δ / 2 := by
      rw [hq]
      calc ∑ j, w j * (e P j) ^ 2 ≤ ∑ j, |w j| * ε ^ 2 := by
            refine Finset.sum_le_sum fun j _ => ?_
            by_cases hj : j = i0
            · subst hj
              have : w j * (e P j) ^ 2 ≤ 0 := mul_nonpos_of_nonpos_of_nonneg hi0 (sq_nonneg _)
              have : 0 ≤ |w j| * ε ^ 2 := by positivity
              linarith
            · have h1 : |e P j| ≤ ε := by simpa [r, hj] using hxr j
              have h2 : (e P j) ^ 2 ≤ ε ^ 2 := by
                rw [← sq_abs]
                exact pow_le_pow_left₀ (abs_nonneg _) h1 2
              calc w j * (e P j) ^ 2 ≤ |w j| * (e P j) ^ 2 :=
                    mul_le_mul_of_nonneg_right (le_abs_self _) (sq_nonneg _)
                _ ≤ |w j| * ε ^ 2 := mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
        _ = (∑ j, |w j|) * ε ^ 2 := by rw [Finset.sum_mul]
        _ ≤ W * ε ^ 2 := by
            apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
            linarith
        _ = δ / 2 := by rw [hε2]; field_simp
    have hmP := hm P hP hP0' (by linarith [min_le_right m 1])
    have hδm : δ ≤ m := min_le_left m 1
    linarith

/-- **Theorem 6.3** (Minkowski, pdf p. 140).  Let $\Lambda$ be a lattice in $\mathbb{R}^n$ with fundamental
parallelepiped $D_0$, and let $B \subseteq \mathbb{R}^n$ be compact, convex and symmetric in the origin.  If
$\operatorname{Vol}(B) \ge 2^n \operatorname{Vol}(D_0)$ then $B$ contains a point of $\Lambda$ other than the
origin.  (Mathlib: `MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure`, for any
fundamental domain; here specialized to the fundamental parallelepiped `ZSpan.fundamentalDomain b`.)  The
hypothesis $n \ge 1$ is implicit in Milne: for $n = 0$ the only point is the origin and the statement fails. -/
@[kb "milne2006ec" "Ch. IV, Thm. 6.3, pdf p. 140"]
theorem thm_6_3 {n : ℕ} (hn : 0 < n) (b : Basis (Fin n) ℝ (EuclideanSpace ℝ (Fin n)))
    {B : Set (EuclideanSpace ℝ (Fin n))} (h_cpt : IsCompact B) (h_conv : Convex ℝ B)
    (h_symm : ∀ x ∈ B, -x ∈ B)
    (h : 2 ^ n * volume (ZSpan.fundamentalDomain b) ≤ volume B) :
    ∃ x ∈ Submodule.span ℤ (Set.range b), x ≠ 0 ∧ x ∈ B := by
  have : Nontrivial (EuclideanSpace ℝ (Fin n)) := by
    have : Nonempty (Fin n) := ⟨⟨0, hn⟩⟩
    infer_instance
  have : Countable (Submodule.span ℤ (Set.range b)) := inferInstance
  obtain ⟨x, hx0, hxB⟩ := MeasureTheory.exists_ne_zero_mem_lattice_of_measure_mul_two_pow_le_measure
    (μ := volume) (L := (Submodule.span ℤ (Set.range b)).toAddSubgroup)
    (ZSpan.isAddFundamentalDomain' b volume) h_symm h_conv h_cpt
    (by simpa [finrank_euclideanSpace, mul_comm] using h)
  exact ⟨x, x.2, fun h0 => hx0 (Subtype.ext h0), hxB⟩

end NumberFieldKB.MilneEC
