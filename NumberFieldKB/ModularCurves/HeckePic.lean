import NumberFieldKB.ModularCurves.PlaceNorm
import Mathlib.FieldTheory.Perfect
import Mathlib.RingTheory.Henselian
import Mathlib.FieldTheory.RatFunc.Basic
import Mathlib.NumberTheory.ModularForms.CongruenceSubgroups
import Mathlib.RingTheory.RegularLocalRing.Defs
import Mathlib.RingTheory.SimpleRing.Principal
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic

/-!
# The Hecke correspondence $T(p)$ on $\mathrm{Pic}^0(X_0(N))$

J. S. Milne, *Elliptic Curves* (`milne2006ec`), Ch. V, §7 (pdf p. 225, D138: $T(p)$ acts on divisor classes and on
$J_0(N)$). $T(p) = \pi_{p*}\circ\pi_1^*$ on divisors of $X_0(N)$ over $\mathbb Q$ (`heckeX0`) multiplies degrees by
$(\Gamma_0(N) : \Gamma_0(pN))$ (`deg_heckeX0`) and sends principal divisors to principal divisors:
$\pi_1^*\operatorname{div}(f) = \operatorname{div}(f)$ (`isDivisorOf_pullX0`) and
$\pi_{p*}\operatorname{div}(g) = \operatorname{div}(N g)$ (`isDivisorOf_pushX0`). So it acts on
$\mathrm{Pic}^0(X_0(N)) = \mathrm{Div}^0/P$ (`heckePic0`), Milne's $T(p)$ on the rational points of $J_0(N)$
(`Pic0X0`).

For this, $\mathbb Q(X_0(M))$ is finite over $\mathbb Q(X_0(N))$ embedded by $z \mapsto dz$
(`finiteDimensional_degeneracy`): it is generated by $j$ and $j_M$, both algebraic.
-/

open Polynomial IsDedekindDomain

namespace NumberFieldKB.ModularCurves

open NumberFieldKB.MilneEC

variable {N M : ℕ} [NeZero N] [NeZero M]

/-- **$\mathbb Q(X_0(M))$ is finite over $\mathbb Q(X_0(N))$ embedded by $z \mapsto dz$** ($dN \mid M$). -/
theorem finiteDimensional_degeneracy {d : ℕ} (h : d * N ∣ M) :
    letI := (degeneracy N M d h).toAlgebra
    FiniteDimensional (X0 N) (X0 M) := by
  let := (degeneracy N M d h).toAlgebra
  have := isAlgebraic_degeneracy h
  have := isScalarTower_rat_degeneracy h
  let E := IntermediateField.adjoin (X0 N) ({jX0 (prop2_4' M), jNX0 (prop2_4' M)} : Set (X0 M))
  have hE : FiniteDimensional (X0 N) E :=
    IntermediateField.finiteDimensional_adjoin fun x _ => (Algebra.IsAlgebraic.isAlgebraic x).isIntegral
  have hj : jX0 (prop2_4' M) ∈ E := IntermediateField.subset_adjoin _ _ (by simp)
  have hr : jNX0 (prop2_4' M) ∈ E := IntermediateField.subset_adjoin _ _ (by simp)
  have hrat : ∀ c : ℚ, algebraMap ℚ (X0 M) c ∈ E := fun c => by
    rw [IsScalarTower.algebraMap_apply ℚ (X0 N) (X0 M)]
    exact E.algebraMap_mem _
  have hpoly : ∀ q : ℚ[X], algebraMap ℚ[X] (X0 M) q ∈ E := by
    intro q
    rw [algebraMap_polyX0_eq]
    induction q using Polynomial.induction_on with
    | C a => simp
    | add p q hp hq => simpa using add_mem hp hq
    | monomial n a _ =>
      simp only [AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_mul, map_pow, aeval_C, aeval_X]
      exact mul_mem (hrat a) (pow_mem hj _)
  have hrf : ∀ r : RatFunc ℚ, algebraMap (RatFunc ℚ) (X0 M) r ∈ E := by
    intro r
    obtain ⟨p, q, _, rfl⟩ := IsFractionRing.div_surjective (A := ℚ[X]) r
    rw [map_div₀, ← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
    exact div_mem (hpoly p) (hpoly q)
  have htop : E = ⊤ := by
    rw [eq_top_iff]
    intro x _
    induction x using AdjoinRoot.induction_on with
    | ih g =>
      rw [← AdjoinRoot.aeval_eq, Polynomial.aeval_eq_sum_range]
      refine sum_mem fun i _ => ?_
      rw [Algebra.smul_def]
      refine mul_mem (hrf _) (pow_mem ?_ _)
      rw [← jNX0_eq_root]
      exact hr
  have : FiniteDimensional (X0 N) (⊤ : IntermediateField (X0 N) (X0 M)) := htop ▸ hE
  exact IntermediateField.topEquiv.toLinearEquiv.finiteDimensional

/-- **Push-forward of a principal divisor along $z \mapsto dz$**: $\pi_*\operatorname{div}(g) =
\operatorname{div}(N g)$, the norm from $\mathbb Q(X_0(M))$ to $\mathbb Q(X_0(N))$. -/
theorem isDivisorOf_pushX0 {d : ℕ} (h : d * N ∣ M) {D : Divisor ℚ (X0 M)} {g : X0 M} (hD : IsDivisorOf D g) :
    letI := (degeneracy N M d h).toAlgebra
    IsDivisorOf (pushX0 h D) (Algebra.norm (X0 N) g) := by
  let := (degeneracy N M d h).toAlgebra
  have := isScalarTower_rat_degeneracy h
  have := finiteDimensional_degeneracy h
  exact isDivisorOf_pushDiv hD

theorem pushX0_principal {d : ℕ} (h : d * N ∣ M) {D : Divisor ℚ (X0 M)} (hD : D ∈ principalDivisors) :
    pushX0 h D ∈ principalDivisors := by
  let := (degeneracy N M d h).toAlgebra
  have := isScalarTower_rat_degeneracy h
  have := finiteDimensional_degeneracy h
  exact pushDiv_principal hD

/-- **$T(p)$ preserves principal divisors** on $X_0(N)$. -/
theorem heckeX0_principal (N p : ℕ) [NeZero N] [NeZero p] {D : Divisor ℚ (X0 N)}
    (hD : D ∈ principalDivisors) : heckeX0 N p D ∈ principalDivisors :=
  pushX0_principal _ (pullX0_principal _ hD)

/-- **$T(p)$ preserves divisors of degree 0** on $X_0(N)$. -/
theorem heckeX0_mem_divisorsDegZero (N p : ℕ) [NeZero N] [NeZero p] {D : Divisor ℚ (X0 N)}
    (hD : D ∈ divisorsDegZero) : heckeX0 N p D ∈ divisorsDegZero := by
  rw [AddMonoidHom.mem_ker] at hD ⊢
  rw [deg_heckeX0, hD, mul_zero]

/-- $T(p)$ on $\mathrm{Div}^0(X_0(N))$. -/
noncomputable def heckeDiv0 (N p : ℕ) [NeZero N] [NeZero p] :
    divisorsDegZero (k := ℚ) (K := X0 N) →+ divisorsDegZero (k := ℚ) (K := X0 N) :=
  ((heckeX0 N p).comp (divisorsDegZero (k := ℚ) (K := X0 N)).subtype).codRestrict _
    fun D => heckeX0_mem_divisorsDegZero N p D.2

/-- **The Hecke operator $T(p)$ on $\mathrm{Pic}^0(X_0(N))$** (Milne V §7, D138): the action of the correspondence
$T(p)$ on divisor classes of degree 0, i.e. on the rational points of $J_0(N)$ (`Pic0X0`). -/
@[kb "milne2006ec" "Ch. V, §7, the Hecke operator T(p) on divisor classes of X_0(N), i.e. on J_0(N) (running text), pdf p. 225"]
noncomputable def heckePic0 (N p : ℕ) [NeZero N] [NeZero p] : Pic0X0 N →+ Pic0X0 N :=
  QuotientAddGroup.map _ _ (heckeDiv0 N p) fun D hD => by
    rw [AddSubgroup.mem_comap, AddSubgroup.mem_addSubgroupOf]
    rw [AddSubgroup.mem_addSubgroupOf] at hD
    exact heckeX0_principal N p hD

theorem heckePic0_mk (N p : ℕ) [NeZero N] [NeZero p] (D : divisorsDegZero (k := ℚ) (K := X0 N)) :
    heckePic0 N p (QuotientAddGroup.mk D) = QuotientAddGroup.mk (heckeDiv0 N p D) :=
  rfl

end NumberFieldKB.ModularCurves
