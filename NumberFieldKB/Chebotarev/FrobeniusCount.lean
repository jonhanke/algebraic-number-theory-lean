import Mathlib.Tactic.Group
import Mathlib.Data.ZMod.QuotientGroup

/-!
# Counting points with a prescribed Frobenius
Pure group theory behind the Deuring reduction. A finite group `G` acts transitively on `X` (the primes
of `L` above an unramified `𝔭`), and `F : X → G` is equivariant for conjugation (`F (g • x) = g F(x) g⁻¹`,
the Frobenius map) with `stabilizer x = ⟨F x⟩` (the decomposition group is generated by Frobenius).

* **`card_fiber_mul_orderOf`**: if `F x₀ = σ` then `#{x | F x = σ} · ord σ = #C_G(σ)`.
-/

open MulAction Subgroup

namespace NumberFieldKB.Chebotarev

variable {G X : Type*} [Group G] [MulAction G X] [MulAction.IsPretransitive G X]

/-- The fibre of the Frobenius map over `σ` is the orbit of `x₀` under the centralizer of `σ`. -/
theorem fiber_eq_orbit_centralizer (F : X → G) (hF : ∀ (g : G) (x : X), F (g • x) = g * F x * g⁻¹)
    {x₀ : X} {σ : G} (h₀ : F x₀ = σ) :
    {x | F x = σ} = MulAction.orbit (Subgroup.centralizer {σ}) x₀ := by
  ext x
  simp only [Set.mem_ofPred_eq]
  constructor
  · intro hx
    obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq G x₀ x
    have hg : g ∈ Subgroup.centralizer {σ} := by
      rw [Subgroup.mem_centralizer_singleton_iff]
      rw [hF, h₀] at hx
      -- g σ g⁻¹ = σ  gives  σ g = g σ
      have : g * σ = σ * g := by
        calc g * σ = (g * σ * g⁻¹) * g := by group
          _ = σ * g := by rw [hx]
      exact this
    exact ⟨⟨g, hg⟩, rfl⟩
  · rintro ⟨⟨g, hg⟩, rfl⟩
    rw [Subgroup.mem_centralizer_singleton_iff] at hg
    show F (g • x₀) = σ
    rw [hF, h₀]
    rw [hg]; group

/-- **Counting primes with a prescribed Frobenius.** If `F x₀ = σ` and the stabilizer of `x₀` is `⟨σ⟩`, then
`#{x | F x = σ} · ord σ = #C_G(σ)`. -/
theorem card_fiber_mul_orderOf [Finite G] (F : X → G)
    (hF : ∀ (g : G) (x : X), F (g • x) = g * F x * g⁻¹)
    {x₀ : X} {σ : G} (h₀ : F x₀ = σ) (hstab : MulAction.stabilizer G x₀ = Subgroup.zpowers σ) :
    Nat.card {x // F x = σ} * orderOf σ = Nat.card (Subgroup.centralizer {σ}) := by
  set Z := Subgroup.centralizer {σ} with hZ
  have hle : Subgroup.zpowers σ ≤ Z := by
    rw [Subgroup.zpowers_le, hZ, Subgroup.mem_centralizer_singleton_iff]
  have hfib := fiber_eq_orbit_centralizer F hF h₀
  have h1 : Nat.card {x // F x = σ} = Nat.card (MulAction.orbit Z x₀) := by
    show Nat.card ↥{x | F x = σ} = _
    rw [hfib]
  have h2 : Nat.card (MulAction.stabilizer Z x₀) = orderOf σ := by
    rw [← Nat.card_zpowers]
    refine Nat.card_congr
      { toFun := fun z => ⟨z.1.1, by rw [← hstab]; exact z.2⟩
        invFun := fun w => ⟨⟨w.1, hle w.2⟩, by
          have : w.1 ∈ MulAction.stabilizer G x₀ := by rw [hstab]; exact w.2
          exact this⟩
        left_inv := fun z => rfl
        right_inv := fun w => rfl }
  rw [h1, ← h2]
  classical
  have : Fintype Z := Fintype.ofFinite Z
  have hfo : Finite (MulAction.orbit Z x₀) :=
    Finite.of_surjective (fun g : Z => (⟨g • x₀, g, rfl⟩ : MulAction.orbit Z x₀))
      (fun ⟨_, g, hg⟩ => ⟨g, Subtype.ext hg⟩)
  have : Fintype (MulAction.orbit Z x₀) := Fintype.ofFinite _
  have : Fintype (MulAction.stabilizer Z x₀) := Fintype.ofFinite _
  simp only [Nat.card_eq_fintype_card]
  exact MulAction.card_orbit_mul_card_stabilizer_eq_card_group Z x₀

end NumberFieldKB.Chebotarev
